```cshtml
<!DOCTYPE html>
<html data-theme="midnight">
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/doctor.css" asp-append-version="true" />
</head>

<body>
    <div class="wrapper">

        <!-- SIDEBAR -->
        <nav id="sidebar">

            <!-- SIDEBAR HEADER -->
            <div class="sidebar-header">
                <div class="header-top">
                    <button id="sidebarToggle" class="toggle-btn" type="button">
                        <i class="fas fa-angle-left"></i>
                    </button>

                    <h3>HemaCore</h3>
                </div>

                <p>DOCTOR PORTAL</p>
            </div>

            <!-- NAVIGATION MENU -->
            <ul class="list-unstyled components">

                <!-- OVERVIEW -->
                <li class="section-label">OVERVIEW</li>

                <li class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                    <a asp-controller="Doctor" asp-action="Index">
                        <i class="fas fa-home"></i>
                        <span class="menu-text">Dashboard</span>
                    </a>
                </li>

                <!-- PATIENT MANAGEMENT -->
                <li class="section-label">PATIENT MANAGEMENT</li>

                <li class="@(ViewContext.RouteData.Values["action"]?.ToString() == "ManagePatients" ? "active" : "")">
                    <a asp-controller="Doctor" asp-action="ManagePatients">
                        <i class="fas fa-users"></i>
                        <span class="menu-text">Manage Patients</span>
                    </a>
                </li>

                <li class="@(ViewContext.RouteData.Values["action"]?.ToString() == "AddPatient" ? "active" : "")">
                    <a asp-controller="Doctor" asp-action="AddPatient">
                        <i class="fas fa-user-plus"></i>
                        <span class="menu-text">Add New Patient</span>
                    </a>
                </li>

                <!-- TEST REQUESTS -->
                <li class="section-label">TEST REQUESTS</li>

                <li class="@(ViewContext.RouteData.Values["action"]?.ToString() == "MyRequests" ? "active" : "")">
                    <a asp-controller="Doctor" asp-action="MyRequests">
                        <i class="fas fa-file-medical"></i>
                        <span class="menu-text">My Requests</span>
                    </a>
                </li>

                <li class="@(ViewContext.RouteData.Values["action"]?.ToString() == "CreateTestRequest" ? "active" : "")">
                    <a asp-controller="Doctor" asp-action="CreateTestRequest">
                        <i class="fas fa-plus-circle"></i>
                        <span class="menu-text">New Request</span>
                    </a>
                </li>

                <!-- NOTIFICATIONS -->
                <li class="section-label">NOTIFICATIONS</li>

                <li class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Alerts" ? "active" : "")">
                    <a asp-controller="Doctor" asp-action="Alerts">
                        <i class="fas fa-bell"></i>
                        <span class="menu-text">Alerts</span>
                    </a>
                </li>

                <!-- REPORTING -->
                <li class="section-label">REPORTING</li>

                <li class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Reports" ? "active" : "")">
                    <a asp-controller="Doctor" asp-action="Reports">
                        <i class="fas fa-chart-column"></i>
                        <span class="menu-text">My Reports</span>
                    </a>
                </li>

            </ul>

            <div class="logout">
                <a href="#"
                   data-bs-toggle="modal"
                   data-bs-target="#logoutModal">
                    <i class="fas fa-sign-out-alt"></i>
                    <span class="menu-text">Logout</span>
                </a>
            </div>

        </nav>

        <!-- MAIN CONTENT -->
        <div id="content">

            <!-- TOP RIGHT DOCTOR ACCOUNT -->
            <div class="top-manager-account">

                <a asp-controller="Doctor"
                   asp-action="Profile"
                   class="top-manager-account"
                   style="text-decoration: none; border: none; color: inherit;">

                    <div class="top-manager-avatar">
                        <i class="fas fa-user-doctor"></i>
                    </div>

                    <div class="top-manager-info">
                        <span class="top-manager-name">
                            @(User.FindFirst("FullName")?.Value
                                ?? User.Identity?.Name
                                ?? "Doctor")
                        </span>

                        <small>Doctor</small>
                    </div>

                </a>
            </div>

            <!-- PAGE CONTENT -->
            <div class="page-content">
                @RenderBody()
            </div>

        </div>

    </div>
    <div class="modal fade"
         id="logoutModal"
         tabindex="-1"
         aria-labelledby="logoutModalLabel"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">

                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="logoutModalLabel">
                        Confirm Logout
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close"></button>
                </div>

                <div class="modal-body text-center py-4">
                    <div class="mb-3">
                        <i class="fas fa-sign-out-alt fa-2x text-secondary"></i>
                    </div>

                    <h6 class="fw-bold">
                        Are you sure you want to logout?
                    </h6>

                    <p class="text-muted mb-0">
                        You will be signed out of HemaCore.
                    </p>
                </div>

                <div class="modal-footer justify-content-center">
                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <form asp-controller="Account"
                          asp-action="Logout"
                          method="post">

                        @Html.AntiForgeryToken()

                        <button type="submit" class="btn btn-danger">
                            <i class="fas fa-sign-out-alt me-1"></i>
                            Logout
                        </button>
                    </form>
                </div>

            </div>
        </div>
    </div>

    <!-- BOOTSTRAP -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- SIDEBAR TOGGLE -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
        const sidebar = document.getElementById("sidebar");
        const content = document.getElementById("content");
        const toggleBtn = document.getElementById("sidebarToggle");

        if (!sidebar || !content || !toggleBtn) {
        return;
        }

        const icon = toggleBtn.querySelector("i");

        toggleBtn.addEventListener("click", function () {
        sidebar.classList.toggle("collapsed");
        content.classList.toggle("expanded");

        if (sidebar.classList.contains("collapsed")) {
        icon.classList.remove("fa-angle-left");
        icon.classList.add("fa-angle-right");
        } else {
        icon.classList.remove("fa-angle-right");
        icon.classList.add("fa-angle-left");
        }
        });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
