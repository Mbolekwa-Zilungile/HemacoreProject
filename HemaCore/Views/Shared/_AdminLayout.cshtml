
<!DOCTYPE html>
<html data-theme="midnight">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - HemaCore</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Layout.css" asp-append-version="true" />
</head>

<body>
    <div class="wrapper">

        <!-- SIDEBAR -->
        <nav id="sidebar">

            <!-- SIDEBAR HEADER -->
            <div class="sidebar-header">
                <div class="header-top">
                    <button id="sidebarToggle"
                            class="toggle-btn"
                            type="button"
                            aria-label="Toggle sidebar">
                        <i class="fas fa-angle-left"></i>
                    </button>

                    <h3>HemaCore</h3>
                </div>

                <p>ADMIN PORTAL</p>
            </div>

            <!-- NAVIGATION MENU -->
            <ul class="list-unstyled components">

                <!-- OVERVIEW -->
                <li class="section-label">OVERVIEW</li>

                <li class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                    <a asp-controller="Admin" asp-action="Index">
                        <i class="fas fa-home"></i>
                        <span class="menu-text">Dashboard</span>
                    </a>
                </li>

                <!-- CLINICAL -->
                <li class="section-label">CLINICAL</li>

                <li class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Conditions" ? "active" : "")">
                    <a asp-controller="Admin" asp-action="Conditions">
                        <i class="fas fa-notes-medical"></i>
                        <span class="menu-text">Conditions</span>
                    </a>
                </li>

                <li class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Allergies" ? "active" : "")">
                    <a asp-controller="Admin" asp-action="Allergies">
                        <i class="fas fa-allergies"></i>
                        <span class="menu-text">Allergies</span>
                    </a>
                </li>

                <li class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Medications" ? "active" : "")">
                    <a asp-controller="Admin" asp-action="Medications">
                        <i class="fas fa-pills"></i>
                        <span class="menu-text">Medications</span>
                    </a>
                </li>

                <!-- CATEGORIES -->
                <li class="section-label">CATEGORIES</li>

                <li class="@(ViewContext.RouteData.Values["action"]?.ToString() == "ConditionCategories" ? "active" : "")">
                    <a asp-controller="Admin" asp-action="ConditionCategories">
                        <i class="fas fa-folder-open"></i>
                        <span class="menu-text">Condition Categories</span>
                    </a>
                </li>

                <li class="@(ViewContext.RouteData.Values["action"]?.ToString() == "AllergyCategories" ? "active" : "")">
                    <a asp-controller="Admin" asp-action="AllergyCategories">
                        <i class="fas fa-folder-open"></i>
                        <span class="menu-text">Allergy Categories</span>
                    </a>
                </li>

                <li class="@(ViewContext.RouteData.Values["action"]?.ToString() == "MedicationCategories" ? "active" : "")">
                    <a asp-controller="Admin" asp-action="MedicationCategories">
                        <i class="fas fa-folder-open"></i>
                        <span class="menu-text">Medication Categories</span>
                    </a>
                </li>

                <!-- REPORTING -->
                <li class="section-label">REPORTING</li>

                <li class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Reports" ? "active" : "")">
                    <a asp-controller="Admin" asp-action="Reports">
                        <i class="fas fa-chart-bar"></i>
                        <span class="menu-text">Reports</span>
                    </a>
                </li>

                <!-- ACCOUNT -->
                <li class="section-label">ACCOUNT</li>

                <li class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Profile" ? "active" : "")">
                    <a asp-controller="Admin" asp-action="Profile">
                        <i class="fas fa-user-cog"></i>
                        <span class="menu-text">Profile</span>
                    </a>
                </li>

            </ul>

            <!-- LOGOUT -->
            <div class="logout">
                <a asp-controller="Account" asp-action="Logout">
                    <i class="fas fa-sign-out-alt"></i>
                    <span class="menu-text">Logout</span>
                </a>
            </div>

        </nav>

        <!-- MAIN CONTENT -->
        <div id="content">

            <!-- TOP RIGHT ADMIN ACCOUNT -->
            <div class="top-manager-account">

                <a asp-controller="Admin"
                   asp-action="Profile"
                   class="top-manager-account"
                   style="text-decoration: none; border: none; color: inherit;">

                    <div class="top-manager-avatar">
                        <i class="fas fa-user-shield"></i>
                    </div>

                    <div class="top-manager-info">
                        <span class="top-manager-name">
                            @(User.FindFirst("FullName")?.Value
                                ?? User.Identity?.Name
                                ?? "Administrator")
                        </span>

                        <small>Administrator</small>
                    </div>

                </a>
            </div>

            <!-- PAGE CONTENT -->
            <div class="page-content">
                @RenderBody()
            </div>

        </div>

    </div>

    <!-- BOOTSTRAP -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- SIDEBAR TOGGLE -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
        const sidebar = document.getElementById("sidebar");
        const content = document.getElementById("content");
        const toggleBtn = document.getElementById("sidebarToggle");

        if (!sidebar || !content || !toggleBtn) {
        return;
        }

        const icon = toggleBtn.querySelector("i");

        toggleBtn.addEventListener("click", function () {
        sidebar.classList.toggle("collapsed");
        content.classList.toggle("expanded");

        if (sidebar.classList.contains("collapsed")) {
        icon.classList.replace("fa-angle-left", "fa-angle-right");
        } else {
        icon.classList.replace("fa-angle-right", "fa-angle-left");
        }
        });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
