<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title - HemaCore</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        /* ================= RESET ================= */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --color-primary-dark: #0C447C;
            --color-primary-darker: #0a3a6a;
            --color-primary-light: #E6F1FB;
            --color-accent: #EF9F27;
            --color-background: #eef2f7;
            --color-text-primary: #1a2634;
            --color-text-secondary: #5b6c7f;
            --color-border-tertiary: #e2e6ed;
            --sidebar-width: 260px;
            --sidebar-collapsed: 72px;
        }

        html, body {
            height: 100%;
        }

        body {
            font-family: system-ui, -apple-system, 'Segoe UI', 'Roboto',
                         'Helvetica Neue', sans-serif;
            background: var(--color-background);
            color: var(--color-text-primary);
            overflow-x: hidden;
        }

        .wrapper {
            display: flex;
            width: 100%;
            min-height: 100vh;
            align-items: stretch;
        }

        /* ================= SIDEBAR ================= */
        #sidebar {
            min-width: var(--sidebar-width);
            max-width: var(--sidebar-width);
            min-height: 100vh;
            background: linear-gradient(180deg,
                        var(--color-primary-dark) 0%,
                        var(--color-primary-darker) 100%);
            color: #fff;
            transition: all 0.3s ease;
            display: flex;
            flex-direction: column;
            position: sticky;
            top: 0;
            height: 100vh;
            overflow-y: auto;
            overflow-x: hidden;
            z-index: 100;
        }

        #sidebar::-webkit-scrollbar {
            width: 6px;
        }

        #sidebar::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.15);
            border-radius: 3px;
        }

        #sidebar.collapsed {
            min-width: var(--sidebar-collapsed);
            max-width: var(--sidebar-collapsed);
        }

        #sidebar.collapsed .menu-text,
        #sidebar.collapsed .sidebar-header p,
        #sidebar.collapsed .sidebar-header h3,
        #sidebar.collapsed .section-label {
            display: none;
        }

        #sidebar.collapsed .components a,
        #sidebar.collapsed .logout a {
            justify-content: center;
            padding: 14px 0;
        }

        #sidebar.collapsed .components a i,
        #sidebar.collapsed .logout a i {
            margin-right: 0;
            font-size: 18px;
        }

        #sidebar.collapsed .header-top {
            justify-content: center;
        }

        /* ============ SIDEBAR HEADER ============ */
        .sidebar-header {
            padding: 20px 18px 18px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            flex-shrink: 0;
        }

        .header-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
        }

        .sidebar-header h3 {
            font-size: 20px;
            font-weight: 700;
            letter-spacing: 0.5px;
            white-space: nowrap;
            color: #fff;
        }

        .sidebar-header p {
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 1.2px;
            opacity: 0.7;
            margin-top: 6px;
            color: #fff;
        }

        .toggle-btn {
            background: rgba(255, 255, 255, 0.12);
            border: none;
            color: #fff;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            cursor: pointer;
            transition: background 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .toggle-btn:hover {
            background: rgba(255, 255, 255, 0.25);
        }

        /* ============ MENU LIST ============ */
        .components {
            list-style: none;
            padding: 12px 0;
            flex: 1;
        }

        .section-label {
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.2px;
            color: rgba(255, 255, 255, 0.45);
            padding: 18px 22px 6px;
        }

        .components li {
            list-style: none;
        }

        .components li a {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 22px;
            color: rgba(255, 255, 255, 0.85);
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            border-left: 3px solid transparent;
            transition: all 0.2s;
        }

        .components li a:hover {
            background: rgba(255, 255, 255, 0.08);
            color: #fff;
        }

        .components li.active a {
            background: rgba(255, 255, 255, 0.12);
            color: #fff;
            border-left-color: var(--color-accent);
        }

        .components li a i {
            min-width: 20px;
            text-align: center;
            font-size: 15px;
        }

        /* ============ LOGOUT ============ */
        .logout {
            padding: 14px 0 20px;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            margin-top: auto;
            flex-shrink: 0;
        }

        .logout a {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 22px;
            color: rgba(255, 255, 255, 0.85);
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            transition: all 0.2s;
        }

        .logout a:hover {
            background: rgba(255, 255, 255, 0.08);
            color: #fff;
        }

        /* ================= CONTENT ================= */
        #content {
            flex: 1;
            width: 100%;
            min-height: 100vh;
            transition: all 0.3s ease;
            overflow-x: hidden;
        }

        /* ================= RESPONSIVE ================= */
        @@media (max-width: 768px) {
            #sidebar {
                min-width: var(--sidebar-collapsed);
                max-width: var(--sidebar-collapsed);
            }

            #sidebar .menu-text,
            #sidebar .sidebar-header p,
            #sidebar .sidebar-header h3,
            #sidebar .section-label {
                display: none;
            }

            #sidebar .components a,
            #sidebar .logout a {
                justify-content: center;
                padding: 14px 0;
            }

            #sidebar .components a i,
            #sidebar .logout a i {
                font-size: 18px;
            }

            #sidebar .header-top {
                justify-content: center;
            }
        }
    </style>
</head>

<body>

    <div class="wrapper">

        <!-- ================= SIDEBAR ================= -->
        <nav id="sidebar">

            <div class="sidebar-header">
                <div class="header-top">
                    <button id="sidebarToggle" class="toggle-btn">
                        <i class="fas fa-angle-left"></i>
                    </button>

                    <h3>HemaCore</h3>
                </div>

                <p>Patient Portal</p>
            </div>

            <ul class="list-unstyled components">

                <!-- ============ OVERVIEW ============ -->
                <li class="section-label">OVERVIEW</li>

                <li class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")">
                    <a asp-controller="Patient" asp-action="Dashboard">
                        <i class="fas fa-home"></i>
                        <span class="menu-text">Dashboard</span>
                    </a>
                </li>

                <!-- ============ LABORATORY ============ -->
                <li class="section-label">LABORATORY</li>

                <li class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Tests" ? "active" : "")">
                    <a asp-controller="Patient" asp-action="Tests">
                        <i class="fas fa-vials"></i>
                        <span class="menu-text">Tests</span>
                    </a>
                </li>

                <li class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Result" ? "active" : "")">
                    <a asp-controller="Patient" asp-action="Result">
                        <i class="fas fa-file-medical-alt"></i>
                        <span class="menu-text">Results</span>
                    </a>
                </li>

                <li class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Health" ? "active" : "")">
                    <a asp-controller="Patient" asp-action="Health">
                        <i class="fas fa-heartbeat"></i>
                        <span class="menu-text">My Health</span>
                    </a>
                </li>

                <li class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Consent" ? "active" : "")">
                    <a asp-controller="Patient" asp-action="Consent">
                        <i class="fas fa-file-signature"></i>
                        <span class="menu-text">Consent</span>
                    </a>
                </li>

                <!-- ============ PROFILE ============ -->
                <li class="section-label">PROFILE</li>

                <li class="@(ViewContext.RouteData.Values["action"]?.ToString() == "CompleteProfile" ? "active" : "")">
                    <a asp-controller="Patient" asp-action="CompleteProfile">
                        <i class="fas fa-user-plus"></i>
                        <span class="menu-text">Complete Profile</span>
                    </a>
                </li>

                <li class="@(ViewContext.RouteData.Values["action"]?.ToString() == "PatientDetails" ? "active" : "")">
                    <a asp-controller="Patient" asp-action="PatientDetails">
                        <i class="fas fa-id-card"></i>
                        <span class="menu-text">My Details</span>
                    </a>
                </li>

                <li class="@(ViewContext.RouteData.Values["action"]?.ToString() == "EditProfile" ? "active" : "")">
                    <a asp-controller="Patient" asp-action="EditProfile">
                        <i class="fas fa-user-edit"></i>
                        <span class="menu-text">Edit Profile</span>
                    </a>
                </li>

                <li class="@(ViewContext.RouteData.Values["action"]?.ToString() == "ChangePassword" ? "active" : "")">
                    <a asp-controller="Patient" asp-action="ChangePassword">
                        <i class="fas fa-key"></i>
                        <span class="menu-text">Change Password</span>
                    </a>
                </li>

                <!-- ============ REPORTING ============ -->
                <li class="section-label">REPORTING</li>

                <li class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Report" ? "active" : "")">
                    <a asp-controller="Patient" asp-action="Report">
                        <i class="fas fa-chart-bar"></i>
                        <span class="menu-text">Reports</span>
                    </a>
                </li>

            </ul>

            <!-- ============ LOGOUT ============ -->
            <div class="logout">
                <a asp-controller="Account" asp-action="Logout">
                    <i class="fas fa-sign-out-alt"></i>
                    <span class="menu-text">Logout</span>
                </a>
            </div>

        </nav>

        <!-- ================= CONTENT ================= -->
        <div id="content">
            @RenderBody()
        </div>

    </div>

    <!-- ================= SIDEBAR TOGGLE SCRIPT ================= -->
    <script>
        (function () {
            const sidebar   = document.getElementById("sidebar");
            const content   = document.getElementById("content");
            const toggleBtn = document.getElementById("sidebarToggle");
            const icon      = toggleBtn.querySelector("i");

            toggleBtn.addEventListener("click", function () {
                sidebar.classList.toggle("collapsed");
                content.classList.toggle("expanded");

                if (sidebar.classList.contains("collapsed")) {
                    icon.classList.remove("fa-angle-left");
                    icon.classList.add("fa-angle-right");
                } else {
                    icon.classList.remove("fa-angle-right");
                    icon.classList.add("fa-angle-left");
                }
            });
        })();
    </script>

    @RenderSection("Scripts", required: false)

</body>
</html>