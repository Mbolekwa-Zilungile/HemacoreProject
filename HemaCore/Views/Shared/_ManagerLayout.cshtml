<!DOCTYPE html>
<html data-theme="midnight">
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>

    <link rel="stylesheet" href="~/css/Layout.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
</head>

<body>
    <div class="wrapper">

        <!-- SIDEBAR -->
        <nav id="sidebar">

            <!-- SIDEBAR HEADER -->
            <div class="sidebar-header">
                <div class="header-top">
                    <button id="sidebarToggle" class="toggle-btn" type="button">
                        <i class="fas fa-angle-left"></i>
                    </button>

                    <h3>HemaCore</h3>
                </div>

                <p>LAB MANAGER PORTAL</p>
            </div>

            <!-- NAVIGATION MENU -->
            <ul class="list-unstyled components">

                <!-- OVERVIEW -->
                <li class="section-label">OVERVIEW</li>

                <li class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                    <a asp-controller="Manager" asp-action="Index">
                        <i class="fas fa-home"></i>
                        <span class="menu-text">Dashboard</span>
                    </a>
                </li>

                <!-- TEST CATALOGUE -->
                <li class="section-label">TEST CATALOGUE</li>

                <li class="@(ViewContext.RouteData.Values["action"]?.ToString() == "TestCategories" ? "active" : "")">
                    <a asp-controller="Manager" asp-action="TestCategories">
                        <i class="fas fa-folder"></i>
                        <span class="menu-text">Test Categories</span>
                    </a>
                </li>

                <li class="@(ViewContext.RouteData.Values["action"]?.ToString() == "TestTypes" ? "active" : "")">
                    <a asp-controller="Manager" asp-action="TestTypes">
                        <i class="fas fa-microscope"></i>
                        <span class="menu-text">Test Types</span>
                    </a>
                </li>

                <li class="@(ViewContext.RouteData.Values["action"]?.ToString() == "SampleTypes" ? "active" : "")">
                    <a asp-controller="Manager" asp-action="SampleTypes">
                        <i class="fas fa-vial"></i>
                        <span class="menu-text">Sample Types</span>
                    </a>
                </li>

                <!-- STOCK MANAGEMENT -->
                <li class="section-label">STOCK MANAGEMENT</li>

                <li class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Consumables" ? "active" : "")">
                    <a asp-controller="Manager" asp-action="Consumables">
                        <i class="fas fa-box"></i>
                        <span class="menu-text">Consumables</span>
                    </a>
                </li>

                <li class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Suppliers" ? "active" : "")">
                    <a asp-controller="Manager" asp-action="Suppliers">
                        <i class="fas fa-industry"></i>
                        <span class="menu-text">Suppliers</span>
                    </a>
                </li>

                <li class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Orders" ? "active" : "")">
                    <a asp-controller="Manager" asp-action="Orders">
                        <i class="fas fa-shopping-cart"></i>
                        <span class="menu-text">Orders</span>
                    </a>
                </li>

                <!-- USER MANAGEMENT -->
                <li class="section-label">USER MANAGEMENT</li>

                <li class="@(
                    ViewContext.RouteData.Values["action"]?.ToString() == "Doctors" ||
                    ViewContext.RouteData.Values["action"]?.ToString() == "InactiveDoctors"
                    ? "active" : "")">
                    <a asp-controller="Manager" asp-action="Doctors">
                        <i class="fas fa-user-doctor"></i>
                        <span class="menu-text">Doctors</span>
                    </a>
                </li>

                <li class="@(ViewContext.RouteData.Values["action"]?.ToString() == "LabTechnician" ? "active" : "")">
                    <a asp-controller="Manager" asp-action="LabTechnician">
                        <i class="fas fa-user-nurse"></i>
                        <span class="menu-text">Technicians</span>
                    </a>
                </li>

                <!-- REPORTING -->
                <li class="section-label">REPORTING</li>

                <li class="@(ViewContext.RouteData.Values["action"]?.ToString() == "TestsPerformedReport" ? "active" : "")">
                    <a asp-controller="Manager" asp-action="TestsPerformedReport">
                        <i class="fas fa-chart-column"></i>
                        <span class="menu-text">Reports</span>
                    </a>
                </li>

            </ul>

            <!-- LOGOUT -->
            <div class="logout">
                <a href="#"
                   data-bs-toggle="modal"
                   data-bs-target="#logoutModal">
                    <i class="fas fa-sign-out-alt"></i>
                    <span class="menu-text">Logout</span>
                </a>
            </div>

        </nav>

        <div id="content">

            <!-- TOP RIGHT MANAGER ACCOUNT -->
            <div class="top-manager-account">

                <a asp-controller="Manager"
                   asp-action="ManagerDetails"
                   class="top-manager-account"
                   style="text-decoration: none; border: none; color: inherit;">
                    <div class="top-manager-avatar">
                        <i class="fas fa-user-tie"></i>
                    </div>

                    <div class="top-manager-info">
                        <span class="top-manager-name">
                            @(User.FindFirst("FullName")?.Value
                                ?? User.Identity?.Name
                                ?? "Manager")
                        </span>

                        <small>Laboratory Manager</small>
                    </div>
                </a>
            </div>

            <!-- PAGE CONTENT -->
            <div class="page-content">
                @RenderBody()
            </div>

        </div>
        <div class="modal fade"
             id="logoutModal"
             tabindex="-1"
             aria-labelledby="logoutModalLabel"
             aria-hidden="true">

            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow">

                    <div class="modal-header">
                        <h5 class="modal-title fw-bold" id="logoutModalLabel">
                            Confirm Logout
                        </h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Close"></button>
                    </div>

                    <div class="modal-body text-center py-4">
                        <div class="mb-3">
                            <i class="fas fa-sign-out-alt fa-2x text-secondary"></i>
                        </div>

                        <h6 class="fw-bold">
                            Are you sure you want to logout?
                        </h6>

                        <p class="text-muted mb-0">
                            You will be signed out of HemaCore.
                        </p>
                    </div>

                    <div class="modal-footer justify-content-center">
                        <button type="button"
                                class="btn btn-secondary"
                                data-bs-dismiss="modal">
                            Cancel
                        </button>

                        <form asp-controller="Account"
                              asp-action="Logout"
                              method="post">

                            @Html.AntiForgeryToken()

                            <button type="submit" class="btn btn-danger">
                                <i class="fas fa-sign-out-alt me-1"></i>
                                Logout
                            </button>
                        </form>
                    </div>

                </div>
            </div>

      
        <!-- BOOTSTRAP -->
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

        <!-- SIDEBAR TOGGLE -->
        <script>
            document.addEventListener("DOMContentLoaded", function () {
            const sidebar = document.getElementById("sidebar");
            const content = document.getElementById("content");
            const toggleBtn = document.getElementById("sidebarToggle");

            if (!sidebar || !content || !toggleBtn) {
            return;
            }

            const icon = toggleBtn.querySelector("i");

            toggleBtn.addEventListener("click", function () {
            sidebar.classList.toggle("collapsed");
            content.classList.toggle("expanded");

            if (sidebar.classList.contains("collapsed")) {
            icon.classList.remove("fa-angle-left");
            icon.classList.add("fa-angle-right");
            } else {
            icon.classList.remove("fa-angle-right");
            icon.classList.add("fa-angle-left");
            }
            });
            });
        </script>

        @RenderSection("Scripts", required: false)

    </body>
</html>
