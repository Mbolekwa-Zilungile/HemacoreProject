@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_AdminLayout";
}

<div class="admin-dashboard">

    <!-- HEADER -->
    <div class="dashboard-header">

        <div>
            <div class="dashboard-label">
                <i class="bi bi-shield-check"></i>
                Administration
            </div>

            <h1>Admin Dashboard</h1>

            <p>
                Manage your healthcare information from one place.
            </p>
        </div>

        <button type="button"
                class="refresh-button"
                onclick="refreshDashboard()">

            <i class="bi bi-arrow-clockwise" id="refreshIcon"></i>
            Refresh

        </button>

    </div>


    <!-- STAT CARDS -->
    <div class="row g-4 mb-4">

        <!-- CONDITIONS -->
        <div class="col-xl-4 col-md-6">

            <a asp-controller="Admin"
               asp-action="Conditions"
               class="stat-card">

                <div class="stat-icon condition-icon">
                    <i class="bi bi-heart-pulse-fill"></i>
                </div>

                <div class="stat-content">

                    <span>Conditions</span>

                    <h2 id="conditionCount">
                        @(ViewBag.ConditionCount ?? 0)
                    </h2>

                    <small>
                        <span id="conditionCategoryCount">
                            @(ViewBag.ConditionCategoryCount ?? 0)
                        </span>
                        categories
                    </small>

                </div>

                <i class="bi bi-chevron-right card-arrow"></i>

            </a>

        </div>


        <!-- ALLERGIES -->
        <div class="col-xl-4 col-md-6">

            <a asp-controller="Admin"
               asp-action="Allergies"
               class="stat-card">

                <div class="stat-icon allergy-icon">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                </div>

                <div class="stat-content">

                    <span>Allergies</span>

                    <h2 id="allergyCount">
                        @(ViewBag.AllergyCount ?? 0)
                    </h2>

                    <small>
                        <span id="allergyCategoryCount">
                            @(ViewBag.AllergyCategoryCount ?? 0)
                        </span>
                        categories
                    </small>

                </div>

                <i class="bi bi-chevron-right card-arrow"></i>

            </a>

        </div>


        <!-- MEDICATIONS -->
        <div class="col-xl-4 col-md-6">

            <a asp-controller="Admin"
               asp-action="Medications"
               class="stat-card">

                <div class="stat-icon medication-icon">
                    <i class="bi bi-capsule-pill"></i>
                </div>

                <div class="stat-content">

                    <span>Medications</span>

                    <h2 id="medicationCount">
                        @(ViewBag.MedicationCount ?? 0)
                    </h2>

                    <small>
                        <span id="medicationCategoryCount">
                            @(ViewBag.MedicationCategoryCount ?? 0)
                        </span>
                        categories
                    </small>

                </div>

                <i class="bi bi-chevron-right card-arrow"></i>

            </a>

        </div>

    </div>


    <!-- PATIENT RECORDS -->
    <a asp-controller="Admin"
       asp-action="Conditions"
       class="records-banner">

        <div class="records-icon">
            <i class="bi bi-clipboard2-pulse-fill"></i>
        </div>

        <div class="records-content">

            <span>Patient Medical Records</span>

            <strong id="patientRecordCount">
                @(ViewBag.PatientRecordCount ?? 0)
            </strong>

            <small>
                Conditions, allergies and medication records
            </small>

        </div>

        <div class="records-action">
            View
            <i class="bi bi-arrow-right"></i>
        </div>

    </a>


    <!-- QUICK MANAGEMENT -->
    <div class="section-title">

        <div>
            <h3>
                <i class="bi bi-grid-fill"></i>
                Quick Management
            </h3>

            <p>
                Select an area to manage.
            </p>
        </div>

    </div>


    <div class="row g-3 mb-5">

        <!-- CONDITIONS -->
        <div class="col-lg-4 col-md-6">

            <a asp-controller="Admin"
               asp-action="Conditions"
               class="management-card">

                <div class="management-icon condition-bg">
                    <i class="bi bi-heart-pulse-fill"></i>
                </div>

                <div>
                    <h4>Conditions</h4>
                    <p>Manage medical conditions</p>
                </div>

                <i class="bi bi-arrow-right"></i>

            </a>

        </div>


        <!-- CONDITION CATEGORIES -->
        <div class="col-lg-4 col-md-6">

            <a asp-controller="Admin"
               asp-action="ConditionCategories"
               class="management-card">

                <div class="management-icon category-bg">
                    <i class="bi bi-folder-fill"></i>
                </div>

                <div>
                    <h4>Condition Categories</h4>
                    <p>Manage condition categories</p>
                </div>

                <i class="bi bi-arrow-right"></i>

            </a>

        </div>


        <!-- ALLERGIES -->
        <div class="col-lg-4 col-md-6">

            <a asp-controller="Admin"
               asp-action="Allergies"
               class="management-card">

                <div class="management-icon allergy-bg">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                </div>

                <div>
                    <h4>Allergies</h4>
                    <p>Manage allergies</p>
                </div>

                <i class="bi bi-arrow-right"></i>

            </a>

        </div>


        <!-- ALLERGY CATEGORIES -->
        <div class="col-lg-4 col-md-6">

            <a asp-controller="Admin"
               asp-action="AllergyCategories"
               class="management-card">

                <div class="management-icon warning-bg">
                    <i class="bi bi-tags-fill"></i>
                </div>

                <div>
                    <h4>Allergy Categories</h4>
                    <p>Manage allergy categories</p>
                </div>

                <i class="bi bi-arrow-right"></i>

            </a>

        </div>


        <!-- MEDICATIONS -->
        <div class="col-lg-4 col-md-6">

            <a asp-controller="Admin"
               asp-action="Medications"
               class="management-card">

                <div class="management-icon medication-bg">
                    <i class="bi bi-capsule-pill"></i>
                </div>

                <div>
                    <h4>Medications</h4>
                    <p>Manage medications</p>
                </div>

                <i class="bi bi-arrow-right"></i>

            </a>

        </div>


        <!-- MEDICATION CATEGORIES -->
        <div class="col-lg-4 col-md-6">

            <a asp-controller="Admin"
               asp-action="MedicationCategories"
               class="management-card">

                <div class="management-icon medicine-category-bg">
                    <i class="bi bi-collection-fill"></i>
                </div>

                <div>
                    <h4>Medication Categories</h4>
                    <p>Manage medication categories</p>
                </div>

                <i class="bi bi-arrow-right"></i>

            </a>

        </div>

    </div>


    <!-- CREATE NEW -->
    <div class="section-title">

        <div>
            <h3>
                <i class="bi bi-plus-circle-fill"></i>
                Add New
            </h3>

            <p>
                Quickly add information to the system.
            </p>
        </div>

    </div>


    <div class="row g-3">

        <!-- ADD CONDITION -->
        <div class="col-lg-4">

            <a asp-controller="Admin"
               asp-action="AddCondition"
               class="add-card">

                <div class="add-icon condition-bg">
                    <i class="bi bi-plus-lg"></i>
                </div>

                <div>
                    <strong>Add Condition</strong>
                    <span>Create a medical condition</span>
                </div>

                <i class="bi bi-arrow-up-right"></i>

            </a>

        </div>


        <!-- ADD ALLERGY -->
        <div class="col-lg-4">

            <a asp-controller="Admin"
               asp-action="AddAllergy"
               class="add-card">

                <div class="add-icon allergy-bg">
                    <i class="bi bi-plus-lg"></i>
                </div>

                <div>
                    <strong>Add Allergy</strong>
                    <span>Create an allergy</span>
                </div>

                <i class="bi bi-arrow-up-right"></i>

            </a>

        </div>


        <!-- ADD MEDICATION -->
        <div class="col-lg-4">

            <a asp-controller="Admin"
               asp-action="AddMedication"
               class="add-card">

                <div class="add-icon medication-bg">
                    <i class="bi bi-plus-lg"></i>
                </div>

                <div>
                    <strong>Add Medication</strong>
                    <span>Create a medication</span>
                </div>

                <i class="bi bi-arrow-up-right"></i>

            </a>

        </div>

    </div>

</div>


<!-- BOOTSTRAP ICONS -->
<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">


<style>

    /* =====================================
           GENERAL
        ===================================== */

    .admin-dashboard {
        background: #f7f9fc;
        min-height: 100vh;
        padding: 30px;
    }


    /* =====================================
           HEADER
        ===================================== */

    .dashboard-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 30px;
    }

    .dashboard-label {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        color: #3157c7;
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 6px;
    }

    .dashboard-header h1 {
        margin: 0;
        color: #172033;
        font-size: 30px;
        font-weight: 800;
    }

    .dashboard-header p {
        margin: 6px 0 0;
        color: #718096;
        font-size: 14px;
    }

    .refresh-button {
        border: 1px solid #e1e7ef;
        background: white;
        color: #475569;
        padding: 10px 16px;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: .2s;
    }

        .refresh-button:hover {
            background: #f1f5f9;
            color: #3157c7;
        }

        .refresh-button i {
            margin-right: 6px;
        }


    /* =====================================
           STAT CARDS
        ===================================== */

    .stat-card {
        display: flex;
        align-items: center;
        gap: 17px;
        position: relative;
        min-height: 130px;
        padding: 22px;
        background: white;
        border: 1px solid #e7ebf1;
        border-radius: 17px;
        text-decoration: none !important;
        color: inherit !important;
        box-shadow: 0 4px 16px rgba(15,23,42,.04);
        transition: .25s ease;
    }

        .stat-card:hover {
            transform: translateY(-5px);
            border-color: #3157c7;
            box-shadow: 0 12px 30px rgba(49,87,199,.12);
        }

    .stat-icon {
        width: 60px;
        height: 60px;
        min-width: 60px;
        border-radius: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 25px;
    }

    .stat-content {
        flex: 1;
    }

        .stat-content span {
            display: block;
            color: #64748b;
            font-size: 13px;
            margin-bottom: 3px;
        }

        .stat-content h2 {
            margin: 0;
            color: #172033;
            font-size: 30px;
            font-weight: 800;
        }

        .stat-content small {
            color: #94a3b8;
            font-size: 11px;
        }

    .card-arrow {
        color: #a5afbd;
        font-size: 17px;
        transition: .2s;
    }

    .stat-card:hover .card-arrow {
        color: #3157c7;
        transform: translateX(4px);
    }


    /* =====================================
           PATIENT RECORD BANNER
        ===================================== */

    .records-banner {
        display: flex;
        align-items: center;
        gap: 18px;
        padding: 20px 23px;
        margin: 5px 0 40px;
        background: white;
        border: 1px solid #e7ebf1;
        border-radius: 17px;
        text-decoration: none !important;
        color: inherit !important;
        transition: .25s;
    }

        .records-banner:hover {
            transform: translateY(-3px);
            border-color: #3157c7;
            box-shadow: 0 10px 25px rgba(15,23,42,.07);
        }

    .records-icon {
        width: 52px;
        height: 52px;
        min-width: 52px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eef2ff;
        color: #4f46e5;
        font-size: 22px;
    }

    .records-content {
        flex: 1;
    }

        .records-content span {
            display: block;
            color: #64748b;
            font-size: 13px;
        }

        .records-content strong {
            display: inline-block;
            color: #172033;
            font-size: 25px;
            font-weight: 800;
            margin-right: 8px;
        }

        .records-content small {
            color: #94a3b8;
            font-size: 12px;
        }

    .records-action {
        color: #3157c7;
        font-size: 13px;
        font-weight: 700;
    }

        .records-action i {
            margin-left: 5px;
        }


    /* =====================================
           SECTION TITLE
        ===================================== */

    .section-title {
        margin-bottom: 18px;
    }

        .section-title h3 {
            margin: 0;
            color: #172033;
            font-size: 19px;
            font-weight: 750;
        }

            .section-title h3 i {
                color: #3157c7;
                margin-right: 7px;
            }

        .section-title p {
            margin: 5px 0 0 27px;
            color: #718096;
            font-size: 13px;
        }


    /* =====================================
           MANAGEMENT CARDS
        ===================================== */

    .management-card {
        display: flex;
        align-items: center;
        gap: 14px;
        min-height: 105px;
        padding: 18px;
        background: white;
        border: 1px solid #e7ebf1;
        border-radius: 15px;
        text-decoration: none !important;
        color: inherit !important;
        transition: .25s ease;
    }

        .management-card:hover {
            transform: translateY(-4px);
            border-color: #3157c7;
            box-shadow: 0 10px 25px rgba(15,23,42,.08);
        }

    .management-icon {
        width: 50px;
        height: 50px;
        min-width: 50px;
        border-radius: 13px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 21px;
    }

    .management-card > div:nth-child(2) {
        flex: 1;
    }

    .management-card h4 {
        margin: 0 0 4px;
        color: #172033;
        font-size: 15px;
        font-weight: 700;
    }

    .management-card p {
        margin: 0;
        color: #718096;
        font-size: 12px;
    }

    .management-card > i {
        color: #a5afbd;
        transition: .2s;
    }

    .management-card:hover > i {
        color: #3157c7;
        transform: translateX(4px);
    }


    /* =====================================
           ADD CARDS
        ===================================== */

    .add-card {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 18px;
        min-height: 90px;
        background: white;
        border: 1px dashed #d5dce7;
        border-radius: 15px;
        text-decoration: none !important;
        color: inherit !important;
        transition: .25s ease;
    }

        .add-card:hover {
            transform: translateY(-3px);
            border-style: solid;
            border-color: #3157c7;
            box-shadow: 0 10px 25px rgba(15,23,42,.07);
        }

    .add-icon {
        width: 46px;
        height: 46px;
        min-width: 46px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
    }

    .add-card > div:nth-child(2) {
        flex: 1;
    }

    .add-card strong {
        display: block;
        color: #172033;
        font-size: 14px;
        margin-bottom: 3px;
    }

    .add-card span {
        color: #718096;
        font-size: 12px;
    }

    .add-card > i {
        color: #a5afbd;
    }


    /* =====================================
           COLORS
        ===================================== */

    .condition-icon,
    .condition-bg {
        background: #eaf1ff;
        color: #2563eb;
    }

    .allergy-icon,
    .allergy-bg {
        background: #fff0e8;
        color: #ea580c;
    }

    .medication-icon,
    .medication-bg {
        background: #e7f8ef;
        color: #16a34a;
    }

    .category-bg {
        background: #efedff;
        color: #6366f1;
    }

    .warning-bg {
        background: #fff8dc;
        color: #ca8a04;
    }

    .medicine-category-bg {
        background: #e6f8f7;
        color: #0f766e;
    }


    /* =====================================
           MOBILE
        ===================================== */

    @@media (max-width: 768px) {

        .admin-dashboard {
            padding: 20px 15px;
        }

        .dashboard-header {
            align-items: flex-start;
            flex-direction: column;
            gap: 15px;
        }

        .refresh-button {
            width: 100%;
        }

        .dashboard-header h1 {
            font-size: 25px;
        }

        .records-banner {
            align-items: flex-start;
        }

        .records-action {
            display: none;
        }

        .records-content small {
            display: block;
        }
    }

</style>


<script>

    async function refreshDashboard() {

        const icon = document.getElementById("refreshIcon");

        if (icon) {
            icon.classList.add("spin");
        }

        try {

            const response = await fetch(
                '@Url.Action("DashboardStats", "Admin")',
                {
                    method: 'GET',
                    cache: 'no-store'
                }
            );

            if (!response.ok) {
                throw new Error("Unable to load dashboard statistics.");
            }

            const data = await response.json();


            document.getElementById("conditionCount").textContent =
                data.conditionCount;

            document.getElementById("conditionCategoryCount").textContent =
                data.conditionCategoryCount;


            document.getElementById("allergyCount").textContent =
                data.allergyCount;

            document.getElementById("allergyCategoryCount").textContent =
                data.allergyCategoryCount;


            document.getElementById("medicationCount").textContent =
                data.medicationCount;

            document.getElementById("medicationCategoryCount").textContent =
                data.medicationCategoryCount;


            document.getElementById("patientRecordCount").textContent =
                data.patientRecordCount;

        }
        catch (error) {

            console.error(
                "Dashboard refresh failed:",
                error
            );

        }
        finally {

            if (icon) {

                setTimeout(() => {
                    icon.classList.remove("spin");
                }, 500);

            }

        }

    }


    // Automatically update the cards every 10 seconds.
    setInterval(
        refreshDashboard,
        10000
    );

</script>


<style>

    .spin {
        animation: dashboardSpin .5s linear;
    }

    @@keyframes dashboardSpin {

        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }
    }

</style>