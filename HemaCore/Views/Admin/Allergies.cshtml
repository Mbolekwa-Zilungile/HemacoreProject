@model List<HemaCore.Models.Allergy>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Allergies";
}

<link rel="stylesheet" href="~/css/doctor.css" />

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">

        @TempData["Error"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">

        @TempData["Success"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}


<div class="content-card">

    <!-- HEADER -->
    <div class="section-title d-flex align-items-center justify-content-between">

        <div class="d-flex align-items-center">

            <i class="fas fa-allergies me-2"></i>

            <span>
                All Allergies
            </span>

            <span class="badge blue-badge ms-2">
                @ViewBag.AllergyCount
            </span>

        </div>


        <div class="d-flex gap-2">

            <a asp-controller="Admin"
               asp-action="AddAllergyCategory"
               class="btn btn-success btn-sm">

                <i class="fas fa-plus me-1"></i>
                Add Category

            </a>


            <a asp-controller="Admin"
               asp-action="AddAllergy"
               class="btn btn-primary-custom btn-sm">

                <i class="fas fa-plus me-1"></i>
                Add Allergy

            </a>

        </div>

    </div>


    <!-- SEARCH AND FILTER -->
    <div class="row mb-3">

        <div class="col-md-8">

            <div class="input-group">

                <span class="input-group-text bg-transparent border-end-0">

                    <i class="fas fa-search text-muted"></i>

                </span>


                <input type="text"
                       id="searchBox"
                       class="form-control border-start-0 ps-0"
                       placeholder="Search allergies..." />

            </div>

        </div>


        <div class="col-md-4">

            <div class="input-group">

                <span class="input-group-text bg-transparent border-end-0">

                    <i class="fas fa-filter text-muted"></i>

                </span>


                <select id="categoryFilter"
                        class="form-select border-start-0 ps-0">

                    <option value="">
                        All Categories
                    </option>

                    @if (ViewBag.Categories != null)
                    {
                        foreach (var category in ViewBag.Categories)
                        {
                            <option value="@category.Id">
                                @category.Name
                            </option>
                        }
                    }

                </select>

            </div>

        </div>

    </div>


    <!-- TABLE -->
    <div class="table-responsive">

        <table class="modern-table w-100">

            <thead>

                <tr>

                    <th>
                        Allergy Name
                    </th>

                    <th>
                        Category
                    </th>

                    <th>
                        Description
                    </th>

                    <th>
                        Status
                    </th>

                    <th>
                        Actions
                    </th>

                </tr>

            </thead>


            <tbody id="allergyTable">

                @if (Model == null || !Model.Any())
                {
                    <tr>

                        <td colspan="5"
                            class="text-center text-muted">

                            No allergies available.
                            Click "Add Allergy" to create one.

                        </td>

                    </tr>
                }
                else
                {
                    foreach (var allergy in Model)
                    {
                        <tr data-category-id="@allergy.CategoryId">

                            <!-- NAME -->
                            <td class="fw-semibold blue-text">

                                @allergy.Name

                            </td>


                            <!-- CATEGORY -->
                            <td>

                                @(allergy.Category?.Name ?? "No Category")

                            </td>


                            <!-- DESCRIPTION -->
                            <td>

                                @(string.IsNullOrWhiteSpace(allergy.Description)
                                    ? "—"
                                    : allergy.Description)

                            </td>


                            <!-- STATUS -->
                            <td>

                                @if (allergy.IsActive)
                                {
                                    <span class="badge bg-success">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Inactive
                                    </span>
                                }

                            </td>


                            <!-- ACTIONS -->
                            <td>

                                <a asp-controller="Admin"
                                   asp-action="EditAllergy"
                                   asp-route-id="@allergy.Id"
                                   class="btn btn-sm btn-primary me-1">

                                    <i class="fas fa-edit me-1"></i>
                                    Edit

                                </a>


                                <form asp-controller="Admin"
                                      asp-action="ToggleAllergyStatus"
                                      method="post"
                                      class="d-inline">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@allergy.Id" />


                                    @if (allergy.IsActive)
                                    {
                                        <button type="submit"
                                                class="btn btn-sm btn-danger"
                                                onclick="return confirm('Are you sure you want to deactivate this allergy?');">

                                            <i class="fas fa-ban me-1"></i>

                                            Deactivate

                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit"
                                                class="btn btn-sm btn-success"
                                                onclick="return confirm('Are you sure you want to activate this allergy?');">

                                            <i class="fas fa-check me-1"></i>

                                            Activate

                                        </button>
                                    }

                                </form>

                            </td>

                        </tr>
                    }
                }

            </tbody>

        </table>

    </div>

</div>


<script>

    document.addEventListener("DOMContentLoaded", function() {

        const searchBox =
            document.getElementById("searchBox");

        const categoryFilter =
            document.getElementById("categoryFilter");


        function filterTable() {

            const searchTerm =
                searchBox.value
                    .toLowerCase()
                    .trim();

            const categoryId =
                categoryFilter.value;


            const rows =
                document.querySelectorAll(
                    "#allergyTable tr"
                );


            let visibleCount = 0;


            rows.forEach(function(row) {

                if (row.id === "noResultsRow") {
                    return;
                }

                if (row.querySelector("td[colspan]")) {
                    return;
                }


                const allergyName =
                    row.querySelector(
                        "td:nth-child(1)"
                    )?.textContent
                        ?.toLowerCase() || "";


                const categoryName =
                    row.querySelector(
                        "td:nth-child(2)"
                    )?.textContent
                        ?.toLowerCase() || "";


                const description =
                    row.querySelector(
                        "td:nth-child(3)"
                    )?.textContent
                        ?.toLowerCase() || "";


                const rowCategoryId =
                    row.getAttribute(
                        "data-category-id"
                    );


                const matchesSearch =
                    allergyName.includes(searchTerm) ||
                    categoryName.includes(searchTerm) ||
                    description.includes(searchTerm);


                const matchesCategory =
                    categoryId === "" ||
                    rowCategoryId === categoryId;


                if (matchesSearch && matchesCategory) {

                    row.style.display = "";

                    visibleCount++;

                }
                else {

                    row.style.display = "none";

                }

            });


            let noResultsRow =
                document.getElementById(
                    "noResultsRow"
                );


            if (visibleCount === 0 && searchTerm !== "") {

                if (!noResultsRow) {

                    noResultsRow =
                        document.createElement("tr");

                    noResultsRow.id =
                        "noResultsRow";


                    noResultsRow.innerHTML = `
                            <td colspan="5"
                                class="text-center text-muted">
                                No results found.
                            </td>
                        `;


                    document
                        .getElementById("allergyTable")
                        .appendChild(noResultsRow);

                }

            }
            else {

                if (noResultsRow) {
                    noResultsRow.remove();
                }

            }

        }


        searchBox.addEventListener(
            "input",
            filterTable
        );


        categoryFilter.addEventListener(
            "change",
            filterTable
        );

    });

</script>