@model List<HemaCore.Models.Allergy>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Allergies";
}

<link rel="stylesheet" href="~/css/doctor.css" />
<link rel="stylesheet" href="~/css/delete.css" />

<div class="content-card">

    <!-- ALERT MESSAGES -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>
            @TempData["Success"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>
            @TempData["Error"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    }

    <!-- PAGE HEADER -->
    <div class="section-title d-flex align-items-center justify-content-between flex-wrap gap-2">

        <div class="d-flex align-items-center">
            <i class="fas fa-allergies me-2"></i>
            <span>All Allergies (@(Model?.Count ?? 0))</span>
        </div>

        <div class="d-flex gap-2">
            <a asp-controller="Admin"
               asp-action="AddAllergyCategory"
               class="btn btn-primary-custom btn-sm">
                <i class="fas fa-plus me-1"></i>
                Add Category
            </a>

            <a asp-controller="Admin"
               asp-action="AddAllergy"
               class="btn btn-primary-custom btn-sm">
                <i class="fas fa-plus me-1"></i>
                Add Allergy
            </a>
        </div>

    </div>

    <!-- SEARCH AND STATUS FILTER -->
    <div class="search-toolbar">

        <div class="search-box">
            <i class="fas fa-search search-icon"></i>

            <input type="text"
                   id="searchBox"
                   class="search-input"
                   placeholder="Search allergies..."
                   autocomplete="off" />
        </div>

        <div class="filter-box">

            <label for="statusFilter" class="filter-label">
                <i class="fas fa-filter me-1"></i>
            </label>

            <div class="select-wrapper">
                <select id="statusFilter" class="filter-select">
                    <option value="all">All Allergies</option>
                    <option value="active">Active Allergies</option>
                    <option value="inactive">Inactive Allergies</option>
                </select>

                <i class="fas fa-chevron-down dropdown-icon"></i>
            </div>

        </div>

    </div>

    <!-- ALLERGIES TABLE -->
    <div class="card shadow-sm">

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="modern-table w-100">

                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Allergy Name</th>
                            <th>Category</th>
                            <th>Description</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody id="allergyTable">

                        @if (Model != null && Model.Any())
                        {
                            var number = 1;

                            foreach (var allergy in Model.OrderBy(a => a.Name))
                            {
                                <tr data-status="@(allergy.IsActive ? "active" : "inactive")">

                                    <td class="allergy-number">@number</td>

                                    <td class="fw-semibold blue-text">
                                        @allergy.Name
                                    </td>

                                    <td>
                                        @(allergy.Category?.Name ?? "No Category")
                                    </td>

                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(allergy.Description))
                                        {
                                            @allergy.Description
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                No description provided
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (allergy.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Inactive</span>
                                        }
                                    </td>

                                    <td>
                                        <!-- EDIT -->
                                        <a asp-controller="Admin"
                                           asp-action="EditAllergy"
                                           asp-route-id="@allergy.Id"
                                           class="btn btn-sm btn-outline-primary me-1"
                                           title="Edit Allergy">
                                            <i class="fas fa-edit"></i>
                                        </a>

                                        <!-- ACTIVATE / DEACTIVATE -->
                                        <button type="button"
                                                class="btn btn-sm @(allergy.IsActive ? "btn-outline-danger" : "btn-outline-success") toggle-allergy-btn"
                                                data-id="@allergy.Id"
                                                data-name="@allergy.Name"
                                                data-active="@allergy.IsActive.ToString().ToLowerInvariant()"
                                                title="@(allergy.IsActive ? "Deactivate Allergy" : "Activate Allergy")">

                                            @if (allergy.IsActive)
                                            {
                                                <i class="fas fa-ban"></i>
                                            }
                                            else
                                            {
                                                <i class="fas fa-check"></i>
                                            }

                                        </button>
                                    </td>

                                </tr>

                                number++;
                            }
                        }
                        else
                        {
                            <tr id="emptyAllergyRow">
                                <td colspan="6"
                                    class="text-center text-muted py-3">
                                    No allergies available. Click "Add Allergy" to create one.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

<!-- =========================================
     ALLERGY ACTIVATION / DEACTIVATION MODAL
     ========================================= -->

<div id="deleteModal"
     class="delete-overlay"
     role="dialog"
     aria-modal="true"
     aria-hidden="true"
     aria-labelledby="deleteModalTitle">

    <div class="delete-box">

        <!-- ICON -->
        <div class="delete-icon">
            <i id="modalIcon" class="fas fa-exclamation-triangle"></i>
        </div>

        <!-- TITLE -->
        <h3 id="deleteModalTitle">
            Are you sure?
        </h3>

        <!-- MESSAGE -->
        <p>
            Are you sure you want to
            <strong id="modalActionText">deactivate</strong>
            the allergy
            <strong id="deleteAllergyName"></strong>?
        </p>

        <!-- WARNING -->
        <span class="delete-warning">
            <i class="fas fa-info-circle"></i>
            <span id="modalWarning">
                This allergy will no longer be active.
            </span>
        </span>

        <!-- BUTTONS -->
        <div class="delete-buttons">

            <!-- CANCEL -->
            <button type="button"
                    id="cancelDeleteBtn"
                    class="cancel-btn">
                Cancel
            </button>

            <!-- CONFIRM FORM -->
            <form asp-controller="Admin"
                  asp-action="ToggleAllergyStatus"
                  method="post"
                  id="deleteForm">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       id="deleteAllergyId" />

                <button type="submit"
                        id="confirmDeleteBtn"
                        class="confirm-delete-btn">

                    <i id="confirmButtonIcon" class="fas fa-ban me-1"></i>

                    <span id="confirmButtonText">Yes, Deactivate</span>

                </button>

            </form>

        </div>

    </div>

</div>

@section Scripts {

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            // ==========================================
            // ELEMENTS
            // ==========================================

            const modal = document.getElementById("deleteModal");
            const allergyIdInput = document.getElementById("deleteAllergyId");
            const allergyName = document.getElementById("deleteAllergyName");

            const cancelButton = document.getElementById("cancelDeleteBtn");
            const deleteForm = document.getElementById("deleteForm");
            const confirmButton = document.getElementById("confirmDeleteBtn");

            const modalTitle = document.getElementById("deleteModalTitle");
            const modalActionText = document.getElementById("modalActionText");
            const modalWarning = document.getElementById("modalWarning");
            const modalIcon = document.getElementById("modalIcon");

            const confirmButtonIcon = document.getElementById("confirmButtonIcon");
            const confirmButtonText = document.getElementById("confirmButtonText");

            const searchBox = document.getElementById("searchBox");
            const statusFilter = document.getElementById("statusFilter");
            const allergyTable = document.getElementById("allergyTable");

            const originalButtonText = confirmButtonText.textContent;
            const originalButtonIcon = confirmButtonIcon.className;

            let previousFocusedElement = null;

            // ==========================================
            // ESCAPE HTML
            // ==========================================

            function escapeHtml(value) {
                return String(value ?? "").replace(/[&<>"']/g, function (character) {
                    return {
                        "&": "&amp;",
                        "<": "&lt;",
                        ">": "&gt;",
                        '"': "&quot;",
                        "'": "&#39;"
                    }[character];
                });
            }

            // ==========================================
            // OPEN MODAL
            // ==========================================

            document.addEventListener("click", function (event) {

                const button = event.target.closest(".toggle-allergy-btn");

                if (!button) return;

                previousFocusedElement = button;

                const id = button.dataset.id;
                const name = button.dataset.name || "this allergy";
                const isActive = button.dataset.active === "true";

                allergyIdInput.value = id;
                allergyName.textContent = name;

                if (isActive) {

                    // DEACTIVATION
                    modalTitle.textContent = "Are you sure?";
                    modalActionText.textContent = "deactivate";

                    modalWarning.textContent =
                        "This allergy will no longer be active.";

                    modalIcon.className =
                        "fas fa-exclamation-triangle";

                    confirmButton.className =
                        "confirm-delete-btn";

                    confirmButtonIcon.className =
                        "fas fa-ban me-1";

                    confirmButtonText.textContent =
                        "Yes, Deactivate";

                } else {

                    // ACTIVATION
                    modalTitle.textContent = "Activate allergy?";
                    modalActionText.textContent = "activate";

                    modalWarning.textContent =
                        "This allergy will become active again.";

                    modalIcon.className =
                        "fas fa-check-circle";

                    confirmButton.className =
                        "confirm-delete-btn";

                    confirmButtonIcon.className =
                        "fas fa-check me-1";

                    confirmButtonText.textContent =
                        "Yes, Activate";
                }

                confirmButton.disabled = false;

                modal.classList.add("show");
                modal.setAttribute("aria-hidden", "false");

                document.body.classList.add("modal-open");

                cancelButton.focus();
            });

            // ==========================================
            // CLOSE MODAL
            // ==========================================

            function closeModal() {

                modal.classList.remove("show");
                modal.setAttribute("aria-hidden", "true");

                document.body.classList.remove("modal-open");

                allergyIdInput.value = "";
                allergyName.textContent = "";

                if (previousFocusedElement &&
                    document.contains(previousFocusedElement)) {
                    previousFocusedElement.focus();
                }
            }

            cancelButton.addEventListener("click", closeModal);

            // Close when clicking outside the modal box.
            modal.addEventListener("click", function (event) {

                if (event.target === modal) {
                    closeModal();
                }
            });

            // Close with Escape.
            document.addEventListener("keydown", function (event) {

                if (
                    event.key === "Escape" &&
                    modal.classList.contains("show")
                ) {
                    closeModal();
                }
            });

            // ==========================================
            // PREVENT DOUBLE SUBMISSION
            // ==========================================

            deleteForm.addEventListener("submit", function (event) {

                if (!allergyIdInput.value) {
                    event.preventDefault();
                    return;
                }

                confirmButton.disabled = true;

                confirmButtonIcon.className =
                    "fas fa-spinner fa-spin me-1";

                confirmButtonText.textContent =
                    "Processing...";
            });

            // ==========================================
            // SEARCH AND STATUS FILTER
            // ==========================================

            function filterAllergies() {

                const term = searchBox.value.trim().toLowerCase();
                const status = statusFilter.value;

                const rows = allergyTable.querySelectorAll(
                    "tr[data-status]"
                );

                let visibleCount = 0;

                rows.forEach(function (row) {

                    const rowText = row.textContent.toLowerCase();
                    const rowStatus = row.dataset.status;

                    const matchesSearch = rowText.includes(term);

                    const matchesStatus =
                        status === "all" || rowStatus === status;

                    const visible = matchesSearch && matchesStatus;

                    row.style.display = visible ? "" : "none";

                    if (visible) {
                        visibleCount++;
                    }
                });

                let noResults =
                    document.getElementById("noAllergyResults");

                if (visibleCount === 0 && rows.length > 0) {

                    if (!noResults) {

                        noResults = document.createElement("tr");
                        noResults.id = "noAllergyResults";

                        noResults.innerHTML = `
                            <td colspan="6"
                                class="text-center text-muted py-3">
                                No allergies found.
                            </td>`;

                        allergyTable.appendChild(noResults);
                    }

                    noResults.style.display = "";

                } else if (noResults) {

                    noResults.remove();
                }
            }

            searchBox.addEventListener("input", filterAllergies);
            statusFilter.addEventListener("change", filterAllergies);

            // Initial filtering.
            filterAllergies();

        });
    </script>
}