@model HemaCore.Models.ConditionCategory

@{
    Layout = "_AdminLayout";
}

<link rel="stylesheet" href="~/css/doctor.css" />

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<div class="content-card">

    <div class="section-title d-flex align-items-center">
        <i class="fas fa-folder-plus me-2"></i>
        <span>Add New Condition Category</span>
    </div>

    <form asp-action="AddConditionCategory" asp-controller="Admin" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="row">
            <!-- Category Name -->
            <div class="col-12 mb-3">
                <label asp-for="Name" class="form-label fw-semibold">
                    Category Name *
                </label>
                <input asp-for="Name" class="form-control" placeholder="Enter category name" />
                <span asp-validation-for="Name" class="text-danger"></span>
                <small class="text-muted">Examples: Chronic Diseases, Infections, Injuries, Mental Health, etc.</small>
            </div>
        </div>

        <div class="d-flex gap-2 mt-3">
            <button type="submit" class="btn btn-primary-custom">
                <i class="fas fa-save me-2"></i> Save Category
            </button>
            <a asp-action="Conditions" class="btn btn-secondary">
                <i class="fas fa-times me-2"></i> Cancel
            </a>
        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}