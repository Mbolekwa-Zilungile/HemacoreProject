@model List<HemaCore.Models.MedicationCategory>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Medication Categories";
}

<link rel="stylesheet" href="~/css/doctor.css" />

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i>
        @TempData["Success"] <button type="button"
                                     class="btn-close"
                                     data-bs-dismiss="alert"> </button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i>
        @TempData["Error"] <button type="button"
                                   class="btn-close"
                                   data-bs-dismiss="alert"> </button>
    </div>
}

<div class="content-card">

    ```
    <div class="section-title d-flex justify-content-between align-items-center">
        <div>
            <i class="fas fa-folder me-2"></i>
            <span>Medication Categories</span>
        </div>

        <a asp-controller="Admin"
           asp-action="AddMedicationCategory"
           class="btn btn-primary-custom">
            <i class="fas fa-plus me-2"></i>
            Add Category
        </a>
    </div>

    <div class="table-responsive mt-3">

        <table class="table table-hover align-middle">

            <thead>
                <tr>
                    <th>#</th>
                    <th>Category Name</th>
                    <th>Description</th>
                    <th>Medications</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>

            <tbody>

                @if (Model != null && Model.Any())
                {
                    var number = 1;

                    foreach (var category in Model.OrderBy(c => c.Name))
                    {
                        var medicationCount = 0;

                        if (ViewBag.MedicationCountByCategory != null &&
                            ViewBag.MedicationCountByCategory.ContainsKey(category.Id))
                        {
                            medicationCount =
                                ViewBag.MedicationCountByCategory[category.Id];
                        }

                        <tr class="@(category.IsActive ? "" : "table-secondary")">

                            <td>
                                @number
                            </td>

                            <td>
                                <strong>@category.Name</strong>
                            </td>

                            <td>
                                @if (!string.IsNullOrWhiteSpace(category.Description))
                                {
                                    <span>
                                        @category.Description
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        No description provided
                                    </span>
                                }
                            </td>

                            <td>
                                <span class="badge bg-primary">
                                    @medicationCount
                                </span>
                            </td>

                            <td>
                                @if (category.IsActive)
                                {
                                    <span class="badge bg-success">
                                        <i class="fas fa-check-circle me-1"></i>
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        <i class="fas fa-ban me-1"></i>
                                        Inactive
                                    </span>
                                }
                            </td>

                            <td class="text-end">

                                <div class="d-flex justify-content-end gap-2">

                                    <a asp-controller="Admin"
                                       asp-action="EditMedicationCategory"
                                       asp-route-id="@category.Id"
                                       class="btn btn-sm btn-outline-primary"
                                       title="Edit Category">
                                        <i class="fas fa-edit"></i>
                                    </a>

                                    <form asp-controller="Admin"
                                          asp-action="ToggleMedicationCategoryStatus"
                                          asp-route-id="@category.Id"
                                          method="post"
                                          class="d-inline">

                                        @Html.AntiForgeryToken()

                                        @if (category.IsActive)
                                        {
                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-warning"
                                                    title="Deactivate"
                                                    onclick="return confirm('Are you sure you want to deactivate this category?');">
                                                <i class="fas fa-ban"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-success"
                                                    title="Activate">
                                                <i class="fas fa-check"></i>
                                            </button>
                                        }

                                    </form>

                                </div>

                            </td>

                        </tr>

                        number++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-4">
                            <i class="fas fa-folder-open fa-2x text-muted mb-2"></i>
                            <p class="text-muted mb-0">
                                No medication categories found.
                            </p>
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>
    ```

</div>
