
@model List<HemaCore.Models.MedicationCategory>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Medication Categories";
}

<link rel="stylesheet" href="~/css/doctor.css" />

<div class="content-card">

    @* ALERT MESSAGES *@
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @* PAGE HEADER *@
    <div class="section-title d-flex align-items-center justify-content-between">

        <div class="d-flex align-items-center">
            <i class="fas fa-folder me-2"></i>
            <span>
                Medication Categories (@(Model?.Count ?? 0))
            </span>
        </div>

        <a asp-controller="Admin"
           asp-action="AddMedicationCategory"
           class="btn btn-primary-custom btn-sm">
            + Add Category
        </a>

    </div>

    @* SEARCH AND STATUS FILTER *@
    <div class="search-toolbar">

        <div class="search-box">
            <i class="fas fa-search search-icon"></i>

            <input type="text"
                   id="searchBox"
                   class="search-input"
                   placeholder="Search categories..."
                   autocomplete="off" />
        </div>

        <div class="filter-box">
            <label for="statusFilter" class="filter-label">
                <i class="fas fa-filter me-1"></i>
            </label>

            <div class="select-wrapper">
                <select id="statusFilter" class="filter-select">
                    <option value="all">All Categories</option>
                    <option value="active">Active Categories</option>
                    <option value="inactive">Inactive Categories</option>
                </select>

                <i class="fas fa-chevron-down dropdown-icon"></i>
            </div>
        </div>

    </div>

    @* MEDICATION CATEGORY TABLE *@
    <div class="card shadow-sm">
        <div class="card-body p-0">

            <div class="table-responsive">
                <table class="modern-table">

                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Category Name</th>
                            <th>Description</th>
                            <th>Medications</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody id="categoryTable">

                        @if (Model != null && Model.Any())
                        {
                            var number = 1;

                            foreach (var category in Model.OrderBy(c => c.Name))
                            {
                                var medicationCount = 0;

                                if (ViewBag.MedicationCountByCategory != null &&
                                    ViewBag.MedicationCountByCategory.ContainsKey(category.Id))
                                {
                                    medicationCount =
                                        ViewBag.MedicationCountByCategory[category.Id];
                                }

                                <tr data-status="@(category.IsActive ? "active" : "inactive")">

                                    <td>@number</td>

                                    <td class="fw-semibold blue-text">
                                        @category.Name
                                    </td>

                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(category.Description))
                                        {
                                            @category.Description
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                No description provided
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <span class="badge bg-primary">
                                            @medicationCount
                                        </span>
                                    </td>

                                    <td>
                                        @if (category.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Inactive</span>
                                        }
                                    </td>

                                    <td>
                                        <a asp-controller="Admin"
                                           asp-action="EditMedicationCategory"
                                           asp-route-id="@category.Id"
                                           class="btn btn-sm btn-outline-primary me-1"
                                           title="Edit Category">
                                            <i class="fas fa-edit"></i>
                                        </a>

                                        <form asp-controller="Admin"
                                              asp-action="ToggleMedicationCategoryStatus"
                                              asp-route-id="@category.Id"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            @if (category.IsActive)
                                            {
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger"
                                                        title="Deactivate Category"
                                                        onclick="return confirm('Are you sure you want to deactivate this category?');">
                                                    <i class="fas fa-ban"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-success"
                                                        title="Activate Category">
                                                    <i class="fas fa-check"></i>
                                                </button>
                                            }

                                        </form>
                                    </td>

                                </tr>

                                number++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6"
                                    class="text-center text-muted py-3">
                                    No medication categories available.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const searchBox = document.getElementById("searchBox");
            const statusFilter = document.getElementById("statusFilter");
            const categoryTable = document.getElementById("categoryTable");

            function filterCategories() {

                const term = searchBox.value.trim().toLowerCase();
                const status = statusFilter.value;
                const rows = categoryTable.querySelectorAll("tr");

                let visibleCount = 0;

                rows.forEach(function (row) {

                    if (!row.hasAttribute("data-status")) {
                        return;
                    }

                    const rowText = row.textContent.toLowerCase();
                    const rowStatus = row.getAttribute("data-status");

                    const matchesSearch = rowText.includes(term);
                    const matchesStatus =
                        status === "all" || rowStatus === status;

                    const visible = matchesSearch && matchesStatus;

                    row.style.display = visible ? "" : "none";

                    if (visible) {
                        visibleCount++;
                    }
                });

                let noResults =
                    document.getElementById("noCategoryResults");

                if (visibleCount === 0) {

                    if (!noResults) {
                        noResults = document.createElement("tr");
                        noResults.id = "noCategoryResults";

                        noResults.innerHTML = `
                            <td colspan="6"
                                class="text-center text-muted py-3">
                                No medication categories found.
                            </td>`;

                        categoryTable.appendChild(noResults);
                    }

                    noResults.style.display = "";
                }
                else if (noResults) {
                    noResults.remove();
                }
            }

            searchBox.addEventListener("input", filterCategories);
            statusFilter.addEventListener("change", filterCategories);

        });
    </script>
}

