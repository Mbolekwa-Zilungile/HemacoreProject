@model HemaCore.Models.AllergyCategory

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Add Allergy Category";
}

<link rel="stylesheet" href="~/css/doctor.css" />

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}

<div class="content-card">

    <div class="section-title d-flex align-items-center">

        <i class="fas fa-folder-plus me-2"></i>

        <span>Add New Allergy Category</span>

    </div>


    <form asp-controller="Admin"
          asp-action="AddAllergyCategory"
          method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3">
        </div>


        <div class="row">

            <div class="col-12 mb-3">

                <label asp-for="Name"
                       class="form-label fw-semibold">

                    Category Name
                    <span class="text-danger">*</span>

                </label>

                <input asp-for="Name"
                       class="form-control"
                       placeholder="Enter category name" />

                <span asp-validation-for="Name"
                      class="text-danger">
                </span>

                <small class="text-muted">
                    Examples: Food Allergies, Drug Allergies,
                    Environmental Allergies, etc.
                </small>

            </div>


            <div class="col-12 mb-3">

                <label asp-for="Description"
                       class="form-label fw-semibold">

                    Description
                    <span class="text-danger">*</span>

                </label>

                <textarea asp-for="Description"
                          class="form-control"
                          rows="4"
                          placeholder="Enter category description">
                </textarea>

                <span asp-validation-for="Description"
                      class="text-danger">
                </span>

            </div>

        </div>


        <div class="d-flex gap-2 mt-3">

            <button type="submit"
                    class="btn btn-primary-custom">

                <i class="fas fa-save me-2"></i>

                Save Category

            </button>


            <a asp-controller="Admin"
               asp-action="AllergyCategories"
               class="btn btn-secondary">

                <i class="fas fa-times me-2"></i>

                Cancel

            </a>

        </div>

    </form>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}