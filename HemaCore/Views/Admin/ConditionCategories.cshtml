
@model List<HemaCore.Models.ConditionCategory>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Condition Categories";
}

<link rel="stylesheet" href="~/css/doctor.css" />
<link rel="stylesheet" href="~/css/delete.css" />

<div class="content-card">

    @* ALERT MESSAGES *@
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @* PAGE HEADER *@
    <div class="section-title d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center">
            <i class="fas fa-folder me-2"></i>
            <span>
                Condition Categories (@(Model?.Count ?? 0))
            </span>
        </div>

        <a asp-controller="Admin"
           asp-action="AddConditionCategory"
           class="btn btn-primary-custom btn-sm">
            + Add Category
        </a>
    </div>

    @* SEARCH AND STATUS FILTER *@
    <div class="search-toolbar">
        <div class="search-box">
            <i class="fas fa-search search-icon"></i>

            <input type="text"
                   id="searchBox"
                   class="search-input"
                   placeholder="Search categories..."
                   autocomplete="off" />
        </div>

        <div class="filter-box">
            <label for="statusFilter" class="filter-label">
                <i class="fas fa-filter me-1"></i>
            </label>

            <div class="select-wrapper">
                <select id="statusFilter" class="filter-select">
                    <option value="all">All Categories</option>
                    <option value="active">Active Categories</option>
                    <option value="inactive">Inactive Categories</option>
                </select>

                <i class="fas fa-chevron-down dropdown-icon"></i>
            </div>
        </div>
    </div>

    @* CATEGORY TABLE *@
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="modern-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Category Name</th>
                            <th>Description</th>
                            <th>Conditions</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody id="categoryTable">
                        @if (Model != null && Model.Any())
                        {
                            var number = 1;

                            foreach (var category in Model.OrderBy(c => c.Name))
                            {
                                var conditionCount = 0;

                                if (ViewBag.ConditionCountByCategory != null &&
                                    ViewBag.ConditionCountByCategory.ContainsKey(category.Id))
                                {
                                    conditionCount =
                                        ViewBag.ConditionCountByCategory[category.Id];
                                }

                                <tr data-status="@(category.IsActive ? "active" : "inactive")">
                                    <td>@number</td>

                                    <td class="fw-semibold blue-text">
                                        @category.Name
                                    </td>

                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(category.Description))
                                        {
                                            @category.Description
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                No description provided
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <span class="badge bg-primary">
                                            @conditionCount
                                        </span>
                                    </td>

                                    <td>
                                        @if (category.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Inactive</span>
                                        }
                                    </td>

                                    <td>
                                        <a asp-controller="Admin"
                                           asp-action="EditConditionCategory"
                                           asp-route-id="@category.Id"
                                           class="btn btn-sm btn-outline-primary me-1"
                                           title="Edit Category">
                                            <i class="fas fa-edit"></i>
                                        </a>

                                        @* OPEN CONFIRMATION MODAL *@
                                        <button type="button"
                                                class="btn btn-sm @(category.IsActive ? "btn-outline-danger" : "btn-outline-success") toggle-condition-category-btn"
                                                data-id="@category.Id"
                                                data-name="@category.Name"
                                                data-active="@category.IsActive.ToString().ToLowerInvariant()"
                                                title="@(category.IsActive ? "Deactivate Category" : "Activate Category")">
                                            @if (category.IsActive)
                                            {
                                                <i class="fas fa-ban"></i>
                                            }
                                            else
                                            {
                                                <i class="fas fa-check"></i>
                                            }
                                        </button>
                                    </td>
                                </tr>

                                number++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6"
                                    class="text-center text-muted py-3">
                                    No condition categories available.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@* ACTIVATE / DEACTIVATE CONFIRMATION MODAL *@
<div id="deleteModal"
     class="delete-overlay"
     role="dialog"
     aria-modal="true"
     aria-labelledby="deleteModalTitle"
     aria-hidden="true">

    <div class="delete-box">
        <div class="delete-icon">
            <i id="modalIcon" class="fas fa-exclamation-triangle"></i>
        </div>

        <h3 id="deleteModalTitle">Confirm Action</h3>

        <p id="modalActionText">
            Are you sure you want to change this category's status?
        </p>

        <p class="delete-item-name" id="deleteConditionCategoryName"></p>

        <div class="delete-warning" id="modalWarning">
            Please confirm that you want to continue.
        </div>

        <div class="delete-buttons">
            <button type="button"
                    id="cancelDeleteBtn"
                    class="cancel-btn">
                Cancel
            </button>

            <form id="deleteForm"
                  asp-controller="Admin"
                  asp-action="ToggleCategoryStatus"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       id="deleteConditionCategoryId"
                       name="id" />

                <button type="submit"
                        id="confirmDeleteBtn"
                        class="confirm-delete-btn">
                    <i id="confirmButtonIcon" class="fas fa-ban"></i>
                    <span id="confirmButtonText">Confirm</span>
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {

            // SEARCH AND STATUS FILTER
            const searchBox = document.getElementById("searchBox");
            const statusFilter = document.getElementById("statusFilter");
            const categoryTable = document.getElementById("categoryTable");

            function filterCategories() {
                const term = searchBox.value.trim().toLowerCase();
                const status = statusFilter.value;
                const rows = categoryTable.querySelectorAll("tr");
                let visibleCount = 0;

                rows.forEach(function(row) {
                    if (!row.hasAttribute("data-status")) {
                        return;
                    }

                    const rowText = row.textContent.toLowerCase();
                    const rowStatus = row.getAttribute("data-status");

                    const matchesSearch = rowText.includes(term);
                    const matchesStatus =
                        status === "all" || rowStatus === status;

                    const visible = matchesSearch && matchesStatus;

                    row.style.display = visible ? "" : "none";

                    if (visible) {
                        visibleCount++;
                    }
                });

                let noResults = document.getElementById("noCategoryResults");

                if (visibleCount === 0) {
                    if (!noResults) {
                        noResults = document.createElement("tr");
                        noResults.id = "noCategoryResults";

                        noResults.innerHTML = `
                                    <td colspan="6"
                                        class="text-center text-muted py-3">
                                        No condition categories found.
                                    </td>`;

                        categoryTable.appendChild(noResults);
                    }

                    noResults.style.display = "";
                } else if (noResults) {
                    noResults.remove();
                }
            }

            searchBox.addEventListener("input", filterCategories);
            statusFilter.addEventListener("change", filterCategories);


            // CONFIRMATION MODAL
            const modal = document.getElementById("deleteModal");
            const modalIcon = document.getElementById("modalIcon");
            const modalTitle = document.getElementById("deleteModalTitle");
            const modalActionText = document.getElementById("modalActionText");
            const categoryName = document.getElementById("deleteConditionCategoryName");
            const modalWarning = document.getElementById("modalWarning");
            const categoryIdInput = document.getElementById("deleteConditionCategoryId");
            const cancelButton = document.getElementById("cancelDeleteBtn");
            const confirmButton = document.getElementById("confirmDeleteBtn");
            const confirmButtonIcon = document.getElementById("confirmButtonIcon");
            const confirmButtonText = document.getElementById("confirmButtonText");
            const form = document.getElementById("deleteForm");

            let previousFocus = null;

            function openModal(id, name, isActive, triggerButton) {
                previousFocus = triggerButton;

                categoryIdInput.value = id;
                categoryName.textContent = name;

                if (isActive) {
                    modalTitle.textContent = "Deactivate Category?";
                    modalActionText.textContent =
                        "Are you sure you want to deactivate this condition category?";
                    modalWarning.textContent =
                        "This category will be marked as inactive. Existing records will remain visible.";
                    modalIcon.className = "fas fa-exclamation-triangle";
                    confirmButtonIcon.className = "fas fa-ban";
                    confirmButtonText.textContent = "Deactivate";
                } else {
                    modalTitle.textContent = "Activate Category?";
                    modalActionText.textContent =
                        "Are you sure you want to activate this condition category?";
                    modalWarning.textContent =
                        "This category will be marked as active again.";
                    modalIcon.className = "fas fa-check-circle";
                    confirmButtonIcon.className = "fas fa-check";
                    confirmButtonText.textContent = "Activate";
                }

                confirmButton.disabled = false;
                confirmButton.classList.toggle("deactivate-action", isActive);
                confirmButton.classList.toggle("activate-action", !isActive);

                modal.classList.add("show");
                modal.setAttribute("aria-hidden", "false");
                document.body.classList.add("modal-open");

                cancelButton.focus();
            }

            function closeModal() {
                modal.classList.remove("show");
                modal.setAttribute("aria-hidden", "true");
                document.body.classList.remove("modal-open");

                if (previousFocus) {
                    previousFocus.focus();
                }
            }

            document.querySelectorAll(".toggle-condition-category-btn")
                .forEach(function(button) {
                    button.addEventListener("click", function() {
                        const id = this.dataset.id;
                        const name = this.dataset.name;
                        const isActive = this.dataset.active === "true";

                        openModal(id, name, isActive, this);
                    });
                });

            cancelButton.addEventListener("click", closeModal);

            modal.addEventListener("click", function(event) {
                if (event.target === modal) {
                    closeModal();
                }
            });

            document.addEventListener("keydown", function(event) {
                if (event.key === "Escape" && modal.classList.contains("show")) {
                    closeModal();
                }
            });

            form.addEventListener("submit", function() {
                confirmButton.disabled = true;
                confirmButtonText.textContent = "Processing...";
            });
        });
    </script>
}
