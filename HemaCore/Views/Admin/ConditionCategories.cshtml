@model List<HemaCore.Models.ConditionCategory>

@{
    Layout = "_AdminLayout";
}

<link rel="stylesheet" href="~/css/doctor.css" />

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

<div class="content-card">

    <!-- HEADER -->
    <div class="section-title d-flex align-items-center justify-content-between">

        <div class="d-flex align-items-center">
            <i class="fas fa-box-open me-2"></i>
            <span>Condition Categories</span>
            <span class="badge blue-badge ms-2">
                @ViewBag.CategoryCount
            </span>
        </div>

        <a asp-action="AddConditionCategory"
           class="btn btn-primary-custom btn-sm">
            + Add Category
        </a>

    </div>

    <!-- SEARCH -->
    <input type="text"
           id="searchBox"
           class="form-control mb-3"
           placeholder="Search condition categories..." />

    <!-- TABLE -->
    <table class="modern-table">

        <thead>
            <tr>
                <th>Category Name</th>
                <th>Conditions</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody id="categoryTable">

            @if (!Model.Any())
            {
                <tr>
                    <td colspan="4" class="text-center text-muted">
                        No condition categories available.
                    </td>
                </tr>
            }
            else
            {
                @foreach (var category in Model)
                {
                    <tr>
                        <td class="fw-semibold blue-text">
                            @category.Name
                        </td>

                        <td>
                            @(ViewBag.ConditionCountByCategory != null &&
                                ViewBag.ConditionCountByCategory.ContainsKey(category.Id)
                                ? ViewBag.ConditionCountByCategory[category.Id]
                                : 0)
                        </td>

                        <td>
                            <span class="badge @(category.IsActive ? "bg-success" : "bg-secondary")">
                                @(category.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>

                        <td>
                            <a asp-action="EditConditionCategory"
                               asp-route-id="@category.Id"
                               class="btn btn-sm btn-primary me-1">
                                Edit
                            </a>

                            <a href="#"
                               class="btn btn-sm @(category.IsActive ? "btn-danger" : "btn-success")"
                               onclick="toggleStatus(@category.Id, @(category.IsActive ? "false" : "true"))">
                                @(category.IsActive ? "Deactivate" : "Activate")
                            </a>
                        </td>
                    </tr>
                }
            }

        </tbody>

    </table>

</div>

<!-- SCRIPT -->
<script>
    document.getElementById("searchBox").addEventListener("keyup", function() {
        let term = this.value;

        fetch('/Admin/SearchCategoriesLive?term=' + term)
            .then(res => res.json())
            .then(data => {
                let rows = "";

                if (data.length === 0) {
                    rows = `
                            <tr>
                                <td colspan="4" class="text-center text-muted">
                                    No results found.
                                </td>
                            </tr>
                        `;
                }
                else {
                    data.forEach(item => {
                        rows += `
                                <tr>
                                    <td class="fw-semibold blue-text">
                                        ${item.name}
                                    </td>
                                    <td>${item.conditionCount}</td>
                                    <td>
                                        <span class="badge ${item.isActive ? "bg-success" : "bg-secondary"}">
                                            ${item.isActive ? "Active" : "Inactive"}
                                        </span>
                                    </td>
                                    <td>
                                        <a href="/Admin/EditConditionCategory/${item.id}"
                                           class="btn btn-sm btn-primary me-1">
                                            Edit
                                        </a>
                                        <a href="#"
                                           class="btn btn-sm ${item.isActive ? "btn-danger" : "btn-success"}"
                                           onclick="toggleStatus(${item.id}, ${!item.isActive})">
                                            ${item.isActive ? "Deactivate" : "Activate"}
                                        </a>
                                    </td>
                                </tr>
                            `;
                    });
                }

                document.getElementById("categoryTable").innerHTML = rows;
            });
    });

    function toggleStatus(id, activate) {
        const action = activate ? "activate" : "deactivate";
        if (confirm(`Are you sure you want to ${action} this category?`)) {
            fetch('/Admin/ToggleCategoryStatus', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                },
                body: JSON.stringify({ id: id })
            })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        location.reload();
                    } else {
                        alert(data.message);
                    }
                });
        }
    }
</script>