@model HemaCore.Models.Medication

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Add Medication";
}

<div class="content-card">

    <div class="section-title">
        <i class="fas fa-pills me-2"></i>
        Add Medication
    </div>


    <form asp-controller="Admin"
          asp-action="AddMedication"
          method="post">

        @Html.AntiForgeryToken()


        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3">
        </div>


        <!-- MEDICATION NAME -->
        <div class="mb-3">

            <label asp-for="Name"
                   class="form-label">
                Medication Name
            </label>

            <input asp-for="Name"
                   class="form-control"
                   placeholder="Enter medication name" />

            <span asp-validation-for="Name"
                  class="text-danger">
            </span>

        </div>


        <!-- CATEGORY -->
        <div class="mb-3">

            <label asp-for="CategoryId"
                   class="form-label">
                Category
            </label>

            <select asp-for="CategoryId"
                    class="form-select">

                <option value="">
                    -- Select Category --
                </option>

                @if (ViewBag.Categories != null)
                {
                    foreach (var category in ViewBag.Categories)
                    {
                        <option value="@category.Id">
                            @category.Name
                        </option>
                    }
                }

            </select>

            <span asp-validation-for="CategoryId"
                  class="text-danger">
            </span>

        </div>


        <!-- DESCRIPTION -->
        <div class="mb-3">

            <label asp-for="Description"
                   class="form-label">
                Description
            </label>

            <textarea asp-for="Description"
                      class="form-control"
                      rows="4"
                      maxlength="200"
                      placeholder="Enter medication description"></textarea>

            <span asp-validation-for="Description"
                  class="text-danger">
            </span>

            <small class="text-muted">
                Maximum 200 characters.
            </small>

        </div>


        <!-- BUTTONS -->
        <div class="d-flex gap-2">

            <button type="submit"
                    class="btn btn-primary-custom">

                <i class="fas fa-save me-1"></i>
                Add Medication

            </button>


            <a asp-controller="Admin"
               asp-action="Medications"
               class="btn btn-secondary">

                Cancel

            </a>

        </div>

    </form>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}