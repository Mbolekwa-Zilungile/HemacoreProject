@model HemaCore.Models.MedicationCategory

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Edit Medication Category";
}

<link rel="stylesheet" href="~/css/doctor.css" />

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="content-card">

    <div class="section-title d-flex align-items-center">
        <i class="fas fa-edit me-2"></i>
        <span>Edit Medication Category</span>
    </div>

    <form asp-action="EditMedicationCategory" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row">
            <!-- Category Name -->
            <div class="col-12 mb-3">
                <label asp-for="Name" class="form-label fw-semibold">
                    Category Name <span class="text-danger">*</span>
                </label>
                <input asp-for="Name" class="form-control" placeholder="Enter category name" />
                <span asp-validation-for="Name" class="text-danger"></span>
                <small class="text-muted">Examples: Pain Relievers, Antibiotics, Antihistamines, Blood Pressure, etc.</small>
            </div>
        </div>

        <div class="d-flex gap-2 mt-3">
            <button type="submit" class="btn btn-primary-custom">
                <i class="fas fa-save me-2"></i> Update Category
            </button>
            <a asp-action="Medications" class="btn btn-secondary">
                <i class="fas fa-times me-2"></i> Cancel
            </a>
        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
