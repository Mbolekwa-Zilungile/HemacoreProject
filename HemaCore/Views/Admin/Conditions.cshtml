@model List<HemaCore.Models.Condition>

@{
    Layout = "_AdminLayout";
}

<link rel="stylesheet" href="~/css/doctor.css" />

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

<div class="content-card">

    <!-- HEADER -->
    <div class="section-title d-flex align-items-center justify-content-between">

        <div class="d-flex align-items-center">
            <i class="fas fa-list me-2"></i>
            <span>All Conditions</span>
            <span class="badge blue-badge ms-2">
                @ViewBag.ConditionCount
            </span>
        </div>

        <div class="d-flex gap-2">
            <!-- Add Category Button -->
            <a asp-action="AddConditionCategory"
               asp-controller="Admin"
               class="btn btn-success btn-sm">
                <i class="fas fa-plus me-1"></i> Add Category
            </a>

            <!-- Add Condition Button -->
            <a asp-action="AddCondition"
               class="btn btn-primary-custom btn-sm">
                <i class="fas fa-plus me-1"></i> Add Condition
            </a>
        </div>

    </div>

    <!-- SEARCH AND FILTER -->
    <div class="row mb-3">
        <div class="col-md-8">
            <div class="input-group">
                <span class="input-group-text bg-transparent border-end-0">
                    <i class="fas fa-search text-muted"></i>
                </span>
                <input type="text"
                       id="searchBox"
                       class="form-control border-start-0 ps-0"
                       placeholder="Search conditions..." />
            </div>
        </div>
        <div class="col-md-4">
            <div class="input-group">
                <span class="input-group-text bg-transparent border-end-0">
                    <i class="fas fa-filter text-muted"></i>
                </span>
                <select id="categoryFilter" class="form-select border-start-0 ps-0">
                    <option value="">All Categories</option>
                    @if (ViewBag.Categories != null)
                    {
                        foreach (var category in ViewBag.Categories)
                        {
                            <option value="@category.Id">@category.Name</option>
                        }
                    }
                </select>
            </div>
        </div>
    </div>

    <!-- TABLE -->
    <table class="modern-table">

        <thead>
            <tr>
                <th>Condition Name</th>
                <th>Category</th>
                <th>Description</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody id="conditionTable">

            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5" class="text-center text-muted">
                        No conditions available. Click "Add Condition" to create one.
                    </td>
                </tr>
            }
            else
            {
                @foreach (var condition in Model)
                {
                    <tr data-category-id="@condition.CategoryId">
                        <td class="fw-semibold blue-text">
                            @condition.Name
                        </td>

                        <td>
                            @condition.Category?.Name
                        </td>

                        <td>
                            @condition.Description
                        </td>

                        <td>
                            <span class="badge @(condition.IsActive ? "bg-success" : "bg-secondary")">
                                @(condition.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>

                        <td>
                            <a asp-action="EditCondition"
                               asp-route-id="@condition.Id"
                               class="btn btn-sm btn-primary me-1">
                                Edit
                            </a>

                            <form asp-controller="Admin"
                                  asp-action="ToggleConditionStatus"
                                  method="post"
                                  class="d-inline"
                                  onsubmit="return confirm('Are you sure you want to change the status of this condition?');">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@condition.Id" />

                                <button type="submit"
                                        class="btn btn-sm @(condition.IsActive ? "btn-danger" : "btn-success")">
                                    @(condition.IsActive ? "Deactivate" : "Activate")
                                </button>

                            </form>
                        </td>
                    </tr>
                }
            }

        </tbody>

    </table>

</div>

<!-- SCRIPT -->
<script>
    // Search functionality
    document.getElementById("searchBox").addEventListener("keyup", function () {
        filterTable();
    });

    // Category filter functionality
    document.getElementById("categoryFilter").addEventListener("change", function () {
        filterTable();
    });

    function filterTable() {
        let searchTerm = document.getElementById("searchBox").value.toLowerCase();
        let categoryId = document.getElementById("categoryFilter").value;
        let rows = document.querySelectorAll("#conditionTable tr");

        rows.forEach(row => {
            // Skip if it's the "no results" row
            if (row.querySelector("td[colspan]")) return;

            let conditionName = row.querySelector("td:first-child")?.textContent?.toLowerCase() || "";
            let categoryName = row.querySelector("td:nth-child(2)")?.textContent?.toLowerCase() || "";
            let description = row.querySelector("td:nth-child(3)")?.textContent?.toLowerCase() || "";

            let rowCategoryId = row.getAttribute("data-category-id");

            // Check if search term matches
            let matchesSearch = conditionName.includes(searchTerm) ||
                               categoryName.includes(searchTerm) ||
                               description.includes(searchTerm);

            // Check if category filter matches
            let matchesCategory = categoryId === "" || rowCategoryId === categoryId;

            // Show/hide row
            if (matchesSearch && matchesCategory) {
                row.style.display = "";
            } else {
                row.style.display = "none";
            }
        });

        // Show "no results" message if all rows are hidden
        let visibleRows = document.querySelectorAll("#conditionTable tr[style*='display: none']");
        let allRows = document.querySelectorAll("#conditionTable tr:not([style*='display: none'])");

        // Check if there's already a "no results" row
        let noResultsRow = document.querySelector("#conditionTable tr td[colspan]");

        if (allRows.length === 1 && allRows[0].querySelector("td[colspan]")) {
            // Only the no results row exists
            return;
        }

        if (visibleRows.length === document.querySelectorAll("#conditionTable tr:not([style*='display: none']):not([style*='display'])").length) {
            // All rows are hidden, show no results message
            if (!noResultsRow) {
                let tbody = document.getElementById("conditionTable");
                let tr = document.createElement("tr");
                tr.id = "noResultsRow";
                tr.innerHTML = `
                    <td colspan="5" class="text-center text-muted">
                        No results found.
                    </td>
                `;
                tbody.appendChild(tr);
            }
        } else {
            // Remove no results row if it exists
            let noResults = document.getElementById("noResultsRow");
            if (noResults) {
                noResults.remove();
            }
        }
    }
</script>