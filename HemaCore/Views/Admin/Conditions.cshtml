
@model List<HemaCore.Models.Condition>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Conditions";
}

<link rel="stylesheet" href="~/css/doctor.css" />
<link rel="stylesheet" href="~/css/delete.css" />

<div class="content-card">

    @* ALERT MESSAGES *@
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>
            @TempData["Error"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>
            @TempData["Success"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @* PAGE HEADER *@
    <div class="section-title d-flex align-items-center justify-content-between">

        <div class="d-flex align-items-center">
            <i class="fas fa-list me-2"></i>
            <span>All Conditions (@(Model?.Count ?? 0))</span>
        </div>

        <div class="d-flex gap-2">
            <a asp-controller="Admin"
               asp-action="AddConditionCategory"
               class="btn btn-primary-custom btn-sm">
                <i class="fas fa-plus me-1"></i>
                Add Category
            </a>

            <a asp-controller="Admin"
               asp-action="AddCondition"
               class="btn btn-primary-custom btn-sm">
                <i class="fas fa-plus me-1"></i>
                Add Condition
            </a>
        </div>

    </div>

    @* SEARCH AND CATEGORY FILTER *@
    <div class="search-toolbar">

        <div class="search-box">
            <i class="fas fa-search search-icon"></i>

            <input type="text"
                   id="searchBox"
                   class="search-input"
                   placeholder="Search conditions..."
                   autocomplete="off" />
        </div>

        <div class="filter-box">
            <label for="categoryFilter" class="filter-label">
                <i class="fas fa-filter me-1"></i>
            </label>

            <div class="select-wrapper">
                <select id="categoryFilter" class="filter-select">
                    <option value="">All Categories</option>

                    @if (ViewBag.Categories != null)
                    {
                        foreach (var category in ViewBag.Categories)
                        {
                            <option value="@category.Id">
                                @category.Name
                            </option>
                        }
                    }
                </select>

                <i class="fas fa-chevron-down dropdown-icon"></i>
            </div>
        </div>

    </div>

    @* CONDITIONS TABLE *@
    <div class="card shadow-sm">
        <div class="card-body p-0">

            <div class="table-responsive">
                <table class="modern-table">

                    <thead>
                        <tr>
                            <th>Condition Name</th>
                            <th>Category</th>
                            <th>Description</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody id="conditionTable">

                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="5"
                                    class="text-center text-muted py-3">
                                    No conditions available.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var condition in Model)
                            {
                                <tr data-category-id="@condition.CategoryId">

                                    <td class="fw-semibold blue-text">
                                        @condition.Name
                                    </td>

                                    <td>
                                        @(condition.Category?.Name ?? "No Category")
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(condition.Description)
                                            ? "—"
                                            : condition.Description)
                                    </td>

                                    <td>
                                        @if (condition.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Inactive</span>
                                        }
                                    </td>

                                    <td>
                                        @* EDIT CONDITION *@
                                        <a asp-controller="Admin"
                                           asp-action="EditCondition"
                                           asp-route-id="@condition.Id"
                                           class="btn btn-sm btn-outline-primary me-1"
                                           title="Edit Condition">
                                            <i class="fas fa-edit"></i>
                                        </a>

                                        @* ACTIVATE / DEACTIVATE BUTTON *@
                                        <button type="button"
                                                class="btn btn-sm @(condition.IsActive ? "btn-outline-danger" : "btn-outline-success") toggle-condition-btn"
                                                data-id="@condition.Id"
                                                data-name="@condition.Name"
                                                data-active="@condition.IsActive.ToString().ToLowerInvariant()"
                                                title="@(condition.IsActive ? "Deactivate Condition" : "Activate Condition")">

                                            @if (condition.IsActive)
                                            {
                                                <i class="fas fa-ban"></i>
                                            }
                                            else
                                            {
                                                <i class="fas fa-check"></i>
                                            }

                                        </button>
                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>
            </div>

        </div>
    </div>

</div>

@* =========================================
   CONDITION ACTIVATION / DEACTIVATION MODAL
   Same modal CSS/classes as Allergies.cshtml
   ========================================= *@

<div id="deleteModal"
     class="delete-overlay"
     role="dialog"
     aria-modal="true"
     aria-hidden="true"
     aria-labelledby="deleteModalTitle">

    <div class="delete-box">

        @* ICON *@
        <div class="delete-icon">
            <i id="modalIcon" class="fas fa-exclamation-triangle"></i>
        </div>

        @* TITLE *@
        <h3 id="deleteModalTitle">
            Are you sure?
        </h3>

        @* MESSAGE *@
        <p>
            Are you sure you want to
            <strong id="modalActionText">deactivate</strong>
            the condition
            <strong id="deleteConditionName"></strong>?
        </p>

        @* WARNING *@
        <span class="delete-warning">
            <i class="fas fa-info-circle"></i>
            <span id="modalWarning">
                This condition will no longer be active.
            </span>
        </span>

        @* BUTTONS *@
        <div class="delete-buttons">

            @* CANCEL *@
            <button type="button"
                    id="cancelDeleteBtn"
                    class="cancel-btn">
                Cancel
            </button>

            @* CONFIRM FORM *@
            <form asp-controller="Admin"
                  asp-action="ToggleConditionStatus"
                  method="post"
                  id="deleteForm">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       id="deleteConditionId" />

                <button type="submit"
                        id="confirmDeleteBtn"
                        class="confirm-delete-btn">

                    <i id="confirmButtonIcon" class="fas fa-ban me-1"></i>

                    <span id="confirmButtonText">Yes, Deactivate</span>

                </button>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {

            // ==========================================
            // MODAL ELEMENTS
            // ==========================================

            const modal = document.getElementById("deleteModal");
            const conditionIdInput =
                document.getElementById("deleteConditionId");
            const conditionName =
                document.getElementById("deleteConditionName");

            const cancelButton =
                document.getElementById("cancelDeleteBtn");
            const statusForm =
                document.getElementById("deleteForm");
            const confirmButton =
                document.getElementById("confirmDeleteBtn");

            const modalTitle =
                document.getElementById("deleteModalTitle");
            const modalActionText =
                document.getElementById("modalActionText");
            const modalWarning =
                document.getElementById("modalWarning");
            const modalIcon =
                document.getElementById("modalIcon");

            const confirmButtonIcon =
                document.getElementById("confirmButtonIcon");
            const confirmButtonText =
                document.getElementById("confirmButtonText");

            let previousFocusedElement = null;

            // ==========================================
            // OPEN ACTIVATION / DEACTIVATION MODAL
            // ==========================================

            document.addEventListener("click", function(event) {

                const button = event.target.closest(".toggle-condition-btn");

                if (!button) {
                    return;
                }

                previousFocusedElement = button;

                const id = button.dataset.id;
                const name = button.dataset.name || "this condition";
                const isActive = button.dataset.active === "true";

                conditionIdInput.value = id;
                conditionName.textContent = name;

                if (isActive) {

                    // DEACTIVATE CONDITION
                    modalTitle.textContent = "Are you sure?";
                    modalActionText.textContent = "deactivate";

                    modalWarning.textContent =
                        "This condition will no longer be active.";

                    modalIcon.className =
                        "fas fa-exclamation-triangle";

                    confirmButton.className =
                        "confirm-delete-btn";

                    confirmButtonIcon.className =
                        "fas fa-ban me-1";

                    confirmButtonText.textContent =
                        "Yes, Deactivate";

                } else {

                    // ACTIVATE CONDITION
                    modalTitle.textContent = "Activate condition?";

                    modalActionText.textContent = "activate";

                    modalWarning.textContent =
                        "This condition will become active again.";

                    modalIcon.className =
                        "fas fa-check-circle";

                    confirmButton.className =
                        "confirm-delete-btn";

                    confirmButtonIcon.className =
                        "fas fa-check me-1";

                    confirmButtonText.textContent =
                        "Yes, Activate";
                }

                confirmButton.disabled = false;

                modal.classList.add("show");
                modal.setAttribute("aria-hidden", "false");

                document.body.classList.add("modal-open");

                cancelButton.focus();
            });

            // ==========================================
            // CLOSE MODAL
            // ==========================================

            function closeModal() {

                modal.classList.remove("show");
                modal.setAttribute("aria-hidden", "true");

                document.body.classList.remove("modal-open");

                conditionIdInput.value = "";
                conditionName.textContent = "";

                if (previousFocusedElement &&
                    document.contains(previousFocusedElement)) {
                    previousFocusedElement.focus();
                }
            }

            cancelButton.addEventListener("click", closeModal);

            // Close when clicking outside the modal box.
            modal.addEventListener("click", function(event) {

                if (event.target === modal) {
                    closeModal();
                }
            });

            // Close when pressing Escape.
            document.addEventListener("keydown", function(event) {

                if (
                    event.key === "Escape" &&
                    modal.classList.contains("show")
                ) {
                    closeModal();
                }
            });

            // ==========================================
            // PREVENT DOUBLE SUBMISSION
            // ==========================================

            statusForm.addEventListener("submit", function(event) {

                if (!conditionIdInput.value) {
                    event.preventDefault();
                    return;
                }

                confirmButton.disabled = true;

                confirmButtonIcon.className =
                    "fas fa-spinner fa-spin me-1";

                confirmButtonText.textContent = "Processing...";
            });

            // ==========================================
            // ORIGINAL SEARCH AND CATEGORY FILTER
            // ==========================================

            const searchBox = document.getElementById("searchBox");
            const categoryFilter =
                document.getElementById("categoryFilter");
            const conditionTable =
                document.getElementById("conditionTable");

            function filterTable() {

                const searchTerm =
                    searchBox.value.trim().toLowerCase();

                const categoryId = categoryFilter.value;

                const rows = conditionTable.querySelectorAll("tr");

                let visibleCount = 0;

                rows.forEach(function(row) {

                    if (!row.hasAttribute("data-category-id")) {
                        return;
                    }

                    const cells = row.querySelectorAll("td");

                    const conditionName =
                        cells[0]?.textContent.toLowerCase() || "";

                    const categoryName =
                        cells[1]?.textContent.toLowerCase() || "";

                    const description =
                        cells[2]?.textContent.toLowerCase() || "";

                    const rowCategoryId =
                        row.getAttribute("data-category-id");

                    const matchesSearch =
                        conditionName.includes(searchTerm) ||
                        categoryName.includes(searchTerm) ||
                        description.includes(searchTerm);

                    const matchesCategory =
                        categoryId === "" ||
                        rowCategoryId === categoryId;

                    const visible =
                        matchesSearch && matchesCategory;

                    row.style.display = visible ? "" : "none";

                    if (visible) {
                        visibleCount++;
                    }
                });

                let noResultsRow =
                    document.getElementById("noConditionResults");

                if (visibleCount === 0) {

                    if (!noResultsRow) {

                        noResultsRow = document.createElement("tr");
                        noResultsRow.id = "noConditionResults";

                        noResultsRow.innerHTML = `
                                    <td colspan="5"
                                        class="text-center text-muted py-3">
                                        No conditions found.
                                    </td>`;

                        conditionTable.appendChild(noResultsRow);
                    }

                    noResultsRow.style.display = "";

                } else if (noResultsRow) {

                    noResultsRow.remove();
                }
            }

            searchBox.addEventListener("input", filterTable);
            categoryFilter.addEventListener("change", filterTable);

        });
    </script>
}
