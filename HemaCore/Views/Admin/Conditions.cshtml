
@model List<HemaCore.Models.Condition>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Conditions";
}

<link rel="stylesheet" href="~/css/doctor.css" />

<div class="content-card">

    @* ALERT MESSAGES *@
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>
            @TempData["Error"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>
            @TempData["Success"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @* PAGE HEADER *@
    <div class="section-title d-flex align-items-center justify-content-between">

        <div class="d-flex align-items-center">
            <i class="fas fa-list me-2"></i>
            <span>All Conditions (@(Model?.Count ?? 0))</span>
        </div>

        <div class="d-flex gap-2">
            <a asp-controller="Admin"
               asp-action="AddConditionCategory"
               class="btn btn-primary-custom btn-sm">
                <i class="fas fa-plus me-1"></i>
                Add Category
            </a>

            <a asp-controller="Admin"
               asp-action="AddCondition"
               class="btn btn-primary-custom btn-sm">
                <i class="fas fa-plus me-1"></i>
                Add Condition
            </a>
        </div>

    </div>

    @* SEARCH AND CATEGORY FILTER *@
    <div class="search-toolbar">

        <div class="search-box">
            <i class="fas fa-search search-icon"></i>

            <input type="text"
                   id="searchBox"
                   class="search-input"
                   placeholder="Search conditions..."
                   autocomplete="off" />
        </div>

        <div class="filter-box">
            <label for="categoryFilter" class="filter-label">
                <i class="fas fa-filter me-1"></i>
            </label>

            <div class="select-wrapper">
                <select id="categoryFilter" class="filter-select">
                    <option value="">All Categories</option>

                    @if (ViewBag.Categories != null)
                    {
                        foreach (var category in ViewBag.Categories)
                        {
                            <option value="@category.Id">
                                @category.Name
                            </option>
                        }
                    }
                </select>

                <i class="fas fa-chevron-down dropdown-icon"></i>
            </div>
        </div>

    </div>

    @* CONDITIONS TABLE *@
    <div class="card shadow-sm">
        <div class="card-body p-0">

            <div class="table-responsive">
                <table class="modern-table">

                    <thead>
                        <tr>
                            <th>Condition Name</th>
                            <th>Category</th>
                            <th>Description</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody id="conditionTable">

                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="5"
                                    class="text-center text-muted py-3">
                                    No conditions available.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var condition in Model)
                            {
                                <tr data-category-id="@condition.CategoryId">

                                    <td class="fw-semibold blue-text">
                                        @condition.Name
                                    </td>

                                    <td>
                                        @(condition.Category?.Name ?? "No Category")
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(condition.Description)
                                            ? "—"
                                            : condition.Description)
                                    </td>

                                    <td>
                                        @if (condition.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Inactive</span>
                                        }
                                    </td>

                                    <td>
                                        <a asp-controller="Admin"
                                           asp-action="EditCondition"
                                           asp-route-id="@condition.Id"
                                           class="btn btn-sm btn-outline-primary me-1"
                                           title="Edit Condition">
                                            <i class="fas fa-edit"></i>
                                        </a>

                                        <form asp-controller="Admin"
                                              asp-action="ToggleConditionStatus"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@condition.Id" />

                                            @if (condition.IsActive)
                                            {
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger"
                                                        title="Deactivate Condition"
                                                        onclick="return confirm('Are you sure you want to deactivate this condition?');">
                                                    <i class="fas fa-ban"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-success"
                                                        title="Activate Condition"
                                                        onclick="return confirm('Are you sure you want to activate this condition?');">
                                                    <i class="fas fa-check"></i>
                                                </button>
                                            }

                                        </form>
                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const searchBox = document.getElementById("searchBox");
            const categoryFilter = document.getElementById("categoryFilter");
            const conditionTable = document.getElementById("conditionTable");

            function filterTable() {

                const searchTerm = searchBox.value.trim().toLowerCase();
                const categoryId = categoryFilter.value;

                const rows = conditionTable.querySelectorAll("tr");
                let visibleCount = 0;

                rows.forEach(function (row) {

                    if (!row.hasAttribute("data-category-id")) {
                        return;
                    }

                    const cells = row.querySelectorAll("td");

                    const conditionName =
                        cells[0]?.textContent.toLowerCase() || "";

                    const categoryName =
                        cells[1]?.textContent.toLowerCase() || "";

                    const description =
                        cells[2]?.textContent.toLowerCase() || "";

                    const rowCategoryId =
                        row.getAttribute("data-category-id");

                    const matchesSearch =
                        conditionName.includes(searchTerm) ||
                        categoryName.includes(searchTerm) ||
                        description.includes(searchTerm);

                    const matchesCategory =
                        categoryId === "" ||
                        rowCategoryId === categoryId;

                    const visible = matchesSearch && matchesCategory;

                    row.style.display = visible ? "" : "none";

                    if (visible) {
                        visibleCount++;
                    }
                });

                let noResultsRow =
                    document.getElementById("noConditionResults");

                if (visibleCount === 0) {

                    if (!noResultsRow) {
                        noResultsRow = document.createElement("tr");
                        noResultsRow.id = "noConditionResults";

                        noResultsRow.innerHTML = `
                            <td colspan="5"
                                class="text-center text-muted py-3">
                                No conditions found.
                            </td>`;

                        conditionTable.appendChild(noResultsRow);
                    }

                    noResultsRow.style.display = "";
                }
                else if (noResultsRow) {
                    noResultsRow.remove();
                }
            }

            searchBox.addEventListener("input", filterTable);
            categoryFilter.addEventListener("change", filterTable);

        });
    </script>
}
