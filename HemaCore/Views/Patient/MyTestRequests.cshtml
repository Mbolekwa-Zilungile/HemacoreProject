@model List<HemaCore.Models.TestRequest>

@{
    Layout = "~/Views/Shared/_PatientLayout.cshtml";
    ViewBag.Title = "My Test Requests";
}

<div class="patient-page">

    <!-- Page Header -->
    <div class="page-header">
        <div>
            <div class="page-label">
                <i class="fas fa-flask"></i>
                PATIENT PORTAL
            </div>

            <h1>My Test Requests</h1>

            <p>
                Track the progress of laboratory test requests created for you by your doctor.
            </p>
        </div>

        <a asp-controller="Patient"
           asp-action="Dashboard"
           class="back-btn">
            <i class="fas fa-arrow-left"></i>
            Dashboard
        </a>
    </div>

    <!-- Success Message -->
    @if (TempData["Success"] != null)
    {
        <div class="alert success-alert">
            <i class="fas fa-check-circle"></i>
            <span>@TempData["Success"]</span>
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <!-- Empty State -->
        <div class="empty-state">
            <div class="empty-icon">
                <i class="fas fa-flask"></i>
            </div>

            <h2>No Test Requests</h2>

            <p>
                You currently do not have any test requests created by a doctor.
            </p>

            <a asp-controller="Patient"
               asp-action="Dashboard"
               class="primary-btn">
                <i class="fas fa-home"></i>
                Return to Dashboard
            </a>
        </div>
    }
    else
    {
        <!-- Summary -->
        <div class="summary-card">
            <div class="summary-icon">
                <i class="fas fa-file-medical"></i>
            </div>

            <div>
                <span class="summary-label">TOTAL TEST REQUESTS</span>
                <strong>@Model.Count</strong>
            </div>
        </div>

        <!-- Test Requests -->
        <div class="requests-container">

            @foreach (var request in Model)
            {
                var status = request.Status?.Trim() ?? "";

                // 1. Determine Badge Color
                var statusClass = "status-default";

                if (status.Equals("Completed", StringComparison.OrdinalIgnoreCase))
                {
                    statusClass = "status-completed";
                }
                else if (status.Equals("Cancelled", StringComparison.OrdinalIgnoreCase))
                {
                    statusClass = "status-cancelled";
                }
                else if (status.Equals("Submitted", StringComparison.OrdinalIgnoreCase))
                {
                    statusClass = "status-submitted";
                }
                else if (status.Equals("In progress", StringComparison.OrdinalIgnoreCase) ||
                         status.Equals("InProgress", StringComparison.OrdinalIgnoreCase) ||
                         status.Equals("Sample(s) received", StringComparison.OrdinalIgnoreCase) ||
                         status.Equals("SamplesReceived", StringComparison.OrdinalIgnoreCase))
                {
                    statusClass = "status-progress";
                }
                else if (status.Equals("Released by doctor", StringComparison.OrdinalIgnoreCase))
                {
                    statusClass = "status-released";
                }

                // 2. Determine Urgency Color
                var urgencyClass = "urgency-normal";

                if (request.Urgency == "Urgent" || request.Urgency == "STAT")
                {
                    urgencyClass = "urgency-urgent";
                }

                // 3. Determine Tracker Stage
                // 1 = Submitted, 2 = Sample Received, 3 = In Progress, 4 = Completed, 5 = Released
                var currentStage = 1;

                if (status.Equals("Sample(s) received", StringComparison.OrdinalIgnoreCase) ||
                    status.Equals("SamplesReceived", StringComparison.OrdinalIgnoreCase))
                {
                    currentStage = 2;
                }
                else if (status.Equals("In progress", StringComparison.OrdinalIgnoreCase) ||
                         status.Equals("InProgress", StringComparison.OrdinalIgnoreCase))
                {
                    currentStage = 3;
                }
                else if (status.Equals("Completed", StringComparison.OrdinalIgnoreCase))
                {
                    currentStage = 4;
                }
                else if (status.Equals("Released by doctor", StringComparison.OrdinalIgnoreCase))
                {
                    currentStage = 5;
                }

                <div class="request-card">

                    <!-- Request Header -->
                    <div class="request-header">

                        <div>
                            <span class="request-number">
                                TEST REQUEST #@request.TestRequestId
                            </span>

                            <h2>
                                <i class="fas fa-file-medical-alt"></i>
                                Laboratory Test Request
                            </h2>
                        </div>

                        <span class="status-badge @statusClass">
                            @request.Status
                        </span>

                    </div>


                    <!-- REQUEST TRACKER -->
                    @if (request.Status != "Cancelled")
                    {
                        <div class="request-tracker">

                            <div class="tracker-header">
                                <div>
                                    <span class="tracker-label">
                                        <i class="fas fa-route"></i>
                                        REQUEST PROGRESS
                                    </span>

                                    <strong>
                                        @if (currentStage == 1)
                                        {
                                            @:Request Submitted
                                        }
                                        else if (currentStage == 2)
                                        {
                                            @:Sample Received
                                        }
                                        else if (currentStage == 3)
                                        {
                                            @:Test In Progress
                                        }
                                        else if (currentStage == 4)
                                        {
                                            @:Testing Completed
                                        }
                                        else
                                        {
                                            @:Released by Doctor
                                        }
                                    </strong>
                                </div>

                                <span class="tracker-count">
                                    Step @currentStage of 5
                                </span>
                            </div>


                            <div class="tracker">

                                <!-- STEP 1 -->
                                <div class="tracker-step
                                    @(currentStage >= 1 ? "completed" : "")
                                    @(currentStage == 1 ? "current" : "")">

                                    <div class="tracker-circle">
                                        @if (currentStage > 1)
                                        {
                                            <i class="fas fa-check"></i>
                                        }
                                        else
                                        {
                                            <i class="fas fa-paper-plane"></i>
                                        }
                                    </div>

                                    <span>Submitted</span>
                                </div>


                                <div class="tracker-line
                                    @(currentStage >= 2 ? "active" : "")">
                                </div>


                                <!-- STEP 2 -->
                                <div class="tracker-step
                                    @(currentStage >= 2 ? "completed" : "")
                                    @(currentStage == 2 ? "current" : "")">

                                    <div class="tracker-circle">
                                        @if (currentStage > 2)
                                        {
                                            <i class="fas fa-check"></i>
                                        }
                                        else
                                        {
                                            <i class="fas fa-vial"></i>
                                        }
                                    </div>

                                    <span>Sample Received</span>
                                </div>


                                <div class="tracker-line
                                    @(currentStage >= 3 ? "active" : "")">
                                </div>


                                <!-- STEP 3 -->
                                <div class="tracker-step
                                    @(currentStage >= 3 ? "completed" : "")
                                    @(currentStage == 3 ? "current" : "")">

                                    <div class="tracker-circle">
                                        @if (currentStage > 3)
                                        {
                                            <i class="fas fa-check"></i>
                                        }
                                        else
                                        {
                                            <i class="fas fa-microscope"></i>
                                        }
                                    </div>

                                    <span>In Progress</span>
                                </div>


                                <div class="tracker-line
                                    @(currentStage >= 4 ? "active" : "")">
                                </div>


                                <!-- STEP 4 -->
                                <div class="tracker-step
                                    @(currentStage >= 4 ? "completed" : "")
                                    @(currentStage == 4 ? "current" : "")">

                                    <div class="tracker-circle">
                                        @if (currentStage > 4)
                                        {
                                            <i class="fas fa-check"></i>
                                        }
                                        else
                                        {
                                            <i class="fas fa-check-double"></i>
                                        }
                                    </div>

                                    <span>Completed</span>
                                </div>


                                <div class="tracker-line
                                    @(currentStage >= 5 ? "active" : "")">
                                </div>


                                <!-- STEP 5 -->
                                <div class="tracker-step
                                    @(currentStage >= 5 ? "completed" : "")
                                    @(currentStage == 5 ? "current" : "")">

                                    <div class="tracker-circle">
                                        @if (currentStage >= 5)
                                        {
                                            <i class="fas fa-check"></i>
                                        }
                                        else
                                        {
                                            <i class="fas fa-user-md"></i>
                                        }
                                    </div>

                                    <span>Released</span>
                                </div>

                            </div>

                        </div>
                    }


                    <!-- Cancelled Tracker -->
                    @if (request.Status == "Cancelled")
                    {
                        <div class="cancelled-tracker">

                            <div class="cancelled-tracker-icon">
                                <i class="fas fa-times"></i>
                            </div>

                            <div>
                                <strong>Request Cancelled</strong>

                                <span>
                                    This laboratory test request has been cancelled.
                                </span>
                            </div>

                        </div>
                    }


                    <!-- Request Information -->
                    <div class="request-info">

                        <div class="info-item">

                            <span class="info-label">
                                <i class="fas fa-user-md"></i>
                                Doctor
                            </span>

                            <strong>
                                Dr. @request.Doctor?.Name @request.Doctor?.Surname
                            </strong>

                        </div>


                        <div class="info-item">

                            <span class="info-label">
                                <i class="fas fa-calendar"></i>
                                Request Date
                            </span>

                            <strong>
                                @request.RequestDate.ToString("dd MMM yyyy HH:mm")
                            </strong>

                        </div>


                        <div class="info-item">

                            <span class="info-label">
                                <i class="fas fa-exclamation-circle"></i>
                                Urgency
                            </span>

                            <span class="urgency-badge @urgencyClass">
                                @request.Urgency
                            </span>

                        </div>

                    </div>


                    <!-- Clinical Notes -->
                    @if (!string.IsNullOrWhiteSpace(request.ClinicalNotes))
                    {
                        <div class="clinical-notes">

                            <span class="info-label">
                                <i class="fas fa-notes-medical"></i>
                                Clinical Notes
                            </span>

                            <p>
                                @request.ClinicalNotes
                            </p>

                        </div>
                    }


                    <!-- Requested Tests -->
                    <div class="section">

                        <div class="section-title">
                            <i class="fas fa-vials"></i>
                            Requested Tests
                        </div>

                        @if (request.TestRequestTestTypes != null &&
                             request.TestRequestTestTypes.Any())
                        {
                            <div class="test-list">

                                @foreach (var item in request.TestRequestTestTypes)
                                {
                                    <div class="test-item">

                                        <div class="test-icon">
                                            <i class="fas fa-vial"></i>
                                        </div>

                                        <div class="test-details">

                                            <strong>
                                                @item.TestType?.TestTypeName
                                            </strong>

                                            <span>
                                                Status: @item.Status
                                            </span>

                                        </div>

                                    </div>
                                }

                            </div>
                        }
                        else
                        {
                            <p class="no-data">
                                No test types have been recorded.
                            </p>
                        }

                    </div>


                    <!-- Samples -->
                    <div class="section">

                        <div class="section-title">
                            <i class="fas fa-prescription-bottle"></i>
                            Samples
                        </div>

                        @if (request.Samples != null &&
                             request.Samples.Any())
                        {
                            <div class="sample-list">

                                @foreach (var sample in request.Samples)
                                {
                                    <div class="sample-item">

                                        <div>
                                            <span class="sample-label">
                                                Sample Type
                                            </span>

                                            <strong>
                                                @sample.SampleType?.SampleName
                                            </strong>
                                        </div>

                                        <div>
                                            <span class="sample-label">
                                                Barcode
                                            </span>

                                            <strong>
                                                @sample.Barcode
                                            </strong>
                                        </div>

                                    </div>
                                }

                            </div>
                        }
                        else
                        {
                            <p class="no-data">
                                No samples have been recorded yet.
                            </p>
                        }

                    </div>


                    <!-- Cancellation Information -->
                    @if (request.Status == "Cancelled")
                    {
                        <div class="cancelled-box">

                            <div class="section-title">
                                <i class="fas fa-times-circle"></i>
                                Cancellation Information
                            </div>

                            @if (!string.IsNullOrWhiteSpace(request.CancelReason))
                            {
                                <p>
                                    <strong>Reason:</strong>
                                    @request.CancelReason
                                </p>
                            }

                            @if (request.CancellationDate.HasValue)
                            {
                                <p>
                                    <strong>Cancelled:</strong>
                                    @request.CancellationDate.Value.ToString("dd MMM yyyy HH:mm")
                                </p>
                            }

                        </div>
                    }


                    <!-- Released Results -->
                    @if (request.Status == "Released by doctor")
                    {
                        <div class="released-box">

                            <div>

                                <i class="fas fa-check-circle"></i>

                                <div>

                                    <strong>
                                        Results Released
                                    </strong>

                                    <span>
                                        Your doctor has released the results
                                        for this test request.
                                    </span>

                                </div>

                            </div>

                            <a asp-controller="Patient"
                               asp-action="Result"
                               class="view-results-btn">

                                <i class="fas fa-file-medical"></i>
                                View Results

                            </a>

                        </div>
                    }

                </div>
            }

        </div>
    }

</div>


<style>

    .patient-page {
        width: 100%;
        max-width: 1400px;
        margin: 0 auto;
        padding: 24px;
        color: #172033;
    }

    /* Header */

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 28px;
    }

    .page-label {
        color: #3157c7;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.08em;
        margin-bottom: 6px;
    }

        .page-label i {
            margin-right: 6px;
        }

    .page-header h1 {
        margin: 0;
        font-size: 32px;
        font-weight: 700;
        color: #172033;
    }

    .page-header p {
        margin: 8px 0 0;
        color: #718096;
        font-size: 15px;
    }

    .back-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 11px 18px;
        border: 1px solid #dce2ea;
        border-radius: 8px;
        background: #fff;
        color: #3157c7;
        text-decoration: none;
        font-weight: 600;
        transition: 0.2s ease;
    }

        .back-btn:hover {
            background: #f5f7fb;
            color: #2447aa;
        }

    /* Alerts */

    .alert {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 14px 18px;
        border-radius: 8px;
        margin-bottom: 22px;
    }

    .success-alert {
        background: #eef9f2;
        border: 1px solid #c9ead4;
        color: #267346;
    }

    /* Summary */

    .summary-card {
        display: flex;
        align-items: center;
        gap: 16px;
        background: #fff;
        border: 1px solid #e7ebf1;
        border-radius: 12px;
        padding: 20px 24px;
        margin-bottom: 24px;
        box-shadow: 0 3px 12px rgba(23, 32, 51, 0.05);
        width: fit-content;
        min-width: 220px;
    }

    .summary-icon {
        width: 48px;
        height: 48px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #edf2ff;
        color: #3157c7;
        font-size: 21px;
    }

    .summary-label {
        display: block;
        font-size: 11px;
        font-weight: 700;
        color: #718096;
        letter-spacing: 0.07em;
        margin-bottom: 3px;
    }

    .summary-card strong {
        font-size: 25px;
        color: #172033;
    }

    /* Empty State */

    .empty-state {
        background: #fff;
        border: 1px solid #e7ebf1;
        border-radius: 14px;
        padding: 60px 30px;
        text-align: center;
        box-shadow: 0 3px 12px rgba(23, 32, 51, 0.05);
    }

    .empty-icon {
        width: 72px;
        height: 72px;
        margin: 0 auto 18px;
        border-radius: 50%;
        background: #edf2ff;
        color: #3157c7;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
    }

    .empty-state h2 {
        margin: 0 0 8px;
        font-size: 23px;
    }

    .empty-state p {
        color: #718096;
        margin-bottom: 22px;
    }

    .primary-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 11px 20px;
        border-radius: 8px;
        background: #3157c7;
        color: white;
        text-decoration: none;
        font-weight: 600;
    }

        .primary-btn:hover {
            background: #2447aa;
            color: white;
        }

    /* Request Card */

    .request-card {
        background: #fff;
        border: 1px solid #e7ebf1;
        border-radius: 14px;
        margin-bottom: 22px;
        padding: 24px;
        box-shadow: 0 4px 14px rgba(23, 32, 51, 0.05);
    }

    .request-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
        padding-bottom: 20px;
        border-bottom: 1px solid #edf0f4;
    }

    .request-number {
        display: block;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.07em;
        color: #718096;
        margin-bottom: 6px;
    }

    .request-header h2 {
        margin: 0;
        font-size: 20px;
        color: #172033;
    }

        .request-header h2 i {
            color: #3157c7;
            margin-right: 7px;
        }

    /* Status */

    .status-badge,
    .urgency-badge {
        display: inline-flex;
        align-items: center;
        padding: 6px 11px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

    .status-default {
        background: #edf0f4;
        color: #526071;
    }

    .status-submitted {
        background: #edf2ff;
        color: #3157c7;
    }

    .status-progress {
        background: #fff6df;
        color: #9a6b00;
    }

    .status-completed {
        background: #eaf8ef;
        color: #267346;
    }

    .status-cancelled {
        background: #fdecec;
        color: #b53a3a;
    }

    .status-released {
        background: #e8f7f5;
        color: #16766b;
    }

    .urgency-normal {
        background: #edf0f4;
        color: #526071;
    }

    .urgency-urgent {
        background: #fdecec;
        color: #b53a3a;
    }


    /* =========================
           REQUEST TRACKER
           ========================= */

    .request-tracker {
        margin: 22px 0 6px;
        padding: 20px;
        background: #f8f9fc;
        border: 1px solid #e7ebf1;
        border-radius: 12px;
    }

    .tracker-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        margin-bottom: 24px;
    }

        .tracker-header > div {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

    .tracker-label {
        color: #718096;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.07em;
    }

        .tracker-label i {
            color: #3157c7;
            margin-right: 5px;
        }

    .tracker-header strong {
        font-size: 15px;
        color: #172033;
    }

    .tracker-count {
        padding: 6px 10px;
        border-radius: 15px;
        background: #edf2ff;
        color: #3157c7;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
    }

    .tracker {
        display: flex;
        align-items: flex-start;
        width: 100%;
    }

    .tracker-step {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        min-width: 90px;
        flex: 0 0 90px;
        gap: 8px;
    }

    .tracker-circle {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: #e8ebf0;
        color: #8a94a6;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        border: 3px solid #e8ebf0;
        transition: 0.2s ease;
    }

    .tracker-step span {
        font-size: 11px;
        line-height: 1.3;
        color: #8a94a6;
        font-weight: 600;
    }

    .tracker-step.completed .tracker-circle {
        background: #3157c7;
        border-color: #3157c7;
        color: white;
    }

    .tracker-step.completed span {
        color: #3157c7;
    }

    .tracker-step.current .tracker-circle {
        box-shadow: 0 0 0 5px rgba(49, 87, 199, 0.10);
    }

    .tracker-step.current span {
        font-weight: 700;
    }

    .tracker-line {
        height: 3px;
        flex: 1;
        background: #e1e5eb;
        margin-top: 20px;
        min-width: 20px;
        border-radius: 5px;
    }

        .tracker-line.active {
            background: #3157c7;
        }


    /* Cancelled Tracker */

    .cancelled-tracker {
        display: flex;
        align-items: center;
        gap: 14px;
        margin: 22px 0 6px;
        padding: 16px;
        border-radius: 10px;
        background: #fff5f5;
        border: 1px solid #f3cccc;
    }

    .cancelled-tracker-icon {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #fdecec;
        color: #b53a3a;
    }

    .cancelled-tracker strong,
    .cancelled-tracker span {
        display: block;
    }

    .cancelled-tracker strong {
        color: #b53a3a;
        margin-bottom: 3px;
    }

    .cancelled-tracker span {
        color: #7d5656;
        font-size: 13px;
    }


    /* Request Info */

    .request-info {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        padding: 22px 0;
    }

    .info-item {
        display: flex;
        flex-direction: column;
        gap: 7px;
    }

    .info-label {
        color: #718096;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

        .info-label i {
            color: #3157c7;
            margin-right: 5px;
        }

    .info-item strong {
        color: #172033;
        font-size: 14px;
    }


    /* Clinical Notes */

    .clinical-notes {
        background: #f8f9fc;
        border-radius: 9px;
        padding: 16px;
        margin-bottom: 22px;
    }

        .clinical-notes p {
            margin: 8px 0 0;
            color: #4a5568;
            line-height: 1.6;
            font-size: 14px;
        }


    /* Sections */

    .section {
        border-top: 1px solid #edf0f4;
        padding-top: 20px;
        margin-top: 20px;
    }

    .section-title {
        font-size: 14px;
        font-weight: 700;
        color: #172033;
        margin-bottom: 14px;
    }

        .section-title i {
            color: #3157c7;
            margin-right: 7px;
        }


    /* Tests */

    .test-list {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 10px;
    }

    .test-item {
        display: flex;
        align-items: center;
