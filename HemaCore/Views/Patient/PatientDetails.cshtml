@model HemaCore.Models.Patient

@{
    Layout = "~/Views/Shared/_PatientLayout.cshtml";
    ViewBag.Title = "My Details";

    var conditions =
        ViewBag.Conditions as List<HemaCore.Models.PatientCondition>
        ?? new();

    var allergies =
        ViewBag.Allergies as List<HemaCore.Models.PatientAllergy>
        ?? new();

    var medications =
        ViewBag.Medications as List<HemaCore.Models.PatientMedication>
        ?? new();
}


<div class="container-fluid p-4">

    <div class="content-card">

        <!-- HEADER -->
        <div class="section-title d-flex align-items-center mb-2">

            <i class="fas fa-id-card me-2"></i>

            <span>My Details</span>

        </div>

        <div class="d-flex justify-content-between align-items-center mb-4">

            <p class="text-muted mb-0">
                Your personal information and medical history on record.
            </p>

            <a asp-action="EditProfile"
               class="btn btn-primary-custom">

                <i class="fas fa-edit me-2"></i>

                Edit Profile

            </a>

        </div>


        <!-- INCOMPLETE PROFILE -->
        @if (string.IsNullOrWhiteSpace(Model.Name)
            || string.IsNullOrWhiteSpace(Model.Surname))
        {
            <div class="alert alert-info">

                <i class="fas fa-info-circle me-2"></i>

                Your profile is incomplete.

                <a asp-action="CompleteProfile"
                   class="fw-semibold">

                    Complete it now →

                </a>

            </div>
        }


        <!-- PERSONAL INFORMATION -->
        <div class="mb-5">

            <h5 class="fw-bold mb-3">

                <i class="fas fa-user-circle me-2"></i>

                Personal Information

            </h5>

            <hr />


            <div class="row g-4">

                <!-- FIRST NAME -->
                <div class="col-md-6">

                    <small class="text-muted text-uppercase fw-semibold">
                        First Name
                    </small>

                    <div class="mt-1 fw-semibold">

                        @(string.IsNullOrWhiteSpace(Model.Name)
                            ? "—"
                            : Model.Name)

                    </div>

                </div>


                <!-- LAST NAME -->
                <div class="col-md-6">

                    <small class="text-muted text-uppercase fw-semibold">
                        Last Name
                    </small>

                    <div class="mt-1 fw-semibold">

                        @(string.IsNullOrWhiteSpace(Model.Surname)
                            ? "—"
                            : Model.Surname)

                    </div>

                </div>


                <!-- ID -->
                <div class="col-md-6">

                    <small class="text-muted text-uppercase fw-semibold">
                        ID Number
                    </small>

                    <div class="mt-1 fw-semibold">

                        @(string.IsNullOrWhiteSpace(Model.IDNumber)
                            ? "—"
                            : Model.IDNumber)

                    </div>

                </div>


                <!-- GENDER -->
                <div class="col-md-6">

                    <small class="text-muted text-uppercase fw-semibold">
                        Gender
                    </small>

                    <div class="mt-1 fw-semibold">

                        @(string.IsNullOrWhiteSpace(Model.Gender)
                            ? "—"
                            : Model.Gender)

                    </div>

                </div>


                <!-- DOB -->
                <div class="col-md-6">

                    <small class="text-muted text-uppercase fw-semibold">
                        Date of Birth
                    </small>

                    <div class="mt-1 fw-semibold">

                        @(Model.DateOfBirth == default
                            ? "—"
                            : Model.DateOfBirth.ToString("yyyy-MM-dd"))

                    </div>

                </div>


                <!-- PHONE -->
                <div class="col-md-6">

                    <small class="text-muted text-uppercase fw-semibold">
                        Phone Number
                    </small>

                    <div class="mt-1 fw-semibold">

                        @(string.IsNullOrWhiteSpace(Model.PhoneNumber)
                            ? "—"
                            : Model.PhoneNumber)

                    </div>

                </div>


                <!-- ADDRESS -->
                <div class="col-12">
                    <h5 class="fw-bold mb-3">Residential Address</h5>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="StreetAddress" class="form-label fw-semibold">
                        Street Address
                    </label>
                    <input asp-for="StreetAddress"
                           class="form-control"
                           placeholder="Enter your street address" />
                    <span asp-validation-for="StreetAddress" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Suburb" class="form-label fw-semibold">
                        Suburb
                    </label>
                    <input asp-for="Suburb"
                           class="form-control"
                           placeholder="Enter your suburb" />
                    <span asp-validation-for="Suburb" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="City" class="form-label fw-semibold">
                        City
                    </label>
                    <input asp-for="City"
                           class="form-control"
                           placeholder="Enter your city" />
                    <span asp-validation-for="City" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Province" class="form-label fw-semibold">
                        Province
                    </label>
                    <select asp-for="Province" class="form-select">
                        <option value="">-- Select Province --</option>
                        <option value="Eastern Cape">Eastern Cape</option>
                        <option value="Free State">Free State</option>
                        <option value="Gauteng">Gauteng</option>
                        <option value="KwaZulu-Natal">KwaZulu-Natal</option>
                        <option value="Limpopo">Limpopo</option>
                        <option value="Mpumalanga">Mpumalanga</option>
                        <option value="Northern Cape">Northern Cape</option>
                        <option value="North West">North West</option>
                        <option value="Western Cape">Western Cape</option>
                    </select>
                    <span asp-validation-for="Province" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="PostalCode" class="form-label fw-semibold">
                        Postal Code
                    </label>
                    <input asp-for="PostalCode"
                           class="form-control"
                           placeholder="Enter 4-digit postal code"
                           maxlength="4" />
                    <span asp-validation-for="PostalCode" class="text-danger"></span>
                </div>

                  

                <!-- EMAIL -->
                <div class="col-md-6">

                    <small class="text-muted text-uppercase fw-semibold">
                        Email
                    </small>

                    <div class="mt-1 fw-semibold">

                        @(Model.User?.Email ?? "—")

                    </div>

                </div>

            </div>

        </div>


        <!-- CONDITIONS -->
        <div class="mb-5">

            <h5 class="fw-bold mb-3">

                <i class="fas fa-notes-medical me-2"></i>

                Medical Conditions

                <span class="badge bg-primary ms-2">
                    @conditions.Count
                </span>

            </h5>

            <hr />


            @if (conditions.Any())
            {
                <div class="d-flex flex-wrap gap-2">

                    @foreach (var pc in conditions)
                    {
                        <span class="badge bg-primary p-2">

                            <i class="fas fa-notes-medical me-1"></i>

                            @pc.Condition?.Name

                        </span>
                    }

                </div>
            }
            else
            {
                <div class="text-muted">

                    <i class="fas fa-info-circle me-2"></i>

                    No conditions recorded.

                </div>
            }

        </div>


        <!-- ALLERGIES -->
        <div class="mb-5">

            <h5 class="fw-bold mb-3">

                <i class="fas fa-allergies me-2"></i>

                Allergies

                <span class="badge bg-danger ms-2">
                    @allergies.Count
                </span>

            </h5>

            <hr />


            @if (allergies.Any())
            {
                <div class="d-flex flex-wrap gap-2">

                    @foreach (var pa in allergies)
                    {
                        <span class="badge bg-danger p-2">

                            <i class="fas fa-allergies me-1"></i>

                            @pa.Allergy?.Name

                        </span>
                    }

                </div>
            }
            else
            {
                <div class="text-muted">

                    <i class="fas fa-info-circle me-2"></i>

                    No allergies recorded.

                </div>
            }

        </div>


        <!-- MEDICATIONS -->
        <div class="mb-4">

            <h5 class="fw-bold mb-3">

                <i class="fas fa-pills me-2"></i>

                Current Medications

                <span class="badge bg-success ms-2">
                    @medications.Count
                </span>

            </h5>

            <hr />


            @if (medications.Any())
            {
                <div class="d-flex flex-wrap gap-2">

                    @foreach (var pm in medications)
                    {
                        <span class="badge bg-success p-2">

                            <i class="fas fa-pills me-1"></i>

                            @pm.Medication?.Name

                        </span>
                    }

                </div>
            }
            else
            {
                <div class="text-muted">

                    <i class="fas fa-info-circle me-2"></i>

                    No medications recorded.

                </div>
            }

        </div>

    </div>

</div>