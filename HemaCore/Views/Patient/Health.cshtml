    margin-top: 3px;
    color: #718096;
    font-size: 13px;
    }

    .period-form {
    display: flex;
    align-items: center;
    gap: 15px;
    flex-wrap: wrap;
    }

    .period-form select {
    min-width: 190px;
    padding: 10px 13px;
    border: 1px solid #dce2ea;
    border-radius: 8px;
    background: #fff;
    color: #172033;
    font-size: 14px;
