    padding: 20px;
    display: flex;
    align-items: center;
    gap: 15px;
    box-shadow: 0 3px 12px rgba(23,32,51,.05);
    }

    .summary-icon {
    width: 48px;
    height: 48px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    }

    .tests-icon {
    background: #f1f4fb;
    color: #3157c7;
    }

    .completed-icon {
    background: #eef9f2;
    color: #267346;
    }

    .abnormal-icon {
    background: #fff4f1;
    color: #c0392b;
    }

    .summary-card span {
    display: block;
    color: #718096;
    font-size: 13px;
    }

    .summary-card strong {
    display: block;
    margin-top: 3px;
    font-size: 25px;
    }

    .health-card {
    background: #fff;
    border: 1px solid #e7ebf1;
    border-radius: 12px;
    margin-bottom: 24px;
    box-shadow: 0 3px 12px rgba(23,32,51,.05);
    overflow: hidden;
    }

    .card-header {
    padding: 20px 24px;
    border-bottom: 1px solid #edf0f4;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    }

    .card-header h2 {
    margin: 0;
    font-size: 19px;
    }

    .card-header h2 i {
    color: #3157c7;
    margin-right: 7px;
    }

    .card-header p {
