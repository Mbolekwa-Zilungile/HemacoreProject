@model List<HemaCore.Models.TestRequest>
@using System.Text.Json

@{
    ViewData["Title"] = "My Health";
    Layout = "_PatientLayout";

    var availableTests = ViewBag.AvailableTests as IEnumerable<dynamic> ?? new List<dynamic>();
    var selectedTestTypeId = ViewBag.SelectedTestTypeId as int?;

    var graphLabels = ViewBag.GraphLabels as List<string> ?? new List<string>();
    var graphValues = ViewBag.GraphValues as List<double> ?? new List<double>();

    double normalMin = ViewBag.NormalMin ?? 0.0;
    double normalMax = ViewBag.NormalMax ?? 0.0;
    string unit = ViewBag.Unit?.ToString() ?? "";

    var totalTests = ViewBag.TotalTests ?? 0;
    var completedTests = ViewBag.CompletedTests ?? 0;
    var abnormalResults = ViewBag.AbnormalResults ?? 0;

    var conditions = ViewBag.Conditions as IEnumerable<HemaCore.Models.PatientCondition> ?? new List<HemaCore.Models.PatientCondition>();
    var selectedPeriod = ViewBag.Period?.ToString() ?? "all";

    // JSON for the chart
    var labelsJson = JsonSerializer.Serialize(graphLabels);
    var valuesJson = JsonSerializer.Serialize(graphValues);

    // Create arrays for the normal range lines (same length as data)
    var minLines = Enumerable.Repeat(normalMin, graphLabels.Count).ToList();
    var maxLines = Enumerable.Repeat(normalMax, graphLabels.Count).ToList();
    var minJson = JsonSerializer.Serialize(minLines);
    var maxJson = JsonSerializer.Serialize(maxLines);
}

<div class="health-page">

    <!-- HEADER -->
    <div class="health-header">
        <div>
            <div class="health-label">
                <i class="fas fa-heartbeat"></i>
                MY HEALTH
            </div>
            <h1>My Health</h1>
            <p>Track your health activity and laboratory tests over time.</p>
        </div>
    </div>

    <!-- FILTER -->
    <div class="health-filter-card">
        <div class="filter-title">
            <div class="filter-icon">
                <i class="fas fa-filter"></i>
            </div>
            <div>
                <strong>Filter Health Data</strong>
                <span>Select a specific test and time period to view trends.</span>
            </div>
        </div>

        <form asp-controller="Patient" asp-action="Health" method="get" class="period-form">
            <!-- Period Selector -->
            <div style="display:flex; flex-direction:column; gap:5px;">
                <label for="period" style="font-size:11px; color:#718096; margin-bottom:2px;">Time Period</label>
                <select id="period" name="period" onchange="this.form.submit()">
                    <option value="7" selected="@(selectedPeriod == "7")">Last 7 days</option>
                    <option value="30" selected="@(selectedPeriod == "30")">Last 30 days</option>
                    <option value="90" selected="@(selectedPeriod == "90")">Last 3 months</option>
                    <option value="180" selected="@(selectedPeriod == "180")">Last 6 months</option>
                    <option value="365" selected="@(selectedPeriod == "365")">Last year</option>
                    <option value="all" selected="@(selectedPeriod == "all")">All history</option>
                </select>
            </div>

            <!-- Test Selector -->
            <div style="display:flex; flex-direction:column; gap:5px;">
                <label for="testTypeId" style="font-size:11px; color:#718096; margin-bottom:2px;">Select Test</label>
                <select id="testTypeId" name="testTypeId" onchange="this.form.submit()">
                    <option value="">-- Choose a Test --</option>
                    @foreach (var test in availableTests)
                    {
                        <option value="@test.TestTypeId" selected="@(selectedTestTypeId == test.TestTypeId)">
                            @test.TestTypeName
                        </option>
                    }
                </select>
            </div>
        </form>
    </div>

    <!-- SUMMARY CARDS -->
    <div class="summary-grid">
        <div class="summary-card">
            <div class="summary-icon tests-icon"><i class="fas fa-vials"></i></div>
            <div><span>Total Tests</span><strong>@totalTests</strong></div>
        </div>
        <div class="summary-card">
            <div class="summary-icon completed-icon"><i class="fas fa-check-circle"></i></div>
            <div><span>Completed</span><strong>@completedTests</strong></div>
        </div>
        <div class="summary-card">
            <div class="summary-icon abnormal-icon"><i class="fas fa-exclamation-triangle"></i></div>
            <div><span>Abnormal Results</span><strong>@abnormalResults</strong></div>
        </div>
    </div>

    <!-- GRAPH -->
    <div class="health-card">
        <div class="card-header">
            <div>
                <h2><i class="fas fa-chart-line"></i> Test Results Trend</h2>
                <p>
                    @if (selectedTestTypeId.HasValue)
                    {
                        <span>Showing results for the selected test. Red lines indicate normal ranges.</span>
                    }
                    else
                    {
                        <span>Select a test from the dropdown above to view its graph.</span>
                    }
                </p>
            </div>
        </div>

        @if (!selectedTestTypeId.HasValue)
        {
            <div class="empty-health">
                <div class="empty-health-icon"><i class="fas fa-hand-pointer"></i></div>
                <h3>No Test Selected</h3>
                <p>Please select a test from the filter above to view your progress graph.</p>
            </div>
        }
        else if (graphLabels.Any())
        {
            <div class="chart-container">
                <canvas id="healthChart"></canvas>
            </div>
        }
        else
        {
            <div class="empty-health">
                <div class="empty-health-icon"><i class="fas fa-chart-line"></i></div>
                <h3>No Data Available</h3>
                <p>You do not have verified results for this test in the selected time period.</p>
            </div>
        }
    </div>

    <!-- CONDITIONS & RECENT TESTS -->
    <div class="health-card conditions-card">
        <div class="card-header">
            <div>
                <h2><i class="fas fa-notes-medical"></i> Known Health Conditions</h2>
                <p>Conditions currently recorded on your health profile.</p>
            </div>
            <span class="condition-count">@conditions.Count()</span>
        </div>

        @if (conditions.Any())
        {
            <div class="conditions-grid">
                @foreach (var pc in conditions)
                {
                    <div class="condition-item">
                        <div class="condition-icon"><i class="fas fa-heartbeat"></i></div>
                        <div>
                            <strong>@pc.Condition?.Name</strong>
                            @if (!string.IsNullOrWhiteSpace(pc.Condition?.Description))
                            {
                                <span>@pc.Condition.Description</span>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="no-conditions">
                <i class="fas fa-check-circle"></i>
                <span>No health conditions are currently recorded.</span>
            </div>
        }
    </div>

    <div class="health-card">
        <div class="card-header">
            <div>
                <h2><i class="fas fa-vial"></i> Recent Tests</h2>
                <p>Your latest laboratory test activity.</p>
            </div>
            <a asp-controller="Patient" asp-action="MyTestRequests" class="view-all-btn">
                View Requests <i class="fas fa-arrow-right"></i>
            </a>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="recent-tests">
                @foreach (var request in Model.OrderByDescending(r => r.RequestDate).Take(5))
                {
                    <div class="recent-test-row">
                        <div class="recent-test-icon"><i class="fas fa-flask"></i></div>
                        <div class="recent-test-info">
                            <strong>Test Request #@request.TestRequestId</strong>
                            <span>@request.RequestDate.ToString("dd MMM yyyy HH:mm")</span>
                        </div>
                        <div class="recent-test-count">
                            <strong>@(request.TestRequestTestTypes?.Count ?? 0)</strong>
                            <span>test(s)</span>
                        </div>
                        <div class="recent-test-status">
                            <span>@request.Status</span>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="no-conditions">
                <i class="fas fa-info-circle"></i>
                <span>No test requests have been recorded yet.</span>
            </div>
        }
    </div>

</div>

<!-- CHART.JS -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
    const chartElement = document.getElementById("healthChart");
    if (!chartElement) return;

    const labels = @Html.Raw(labelsJson);
    const dataValues = @Html.Raw(valuesJson);
    const minLineData = @Html.Raw(minJson);
    const maxLineData = @Html.Raw(maxJson);
    const unitLabel = "@Html.Raw(unit)";

    if (labels.length > 0) {
    new Chart(chartElement, {
    type: "line",
    data: {
    labels: labels,
    datasets: [
    {
    // The actual test results
    label: `Result (${unitLabel})`,
    data: dataValues,
    tension: 0.3,
    borderWidth: 3,
    borderColor: "#3157c7",
    backgroundColor: "rgba(49, 87, 199, 0.1)",
    pointBackgroundColor: "#3157c7",
    pointRadius: 5,
    pointHoverRadius: 7,
    fill: false
    },
    {
    // Normal Minimum line
    label: "Normal Min",
    data: minLineData,
    borderDash: [5, 5],
    borderColor: "#c0392b",
    borderWidth: 2,
    pointRadius: 0,
    pointHoverRadius: 0,
    fill: false
    },
    {
    // Normal Maximum line
    label: "Normal Max",
    data: maxLineData,
    borderDash: [5, 5],
    borderColor: "#c0392b",
    borderWidth: 2,
    pointRadius: 0,
    pointHoverRadius: 0,
    fill: false
    }
    ]
    },
    options: {
    responsive: true,
    maintainAspectRatio: false,
    interaction: {
    intersect: false,
    mode: "index"
    },
    plugins: {
    legend: {
    display: true,
    position: "top"
    },
    tooltip: {
    callbacks: {
    label: function(context) {
    return context.dataset.label + ": " + context.parsed.y;
    }
    }
    }
    },
    scales: {
    y: {
    title: {
    display: true,
    text: `Result Value (${unitLabel})`
    }
    },
    x: {
    title: {
    display: true,
    text: "Date of Test"
    }
    }
    }
    }
    });
    }
    });
</script>

<style>
