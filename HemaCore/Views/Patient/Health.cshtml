    }

    .health-label {
    color: #3157c7;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: .08em;
    margin-bottom: 6px;
    }

    .health-label i {
    margin-right: 6px;
    }

    .health-header h1 {
    margin: 0;
    font-size: 32px;
    font-weight: 700;
    }

    .health-header p {
    margin: 8px 0 0;
    color: #718096;
    }

    .health-filter-card {
    background: #fff;
    border: 1px solid #e7ebf1;
    border-radius: 12px;
    padding: 20px 24px;
    margin-bottom: 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    box-shadow: 0 3px 12px rgba(23,32,51,.05);
    flex-wrap: wrap;
    }

