            color: #15803d;
        }

        .cr-history-message.rejected i {
            color: #dc2626;
        }

    .cr-empty-card {
        padding: 35px 20px;
        background: #fff;
        border: 1px solid #e7ebf1;
        border-radius: 17px;
        box-shadow: 0 5px 18px rgba(15,23,42,.045);
    }

    .cr-empty-icon {
        width: 52px;
        height: 52px;
        margin: 0 auto 12px;
        border-radius: 14px;
        color: #7d8797;
        background: #f1f4f8;
        font-size: 21px;
    }

    .cr-empty-card h3 {
        margin: 0 0 5px;
        color: #344054;
        font-size: 14px;
    }

    .cr-empty-card p {
        max-width: 480px;
        margin: 0 auto 16px;
        color: #8a94a6;
        font-size: 11px;
        line-height: 1.8;
    }

    .cr-empty-tag {
        color: #3157c7;
        background: #f5f8ff;
        font-size: 10px;
    }

    .cr-bottom-help {
        gap: 16px;
        margin-top: 20px;
    }

    .cr-help-card {
        padding: 20px;
        background: #fff;
        border: 1px solid #e7ebf1;
        border-radius: 14px;
        box-shadow: 0 5px 18px rgba(15,23,42,.035);
    }

        .cr-help-card h4 {
            gap: 9px;
            margin: 0 0 12px;
            color: #263246;
            font-size: 13px;
            font-weight: 750;
        }

            .cr-help-card h4 i {
                color: #3157c7;
                font-size: 16px;
            }

        .cr-help-card p,
        .cr-step {
            color: #8a94a6;
            font-size: 11px;
            line-height: 1.7;
        }

    .cr-step-number {
        width: 25px;
        height: 25px;
        color: #3157c7;
        background: #eef2ff;
        font-size: 10px;
        font-weight: 800;
    }

    @@media (max-width: 1100px) {
        .cr-page {
            padding: 24px 20px 35px;
        }

        .cr-test-list {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 850px) {
        .cr-summary {
            grid-template-columns: 1fr;
            gap: 12px;
        }

        .cr-bottom-help,
        .cr-form-row {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 600px) {
        .cr-page {
            padding: 18px 14px 30px;
        }

        .cr-header {
            align-items: flex-start;
        }

            .cr-header h1 {
                font-size: 24px;
            }

        .cr-header-icon {
            width: 48px;
            height: 48px;
            flex-basis: 48px;
            font-size: 20px;
        }

        .cr-request-top {
            align-items: flex-start;
            flex-direction: column;
            padding: 17px;
        }

        .cr-request-body {
            padding: 17px;
        }

        .cr-actions {
            flex-direction: column;
        }

        .cr-button {
            width: 100%;
        }

        .cr-empty-card {
            padding: 30px 16px;
        }
    }

</style>

<div class="cr-page">

    <!-- HEADER -->
    <div class="cr-header">
        <div>
            <span class="cr-eyebrow">Patient Portal</span>
            <h1>Consent Requests</h1>
            <p>
                Review requests from doctors who need permission to access
                your medical test results. You decide what to share
                and how long access should last.
            </p>
        </div>

        <div class="cr-header-icon">
            <i class="fas fa-user-shield"></i>
        </div>
    </div>

    <!-- ALERTS -->
    @if (TempData["Success"] != null)
    {
        <div class="cr-alert cr-alert-success" role="status">
            <i class="fas fa-check-circle"></i>
            <div>@TempData["Success"]</div>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="cr-alert cr-alert-error" role="alert">
            <i class="fas fa-exclamation-circle"></i>
            <div>@TempData["Error"]</div>
        </div>
    }

    <!-- SUMMARY -->
    <div class="cr-summary">
        <div class="cr-summary-card">
            <div class="cr-summary-icon cr-icon-blue">
                <i class="fas fa-inbox"></i>
            </div>
            <div>
                <span class="cr-summary-number">@pendingCount</span>
                <span class="cr-summary-label">Pending requests</span>
            </div>
        </div>

        <div class="cr-summary-card">
            <div class="cr-summary-icon cr-icon-green">
                <i class="fas fa-check-circle"></i>
            </div>
            <div>
                <span class="cr-summary-number">@approvedCount</span>
                <span class="cr-summary-label">Approved requests</span>
            </div>
        </div>

        <div class="cr-summary-card">
            <div class="cr-summary-icon cr-icon-purple">
                <i class="fas fa-history"></i>
            </div>
            <div>
                <span class="cr-summary-number">@rejectedCount</span>
                <span class="cr-summary-label">Rejected requests</span>
            </div>
        </div>
    </div>

    <!-- REQUESTS -->
    <section>
        <h2 class="cr-section-title">Your requests</h2>
        <p class="cr-section-description">
            Requests sent by doctors will appear here. Review each request
            and decide whether to approve or reject it.
        </p>

        @if (!requests.Any())
        {
            <div class="cr-empty-card">
                <div class="cr-empty-icon">
                    <i class="fas fa-envelope-open-text"></i>
                </div>

                <h3>No consent requests yet</h3>

                <p>
                    When a doctor requests permission to access your medical
                    information, the request will appear here. You can review
                    it and choose whether to approve or reject it.
                </p>

                <span class="cr-empty-tag">
                    <i class="fas fa-shield-alt"></i>
                    Your medical information stays under your control
                </span>
            </div>
        }
        else
        {
            <div class="cr-request-list">
                @foreach (var request in requests)
                {
                    var doctorName = request.Doctor != null
                        ? $"Dr. {request.Doctor.Name} {request.Doctor.Surname}"
                        : "Doctor details unavailable";

                    var statusClass = request.Status == "Pending"
                        ? "cr-status-pending"
                        : request.Status == "Approved"
                            ? "cr-status-approved"
                            : request.Status == "Rejected"
                                ? "cr-status-rejected"
                                : "cr-status-pending";

                    var statusIcon = request.Status == "Pending"
                        ? "fa-clock"
                        : request.Status == "Approved"
                            ? "fa-check-circle"
                            : request.Status == "Rejected"
                                ? "fa-times-circle"
                                : "fa-info-circle";

                    <article class="cr-request-card">
                        <div class="cr-request-top">
                            <div class="cr-doctor-info">
                                <div class="cr-doctor-icon">
                                    <i class="fas fa-user-md"></i>
                                </div>

                                <div>
                                    <h3>@doctorName</h3>
                                    <div class="cr-request-date">
                                        <i class="far fa-calendar-alt"></i>
                                        Requested on
                                        @(request.RequestedAt.ToLocalTime()
                                            .ToString("dd MMM yyyy, HH:mm"))
                                    </div>
                                </div>
                            </div>

                            <span class="cr-status @statusClass">
                                <i class="fas @statusIcon"></i>
                                @request.Status
                            </span>
                        </div>

                        <div class="cr-request-body">
                            @if (request.Status == "Pending")
                            {
                                <form asp-controller="Patient"
                                      asp-action="ApproveConsentRequest"
                                      method="post"
                                      class="cr-approve-form">

                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="requestId" value="@request.Id" />

                                    @if (releasedTestRequests.Any())
                                    {
                                        <div class="cr-form-section">
                                            <h4>
                                                <i class="fas fa-file-medical"></i>
                                                Select released test results to share
                                            </h4>

                                            <p class="cr-help-text">
                                                Select the released test results you want to share
                                                with this doctor. Sharing results is optional — you
                                                can approve the request now and share results later
                                                by granting a new consent.
                                            </p>

                                            <div class="cr-test-list">
                                                @foreach (var testRequest in releasedTestRequests)
                                                {
                                                    var verifiedTestNames = testRequest
                                                        .TestRequestTestTypes?
                                                        .Where(t =>
                                                            t.TestResult != null &&
                                                            t.TestResult.TestResultVerification != null &&
                                                            t.TestResult.TestResultVerification.Status == "Verified")
                                                        .Select(t => t.TestType?.TestTypeName)
                                                        .Where(name => !string.IsNullOrWhiteSpace(name))
                                                        .ToList()
                                                        ?? new List<string?>();

                                                    var checkboxId =
                                                        $"test-{request.Id}-{testRequest.TestRequestId}";

                                                    <label class="cr-test-option" for="@checkboxId">
                                                        <input type="checkbox"
                                                               name="selectedTestRequestIds"
                                                               value="@testRequest.TestRequestId"
                                                               id="@checkboxId" />

                                                        <span>
                                                            <span class="cr-test-title">
                                                                Test Request #@testRequest.TestRequestId
                                                            </span>

                                                            <span class="cr-test-names">
                                                                @if (verifiedTestNames.Any())
                                                                {
                                                                    @string.Join(", ", verifiedTestNames)
                                                                }
                                                                else
                                                                {
                                                                    <text>Test details unavailable</text>
                                                                }

                                                                <br />
                                                                <i class="far fa-calendar-alt"></i>
                                                                Released
                                                                @(testRequest.ReleasedToPatientDate?
                                                                    .ToLocalTime()
                                                                    .ToString("dd MMM yyyy HH:mm")
                                                                    ?? "—")
                                                            </span>
                                                        </span>
                                                    </label>
                                                }
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="cr-alert cr-alert-info">
                                            <i class="fas fa-info-circle"></i>
                                            <div>
                                                <strong>No released test results available.</strong>
                                                You can still approve this request. Once your
                                                doctor releases results to you, you can share them
                                                by revoking the consent and granting a new one.
                                            </div>
                                        </div>
                                    }

                                    <div class="cr-form-section">
                                        <h4>
                                            <i class="fas fa-hourglass-half"></i>
                                            Set consent duration
                                        </h4>

                                        <p class="cr-help-text">
                                            Choose how long the consent should remain active.
                                        </p>

                                        <div class="cr-form-row">
                                            <div class="cr-field">
                                                <label for="consentDuration-@request.Id">
                                                    Consent duration
                                                </label>

                                                <select name="consentDuration"
                                                        id="consentDuration-@request.Id"
                                                        class="cr-duration-select"
                                                        data-request-id="@request.Id"
                                                        required>
                                                    <option value="">Select duration</option>
                                                    <option value="2Days">2 days</option>
                                                    <option value="7Days">7 days</option>
                                                    <option value="30Days">30 days</option>
                                                    <option value="Custom">Custom expiry</option>
                                                </select>
                                            </div>

                                            <div class="cr-field cr-custom-expiry"
                                                 id="customExpiryContainer-@request.Id">

                                                <label for="customExpiry-@request.Id">
                                                    Custom expiry date and time
                                                </label>

                                                <input type="datetime-local"
                                                       name="customExpiry"
                                                       id="customExpiry-@request.Id"
                                                       min="@customExpiryMin" />
                                            </div>
                                        </div>
                                    </div>

                                    <div class="cr-privacy-note">
                                        <i class="fas fa-lock"></i>
                                        <div>
                                            <strong>Your privacy matters.</strong>
                                            Review the request and duration carefully before
                                            approving. Only the released test results you
                                            select are shared. You can share them later by
                                            revoking and re-granting consent.
                                        </div>
                                    </div>

                                    <div class="cr-actions">
                                        <button type="submit"
                                                class="cr-button cr-button-primary">
                                            <i class="fas fa-check"></i>
                                            Approve Request
                                        </button>
                                    </div>
                                </form>

                                <form asp-controller="Patient"
                                      asp-action="RejectConsentRequest"
                                      method="post"
                                      onsubmit="return confirm('Are you sure you want to reject this consent request? No access will be granted through this request.');">

                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="requestId" value="@request.Id" />

                                    <div class="cr-actions">
                                        <button type="submit"
                                                class="cr-button cr-button-danger">
                                            <i class="fas fa-times"></i>
                                            Reject Request
                                        </button>
                                    </div>
                                </form>
                            }
                            else if (request.Status == "Approved")
                            {
                                <div class="cr-history-message approved">
                                    <i class="fas fa-check-circle"></i>
                                    <div>
                                        <strong>Request approved</strong>
                                        <br />
                                        You approved this request. Review the active consent
                                        and permitted access on your Consent page.
                                    </div>
                                </div>
                            }
                            else if (request.Status == "Rejected")
                            {
                                <div class="cr-history-message rejected">
                                    <i class="fas fa-shield-alt"></i>
                                    <div>
                                        <strong>Request rejected</strong>
                                        <br />
                                        You rejected this request. No access was granted
                                        through this request.
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="cr-history-message">
                                    <i class="fas fa-info-circle"></i>
                                    <div>
                                        This request has the status:
                                        <strong>@request.Status</strong>.
                                    </div>
                                </div>
                            }
                        </div>
                    </article>
                }
            </div>
        }
    </section>

    <!-- BOTTOM HELP -->
    <div class="cr-bottom-help">
        <div class="cr-help-card">
            <h4>
                <i class="fas fa-question-circle"></i>
                How consent requests work
            </h4>

            <div class="cr-steps">
                <div class="cr-step">
                    <span class="cr-step-number">1</span>
                    <span>Review the doctor's name and request date.</span>
                </div>

                <div class="cr-step">
                    <span class="cr-step-number">2</span>
                    <span>Optionally select released test results to share.</span>
                </div>

                <div class="cr-step">
                    <span class="cr-step-number">3</span>
                    <span>Choose how long consent should remain active.</span>
                </div>

                <div class="cr-step">
                    <span class="cr-step-number">4</span>
                    <span>Approve the request or reject it if you do not wish to share.</span>
                </div>
            </div>
        </div>

        <div class="cr-help-card">
            <h4>
                <i class="fas fa-user-shield"></i>
                Protecting your medical information
            </h4>

            <p>
                You decide whether to grant access and what to share. Review every
                request carefully and choose an expiry period that suits you.
                You can approve without sharing any results and update the share
                later by revoking and re-granting consent.
            </p>
        </div>
    </div>

</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        document.querySelectorAll(".cr-duration-select").forEach(function (select) {
            const requestId = select.dataset.requestId;

            const container = document.getElementById(
                "customExpiryContainer-" + requestId
            );

            const expiryInput = document.getElementById(
                "customExpiry-" + requestId
            );

            function updateCustomExpiry() {
                const isCustom = select.value === "Custom";

                if (container) {
                    container.classList.toggle("show", isCustom);
                }

                if (expiryInput) {
                    expiryInput.required = isCustom;
                }
            }

            select.addEventListener("change", updateCustomExpiry);
            updateCustomExpiry();
        });

        document.querySelectorAll(".cr-approve-form").forEach(function (form) {
            form.addEventListener("submit", function (event) {
                const duration = form.querySelector(
                    'select[name="consentDuration"]'
                );

                if (!duration || !duration.value) {
                    event.preventDefault();
                    alert("Please select a consent duration.");
                    return;
                }

                if (duration.value === "Custom") {
                    const expiry = form.querySelector(
                        'input[name="customExpiry"]'
                    );

                    if (!expiry || !expiry.value) {
                        event.preventDefault();
                        alert("Please select a custom expiry date and time.");
                    }
                }
            });
        });
    });
</script>