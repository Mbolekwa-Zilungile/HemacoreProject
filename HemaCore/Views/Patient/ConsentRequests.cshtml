@model IEnumerable<HemaCore.Models.ConsentRequest>
@using HemaCore.Models

@{
    Layout = "~/Views/Shared/_PatientLayout.cshtml";
    ViewData["Title"] = "Consent Requests";
    ViewBag.Title = "Consent Requests";

    var requests = Model?.ToList() ?? new List<ConsentRequest>();

    var completedTestRequests =
        ViewBag.CompletedTestRequests as IEnumerable<TestRequest>
        ?? new List<TestRequest>();

    var releasedTestRequests =
        ViewBag.ReleasedTestRequests as IEnumerable<TestRequest>
        ?? completedTestRequests;

    var pendingCount = requests.Count(r => r.Status == "Pending");
    var approvedCount = requests.Count(r => r.Status == "Approved");
    var rejectedCount = requests.Count(r => r.Status == "Rejected");

    var customExpiryMin = DateTime.Now.AddDays(2)
        .ToString("yyyy-MM-ddTHH:mm");
}

