@model HemaCore.Models.Patient
@using Microsoft.AspNetCore.Identity
@using HemaCore.Data
@using Microsoft.EntityFrameworkCore
@inject UserManager<HemaCore.Models.Users> UserManager
@inject AppDbContext Context

@{
    Layout = "~/Views/Shared/_PatientLayout.cshtml";
    ViewBag.Title = "Patient Dashboard";

    // Fetch pending consent requests for the notification banner
    var currentUser = await UserManager.GetUserAsync(User);
    var pendingConsentCount = 0;

    if (currentUser != null)
    {
        pendingConsentCount = await Context.ConsentRequests
            .CountAsync(r => r.PatientID == currentUser.Id && r.Status == "Pending");
    }
}

<div class="patient-dashboard">

    <!-- WELCOME HEADER -->
    <div class="dashboard-hero">
        <div class="hero-content">
            <div class="dashboard-label">
                <i class="fas fa-heartbeat"></i>
                Patient Portal
            </div>

            <h1>
                Welcome@(Model != null && !string.IsNullOrWhiteSpace(Model.Name)
                                    ? ", " + Model.Name
                                    : "")
            </h1>

            <p>
                Manage your personal information, medical history,
                test results and healthcare access securely.
            </p>
        </div>

        <div class="hero-icon">
            <i class="fas fa-user-md"></i>
        </div>
    </div>

    <!-- ACTION REQUIRED: CONSENT REQUESTS -->
    @if (pendingConsentCount > 0)
    {
        <div class="profile-alert consent-alert">
            <div class="profile-alert-icon consent-alert-icon">
                <i class="fas fa-bell"></i>
            </div>

            <div class="profile-alert-content">
                <strong class="consent-alert-title">Action Required</strong>
                <span class="consent-alert-message">
                    You have <strong>@pendingConsentCount</strong>
                    doctor(s) requesting access to your medical records.
                    Please review these requests to approve or deny them.
                </span>
            </div>

            <a asp-controller="Patient"
               asp-action="ConsentRequests"
               class="profile-alert-action consent-alert-action">
                Review Requests
                <i class="fas fa-arrow-right"></i>
            </a>
        </div>
    }

    <!-- PROFILE COMPLETION -->
    @if (Model == null || string.IsNullOrWhiteSpace(Model.Name))
    {
        <div class="profile-alert">
            <div class="profile-alert-icon">
                <i class="fas fa-exclamation"></i>
            </div>

            <div class="profile-alert-content">
                <strong>Complete your patient profile</strong>
                <span>
                    Add your personal details, medical conditions,
                    allergies and medications to keep your healthcare
                    information up to date.
                </span>
            </div>

            <a asp-action="CompleteProfile"
               class="profile-alert-action">
                Complete Profile
                <i class="fas fa-arrow-right"></i>
            </a>
        </div>
    }

    <!-- QUICK ACCESS -->
    <div class="section-heading">
        <div>
            <span class="section-eyebrow">YOUR HEALTHCARE</span>
            <h2>Quick Access</h2>
            <p>Access and manage your healthcare information.</p>
        </div>
    </div>

    <div class="dashboard-grid">

        <!-- MY DETAILS -->
        <a asp-action="PatientDetails" class="dashboard-card">
            <div class="card-icon details-icon">
                <i class="fas fa-id-card"></i>
            </div>

            <div class="card-content">
                <h3>My Details</h3>
                <p>View your personal and medical information.</p>
            </div>

            <div class="card-arrow">
                <i class="fas fa-arrow-right"></i>
            </div>
        </a>

        <!-- EDIT PROFILE -->
        <a asp-action="EditProfile" class="dashboard-card">
            <div class="card-icon edit-icon">
                <i class="fas fa-user-edit"></i>
            </div>

            <div class="card-content">
                <h3>Edit Profile</h3>
                <p>Update your personal details and medical history.</p>
            </div>

            <div class="card-arrow">
                <i class="fas fa-arrow-right"></i>
            </div>
        </a>

        <!-- RESULTS -->
        <a asp-action="Result" class="dashboard-card">
            <div class="card-icon results-icon">
                <i class="fas fa-file-medical-alt"></i>
            </div>

            <div class="card-content">
                <h3>Test Results</h3>
                <p>View your available laboratory results.</p>
            </div>

            <div class="card-arrow">
                <i class="fas fa-arrow-right"></i>
            </div>
        </a>

        <!-- HEALTH -->
        <a asp-action="Health" class="dashboard-card">
            <div class="card-icon health-icon">
                <i class="fas fa-heartbeat"></i>
            </div>

            <div class="card-content">
                <h3>My Health</h3>
                <p>Review your health information and history.</p>
            </div>

            <div class="card-arrow">
                <i class="fas fa-arrow-right"></i>
            </div>
        </a>

        <!-- CONSENT -->
        <a asp-action="Consent" class="dashboard-card">
            <div class="card-icon consent-icon">
                <i class="fas fa-user-shield"></i>
            </div>

            <div class="card-content">
                <h3>Doctor Consent</h3>
                <p>Manage which doctors can access your information.</p>
            </div>

            <div class="card-arrow">
                <i class="fas fa-arrow-right"></i>
            </div>
        </a>

        <!-- CHANGE PASSWORD -->
        <a asp-action="ChangePassword" class="dashboard-card">
            <div class="card-icon password-icon">
                <i class="fas fa-lock"></i>
            </div>

            <div class="card-content">
                <h3>Security</h3>
                <p>Change your password and protect your account.</p>
            </div>

            <div class="card-arrow">
                <i class="fas fa-arrow-right"></i>
            </div>
        </a>

    </div>

    <!-- ACCOUNT INFORMATION -->
    <div class="section-heading account-heading">
        <div>
            <span class="section-eyebrow">ACCOUNT</span>
            <h2>Your Account</h2>
            <p>Keep your account information accurate and secure.</p>
        </div>
    </div>

    <div class="account-panel">
        <div class="account-avatar">
            <i class="fas fa-user"></i>
        </div>

        <div class="account-info">
            <span>Current Patient</span>

            <strong>
                @(Model != null && !string.IsNullOrWhiteSpace(Model.Name)
                    ? $"{Model.Name} {Model.Surname}"
                    : "Profile not completed")
            </strong>

            <small>
                Your healthcare information is stored securely
                within your patient account.
            </small>
        </div>

        <a asp-action="EditProfile" class="account-button">
            Manage Profile
            <i class="fas fa-arrow-right"></i>
        </a>
    </div>

</div>

<style>
    /* =====================================================
           PATIENT DASHBOARD - MATCHES MANAGER DASHBOARD
           ===================================================== */

    .patient-dashboard {
        width: 100%;
        max-width: 1350px;
        margin: 0 auto;
        padding: 30px;
        color: #172033;
        box-sizing: border-box;
    }

        .patient-dashboard * {
            box-sizing: border-box;
        }

    /* WELCOME HEADER */

    .dashboard-hero {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: space-between;
        overflow: hidden;
        min-height: 190px;
        padding: 35px 40px;
        margin-bottom: 28px;
        background: linear-gradient( 135deg, #f4f7ff 0%, #eef4ff 55%, #f8fbff 100% );
        border: 1px solid #e2e9f5;
        border-radius: 22px;
    }

        .dashboard-hero::after {
            content: "";
            position: absolute;
            width: 220px;
            height: 220px;
            right: -70px;
            top: -100px;
            background: rgba(49, 87, 199, 0.07);
            border-radius: 50%;
            pointer-events: none;
        }

    .hero-content {
        position: relative;
        z-index: 2;
    }

    .dashboard-label {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 9px;
        color: #3157c7;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 0.4px;
        text-transform: uppercase;
    }

        .dashboard-label i {
            font-size: 13px;
        }

    .dashboard-hero h1 {
        margin: 0;
        color: #172033;
        font-size: 31px;
        font-weight: 800;
        letter-spacing: -0.5px;
        line-height: 1.3;
    }

    .dashboard-hero p {
        max-width: 650px;
        margin: 8px 0 0;
        color: #68758a;
        font-size: 14px;
        line-height: 1.6;
    }

    .hero-icon {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 86px;
        height: 86px;
        min-width: 86px;
        margin-right: 30px;
        background: #fff;
        color: #3157c7;
        border: 1px solid #e1e8f4;
        border-radius: 24px;
        box-shadow: 0 10px 30px rgba(49, 87, 199, 0.08);
        font-size: 34px;
    }

    /* ALERTS */

    .profile-alert {
        display: flex;
        align-items: center;
        gap: 17px;
        padding: 18px 20px;
        margin-bottom: 28px;
        background: #fff;
        border: 1px solid #e2e9f5;
        border-left: 4px solid #3157c7;
        border-radius: 15px;
        box-shadow: 0 5px 18px rgba(15, 23, 42, 0.04);
    }

    .profile-alert-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 46px;
        height: 46px;
        min-width: 46px;
        background: #eef3ff;
        color: #3157c7;
        border-radius: 12px;
        font-size: 17px;
    }

    .profile-alert-content {
        flex: 1;
        min-width: 0;
    }

        .profile-alert-content > strong {
            display: block;
            margin-bottom: 3px;
            color: #172033;
            font-size: 14px;
            font-weight: 750;
        }

        .profile-alert-content span {
            display: block;
            color: #718096;
            font-size: 12px;
            line-height: 1.6;
        }

            .profile-alert-content span strong {
                display: inline;
            }

    .profile-alert-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        flex-shrink: 0;
        padding: 10px 16px;
        background: #3157c7;
        color: #fff !important;
        border: none;
        border-radius: 9px;
        text-decoration: none !important;
        font-size: 12px;
        font-weight: 700;
        transition: background 0.2s ease, transform 0.2s ease;
    }

        .profile-alert-action:hover {
            background: #2647a7;
            color: #fff !important;
            transform: translateY(-1px);
        }

    /* PENDING CONSENT ALERT */

    .consent-alert {
        background: #fff5f5;
        border-left-color: #dc2626;
    }

    .consent-alert-icon {
        background: #fee2e2;
        color: #dc2626;
    }

    .consent-alert-title {
        color: #991b1b !important;
    }

    .consent-alert-message {
        color: #7f1d1d !important;
    }

    .consent-alert-action,
    .consent-alert-action:hover {
        background: #dc2626;
        color: #fff !important;
    }

    /* SECTION HEADINGS */

    .section-heading {
        margin-bottom: 18px;
    }

    .section-eyebrow {
        display: block;
        margin-bottom: 4px;
        color: #3157c7;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 1px;
    }

    .section-heading h2 {
        margin: 0;
        color: #172033;
        font-size: 21px;
        font-weight: 800;
        line-height: 1.4;
    }

    .section-heading p {
        margin: 5px 0 0;
        color: #718096;
        font-size: 13px;
        line-height: 1.6;
    }

    .account-heading {
        margin-top: 42px;
    }

    /* DASHBOARD GRID */

    .dashboard-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
    }

    /* DASHBOARD CARDS */

    .dashboard-card {
        position: relative;
        display: flex;
        align-items: center;
        min-width: 0;
        min-height: 130px;
        padding: 20px;
        background: #fff;
        border: 1px solid #e6eaf0;
        border-radius: 17px;
        color: inherit !important;
        text-decoration: none !important;
        box-shadow: 0 4px 16px rgba(15, 23, 42, 0.035);
        transition: transform 0.22s ease, border-color 0.22s ease, box-shadow 0.22s ease;
    }

        .dashboard-card:hover {
            transform: translateY(-4px);
            border-color: #cbd7f5;
            box-shadow: 0 12px 30px rgba(49, 87, 199, 0.09);
            color: inherit !important;
        }

        .dashboard-card:focus-visible {
            outline: 3px solid rgba(49, 87, 199, 0.3);
            outline-offset: 3px;
        }

    /* CARD ICONS */

    .card-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 53px;
        height: 53px;
        min-width: 53px;
        margin-right: 15px;
        border-radius: 14px;
        font-size: 21px;
    }

    .details-icon {
        background: #eef2ff;
        color: #4f46e5;
    }

    .edit-icon {
        background: #e7f8f5;
        color: #0f766e;
    }

    .results-icon {
        background: #fff0e8;
        color: #ea580c;
    }

    .health-icon {
        background: #ffecee;
        color: #dc2626;
    }

    .consent-icon {
        background: #eaf4ff;
        color: #2563eb;
    }

    .password-icon {
        background: #fff8df;
        color: #ca8a04;
    }

    /* CARD CONTENT */

    .card-content {
        flex: 1;
        min-width: 0;
    }

        .card-content h3 {
            margin: 0 0 5px;
            color: #172033;
            font-size: 15px;
            font-weight: 750;
            line-height: 1.45;
        }

        .card-content p {
            margin: 0;
            color: #718096;
            font-size: 12px;
            line-height: 1.6;
        }

    .card-arrow {
        flex-shrink: 0;
        margin-left: 10px;
        color: #a7b0bf;
        font-size: 12px;
        transition: color 0.2s ease, transform 0.2s ease;
    }

    .dashboard-card:hover .card-arrow {
        color: #3157c7;
        transform: translateX(4px);
    }

    /* ACCOUNT PANEL */

    .account-panel {
        display: flex;
        align-items: center;
        gap: 18px;
        padding: 22px 24px;
        background: #fff;
        border: 1px solid #e2e9f5;
        border-radius: 18px;
        box-shadow: 0 5px 18px rgba(15, 23, 42, 0.035);
    }

    .account-avatar {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 55px;
        height: 55px;
        min-width: 55px;
        background: #eef2ff;
        color: #4f46e5;
        border-radius: 15px;
        font-size: 21px;
    }

    .account-info {
        flex: 1;
        min-width: 0;
    }

        .account-info span {
            display: block;
            margin-bottom: 2px;
            color: #64748b;
            font-size: 11px;
        }

        .account-info strong {
            display: block;
            margin-bottom: 3px;
            color: #172033;
            font-size: 17px;
            font-weight: 800;
            overflow-wrap: anywhere;
        }

        .account-info small {
            display: block;
            color: #94a3b8;
            font-size: 12px;
            line-height: 1.6;
        }

    .account-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        flex-shrink: 0;
        padding: 10px 15px;
        background: #f3f6ff;
        color: #3157c7 !important;
        border-radius: 9px;
        text-decoration: none !important;
        font-size: 12px;
        font-weight: 750;
        transition: background 0.2s ease;
    }

        .account-button:hover {
            background: #e7edff;
            color: #2647a7 !important;
        }

    /* RESPONSIVE: TABLETS */

    @@media (max-width: 1000px) {
        .patient-dashboard {
            padding: 24px;
        }

        .dashboard-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    /* RESPONSIVE: MOBILE */

    @@media (max-width: 700px) {
        .patient-dashboard {
            padding: 20px 15px;
        }

        .dashboard-hero {
            min-height: auto;
            padding: 26px 24px;
        }

            .dashboard-hero h1 {
                font-size: 25px;
            }

        .hero-icon {
            display: none;
        }

        .profile-alert {
            align-items: flex-start;
            flex-wrap: wrap;
        }

        .profile-alert-action {
            width: 100%;
        }

        .dashboard-grid {
            grid-template-columns: 1fr;
        }

        .account-panel {
            align-items: flex-start;
            flex-wrap: wrap;
        }

        .account-info {
            flex-basis: calc(100% - 75px);
        }

        .account-button {
            margin-left: 73px;
        }

        .account-heading {
            margin-top: 32px;
        }
    }

    /* RESPONSIVE: SMALL PHONES */

    @@media (max-width: 450px) {
        .patient-dashboard {
            padding: 15px 12px;
        }

        .dashboard-hero {
            padding: 23px 19px;
            border-radius: 17px;
        }

            .dashboard-hero h1 {
                font-size: 23px;
            }

            .dashboard-hero p {
                font-size: 13px;
            }

        .dashboard-card {
            min-height: 110px;
            padding: 16px;
        }

        .card-icon {
            width: 47px;
            height: 47px;
            min-width: 47px;
            margin-right: 12px;
            font-size: 18px;
        }

        .card-content h3 {
            font-size: 14px;
        }

        .card-content p {
            font-size: 12px;
        }

        .profile-alert {
            gap: 12px;
            padding: 15px;
        }

        .profile-alert-icon {
            width: 40px;
            height: 40px;
            min-width: 40px;
        }

        .account-panel {
            gap: 13px;
            padding: 18px;
        }

        .account-avatar {
            width: 48px;
            height: 48px;
            min-width: 48px;
        }

        .account-info strong {
            font-size: 15px;
        }

        .account-button {
            margin-left: 61px;
        }
    }
</style>
