<script>

    document.addEventListener("DOMContentLoaded", function () {

        const duration = document.getElementById("consentDuration");
        const container = document.getElementById("customExpiryContainer");
        const input = document.getElementById("customExpiry");

        if (!duration || !container || !input) {
            return;
        }

        function updateExpiry() {

            if (duration.value === "Custom") {

                container.style.display = "block";
                input.required = true;

            } else {

                container.style.display = "none";
                input.required = false;
                input.value = "";

            }

        }

        duration.addEventListener("change", updateExpiry);

        updateExpiry();

    });

</script>