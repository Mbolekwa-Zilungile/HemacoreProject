@using HemaCore.Models

@{
    ViewData["Title"] = "My Consent";
    ViewBag.Title = "My Consent";
    Layout = "~/Views/Shared/_PatientLayout.cshtml";

    var doctors = ViewBag.Doctors as IEnumerable<Doctor>
                   ?? new List<Doctor>();

    var completedTestRequests = ViewBag.CompletedTestRequests as IEnumerable<TestRequest>
                                ?? new List<TestRequest>();

    var consents = ViewBag.Consents as IEnumerable<Consent>
                   ?? new List<Consent>();
}

<div class="consent-page">

    <!-- PAGE HEADER -->
    <div class="consent-header">

        <div>
            <div class="consent-eyebrow">
                <i class="fas fa-shield-alt"></i>
                PATIENT PORTAL
            </div>

            <h1>My Consent</h1>

            <p>
                Control which doctors can access your completed test requests
                and how long they can access them.
            </p>
        </div>

        <div class="consent-header-icon">
            <i class="fas fa-user-shield"></i>
        </div>

    </div>

    <!-- ALERTS -->
    @if (TempData["Success"] != null)
    {
        <div class="consent-alert success">
            <div class="alert-icon">
                <i class="fas fa-check"></i>
            </div>

            <div>
                <strong>Success</strong>
                <span>@TempData["Success"]</span>
            </div>

            <button type="button"
                    class="alert-close"
                    data-bs-dismiss="alert">
                <i class="fas fa-times"></i>
            </button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="consent-alert error">
            <div class="alert-icon">
                <i class="fas fa-exclamation"></i>
            </div>

            <div>
                <strong>Something went wrong</strong>
                <span>@TempData["Error"]</span>
            </div>

            <button type="button"
                    class="alert-close"
                    data-bs-dismiss="alert">
                <i class="fas fa-times"></i>
            </button>
        </div>
    }

    <div class="consent-layout">

        <!-- MAIN COLUMN -->
        <div class="consent-main">

            <!-- GRANT CONSENT -->
            <div class="consent-card">

                <div class="card-heading">

                    <div class="heading-icon blue">
                        <i class="fas fa-hand-holding-medical"></i>
                    </div>

                    <div>
                        <h2>Grant Doctor Access</h2>
                        <p>
                            Choose a doctor and select the completed test requests
                            you want to share.
                        </p>
                    </div>

                </div>

                <form asp-controller="Patient"
                      asp-action="Consent"
                      method="post">

                    @Html.AntiForgeryToken()

                    <!-- DOCTOR -->
                    <div class="form-section">

                        <label for="doctorId">
                            <i class="fas fa-user-md"></i>
                            Select Doctor
                        </label>

                        <select id="doctorId"
                                name="doctorId"
                                class="form-control consent-select"
                                required>

                            <option value="">
                                -- Select a Doctor --
                            </option>

                            @foreach (var doctor in doctors)
                            {
                                <option value="@doctor.DoctorId">
                                    Dr. @doctor.Name @doctor.Surname
                                </option>
                            }

                        </select>

                        <small>
                            Select the doctor you want to give access to.
                        </small>

                    </div>

                    <!-- DURATION -->
                    <div class="form-section">

                        <label for="consentDuration">
                            <i class="fas fa-clock"></i>
                            Access Duration
                        </label>

                        <select id="consentDuration"
                                name="consentDuration"
                                class="form-control consent-select"
                                required>

                            <option value="">
                                -- Select Duration --
                            </option>

                            <option value="1Hour">
                                1 Hour
                            </option>

                            <option value="1Day">
                                1 Day
                            </option>

                            <option value="7Days">
                                7 Days
                            </option>

                            <option value="30Days">
                                30 Days
                            </option>

                            <option value="Custom">
                                Custom Date &amp; Time
                            </option>

                        </select>

                        <small>
                            Access will automatically expire after the selected period.
                        </small>

                    </div>

                    <!-- CUSTOM EXPIRY -->
                    <div class="form-section"
                         id="customExpiryContainer"
                         style="display:none;">

                        <label for="customExpiry">
                            <i class="fas fa-calendar-alt"></i>
                            Custom Expiry
                        </label>

                        <input type="datetime-local"
                               id="customExpiry"
                               name="customExpiry"
                               class="form-control consent-select" />

                        <small>
                            Choose exactly when the doctor's access should end.
                        </small>

                    </div>

                    <!-- INFORMATION TO SHARE -->
                    <div class="share-heading">

                        <div>
                            <h3>
                                <i class="fas fa-file-medical"></i>
                                Completed Test Requests to Share
                            </h3>

                            <p>
                                Select one or more completed test requests that
                                the selected doctor may access.
                            </p>
                        </div>

                    </div>

                    <!-- COMPLETED TEST REQUESTS -->
                    <div class="medical-section">

                        <div class="medical-section-header">

                            <div class="medical-title">

                                <div class="medical-icon condition">
                                    <i class="fas fa-flask"></i>
                                </div>

                                <div>
                                    <strong>Completed Test Requests</strong>

                                    <span>
                                        Only completed test requests can be selected.
                                    </span>
                                </div>

                            </div>

                            @if (completedTestRequests.Any())
                            {
                                <span class="count-badge">
                                    @completedTestRequests.Count()
                                </span>
                            }

                        </div>

                        @if (completedTestRequests.Any())
                        {
                            <div class="medical-list">

                                @foreach (var request in completedTestRequests)
                                {
                                    <label class="medical-item"
                                           for="testRequest_@request.TestRequestId">

                                        <input class="form-check-input"
                                               type="checkbox"
                                               name="selectedTestRequestIds"
                                               value="@request.TestRequestId"
                                               id="testRequest_@request.TestRequestId" />

                                        <span class="custom-check">
                                            <i class="fas fa-check"></i>
                                        </span>

                                        <span class="medical-name">

                                            <span>
                                                Test Request #@request.TestRequestId
                                            </span>

                                            @if (request.RequestDate != default)
                                            {
                                                <small>
                                                    @request.RequestDate.ToString("dd MMM yyyy")
                                                </small>
                                            }

                                            @if (request.TestRequestTestTypes != null &&
                                                 request.TestRequestTestTypes.Any())
                                            {
                                                <small>
                                                    Tests:
                                                    @string.Join(", ",
                                                        request.TestRequestTestTypes
                                                            .Where(t => t.TestType != null)
                                                            .Select(t => t.TestType.TestTypeName))
                                                </small>
                                            }

                                        </span>

                                    </label>
                                }

                            </div>
                        }
                        else
                        {
                            <div class="empty-information">
                                <i class="fas fa-info-circle"></i>

                                <span>
                                    You have no completed test requests available to share.
                                </span>
                            </div>
                        }

                    </div>

                    <!-- PRIVACY NOTICE -->
                    <div class="privacy-notice">

                        <div class="privacy-icon">
                            <i class="fas fa-lock"></i>
                        </div>

                        <div>
                            <strong>
                                Your medical information stays under your control.
                            </strong>

                            <p>
                                Only the completed test requests you select will be
                                included in this consent. Access automatically expires
                                at the selected time. You can revoke active consent
                                whenever you choose.
                            </p>
                        </div>

                    </div>

                    <!-- SUBMIT -->
                    <div class="consent-submit">

                        <button type="submit"
                                class="grant-button"
                            @((doctors.Any() && completedTestRequests.Any()) ? "" : "disabled")>

                            <i class="fas fa-check"></i>
                            Grant Consent

                        </button>

                    </div>

                </form>

            </div>

            <!-- EXISTING CONSENTS -->
            <div class="consent-card existing-card">

                <div class="card-heading">

                    <div class="heading-icon purple">
                        <i class="fas fa-history"></i>
                    </div>

                    <div>
                        <h2>My Doctor Consents</h2>

                        <p>
                            View and manage the access you have granted.
                        </p>
                    </div>

                </div>

                @if (consents.Any())
                {
                    <div class="consent-list">

                        @foreach (var consent in consents)
                        {
                            var expired =
                                consent.ExpiresAt.HasValue &&
                                consent.ExpiresAt.Value <= DateTime.UtcNow;

                            var active =
                                consent.IsActive &&
                                !expired;

                            <div class="existing-consent">

                                <div class="existing-top">

                                    <div class="doctor-info">

                                        <div class="doctor-avatar">
                                            <i class="fas fa-user-md"></i>
                                        </div>

                                        <div>
                                            <h4>
                                                Dr. @consent.Doctor.Name
                                                @consent.Doctor.Surname
                                            </h4>

                                            <small>
                                                Granted
                                                @consent.GrantedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                                            </small>
                                        </div>

                                    </div>

                                    @if (active)
                                    {
                                        <span class="status-badge active">
                                            Active
                                        </span>
                                    }
                                    else if (consent.RevokedAt.HasValue)
                                    {
                                        <span class="status-badge revoked">
                                            Revoked
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge expired">
                                            Expired
                                        </span>
                                    }

                                </div>

                                <!-- SHARED TEST REQUESTS -->
                                <div class="shared-information test-request-information">

                                    <div>
                                        <span class="shared-label">
                                            Shared Completed Test Requests
                                        </span>

                                        @if (consent.TestAccesses != null &&
                                             consent.TestAccesses.Any())
                                        {
                                            <div class="tag-list">

                                                @foreach (var access in consent.TestAccesses)
                                                {
                                                    <span class="medical-tag">
                                                        Test Request #@access.TestRequestId
                                                    </span>
                                                }

                                            </div>
                                        }
                                        else
                                        {
                                            <small class="none-text">
                                                No test requests recorded for this consent.
                                            </small>
                                        }
                                    </div>

                                </div>

                                <!-- CONSENT FOOTER -->
                                <div class="existing-footer">

                                    @if (consent.ExpiresAt.HasValue)
                                    {
                                        <span>
                                            <i class="fas fa-clock"></i>
                                            Expires
                                            @consent.ExpiresAt.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                                        </span>
                                    }

                                    @if (active)
                                    {
                                        <form asp-controller="Patient"
                                              asp-action="RevokeConsent"
                                              method="post"
                                              onsubmit="return confirm('Are you sure you want to revoke this consent? The doctor will no longer have access to the selected test requests.');">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="consentId"
                                                   value="@consent.Id" />

                                            <button type="submit"
                                                    class="revoke-button">

                                                <i class="fas fa-ban"></i>
                                                Revoke Consent

                                            </button>

                                        </form>
                                    }

                                </div>

                            </div>
                        }

                    </div>
                }
                else
                {
                    <div class="empty-consents">

                        <div class="empty-consents-icon">
                            <i class="fas fa-user-shield"></i>
                        </div>

                        <h4>No doctor access granted</h4>

                        <p>
                            You have not granted consent to any doctors yet.
                        </p>

                    </div>
                }

            </div>

        </div>

        <!-- RIGHT INFORMATION PANEL -->
        <aside class="consent-sidebar">

            <div class="info-card">

                <div class="info-card-header">

                    <div class="heading-icon blue">
                        <i class="fas fa-info-circle"></i>
                    </div>

                    <div>
                        <h3>How Consent Works</h3>
                        <p>You're always in control.</p>
                    </div>

                </div>

                <div class="step">

                    <div class="step-number">
                        1
                    </div>

                    <div>
                        <strong>Choose a doctor</strong>

                        <p>
                            Select the doctor you want to give access to.
                        </p>
                    </div>

                </div>

                <div class="step">

                    <div class="step-number">
                        2
                    </div>

                    <div>
                        <strong>Select test requests</strong>

                        <p>
                            Choose one or more completed test requests you want
                            the doctor to access.
                        </p>
                    </div>

                </div>

                <div class="step">

                    <div class="step-number">
                        3
                    </div>

                    <div>
                        <strong>Set a duration</strong>

                        <p>
                            Decide how long the doctor can access the selected
                            test requests.
                        </p>
                    </div>

                </div>

                <div class="step">

                    <div class="step-number">
                        4
                    </div>

                    <div>
                        <strong>Revoke anytime</strong>

                        <p>
                            You can revoke active consent whenever you choose.
                        </p>
                    </div>

                </div>

            </div>

            <!-- PRIVACY CARD -->
            <div class="privacy-card">

                <div class="privacy-card-icon">
                    <i class="fas fa-shield-alt"></i>
                </div>

                <div>
                    <h4>Your Privacy</h4>

                    <p>
                        Only the completed test requests you specifically select
                        are included in the consent.
                    </p>
                </div>

            </div>

        </aside>

    </div>

</div>

<style>

    /* =========================================================
           PAGE
        ========================================================= */

    .consent-page {
        width: 100%;
        max-width: 1500px;
        margin: 0 auto;
        padding: 28px 30px 40px;
        box-sizing: border-box;
    }

    /* =========================================================
           HEADER
        ========================================================= */

    .consent-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 25px;
    }

    .consent-eyebrow {
        display: flex;
        align-items: center;
        gap: 7px;
        color: #3157c7;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: .08em;
        margin-bottom: 5px;
    }

    .consent-header h1 {
        margin: 0;
        color: #172033;
        font-size: 29px;
        font-weight: 800;
    }

    .consent-header p {
        margin: 6px 0 0;
        color: #718096;
        font-size: 13px;
    }

    .consent-header-icon {
        width: 58px;
        height: 58px;
        flex: 0 0 58px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 16px;
        background: #eef2ff;
        color: #3157c7;
        font-size: 23px;
    }

    /* =========================================================
           ALERTS
        ========================================================= */

    .consent-alert {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 13px 15px;
        margin-bottom: 18px;
        border-radius: 12px;
        border: 1px solid;
    }

        .consent-alert.success {
            background: #effaf4;
            border-color: #ccebd8;
            color: #166534;
        }

        .consent-alert.error {
            background: #fff3f3;
            border-color: #f2cccc;
            color: #b42318;
        }

    .alert-icon {
        width: 34px;
        height: 34px;
        min-width: 34px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        background: rgba(255,255,255,.7);
    }

    .consent-alert div:nth-child(2) {
        flex: 1;
    }

    .consent-alert strong,
    .consent-alert span {
        display: block;
    }

    .consent-alert strong {
        font-size: 12px;
        margin-bottom: 2px;
    }

    .consent-alert span {
        font-size: 12px;
    }

    .alert-close {
        border: 0;
        background: transparent;
        color: inherit;
        opacity: .6;
        cursor: pointer;
    }

    /* =========================================================
           LAYOUT
        ========================================================= */

    .consent-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 320px;
        gap: 22px;
        align-items: start;
    }

    .consent-main {
        min-width: 0;
    }

    .consent-sidebar {
        min-width: 0;
        position: sticky;
        top: 20px;
    }

    /* =========================================================
           CARDS
        ========================================================= */

    .consent-card,
    .info-card,
    .privacy-card {
        background: #fff;
        border: 1px solid #e7ebf1;
        border-radius: 17px;
        box-shadow: 0 5px 18px rgba(15,23,42,.045);
    }

    .consent-card {
        padding: 24px;
    }

    .existing-card {
        margin-top: 20px;
    }

    .card-heading {
        display: flex;
        align-items: center;
        gap: 13px;
        padding-bottom: 20px;
        margin-bottom: 22px;
        border-bottom: 1px solid #edf0f4;
    }

    .heading-icon {
        width: 43px;
        height: 43px;
        min-width: 43px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
    }

        .heading-icon.blue {
            background: #eef2ff;
            color: #3157c7;
        }

        .heading-icon.purple {
            background: #f1edff;
            color: #6d4bd8;
        }

    .card-heading h2 {
        margin: 0;
        color: #172033;
        font-size: 17px;
        font-weight: 750;
    }

    .card-heading p {
        margin: 3px 0 0;
        color: #8a94a6;
        font-size: 12px;
    }

    /* =========================================================
           FORM
        ========================================================= */

    .form-section {
        margin-bottom: 20px;
    }

        .form-section label {
            display: block;
            margin-bottom: 7px;
            color: #253044;
            font-size: 13px;
            font-weight: 700;
        }

            .form-section label i {
                color: #3157c7;
                width: 18px;
            }

    .consent-select {
        min-height: 43px;
        border: 1px solid #dce2ea;
        border-radius: 10px;
        color: #273244;
        font-size: 13px;
        box-shadow: none !important;
    }

        .consent-select:focus {
            border-color: #3157c7;
            box-shadow: 0 0 0 3px rgba(49,87,199,.09) !important;
        }

    .form-section small {
        display: block;
        margin-top: 6px;
        color: #8b95a5;
        font-size: 11px;
    }

    /* =========================================================
           SHARE HEADING
        ========================================================= */

    .share-heading {
        padding: 3px 0 15px;
    }

        .share-heading h3 {
            margin: 0;
            color: #172033;
            font-size: 15px;
            font-weight: 750;
        }

            .share-heading h3 i {
                color: #3157c7;
                margin-right: 5px;
            }

        .share-heading p {
            margin: 4px 0 0;
            color: #8a94a6;
            font-size: 11px;
        }

    /* =========================================================
           TEST REQUEST SECTION
        ========================================================= */

    .medical-section {
        margin-bottom: 14px;
        padding: 16px;
        background: #fafbfc;
        border: 1px solid #e9edf2;
        border-radius: 13px;
    }

    .medical-section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 13px;
    }

    .medical-title {
        display: flex;
        align-items: center;
        gap: 10px;
        min-width: 0;
    }

    .medical-icon {
        width: 35px;
        height: 35px;
        min-width: 35px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
    }

        .medical-icon.condition {
            background: #eaf1ff;
            color: #2563eb;
        }

    .count-badge {
        min-width: 25px;
        height: 25px;
        padding: 0 7px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 20px;
        background: #e9eefb;
        color: #3157c7;
        font-size: 10px;
        font-weight: 700;
    }

    .medical-title strong,
    .medical-title span {
        display: block;
    }

    .medical-title strong {
        color: #263246;
        font-size: 12px;
    }

    .medical-title span {
        color: #8b95a5;
        font-size: 10px;
        margin-top: 2px;
    }

    /* =========================================================
           CHECKBOX LIST
        ========================================================= */

    .medical-list {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 8px;
    }

    .medical-item {
        position: relative;
        display: flex;
        align-items: center;
        gap: 9px;
        min-height: 43px;
        padding: 9px 11px;
        background: #fff;
        border: 1px solid #e4e8ee;
        border-radius: 9px;
        cursor: pointer;
        transition: .2s ease;
    }

        .medical-item:hover {
            border-color: #9db1e8;
            background: #f9fbff;
        }

        .medical-item input {
            position: absolute;
            opacity: 0;
            pointer-events: none;
        }

    .custom-check {
        width: 18px;
        height: 18px;
        min-width: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1.5px solid #cbd3df;
        border-radius: 5px;
        color: #fff;
        font-size: 9px;
        transition: .15s ease;
    }

    .medical-item input:checked + .custom-check {
        background: #3157c7;
        border-color: #3157c7;
    }

    .medical-item:has(input:checked) {
        border-color: #9db1e8;
        background: #f5f8ff;
    }

    .medical-name {
        display: flex;
        flex-direction: column;
        gap: 4px;
        min-width: 0;
        color: #344054;
        font-size: 12px;
        font-weight: 600;
        overflow-wrap: anywhere;
    }

        .medical-name small {
            color: #8a94a6;
            font-size: 10px;
            font-weight: 400;
        }

    /* =========================================================
           EMPTY INFORMATION
        ========================================================= */

    .empty-information {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 11px;
        border-radius: 8px;
        background: #f5f7fa;
        color: #7b8798;
        font-size: 11px;
    }

        .empty-information i {
            color: #64748b;
        }

    /* =========================================================
           PRIVACY
        ========================================================= */

    .privacy-notice {
        display: flex;
        gap: 12px;
        margin-top: 20px;
        padding: 14px;
        background: #f5f8ff;
        border: 1px solid #dce5fb;
        border-radius: 11px;
    }

    .privacy-icon {
        width: 35px;
        height: 35px;
        min-width: 35px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        background: #e5ecff;
        color: #3157c7;
    }

    .privacy-notice strong {
        display: block;
        color: #263246;
        font-size: 12px;
        margin-bottom: 3px;
    }

    .privacy-notice p {
        margin: 0;
        color: #778399;
        font-size: 10px;
        line-height: 1.5;
    }

    /* =========================================================
           SUBMIT
        ========================================================= */

    .consent-submit {
        display: flex;
        justify-content: flex-end;
        margin-top: 18px;
    }

    .grant-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
