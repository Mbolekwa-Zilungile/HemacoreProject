@model HemaCore.ViewModels.Patient.CompleteProfileViewModel

@{
    Layout = "~/Views/Shared/_PatientLayout.cshtml";
    ViewBag.Title = "Complete Profile";
}

<div class="container-fluid p-4">

    <!-- MAIN CARD -->
    <div class="content-card">

        <!-- HEADER -->
        <div class="section-title d-flex align-items-center mb-2">

            <i class="fas fa-user-plus me-2"></i>

            <span>Complete Your Profile</span>

        </div>

        <p class="text-muted mb-4">
            Please provide your personal information and medical history
            to help us serve you better.
        </p>


        <!-- SUCCESS -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">

                <i class="fas fa-check-circle me-2"></i>

                @TempData["Success"]

            </div>
        }


        <!-- FORM -->
        <form asp-action="CompleteProfile"
              method="post"
              id="profileForm">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="All"
                 class="alert alert-danger">
            </div>


            <!-- INFORMATION -->
            <div class="alert alert-info mb-4">

                <i class="fas fa-info-circle me-2"></i>

                All fields marked with
                <strong>*</strong>
                are required.
                Your information is kept confidential and secure.

            </div>


            <!-- PERSONAL INFORMATION -->
            <div class="mb-5">

                <h5 class="fw-bold mb-3">

                    <i class="fas fa-user-circle me-2"></i>

                    Personal Information

                </h5>

                <hr />


                <div class="row g-3">

                    <!-- FIRST NAME -->
                    <div class="col-md-6">

                        <label asp-for="Name"
                               class="form-label fw-semibold">

                            First Name *

                        </label>

                        <input asp-for="Name"
                               class="form-control"
                               placeholder="Enter your first name" />

                        <span asp-validation-for="Name"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- SURNAME -->
                    <div class="col-md-6">

                        <label asp-for="Surname"
                               class="form-label fw-semibold">

                            Last Name *

                        </label>

                        <input asp-for="Surname"
                               class="form-control"
                               placeholder="Enter your last name" />

                        <span asp-validation-for="Surname"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- ID -->
                    <div class="col-md-6">

                        <label asp-for="IDNumber"
                               class="form-label fw-semibold">

                            ID Number / Passport *

                        </label>

                        <input asp-for="IDNumber"
                               class="form-control"
                               placeholder="Enter your ID number" />

                        <span asp-validation-for="IDNumber"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- PHONE -->
                    <div class="col-md-6">

                        <label asp-for="PhoneNumber"
                               class="form-label fw-semibold">

                            Phone Number *

                        </label>

                        <input asp-for="PhoneNumber"
                               class="form-control"
                               placeholder="+27XXXXXXXXX" />

                        <span asp-validation-for="PhoneNumber"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- DOB -->
                    <div class="col-md-6">

                        <label asp-for="DateOfBirth"
                               class="form-label fw-semibold">

                            Date of Birth

                        </label>

                        <input asp-for="DateOfBirth"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="DateOfBirth"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- GENDER -->
                    <div class="col-md-6">

                        <label asp-for="Gender"
                               class="form-label fw-semibold">

                            Gender *

                        </label>

                        <select asp-for="Gender"
                                class="form-select">

                            <option value="">
                                Select Gender
                            </option>

                            <option value="Male">
                                Male
                            </option>

                            <option value="Female">
                                Female
                            </option>

                            <option value="Other">
                                Other
                            </option>

                            <option value="Prefer not to say">
                                Prefer not to say
                            </option>

                        </select>

                        <span asp-validation-for="Gender"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- ADDRESS -->
                    <div class="col-12">

                        <label asp-for="Address"
                               class="form-label fw-semibold">

                            Residential Address

                        </label>

                        <input asp-for="Address"
                               class="form-control"
                               placeholder="Enter your address" />

                        <span asp-validation-for="Address"
                              class="text-danger">
                        </span>

                    </div>

                </div>

            </div>


            <!-- CONDITIONS -->
            <div class="mb-5">

                <h5 class="fw-bold mb-3">

                    <i class="fas fa-notes-medical me-2"></i>

                    Medical Conditions

                </h5>

                <hr />


                <div class="row g-4">

                    <div class="col-md-7">

                        <label class="form-label fw-semibold">

                            Select your medical conditions

                        </label>

                        <div class="border rounded p-3">

                            <input type="text"
                                   id="conditionSearch"
                                   class="form-control mb-3"
                                   placeholder="Search conditions..."
                                   onkeyup="filterOptions('condition')" />

                            <div id="conditionsList"
                                 style="max-height:250px; overflow-y:auto;">

                                @foreach (var c in Model.AvailableConditions)
                                {
                                    var isChecked =
                                    Model.SelectedConditionIds.Contains(c.Id);

                                    <div class="d-flex align-items-center gap-2 p-2 option-item"
                                         data-name="@c.Name.ToLower()">

                                        <input type="checkbox"
                                               name="SelectedConditionIds"
                                               value="@c.Id"
                                               id="cond_@c.Id"
                                               class="form-check-input"
                                        @(isChecked ? "checked" : "") />

                                        <label for="cond_@c.Id"
                                               class="form-check-label">

                                            @c.Name

                                        </label>

                                    </div>
                                }

                            </div>

                        </div>

                    </div>


                    <div class="col-md-5">

                        <div class="border rounded p-3 h-100">

                            <h6 class="fw-bold">

                                <i class="fas fa-check-circle me-2"></i>

                                Selected Conditions

                            </h6>

                            <hr />

                            <div id="selectedConditionsList">

                                <div class="text-muted small">
                                    No conditions selected
                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- ALLERGIES -->
            <div class="mb-5">

                <h5 class="fw-bold mb-3">

                    <i class="fas fa-allergies me-2"></i>

                    Allergies

                </h5>

                <hr />


                <div class="row g-4">

                    <div class="col-md-7">

                        <label class="form-label fw-semibold">

                            Select your allergies

                        </label>

                        <div class="border rounded p-3">

                            <input type="text"
                                   id="allergySearch"
                                   class="form-control mb-3"
                                   placeholder="Search allergies..."
                                   onkeyup="filterOptions('allergy')" />

                            <div id="allergiesList"
                                 style="max-height:250px; overflow-y:auto;">

                                @foreach (var a in Model.AvailableAllergies)
                                {
                                    var isChecked =
                                    Model.SelectedAllergyIds.Contains(a.Id);

                                    <div class="d-flex align-items-center gap-2 p-2 option-item"
                                         data-name="@a.Name.ToLower()">

                                        <input type="checkbox"
                                               name="SelectedAllergyIds"
                                               value="@a.Id"
                                               id="all_@a.Id"
                                               class="form-check-input"
                                        @(isChecked ? "checked" : "") />

                                        <label for="all_@a.Id"
                                               class="form-check-label">

                                            @a.Name

                                        </label>

                                    </div>
                                }

                            </div>

                        </div>

                    </div>


                    <div class="col-md-5">

                        <div class="border rounded p-3 h-100">

                            <h6 class="fw-bold">

                                <i class="fas fa-check-circle me-2"></i>

                                Selected Allergies

                            </h6>

                            <hr />

                            <div id="selectedAllergiesList">

                                <div class="text-muted small">
                                    No allergies selected
                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- MEDICATIONS -->
            <div class="mb-5">

                <h5 class="fw-bold mb-3">

                    <i class="fas fa-pills me-2"></i>

                    Current Medications

                </h5>

                <hr />


                <div class="row g-4">

                    <div class="col-md-7">

                        <label class="form-label fw-semibold">

                            Select medications you are currently taking

                        </label>

                        <div class="border rounded p-3">

                            <input type="text"
                                   id="medicationSearch"
                                   class="form-control mb-3"
                                   placeholder="Search medications..."
                                   onkeyup="filterOptions('medication')" />

                            <div id="medicationsList"
                                 style="max-height:250px; overflow-y:auto;">

                                @foreach (var m in Model.AvailableMedications)
                                {
                                    var isChecked =
                                    Model.SelectedMedicationIds.Contains(m.Id);

                                    <div class="d-flex align-items-center gap-2 p-2 option-item"
                                         data-name="@m.Name.ToLower()">

                                        <input type="checkbox"
                                               name="SelectedMedicationIds"
                                               value="@m.Id"
                                               id="med_@m.Id"
                                               class="form-check-input"
                                        @(isChecked ? "checked" : "") />

                                        <label for="med_@m.Id"
                                               class="form-check-label">

                                            @m.Name

                                        </label>

                                    </div>
                                }

                            </div>

                        </div>

                    </div>


                    <div class="col-md-5">

                        <div class="border rounded p-3 h-100">

                            <h6 class="fw-bold">

                                <i class="fas fa-check-circle me-2"></i>

                                Selected Medications

                            </h6>

                            <hr />

                            <div id="selectedMedicationsList">

                                <div class="text-muted small">
                                    No medications selected
                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- ACTIONS -->
            <div class="d-flex justify-content-end gap-2">

                <a asp-controller="Patient"
                   asp-action="Dashboard"
                   class="btn btn-secondary">

                    <i class="fas fa-times me-2"></i>
                    Cancel

                </a>

                <button type="submit"
                        class="btn btn-primary-custom">

                    <i class="fas fa-save me-2"></i>
                    Save Profile

                </button>

            </div>

        </form>

    </div>

</div>


<script>

    function filterOptions(type) {

        const inputId =
            type === 'condition'
                ? 'conditionSearch'
                : type === 'allergy'
                    ? 'allergySearch'
                    : 'medicationSearch';

        const listId =
            type === 'condition'
                ? 'conditionsList'
                : type === 'allergy'
                    ? 'allergiesList'
                    : 'medicationsList';

        const term =
            document.getElementById(inputId).value.toLowerCase();

        document
            .querySelectorAll('#' + listId + ' .option-item')
            .forEach(item => {

                const name =
                    item.getAttribute('data-name') || '';

                item.style.display =
                    name.includes(term)
                        ? 'flex'
                        : 'none';

            });
    }


    function initSelectedBadges() {

        const mappings = [

            {
                checkboxes: 'input[name="SelectedConditionIds"]',
                container: 'selectedConditionsList',
                empty: 'No conditions selected'
            },

            {
                checkboxes: 'input[name="SelectedAllergyIds"]',
                container: 'selectedAllergiesList',
                empty: 'No allergies selected'
            },

            {
                checkboxes: 'input[name="SelectedMedicationIds"]',
                container: 'selectedMedicationsList',
                empty: 'No medications selected'
            }

        ];


        mappings.forEach(map => {

            document
                .querySelectorAll(map.checkboxes)
                .forEach(cb => {

                    cb.addEventListener(
                        'change',
                        () => renderBadges(map)
                    );

                });

            renderBadges(map);

        });

    }


    function renderBadges(map) {

        const container =
            document.getElementById(map.container);

        const checked =
            Array.from(
                document.querySelectorAll(map.checkboxes)
            ).filter(cb => cb.checked);


        if (checked.length === 0) {

            container.innerHTML =
                `<div class="text-muted small">
                    ${map.empty}
                </div>`;

            return;
        }


        container.innerHTML =
            checked.map(cb => {

                const label =
                    document.querySelector(
                        `label[for="${cb.id}"]`
                    ).innerText;


                return `
                    <span class="badge bg-primary me-1 mb-1">
                        ${label}
                        <button
                            type="button"
                            class="btn btn-sm text-white p-0 ms-1"
                            onclick="uncheckById('${cb.id}')">
                            ×
                        </button>
                    </span>
                `;

            }).join('');

    }


    function uncheckById(id) {

        const cb =
            document.getElementById(id);

        if (cb) {

            cb.checked = false;

            cb.dispatchEvent(
                new Event('change')
            );

        }

    }


    document.addEventListener(
        'DOMContentLoaded',
        initSelectedBadges
    );

</script>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}