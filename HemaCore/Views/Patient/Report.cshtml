@model IEnumerable<HemaCore.Models.PatientReport>

@{
    ViewData["Title"] = "Reports";
    Layout = "~/Views/Shared/_PatientLayout.cshtml";
}

<div class="container-fluid py-4">

    
    <div class="mb-4">
        <h2 class="fw-bold mb-1">
            <i class="fas fa-chart-bar text-primary me-2"></i>
            My Reports
        </h2>

        <p class="text-muted mb-0">
            View your available medical reports.
        </p>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">

                <i class="fas fa-file-medical fa-3x text-muted mb-3"></i>

                <h5 class="fw-semibold">
                    No reports available
                </h5>

                <p class="text-muted mb-0">
                    Your medical reports will appear here when they are available.
                </p>

            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">

            <div class="card-header bg-white border-0">
                <h5 class="mb-0 fw-semibold">
                    Available Reports
                </h5>
            </div>

            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th>Report</th>
                                <th>Type</th>
                                <th>Date</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var report in Model)
                            {
                                <tr>

                                    <td>
                                        <div class="d-flex align-items-center">

                                            <i class="fas fa-file-medical text-primary fa-lg me-3"></i>

                                            <div>
                                                <div class="fw-semibold">
                                                    @report.Title
                                                </div>

                                                @if (!string.IsNullOrWhiteSpace(report.FileName))
                                                {
                                                    <small class="text-muted">
                                                        @report.FileName
                                                    </small>
                                                }
                                            </div>

                                        </div>
                                    </td>

                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(report.ReportType))
                                        {
                                            <span class="badge bg-light text-dark border">
                                                @report.ReportType
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Not specified
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @report.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                                    </td>

                                    <td class="text-end">

                                        @if (report.FileData != null &&
                                             report.FileData.Length > 0)
                                        {
                                            <a asp-controller="Patient"
                                               asp-action="DownloadReport"
                                               asp-route-id="@report.Id"
                                               class="btn btn-sm btn-primary">

                                                <i class="fas fa-download me-1"></i>
                                                Download

                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">
                                                No file
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }
    

</div>
