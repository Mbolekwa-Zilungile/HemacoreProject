
@model HemaCore.ViewModels.ChangePasswordViewModel

@{
    Layout = "~/Views/Shared/_PatientLayout.cshtml";
    ViewData["Title"] = "Change Password";
}

<style>
    /* =========================
           PAGE LAYOUT
        ========================= */
    .cp-page {
        width: 100%;
        max-width: 1200px;
        margin: 0 auto;
        padding: 16px 20px 40px;
        color: #26364a;
        box-sizing: border-box;
    }

        .cp-page *,
        .cp-page *::before,
        .cp-page *::after {
            box-sizing: border-box;
        }

    .cp-heading {
        margin-bottom: 26px;
    }

        .cp-heading h2 {
            display: flex;
            align-items: center;
            gap: 14px;
            margin: 0 0 10px;
            color: #26364a;
            font-size: 28px;
            font-weight: 700;
            line-height: 1.3;
        }

    .cp-heading-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 52px;
        height: 52px;
        flex-shrink: 0;
        color: #3157c7;
        background: #eaf0ff;
        border-radius: 13px;
    }

    .cp-heading p {
        max-width: 800px;
        margin: 0;
        color: #718096;
        font-size: 14px;
        line-height: 1.8;
    }

    /* =========================
           MAIN CARD
        ========================= */
    .cp-card {
        width: 100%;
        padding: 36px 40px;
        background: #fff;
        border: 1px solid #e4eaf1;
        border-radius: 16px;
        box-shadow: 0 5px 22px rgba(35, 55, 85, .05);
    }

    .cp-card-heading {
        margin-bottom: 30px;
        padding-bottom: 22px;
        border-bottom: 1px solid #edf0f5;
    }

        .cp-card-heading h3 {
            margin: 0 0 8px;
            font-size: 21px;
            font-weight: 700;
            color: #26364a;
        }

        .cp-card-heading p {
            max-width: 850px;
            margin: 0;
            color: #78869a;
            font-size: 14px;
            line-height: 1.8;
        }

    /* =========================
           FORM GRID
        ========================= */
    .cp-form-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 24px;
        width: 100%;
    }

    .cp-field {
        min-width: 0;
        margin: 0;
    }

    .cp-label {
        display: block;
        margin-bottom: 10px;
        color: #34445a;
        font-size: 14px;
        font-weight: 650;
        line-height: 1.5;
    }

    /* =========================
           INPUTS
        ========================= */
    .cp-input-group {
        display: flex;
        align-items: stretch;
        width: 100%;
        min-width: 0;
    }

    .cp-input-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 52px;
        min-height: 52px;
        flex-shrink: 0;
        color: #738198;
        background: #f7f9fc;
        border: 1px solid #dce4ee;
        border-right: 0;
        border-radius: 9px 0 0 9px;
    }

    .cp-input {
        display: block;
        width: 100%;
        min-width: 0;
        min-height: 52px;
        flex: 1 1 auto;
        padding: 13px 16px;
        color: #26364a;
        background: #fff;
        border: 1px solid #dce4ee;
        border-radius: 0;
        font-family: inherit;
        font-size: 14px;
        line-height: 1.5;
        transition: border-color .2s, box-shadow .2s;
    }

        .cp-input::placeholder {
            color: #9aa5b5;
            opacity: 1;
        }

        .cp-input:focus {
            position: relative;
            z-index: 1;
            outline: none;
            border-color: #5478dc;
            box-shadow: 0 0 0 3px rgba(49, 87, 199, .10);
        }

    .cp-toggle {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 52px;
        min-height: 52px;
        flex-shrink: 0;
        color: #718096;
        background: #fff;
        border: 1px solid #dce4ee;
        border-left: 0;
        border-radius: 0 9px 9px 0;
        cursor: pointer;
        transition: background .2s, color .2s;
    }

        .cp-toggle:hover {
            color: #3157c7;
            background: #f5f7ff;
        }

        .cp-toggle:focus-visible {
            position: relative;
            z-index: 2;
            outline: 2px solid #3157c7;
            outline-offset: 2px;
        }

    .cp-field .field-validation-error {
        display: block;
        margin-top: 7px;
        color: #c03945;
        font-size: 12px;
        line-height: 1.5;
    }

    .cp-field .input-validation-error {
        border-color: #d9534f;
    }

    /* =========================
           VALIDATION SUMMARY
        ========================= */
    .cp-error-summary:empty {
        display: none;
    }

    .cp-error-summary {
        margin: 0 0 24px;
        padding: 12px 16px;
        color: #b42332;
        background: #fff;
        border: 0;
        border-left: 3px solid #d9534f;
        border-radius: 4px;
        font-size: 13px;
        line-height: 1.7;
    }

        .cp-error-summary ul {
            margin: 0;
            padding-left: 18px;
        }

        .cp-error-summary li + li {
            margin-top: 4px;
        }

    /* =========================
           PASSWORD REQUIREMENTS
        ========================= */
    .cp-requirements {
        padding: 22px 24px;
        margin-top: 18px;
        background: #f8faff;
        border: 1px solid #e5eaf6;
        border-radius: 10px;
    }

        .cp-requirements h4 {
            display: flex;
            align-items: center;
            gap: 10px;
            margin: 0 0 17px;
            color: #34445a;
            font-size: 14px;
            font-weight: 700;
        }

            .cp-requirements h4 i {
                color: #3157c7;
            }

        .cp-requirements ul {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 13px 28px;
            padding: 0;
            margin: 0;
            list-style: none;
        }

        .cp-requirements li {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            min-width: 0;
            color: #7b8798;
            font-size: 13px;
            line-height: 1.6;
        }

            .cp-requirements li i {
                width: 15px;
                flex-shrink: 0;
                margin-top: 3px;
                color: #9aa5b5;
                text-align: center;
            }

            .cp-requirements li.met {
                color: #24784c;
            }

                .cp-requirements li.met i {
                    color: #24784c;
                }

    /* =========================
           PASSWORD MATCH FEEDBACK
        ========================= */
    .cp-match-message {
        display: none;
        margin-top: 9px;
        font-size: 12px;
        line-height: 1.6;
    }

        .cp-match-message.visible {
            display: block;
        }

        .cp-match-message.match {
            color: #24784c;
        }

        .cp-match-message.no-match {
            color: #c03945;
        }

    /* =========================
           SECURITY NOTE
        ========================= */
    .cp-security-note {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        padding: 19px 22px;
        margin-top: 28px;
        color: #536781;
        background: #f3f7ff;
        border: 1px solid #e0e8fb;
        border-radius: 10px;
    }

        .cp-security-note > i {
            flex-shrink: 0;
            margin-top: 3px;
            color: #3157c7;
            font-size: 18px;
        }

        .cp-security-note strong {
            display: block;
            margin-bottom: 6px;
            color: #34445a;
            font-size: 14px;
        }

        .cp-security-note p {
            margin: 0;
            font-size: 13px;
            line-height: 1.8;
        }

    /* =========================
           ACTION BUTTONS
        ========================= */
    .cp-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        flex-wrap: wrap;
        gap: 14px;
        margin-top: 30px;
        padding-top: 25px;
        border-top: 1px solid #edf0f5;
    }

    .cp-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        min-width: 165px;
        min-height: 48px;
        padding: 12px 24px;
        border-radius: 8px;
        font-family: inherit;
        font-size: 14px;
        font-weight: 650;
        line-height: 1.4;
        text-decoration: none;
        cursor: pointer;
        transition: background .2s, border-color .2s;
    }

    .cp-btn-cancel {
        color: #536174;
        background: #fff;
        border: 1px solid #dce4ee;
    }

        .cp-btn-cancel:hover {
            color: #26364a;
            background: #f5f7fa;
            border-color: #cbd5e1;
        }

    .cp-btn-submit {
        color: #fff;
        background: #3157c7;
        border: 1px solid #3157c7;
    }

        .cp-btn-submit:hover {
            color: #fff;
            background: #2648ad;
            border-color: #2648ad;
        }

        .cp-btn-submit:disabled {
            opacity: .7;
            cursor: wait;
        }

        .cp-btn-submit .cp-spinner {
            display: none;
        }

        .cp-btn-submit.is-loading .cp-spinner {
            display: inline-block;
        }

        .cp-btn-submit.is-loading .cp-submit-icon {
            display: none;
        }

    /* =========================
           RESPONSIVE LAYOUT
        ========================= */
    @@media (min-width: 992px) {
        .cp-form-grid {
            grid-template-columns: minmax(0, 1fr);
        }
    }

    @@media (max-width: 767px) {
        .cp-page {
            padding: 8px 12px 25px;
        }

        .cp-heading h2 {
            font-size: 23px;
        }

        .cp-heading-icon {
            width: 46px;
            height: 46px;
        }

        .cp-card {
            padding: 24px 20px;
            border-radius: 12px;
        }

        .cp-card-heading h3 {
            font-size: 19px;
        }

        .cp-requirements {
            padding: 18px;
        }

            .cp-requirements ul {
                grid-template-columns: 1fr;
                gap: 11px;
            }

        .cp-actions {
            flex-direction: column-reverse;
            align-items: stretch;
        }

            .cp-actions .cp-btn {
                width: 100%;
                min-width: 0;
            }
    }

    @@media (max-width: 400px) {
        .cp-page {
            padding-right: 8px;
            padding-left: 8px;
        }

        .cp-card {
            padding: 20px 14px;
        }

        .cp-input-icon,
        .cp-toggle {
            width: 43px;
        }

        .cp-input {
            padding: 12px 10px;
            font-size: 13px;
        }
    }
</style>

<div class="container-fluid p-3 p-md-4">
    <div class="cp-page">

        <!-- PAGE HEADING -->
        <div class="cp-heading">
            <h2>
                <span class="cp-heading-icon">
                    <i class="fas fa-shield-alt"></i>
                </span>
                Security Settings
            </h2>

            <p>
                Update your password to help keep your HemaCore account
                and personal health information secure.
            </p>
        </div>

        <!-- CHANGE PASSWORD CARD -->
        <div class="cp-card">

            <div class="cp-card-heading">
                <h3>Change Password</h3>
                <p>
                    Enter your current password, then choose a new password
                    that you have not used for another account.
                </p>
            </div>

            <form id="changePasswordForm"
                  asp-controller="Patient"
                  asp-action="ChangePassword"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="All"
                     class="cp-error-summary"
                     role="alert"
                     aria-live="polite"></div>

                <div class="cp-form-grid">

                    <!-- CURRENT PASSWORD -->
                    <div class="cp-field">
                        <label asp-for="CurrentPassword" class="cp-label">
                            Current password
                        </label>

                        <div class="cp-input-group">
                            <span class="cp-input-icon">
                                <i class="fas fa-lock"></i>
                            </span>

                            <input asp-for="CurrentPassword"
                                   type="password"
                                   class="cp-input"
                                   placeholder="Enter your current password"
                                   autocomplete="current-password"
                                   aria-describedby="CurrentPassword-error" />

                            <button type="button"
                                    class="cp-toggle"
                                    data-password-target="CurrentPassword"
                                    aria-label="Show current password"
                                    aria-pressed="false">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>

                        <span asp-validation-for="CurrentPassword"
                              id="CurrentPassword-error"
                              class="text-danger"></span>
                    </div>

                    <!-- NEW PASSWORD -->
                    <div class="cp-field">
                        <label asp-for="NewPassword" class="cp-label">
                            New password
                        </label>

                        <div class="cp-input-group">
                            <span class="cp-input-icon">
                                <i class="fas fa-key"></i>
                            </span>

                            <input asp-for="NewPassword"
                                   type="password"
                                   class="cp-input"
                                   placeholder="Create a new password"
                                   autocomplete="new-password"
                                   aria-describedby="NewPassword-error passwordRequirements" />

                            <button type="button"
                                    class="cp-toggle"
                                    data-password-target="NewPassword"
                                    aria-label="Show new password"
                                    aria-pressed="false">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>

                        <span asp-validation-for="NewPassword"
                              id="NewPassword-error"
                              class="text-danger"></span>

                        <!-- PASSWORD REQUIREMENTS -->
                        <div class="cp-requirements" id="passwordRequirements">
                            <h4>
                                <i class="fas fa-shield-alt"></i>
                                Password requirements
                            </h4>

                            <ul>
                                <li data-rule="length">
                                    <i class="fas fa-circle"></i>
                                    At least 6 characters
                                </li>

                                <li data-rule="uppercase">
                                    <i class="fas fa-circle"></i>
                                    One uppercase letter (A–Z)
                                </li>

                                <li data-rule="lowercase">
                                    <i class="fas fa-circle"></i>
                                    One lowercase letter (a–z)
                                </li>

                                <li data-rule="number">
                                    <i class="fas fa-circle"></i>
                                    One number (0–9)
                                </li>

                                <li data-rule="special">
                                    <i class="fas fa-circle"></i>
                                    One special character
                                </li>
                            </ul>
                        </div>
                    </div>

                    <!-- CONFIRM PASSWORD -->
                    <div class="cp-field">
                        <label asp-for="ConfirmNewPassword" class="cp-label">
                            Confirm new password
                        </label>

                        <div class="cp-input-group">
                            <span class="cp-input-icon">
                                <i class="fas fa-check-circle"></i>
                            </span>

                            <input asp-for="ConfirmNewPassword"
                                   type="password"
                                   class="cp-input"
                                   placeholder="Enter your new password again"
                                   autocomplete="new-password"
                                   aria-describedby="ConfirmNewPassword-error passwordMatchMessage" />

                            <button type="button"
                                    class="cp-toggle"
                                    data-password-target="ConfirmNewPassword"
                                    aria-label="Show password confirmation"
                                    aria-pressed="false">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>

                        <span asp-validation-for="ConfirmNewPassword"
                              id="ConfirmNewPassword-error"
                              class="text-danger"></span>

                        <div id="passwordMatchMessage"
                             class="cp-match-message"
                             aria-live="polite"></div>
                    </div>

                </div>

                <!-- SECURITY TIP -->
                <div class="cp-security-note">
                    <i class="fas fa-shield-alt"></i>

                    <div>
                        <strong>Protect your account</strong>
                        <p>
                            Never share your password with anyone.
                            Choose a unique password and avoid using
                            personal information that others could guess.
                        </p>
                    </div>
                </div>

                <!-- ACTIONS -->
                <div class="cp-actions">

                    <a asp-controller="Patient"
                       asp-action="PatientDetails"
                       class="cp-btn cp-btn-cancel">
                        <i class="fas fa-arrow-left"></i>
                        Cancel
                    </a>

                    <button type="submit"
                            id="updatePasswordButton"
                            class="cp-btn cp-btn-submit">

                        <i class="fas fa-save cp-submit-icon"></i>
                        <i class="fas fa-spinner fa-spin cp-spinner"></i>

                        <span class="cp-submit-text">Update Password</span>
                    </button>

                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const form = document.getElementById("changePasswordForm");

            if (!form) {
                return;
            }

            const currentPassword =
                document.getElementById("CurrentPassword");

            const newPassword =
                document.getElementById("NewPassword");

            const confirmPassword =
                document.getElementById("ConfirmNewPassword");

            const submitButton =
                document.getElementById("updatePasswordButton");

            const submitText =
                submitButton.querySelector(".cp-submit-text");

            const matchMessage =
                document.getElementById("passwordMatchMessage");

            // SHOW / HIDE PASSWORD
            document.querySelectorAll("[data-password-target]")
                .forEach(function (button) {

                    button.addEventListener("click", function () {

                        const targetId =
                            button.getAttribute("data-password-target");

                        const input = document.getElementById(targetId);
                        const icon = button.querySelector("i");

                        if (!input || !icon) {
                            return;
                        }

                        const shouldShow = input.type === "password";

                        input.type = shouldShow ? "text" : "password";

                        icon.classList.toggle("fa-eye", !shouldShow);
                        icon.classList.toggle("fa-eye-slash", shouldShow);

                        button.setAttribute(
                            "aria-label",
                            shouldShow ? "Hide password" : "Show password"
                        );

                        button.setAttribute(
                            "aria-pressed",
                            shouldShow ? "true" : "false"
                        );
                    });
                });

            // PASSWORD REQUIREMENTS
            const passwordRules = {
                length: function (value) {
                    return value.length >= 6 && value.length <= 100;
                },
                uppercase: function (value) {
                    return /[A-Z]/.test(value);
                },
                lowercase: function (value) {
                    return /[a-z]/.test(value);
                },
                number: function (value) {
                    return /\d/.test(value);
                },
                special: function (value) {
                    return /[^\da-zA-Z]/.test(value);
                }
            };

            function updatePasswordRequirements() {

                const value = newPassword.value;

                document.querySelectorAll(
                    "#passwordRequirements li[data-rule]"
                ).forEach(function (item) {

                    const rule = item.getAttribute("data-rule");
                    const icon = item.querySelector("i");

                    const passed =
                        value.length > 0 &&
                        passwordRules[rule](value);

                    item.classList.toggle("met", passed);

                    if (icon) {
                        icon.classList.toggle("fa-circle", !passed);
                        icon.classList.toggle("fa-check-circle", passed);
                    }
                });
            }

            // PASSWORD CONFIRMATION FEEDBACK
            function updatePasswordMatch() {

                const newValue = newPassword.value;
                const confirmValue = confirmPassword.value;

                matchMessage.classList.remove(
                    "visible",
                    "match",
                    "no-match"
                );

                matchMessage.textContent = "";

                if (!confirmValue) {
                    return;
                }

                matchMessage.classList.add("visible");

                const icon = document.createElement("i");
                icon.classList.add(
                    "fas",
                    newValue === confirmValue
                        ? "fa-check-circle"
                        : "fa-times-circle"
                );

                matchMessage.classList.add(
                    newValue === confirmValue ? "match" : "no-match"
                );

                matchMessage.appendChild(icon);
                matchMessage.appendChild(
                    document.createTextNode(
                        newValue === confirmValue
                            ? " Passwords match."
                            : " Passwords do not match."
                    )
                );
            }

            newPassword.addEventListener("input", function () {
                updatePasswordRequirements();
                updatePasswordMatch();
            });

            confirmPassword.addEventListener(
                "input",
                updatePasswordMatch
            );

            // SUBMIT LOADING STATE
            let submitting = false;

            form.addEventListener("submit", function (event) {

                if (submitting) {
                    event.preventDefault();
                    return;
                }

                if (!form.checkValidity()) {
                    return;
                }

                if (
                    window.jQuery &&
                    window.jQuery.fn &&
                    typeof window.jQuery.fn.valid === "function"
                ) {
                    if (!window.jQuery(form).valid()) {
                        return;
                    }
                }

                submitting = true;

                submitButton.disabled = true;
                submitButton.classList.add("is-loading");

                submitText.textContent = "Updating password...";
            });

            // INITIAL STATE
            updatePasswordRequirements();
            updatePasswordMatch();
        });
    </script>
}
