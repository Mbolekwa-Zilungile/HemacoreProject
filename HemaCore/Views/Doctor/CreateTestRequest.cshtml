@model HemaCore.ViewModels.DoctorViewModels.CreateTestRequestViewModel

@{
    Layout = "~/Views/Shared/_DoctorLayout.cshtml";
    ViewData["Title"] = "New Test Request";
}

<link rel="stylesheet" href="~/css/doctor.css" />

<style>
    .create-request-page {
        max-width: 1200px;
        margin: 0 auto;
        padding: 10px 0 40px;
    }

    .page-heading {
        margin-bottom: 25px;
    }

    .page-heading h1 {
        margin: 0 0 6px;
        font-size: 28px;
        font-weight: 700;
        color: #1f5068;
    }

    .page-heading p {
        margin: 0;
        color: #6b7280;
        font-size: 14px;
    }

    .request-step-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        margin-bottom: 22px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    }

    .request-step-header {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 18px 22px;
        background: #f8fafb;
        border-bottom: 1px solid #e5e7eb;
    }

    .step-badge {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #2c7da0;
        color: white;
        font-weight: 700;
        font-size: 14px;
        flex-shrink: 0;
    }

    .request-step-header h2 {
        margin: 0;
        font-size: 18px;
        color: #1f5068;
        font-weight: 700;
    }

    .request-step-header p {
        margin: 3px 0 0;
        font-size: 13px;
        color: #6b7280;
    }

    .request-step-body {
        padding: 22px;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-label {
        display: block;
        margin-bottom: 8px;
        font-size: 14px;
        font-weight: 600;
        color: #374151;
    }

    .required-star {
        color: #dc2626;
    }

    .request-select,
    .request-input,
    .request-textarea {
        width: 100%;
        padding: 11px 13px;
        border: 1px solid #d1d5db;
        border-radius: 7px;
        background: #fff;
        color: #374151;
        font-size: 14px;
        box-sizing: border-box;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

    .request-select:focus,
    .request-input:focus,
    .request-textarea:focus {
        outline: none;
        border-color: #2c7da0;
        box-shadow: 0 0 0 3px rgba(44, 125, 160, 0.12);
    }

    .request-input.input-error {
        border-color: #dc2626;
        box-shadow: 0 0 0 3px rgba(220, 38, 38, 0.1);
    }

    .request-textarea {
        min-height: 110px;
        resize: vertical;
    }

    .field-validation {
        display: block;
        margin-top: 6px;
        color: #dc2626;
        font-size: 13px;
    }

    .patient-summary {
        margin-top: 16px;
        padding: 18px;
        border: 1px solid #dbe7ec;
        background: #f6fbfd;
        border-radius: 9px;
        display: none;
    }

    .patient-summary.show {
        display: block;
    }

    .patient-summary-title {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 10px;
    }

    .patient-avatar {
        width: 45px;
        height: 45px;
        border-radius: 50%;
        background: #2c7da0;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        flex-shrink: 0;
    }

    .patient-summary h3 {
        margin: 0 0 3px;
        color: #1f5068;
        font-size: 16px;
    }

    .patient-summary p {
        margin: 0;
        color: #6b7280;
        font-size: 13px;
    }

    .patient-summary-details {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
        font-size: 13px;
        color: #374151;
        margin-top: 8px;
        padding-top: 10px;
        border-top: 1px solid #dbe7ec;
        overflow-wrap: anywhere;
    }

    .patient-summary-details strong {
        display: block;
        color: #6b7280;
        font-weight: 600;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.4px;
        margin-bottom: 2px;
    }

    .patient-search-message {
        display: none;
        margin-top: 16px;
        padding: 16px;
        border-radius: 9px;
        font-size: 14px;
    }

    .patient-search-message.show {
        display: block;
    }

    .patient-search-message p {
        margin: 0 0 12px;
    }

    .patient-search-message p:last-child {
        margin-bottom: 0;
    }

    .message-error {
        color: #991b1b;
        background: #fef2f2;
        border: 1px solid #fecaca;
    }

    .message-warning {
        color: #854d0e;
        background: #fffbeb;
        border: 1px solid #fde68a;
    }

    .message-info {
        color: #1f5068;
        background: #f0f9ff;
        border: 1px solid #bae6fd;
    }

    .patient-message-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #2c7da0;
        color: white;
        text-decoration: none;
        padding: 9px 16px;
        border-radius: 7px;
        font-size: 14px;
        font-weight: 600;
    }

    .patient-message-link:hover {
        background: #1f5068;
        color: white;
    }

    .history-section {
        margin-top: 18px;
        padding-top: 16px;
        border-top: 1px solid #dbe7ec;
    }

    .history-section h4 {
        margin: 0 0 12px;
        font-size: 15px;
        color: #1f5068;
    }

    .history-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 12px;
    }

    .history-card {
        background: #fff;
        border: 1px solid #dbe7ec;
        border-radius: 8px;
        padding: 12px;
        min-width: 0;
    }

    .history-card h5 {
        margin: 0 0 8px;
        font-size: 13px;
        color: #1f5068;
    }

    .history-list {
        margin: 0;
        padding-left: 18px;
        color: #374151;
        font-size: 13px;
    }

    .history-list li {
        margin-bottom: 5px;
        overflow-wrap: anywhere;
    }

    .history-empty {
        color: #6b7280;
        font-size: 13px;
        margin: 0;
    }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    /* TEST TYPES: search, grid and Show More */

    .test-search-wrapper {
        position: relative;
        margin-bottom: 14px;
    }

    .test-search-wrapper > i {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: #6b7280;
        pointer-events: none;
    }

    .test-search-wrapper .request-input {
        padding-left: 40px;
    }

    .test-types-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
    }

    .test-type-card {
        position: relative;
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 16px;
        border: 1px solid #d9e1e5;
        border-radius: 9px;
        background: #fff;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .test-type-card[hidden] {
        display: none !important;
    }

    .test-type-card:hover {
        border-color: #61a5c2;
        background: #f8fcfd;
    }

    .test-type-card.selected {
        border-color: #2c7da0;
        background: #eef8fb;
    }

    .test-checkbox {
        margin-top: 3px;
        width: 17px;
        height: 17px;
        accent-color: #2c7da0;
        flex-shrink: 0;
    }

    .test-type-content {
        flex: 1;
    }

    .test-type-name {
        display: block;
        font-weight: 600;
        color: #374151;
        font-size: 14px;
        line-height: 1.4;
    }

    .test-type-sample {
        display: block;
        font-size: 12px;
        color: #6b7280;
        margin-top: 3px;
    }

    .test-list-actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-top: 14px;
        font-size: 13px;
        color: #6b7280;
    }

    .test-more-button {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 18px;
        border: 1px solid #61a5c2;
        border-radius: 8px;
        background: #eef8fb;
        color: #2c7da0;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s, border-color 0.2s;
    }

    .test-more-button:hover {
        background: #d6edf5;
        border-color: #2c7da0;
    }

    .test-more-button[hidden] {
        display: none !important;
    }

    .selected-count {
        margin-bottom: 15px;
        padding: 10px 13px;
        border-radius: 7px;
        background: #f3f7f9;
        color: #4b5563;
        font-size: 13px;
    }

    .sample-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .sample-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        align-items: start;
        padding: 15px;
        border: 1px solid #e1e6e9;
        border-radius: 9px;
        background: #fafcfd;
    }

    .sample-field label {
        display: block;
        margin-bottom: 7px;
        font-size: 13px;
        font-weight: 600;
        color: #4b5563;
    }

    .sample-type-label {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 11px 13px;
        background: #eef8fb;
        border: 1px solid #bfe0ec;
        border-radius: 7px;
        color: #1f5068;
        font-weight: 600;
        font-size: 14px;
    }

    .sample-type-label i {
        color: #2c7da0;
    }

    .no-options,
    .no-samples-yet {
        padding: 20px;
        text-align: center;
        color: #6b7280;
        background: #f9fafb;
        border: 1px dashed #d1d5db;
        border-radius: 8px;
    }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 25px;
        padding-top: 20px;
        border-top: 1px solid #e5e7eb;
    }

    .btn-cancel,
    .btn-submit {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 11px 20px;
        border-radius: 7px;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
    }

    .btn-cancel {
        border: 1px solid #d1d5db;
        background: white;
        color: #4b5563;
    }

    .btn-cancel:hover {
        background: #f9fafb;
    }

    .btn-submit {
        border: 1px solid #2c7da0;
        background: #2c7da0;
        color: white;
    }

    .btn-submit:hover {
        background: #1f5068;
    }

    .validation-summary {
        margin-bottom: 20px;
        padding: 13px 16px;
        border-radius: 8px;
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: #b91c1c;
        font-size: 14px;
    }

    #clientValidationSummary {
        display: none;
    }

    #clientValidationSummary ul {
        margin: 6px 0 0;
        padding-left: 20px;
    }

    @@media (max-width: 768px) {
        .form-row,
        .test-types-grid,
        .sample-row,
        .patient-summary-details,
        .history-grid {
            grid-template-columns: 1fr;
        }

        .form-actions {
            flex-direction: column-reverse;
        }

        .btn-cancel,
        .btn-submit {
            width: 100%;
        }

        .test-list-actions {
            flex-direction: column;
            align-items: stretch;
        }

        .test-more-button {
            justify-content: center;
        }
    }
</style>

<div class="create-request-page">

    <div class="page-heading">
        <h1>Create New Test Request</h1>
    </div>

    <form asp-controller="Doctor"
          asp-action="CreateTestRequest"
          method="post"
          id="createTestRequestForm">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="All"
             class="validation-summary"></div>

        <div id="clientValidationSummary" class="validation-summary">
            <strong>Please fix the following before submitting:</strong>
            <ul id="clientValidationList"></ul>
        </div>

        <!-- STEP 1: PATIENT SELECTION -->

        <div class="request-step-card">

            <div class="request-step-header">
                <div class="step-badge">1</div>
                <div>
                    <h2>Patient Selection</h2>
                    <p>Enter the patient's full 13-digit ID number to check their registration and consent.</p>
                </div>
            </div>

            <div class="request-step-body">

                <div class="form-group">

                    <label for="patientIdSearch" class="form-label">
                        Patient ID Number <span class="required-star">*</span>
                    </label>

                    <input type="text"
                           id="patientIdSearch"
                           class="request-input"
                           placeholder="Enter all 13 digits"
                           autocomplete="off"
                           maxlength="13"
                           inputmode="numeric"
                           aria-describedby="patientSearchStatus" />

                    <small id="patientSearchStatus" style="display:block; margin-top:6px; color:#6b7280;">
                        Enter exactly 13 digits to search for a registered patient.
                    </small>

                    <input type="hidden" asp-for="PatientId" id="patientIdHidden" />

                    <span asp-validation-for="PatientId"
                          class="field-validation"></span>

                </div>

                <!-- Patient details: only shown when consent is active -->

                <div class="patient-summary" id="patientSummary">

                    <div class="patient-summary-title">

                        <div class="patient-avatar">
                            <i class="fas fa-user"></i>
                        </div>

                        <div>
                            <h3 id="selectedPatientName"></h3>
                            <p id="patientConsentStatus">Active consent confirmed</p>
                        </div>

                    </div>

                    <div class="patient-summary-details">

                        <div>
                            <strong>ID Number</strong>
                            <span id="selectedPatientId"></span>
                        </div>

                        <div>
                            <strong>Date of Birth</strong>
                            <span id="selectedPatientDob"></span>
                        </div>

                        <div>
                            <strong>Phone Number</strong>
                            <span id="selectedPatientPhone"></span>
                        </div>

                        <div>
                            <strong>Address</strong>
                            <span id="selectedPatientAddress"></span>
                        </div>

                    </div>

                    <!-- Mini medical history -->

                    <div class="history-section" id="patientHistorySection">

                        <h4>
                            <i class="fas fa-notes-medical"></i>
                            Patient Medical History
                        </h4>

                        <div class="history-grid">

                            <div class="history-card">
                                <h5><i class="fas fa-heartbeat"></i> Medical Conditions</h5>
                                <ul class="history-list" id="patientConditions"></ul>
                            </div>

                            <div class="history-card">
                                <h5><i class="fas fa-allergies"></i> Allergies</h5>
                                <ul class="history-list" id="patientAllergies"></ul>
                            </div>

                            <div class="history-card">
                                <h5><i class="fas fa-pills"></i> Current Medications</h5>
                                <ul class="history-list" id="patientMedications"></ul>
                            </div>

                        </div>
                    </div>

                </div>

                <!-- Messages for missing patients, missing consent, and errors -->

                <div id="patientSearchMessage"
                     class="patient-search-message"
                     role="status"
                     aria-live="polite">

                    <p id="patientSearchMessageText"></p>

                    <a href="#"
                       id="patientMessageAction"
                       class="patient-message-link"
                       style="display:none;">
                        <i class="fas fa-user-plus"></i>
                        <span id="patientMessageActionText">Add New Patient</span>
                    </a>

                </div>

                <div class="form-row">

                    <div class="form-group">

                        <label asp-for="Urgency" class="form-label">
                            Urgency <span class="required-star">*</span>
                        </label>

                        <select asp-for="Urgency" class="request-select">
                            <option value="">-- Select Urgency --</option>
                            <option value="Routine">Routine</option>
                            <option value="Urgent">Urgent</option>
                            <option value="STAT">STAT</option>
                        </select>

                        <span asp-validation-for="Urgency"
                              class="field-validation"></span>

                    </div>

                </div>

                <div class="form-group">

                    <label asp-for="ClinicalNotes" class="form-label">
                        Clinical Notes
                    </label>

                    <textarea asp-for="ClinicalNotes"
                              class="request-textarea"
                              placeholder="Enter any relevant clinical information, symptoms or notes..."></textarea>

                    <span asp-validation-for="ClinicalNotes"
                          class="field-validation"></span>

                </div>

            </div>
        </div>

        <!-- STEP 2: TEST TYPES -->

        <div class="request-step-card">

            <div class="request-step-header">
                <div class="step-badge">2</div>
                <div>
                    <h2>Select Test Types</h2>
                    <p>Search for the required tests and select one or more.</p>
                </div>
            </div>

            <div class="request-step-body">

                <div class="selected-count">
                    <i class="fas fa-vial"></i>
                    <span id="selectedTestCount">0</span>
                    test(s) selected
                </div>

                @if (Model.TestTypes != null && Model.TestTypes.Any())
                {
                    <div class="test-search-wrapper">
                        <i class="fas fa-search"></i>
                        <input type="search"
                               id="testTypeSearch"
                               class="request-input"
                               placeholder="Search test types..."
                               autocomplete="off"
                               aria-label="Search test types" />
                    </div>

                    <div class="test-types-grid" id="testTypesGrid">
                        @foreach (var test in Model.TestTypes)
                        {
                            var isSelected =
                                Model.SelectedTestTypeIds != null &&
                                Model.SelectedTestTypeIds.Contains(test.TestTypeId);

                            <label class="test-type-card @(isSelected ? "selected" : "")"
                                   data-sample-type-id="@test.SampleTypeId"
                                   data-sample-type-name="@test.SampleTypeName"
                                   data-test-name="@test.TestTypeName.ToLowerInvariant()">

                                <input type="checkbox"
                                       name="SelectedTestTypeIds"
                                       value="@test.TestTypeId"
                                       class="test-checkbox"
                                       @(isSelected ? "checked" : "") />

                                <div class="test-type-content">
                                    <span class="test-type-name">
                                        @test.TestTypeName
                                    </span>

                                    <span class="test-type-sample">
                                        <i class="fas fa-tint"></i>
                                        Requires: @test.SampleTypeName
                                    </span>
                                </div>
                            </label>
                        }
                    </div>

                    <p id="noMatchingTests"
                       class="no-options"
                       style="display:none;">
                        No test types match your search.
                    </p>

                    <div class="test-list-actions">
                        <span id="testResultsCount"></span>

                        <button type="button"
                                id="toggleTestTypes"
                                class="test-more-button"
                                hidden>
                            Show More
                        </button>
                    </div>
                }
                else
                {
                    <div class="no-options">
                        <i class="fas fa-info-circle"></i>
                        No test types are currently available.
                    </div>
                }

            </div>
        </div>

        <!-- STEP 3: SAMPLE INFORMATION -->

        <div class="request-step-card">

            <div class="request-step-header">
                <div class="step-badge">3</div>
                <div>
                    <h2>Sample Information</h2>
                    <p>Select test types above to see the required samples, then enter a barcode for each.</p>
                </div>
            </div>

            <div class="request-step-body">

                <div id="sampleList" class="sample-list">
                    <div class="no-samples-yet" id="noSamplesYet">
                        <i class="fas fa-info-circle"></i>
                        Select test types above to see which samples are needed.
                    </div>
                </div>

            </div>
        </div>

        <!-- ACTIONS -->

        <div class="form-actions">

            <a asp-controller="Doctor"
               asp-action="Index"
               class="btn-cancel">
                <i class="fas fa-times"></i>
                Cancel
            </a>

            <button type="submit" class="btn-submit">
                <i class="fas fa-paper-plane"></i>
                Submit Test Request
            </button>

        </div>

    </form>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const idSearch = document.getElementById("patientIdSearch");
            const patientIdHidden = document.getElementById("patientIdHidden");

            const patientSummary = document.getElementById("patientSummary");
            const selectedPatientName = document.getElementById("selectedPatientName");
            const selectedPatientId = document.getElementById("selectedPatientId");
            const selectedPatientDob = document.getElementById("selectedPatientDob");
            const selectedPatientPhone = document.getElementById("selectedPatientPhone");
            const selectedPatientAddress = document.getElementById("selectedPatientAddress");

            const patientConditions = document.getElementById("patientConditions");
            const patientAllergies = document.getElementById("patientAllergies");
            const patientMedications = document.getElementById("patientMedications");

            const patientSearchStatus = document.getElementById("patientSearchStatus");
            const patientSearchMessage = document.getElementById("patientSearchMessage");
            const patientSearchMessageText = document.getElementById("patientSearchMessageText");
            const patientMessageAction = document.getElementById("patientMessageAction");
            const patientMessageActionText = document.getElementById("patientMessageActionText");

            const testCheckboxes = document.querySelectorAll(".test-checkbox");
            const selectedTestCount = document.getElementById("selectedTestCount");
            const sampleList = document.getElementById("sampleList");

            const clientValidationSummary = document.getElementById("clientValidationSummary");
            const clientValidationList = document.getElementById("clientValidationList");

            let searchController = null;
            let searchSequence = 0;

            /*
             * EXISTING BARCODES (for postback with validation errors)
             */

            const existingBarcodes = {};

            @if (Model.SampleTypeIds != null && Model.BarcodeNumbers != null)
            {
                for (int i = 0; i < Model.SampleTypeIds.Count && i < Model.BarcodeNumbers.Count; i++)
                {
                    if (Model.SampleTypeIds[i].HasValue)
                    {
                        <text>
                            existingBarcodes[@Model.SampleTypeIds[i]!.Value] =
                                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BarcodeNumbers[i]));
                        </text>
                    }
                }
            }

            /*
             * PATIENT SEARCH UI HELPERS
             */

            function hidePatientSummary() {
                patientSummary.classList.remove("show");

                selectedPatientName.textContent = "";
                selectedPatientId.textContent = "";
                selectedPatientDob.textContent = "";
                selectedPatientPhone.textContent = "";
                selectedPatientAddress.textContent = "";

                patientConditions.innerHTML = "";
                patientAllergies.innerHTML = "";
                patientMedications.innerHTML = "";
            }

            function hidePatientMessage() {
                patientSearchMessage.className = "patient-search-message";
                patientSearchMessageText.textContent = "";

                patientMessageAction.style.display = "none";
                patientMessageAction.removeAttribute("href");
            }

            function showPatientMessage(message, type, actionUrl, actionText) {
                patientSearchMessage.className = "patient-search-message show " + type;
                patientSearchMessageText.textContent = message;

                if (actionUrl) {
                    patientMessageAction.href = actionUrl;
                    patientMessageActionText.textContent = actionText || "Continue";
                    patientMessageAction.style.display = "inline-flex";
                } else {
                    patientMessageAction.style.display = "none";
                    patientMessageAction.removeAttribute("href");
                }
            }

            function setHistoryList(listElement, values) {
                listElement.innerHTML = "";

                if (!Array.isArray(values) || values.length === 0) {
                    const item = document.createElement("li");
                    item.className = "history-empty";
                    item.textContent = "No records available.";
                    listElement.appendChild(item);
                    return;
                }

                values.forEach(function (value) {
                    const item = document.createElement("li");
                    item.textContent = value || "Not recorded";
                    listElement.appendChild(item);
                });
            }

            function formatDate(value) {
                if (!value) {
                    return "Not recorded";
                }

                const date = new Date(value);

                if (Number.isNaN(date.getTime())) {
                    return value;
                }

                return date.toLocaleDateString("en-ZA", {
                    day: "2-digit",
                    month: "short",
                    year: "numeric",
                    timeZone: "UTC"
                });
            }

            function showPatientDetails(patient) {
                patientIdHidden.value = patient.patientId;

                selectedPatientName.textContent = patient.fullName || "Name not recorded";
                selectedPatientId.textContent = patient.idNumber || idSearch.value;
                selectedPatientDob.textContent = formatDate(patient.dateOfBirth);
                selectedPatientPhone.textContent = patient.phoneNumber || "Not recorded";
                selectedPatientAddress.textContent = patient.address || "Not recorded";

                setHistoryList(patientConditions, patient.conditions);
                setHistoryList(patientAllergies, patient.allergies);
                setHistoryList(patientMedications, patient.medications);

                patientSummary.classList.add("show");
                hidePatientMessage();
            }

            function resetPatientSelection() {
                patientIdHidden.value = "";
                hidePatientSummary();
                hidePatientMessage();
            }

            /*
             * SEARCH THE DATABASE USING THE CONTROLLER ACTION.
             *
             * The server checks whether the patient exists and whether
             * the current doctor has active consent.
             */

            async function searchPatient(idNumber) {

                const currentSequence = ++searchSequence;

                if (searchController) {
                    searchController.abort();
                }

                searchController = new AbortController();

                resetPatientSelection();

                if (!/^\d{13}$/.test(idNumber)) {
                    patientSearchStatus.textContent =
                        "Enter exactly 13 digits to search for a registered patient.";

                    return;
                }

                patientSearchStatus.textContent = "Searching for patient...";
                idSearch.classList.remove("input-error");

                try {
                    const response = await fetch(
                        "/Doctor/SearchPatientById?idNumber=" + encodeURIComponent(idNumber),
                        {
                            method: "GET",
                            headers: {
                                "Accept": "application/json"
                            },
                            signal: searchController.signal
                        }
                    );

                    const data = await response.json();

                    // Ignore an old response if the doctor has typed again.
                    if (currentSequence !== searchSequence) {
                        return;
                    }

                    // Patient does not exist in the database.
                    if (response.status === 404 || data.found === false) {

                        patientIdHidden.value = "";

                        showPatientMessage(
                            data.message ||
                            "No patient was found with this ID number. You can add the patient if they are not registered.",
                            "message-error",
                            "/Doctor/AddPatient?idNumber=" + encodeURIComponent(idNumber),
                            "Add New Patient"
                        );

                        patientSearchStatus.textContent = "Patient not found.";
                        return;
                    }

                    // Invalid ID number or another client-side request error.
                    if (!response.ok) {

                        patientIdHidden.value = "";

                        showPatientMessage(
                            data.message || "We could not complete the patient search. Please try again.",
                            "message-error"
                        );

                        patientSearchStatus.textContent = "Search unsuccessful.";
                        return;
                    }

                    // Patient exists but the doctor does not have active consent.
                    // Do not display the patient's medical history.
                    if (data.found && !data.hasConsent) {

                        patientIdHidden.value = "";

                        showPatientMessage(
                            data.message ||
                            "This patient is registered, but you do not have active consent. Please request consent before accessing their medical history.",
                            "message-warning",
                            "/Doctor/RequestConsent?patientId=" + encodeURIComponent(data.patientId),
                            "Request Patient Consent"
                        );

                        patientSearchStatus.textContent =
                            "Patient found. Active consent is required.";

                        return;
                    }

                    // Patient exists and active consent has been confirmed.
                    if (data.found && data.hasConsent) {

                        showPatientDetails(data);

                        patientSearchStatus.textContent =
                            "Patient found. Active consent confirmed.";

                        return;
                    }

                    showPatientMessage(
                        "We could not confirm the patient's registration and consent. Please try again.",
                        "message-error"
                    );

                    patientSearchStatus.textContent = "Unable to confirm patient.";

                } catch (error) {

                    if (error.name === "AbortError") {
                        return;
                    }

                    if (currentSequence !== searchSequence) {
                        return;
                    }

                    patientIdHidden.value = "";

                    showPatientMessage(
                        "An error occurred while searching. Please check your connection and try again.",
                        "message-error"
                    );

                    patientSearchStatus.textContent = "Search failed.";
                }
            }

            /*
             * REQUIRE EXACTLY 13 DIGITS.
             *
             * The search is performed only after all 13 digits are entered.
             */

            idSearch.addEventListener("input", function () {

                const originalValue = this.value;
                const digitsOnly = originalValue.replace(/\D/g, "").slice(0, 13);

                if (originalValue !== digitsOnly) {
                    this.value = digitsOnly;
                }

                resetPatientSelection();
                idSearch.classList.remove("input-error");

                if (searchController) {
                    searchController.abort();
                }

                searchSequence++;

                if (digitsOnly.length === 0) {
                    patientSearchStatus.textContent =
                        "Enter exactly 13 digits to search for a registered patient.";
                    return;
                }

                if (digitsOnly.length < 13) {
                    patientSearchStatus.textContent =
                        "You have entered " + digitsOnly.length +
                        " of 13 digits. Enter the full ID number.";

                    return;
                }

                searchPatient(digitsOnly);
            });
                        /*
             * REQUEST CONSENT MUST BE A POST (the controller action is [HttpPost]).
             * Intercept the link and submit a temporary form with the
             * anti-forgery token instead of navigating with a GET.
             */

            patientMessageAction.addEventListener("click", function (event) {

                const href = this.getAttribute("href") || "";

                if (!href.startsWith("/Doctor/RequestConsent")) {
                    return;
                }

                event.preventDefault();

                const patientId = new URL(href, window.location.origin)
                    .searchParams.get("patientId");

                const token = document.querySelector(
                    '#createTestRequestForm input[name="__RequestVerificationToken"]'
                );

                if (!patientId || !token) {
                    return;
                }

                const consentForm = document.createElement("form");
                consentForm.method = "post";
                consentForm.action = "/Doctor/RequestConsent";

                const patientInput = document.createElement("input");
                patientInput.type = "hidden";
                patientInput.name = "patientId";
                patientInput.value = patientId;

                const tokenInput = document.createElement("input");
                tokenInput.type = "hidden";
                tokenInput.name = "__RequestVerificationToken";
                tokenInput.value = token.value;

                consentForm.appendChild(patientInput);
                consentForm.appendChild(tokenInput);

                document.body.appendChild(consentForm);
                consentForm.submit();
            });


            /*
             * TEST TYPE SELECTION -> AUTO-BUILD SAMPLE ROWS
             */

            function rebuildSampleRows() {

                const currentBarcodes = {};

                sampleList.querySelectorAll(".sample-row").forEach(function (row) {

                    const sampleId = row.getAttribute("data-sample-type-id");
                    const input = row.querySelector('input[name="BarcodeNumbers"]');

                    if (sampleId && input) {
                        currentBarcodes[sampleId] = input.value;
                    }
                });

                const neededMap = new Map();

                testCheckboxes.forEach(function (checkbox) {

                    const card = checkbox.closest(".test-type-card");

                    if (checkbox.checked && card) {

                        const sampleId = card.getAttribute("data-sample-type-id");
                        const sampleName = card.getAttribute("data-sample-type-name");

                        if (sampleId && !neededMap.has(sampleId)) {
                            neededMap.set(sampleId, sampleName);
                        }
                    }
                });

                sampleList.innerHTML = "";

                if (neededMap.size === 0) {

                    const empty = document.createElement("div");
                    empty.className = "no-samples-yet";
                    empty.id = "noSamplesYet";
                    empty.innerHTML =
                        '<i class="fas fa-info-circle"></i> Select test types above to see which samples are needed.';

                    sampleList.appendChild(empty);
                    return;
                }

                neededMap.forEach(function (sampleName, sampleId) {

                    const row = document.createElement("div");
                    row.className = "sample-row";
                    row.setAttribute("data-sample-type-id", sampleId);

                    const prefill = currentBarcodes[sampleId] !== undefined
                        ? currentBarcodes[sampleId]
                        : (existingBarcodes[sampleId] || "");

                    const sampleField = document.createElement("div");
                    sampleField.className = "sample-field";

                    const sampleLabel = document.createElement("label");
                    sampleLabel.textContent = "Sample Type";

                    const sampleTypeLabel = document.createElement("div");
                    sampleTypeLabel.className = "sample-type-label";

                    const sampleIcon = document.createElement("i");
                    sampleIcon.className = "fas fa-tint";

                    sampleTypeLabel.appendChild(sampleIcon);
                    sampleTypeLabel.appendChild(
                        document.createTextNode(" " + (sampleName || "Sample"))
                    );

                    const sampleTypeInput = document.createElement("input");
                    sampleTypeInput.type = "hidden";
                    sampleTypeInput.name = "SampleTypeIds";
                    sampleTypeInput.value = sampleId;

                    sampleField.appendChild(sampleLabel);
                    sampleField.appendChild(sampleTypeLabel);
                    sampleField.appendChild(sampleTypeInput);

                    const barcodeField = document.createElement("div");
                    barcodeField.className = "sample-field";

                    const barcodeLabel = document.createElement("label");
                    barcodeLabel.textContent = "Barcode Number";

                    const barcodeInput = document.createElement("input");
                    barcodeInput.type = "text";
                    barcodeInput.name = "BarcodeNumbers";
                    barcodeInput.className = "request-input";
                    barcodeInput.placeholder = "Enter barcode";
                    barcodeInput.value = prefill;
                    barcodeInput.setAttribute(
                        "data-sample-name",
                        sampleName || "sample"
                    );

                    const barcodeError = document.createElement("span");
                    barcodeError.className = "field-validation barcode-error";
                    barcodeError.style.display = "none";

                    barcodeField.appendChild(barcodeLabel);
                    barcodeField.appendChild(barcodeInput);
                    barcodeField.appendChild(barcodeError);

                    row.appendChild(sampleField);
                    row.appendChild(barcodeField);

                    sampleList.appendChild(row);
                });
            }

            function updateTestCount() {

                let count = 0;

                testCheckboxes.forEach(function (checkbox) {

                    const card = checkbox.closest(".test-type-card");

                    if (checkbox.checked) {
                        count++;

                        if (card) {
                            card.classList.add("selected");
                        }
                    } else if (card) {
                        card.classList.remove("selected");
                    }
                });

                selectedTestCount.textContent = count;
            }

            testCheckboxes.forEach(function (checkbox) {

                checkbox.addEventListener("change", function () {
                    updateTestCount();
                    rebuildSampleRows();
                });
            });

            /*
             * TEST TYPE SEARCH AND SHOW MORE
             *
             * Only the first 6 matching tests are visible. Show More reveals
             * 6 more each time. Hidden tests that are ticked are still
             * submitted with the form.
             */

            const testSearch = document.getElementById("testTypeSearch");
            const testCards = Array.from(
                document.querySelectorAll("#testTypesGrid .test-type-card")
            );
            const noMatchingTests = document.getElementById("noMatchingTests");
            const toggleTestTypes = document.getElementById("toggleTestTypes");
            const testResultsCount = document.getElementById("testResultsCount");

            const TESTS_PER_BATCH = 6;
            let testVisibleLimit = TESTS_PER_BATCH;

            function getMatchingTestCards() {
                const query = testSearch.value.trim().toLowerCase();

                return testCards.filter(function (card) {
                    const testName = card.getAttribute("data-test-name") || "";
                    const sampleName = (
                        card.getAttribute("data-sample-type-name") || ""
                    ).toLowerCase();

                    return testName.includes(query) || sampleName.includes(query);
                });
            }

            function filterTestTypes() {
                const matches = getMatchingTestCards();

                testCards.forEach(function (card) {
                    card.hidden = true;
                });

                matches.forEach(function (card, index) {
                    card.hidden = index >= testVisibleLimit;
                });

                const shown = Math.min(testVisibleLimit, matches.length);

                noMatchingTests.style.display = matches.length === 0 ? "block" : "none";

                testResultsCount.textContent = matches.length === 0
                    ? ""
                    : "Showing " + shown + " of " + matches.length + " tests";

                toggleTestTypes.hidden = matches.length <= TESTS_PER_BATCH;

                if (!toggleTestTypes.hidden) {
                    if (testVisibleLimit >= matches.length) {
                        toggleTestTypes.textContent = "Show Less";
                    } else {
                        const nextCount = Math.min(
                            TESTS_PER_BATCH,
                            matches.length - testVisibleLimit
                        );

                        toggleTestTypes.textContent = "Show More (" + nextCount + ")";
                    }
                }
            }

            if (testSearch && toggleTestTypes && noMatchingTests && testResultsCount) {

                testSearch.addEventListener("input", function () {
                    testVisibleLimit = TESTS_PER_BATCH;
                    filterTestTypes();
                });

                // Pressing Enter in the search box must not submit the form.
                testSearch.addEventListener("keydown", function (event) {
                    if (event.key === "Enter") {
                        event.preventDefault();
                    }
                });

                toggleTestTypes.addEventListener("click", function () {
                    const matchingCount = getMatchingTestCards().length;

                    if (testVisibleLimit >= matchingCount) {
                        testVisibleLimit = TESTS_PER_BATCH;
                    } else {
                        testVisibleLimit += TESTS_PER_BATCH;
                    }

                    filterTestTypes();
                });

                filterTestTypes();
            }

            /*
             * INITIAL STATE
             */

            updateTestCount();
            rebuildSampleRows();

            /*
             * FORM VALIDATION
             */

            function clearValidationState() {

                clientValidationSummary.style.display = "none";
                clientValidationList.innerHTML = "";

                document.querySelectorAll(".request-input.input-error")
                    .forEach(function (element) {
                        element.classList.remove("input-error");
                    });

                document.querySelectorAll(".barcode-error")
                    .forEach(function (element) {
                        element.style.display = "none";
                        element.textContent = "";
                    });
            }

            document.getElementById("createTestRequestForm")
                .addEventListener("submit", function (event) {

                    clearValidationState();

                    const problems = [];

                    const idNumber = idSearch.value.trim();

                    if (!/^\d{13}$/.test(idNumber)) {
                        problems.push("Enter the patient's complete 13-digit ID number.");
                        idSearch.classList.add("input-error");
                    }

                    if (!patientIdHidden.value || patientIdHidden.value === "0") {
                        problems.push(
                            "Search for a registered patient and confirm that you have active consent before submitting the request."
                        );
                    }

                    const selectedTests =
                        document.querySelectorAll(".test-checkbox:checked");

                    if (selectedTests.length === 0) {
                        problems.push("Please select at least one test type.");
                    }

                    const barcodeInputs =
                        document.querySelectorAll('input[name="BarcodeNumbers"]');

                    barcodeInputs.forEach(function (input) {

                        if (!input.value.trim()) {

                            input.classList.add("input-error");

                            const sampleName =
                                input.getAttribute("data-sample-name") || "sample";

                            const errorSpan = input.nextElementSibling;

                            if (errorSpan &&
                                errorSpan.classList.contains("barcode-error")) {

                                errorSpan.textContent =
                                    "Barcode is required for " + sampleName + ".";

                                errorSpan.style.display = "block";
                            }

                            problems.push(
                                "Enter a barcode for the " + sampleName + " sample."
                            );
                        }
                    });

                    if (problems.length > 0) {

                        event.preventDefault();

                        clientValidationList.innerHTML = "";

                        problems.forEach(function (problem) {

                            const li = document.createElement("li");
                            li.textContent = problem;

                            clientValidationList.appendChild(li);
                        });

                        clientValidationSummary.style.display = "block";

                        clientValidationSummary.scrollIntoView({
                            behavior: "smooth",
                            block: "start"
                        });
                    }
                });

        });
    </script>
}