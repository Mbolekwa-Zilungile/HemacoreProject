```cshtml
@model HemaCore.ViewModels.DoctorViewModels.EditPatientHistoryViewModel

@{
    ViewData["Title"] = "Edit Medical History";
}

<div class="container-fluid py-4">
    <div class="mb-4">
        <h2 class="fw-bold">Edit Medical History</h2>
        <p class="text-muted">
            Update the medical history for <strong>@Model.PatientName</strong>.
        </p>
    </div>

    <form asp-action="EditPatientHistory" method="post">

        <input type="hidden" asp-for="PatientId" />

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body p-4">

                <h5 class="fw-bold mb-3">Known Conditions</h5>

                <div class="row">
                    @foreach (var condition in Model.AllConditions)
                    {
                        <div class="col-md-4 mb-3">
                            <div class="form-check">
                                <input class="form-check-input"
                                       type="checkbox"
                                       name="SelectedConditionIds"
                                       value="@condition.Id"
                                @(condition.IsSelected ? "checked" : "") />

                                <label class="form-check-label">
                                    @condition.Name
                                </label>
                            </div>
                        </div>
                    }
                </div>

            </div>
        </div>

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body p-4">

                <h5 class="fw-bold mb-3">Allergies</h5>

                <div class="row">
                    @foreach (var allergy in Model.AllAllergies)
                    {
                        <div class="col-md-4 mb-3">
                            <div class="form-check">
                                <input class="form-check-input"
                                       type="checkbox"
                                       name="SelectedAllergyIds"
                                       value="@allergy.Id"
                                @(allergy.IsSelected ? "checked" : "") />

                                <label class="form-check-label">
                                    @allergy.Name
                                </label>
                            </div>
                        </div>
                    }
                </div>

            </div>
        </div>

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body p-4">

                <h5 class="fw-bold mb-3">Medications</h5>

                <div class="row">
                    @foreach (var medication in Model.AllMedications)
                    {
                        <div class="col-md-4 mb-3">
                            <div class="form-check">
                                <input class="form-check-input"
                                       type="checkbox"
                                       name="SelectedMedicationIds"
                                       value="@medication.Id"
                                @(medication.IsSelected ? "checked" : "") />

                                <label class="form-check-label">
                                    @medication.Name
                                </label>
                            </div>
                        </div>
                    }
                </div>

            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary px-4">
                Save Changes
            </button>

            <a asp-controller="Doctor"
               asp-action="ManagePatients"
               class="btn btn-outline-secondary px-4">
                Cancel
            </a>
        </div>

    </form>
</div>

<style>
    .card {
        border-radius: 12px;
    }

    .form-check-input {
        cursor: pointer;
    }

    .form-check-label {
        cursor: pointer;
    }

    .btn-primary {
        background-color: #2c7da0;
        border-color: #2c7da0;
    }

        .btn-primary:hover {
            background-color: #1f5068;
            border-color: #1f5068;
        }
</style>
```
