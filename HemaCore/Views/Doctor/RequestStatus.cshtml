```cshtml
@model HemaCore.ViewModels.DoctorViewModels.RequestStatusViewModel

@{
    ViewData["Title"] = "Request Status";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Test Request Status</h2>
            <p class="text-muted mb-0">
                View the current status of this test request.
            </p>
        </div>

        <a asp-controller="Doctor"
           asp-action="MyRequests"
           class="btn btn-outline-secondary">
            Back to Requests
        </a>
    </div>

    <!-- Request Information -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4">

            <h5 class="fw-bold mb-4">Request Information</h5>

            <div class="row">

                <div class="col-md-4 mb-3">
                    <label class="text-muted small">Request Number</label>
                    <div class="fw-semibold">
                        #@Model.TestRequestId
                    </div>
                </div>

                <div class="col-md-4 mb-3">
                    <label class="text-muted small">Patient</label>
                    <div class="fw-semibold">
                        @Model.PatientName
                    </div>
                </div>

                <div class="col-md-4 mb-3">
                    <label class="text-muted small">Request Date</label>
                    <div class="fw-semibold">
                        @Model.RequestDate
                    </div>
                </div>

                <div class="col-md-4 mb-3">
                    <label class="text-muted small">Urgency</label>
                    <div class="fw-semibold">
                        @Model.Urgency
                    </div>
                </div>

                <div class="col-md-4 mb-3">
                    <label class="text-muted small">Current Status</label>
                    <div>
                        <span class="badge status-badge">
                            @Model.Status
                        </span>
                    </div>
                </div>

            </div>

        </div>
    </div>


    <!-- Requested Tests -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4">

            <h5 class="fw-bold mb-4">Requested Tests</h5>

            @if (Model.TestItems != null && Model.TestItems.Any())
            {
                <div class="table-responsive">

                    <table class="table align-middle">

                        <thead>
                            <tr>
                                <th>Test Type</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model.TestItems)
                            {
                                <tr>

                                    <td class="fw-semibold">
                                        @item.TestTypeName
                                    </td>

                                    <td>
                                        <span class="badge item-status">
                                            @item.Status
                                        </span>
                                    </td>

                                </tr>
                            }
                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <p class="text-muted mb-0">
                    No test types have been recorded for this request.
                </p>
            }

        </div>
    </div>


    <!-- Samples -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4">

            <h5 class="fw-bold mb-4">Samples</h5>

            @if (Model.Samples != null && Model.Samples.Any())
            {
                <div class="table-responsive">

                    <table class="table align-middle">

                        <thead>
                            <tr>
                                <th>Barcode</th>
                                <th>Sample Type</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var sample in Model.Samples)
                            {
                                <tr>

                                    <td class="fw-semibold">
                                        @sample.Barcode
                                    </td>

                                    <td>
                                        @sample.SampleTypeName
                                    </td>

                                </tr>
                            }
                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <p class="text-muted mb-0">
                    No samples have been recorded for this request.
                </p>
            }

        </div>
    </div>


    <!-- Cancel Request -->
    @if (Model.Status == "Submitted" ||
         Model.Status == "Samples Received" ||
         Model.Status == "Sample(s) received")
    {
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">

                <h5 class="fw-bold mb-2">Cancel Test Request</h5>

                <p class="text-muted">
                    You can cancel this request while it is still awaiting
                    laboratory processing.
                </p>

                <form asp-controller="Doctor"
                      asp-action="CancelRequest"
                      method="post">

                    <input type="hidden"
                           name="id"
                           value="@Model.TestRequestId" />

                    <div class="mb-3">
                        <label for="reason" class="form-label fw-semibold">
                            Cancellation Reason
                        </label>

                        <textarea id="reason"
                                  name="reason"
                                  class="form-control"
                                  rows="3"
                                  required
                                  placeholder="Enter the reason for cancellation"></textarea>
                    </div>

                    <button type="submit"
                            class="btn btn-danger">
                        Cancel Request
                    </button>

                </form>

            </div>
        </div>
    }

</div>

<style>
    .card {
        border-radius: 12px;
    }

    .table thead th {
        background-color: #f4f7f9;
        color: #1f5068;
        font-weight: 600;
    }

    .table td,
    .table th {
        padding: 14px;
    }

    .status-badge,
    .item-status {
        background-color: #2c7da0;
        color: white;
        padding: 7px 11px;
        border-radius: 6px;
    }

    .btn-primary {
        background-color: #2c7da0;
        border-color: #2c7da0;
    }

        .btn-primary:hover {
            background-color: #1f5068;
            border-color: #1f5068;
        }
</style>

