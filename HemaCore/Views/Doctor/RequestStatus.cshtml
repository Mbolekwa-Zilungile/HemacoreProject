@model HemaCore.ViewModels.DoctorViewModels.RequestStatusViewModel

@{
    Layout = "~/Views/Shared/_DoctorLayout.cshtml";
    ViewBag.Title = "Request Status";

    var statuses = new[]
    {
        "Submitted",
        "Samples Received",
        "In Progress",
        "Completed",
        "Released"
    };

    var currentStatus = (Model.Status ?? "").Trim();

    string NormalizeStatus(string? status)
    {
        return (status ?? "")
            .Trim()
            .Replace(" ", "")
            .Replace("(", "")
            .Replace(")", "")
            .ToLowerInvariant();
    }

    var normalizedStatus = NormalizeStatus(currentStatus);

    bool IsStatus(string? status, params string[] acceptedStatuses)
    {
        var normalized = NormalizeStatus(status);

        return acceptedStatuses.Any(s =>
            normalized == NormalizeStatus(s));
    }

    var currentIndex = normalizedStatus switch
    {
        "submitted" => 0,
        "samplesreceived" => 1,
        "samplereceived" => 1,
        "inprogress" => 2,
        "completed" => 3,
        "releasedbydoctor" => 4,
        "released" => 4,
        _ => 0
    };

    var isCancelled = IsStatus(currentStatus, "Cancelled");
}

<link rel="stylesheet" href="~/css/doctor.css" />

<div class="rs-page">

    <!-- HEADER -->
    <div class="rs-header">
        <div>
            <span class="rs-eyebrow">
                <i class="fas fa-tasks"></i>
                Doctor Portal
            </span>

            <h1>Test Request #@Model.TestRequestId</h1>

            <p>
                Track the progress of this test request, review sample
                information and check the status of your requested tests.
            </p>
        </div>

        <div class="rs-header-icon">
            <i class="fas fa-file-medical-alt"></i>
        </div>
    </div>

    <!-- PROGRESS TRACKER -->
    <section class="rs-card rs-progress-card">
        <div class="rs-section-heading">
            <div class="rs-heading-icon">
                <i class="fas fa-route"></i>
            </div>
            <div>
                <h2>Request Progress</h2>
                <p>Follow each stage of your laboratory request.</p>
            </div>
        </div>

        @if (isCancelled)
        {
            <div class="rs-cancelled-notice" role="status">
                <i class="fas fa-times-circle"></i>
                <div>
                    <strong>Request Cancelled</strong>
                    <p>This test request has been cancelled.</p>
                </div>
            </div>
        }
        else
        {
            <div class="rs-progress-scroll">
                <div class="rs-progress-steps">
                    @for (int i = 0; i < statuses.Length; i++)
                    {
                        var isCompleted = i <= currentIndex;

                        <div class="rs-progress-step">

                            @if (i < statuses.Length - 1)
                            {
                                <div class="rs-progress-line @(i < currentIndex ? "completed" : "")"></div>
                            }

                            <div class="rs-progress-circle @(isCompleted ? "completed" : "")">
                                @if (isCompleted)
                                {
                                    <i class="fas fa-check"></i>
                                }
                                else
                                {
                                    <span>@(i + 1)</span>
                                }
                            </div>

                            <span class="rs-progress-label @(isCompleted ? "completed" : "")">
                                @statuses[i]
                            </span>
                        </div>
                    }
                </div>
            </div>
        }
    </section>

    <!-- REQUEST INFORMATION -->
    <div class="rs-info-grid">

        <div class="rs-info-card">
            <div class="rs-info-icon rs-icon-blue">
                <i class="fas fa-user"></i>
            </div>
            <div class="rs-info-content">
                <span class="rs-info-label">Patient Name</span>
                <div class="rs-info-value">@Model.PatientName</div>
            </div>
        </div>

        <div class="rs-info-card">
            <div class="rs-info-icon rs-icon-purple">
                <i class="fas fa-calendar-alt"></i>
            </div>
            <div class="rs-info-content">
                <span class="rs-info-label">Request Date</span>
                <div class="rs-info-value">@Model.RequestDate</div>
            </div>
        </div>

        <div class="rs-info-card">
            <div class="rs-info-icon rs-icon-orange">
                <i class="fas fa-flag"></i>
            </div>
            <div class="rs-info-content">
                <span class="rs-info-label">Urgency</span>
                <div class="rs-info-value">
                    @if (IsStatus(Model.Urgency, "Routine"))
                    {
                        <span class="rs-status rs-status-routine">
                            <i class="fas fa-circle"></i> Routine
                        </span>
                    }
                    else if (IsStatus(Model.Urgency, "Urgent"))
                    {
                        <span class="rs-status rs-status-urgent">
                            <i class="fas fa-exclamation-circle"></i> Urgent
                        </span>
                    }
                    else if (IsStatus(Model.Urgency, "STAT"))
                    {
                        <span class="rs-status rs-status-stat">
                            <i class="fas fa-exclamation-triangle"></i> STAT
                        </span>
                    }
                    else
                    {
                        <span class="rs-status rs-status-routine">
                            @(string.IsNullOrWhiteSpace(Model.Urgency) ? "Unknown" : Model.Urgency)
                        </span>
                    }
                </div>
            </div>
        </div>

        <div class="rs-info-card">
            <div class="rs-info-icon rs-icon-green">
                <i class="fas fa-info-circle"></i>
            </div>
            <div class="rs-info-content">
                <span class="rs-info-label">Current Status</span>
                <div class="rs-info-value">
                    @if (IsStatus(currentStatus, "Submitted"))
                    {
                        <span class="rs-status rs-status-submitted">
                            <i class="fas fa-clock"></i> Submitted
                        </span>
                    }
                    else if (IsStatus(currentStatus, "SamplesReceived", "Sample(s) received", "SampleReceived"))
                    {
                        <span class="rs-status rs-status-samples">
                            <i class="fas fa-vial"></i> Samples Received
                        </span>
                    }
                    else if (IsStatus(currentStatus, "InProgress"))
                    {
                        <span class="rs-status rs-status-progress">
                            <i class="fas fa-spinner"></i> In Progress
                        </span>
                    }
                    else if (IsStatus(currentStatus, "Completed"))
                    {
                        <span class="rs-status rs-status-completed">
                            <i class="fas fa-check-circle"></i> Completed
                        </span>
                    }
                    else if (IsStatus(currentStatus, "Released by doctor", "Released"))
                    {
                        <span class="rs-status rs-status-released">
                            <i class="fas fa-check-double"></i> Released
                        </span>
                    }
                    else if (isCancelled)
                    {
                        <span class="rs-status rs-status-cancelled">
                            <i class="fas fa-times-circle"></i> Cancelled
                        </span>
                    }
                    else
                    {
                        <span class="rs-status rs-status-submitted">
                            @(string.IsNullOrWhiteSpace(currentStatus) ? "Unknown" : currentStatus)
                        </span>
                    }
                </div>
            </div>
        </div>

    </div>

    <!-- REQUESTED TESTS -->
    <section class="rs-section">
        <div class="rs-section-heading">
            <div class="rs-heading-icon">
                <i class="fas fa-microscope"></i>
            </div>
            <div>
                <h2>Requested Tests</h2>
                <p>Review the current status of each requested laboratory test.</p>
            </div>
        </div>

        @if (Model.TestItems != null && Model.TestItems.Any())
        {
            <div class="rs-table-wrapper">
                <table class="rs-table">
                    <thead>
                        <tr>
                            <th>Test Name</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.TestItems)
                        {
                            <tr>
                                <td>
                                    <div class="rs-table-primary">
                                        <span class="rs-table-icon">
                                            <i class="fas fa-flask"></i>
                                        </span>
                                        <strong>@item.TestTypeName</strong>
                                    </div>
                                </td>
                                <td>
                                    @if (IsStatus(item.Status, "Submitted"))
                                    {
                                        <span class="rs-status rs-status-submitted">
                                            <i class="fas fa-clock"></i> Submitted
                                        </span>
                                    }
                                    else if (IsStatus(item.Status, "InProgress"))
                                    {
                                        <span class="rs-status rs-status-progress">
                                            <i class="fas fa-spinner"></i> In Progress
                                        </span>
                                    }
                                    else if (IsStatus(item.Status, "Completed"))
                                    {
                                        <span class="rs-status rs-status-completed">
                                            <i class="fas fa-check-circle"></i> Completed - Awaiting Verification
                                        </span>
                                    }
                                    else if (IsStatus(item.Status, "Verified"))
                                    {
                                        <span class="rs-status rs-status-released">
                                            <i class="fas fa-check-double"></i> Verified
                                        </span>
                                    }
                                    else if (IsStatus(item.Status, "To Be Reviewed"))
                                    {
                                        <span class="rs-status rs-status-review">
                                            <i class="fas fa-eye"></i> To Be Reviewed
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="rs-status rs-status-submitted">
                                            @(string.IsNullOrWhiteSpace(item.Status) ? "Unknown" : item.Status)
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="rs-empty-state">
                <div class="rs-empty-icon">
                    <i class="fas fa-microscope"></i>
                </div>
                <h3>No tests recorded</h3>
                <p>No test types have been recorded for this request.</p>
            </div>
        }
    </section>

    <!-- SAMPLES -->
    <section class="rs-section">
        <div class="rs-section-heading">
            <div class="rs-heading-icon rs-heading-icon-teal">
                <i class="fas fa-vial"></i>
            </div>
            <div>
                <h2>Samples Collected</h2>
                <p>View the barcodes and sample types associated with this request.</p>
            </div>
        </div>

        @if (Model.Samples != null && Model.Samples.Any())
        {
            <div class="rs-table-wrapper">
                <table class="rs-table">
                    <thead>
                        <tr>
                            <th>Barcode</th>
                            <th>Sample Type</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sample in Model.Samples)
                        {
                            <tr>
                                <td>
                                    <div class="rs-table-primary">
                                        <span class="rs-table-icon rs-barcode-icon">
                                            <i class="fas fa-barcode"></i>
                                        </span>
                                        <strong>@sample.Barcode</strong>
                                    </div>
                                </td>
                                <td>@sample.SampleTypeName</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="rs-empty-state">
                <div class="rs-empty-icon">
                    <i class="fas fa-vial"></i>
                </div>
                <h3>No samples recorded</h3>
                <p>No samples have been recorded for this request yet.</p>
            </div>
        }
    </section>

    <!-- VIEW RESULTS -->
    @if (!isCancelled &&
         IsStatus(currentStatus, "Completed", "Released by doctor", "Released"))
    {
        <div class="rs-results-card">
            <div class="rs-results-icon">
                <i class="fas fa-file-medical-alt"></i>
            </div>
            <div class="rs-results-content">
                <h3>Test Results</h3>
                <p>
                    View the available results associated with this test request.
                </p>
            </div>
            <a asp-controller="Doctor"
               asp-action="Results"
               asp-route-id="@Model.TestRequestId"
               class="rs-button rs-button-primary">
                <i class="fas fa-eye"></i>
                View Full Results
            </a>
        </div>
    }

    <!-- CANCEL REQUEST -->
    @if (!isCancelled &&
         IsStatus(currentStatus, "Submitted", "SamplesReceived", "Sample(s) received", "SampleReceived"))
    {
        <section class="rs-cancel-card">
            <div class="rs-section-heading">
                <div class="rs-heading-icon rs-heading-icon-red">
                    <i class="fas fa-times-circle"></i>
                </div>
                <div>
                    <h2>Cancel Request</h2>
                    <p>Cancel a request that has not yet been processed by the laboratory.</p>
                </div>
            </div>

            <div class="rs-cancel-warning">
                <i class="fas fa-exclamation-circle"></i>
                <p>
                    Please provide a reason for cancellation. Make sure you have
                    selected the correct request before continuing.
                </p>
            </div>

            <form asp-controller="Doctor"
                  asp-action="CancelRequest"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       value="@Model.TestRequestId" />

                <div class="rs-form-group">
                    <label for="reason">
                        <i class="fas fa-comment-alt"></i>
                        Reason for Cancellation
                    </label>

                    <textarea id="reason"
                              name="reason"
                              rows="4"
                              maxlength="1000"
                              placeholder="Explain why this test request needs to be cancelled..."
                              required></textarea>
                </div>

                <div class="rs-cancel-actions">
                    <button type="submit" class="rs-button rs-button-danger"
                            onclick="return confirm('Are you sure you want to cancel this test request?');">
                        <i class="fas fa-times"></i>
                        Cancel This Request
                    </button>
                </div>
            </form>
        </section>
    }

    <!-- BACK BUTTON -->
    <div class="rs-back-container">
        <a asp-action="MyRequests"
           asp-controller="Doctor"
           class="rs-button rs-button-outline">
            <i class="fas fa-arrow-left"></i>
            Back to My Requests
        </a>
    </div>

</div>

<style>
    .rs-page {
        width: 100%;
        max-width: 1500px;
        margin: 0 auto;
        padding: 28px 30px 40px;
        box-sizing: border-box;
        color: #273244;
        font-family: "Segoe UI", Arial, sans-serif;
        animation: rsFadeIn .4s ease;
    }

        .rs-page * {
            box-sizing: border-box;
        }

    .rs-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 25px;
    }

    .rs-eyebrow {
        display: flex;
        align-items: center;
        gap: 7px;
        margin-bottom: 7px;
        color: #3157c7;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: .08em;
        text-transform: uppercase;
    }

    .rs-header h1 {
        margin: 0;
        color: #172033;
        font-size: 29px;
        font-weight: 800;
        overflow-wrap: anywhere;
    }

    .rs-header p {
        max-width: 650px;
        margin: 7px 0 0;
        color: #718096;
        font-size: 13px;
        line-height: 1.7;
    }

    .rs-header-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 62px;
        height: 62px;
        flex: 0 0 62px;
        border-radius: 16px;
        color: #3157c7;
        background: #eef2ff;
        font-size: 25px;
    }

    .rs-card,
    .rs-info-card,
    .rs-results-card,
    .rs-cancel-card,
    .rs-empty-state {
        background: #fff;
        border: 1px solid #e7ebf1;
        border-radius: 15px;
        box-shadow: 0 5px 18px rgba(15, 23, 42, .045);
    }

    .rs-progress-card {
        padding: 24px;
        margin-bottom: 20px;
    }

    .rs-section-heading {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 20px;
    }

    .rs-heading-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 43px;
        height: 43px;
        flex: 0 0 43px;
        border-radius: 12px;
        color: #3157c7;
        background: #eef2ff;
        font-size: 18px;
    }

    .rs-heading-icon-teal {
        color: #167d8d;
        background: #e8f7f8;
    }

    .rs-heading-icon-red {
        color: #c62828;
        background: #fff0f0;
    }

    .rs-section-heading h2 {
        margin: 0 0 4px;
        color: #172033;
        font-size: 16px;
        font-weight: 750;
    }

    .rs-section-heading p {
        margin: 0;
        color: #8a94a6;
        font-size: 12px;
        line-height: 1.6;
    }

    /* Progress tracker */

    .rs-progress-scroll {
        width: 100%;
        overflow-x: auto;
        padding: 8px 0 2px;
    }

    .rs-progress-steps {
        display: flex;
        align-items: flex-start;
        width: 100%;
        min-width: 490px;
    }

    .rs-progress-step {
        position: relative;
        display: flex;
        flex: 1;
        flex-direction: column;
        align-items: center;
        min-width: 0;
    }

    .rs-progress-line {
        position: absolute;
        z-index: 0;
        top: 17px;
        left: 50%;
        width: 100%;
        height: 3px;
        background: #e5e9f0;
    }

        .rs-progress-line.completed {
            background: #3157c7;
        }

    .rs-progress-circle {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border: 3px solid #e5e9f0;
        border-radius: 50%;
        color: #8a94a6;
        background: #fff;
        font-size: 12px;
        font-weight: 800;
    }

        .rs-progress-circle.completed {
            border-color: #3157c7;
            color: #fff;
            background: #3157c7;
        }

    .rs-progress-label {
        margin-top: 10px;
        color: #8a94a6;
        font-size: 11px;
        font-weight: 600;
        text-align: center;
    }

        .rs-progress-label.completed {
            color: #3157c7;
        }

    .rs-cancelled-notice {
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 17px;
        color: #b42318;
        background: #fff3f3;
        border: 1px solid #f2cccc;
        border-radius: 12px;
    }

        .rs-cancelled-notice > i {
            font-size: 25px;
        }

        .rs-cancelled-notice strong {
            font-size: 14px;
        }

        .rs-cancelled-notice p {
            margin: 4px 0 0;
            font-size: 12px;
        }

    /* Information cards */

    .rs-info-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
        margin-bottom: 30px;
    }

    .rs-info-card {
        display: flex;
        align-items: center;
        gap: 14px;
        min-width: 0;
        padding: 19px;
        transition: box-shadow .2s ease, transform .2s ease;
    }

        .rs-info-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 22px rgba(15, 23, 42, .07);
        }

    .rs-info-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        flex: 0 0 44px;
        border-radius: 12px;
        font-size: 18px;
    }

    .rs-icon-blue {
        color: #3157c7;
        background: #eef2ff;
    }

    .rs-icon-purple {
        color: #6d4bd8;
        background: #f1edff;
    }

    .rs-icon-orange {
        color: #b7791f;
        background: #fff5df;
    }

    .rs-icon-green {
        color: #15803d;
        background: #eaf8ef;
    }

    .rs-info-content {
        min-width: 0;
    }

    .rs-info-label {
        display: block;
        margin-bottom: 6px;
        color: #8a94a6;
        font-size: 11px;
        font-weight: 600;
    }

    .rs-info-value {
        color: #273244;
        font-size: 13px;
        font-weight: 700;
        overflow-wrap: anywhere;
    }

    /* Rounded badges */

    .rs-status {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        max-width: 100%;
        padding: 6px 10px;
        border-radius: 20px;
        font-size: 10px;
        font-weight: 750;
        line-height: 1.4;
        white-space: normal;
        overflow-wrap: anywhere;
        vertical-align: middle;
    }

        .rs-status i {
            font-size: 10px;
        }

    .rs-status-routine,
    .rs-status-submitted {
        color: #526174;
        background: #edf0f5;
    }

    .rs-status-urgent,
    .rs-status-review {
        color: #986500;
        background: #fff3d6;
    }

    .rs-status-stat,
    .rs-status-cancelled {
        color: #b42318;
        background: #fde9eb;
    }

    .rs-status-samples {
        color: #986500;
        background: #fff3d6;
    }

    .rs-status-progress {
        color: #3157c7;
        background: #eef2ff;
    }

    .rs-status-completed,
    .rs-status-released {
        color: #15803d;
        background: #eaf8ef;
    }

    /* Tables */

    .rs-section {
        margin-bottom: 30px;
    }

    .rs-table-wrapper {
        width: 100%;
        overflow-x: auto;
        background: #fff;
        border: 1px solid #e7ebf1;
        border-radius: 14px;
        box-shadow: 0 5px 18px rgba(15, 23, 42, .035);
    }

    .rs-table {
        width: 100%;
        margin: 0;
        border-collapse: collapse;
        text-align: left;
    }

        .rs-table thead th {
            padding: 15px 19px;
            color: #66758a;
            background: #f7f9fc;
            border-bottom: 1px solid #e7ebf1;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: .025em;
        }

        .rs-table tbody td {
            padding: 15px 19px;
            color: #526174;
            border-bottom: 1px solid #edf0f4;
            font-size: 12px;
            vertical-align: middle;
        }

        .rs-table tbody tr:last-child td {
            border-bottom: none;
        }

        .rs-table tbody tr {
            transition: background .2s ease;
        }

            .rs-table tbody tr:hover {
                background: #f9fbff;
            }

    .rs-table-primary {
        display: flex;
        align-items: center;
        gap: 11px;
        color: #344054;
    }

        .rs-table-primary strong {
            font-size: 12px;
            overflow-wrap: anywhere;
        }

    .rs-table-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        flex: 0 0 34px;
        border-radius: 10px;
        color: #3157c7;
        background: #eef2ff;
        font-size: 14px;
    }

    .rs-barcode-icon {
        color: #167d8d;
        background: #e8f7f8;
    }

    /* Empty states */

    .rs-empty-state {
        padding: 35px 20px;
        text-align: center;
        box-shadow: none;
    }

    .rs-empty-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 48px;
        height: 48px;
        margin: 0 auto 12px;
        border-radius: 14px;
        color: #7d8797;
        background: #f1f4f8;
        font-size: 20px;
    }

    .rs-empty-state h3 {
        margin: 0 0 6px;
        color: #344054;
        font-size: 14px;
