@model HemaCore.ViewModels.DoctorViewModels.RequestStatusViewModel

@{
    Layout = "~/Views/Shared/_DoctorLayout.cshtml";
    ViewBag.Title = "Request Status";

    var statuses = new[]
    {
        "Submitted",
        "Samples Received",
        "In Progress",
        "Completed",
        "Released"
    };

    var currentStatus = (Model.Status ?? "").Trim();

    // Normalize status values so that "InProgress" and "In Progress"
    // are treated as the same status.
    string NormalizeStatus(string? status)
    {
        return (status ?? "")
            .Trim()
            .Replace(" ", "")
            .Replace("(", "")
            .Replace(")", "")
            .ToLowerInvariant();
    }

    var normalizedStatus = NormalizeStatus(currentStatus);

    bool IsStatus(string? status, params string[] acceptedStatuses)
    {
        var normalized = NormalizeStatus(status);

        return acceptedStatuses.Any(s =>
            normalized == NormalizeStatus(s));
    }

    // Determine the current progress step.
    var currentIndex = normalizedStatus switch
    {
        "submitted" => 0,

        "samplesreceived" => 1,
        "samplereceived" => 1,

        "inprogress" => 2,

        "completed" => 3,

        "releasedbydoctor" => 4,
        "released" => 4,

        _ => 0
    };

    // Cancelled requests should not appear to be progressing.
    var isCancelled = IsStatus(currentStatus, "Cancelled");
}

<link rel="stylesheet" href="~/css/doctor.css" />

<div class="fade-in">

    <!-- PAGE HEADER -->
    <div class="page-header">
        <h2>
            <i class="fas fa-tasks"></i>
            Test Request #@Model.TestRequestId
        </h2>

        <p>Track the progress of this test request</p>
    </div>

    <!-- PROGRESS BAR -->
    <div class="request-progress-card">

        @if (isCancelled)
        {
            <div class="cancelled-notice">
                <i class="fas fa-times-circle"></i>
                This test request has been cancelled.
            </div>
        }
        else
        {
            <div class="progress-steps">

                @for (int i = 0; i < statuses.Length; i++)
                {
                    var isCompleted = i <= currentIndex;

                    <div class="progress-step">

                        @if (i < statuses.Length - 1)
                        {
                            <div class="progress-line @(i < currentIndex ? "completed" : "")"></div>
                        }

                        <div class="progress-circle @(isCompleted ? "completed" : "")">
                            @if (isCompleted)
                            {
                                <i class="fas fa-check"></i>
                            }
                            else
                            {
                                <span>@(i + 1)</span>
                            }
                        </div>

                        <div class="progress-label @(isCompleted ? "completed" : "")">
                            @statuses[i]
                        </div>

                    </div>
                }

            </div>
        }

    </div>

    <!-- REQUEST INFORMATION -->
    <div class="info-grid">

        <!-- PATIENT -->
        <div class="info-card">
            <label>
                <i class="fas fa-user"></i>
                Patient Name
            </label>

            <div class="info-value">
                @Model.PatientName
            </div>
        </div>

        <!-- REQUEST DATE -->
        <div class="info-card">
            <label>
                <i class="fas fa-calendar"></i>
                Request Date
            </label>

            <div class="info-value">
                @Model.RequestDate
            </div>
        </div>

        <!-- URGENCY -->
        <div class="info-card">
            <label>
                <i class="fas fa-flag"></i>
                Urgency
            </label>

            <div class="info-value">
                @if (IsStatus(Model.Urgency, "Routine"))
                {
                    <span class="badge badge-routine">Routine</span>
                }
                else if (IsStatus(Model.Urgency, "Urgent"))
                {
                    <span class="badge badge-urgent">Urgent</span>
                }
                else if (IsStatus(Model.Urgency, "STAT"))
                {
                    <span class="badge badge-stat">STAT</span>
                }
                else
                {
                    <span class="badge badge-routine">@Model.Urgency</span>
                }
            </div>
        </div>

        <!-- CURRENT STATUS -->
        <div class="info-card">
            <label>
                <i class="fas fa-info-circle"></i>
                Current Status
            </label>

            <div class="info-value">

                @if (IsStatus(currentStatus, "Submitted"))
                {
                    <span class="badge badge-submitted">Submitted</span>
                }
                else if (IsStatus(currentStatus, "SamplesReceived", "Sample(s) received", "SampleReceived"))
                {
                    <span class="badge badge-samplesreceived">Samples Received</span>
                }
                else if (IsStatus(currentStatus, "InProgress"))
                {
                    <span class="badge badge-inprogress">In Progress</span>
                }
                else if (IsStatus(currentStatus, "Completed"))
                {
                    <span class="badge badge-completed">Completed</span>
                }
                else if (IsStatus(currentStatus, "Released by doctor", "Released"))
                {
                    <span class="badge badge-releasedbydoctor">Released</span>
                }
                else if (isCancelled)
                {
                    <span class="badge badge-cancelled">Cancelled</span>
                }
                else
                {
                    <span class="badge badge-submitted">
                        @(string.IsNullOrWhiteSpace(currentStatus) ? "Unknown" : currentStatus)
                    </span>
                }

            </div>
        </div>

    </div>

    <!-- REQUESTED TESTS -->
    <div class="section-title">
        <i class="fas fa-microscope"></i>
        Requested Tests
    </div>

    @if (Model.TestItems != null && Model.TestItems.Any())
    {
        <div class="table-responsive">
            <table class="modern-table">
                <thead>
                    <tr>
                        <th>Test Name</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model.TestItems)
                    {
                        <tr>
                            <td>
                                <strong>@item.TestTypeName</strong>
                            </td>

                            <td>
                                @if (IsStatus(item.Status, "Submitted"))
                                {
                                    <span class="badge badge-submitted">Submitted</span>
                                }
                                else if (IsStatus(item.Status, "InProgress"))
                                {
                                    <span class="badge badge-inprogress">In Progress</span>
                                }
                                else if (IsStatus(item.Status, "Completed"))
                                {
                                    <span class="badge badge-completed">Completed - Awaiting Verification</span>
                                }
                                else if (IsStatus(item.Status, "Verified"))
                                {
                                    <span class="badge badge-verified">Verified</span>
                                }
                                else if (IsStatus(item.Status, "To Be Reviewed"))
                                {
                                    <span class="badge badge-review">To Be Reviewed</span>
                                }
                                else
                                {
                                    <span class="badge badge-submitted">
                                        @(string.IsNullOrWhiteSpace(item.Status) ? "Unknown" : item.Status)
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="empty-message">
            No test types have been recorded for this request.
        </p>
    }

    <!-- SAMPLES -->
    <div class="section-title samples-title">
        <i class="fas fa-vial"></i>
        Samples Collected
    </div>

    @if (Model.Samples != null && Model.Samples.Any())
    {
        <div class="table-responsive">
            <table class="modern-table">
                <thead>
                    <tr>
                        <th>Barcode</th>
                        <th>Sample Type</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var sample in Model.Samples)
                    {
                        <tr>
                            <td>
                                <strong>
                                    <i class="fas fa-barcode barcode-icon"></i>
                                    @sample.Barcode
                                </strong>
                            </td>

                            <td>@sample.SampleTypeName</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="empty-message">
            No samples recorded yet.
        </p>
    }

    <!-- VIEW RESULTS -->
    @if (!isCancelled &&
         IsStatus(currentStatus, "Completed", "Released by doctor", "Released"))
    {
        <div class="results-button-container">
            <a asp-controller="Doctor"
               asp-action="Results"
               asp-route-id="@Model.TestRequestId"
               class="btn-primary-custom">

                <i class="fas fa-file-medical-alt"></i>
                View Full Results
            </a>
        </div>
    }

    <!-- CANCEL REQUEST -->
    @if (!isCancelled &&
         IsStatus(currentStatus, "Submitted", "SamplesReceived", "Sample(s) received", "SampleReceived"))
    {
        <div class="cancel-card">

            <div class="section-title cancel-title">
                <i class="fas fa-times-circle"></i>
                Cancel Request
            </div>

            <p class="cancel-description">
                You can only cancel a request if it has not yet been
                processed by the laboratory. Please provide a reason.
            </p>

            <form asp-controller="Doctor"
                  asp-action="CancelRequest"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       value="@Model.TestRequestId" />

                <div class="form-group">
                    <label for="reason">
                        <i class="fas fa-comment-alt"></i>
                        Reason for Cancellation
                    </label>

                    <textarea id="reason"
                              name="reason"
                              rows="3"
                              placeholder="Enter the reason for cancelling this request..."
                              required></textarea>
                </div>

                <div class="cancel-button-container">
                    <button type="submit" class="cancel-button">
                        <i class="fas fa-times"></i>
                        Cancel This Request
                    </button>
                </div>

            </form>
        </div>
    }

    <!-- BACK BUTTON -->
    <div class="back-button-container">
        <a asp-action="MyRequests"
           asp-controller="Doctor"
           class="btn-outline-custom">

            <i class="fas fa-arrow-left"></i>
            Back to My Requests
        </a>
    </div>

</div>

<style>
    .fade-in {
        animation: fadeInUp 0.5s ease;
    }

    /* PAGE HEADER */
    .page-header {
        margin-bottom: 2rem;
    }

        .page-header h2 {
            margin: 0;
            font-size: 1.8rem;
            font-weight: 700;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

            .page-header h2 i {
                -webkit-text-fill-color: #667eea;
            }

        .page-header p {
            margin: 6px 0 0;
            color: #718096;
            font-size: 14px;
        }

    /* PROGRESS CARD */
    .request-progress-card {
        background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
        border-radius: 24px;
        padding: 2rem;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
        border: 1px solid rgba(0, 0, 0, 0.05);
        margin-bottom: 1.5rem;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .request-progress-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 15px 50px rgba(0, 0, 0, 0.12);
        }

    .progress-steps {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        width: 100%;
    }

    .progress-step {
        display: flex;
        flex-direction: column;
        align-items: center;
        flex: 1;
        position: relative;
    }

    .progress-line {
        position: absolute;
        top: 18px;
        left: 50%;
        width: 100%;
        height: 3px;
        background: #e2e8f0;
        z-index: 0;
    }

        .progress-line.completed {
            background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
        }

    .progress-circle {
        width: 36px;
        height: 36px;
        border-radius: 12px;
        background: #e2e8f0;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 0.85rem;
        z-index: 1;
        position: relative;
    }

        .progress-circle.completed {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }

    .progress-label {
        margin-top: 0.5rem;
        font-size: 0.75rem;
        font-weight: 600;
        color: #718096;
        text-align: center;
    }

        .progress-label.completed {
            color: #667eea;
        }

    .cancelled-notice {
        padding: 1rem;
        border-radius: 12px;
        background: #fed7d7;
        color: #c53030;
        font-weight: 600;
        text-align: center;
    }

    /* INFORMATION CARDS */
    .info-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .info-card {
        background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
        border-radius: 20px;
        padding: 1.25rem 1.5rem;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
        border: 1px solid rgba(0, 0, 0, 0.05);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .info-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 15px 50px rgba(0, 0, 0, 0.12);
        }

        .info-card label {
            display: block;
            color: #718096;
            font-size: 0.85rem;
            font-weight: 600;
            margin-bottom: 0.5rem;
        }

            .info-card label i {
                color: #667eea;
                margin-right: 0.35rem;
            }

    .info-value {
        font-weight: 600;
        color: #2d3748;
    }

    /* TABLES */
    .modern-table {
        width: 100%;
        border-collapse: collapse;
        background: white;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
        margin-bottom: 1rem;
    }

        .modern-table thead th {
            background: #f7fafc;
            color: #667eea;
            font-weight: 600;
            padding: 14px 16px;
            text-align: left;
            border-bottom: 2px solid #e9ecef;
        }

        .modern-table tbody td {
            padding: 14px 16px;
            border-bottom: 1px solid #eef1f3;
            color: #2d3748;
        }

        .modern-table tbody tr:last-child td {
            border-bottom: none;
        }

        .modern-table tbody tr:hover {
            background: #f0f4ff;
        }

    .barcode-icon {
        color: #667eea;
        margin-right: 0.4rem;
    }

    /* SECTION TITLES */
    .section-title {
        margin-top: 1.5rem;
        margin-bottom: 0.75rem;
        color: #2d3748;
        font-size: 1.15rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

        .section-title i {
            color: #667eea;
        }

    .samples-title {
        margin-top: 1.5rem;
    }

    .empty-message {
        color: #718096;
        margin-bottom: 1.5rem;
    }

    /* BADGES */
    .badge {
        display: inline-block;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .badge-routine {
        background: #edf2f7;
        color: #4a5568;
    }

    .badge-urgent {
        background: #feebc8;
        color: #c05621;
    }

    .badge-stat {
        background: #fed7d7;
        color: #c53030;
    }

    .badge-submitted {
        background: #e2e8f0;
        color: #4a5568;
    }

    .badge-samplesreceived {
        background: #faf089;
        color: #975a16;
    }

    .badge-inprogress {
        background: #bee3f8;
        color: #2b6cb0;
    }

    .badge-completed {
        background: #c6f6d5;
        color: #276749;
    }

    .badge-releasedbydoctor,
    .badge-verified {
        background: #c6f6d5;
        color: #276749;
    }

    .badge-review {
        background: #feebc8;
        color: #975a16;
    }

    .badge-cancelled {
        background: #fed7d7;
        color: #c53030;
    }

    /* RESULTS BUTTON */
    .results-button-container {
        margin-top: 1rem;
        margin-bottom: 1.5rem;
    }

    .btn-primary-custom {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        text-decoration: none;
        padding: 0.65rem 1.5rem;
        border-radius: 12px;
        font-weight: 600;
        transition: all 0.3s ease;
    }

        .btn-primary-custom:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.3);
            color: white;
            text-decoration: none;
        }

    /* CANCEL REQUEST */
    .cancel-card {
        background: linear-gradient(135deg, #ffffff 0%, #fff8f8 100%);
        border-radius: 24px;
        padding: 1.5rem 2rem;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
        margin-top: 2rem;
        border: 1px solid rgba(0, 0, 0, 0.05);
        border-left: 4px solid #e53e3e;
    }

    .cancel-title {
        margin-top: 0;
        color: #e53e3e;
    }

        .cancel-title i {
            color: #e53e3e;
        }

    .cancel-description {
        color: #718096;
        font-size: 0.9rem;
        margin-bottom: 1rem;
    }

    .cancel-card .form-group {
        margin-bottom: 1rem;
    }

        .cancel-card .form-group label {
            display: block;
            font-weight: 600;
            margin-bottom: 0.5rem;
            color: #2d3748;
        }

            .cancel-card .form-group label i {
                margin-right: 0.35rem;
                color: #e53e3e;
            }

    .cancel-card textarea {
        width: 100%;
        border: 2px solid #e2e8f0;
        border-radius: 12px;
        padding: 0.75rem 1rem;
        resize: vertical;
        font-family: inherit;
        box-sizing: border-box;
        transition: all 0.3s ease;
    }

        .cancel-card textarea:hover {
            border-color: #cbd5e0;
        }

        .cancel-card textarea:focus {
            outline: none;
            border-color: #e53e3e;
            box-shadow: 0 0 0 3px rgba(229, 62, 62, 0.1);
        }

    .cancel-button-container {
        display: flex;
        justify-content: flex-end;
    }

    .cancel-button {
        background: linear-gradient(135deg, #fc8181 0%, #e53e3e 100%);
        color: white;
        border: none;
        padding: 0.7rem 1.8rem;
        border-radius: 12px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .cancel-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(229, 62, 62, 0.3);
        }

    /* BACK BUTTON */
    .back-button-container {
        margin-top: 1.5rem;
        margin-bottom: 1rem;
    }

    .btn-outline-custom {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: #718096;
        border: 2px solid #e2e8f0;
        background: white;
        text-decoration: none;
        padding: 0.6rem 1.5rem;
        border-radius: 12px;
        font-weight: 500;
        transition: all 0.3s ease;
    }

        .btn-outline-custom:hover {
            background: #f7fafc;
            border-color: #cbd5e0;
            color: #4a5568;
            transform: translateY(-2px);
            text-decoration: none;
        }

    /* ANIMATION AND MOBILE */
    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@media (max-width: 768px) {
        .info-grid {
            grid-template-columns: 1fr;
        }

        .request-progress-card {
            padding: 1rem;
            overflow-x: auto;
        }

        .progress-steps {
            min-width: 600px;
        }

        .table-responsive {
            overflow-x: auto;
        }

        .modern-table {
            min-width: 600px;
        }

        .cancel-card {
            padding: 1.25rem;
        }

        .cancel-button-container {
            justify-content: stretch;
        }

        .cancel-button {
            width: 100%;
        }
    }
</style>
