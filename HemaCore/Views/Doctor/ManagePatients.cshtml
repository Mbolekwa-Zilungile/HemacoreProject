@model List<HemaCore.ViewModels.DoctorViewModels.PatientListItemViewModel>

@{
    ViewData["Title"] = "Manage Patients";
    Layout = "~/Views/Shared/_DoctorLayout.cshtml";

    var totalPatients = Model?.Count ?? 0;
    var totalRequests = Model?.Sum(p => p.RequestCount) ?? 0;
    var patientsWithConditions = Model?.Count(p => p.Conditions?.Any() == true) ?? 0;
    var patientsOnMedication = Model?.Count(p => p.Medications?.Any() == true) ?? 0;
}

<style>
    .patients-container {
        max-width: 100%;
        overflow-x: auto;
    }

    .page-header {
        margin-bottom: 1.75rem;
    }

        .page-header h1 {
            font-size: 1.5rem;
            font-weight: 600;
            color: #1f5068;
            margin: 0 0 .25rem;
        }

        .page-header p {
            color: #64748b;
            font-size: .875rem;
            margin: 0;
        }

    .search-card, .stat-card, .table-wrapper, .empty-state {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
    }

    .search-card {
        padding: 1rem 1.25rem;
        margin-bottom: 1rem;
        box-shadow: 0 1px 2px #00000008;
    }

    .search-flex {
        display: flex;
        gap: .75rem;
        align-items: center;
        flex-wrap: wrap;
    }

    .search-field {
        flex: 1;
        min-width: 250px;
    }

        .search-field input {
            width: 100%;
            padding: .7rem 1rem;
            border: 1px solid #cbd5e1;
            border-radius: 8px;
            font-size: .875rem;
            color: #334155;
            background: #fff;
        }

            .search-field input:focus {
                outline: none;
                border-color: #2c7da0;
                box-shadow: 0 0 0 3px #2c7da01a;
            }

    .search-help {
        font-size: .75rem;
        color: #64748b;
        margin-top: .4rem;
    }

    .btn-primary, .btn-outline {
        padding: .625rem 1.1rem;
        border-radius: 8px;
        font-size: .875rem;
        font-weight: 500;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .5rem;
        text-decoration: none;
        transition: background .2s ease;
    }

    .btn-primary {
        background: #2c7da0;
        color: #fff;
        border: 1px solid #2c7da0;
    }

        .btn-primary:hover {
            background: #1f5068;
            color: #fff;
        }

    .btn-outline {
        background: #fff;
        color: #2c7da0;
        border: 1px solid #2c7da0;
    }

        .btn-outline:hover {
            background: #eef7fa;
            color: #1f5068;
        }

    .search-result {
        display: none;
        padding: 1rem;
        margin-bottom: 1.5rem;
        border-radius: 8px;
        font-size: .875rem;
    }

        .search-result.info {
            display: block;
            background: #e0f2fe;
            color: #075985;
        }

        .search-result.success {
            display: block;
            background: #dcfce7;
            color: #166534;
        }

        .search-result.error {
            display: block;
            background: #fee2e2;
            color: #991b1b;
        }

    .consent-form {
        display: none;
        margin-top: .85rem;
    }

    .stats-row {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .stat-card {
        padding: 1rem;
        text-align: center;
    }

    .stat-icon {
        width: 42px;
        height: 42px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto .75rem;
    }

    .stat-number {
        font-size: 1.5rem;
        font-weight: 700;
        color: #0f172a;
    }

    .stat-label {
        font-size: .7rem;
        font-weight: 500;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: .5px;
    }

    .table-wrapper {
        overflow-x: auto;
    }

    .patient-table {
        width: 100%;
        border-collapse: collapse;
        font-size: .813rem;
        min-width: 1100px;
    }

        .patient-table th {
            text-align: left;
            padding: 1rem;
            background: #f8fafc;
            font-weight: 600;
            color: #475569;
            border-bottom: 1px solid #e2e8f0;
            font-size: .75rem;
            text-transform: uppercase;
            letter-spacing: .5px;
            white-space: nowrap;
        }

        .patient-table td {
            padding: 1rem;
            border-bottom: 1px solid #f1f5f9;
            vertical-align: middle;
            color: #334155;
        }

        .patient-table tbody tr:hover td {
            background: #f8fafc;
        }

        .patient-table tbody tr:last-child td {
            border-bottom: none;
        }

    .patient-info {
        display: flex;
        align-items: center;
        gap: .75rem;
        min-width: 220px;
    }

    .patient-avatar {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: #e6f3f7;
        color: #2c7da0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        flex-shrink: 0;
    }

    .patient-details {
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    .patient-name {
        font-weight: 600;
        color: #1f5068;
    }

    .patient-email {
        font-size: .7rem;
        color: #64748b;
        word-break: break-word;
    }

    .request-count {
        font-size: .65rem;
        color: #2c7da0;
        margin-top: .125rem;
    }

    .patient-id {
        font-family: monospace;
        font-size: .8rem;
        color: #475569;
        white-space: nowrap;
    }

    .contact-cell {
        display: flex;
        align-items: center;
        gap: .375rem;
        font-size: .75rem;
        white-space: nowrap;
    }

    .badge-condition, .badge-allergy, .badge-medication, .badge-more {
        display: inline-block;
        padding: .2rem .6rem;
        border-radius: 20px;
        font-size: .7rem;
        font-weight: 500;
        margin: .125rem;
        white-space: nowrap;
    }

    .badge-condition {
        background: #e0f2fe;
        color: #0369a1;
    }

    .badge-allergy {
        background: #fee2e2;
        color: #b91c1c;
    }

    .badge-medication {
        background: #dcfce7;
        color: #166534;
    }

    .badge-more {
        background: #f1f5f9;
        color: #64748b;
    }

    .empty-badge {
        color: #94a3b8;
        font-size: .7rem;
        font-style: italic;
    }

    .actions {
        display: flex;
        align-items: center;
        gap: .4rem;
        white-space: nowrap;
    }

    .action-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        padding: 7px 10px;
        border-radius: 6px;
        font-size: .72rem;
        font-weight: 600;
        text-decoration: none;
        border: 1px solid transparent;
        cursor: pointer;
    }

    .view-btn {
        background: #eef7fa;
        color: #2c7da0;
        border-color: #d8edf3;
    }

        .view-btn:hover {
            background: #dceff5;
            color: #1f5068;
        }

    .test-btn {
        background: #e0f2fe;
        color: #0369a1;
        border-color: #bae6fd;
    }

        .test-btn:hover {
            background: #bae6fd;
            color: #075985;
        }

    .history-btn {
        background: #f5f7f9;
        color: #475569;
        border-color: #e2e8f0;
    }

        .history-btn:hover {
            background: #e9eef2;
            color: #1f5068;
        }

    .empty-state {
        text-align: center;
        padding: 3rem 2rem;
    }

    .empty-icon {
        width: 64px;
        height: 64px;
        background: #eef7fa;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1rem;
        color: #2c7da0;
        font-size: 1.5rem;
    }

    .empty-state h3 {
        font-size: 1rem;
        font-weight: 600;
        color: #1f5068;
    }

    .empty-state p {
        font-size: .813rem;
        color: #64748b;
        margin-bottom: 1rem;
    }

    @@media (max-width: 1000px) {
        .stats-row {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 768px) {
        .search-flex {
            flex-direction: column;
            align-items: stretch;
        }

        .search-field {
            width: 100%;
            min-width: 0;
        }

        .search-flex > .btn-primary, .search-flex > .btn-outline {
            width: 100%;
        }

        .actions {
            flex-direction: column;
            align-items: stretch;
        }

        .action-btn {
            width: 100%;
        }
    }

    @@media (max-width: 500px) {
        .stats-row {
            grid-template-columns: 1fr;
        }
    }

    .patient-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        position: relative;
        z-index: 10;
    }

        .patient-actions a {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 8px 12px;
            cursor: pointer;
            pointer-events: auto;
            position: relative;
            z-index: 11;
        }
</style>

<div class="patients-container">
    <div class="page-header">
        <h1><i class="fas fa-users" style="color:#2c7da0;"></i> Patient Directory</h1>
        <p>Search using a complete South African ID number, or select a patient below.</p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="search-result success" style="display:block;">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="search-result error" style="display:block;">@TempData["Error"]</div>
    }

    <div class="search-card">
        <div class="search-flex">
            <div class="search-field">
                <input type="text" id="patientSearch"
                       placeholder="Enter full 13-digit ID number"
                       maxlength="13" inputmode="numeric" autocomplete="off"
                       aria-describedby="searchHelp" />
                <div class="search-help" id="searchHelp">
                    Enter all 13 digits. Partial ID numbers are not accepted.
                </div>
            </div>

            <button type="button" id="searchPatientButton" class="btn-primary">
                <i class="fas fa-search"></i> Search
            </button>

            <a asp-action="AddPatient" asp-controller="Doctor" class="btn-outline">
                <i class="fas fa-user-plus"></i> New Patient
            </a>
        </div>
    </div>

    <div id="searchResult" class="search-result" role="status" aria-live="polite">
        <div id="searchResultMessage"></div>

        <div id="patientDetailsAction" style="display:none; margin-top:.75rem;">
            <a id="viewSearchedPatient" class="btn-primary" href="#">
                <i class="fas fa-eye"></i> View Patient Details
            </a>
        </div>

        <form id="consentRequestForm" method="post"
              action="@Url.Action("RequestConsent", "Doctor")"
              class="consent-form">
            @Html.AntiForgeryToken()
            <input type="hidden" id="consentPatientId" name="patientId" />
            <button type="submit" class="btn-primary">
                <i class="fas fa-paper-plane"></i> Request Consent
            </button>
        </form>
    </div>

    <div class="stats-row">
        <div class="stat-card">
            <div class="stat-icon" style="background:#e0f2fe;"><i class="fas fa-users" style="color:#0284c7;"></i></div>
            <div class="stat-number">@totalPatients</div>
            <div class="stat-label">Total Patients</div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="background:#dcfce7;"><i class="fas fa-flask" style="color:#16a34a;"></i></div>
            <div class="stat-number">@totalRequests</div>
            <div class="stat-label">Test Requests</div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="background:#fee2e2;"><i class="fas fa-heartbeat" style="color:#dc2626;"></i></div>
            <div class="stat-number">@patientsWithConditions</div>
            <div class="stat-label">With Conditions</div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="background:#fef3c7;"><i class="fas fa-pills" style="color:#d97706;"></i></div>
            <div class="stat-number">@patientsOnMedication</div>
            <div class="stat-label">On Medication</div>
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="empty-state">
            <div class="empty-icon"><i class="fas fa-user-slash"></i></div>
            <h3>No registered patients found</h3>
            <p>Search for an existing patient or add a new patient.</p>
            <a asp-action="AddPatient" asp-controller="Doctor" class="btn-primary">
                <i class="fas fa-user-plus"></i> Add Patient
            </a>
        </div>
    }
    else
    {
        <div class="table-wrapper">
            <table class="patient-table" id="patientsTable">
                <thead>
                    <tr>
                        <th>Patient</th>
                        <th>ID Number</th>
                        <th>Date of Birth</th>
                        <th>Contact</th>
                        <th>Conditions</th>
                        <th>Allergies</th>
                        <th>Medications</th>
                        <th style="text-align:center;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var patient in Model.OrderBy(p => p.FullName))
                    {
                        var fullName = patient.FullName ?? "";
                        var nameParts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                        var initials = nameParts.Length >= 2
                            ? nameParts[0].Substring(0, 1).ToUpper() + nameParts[^1].Substring(0, 1).ToUpper()
                            : nameParts.Length == 1
                                ? nameParts[0].Substring(0, 1).ToUpper()
                                : "?";

                        <tr>
                            <td>
                                <div class="patient-info">
                                    <div class="patient-avatar">@initials</div>
                                    <div class="patient-details">
                                        <span class="patient-name">@patient.FullName</span>
                                        <span class="patient-email">@patient.Email</span>
                                        <span class="request-count">
                                            <i class="fas fa-flask"></i>
                                            @patient.RequestCount request@(patient.RequestCount != 1 ? "s" : "")
                                        </span>
                                    </div>
                                </div>
                            </td>
                            <td><span class="patient-id">@patient.IDNumber</span></td>
                            <td><span class="empty-badge">Not available</span></td>
                            <td>
                                <div class="contact-cell">
                                    <i class="fas fa-phone"></i>
                                    <span>@patient.PhoneNumber</span>
                                </div>
                            </td>
                            <td>
                                @if (patient.Conditions?.Any() == true)
                                {
                                    foreach (var condition in patient.Conditions.Take(2))
                                    {
                                        <span class="badge-condition">@condition</span>
                                    }
                                    if (patient.Conditions.Count > 2)
                                    {
                                        <span class="badge-more">+@(patient.Conditions.Count - 2)</span>
                                    }
                                }
                                else
                                {
                                    <span class="empty-badge">—</span>
                                }
                            </td>
                            <td>
                                @if (patient.Allergies?.Any() == true)
                                {
                                    foreach (var allergy in patient.Allergies.Take(2))
                                    {
                                        <span class="badge-allergy">@allergy</span>
                                    }
                                    if (patient.Allergies.Count > 2)
                                    {
                                        <span class="badge-more">+@(patient.Allergies.Count - 2)</span>
                                    }
                                }
                                else
                                {
                                    <span class="empty-badge">—</span>
                                }
                            </td>
                            <td>
                                @if (patient.Medications?.Any() == true)
                                {
                                    foreach (var medication in patient.Medications.Take(2))
                                    {
                                        <span class="badge-medication">@medication</span>
                                    }
                                    if (patient.Medications.Count > 2)
                                    {
                                        <span class="badge-more">+@(patient.Medications.Count - 2)</span>
                                    }
                                }
                                else
                                {
                                    <span class="empty-badge">—</span>
                                }
                            </td>
                            <td>
                                
                                <div class="patient-actions">
                                    <a asp-controller="Doctor"
                                       asp-action="PatientDetails"
                                       asp-route-id="@patient.PatientId"
                                       class="action-btn view-btn">
                                        View
                                    </a>

                                    <a asp-controller="Doctor"
                                       asp-action="CreateTestRequest"
                                       asp-route-patientId="@patient.PatientId"
                                       class="action-btn test-btn">
                                        Test
                                    </a>

                                    <a asp-controller="Doctor"
                                       asp-action="EditPatientHistory"
                                       asp-route-id="@patient.PatientId"
                                       class="action-btn history-btn">
                                        History
                                    </a>
                                </div>
                                ```
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<script>
    (() => {
        const searchInput = document.getElementById("patientSearch");
        const searchButton = document.getElementById("searchPatientButton");
        const resultPanel = document.getElementById("searchResult");
        const resultMessage = document.getElementById("searchResultMessage");
        const consentForm = document.getElementById("consentRequestForm");
        const consentPatientId = document.getElementById("consentPatientId");
        const detailsAction = document.getElementById("patientDetailsAction");
        const viewPatientLink = document.getElementById("viewSearchedPatient");

        const searchUrl = '@Url.Action("SearchPatientById", "Doctor")';
        const detailsUrl = '@Url.Action("PatientDetails", "Doctor")';

        function resetSearchResults() {
            resultPanel.className = "search-result";
            resultPanel.style.display = "none";
            resultMessage.textContent = "";
            consentForm.style.display = "none";
            detailsAction.style.display = "none";
            consentPatientId.value = "";
            viewPatientLink.href = "#";
        }

        function showMessage(message, type) {
            resultPanel.className = "search-result " + type;
            resultPanel.style.display = "block";
            resultMessage.textContent = message;
        }

        async function runSearch() {
            const idNumber = searchInput.value.trim();
            resetSearchResults();

            if (!/^[0-9]{13}$/.test(idNumber)) {
                showMessage("Please enter the full 13-digit ID number.", "error");
                searchInput.focus();
                return;
            }

            searchButton.disabled = true;
            searchButton.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Searching...';
            showMessage("Searching for patient...", "info");

            try {
                const response = await fetch(
                    searchUrl + "?idNumber=" + encodeURIComponent(idNumber),
                    { method: "GET", headers: { "Accept": "application/json" } }
                );

                if (!response.ok) {
                    throw new Error("The search could not be completed. Please try again.");
                }

                const data = await response.json();

                if (!data.found) {
                    showMessage(data.message || "No patient was found with this ID number.", "error");
                    return;
                }

                if (data.hasConsent) {
                    showMessage("Patient found. You have active consent to access this patient's records.", "success");

                    if (data.patientId !== null && data.patientId !== undefined) {
                        const url = new URL(detailsUrl, window.location.origin);
                        url.searchParams.set("id", data.patientId);
                        viewPatientLink.href = url.pathname + url.search;
                        detailsAction.style.display = "block";
                    }
                    return;
                }

                showMessage(
                    data.message || "Patient found, but you do not have active consent. Please request consent from the patient.",
                    "info"
                );

                if (data.patientId !== null && data.patientId !== undefined) {
                    consentPatientId.value = data.patientId;
                    consentForm.style.display = "block";
                }
            }
            catch (error) {
                showMessage(error.message || "An error occurred while searching.", "error");
            }
            finally {
                searchButton.disabled = false;
                searchButton.innerHTML = '<i class="fas fa-search"></i> Search';
            }
        }

        searchButton.addEventListener("click", runSearch);

        searchInput.addEventListener("keydown", function (event) {
            if (event.key === "Enter") {
                event.preventDefault();
                runSearch();
            }
        });

        searchInput.addEventListener("input", function () {
            resetSearchResults();
            this.value = this.value.replace(/[^0-9]/g, "").slice(0, 13);
        });
    })();
</script>
