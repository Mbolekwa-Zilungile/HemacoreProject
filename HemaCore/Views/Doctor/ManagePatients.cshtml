@model List<HemaCore.ViewModels.DoctorViewModels.PatientListItemViewModel>

@{
    ViewData["Title"] = "Manage Patients";
    Layout = "~/Views/Shared/_DoctorLayout.cshtml";
}

<style>
    .patients-page {
        padding: 10px 5px 30px;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 25px;
    }

    .page-title h1 {
        margin: 0;
        color: #1f5068;
        font-size: 28px;
        font-weight: 700;
    }

    .page-title p {
        margin: 6px 0 0;
        color: #6b7280;
        font-size: 14px;
    }

    .add-patient-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #2c7da0;
        color: white;
        border: none;
        border-radius: 8px;
        padding: 11px 18px;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        transition: 0.2s ease;
    }

        .add-patient-btn:hover {
            background: #1f5068;
            color: white;
        }

    .patients-card {
        background: #ffffff;
        border-radius: 12px;
        border: 1px solid #e5e7eb;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
        overflow: hidden;
    }

    .card-top {
        padding: 20px 22px;
        border-bottom: 1px solid #e5e7eb;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
    }

        .card-top h2 {
            margin: 0;
            color: #1f5068;
            font-size: 18px;
            font-weight: 650;
        }

    .patient-count {
        color: #6b7280;
        font-size: 13px;
        margin-top: 4px;
    }

    .search-box {
        position: relative;
        width: 280px;
    }

        .search-box i {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #9ca3af;
            font-size: 14px;
        }

        .search-box input {
            width: 100%;
            height: 40px;
            border: 1px solid #d1d5db;
            border-radius: 7px;
            padding: 0 12px 0 36px;
            outline: none;
            font-size: 13px;
            color: #374151;
            background: #fff;
        }

            .search-box input:focus {
                border-color: #61a5c2;
                box-shadow: 0 0 0 3px rgba(97, 165, 194, 0.12);
            }

    .table-wrapper {
        width: 100%;
        overflow-x: auto;
    }

    .patients-table {
        width: 100%;
        border-collapse: collapse;
    }

        .patients-table thead {
            background: #f8fafb;
        }

        .patients-table th {
            padding: 14px 20px;
            text-align: left;
            font-size: 12px;
            font-weight: 700;
            color: #64748b;
            text-transform: uppercase;
            letter-spacing: 0.03em;
            border-bottom: 1px solid #e5e7eb;
            white-space: nowrap;
        }

        .patients-table td {
            padding: 16px 20px;
            font-size: 14px;
            color: #374151;
            border-bottom: 1px solid #edf0f2;
            vertical-align: middle;
        }

        .patients-table tbody tr {
            transition: background 0.15s ease;
        }

            .patients-table tbody tr:hover {
                background: #f8fbfc;
            }

    .patient-name {
        display: flex;
        align-items: center;
        gap: 11px;
        font-weight: 600;
        color: #1f5068;
    }

    .patient-avatar {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: #e6f3f7;
        color: #2c7da0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 14px;
        flex-shrink: 0;
    }

    .patient-id {
        color: #64748b;
        font-size: 13px;
    }

    .phone-number {
        color: #475569;
    }

    .actions {
        display: flex;
        align-items: center;
        gap: 7px;
        white-space: nowrap;
    }

    .action-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        min-height: 34px;
        padding: 7px 11px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 600;
        text-decoration: none;
        border: 1px solid transparent;
        transition: 0.2s ease;
    }

    .view-btn {
        background: #eef7fa;
        color: #2c7da0;
        border-color: #d8edf3;
    }

        .view-btn:hover {
            background: #dceff5;
            color: #1f5068;
        }

    .history-btn {
        background: #f5f7f9;
        color: #475569;
        border-color: #e2e8f0;
    }

        .history-btn:hover {
            background: #e9eef2;
            color: #1f5068;
        }

    .empty-state {
        padding: 60px 20px;
        text-align: center;
    }

    .empty-icon {
        width: 58px;
        height: 58px;
        margin: 0 auto 15px;
        border-radius: 50%;
        background: #eef7fa;
        color: #2c7da0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 23px;
    }

    .empty-state h3 {
        margin: 0 0 6px;
        color: #1f5068;
        font-size: 17px;
    }

    .empty-state p {
        margin: 0;
        color: #6b7280;
        font-size: 14px;
    }

    .no-results {
        display: none;
        padding: 35px 20px;
        text-align: center;
        color: #6b7280;
        font-size: 14px;
    }

    @@media (max-width: 768px) {
        .page-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .add-patient-btn {
            width: 100%;
            justify-content: center;
        }

        .card-top {
            flex-direction: column;
            align-items: stretch;
        }

        .search-box {
            width: 100%;
        }

        .patients-table th,
        .patients-table td {
            padding: 12px 14px;
        }

        .actions {
            flex-direction: column;
            align-items: stretch;
        }

        .action-btn {
            width: 100%;
        }
    }
</style>

<div class="patients-page">

    <div class="page-header">
        <div class="page-title">
            <h1>Manage Patients</h1>
            <p>View and manage patients who are associated with your doctor profile.</p>
        </div>

        <a asp-controller="Doctor"
           asp-action="AddPatient"
           class="add-patient-btn">
            <i class="bi bi-person-plus"></i>
            Add New Patient
        </a>
    </div>

    <div class="patients-card">

        <div class="card-top">
            <div>
                <h2>My Patients</h2>

                <div class="patient-count">
                    @Model.Count patient@(Model.Count == 1 ? "" : "s")
                </div>
            </div>

            @if (Model.Any())
            {
                <div class="search-box">
                    <i class="bi bi-search"></i>

                    <input type="text"
                           id="patientSearch"
                           placeholder="Search patients..."
                           autocomplete="off" />
                </div>
            }
        </div>

        @if (Model.Any())
        {
            <div class="table-wrapper">

                <table class="patients-table" id="patientsTable">

                    <thead>
                        <tr>
                            <th>Patient</th>
                            <th>ID Number</th>
                            <th>Phone Number</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody id="patientsTableBody">

                        @foreach (var patient in Model)
                        {
                            var initials = "";

                            if (!string.IsNullOrWhiteSpace(patient.FullName))
                            {
                                var nameParts = patient.FullName
                                    .Split(' ', StringSplitOptions.RemoveEmptyEntries);

                                if (nameParts.Length >= 2)
                                {
                                    initials =
                                        nameParts[0].Substring(0, 1).ToUpper() +
                                        nameParts[^1].Substring(0, 1).ToUpper();
                                }
                                else
                                {
                                    initials = nameParts[0]
                                        .Substring(0, 1)
                                        .ToUpper();
                                }
                            }

                            <tr class="patient-row"
                                data-search="@($"{patient.FullName} {patient.IDNumber} {patient.PhoneNumber}")">

                                <td>
                                    <div class="patient-name">

                                        <div class="patient-avatar">
                                            @initials
                                        </div>

                                        <span>
                                            @patient.FullName
                                        </span>

                                    </div>
                                </td>

                                <td>
                                    <span class="patient-id">
                                        @patient.IDNumber
                                    </span>
                                </td>

                                <td>
                                    <span class="phone-number">
                                        @patient.PhoneNumber
                                    </span>
                                </td>

                                <td>
                                    <div class="actions">

                                        <a asp-controller="Doctor"
                                           asp-action="PatientDetails"
                                           asp-route-id="@patient.PatientId"
                                           class="action-btn view-btn">
                                            <i class="bi bi-eye"></i>
                                            View
                                        </a>

                                        <a asp-controller="Doctor"
                                           asp-action="EditPatientHistory"
                                           asp-route-id="@patient.PatientId"
                                           class="action-btn history-btn">
                                            <i class="bi bi-clipboard2-pulse"></i>
                                            Medical History
                                        </a>

                                    </div>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

                <div class="no-results" id="noResults">
                    No patients match your search.
                </div>

            </div>
        }
        else
        {
            <div class="empty-state">

                <div class="empty-icon">
                    <i class="bi bi-people"></i>
                </div>

                <h3>No patients found</h3>

                <p>
                    You currently do not have any patients associated with your profile.
                </p>

                <div style="margin-top: 18px;">
                    <a asp-controller="Doctor"
                       asp-action="AddPatient"
                       class="add-patient-btn">
                        <i class="bi bi-person-plus"></i>
                        Add New Patient
                    </a>
                </div>

            </div>
        }

    </div>

</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {

        const searchInput = document.getElementById("patientSearch");
        const rows = document.querySelectorAll(".patient-row");
        const noResults = document.getElementById("noResults");

        if (!searchInput) {
            return;
        }

        searchInput.addEventListener("input", function() {

            const searchValue = this.value
                .toLowerCase()
                .trim();

            let visibleRows = 0;

            rows.forEach(function(row) {

                const searchText = row
                    .getAttribute("data-search")
                    .toLowerCase();

                if (searchText.includes(searchValue)) {
                    row.style.display = "";
                    visibleRows++;
                }
                else {
                    row.style.display = "none";
                }
            });

            if (noResults) {
                noResults.style.display =
                    visibleRows === 0 ? "block" : "none";
            }
        });
    });
</script>