```cshtml
@model HemaCore.ViewModels.DoctorViewModels.PatientDetailsViewModel

@{
    ViewData["Title"] = "Patient Details";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Patient Details</h2>
            <p class="text-muted mb-0">
                View patient information and medical history.
            </p>
        </div>

        <a asp-controller="Doctor"
           asp-action="ManagePatients"
           class="btn btn-outline-secondary">
            Back to Patients
        </a>
    </div>

    <!-- Patient Information -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4">

            <h5 class="fw-bold mb-4">Personal Information</h5>

            <div class="row">

                <div class="col-md-6 mb-3">
                    <label class="text-muted small">Full Name</label>
                    <div class="fw-semibold">@Model.FullName</div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="text-muted small">ID Number</label>
                    <div class="fw-semibold">@Model.IDNumber</div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="text-muted small">Date of Birth</label>
                    <div class="fw-semibold">
                        @Model.DateOfBirth.ToString("dd MMMM yyyy")
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="text-muted small">Phone Number</label>
                    <div class="fw-semibold">@Model.PhoneNumber</div>
                </div>

                <div class="col-md-12 mb-3">
                    <label class="text-muted small">Address</label>
                    <div class="fw-semibold">
                        @(string.IsNullOrWhiteSpace(Model.Address)
                            ? "No address recorded"
                            : Model.Address)
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Medical History -->
    <div class="row">

        <!-- Conditions -->
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body p-4">

                    <h5 class="fw-bold mb-3">Known Conditions</h5>

                    @if (Model.Conditions.Any())
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var condition in Model.Conditions)
                            {
                                <li class="list-group-item px-0">
                                    @condition
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted mb-0">
                            No conditions recorded.
                        </p>
                    }

                </div>
            </div>
        </div>

        <!-- Allergies -->
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body p-4">

                    <h5 class="fw-bold mb-3">Allergies</h5>

                    @if (Model.Allergies.Any())
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var allergy in Model.Allergies)
                            {
                                <li class="list-group-item px-0">
                                    @allergy
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted mb-0">
                            No allergies recorded.
                        </p>
                    }

                </div>
            </div>
        </div>

        <!-- Medications -->
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body p-4">

                    <h5 class="fw-bold mb-3">Medications</h5>

                    @if (Model.Medications.Any())
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var medication in Model.Medications)
                            {
                                <li class="list-group-item px-0">
                                    @medication
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted mb-0">
                            No medications recorded.
                        </p>
                    }

                </div>
            </div>
        </div>

    </div>

    <!-- Edit History -->
    <div class="mt-2">
        <a asp-controller="Doctor"
           asp-action="EditPatientHistory"
           asp-route-patientId="@Model.PatientId"
           class="btn btn-primary px-4">
            Edit Medical History
        </a>
    </div>

</div>

<style>
    .card {
        border-radius: 12px;
    }

    .list-group-item {
        border: none;
        border-bottom: 1px solid #eee;
    }

        .list-group-item:last-child {
            border-bottom: none;
        }

    .btn-primary {
        background-color: #2c7da0;
        border-color: #2c7da0;
    }

        .btn-primary:hover {
            background-color: #1f5068;
            border-color: #1f5068;
        }
</style>
```
