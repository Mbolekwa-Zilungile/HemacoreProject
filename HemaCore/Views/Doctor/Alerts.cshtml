@model HemaCore.ViewModels.DoctorViewModels.AlertsViewModel

@{
    Layout = "~/Views/Shared/_DoctorLayout.cshtml";
    ViewBag.Title = "Alerts";
}

<link rel="stylesheet" href="~/css/doctor.css" />

<style>
    .alerts-page {
        max-width: 1400px;
        margin: 0 auto;
        padding-bottom: 2rem;
    }

    .alerts-header {
        margin-bottom: 1.5rem;
    }

        .alerts-header h2 {
            color: #1e293b;
            font-weight: 700;
            margin-bottom: .35rem;
        }

            .alerts-header h2 i {
                color: #2c7da0;
                margin-right: 8px;
            }

        .alerts-header p {
            color: #64748b;
            margin: 0;
        }

    .filter-bar {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 1.1rem 1.25rem;
        margin-bottom: 1.25rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        box-shadow: 0 2px 6px rgba(0,0,0,.04);
    }

    .filter-heading {
        color: #1e293b;
        font-size: .95rem;
        font-weight: 700;
        margin-bottom: .65rem;
    }

    .filter-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .filter-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #dbe3e8;
        background: #f8fafc;
        color: #475569;
        padding: 8px 14px;
        border-radius: 8px;
        font-size: .85rem;
        font-weight: 600;
        text-decoration: none;
        transition: .2s ease;
    }

        .filter-btn:hover {
            background: #eef6f9;
            color: #1f5068;
            border-color: #61a5c2;
        }

        .filter-btn.active {
            background: #2c7da0;
            color: #fff;
            border-color: #2c7da0;
        }

    .date-range-form {
        display: grid;
        grid-template-columns: minmax(160px, 1fr) minmax(160px, 1fr) auto auto;
        gap: 12px;
        align-items: end;
        padding: 1rem;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
    }

    .date-field label {
        display: block;
        color: #334155;
        font-size: .82rem;
        font-weight: 700;
        margin-bottom: 6px;
    }

    .date-field input {
        width: 100%;
        min-height: 42px;
        padding: 8px 10px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        background: #fff;
        color: #1e293b;
        outline: none;
    }

        .date-field input:focus {
            border-color: #2c7da0;
            box-shadow: 0 0 0 3px rgba(44,125,160,.12);
        }

    .btn-apply-date,
    .btn-clear-date,
    .btn-outline-custom {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        min-height: 42px;
        padding: 9px 14px;
        border-radius: 8px;
        font-size: .85rem;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        white-space: nowrap;
        transition: .2s ease;
    }

    .btn-apply-date {
        background: #2c7da0;
        color: #fff;
        border: 1px solid #2c7da0;
    }

        .btn-apply-date:hover {
            background: #1f5068;
            border-color: #1f5068;
        }

    .btn-clear-date {
        background: #fff;
        color: #475569;
        border: 1px solid #cbd5e1;
    }

        .btn-clear-date:hover {
            background: #f1f5f9;
            color: #1e293b;
        }

    .btn-outline-custom {
        background: #fff;
        color: #2c7da0;
        border: 1px solid #2c7da0;
    }

        .btn-outline-custom:hover {
            background: #2c7da0;
            color: #fff;
        }

    .filter-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 10px;
    }

    .alerts-stats-row {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 1.5rem;
    }

    .alert-stat-chip {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 14px;
        border-radius: 20px;
        font-size: .85rem;
        font-weight: 600;
    }

        .alert-stat-chip.total {
            background: #eef6f9;
            color: #1f5068;
        }

        .alert-stat-chip.unread {
            background: #fff1f2;
            color: #be123c;
        }

        .alert-stat-chip.allread {
            background: #ecfdf5;
            color: #047857;
        }

    .alert-card {
        background: #fff;
        border-radius: 15px;
        border: 1px solid #e2e8f0;
        margin-bottom: 1rem;
        overflow: hidden;
        box-shadow: 0 2px 6px rgba(0,0,0,.04);
        transition: .2s ease;
    }

        .alert-card:hover {
            box-shadow: 0 6px 16px rgba(0,0,0,.07);
            transform: translateY(-1px);
        }

        .alert-card.unread {
            border-left: 4px solid #dc3545;
        }

        .alert-card.read {
            border-left: 4px solid #cbd5e1;
        }

    .alert-header {
        padding: 1.1rem 1.25rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        border-bottom: 1px solid #f1f5f9;
    }

    .alert-title {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
    }

    .alert-icon-wrap {
        width: 42px;
        height: 42px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .alert-icon-wrap.unread {
            background: #fee2e2;
            color: #dc2626;
        }

        .alert-icon-wrap.read {
            background: #f1f5f9;
            color: #64748b;
        }

    .alert-title-text {
        display: flex;
        flex-direction: column;
        gap: 3px;
        min-width: 0;
    }

        .alert-title-text strong {
            color: #1e293b;
            font-size: .95rem;
            overflow-wrap: anywhere;
        }

        .alert-title-text span {
            color: #64748b;
            font-size: .85rem;
        }

    .alert-header-right {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        flex-wrap: wrap;
        gap: 12px;
    }

    .alert-date {
        color: #64748b;
        white-space: nowrap;
    }

    .mark-read-btn {
        border: none;
        background: #ecfdf5;
        color: #047857;
        padding: 7px 11px;
        border-radius: 7px;
        font-size: .8rem;
        font-weight: 600;
        cursor: pointer;
    }

        .mark-read-btn:hover {
            background: #d1fae5;
        }

    .read-indicator {
        color: #64748b;
        font-size: .8rem;
        font-weight: 600;
        white-space: nowrap;
    }

        .read-indicator i {
            color: #16a34a;
            margin-right: 4px;
        }

    .alert-body {
        padding: 1.25rem;
        display: flex;
        align-items: center;
        gap: 1.5rem;
    }

    .result-block {
        flex: 1;
        min-width: 0;
    }

    .result-block-label {
        color: #64748b;
        font-size: .75rem;
        font-weight: 600;
        text-transform: uppercase;
        margin-bottom: 5px;
    }

    .result-block-value {
        font-size: 1.15rem;
        font-weight: 700;
        overflow-wrap: anywhere;
    }

        .result-block-value.abnormal {
            color: #dc2626;
        }

        .result-block-value.normal {
            color: #1f5068;
        }

    .result-unit {
        font-size: .8rem;
        font-weight: 500;
        color: #64748b;
        margin-left: 4px;
    }

    .result-divider {
        color: #cbd5e1;
        font-size: 1rem;
    }

    .alert-message-row {
        background: #f8fafc;
        border-top: 1px solid #f1f5f9;
        padding: .9rem 1.25rem;
        display: flex;
        align-items: flex-start;
        gap: 10px;
        color: #475569;
        font-size: .85rem;
        overflow-wrap: anywhere;
    }

        .alert-message-row i {
            color: #2c7da0;
            margin-top: 2px;
        }

    .alert-footer {
        padding: .8rem 1.25rem;
        border-top: 1px solid #f1f5f9;
        display: flex;
        justify-content: flex-end;
    }

    .empty-state {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 4rem 2rem;
        text-align: center;
        box-shadow: 0 2px 6px rgba(0,0,0,.04);
    }

    .empty-icon {
        width: 70px;
        height: 70px;
        margin: 0 auto 1rem;
        border-radius: 50%;
        background: #eef6f9;
        color: #2c7da0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.7rem;
    }

    .empty-state h3 {
        color: #1e293b;
        font-weight: 700;
    }

    .empty-state p {
        color: #64748b;
        margin-bottom: 1.5rem;
    }

    .btn-primary-custom {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #2c7da0;
        color: #fff;
        padding: 10px 16px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        border: none;
    }

        .btn-primary-custom:hover {
            background: #1f5068;
            color: #fff;
        }

    .legend {
        display: flex;
        gap: 1.5rem;
        margin-top: 1.5rem;
        padding: .75rem 0;
    }

    .legend-item {
        display: flex;
        align-items: center;
        gap: 7px;
        color: #64748b;
        font-size: .8rem;
    }

    .legend-color {
        width: 10px;
        height: 10px;
        border-radius: 50%;
    }

    .unread-badge {
        background: #dc3545;
    }

    .read-badge {
        background: #cbd5e1;
    }

    @@media (max-width: 900px) {
        .date-range-form {
            grid-template-columns: 1fr 1fr;
        }

        .filter-actions {
            justify-content: flex-start;
        }
    }

    @@media (max-width: 768px) {
        .filter-buttons {
            width: 100%;
        }

        .filter-btn {
            flex: 1 1 auto;
        }

        .date-range-form {
            grid-template-columns: 1fr;
        }

        .filter-actions {
            display: grid;
            grid-template-columns: 1fr;
        }

            .filter-actions button,
            .filter-actions a,
            .filter-actions form {
                width: 100%;
            }

                .filter-actions form button {
                    width: 100%;
                }

        .alert-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .alert-header-right {
            width: 100%;
            justify-content: space-between;
        }

        .alert-body {
            flex-direction: column;
            align-items: stretch;
            gap: 1rem;
        }

        .result-divider {
            display: none;
        }

        .legend {
            flex-direction: column;
            gap: 8px;
        }
    }

    @@media (max-width: 420px) {
        .alerts-header h2 {
            font-size: 1.35rem;
        }

        .filter-bar {
            padding: .9rem;
        }

        .alert-header,
        .alert-body,
        .alert-message-row,
        .alert-footer {
            padding-left: .9rem;
            padding-right: .9rem;
        }

        .alert-header-right {
            align-items: flex-start;
            flex-direction: column;
        }

        .empty-state {
            padding: 2.5rem 1rem;
        }
    }
</style>

<div class="alerts-page fade-in">

    <div class="alerts-header">
        <h2>
            <i class="fas fa-bell"></i>
            Abnormal Results Alerts
        </h2>
        <p>Review abnormal test results from your patients and filter alerts by date.</p>
    </div>

    <div class="filter-bar">

        <div>
            <div class="filter-heading">
                <i class="fas fa-calendar-alt me-1"></i>
                Quick date filters
            </div>

            <div class="filter-buttons">
                <a asp-controller="Doctor"
                   asp-action="Alerts"
                   asp-route-days="5"
                   class="filter-btn @(Model.SelectedDays == 5 ? "active" : "")">
                    Last 5 Days
                </a>

                <a asp-controller="Doctor"
                   asp-action="Alerts"
                   asp-route-days="10"
                   class="filter-btn @(Model.SelectedDays == 10 ? "active" : "")">
                    Last 10 Days
                </a>

                <a asp-controller="Doctor"
                   asp-action="Alerts"
                   asp-route-days="30"
                   class="filter-btn @(Model.SelectedDays == 30 ? "active" : "")">
                    Last 30 Days
                </a>

                <a asp-controller="Doctor"
                   asp-action="Alerts"
                   asp-route-days="90"
                   class="filter-btn @(Model.SelectedDays == 90 ? "active" : "")">
                    Last 90 Days
                </a>

                <a asp-controller="Doctor"
                   asp-action="Alerts"
                   asp-route-days="365"
                   class="filter-btn @(Model.SelectedDays == 365 ? "active" : "")">
                    Last 365 Days
                </a>
            </div>
        </div>

        <div>
            <div class="filter-heading">
                <i class="fas fa-calendar-week me-1"></i>
                Custom date range
            </div>

            <form asp-controller="Doctor"
                  asp-action="Alerts"
                  method="get"
                  class="date-range-form"
                  id="dateRangeForm">

                <div class="date-field">
                    <label for="startDate">From date</label>
                    <input type="date"
                           id="startDate"
                           name="startDate"
                           value="@Context.Request.Query["startDate"]"
                           required />
                </div>

                <div class="date-field">
                    <label for="endDate">To date</label>
                    <input type="date"
                           id="endDate"
                           name="endDate"
                           value="@Context.Request.Query["endDate"]"
                           required />
                </div>

                <div class="filter-actions">
                    <button type="submit" class="btn-apply-date">
                        <i class="fas fa-filter"></i>
                        Apply Dates
                    </button>
                </div>

                <div class="filter-actions">
                    <a asp-controller="Doctor"
                       asp-action="Alerts"
                       class="btn-clear-date">
                        <i class="fas fa-times"></i>
                        Clear Dates
                    </a>
                </div>
            </form>
        </div>

        @if (Model.UnreadCount > 0)
        {
            <div class="filter-actions">
                <form asp-controller="Doctor"
                      asp-action="MarkAllAlertsAsRead"
                      method="post">
                    @Html.AntiForgeryToken()

                    <button type="submit" class="btn-outline-custom">
                        <i class="fas fa-check-double"></i>
                        Mark All as Read (@Model.UnreadCount)
                    </button>
                </form>
            </div>
        }
    </div>

    <div class="alerts-stats-row">
        <div class="alert-stat-chip total">
            <i class="fas fa-list"></i>
            <span>
                @Model.Alerts.Count
                alert@(Model.Alerts.Count == 1 ? "" : "s") found
            </span>
        </div>

        @if (Model.UnreadCount > 0)
        {
            <div class="alert-stat-chip unread">
                <i class="fas fa-exclamation-circle"></i>
                <span>@Model.UnreadCount unread</span>
            </div>
        }
        else if (Model.Alerts.Any())
        {
            <div class="alert-stat-chip allread">
                <i class="fas fa-check-circle"></i>
                <span>All caught up</span>
            </div>
        }
    </div>

    @if (!Model.Alerts.Any())
    {
        <div class="empty-state">
            <div class="empty-icon">
                <i class="fas fa-bell-slash"></i>
            </div>

            <h3>No Alerts</h3>

            <p>
                No abnormal results were found for the selected date period.
                Try choosing a different date range.
            </p>

            <a asp-controller="Doctor"
               asp-action="Index"
               class="btn-primary-custom">
                <i class="fas fa-home"></i>
                Return to Dashboard
            </a>
        </div>
    }
    else
    {
        @foreach (var alert in Model.Alerts)
        {
            <div class="alert-card @(alert.IsRead ? "read" : "unread")">

                <div class="alert-header">
                    <div class="alert-title">
                        <div class="alert-icon-wrap @(alert.IsRead ? "read" : "unread")">
                            <i class="fas fa-exclamation-triangle"></i>
                        </div>

                        <div class="alert-title-text">
                            <strong>@alert.TestName</strong>
                            <span>@alert.PatientName</span>
                        </div>
                    </div>

                    <div class="alert-header-right">
                        <small class="alert-date">
                            <i class="fas fa-clock"></i>
                            @alert.CreatedDateTime.ToString("dd MMM yyyy, HH:mm")
                        </small>

                        @if (!alert.IsRead)
                        {
                            <form asp-controller="Doctor"
                                  asp-action="MarkAlertAsRead"
                                  method="post">
                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="alertId"
                                       value="@alert.AlertId" />

                                <button type="submit" class="mark-read-btn">
                                    <i class="fas fa-check"></i>
                                    Mark Read
                                </button>
                            </form>
                        }
                        else
                        {
                            <span class="read-indicator">
                                <i class="fas fa-check-circle"></i>
                                Read
                            </span>
                        }
                    </div>
                </div>

                <div class="alert-body">
                    <div class="result-block">
                        <div class="result-block-label">Abnormal Result</div>
                        <div class="result-block-value abnormal">
                            @(alert.ResultValue?.ToString("G") ?? "N/A")

                            @if (!string.IsNullOrWhiteSpace(alert.UnitOfMeasurement))
                            {
                                <span class="result-unit">@alert.UnitOfMeasurement</span>
                            }
                        </div>
                    </div>

                    <div class="result-divider">
                        <i class="fas fa-arrows-alt-h"></i>
                    </div>

                    <div class="result-block">
                        <div class="result-block-label">Normal Range</div>
                        <div class="result-block-value normal">
                            @(alert.NormalRangeMin?.ToString("G") ?? "?")
                            –
                            @(alert.NormalRangeMax?.ToString("G") ?? "?")

                            @if (!string.IsNullOrWhiteSpace(alert.UnitOfMeasurement))
                            {
                                <span class="result-unit">@alert.UnitOfMeasurement</span>
                            }
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(alert.Message))
                {
                    <div class="alert-message-row">
                        <i class="fas fa-comment-medical"></i>
                        <span>@alert.Message</span>
                    </div>
                }

                <div class="alert-footer">
                    <span class="text-muted small">
                        <i class="fas fa-info-circle me-1"></i>
                        Abnormal laboratory result
                    </span>
                </div>
            </div>
        }

        <div class="legend">
            <div class="legend-item">
                <div class="legend-color unread-badge"></div>
                <span>Unread Alert</span>
            </div>

            <div class="legend-item">
                <div class="legend-color read-badge"></div>
                <span>Read Alert</span>
            </div>
        </div>
    }
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const form = document.getElementById("dateRangeForm");
        const startDate = document.getElementById("startDate");
        const endDate = document.getElementById("endDate");

        if (!form || !startDate || !endDate) {
            return;
        }

        startDate.addEventListener("change", function () {
            endDate.min = startDate.value;

            if (endDate.value && endDate.value < startDate.value) {
                endDate.value = "";
            }
        });

        endDate.addEventListener("change", function () {
            startDate.max = endDate.value;

            if (startDate.value && startDate.value > endDate.value) {
                startDate.value = "";
            }
        });

        form.addEventListener("submit", function (event) {
            if (startDate.value && endDate.value &&
                startDate.value > endDate.value) {
                event.preventDefault();
                alert("The start date cannot be after the end date.");
                startDate.focus();
            }
        });

        if (startDate.value) {
            endDate.min = startDate.value;
        }

        if (endDate.value) {
            startDate.max = endDate.value;
        }
    });
</script>