@model HemaCore.ViewModels.DoctorViewModels.AlertsViewModel

@{
    Layout = "~/Views/Shared/_DoctorLayout.cshtml";
    ViewBag.Title = "Alerts";
}

<link rel="stylesheet" href="~/css/doctor.css" />

<style>

    .alerts-page {
        max-width: 1400px;
        margin: 0 auto;
    }

    /* PAGE HEADER */
    .alerts-header {
        margin-bottom: 1.5rem;
    }

        .alerts-header h2 {
            color: #1e293b;
            font-weight: 700;
            margin-bottom: 0.35rem;
        }

            .alerts-header h2 i {
                color: #2c7da0;
                margin-right: 8px;
            }

        .alerts-header p {
            color: #64748b;
            margin: 0;
        }

    /* FILTER BAR */
    .filter-bar {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 1rem 1.25rem;
        margin-bottom: 1.25rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        box-shadow: 0 2px 6px rgba(0,0,0,0.04);
    }

    .filter-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .filter-btn {
        border: 1px solid #dbe3e8;
        background: #f8fafc;
        color: #475569;
        padding: 8px 14px;
        border-radius: 8px;
        font-size: 0.85rem;
        font-weight: 600;
        text-decoration: none;
        transition: 0.2s ease;
    }

        .filter-btn:hover {
            background: #eef6f9;
            color: #1f5068;
            border-color: #61a5c2;
        }

        .filter-btn.active {
            background: #2c7da0;
            color: white;
            border-color: #2c7da0;
        }

    .btn-outline-custom {
        border: 1px solid #2c7da0;
        background: white;
        color: #2c7da0;
        padding: 8px 14px;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.85rem;
        transition: 0.2s ease;
        white-space: nowrap;
    }

        .btn-outline-custom:hover {
            background: #2c7da0;
            color: white;
        }

    /* STAT CHIPS */
    .alerts-stats-row {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 1.5rem;
    }

    .alert-stat-chip {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 14px;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
    }

        .alert-stat-chip.total {
            background: #eef6f9;
            color: #1f5068;
        }

        .alert-stat-chip.unread {
            background: #fff1f2;
            color: #be123c;
        }

        .alert-stat-chip.allread {
            background: #ecfdf5;
            color: #047857;
        }

    /* ALERT CARD */
    .alert-card {
        background: #ffffff;
        border-radius: 15px;
        border: 1px solid #e2e8f0;
        margin-bottom: 1rem;
        overflow: hidden;
        box-shadow: 0 2px 6px rgba(0,0,0,0.04);
        transition: 0.2s ease;
    }

        .alert-card:hover {
            box-shadow: 0 6px 16px rgba(0,0,0,0.07);
            transform: translateY(-1px);
        }

        .alert-card.unread {
            border-left: 4px solid #dc3545;
        }

        .alert-card.read {
            border-left: 4px solid #cbd5e1;
        }

    /* ALERT HEADER */
    .alert-header {
        padding: 1.1rem 1.25rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        border-bottom: 1px solid #f1f5f9;
    }

    .alert-title {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .alert-icon-wrap {
        width: 42px;
        height: 42px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .alert-icon-wrap.unread {
            background: #fee2e2;
            color: #dc2626;
        }

        .alert-icon-wrap.read {
            background: #f1f5f9;
            color: #64748b;
        }

    .alert-title-text {
        display: flex;
        flex-direction: column;
        gap: 3px;
    }

        .alert-title-text strong {
            color: #1e293b;
            font-size: 0.95rem;
        }

        .alert-title-text span {
            color: #64748b;
            font-size: 0.85rem;
        }

    .alert-header-right {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .alert-date {
        color: #64748b;
        white-space: nowrap;
    }

        .alert-date i {
            margin-right: 4px;
        }

    .mark-read-btn {
        border: none;
        background: #ecfdf5;
        color: #047857;
        padding: 7px 11px;
        border-radius: 7px;
        font-size: 0.8rem;
        font-weight: 600;
        cursor: pointer;
    }

        .mark-read-btn:hover {
            background: #d1fae5;
        }

    .read-indicator {
        color: #64748b;
        font-size: 0.8rem;
        font-weight: 600;
        white-space: nowrap;
    }

        .read-indicator i {
            color: #16a34a;
            margin-right: 4px;
        }

    /* RESULT SECTION */
    .alert-body {
        padding: 1.25rem;
        display: flex;
        align-items: center;
        gap: 1.5rem;
    }

    .result-block {
        flex: 1;
    }

    .result-block-label {
        color: #64748b;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        margin-bottom: 5px;
    }

    .result-block-value {
        font-size: 1.15rem;
        font-weight: 700;
    }

        .result-block-value.abnormal {
            color: #dc2626;
        }

        .result-block-value.normal {
            color: #1f5068;
        }

    .result-unit {
        font-size: 0.8rem;
        font-weight: 500;
        color: #64748b;
        margin-left: 4px;
    }

    .result-divider {
        color: #cbd5e1;
        font-size: 1rem;
    }

    /* MESSAGE */
    .alert-message-row {
        background: #f8fafc;
        border-top: 1px solid #f1f5f9;
        padding: 0.9rem 1.25rem;
        display: flex;
        align-items: flex-start;
        gap: 10px;
        color: #475569;
        font-size: 0.85rem;
    }

        .alert-message-row i {
            color: #2c7da0;
            margin-top: 2px;
        }

    /* FOOTER */
    .alert-footer {
        padding: 0.8rem 1.25rem;
        border-top: 1px solid #f1f5f9;
        display: flex;
        justify-content: flex-end;
    }

    .action-link {
        color: #2c7da0;
        text-decoration: none;
        font-size: 0.85rem;
        font-weight: 600;
    }

        .action-link:hover {
            color: #1f5068;
            text-decoration: underline;
        }

    /* EMPTY STATE */
    .empty-state {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 4rem 2rem;
        text-align: center;
        box-shadow: 0 2px 6px rgba(0,0,0,0.04);
    }

    .empty-icon {
        width: 70px;
        height: 70px;
        margin: 0 auto 1rem;
        border-radius: 50%;
        background: #eef6f9;
        color: #2c7da0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.7rem;
    }

    .empty-state h3 {
        color: #1e293b;
        font-weight: 700;
    }

    .empty-state p {
        color: #64748b;
        margin-bottom: 1.5rem;
    }

    .btn-primary-custom {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #2c7da0;
        color: white;
        padding: 10px 16px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        border: none;
    }

        .btn-primary-custom:hover {
            background: #1f5068;
            color: white;
        }

    /* LEGEND */
    .legend {
        display: flex;
        gap: 1.5rem;
        margin-top: 1.5rem;
        padding: 0.75rem 0;
    }

    .legend-item {
        display: flex;
        align-items: center;
        gap: 7px;
        color: #64748b;
        font-size: 0.8rem;
    }

    .legend-color {
        width: 10px;
        height: 10px;
        border-radius: 50%;
    }

    .unread-badge {
        background: #dc3545;
    }

    .read-badge {
        background: #cbd5e1;
    }

    /* MOBILE */
    @@media (max-width: 768px) {

        .filter-bar {
            flex-direction: column;
            align-items: stretch;
        }

        .filter-buttons {
            width: 100%;
        }

        .btn-outline-custom {
            width: 100%;
        }

        .alert-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .alert-header-right {
            width: 100%;
            justify-content: space-between;
        }

        .alert-body {
            flex-direction: column;
            align-items: stretch;
            gap: 1rem;
        }

        .result-divider {
            display: none;
        }

        .legend {
            flex-direction: column;
            gap: 8px;
        }
    }

</style>


<div class="alerts-page fade-in">

    <!-- PAGE HEADER -->
    <div class="alerts-header">

        <h2>
            <i class="fas fa-bell"></i>
            Abnormal Results Alerts
        </h2>

        <p>
            Review abnormal test results from your patients.
        </p>

    </div>


    <!-- FILTER BAR -->
    <div class="filter-bar">

        <div class="filter-buttons">

            <a asp-controller="Doctor"
               asp-action="Alerts"
               asp-route-days="5"
               class="filter-btn @(Model.SelectedDays == 5 ? "active" : "")">
                Last 5 Days
            </a>

            <a asp-controller="Doctor"
               asp-action="Alerts"
               asp-route-days="10"
               class="filter-btn @(Model.SelectedDays == 10 ? "active" : "")">
                Last 10 Days
            </a>

            <a asp-controller="Doctor"
               asp-action="Alerts"
               asp-route-days="30"
               class="filter-btn @(Model.SelectedDays == 30 ? "active" : "")">
                Last 30 Days
            </a>

            <a asp-controller="Doctor"
               asp-action="Alerts"
               asp-route-days="90"
               class="filter-btn @(Model.SelectedDays == 90 ? "active" : "")">
                Last 90 Days
            </a>

            <a asp-controller="Doctor"
               asp-action="Alerts"
               asp-route-days="365"
               class="filter-btn @(Model.SelectedDays == 365 ? "active" : "")">
                All Time
            </a>

        </div>


        @if (Model.UnreadCount > 0)
        {
            <form asp-controller="Doctor"
                  asp-action="MarkAllAlertsAsRead"
                  method="post">

                @Html.AntiForgeryToken()

                <button type="submit" class="btn-outline-custom">
                    <i class="fas fa-check-double"></i>
                    Mark All as Read (@Model.UnreadCount)
                </button>

            </form>
        }

    </div>


    <!-- STAT CHIPS -->
    <div class="alerts-stats-row">

        <div class="alert-stat-chip total">

            <i class="fas fa-list"></i>

            <span>
                @Model.Alerts.Count
                alert@(Model.Alerts.Count == 1 ? "" : "s") found
            </span>

        </div>


        @if (Model.UnreadCount > 0)
        {
            <div class="alert-stat-chip unread">

                <i class="fas fa-exclamation-circle"></i>

                <span>
                    @Model.UnreadCount unread
                </span>

            </div>
        }
        else if (Model.Alerts.Any())
        {
            <div class="alert-stat-chip allread">

                <i class="fas fa-check-circle"></i>

                <span>
                    All caught up
                </span>

            </div>
        }

    </div>


    <!-- EMPTY STATE -->
    @if (!Model.Alerts.Any())
    {
        <div class="empty-state">

            <div class="empty-icon">
                <i class="fas fa-bell-slash"></i>
            </div>

            <h3>No Alerts</h3>

            <p>
                No abnormal results were found in the selected time period.
            </p>

            <a asp-controller="Doctor"
               asp-action="Index"
               class="btn-primary-custom">

                <i class="fas fa-home"></i>
                Return to Dashboard

            </a>

        </div>
    }
    else
    {
        <!-- ALERT CARDS -->
        foreach (var alert in Model.Alerts)
        {
            <div class="alert-card @(alert.IsRead ? "read" : "unread")">

                <!-- HEADER -->
                <div class="alert-header">

                    <div class="alert-title">

                        <div class="alert-icon-wrap @(alert.IsRead ? "read" : "unread")">

                            <i class="fas fa-exclamation-triangle"></i>

                        </div>

                        <div class="alert-title-text">

                            <strong>
                                @alert.TestName
                            </strong>

                            <span>
                                @alert.PatientName
                            </span>

                        </div>

                    </div>


                    <div class="alert-header-right">

                        <small class="alert-date">

                            <i class="fas fa-clock"></i>

                            @alert.CreatedDateTime.ToString("dd MMM yyyy, HH:mm")

                        </small>


                        @if (!alert.IsRead)
                        {
                            <form asp-controller="Doctor"
                                  asp-action="MarkAlertAsRead"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="alertId"
                                       value="@alert.AlertId" />

                                <button type="submit"
                                        class="mark-read-btn">

                                    <i class="fas fa-check"></i>
                                    Mark Read

                                </button>

                            </form>
                        }
                        else
                        {
                            <span class="read-indicator">

                                <i class="fas fa-check-circle"></i>
                                Read

                            </span>
                        }

                    </div>

                </div>


                <!-- RESULT -->
                <div class="alert-body">

                    <div class="result-block">

                        <div class="result-block-label">
                            Abnormal Result
                        </div>

                        <div class="result-block-value abnormal">

                            @(alert.ResultValue?.ToString("G") ?? "N/A")

                            @if (!string.IsNullOrWhiteSpace(alert.UnitOfMeasurement))
                            {
                                <span class="result-unit">
                                    @alert.UnitOfMeasurement
                                </span>
                            }

                        </div>

                    </div>


                    <div class="result-divider">
                        <i class="fas fa-arrows-alt-h"></i>
                    </div>


                    <div class="result-block">

                        <div class="result-block-label">
                            Normal Range
                        </div>

                        <div class="result-block-value normal">

                            @(alert.NormalRangeMin?.ToString("G") ?? "?")
                            –
                            @(alert.NormalRangeMax?.ToString("G") ?? "?")

                            @if (!string.IsNullOrWhiteSpace(alert.UnitOfMeasurement))
                            {
                                <span class="result-unit">
                                    @alert.UnitOfMeasurement
                                </span>
                            }

                        </div>

                    </div>

                </div>


                <!-- MESSAGE -->
                @if (!string.IsNullOrWhiteSpace(alert.Message))
                {
                    <div class="alert-message-row">

                        <i class="fas fa-comment-medical"></i>

                        <span>
                            @alert.Message
                        </span>

                    </div>
                }


                <!-- FOOTER -->
                <div class="alert-footer">

                    <span class="text-muted small">
                        <i class="fas fa-info-circle me-1"></i>
                        Abnormal laboratory result
                    </span>

                </div>

            </div>
        }


        <!-- LEGEND -->
        <div class="legend">

            <div class="legend-item">

                <div class="legend-color unread-badge"></div>

                <span>
                    Unread Alert
                </span>

            </div>

            <div class="legend-item">

                <div class="legend-color read-badge"></div>

                <span>
                    Read Alert
                </span>

            </div>

        </div>

    }

</div>