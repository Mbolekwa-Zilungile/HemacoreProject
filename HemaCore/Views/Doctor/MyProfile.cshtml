@model HemaCore.ViewModels.DoctorViewModels.DoctorProfileViewModel

@{
    ViewBag.Title = "My Profile";
    Layout = "~/Views/Shared/_DoctorLayout.cshtml";
}

<style>
    .profile-page-container {
        max-width: 80%;
        margin: 0 100px;
        padding-top: 30px;
    }

    .profile-card {
        background: white;
        border-radius: 20px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.08);
        overflow: hidden;
    }

    .profile-header {
        background: linear-gradient(135deg, #185FA5 0%, #0C447C 100%);
        padding: 40px;
        text-align: center;
        position: relative;
    }

    .profile-picture-wrapper {
        position: relative;
        display: inline-block;
        margin-bottom: 16px;
    }

    .profile-picture {
        width: 130px;
        height: 130px;
        border-radius: 50%;
        object-fit: cover;
        border: 4px solid white;
        box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        background: #e9ecef;
    }

    .edit-photo-btn {
        position: absolute;
        bottom: 5px;
        right: 5px;
        background: white;
        border: none;
        color: #185FA5;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s;
        box-shadow: 0 2px 8px rgba(0,0,0,0.15);
    }

        .edit-photo-btn:hover {
            background: #185FA5;
            color: white;
            transform: scale(1.05);
        }

    .profile-name {
        color: white;
        font-size: 1.6rem;
        margin-bottom: 5px;
        font-weight: 600;
    }

    .profile-role {
        color: rgba(255,255,255,0.9);
        margin-bottom: 0;
        font-size: 0.9rem;
    }

    .profile-badges {
        display: flex;
        justify-content: center;
        gap: 12px;
        margin-top: 14px;
        flex-wrap: wrap;
    }

    .profile-badge {
        background: rgba(255,255,255,0.15);
        border: 1px solid rgba(255,255,255,0.3);
        color: white;
        border-radius: 20px;
        padding: 4px 14px;
        font-size: 0.78rem;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .info-section {
        padding: 24px;
        border-bottom: 1px solid #e9ecef;
    }

        .info-section:last-child {
            border-bottom: none;
        }

    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    .section-title {
        font-size: 1.1rem;
        font-weight: 600;
        color: #2c3e50;
        margin: 0;
    }

        .section-title i {
            color: #185FA5;
            margin-right: 8px;
        }

    .edit-toggle-btn {
        background: none;
        border: none;
        color: #185FA5;
        cursor: pointer;
        font-size: 0.85rem;
        padding: 6px 14px;
        border-radius: 20px;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .edit-toggle-btn:hover {
            background: #e8f0fb;
        }

        .edit-toggle-btn:disabled {
            opacity: 0.4;
            cursor: default;
        }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 24px;
    }

    .info-grid-3 {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 24px;
    }

    .info-field {
        display: flex;
        flex-direction: column;
    }

    .info-label {
        font-size: 0.7rem;
        text-transform: uppercase;
        color: #6c757d;
        margin-bottom: 6px;
        letter-spacing: 0.5px;
        font-weight: 600;
    }

    .info-value {
        font-size: 1rem;
        color: #2c3e50;
        font-weight: 500;
        padding: 8px 0;
        border-bottom: 1px solid #e9ecef;
    }

    .info-input {
        padding: 10px 12px;
        border: 1px solid #ced4da;
        border-radius: 8px;
        font-size: 0.95rem;
        width: 100%;
        transition: all 0.2s;
    }

        .info-input:focus {
            outline: none;
            border-color: #185FA5;
            box-shadow: 0 0 0 2px rgba(24,95,165,0.1);
        }

        .info-input[type="password"] {
            letter-spacing: 3px;
        }

    .action-buttons {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 20px;
        padding-top: 16px;
        border-top: 1px solid #e9ecef;
    }

    .btn-save {
        background: #28a745;
        color: white;
        border: none;
        padding: 10px 24px;
        border-radius: 8px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s;
    }

        .btn-save:hover {
            background: #218838;
        }

    .btn-cancel {
        background: #6c757d;
        color: white;
        border: none;
        padding: 10px 24px;
        border-radius: 8px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s;
    }

        .btn-cancel:hover {
            background: #5a6268;
        }

    .profile-alert {
        margin: 20px 24px 0;
        padding: 12px 16px;
        border-radius: 8px;
        font-size: 0.9rem;
    }

    .profile-alert-success {
        background: #e6f7ec;
        color: #1e7e34;
        border: 1px solid #c3e6cb;
    }

    .profile-alert-error {
        background: #fdecea;
        color: #a71d2a;
        border: 1px solid #f5c6cb;
    }

    .photo-modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.6);
        display: none;
        justify-content: center;
        align-items: center;
        z-index: 10000;
    }

    .photo-modal {
        background: white;
        border-radius: 16px;
        width: 450px;
        max-width: 90%;
        overflow: hidden;
    }

    .photo-modal-header {
        background: #185FA5;
        color: white;
        padding: 15px 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .photo-modal-header h5 {
            margin: 0;
            font-weight: 600;
        }

    .photo-modal-close {
        background: none;
        border: none;
        color: white;
        font-size: 24px;
        cursor: pointer;
    }

    .photo-modal-body {
        padding: 20px;
        text-align: center;
    }

    .photo-preview {
        width: 150px;
        height: 150px;
        border-radius: 50%;
        object-fit: cover;
        margin-bottom: 20px;
        border: 3px solid #185FA5;
    }

    .photo-modal-footer {
        padding: 15px 20px;
        border-top: 1px solid #e9ecef;
        display: flex;
        justify-content: flex-end;
        gap: 10px;
    }

    @@media (max-width: 768px) {
        .info-grid, .info-grid-3 {
            grid-template-columns: 1fr;
            gap: 16px;
        }

        .profile-header {
            padding: 30px 20px;
        }

        .profile-picture {
            width: 100px;
            height: 100px;
        }

        .info-section {
            padding: 20px;
        }
    }
</style>

<div class="container-fluid profile-page-container">

    @if (TempData["Success"] != null)
    {
        <div class="profile-alert profile-alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="profile-alert profile-alert-error">@TempData["Error"]</div>
    }

    <div class="profile-card">

        <!-- HEADER -->
        <div class="profile-header">
            <div class="profile-picture-wrapper">
                <img id="mainProfileImage" class="profile-picture"
                     src="https://ui-avatars.com/api/?background=ffffff&color=185FA5&size=130&name=@(Model.Name)+@(Model.Surname)"
                     alt="Profile Picture">
                <button class="edit-photo-btn" onclick="openPhotoModal()" type="button">
                    <i class="fas fa-camera"></i>
                </button>
            </div>
            <h3 class="profile-name" id="profileName">Dr. @(Model.Name) @(Model.Surname)</h3>
            <p class="profile-role"><i class="fas fa-stethoscope me-1"></i> Medical Doctor</p>
            <div class="profile-badges">
                <span class="profile-badge">
                    <i class="fas fa-id-badge"></i> ID: @(Model.DoctorId)
                </span>
                @if (!string.IsNullOrEmpty(Model.HPCSANumber))
                {
                    <span class="profile-badge">
                        <i class="fas fa-hospital"></i> HPCSA: @(Model.HPCSANumber)
                    </span>
                }
                <span class="profile-badge">
                    <i class="fas fa-envelope"></i> @(Model.Email)
                </span>
            </div>
        </div>

        <!-- PERSONAL INFORMATION -->
        <form method="post" asp-action="UpdatePersonal" asp-controller="Doctor">
            @Html.AntiForgeryToken()
            <div class="info-section">
                <div class="section-header">
                    <h5 class="section-title"><i class="fas fa-user-circle"></i> Personal Information</h5>
                    <button class="edit-toggle-btn" type="button" id="editPersonalBtn" onclick="toggleEdit('personal')">
                        <i class="fas fa-edit"></i> Edit
                    </button>
                </div>

                <div id="personalView" class="info-grid">
                    <div class="info-field">
                        <span class="info-label">First Name</span>
                        <span class="info-value">@(Model.Name)</span>
                    </div>
                    <div class="info-field">
                        <span class="info-label">Last Name</span>
                        <span class="info-value">@(Model.Surname)</span>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.HPCSANumber))
                    {
                        <div class="info-field">
                            <span class="info-label">HPCSA Number</span>
                            <span class="info-value">@(Model.HPCSANumber)</span>
                        </div>
                    }
                </div>

                <div id="personalEdit" style="display:none;" class="info-grid">
                    <div class="info-field">
                        <span class="info-label">First Name</span>
                        <input asp-for="Name" class="info-input">
                    </div>
                    <div class="info-field">
                        <span class="info-label">Last Name</span>
                        <input asp-for="Surname" class="info-input">
                    </div>
                </div>

                <div id="personalActions" style="display:none;" class="action-buttons">
                    <button class="btn-cancel" type="button" onclick="cancelEdit('personal')">Cancel</button>
                    <button class="btn-save" type="submit">Save Changes</button>
                </div>
            </div>
        </form>

        <!-- CONTACT INFORMATION -->
        <form method="post" asp-action="UpdateContact" asp-controller="Doctor">
            @Html.AntiForgeryToken()
            <div class="info-section">
                <div class="section-header">
                    <h5 class="section-title"><i class="fas fa-address-card"></i> Contact Information</h5>
                    <button class="edit-toggle-btn" type="button" id="editContactBtn" onclick="toggleEdit('contact')">
                        <i class="fas fa-edit"></i> Edit
                    </button>
                </div>

                <div id="contactView" class="info-grid">
                    <div class="info-field">
                        <span class="info-label">Email Address</span>
                        <span class="info-value">@(Model.Email)</span>
                    </div>
                    <div class="info-field">
                        <span class="info-label">Phone Number</span>
                        <span class="info-value">@(Model.PhoneNumber ?? "Not set")</span>
                    </div>
                </div>

                <div id="contactEdit" style="display:none;" class="info-grid">
                    <div class="info-field">
                        <span class="info-label">Email Address</span>
                        <span class="info-value">@(Model.Email) <small class="text-muted">(contact admin to change)</small></span>
                    </div>
                    <div class="info-field">
                        <span class="info-label">Phone Number</span>
                        <input asp-for="PhoneNumber" class="info-input" placeholder="+27756455676">
                    </div>
                </div>

                <div id="contactActions" style="display:none;" class="action-buttons">
                    <button class="btn-cancel" type="button" onclick="cancelEdit('contact')">Cancel</button>
                    <button class="btn-save" type="submit">Save Changes</button>
                </div>
            </div>
        </form>

        <!-- CHANGE PASSWORD (not wired yet — next step) -->
        <div class="info-section">
            <div class="section-header">
                <h5 class="section-title"><i class="fas fa-lock"></i> Change Password</h5>
                <button class="edit-toggle-btn" id="editPasswordBtn" onclick="toggleEdit('password')" type="button">
                    <i class="fas fa-edit"></i> Edit
                </button>
            </div>

            <div id="passwordView" class="info-grid">
                <div class="info-field">
                    <span class="info-label">Password</span>
                    <span class="info-value">••••••••</span>
                </div>
            </div>

            <div id="passwordEdit" style="display:none;">
                <div class="info-grid-3">
                    <div class="info-field">
                        <span class="info-label">Current Password</span>
                        <input type="password" class="info-input" id="currentPassword" placeholder="Current password">
                    </div>
                    <div class="info-field">
                        <span class="info-label">New Password</span>
                        <input type="password" class="info-input" id="newPassword" placeholder="New password">
                    </div>
                    <div class="info-field">
                        <span class="info-label">Confirm New Password</span>
                        <input type="password" class="info-input" id="confirmPassword" placeholder="Confirm new password">
                    </div>
                </div>
                <p class="text-muted mt-2" style="font-size:0.85rem;">Password change isn't wired up yet — coming in the next step.</p>
            </div>
        </div>

    </div>
</div>

<!-- PHOTO MODAL (decorative — not saved to the server yet) -->
<div id="photoModal" class="photo-modal-overlay">
    <div class="photo-modal">
        <div class="photo-modal-header">
            <h5><i class="fas fa-camera me-2"></i>Update Profile Picture</h5>
            <button class="photo-modal-close" onclick="closePhotoModal()" type="button">&times;</button>
        </div>
        <div class="photo-modal-body">
            <img id="photoPreview" class="photo-preview"
                 src="https://ui-avatars.com/api/?background=ffffff&color=185FA5&size=150&name=@(Model.Name)+@(Model.Surname)"
                 alt="Preview">
            <div class="mb-3">
                <input type="file" id="photoInput" accept="image/*" class="form-control" onchange="previewPhoto()">
            </div>
            <small class="text-muted">Supported formats: JPG, PNG. Max size: 2MB. (Not saved yet.)</small>
            <div class="mt-3">
                <button class="btn btn-secondary btn-sm" onclick="useInitials()" type="button">
                    <i class="fas fa-user"></i> Use Initials
                </button>
            </div>
        </div>
        <div class="photo-modal-footer">
            <button class="btn btn-secondary" onclick="closePhotoModal()" type="button">Cancel</button>
            <button class="btn btn-primary" onclick="savePhoto()" type="button">Save Photo</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let tempPhoto = null;

        function toggleEdit(section) {
            if (section === 'personal') {
                document.getElementById('personalView').style.display = 'none';
                document.getElementById('personalEdit').style.display = 'grid';
                document.getElementById('personalActions').style.display = 'flex';
                document.getElementById('editPersonalBtn').disabled = true;
            } else if (section === 'contact') {
                document.getElementById('contactView').style.display = 'none';
                document.getElementById('contactEdit').style.display = 'grid';
                document.getElementById('contactActions').style.display = 'flex';
                document.getElementById('editContactBtn').disabled = true;
            } else if (section === 'password') {
                document.getElementById('passwordView').style.display = 'none';
                document.getElementById('passwordEdit').style.display = 'block';
                document.getElementById('editPasswordBtn').disabled = true;
            }
        }

        function cancelEdit(section) {
            if (section === 'personal') {
                document.getElementById('personalView').style.display = 'grid';
                document.getElementById('personalEdit').style.display = 'none';
                document.getElementById('personalActions').style.display = 'none';
                document.getElementById('editPersonalBtn').disabled = false;
            } else if (section === 'contact') {
                document.getElementById('contactView').style.display = 'grid';
                document.getElementById('contactEdit').style.display = 'none';
                document.getElementById('contactActions').style.display = 'none';
                document.getElementById('editContactBtn').disabled = false;
            }
        }

        function openPhotoModal() {
            document.getElementById('photoModal').style.display = 'flex';
            document.getElementById('photoInput').value = '';
            tempPhoto = null;
        }

        function closePhotoModal() {
            document.getElementById('photoModal').style.display = 'none';
        }

        function previewPhoto() {
            const file = document.getElementById('photoInput').files[0];
            if (!file) return;
            if (file.size > 2 * 1024 * 1024) { alert('File size must be less than 2MB.'); return; }
            const reader = new FileReader();
            reader.onload = e => {
                document.getElementById('photoPreview').src = e.target.result;
                tempPhoto = e.target.result;
            };
            reader.readAsDataURL(file);
        }

        function useInitials() {
            const url = "https://ui-avatars.com/api/?background=ffffff&color=185FA5&size=150&name=@(Model.Name)+@(Model.Surname)";
            document.getElementById('photoPreview').src = url;
            tempPhoto = null;
        }

        function savePhoto() {
            if (tempPhoto) {
                document.getElementById('mainProfileImage').src = tempPhoto;
            }
            closePhotoModal();
        }
    </script>
}