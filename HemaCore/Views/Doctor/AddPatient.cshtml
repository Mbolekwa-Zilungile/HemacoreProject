<script>
    // Automatically extract date of birth from a South African ID number.
    document.addEventListener("DOMContentLoaded", function () {

        const idNumber = document.getElementById("idNumber");
        const dateOfBirth = document.getElementById("dateOfBirth");
        const idError = document.getElementById("idError");

        if (!idNumber || !dateOfBirth) {
            return;
        }

        idNumber.addEventListener("input", function () {

            const value = this.value.trim();

            if (value.length === 0) {
                dateOfBirth.value = "";
                idError.style.display = "none";
                return;
            }

            if (!/^\d{13}$/.test(value)) {
                dateOfBirth.value = "";

                if (value.length === 13) {
                    idError.style.display = "block";
                } else {
                    idError.style.display = "none";
                }

                return;
            }

            const yy = parseInt(value.substring(0, 2));
            const mm = parseInt(value.substring(2, 4));
            const dd = parseInt(value.substring(4, 6));

            const currentYear = new Date().getFullYear();
            const currentYY = currentYear % 100;

            const fullYear =
                yy > currentYY
                    ? 1900 + yy
                    : 2000 + yy;

            const testDate = new Date(fullYear, mm - 1, dd);

            if (
                testDate.getFullYear() !== fullYear ||
                testDate.getMonth() !== mm - 1 ||
                testDate.getDate() !== dd
            ) {
                dateOfBirth.value = "";
                idError.style.display = "block";
                return;
            }

            const month = String(mm).padStart(2, "0");
            const day = String(dd).padStart(2, "0");

            dateOfBirth.value =
                `${fullYear}-${month}-${day}`;

            idError.style.display = "none";
        });
    });
</script>

@section Scripts {
