@model HemaCore.ViewModels.DoctorViewModels.AddPatientViewModel

@{
    ViewData["Title"] = "Add Patient";
    Layout = "~/Views/Shared/_DoctorLayout.cshtml";
}

<style>
    .add-patient-page {
        padding: 10px 5px 30px;
    }

    .page-header {
        margin-bottom: 25px;
    }

        .page-header h1 {
            margin: 0;
            color: #1f5068;
            font-size: 28px;
            font-weight: 700;
        }

        .page-header p {
            margin: 6px 0 0;
            color: #6b7280;
            font-size: 14px;
        }

    .form-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
        margin-bottom: 20px;
        overflow: hidden;
    }

    .card-header {
        padding: 18px 22px;
        border-bottom: 1px solid #e5e7eb;
        background: #f8fafb;
    }

        .card-header h2 {
            margin: 0;
            color: #1f5068;
            font-size: 18px;
            font-weight: 650;
        }

        .card-header p {
            margin: 5px 0 0;
            color: #6b7280;
            font-size: 13px;
        }

    .card-body {
        padding: 24px 22px;
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
    }

        .form-group.full-width {
            grid-column: 1 / -1;
        }

        .form-group label {
            color: #374151;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 7px;
        }

    .form-control {
        width: 100%;
        min-height: 42px;
        border: 1px solid #d1d5db;
        border-radius: 7px;
        padding: 9px 12px;
        font-size: 14px;
        color: #374151;
        background: #fff;
        outline: none;
        box-sizing: border-box;
    }

        .form-control:focus {
            border-color: #61a5c2;
            box-shadow: 0 0 0 3px rgba(97, 165, 194, 0.12);
        }

    textarea.form-control {
        min-height: 90px;
        resize: vertical;
    }

    .validation {
        color: #dc2626;
        font-size: 12px;
        margin-top: 5px;
    }

    .history-section {
        margin-top: 5px;
    }

    .history-title {
        color: #1f5068;
        font-size: 15px;
        font-weight: 650;
        margin-bottom: 12px;
    }

    .options-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 10px;
    }

    .option-item {
        border: 1px solid #e2e8f0;
        border-radius: 7px;
        padding: 11px 12px;
        background: #fafcfd;
        transition: 0.2s ease;
    }

        .option-item:hover {
            border-color: #b8dce8;
            background: #f5fafc;
        }

        .option-item label {
            display: flex;
            align-items: center;
            gap: 9px;
            cursor: pointer;
            font-size: 13px;
            color: #475569;
            font-weight: 500;
        }

        .option-item input {
            accent-color: #2c7da0;
            width: 16px;
            height: 16px;
        }

    .empty-options {
        color: #9ca3af;
        font-size: 13px;
        padding: 10px 0;
    }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 25px;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        min-height: 40px;
        padding: 9px 17px;
        border-radius: 7px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        border: none;
    }

    .btn-primary {
        background: #2c7da0;
        color: white;
    }

        .btn-primary:hover {
            background: #1f5068;
            color: white;
        }

    .btn-secondary {
        background: #f3f4f6;
        color: #475569;
        border: 1px solid #dfe3e8;
    }

        .btn-secondary:hover {
            background: #e8ebee;
            color: #1f5068;
        }

    .info-box {
        margin-top: 20px;
        padding: 13px 15px;
        background: #eef7fa;
        border: 1px solid #d7ebf1;
        border-radius: 7px;
        color: #315c6e;
        font-size: 13px;
        line-height: 1.5;
    }

    @@media (max-width: 768px) {
        .form-grid {
            grid-template-columns: 1fr;
        }

        .form-group.full-width {
            grid-column: auto;
        }

        .options-grid {
            grid-template-columns: 1fr;
        }

        .form-actions {
            flex-direction: column-reverse;
        }

        .btn {
            width: 100%;
        }
    }
</style>

<div class="add-patient-page">

    <div class="page-header">
        <h1>Add Patient</h1>
        <p>Capture the patient's personal information and medical history.</p>
    </div>

    <form asp-controller="Doctor"
          asp-action="AddPatient"
          method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="validation"
             style="margin-bottom: 15px;">
        </div>

        <!-- Personal Information -->
        <div class="form-card">

            <div class="card-header">
                <h2>Patient Information</h2>
                <p>Enter the patient's basic personal and contact details.</p>
            </div>

            <div class="card-body">

                <div class="form-grid">

                    <div class="form-group">
                        <label asp-for="Name"></label>

                        <input asp-for="Name"
                               class="form-control"
                               placeholder="Enter patient's name" />

                        <span asp-validation-for="Name"
                              class="validation"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Surname"></label>

                        <input asp-for="Surname"
                               class="form-control"
                               placeholder="Enter patient's surname" />

                        <span asp-validation-for="Surname"
                              class="validation"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="IDNumber"></label>

                        <input asp-for="IDNumber"
                               class="form-control"
                               placeholder="Enter South African ID number" />

                        <span asp-validation-for="IDNumber"
                              class="validation"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="DateOfBirth"></label>

                        <input asp-for="DateOfBirth"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="DateOfBirth"
                              class="validation"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="PhoneNumber"></label>

                        <input asp-for="PhoneNumber"
                               class="form-control"
                               placeholder="+27XXXXXXXXX" />

                        <span asp-validation-for="PhoneNumber"
                              class="validation"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Email"></label>

                        <input asp-for="Email"
                               type="email"
                               class="form-control"
                               placeholder="patient@example.com" />

                        <span asp-validation-for="Email"
                              class="validation"></span>
                    </div>

                    <div class="form-group full-width">
                        <label asp-for="Address"></label>

                        <textarea asp-for="Address"
                                  class="form-control"
                                  placeholder="Enter patient's address"></textarea>

                        <span asp-validation-for="Address"
                              class="validation"></span>
                    </div>

                </div>

            </div>
        </div>

        <!-- Medical History -->
        <div class="form-card">

            <div class="card-header">
                <h2>Medical History</h2>
                <p>Select any known conditions, allergies or medications.</p>
            </div>

            <div class="card-body">

                <!-- Conditions -->
                <div class="history-section">

                    <div class="history-title">
                        Known Conditions
                    </div>

                    @if (Model.AllConditions.Any())
                    {
                        <div class="options-grid">

                            @for (int i = 0; i < Model.AllConditions.Count; i++)
                            {
                                <div class="option-item">

                                    <label>
                                        <input type="checkbox"
                                               name="SelectedConditionIds"
                                               value="@Model.AllConditions[i].Id"
                                        @(Model.AllConditions[i].IsSelected ? "checked" : "") />

                                        @Model.AllConditions[i].Name
                                    </label>

                                </div>
                            }

                        </div>
                    }
                    else
                    {
                        <div class="empty-options">
                            No conditions are currently available.
                        </div>
                    }

                </div>

                <hr style="border: 0; border-top: 1px solid #edf0f2; margin: 25px 0;" />

                <!-- Allergies -->
                <div class="history-section">

                    <div class="history-title">
                        Allergies
                    </div>

                    @if (Model.AllAllergies.Any())
                    {
                        <div class="options-grid">

                            @for (int i = 0; i < Model.AllAllergies.Count; i++)
                            {
                                <div class="option-item">

                                    <label>
                                        <input type="checkbox"
                                               name="SelectedAllergyIds"
                                               value="@Model.AllAllergies[i].Id"
                                        @(Model.AllAllergies[i].IsSelected ? "checked" : "") />

                                        @Model.AllAllergies[i].Name
                                    </label>

                                </div>
                            }

                        </div>
                    }
                    else
                    {
                        <div class="empty-options">
                            No allergies are currently available.
                        </div>
                    }

                </div>

                <hr style="border: 0; border-top: 1px solid #edf0f2; margin: 25px 0;" />

                <!-- Medications -->
                <div class="history-section">

                    <div class="history-title">
                        Current Medications
                    </div>

                    @if (Model.AllMedications.Any())
                    {
                        <div class="options-grid">

                            @for (int i = 0; i < Model.AllMedications.Count; i++)
                            {
                                <div class="option-item">

                                    <label>
                                        <input type="checkbox"
                                               name="SelectedMedicationIds"
                                               value="@Model.AllMedications[i].Id"
                                        @(Model.AllMedications[i].IsSelected ? "checked" : "") />

                                        @Model.AllMedications[i].Name
                                    </label>

                                </div>
                            }

                        </div>
                    }
                    else
                    {
                        <div class="empty-options">
                            No medications are currently available.
                        </div>
                    }

                </div>

                <div class="info-box">
                    <i class="bi bi-info-circle"></i>
                    The patient will receive their account details after registration.
                    They will be required to change their password when they first log in.
                </div>

            </div>
        </div>

        <!-- Actions -->
        <div class="form-actions">

            <a asp-controller="Doctor"
               asp-action="ManagePatients"
               class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i>
                Cancel
            </a>

            <button type="submit"
                    class="btn btn-primary">
                <i class="bi bi-person-plus"></i>
                Add Patient
            </button>

        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}