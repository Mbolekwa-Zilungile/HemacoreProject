@model HemaCore.ViewModels.DoctorViewModels.AddPatientViewModel

@{
    Layout = "~/Views/Shared/_DoctorLayout.cshtml";
    ViewBag.Title = "Add New Patient";
}

<link rel="stylesheet" href="~/css/doctor.css" />

<style>
    .add-patient-page {
        padding: 5px 5px 30px;
        animation: fadeInUp 0.5s ease;
    }

    .page-header {
        margin-bottom: 2rem;
    }

    .page-header h1 {
        margin: 0;
        font-size: 1.8rem;
        font-weight: 700;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .page-header h1 i {
        -webkit-text-fill-color: #667eea;
    }

    .page-header p {
        margin: 6px 0 0;
        color: #718096;
        font-size: 14px;
    }

    .form-card {
        background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
        border-radius: 24px;
        padding: 2rem;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
        margin-bottom: 1.5rem;
        border: 1px solid rgba(0, 0, 0, 0.05);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .form-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 15px 50px rgba(0, 0, 0, 0.12);
    }

    .step-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.5rem;
        padding-bottom: 1rem;
        border-bottom: 2px solid #e9ecef;
    }

    .step-number {
        width: 40px;
        height: 40px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 1.2rem;
        flex-shrink: 0;
    }

    .step-title {
        font-size: 1.3rem;
        font-weight: 600;
        color: #2d3748;
        margin: 0;
    }

    .step-subtitle {
        color: #718096;
        font-size: 0.85rem;
        margin: 0.25rem 0 0;
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1.5rem;
    }

    .form-group {
        display: flex;
        flex-direction: column;
    }

    .form-group.full-width {
        grid-column: 1 / -1;
    }

    .form-group label {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 600;
        color: #2d3748;
        margin-bottom: 0.5rem;
        font-size: 0.9rem;
    }

    .form-group label i {
        color: #667eea;
        width: 20px;
    }

    .form-control {
        width: 100%;
        padding: 0.75rem 1rem;
        border: 2px solid #e2e8f0;
        border-radius: 12px;
        font-size: 0.95rem;
        background: white;
        box-sizing: border-box;
        transition: all 0.3s ease;
    }

    .form-control:hover {
        border-color: #cbd5e0;
    }

    .form-control:focus {
        outline: none;
        border-color: #667eea;
        box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
    }

    textarea.form-control {
        min-height: 85px;
        resize: vertical;
    }

    .validation {
        color: #dc3545;
        font-size: 0.8rem;
        margin-top: 0.3rem;
    }

    .info-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: #ebf8ff;
        color: #3182ce;
        padding: 0.5rem 1rem;
        border-radius: 12px;
        font-size: 0.85rem;
        margin-bottom: 1rem;
    }

    .history-section {
        margin-bottom: 1rem;
    }

    .history-title {
        color: #2d3748;
        font-size: 1rem;
        font-weight: 600;
        margin-bottom: 0.8rem;
    }

    .options-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0.75rem;
    }

    .option-item {
        background: #f7fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 0.85rem 1rem;
        transition: all 0.3s ease;
    }

    .option-item:hover {
        background: #edf2f7;
        border-color: #c3dafe;
        transform: translateX(5px);
    }

    .option-item label {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        cursor: pointer;
        color: #4a5568;
        font-size: 0.88rem;
        font-weight: 500;
        margin: 0;
    }

    .option-item input[type="checkbox"] {
        width: 17px;
        height: 17px;
        accent-color: #667eea;
        cursor: pointer;
    }

    .empty-options {
        color: #9ca3af;
        background: #f8fafc;
        border: 1px dashed #d1d5db;
        border-radius: 12px;
        padding: 1rem;
        font-size: 0.85rem;
    }

    .history-divider {
        border: 0;
        border-top: 1px solid #edf0f2;
        margin: 1.5rem 0;
    }

    .form-actions {
        display: flex;
        gap: 1rem;
        justify-content: flex-end;
        margin-top: 2rem;
    }

    .btn-cancel {
        background: white;
        color: #718096;
        border: 2px solid #e2e8f0;
        padding: 0.7rem 1.8rem;
        border-radius: 12px;
        font-weight: 500;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-cancel:hover {
        background: #f7fafc;
        border-color: #cbd5e0;
        transform: translateY(-2px);
    }

    .btn-submit {
        background: linear-gradient(135deg, #48bb78 0%, #38a169 100%);
        color: white;
        border: none;
        padding: 0.7rem 2rem;
        border-radius: 12px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 1rem;
    }

    .btn-submit:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(72, 187, 120, 0.3);
    }

    .info-box {
        margin-top: 1.5rem;
        padding: 0.9rem 1rem;
        background: #ebf8ff;
        border: 1px solid #bee3f8;
        border-radius: 12px;
        color: #2b6cb0;
        font-size: 0.85rem;
        line-height: 1.5;
        display: flex;
        align-items: flex-start;
        gap: 0.6rem;
    }

    .success-message {
        background: #c6f6d5;
        color: #22543d;
        padding: 1rem;
        border-radius: 12px;
        margin-bottom: 1.5rem;
        border-left: 4px solid #38a169;
    }

    .error-message {
        background: #fed7d7;
        color: #742a2a;
        padding: 1rem;
        border-radius: 12px;
        margin-bottom: 1.5rem;
        border-left: 4px solid #e53e3e;
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@media (max-width: 768px) {
        .form-grid {
            grid-template-columns: 1fr;
            gap: 1rem;
        }

        .form-group.full-width {
            grid-column: auto;
        }

        .options-grid {
            grid-template-columns: 1fr;
        }

        .form-actions {
            flex-direction: column-reverse;
        }

        .btn-cancel,
        .btn-submit {
            width: 100%;
            justify-content: center;
        }

        .form-card {
            padding: 1.5rem;
        }

        .step-title {
            font-size: 1.1rem;
        }
    }
</style>
<div class="add-patient-page">

    @if (TempData["Success"] != null)
    {
        <div class="success-message">
