
@model HemaCore.ViewModels.DoctorViewModels.AddPatientViewModel

@{
    Layout = "~/Views/Shared/_DoctorLayout.cshtml";
    ViewBag.Title = "Add New Patient";
}

<link rel="stylesheet" href="~/css/doctor.css" />

<style>
    .add-patient-page {
        padding: 5px 5px 30px;
        animation: fadeInUp .5s ease;
    }

    .page-header { margin-bottom: 2rem; }

    .page-header h1 {
        font-size: 1.8rem;
        font-weight: 700;
        color: #2c7da0;
        margin: 0;
    }

    .page-header p {
        margin: 6px 0 0;
        color: #718096;
        font-size: 14px;
    }

    .form-card {
        background: linear-gradient(135deg,#fff,#f8f9fa);
        border-radius: 20px;
        padding: 2rem;
        box-shadow: 0 8px 30px rgba(0,0,0,.06);
        margin-bottom: 1.5rem;
        border: 1px solid rgba(0,0,0,.05);
    }

    .step-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.5rem;
        padding-bottom: 1rem;
        border-bottom: 2px solid #e9ecef;
    }

    .step-number {
        width: 40px;
        height: 40px;
        background: linear-gradient(135deg,#2c7da0,#1f5068);
        color: white;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 1.2rem;
        flex-shrink: 0;
    }

    .step-title {
        font-size: 1.25rem;
        font-weight: 600;
        color: #2d3748;
        margin: 0;
    }

    .step-subtitle {
        color: #718096;
        font-size: .85rem;
        margin: .25rem 0 0;
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(2,minmax(0,1fr));
        gap: 1.25rem;
    }

    .form-group { display: flex; flex-direction: column; }
    .form-group.full-width { grid-column: 1/-1; }

    .form-group label {
        display: flex;
        align-items: center;
        gap: .5rem;
        font-weight: 600;
        color: #2d3748;
        margin-bottom: .5rem;
        font-size: .9rem;
    }

    .form-group label i { color: #2c7da0; width: 20px; }

    .form-control {
        width: 100%;
        padding: .75rem 1rem;
        border: 2px solid #e2e8f0;
        border-radius: 10px;
        font-size: .95rem;
        background: white;
        box-sizing: border-box;
        transition: all .2s ease;
    }

    .form-control:focus {
        outline: none;
        border-color: #2c7da0;
        box-shadow: 0 0 0 3px rgba(44,125,160,.12);
    }

    .form-control.input-invalid,
    .form-control.input-validation-error {
        border-color: #dc3545 !important;
        background: #fffafa;
    }

    .form-control.input-valid { border-color: #38a169; }

    .form-control[readonly] {
        background: #f8f9fa;
        cursor: not-allowed;
    }

    .validation {
        color: #dc3545;
        font-size: .8rem;
        margin-top: .3rem;
    }

    .validation-summary-valid { display: none; }

    .validation-summary-errors {
        color: #742a2a;
        background: #fed7d7;
        border: 1px solid #feb2b2;
        border-left: 4px solid #e53e3e;
        border-radius: 12px;
        padding: 1rem 1.25rem;
        margin-bottom: 1.5rem;
    }

    .validation-summary-errors ul {
        margin: 0;
        padding-left: 1.25rem;
    }

    .info-badge {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        background: #ebf8ff;
        color: #3182ce;
        padding: .5rem 1rem;
        border-radius: 10px;
        font-size: .85rem;
        margin-bottom: 1rem;
    }

    /* Medical history search */
    .history-section { margin-bottom: 1rem; }

    .history-search { margin-bottom: 1rem; }

    .history-search .input-group-text {
        background: white;
        border: 2px solid #e2e8f0;
        border-right: 0;
        border-radius: 10px 0 0 10px;
    }

    .history-search .form-control {
        border-left: 0;
        border-radius: 0 10px 10px 0;
    }

    .history-layout {
        display: grid;
        grid-template-columns: minmax(0,7fr) minmax(0,5fr);
        gap: 1.25rem;
        align-items: stretch;
    }

    .history-panel {
        min-width: 0;
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 1rem;
    }

    .history-panel-title {
        font-size: .9rem;
        font-weight: 700;
        color: #2d3748;
        margin-bottom: .85rem;
    }

    .history-list {
        max-height: 350px;
        overflow-y: auto;
        padding-right: 4px;
    }

    .category-group {
        margin-bottom: .65rem;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        overflow: hidden;
    }

    .category-header {
        cursor: pointer;
        user-select: none;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: .75rem;
        background: #f7fafc;
        color: #4a5568;
        padding: .8rem .9rem;
        font-weight: 700;
        font-size: .82rem;
        text-transform: uppercase;
        transition: background .2s ease;
    }

    .category-header:hover { background: #edf2f7; }

    .category-header .category-name {
        display: flex;
        align-items: center;
        gap: .55rem;
        min-width: 0;
        overflow-wrap: anywhere;
    }

    .category-header .category-name i { color: #2c7da0; }

    .category-chevron {
        transition: transform .2s ease;
        font-size: .7rem;
        flex-shrink: 0;
    }

    .category-group.collapsed .category-chevron {
        transform: rotate(-90deg);
    }

    .category-body {
        display: block;
        padding: .35rem .5rem;
        background: #fff;
    }

    .category-group.collapsed .category-body { display: none; }

    .option-item {
        display: flex;
        align-items: flex-start;
        gap: .65rem;
        padding: .6rem .65rem;
        border-radius: 7px;
        transition: background .15s ease;
    }

    .option-item:hover { background: #f7fafc; }

    .option-item[hidden] { display: none !important; }

    .option-item .form-check-input {
        margin-top: .25rem;
        flex-shrink: 0;
        cursor: pointer;
        accent-color: #2c7da0;
    }

    .option-item .form-check-label {
        font-size: .87rem;
        color: #4a5568;
        cursor: pointer;
        overflow-wrap: anywhere;
        margin: 0;
    }

    .selected-list {
        display: flex;
        flex-wrap: wrap;
        gap: .5rem;
        align-content: flex-start;
    }

    .selected-empty {
        color: #718096;
        font-size: .85rem;
        margin: 0;
    }

    .selected-chip {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        max-width: 100%;
        padding: .45rem .6rem .45rem .75rem;
        background: #ebf8ff;
        border: 1px solid #bee3f8;
        border-radius: 9px;
        color: #2c5282;
        font-size: .82rem;
        overflow-wrap: anywhere;
    }

    .selected-chip button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 22px;
        height: 22px;
        flex-shrink: 0;
        border: none;
        border-radius: 50%;
        background: #bee3f8;
        color: #2c5282;
        cursor: pointer;
        font-size: 1rem;
        line-height: 1;
    }

    .selected-chip button:hover { background: #90cdf4; }

    .history-no-results {
        display: none;
        text-align: center;
        color: #718096;
        font-size: .85rem;
        padding: 1rem .5rem;
    }

    .history-no-results.show { display: block; }

    .history-divider {
        border: 0;
        border-top: 1px solid #edf0f2;
        margin: 1.5rem 0;
    }

    .info-box {
        margin-top: 1.5rem;
        padding: .9rem 1rem;
        background: #ebf8ff;
        border: 1px solid #bee3f8;
        border-radius: 12px;
        color: #2b6cb0;
        font-size: .85rem;
        line-height: 1.5;
        display: flex;
        align-items: flex-start;
        gap: .6rem;
    }

    .success-message, .error-message {
        padding: 1rem;
        border-radius: 12px;
        margin-bottom: 1.5rem;
    }

    .success-message {
        background: #c6f6d5;
        color: #22543d;
        border-left: 4px solid #38a169;
    }

    .error-message {
        background: #fed7d7;
        color: #742a2a;
        border-left: 4px solid #e53e3e;
    }

    .form-actions {
        display: flex;
        gap: 1rem;
        justify-content: flex-end;
        margin-top: 2rem;
    }

    .btn-cancel {
        background: white;
        color: #718096;
        border: 2px solid #e2e8f0;
        padding: .7rem 1.8rem;
        border-radius: 10px;
        font-weight: 500;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .5rem;
    }

    .btn-cancel:hover { background: #f7fafc; }

    .btn-submit {
        background: linear-gradient(135deg,#2c7da0,#1f5068);
        color: white;
        border: none;
        padding: .7rem 2rem;
        border-radius: 10px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .5rem;
        font-size: 1rem;
    }

    .btn-submit:hover { filter: brightness(1.08); }

    @@keyframes fadeInUp {
        from { opacity: 0; transform: translateY(15px); }
        to { opacity: 1; transform: translateY(0); }
    }

    @@media (max-width: 768px) {
        .form-grid { grid-template-columns: 1fr; gap: 1rem; }
        .form-group.full-width { grid-column: auto; }
        .history-layout { grid-template-columns: 1fr; }
        .form-actions { flex-direction: column-reverse; }
        .btn-cancel, .btn-submit { width: 100%; }
        .form-card { padding: 1.25rem; }
    }
</style>

<div class="add-patient-page">

    <div class="page-header">
        <h1><i class="fas fa-user-plus"></i> Add New Patient</h1>
        <p>Register a patient and record their medical history.</p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="success-message" role="status">
            <i class="fas fa-check-circle"></i>
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="error-message" role="alert">
            <i class="fas fa-exclamation-triangle"></i>
            @TempData["Error"]
        </div>
    }

    <form asp-controller="Doctor"
          asp-action="AddPatient"
          method="post"
          id="addPatientForm"
          novalidate>

        @Html.AntiForgeryToken()

        <div asp-validation-summary="All"
             class="validation-summary-errors"
             role="alert"></div>

        <!-- STEP 1: PERSONAL DETAILS -->
        <div class="form-card">
            <div class="step-header">
                <div class="step-number">1</div>
                <div>
                    <h3 class="step-title">Personal Details</h3>
                    <p class="step-subtitle">Basic information about the patient</p>
                </div>
            </div>

            <div class="form-grid">
                <div class="form-group">
                    <label asp-for="Name"><i class="fas fa-user"></i> First Name *</label>
                    <input asp-for="Name" class="form-control" placeholder="Enter first name" />
                    <span asp-validation-for="Name" class="validation"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Surname"><i class="fas fa-user"></i> Surname *</label>
                    <input asp-for="Surname" class="form-control" placeholder="Enter surname" />
                    <span asp-validation-for="Surname" class="validation"></span>
                </div>

                <div class="form-group">
                    <label asp-for="IDNumber"><i class="fas fa-id-card"></i> ID Number *</label>
                    <input asp-for="IDNumber"
                           id="idNumber"
                           class="form-control"
                           placeholder="Enter all 13 digits"
                           maxlength="13"
                           inputmode="numeric"
                           autocomplete="off"
                           aria-describedby="idError" />
                    <span id="idError" class="validation" role="alert"></span>
                    <span asp-validation-for="IDNumber" class="validation"></span>
                    <small class="text-muted mt-1">Enter the complete 13-digit South African ID number.</small>
                </div>

                <div class="form-group">
                    <label asp-for="DateOfBirth"><i class="fas fa-calendar"></i> Date of Birth *</label>
                    <input asp-for="DateOfBirth"
                           id="dateOfBirth"
                           type="date"
                           class="form-control"
                           readonly />
                    <span asp-validation-for="DateOfBirth" class="validation"></span>
                    <small class="text-muted mt-1">Auto-filled from the ID number.</small>
                </div>

                <div class="form-group">
                    <label asp-for="PhoneNumber"><i class="fas fa-phone"></i> Phone Number *</label>
                    <input asp-for="PhoneNumber"
                           id="phoneNumber"
                           class="form-control"
                           placeholder="+27712345678"
                           maxlength="12"
                           inputmode="tel"
                           autocomplete="tel"
                           aria-describedby="phoneError" />
                    <span id="phoneError" class="validation" role="alert"></span>
                    <span asp-validation-for="PhoneNumber" class="validation"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Gender"><i class="fas fa-venus-mars"></i> Gender *</label>
                    <select asp-for="Gender" class="form-control">
                        <option value="">Select gender</option>
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                        <option value="Other">Other</option>
                    </select>
                    <span asp-validation-for="Gender" class="validation"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Email"><i class="fas fa-envelope"></i> Email Address *</label>
                    <input asp-for="Email"
                           type="email"
                           class="form-control"
                           placeholder="patient@example.com"
                           autocomplete="email" />
                    <span asp-validation-for="Email" class="validation"></span>
                </div>

                <div class="form-group full-width">
                    <label asp-for="StreetAddress"><i class="fas fa-home"></i> Street Address *</label>
                    <input asp-for="StreetAddress" class="form-control" placeholder="e.g. 12 Main Road" />
                    <span asp-validation-for="StreetAddress" class="validation"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Province"><i class="fas fa-map"></i> Province *</label>
                    <select asp-for="Province" id="provinceInput" class="form-control">
                        <option value="">Select province</option>
                        <option value="Eastern Cape">Eastern Cape</option>
                        <option value="Free State">Free State</option>
                        <option value="Gauteng">Gauteng</option>
                        <option value="KwaZulu-Natal">KwaZulu-Natal</option>
                        <option value="Limpopo">Limpopo</option>
                        <option value="Mpumalanga">Mpumalanga</option>
                        <option value="Northern Cape">Northern Cape</option>
                        <option value="North West">North West</option>
                        <option value="Western Cape">Western Cape</option>
                    </select>
                    <span asp-validation-for="Province" class="validation"></span>
                </div>

                <div class="form-group">
                    <label asp-for="City"><i class="fas fa-city"></i> City / Town *</label>
                    <input asp-for="City"
                           id="cityInput"
                           class="form-control"
                           placeholder="Type or select a city"
                           autocomplete="off" />
                    <span asp-validation-for="City" class="validation"></span>
                    <small class="text-muted mt-1">Selecting a city can fill the postal code. You may also type a city manually.</small>
                </div>

                <div class="form-group">
                    <label asp-for="Suburb"><i class="fas fa-map-marker-alt"></i> Suburb</label>
                    <input asp-for="Suburb"
                           id="suburbInput"
                           class="form-control"
                           placeholder="Type or select a suburb"
                           autocomplete="off" />
                    <span asp-validation-for="Suburb" class="validation"></span>
                    <small class="text-muted mt-1">Selecting a suburb can fill the city and postal code.</small>
                </div>

                <div class="form-group">
                    <label asp-for="PostalCode"><i class="fas fa-mail-bulk"></i> Postal Code *</label>
                    <input asp-for="PostalCode"
                           id="postalInput"
                           class="form-control"
                           placeholder="e.g. 6070"
                           maxlength="4"
                           inputmode="numeric" />
                    <span asp-validation-for="PostalCode" class="validation"></span>
                    <small class="text-muted mt-1">Auto-filled when available; you can edit it.</small>
                </div>
            </div>
        </div>

        <!-- STEP 2: MEDICAL CONDITIONS -->
        <div class="form-card">
            <div class="step-header">
                <div class="step-number">2</div>
                <div>
                    <h3 class="step-title">Medical Conditions</h3>
                    <p class="step-subtitle">Search categories and select the patient's known medical conditions.</p>
                </div>
            </div>

            <div class="history-layout">
                <div class="history-panel">
                    <h4 class="history-panel-title">Medical Conditions</h4>

                    <div class="history-search">
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-search"></i></span>
                            <input type="search"
                                   id="conditionSearch"
                                   class="form-control"
                                   placeholder="Search conditions..."
                                   oninput="filterOptions('condition')" />
                        </div>
                    </div>

                    <div id="conditionsList" class="history-list">
                        @{
                            var conditionGroups = Model.AllConditions
                                .GroupBy(x => string.IsNullOrWhiteSpace(x.CategoryName) ? "Uncategorized" : x.CategoryName)
                                .OrderBy(g => g.Key)
                                .ToList();
                        }

                        @if (conditionGroups.Any())
                        {
                            foreach (var group in conditionGroups)
                            {
                                <div class="category-group"
                                     data-category="@group.Key.ToLowerInvariant()">

                                    <div class="category-header"
                                         role="button"
                                         tabindex="0"
                                         aria-expanded="true"
                                         onclick="toggleCategory(this)"
                                         onkeydown="toggleCategoryKeyboard(event, this)">
                                        <span class="category-name">
                                            <i class="fas fa-folder"></i>
                                            @group.Key
                                            <span class="text-muted">(@group.Count())</span>
                                        </span>
                                        <i class="fas fa-chevron-down category-chevron"></i>
                                    </div>

                                    <div class="category-body">
                                        @foreach (var item in group.OrderBy(x => x.Name))
                                        {
                                            <div class="option-item"
                                                 data-name="@item.Name.ToLowerInvariant()"
                                                 data-category="@group.Key.ToLowerInvariant()">

                                                <input type="checkbox"
                                                       name="SelectedConditionIds"
                                                       value="@item.Id"
                                                       id="cond_@item.Id"
                                                       class="form-check-input history-checkbox"
                                                       @(item.IsSelected ? "checked" : "") />

                                                <label for="cond_@item.Id" class="form-check-label">
                                                    @item.Name
                                                </label>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted text-center py-3">No medical conditions available.</p>
                        }
                    </div>

                    <p id="conditionNoResults" class="history-no-results">No matching conditions found.</p>
                </div>

                <div class="history-panel">
                    <h4 class="history-panel-title">
                        <i class="fas fa-check-circle me-1"></i>
                        Selected Conditions
                    </h4>
                    <hr />
                    <div id="selectedConditionsList" class="selected-list"></div>
                </div>
            </div>
        </div>

        <!-- STEP 3: ALLERGIES -->
        <div class="form-card">
            <div class="step-header">
                <div class="step-number">3</div>
                <div>
                    <h3 class="step-title">Allergies</h3>
                    <p class="step-subtitle">Record known medication, food, and environmental allergies.</p>
                </div>
            </div>

            <div class="info-badge" style="background:#fff5f5;color:#c53030;">
                <i class="fas fa-exclamation-triangle"></i>
                Allergy information is important for patient safety.
            </div>

            <div class="history-layout">
                <div class="history-panel">
                    <h4 class="history-panel-title">Allergies</h4>

                    <div class="history-search">
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-search"></i></span>
                            <input type="search"
                                   id="allergySearch"
                                   class="form-control"
                                   placeholder="Search allergies..."
                                   oninput="filterOptions('allergy')" />
                        </div>
                    </div>

                    <div id="allergiesList" class="history-list">
                        @{
                            var allergyGroups = Model.AllAllergies
                                .GroupBy(x => string.IsNullOrWhiteSpace(x.CategoryName) ? "Uncategorized" : x.CategoryName)
                                .OrderBy(g => g.Key)
                                .ToList();
                        }

                        @if (allergyGroups.Any())
                        {
                            foreach (var group in allergyGroups)
                            {
                                <div class="category-group"
                                     data-category="@group.Key.ToLowerInvariant()">

                                    <div class="category-header"
                                         role="button"
                                         tabindex="0"
                                         aria-expanded="true"
                                         onclick="toggleCategory(this)"
                                         onkeydown="toggleCategoryKeyboard(event, this)">
                                        <span class="category-name">
                                            <i class="fas fa-folder"></i>
                                            @group.Key
                                            <span class="text-muted">(@group.Count())</span>
                                        </span>
                                        <i class="fas fa-chevron-down category-chevron"></i>
                                    </div>

                                    <div class="category-body">
                                        @foreach (var item in group.OrderBy(x => x.Name))
                                        {
                                            <div class="option-item"
                                                 data-name="@item.Name.ToLowerInvariant()"
                                                 data-category="@group.Key.ToLowerInvariant()">

                                                <input type="checkbox"
                                                       name="SelectedAllergyIds"
                                                       value="@item.Id"
                                                       id="all_@item.Id"
                                                       class="form-check-input history-checkbox"
                                                       @(item.IsSelected ? "checked" : "") />

                                                <label for="all_@item.Id" class="form-check-label">
                                                    @item.Name
                                                </label>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted text-center py-3">No allergies available.</p>
                        }
                    </div>

                    <p id="allergyNoResults" class="history-no-results">No matching allergies found.</p>
                </div>

                <div class="history-panel">
                    <h4 class="history-panel-title">
                        <i class="fas fa-check-circle me-1"></i>
                        Selected Allergies
                    </h4>
                    <hr />
                    <div id="selectedAllergiesList" class="selected-list"></div>
                </div>
            </div>
        </div>

        <!-- STEP 4: CURRENT MEDICATIONS -->
        <div class="form-card">
            <div class="step-header">
                <div class="step-number">4</div>
                <div>
                    <h3 class="step-title">Current Medications</h3>
                    <p class="step-subtitle">Record the medications the patient currently takes.</p>
                </div>
            </div>

            <div class="info-badge" style="background:#f0fff4;color:#276749;">
                <i class="fas fa-pills"></i>
                Select all applicable current medications.
            </div>

            <div class="history-layout">
                <div class="history-panel">
                    <h4 class="history-panel-title">Medications</h4>

                    <div class="history-search">
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-search"></i></span>
                            <input type="search"
                                   id="medicationSearch"
                                   class="form-control"
                                   placeholder="Search medications..."
                                   oninput="filterOptions('medication')" />
                        </div>
                    </div>

                    <div id="medicationsList" class="history-list">
                        @{
                            var medicationGroups = Model.AllMedications
                                .GroupBy(x => string.IsNullOrWhiteSpace(x.CategoryName) ? "Uncategorized" : x.CategoryName)
                                .OrderBy(g => g.Key)
                                .ToList();
                        }

                        @if (medicationGroups.Any())
                        {
                            foreach (var group in medicationGroups)
                            {
                                <div class="category-group"
                                     data-category="@group.Key.ToLowerInvariant()">

                                    <div class="category-header"
                                         role="button"
                                         tabindex="0"
                                         aria-expanded="true"
                                         onclick="toggleCategory(this)"
                                         onkeydown="toggleCategoryKeyboard(event, this)">
                                        <span class="category-name">
                                            <i class="fas fa-folder"></i>
                                            @group.Key
                                            <span class="text-muted">(@group.Count())</span>
                                        </span>
                                        <i class="fas fa-chevron-down category-chevron"></i>
                                    </div>

                                    <div class="category-body">
                                        @foreach (var item in group.OrderBy(x => x.Name))
                                        {
                                            <div class="option-item"
                                                 data-name="@item.Name.ToLowerInvariant()"
                                                 data-category="@group.Key.ToLowerInvariant()">

                                                <input type="checkbox"
                                                       name="SelectedMedicationIds"
                                                       value="@item.Id"
                                                       id="med_@item.Id"
                                                       class="form-check-input history-checkbox"
                                                       @(item.IsSelected ? "checked" : "") />

                                                <label for="med_@item.Id" class="form-check-label">
                                                    @item.Name
                                                </label>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted text-center py-3">No medications available.</p>
                        }
                    </div>

                    <p id="medicationNoResults" class="history-no-results">No matching medications found.</p>
                </div>

                <div class="history-panel">
                    <h4 class="history-panel-title">
                        <i class="fas fa-check-circle me-1"></i>
                        Selected Medications
                    </h4>
                    <hr />
                    <div id="selectedMedicationsList" class="selected-list"></div>
                </div>
            </div>

            <div class="info-box">
                <i class="fas fa-info-circle"></i>
                <span>
                    A temporary password will be generated and sent to the
                    patient's email address. The patient must change it on
                    their first login.
                </span>
            </div>
        </div>

        <!-- ACTIONS -->
        <div class="form-actions">
            <a asp-controller="Doctor"
               asp-action="ManagePatients"
               class="btn-cancel">
                <i class="fas fa-times"></i> Cancel
            </a>

            <button type="submit" class="btn-submit">
                <i class="fas fa-user-plus"></i> Register Patient
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/sa-cities.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const form = document.getElementById("addPatientForm");

            const idNumber = document.getElementById("idNumber");
            const dateOfBirth = document.getElementById("dateOfBirth");
            const idError = document.getElementById("idError");

            const phoneNumber = document.getElementById("phoneNumber");
            const phoneError = document.getElementById("phoneError");

            const postalCode = document.getElementById("postalInput");
            const provinceSelect = document.getElementById("provinceInput");
            const cityInput = document.getElementById("cityInput");

            // City and suburb autocomplete
            if (typeof window.attachCityDropdown === "function") {
                window.attachCityDropdown("cityInput", "postalInput", "provinceInput");
            }

            if (typeof window.attachSuburbDropdown === "function") {
                window.attachSuburbDropdown("suburbInput", "cityInput", "postalInput", "provinceInput");
            }

            // ID number validation and date-of-birth calculation
            function setError(input, errorElement, message) {
                if (!input || !errorElement) return;

                errorElement.textContent = message;
                errorElement.style.display = message ? "block" : "none";

                input.classList.toggle("input-invalid", !!message);
                input.classList.toggle(
                    "input-valid",
                    !message && input.value.trim() !== ""
                );

                input.setAttribute("aria-invalid", message ? "true" : "false");
            }

            function validateID() {
                if (!idNumber || !dateOfBirth || !idError) return true;

                const value = idNumber.value.trim();

                if (!value) {
                    dateOfBirth.value = "";
                    setError(idNumber, idError, "Please enter the patient's ID number.");
                    return false;
                }

                if (!/^\d+$/.test(value)) {
                    dateOfBirth.value = "";
                    setError(idNumber, idError, "ID number must contain digits only.");
                    return false;
                }

                if (value.length !== 13) {
                    dateOfBirth.value = "";
                    setError(idNumber, idError, "ID number must contain exactly 13 digits.");
                    return false;
                }

                const yy = Number(value.substring(0, 2));
                const month = Number(value.substring(2, 4));
                const day = Number(value.substring(4, 6));

                const currentYear = new Date().getFullYear();
                const currentYY = currentYear % 100;
                const fullYear = yy > currentYY ? 1900 + yy : 2000 + yy;

                const birthDate = new Date(fullYear, month - 1, day);

                if (
                    birthDate.getFullYear() !== fullYear ||
                    birthDate.getMonth() !== month - 1 ||
                    birthDate.getDate() !== day
                ) {
                    dateOfBirth.value = "";
                    setError(idNumber, idError, "The date of birth contained in this ID number is invalid.");
                    return false;
                }

                const today = new Date();
                today.setHours(0, 0, 0, 0);

                if (birthDate > today) {
                    dateOfBirth.value = "";
                    setError(idNumber, idError, "Date of birth cannot be in the future.");
                    return false;
                }

                dateOfBirth.value =
                    fullYear + "-" +
                    String(month).padStart(2, "0") + "-" +
                    String(day).padStart(2, "0");

                setError(idNumber, idError, "");
                return true;
            }

            function validatePhone() {
                if (!phoneNumber || !phoneError) return true;

                const value = phoneNumber.value.trim();

                if (!value) {
                    setError(phoneNumber, phoneError, "Please enter the patient's phone number.");
                    return false;
                }

                if (!/^\+27\d{9}$/.test(value)) {
                    setError(phoneNumber, phoneError, "Enter a valid South African phone number, e.g. +27712345678.");
                    return false;
                }

                setError(phoneNumber, phoneError, "");
                return true;
            }

            function validatePostalCode() {
                if (!postalCode) return true;

                const value = postalCode.value.trim();

                if (!/^\d{4}$/.test(value)) {
                    postalCode.classList.add("input-invalid");
                    postalCode.classList.remove("input-valid");
                    return false;
                }

                postalCode.classList.remove("input-invalid");
                postalCode.classList.add("input-valid");
                return true;
            }

            if (idNumber) {
                idNumber.addEventListener("input", validateID);
                idNumber.addEventListener("blur", validateID);
            }

            if (phoneNumber) {
                phoneNumber.addEventListener("input", validatePhone);
                phoneNumber.addEventListener("blur", validatePhone);
            }

            if (postalCode) {
                postalCode.addEventListener("input", validatePostalCode);
                postalCode.addEventListener("blur", validatePostalCode);
            }

            // Category expand/collapse
            window.toggleCategory = function (header) {
                const group = header.closest(".category-group");
                if (!group) return;

                group.classList.toggle("collapsed");
                header.setAttribute(
                    "aria-expanded",
                    group.classList.contains("collapsed") ? "false" : "true"
                );
            };

            window.toggleCategoryKeyboard = function (event, header) {
                if (event.key === "Enter" || event.key === " ") {
                    event.preventDefault();
                    window.toggleCategory(header);
                }
            };

            // Search and filter medical history categories
            window.filterOptions = function (type) {
                const settings = {
                    condition: {
                        input: "conditionSearch",
                        list: "conditionsList",
                        empty: "conditionNoResults"
                    },
                    allergy: {
                        input: "allergySearch",
                        list: "allergiesList",
                        empty: "allergyNoResults"
                    },
                    medication: {
                        input: "medicationSearch",
                        list: "medicationsList",
                        empty: "medicationNoResults"
                    }
                };

                const config = settings[type];
                if (!config) return;

                const searchInput = document.getElementById(config.input);
                const list = document.getElementById(config.list);
                const noResults = document.getElementById(config.empty);

                if (!searchInput || !list || !noResults) return;

                const term = searchInput.value.toLowerCase().trim();
                const groups = list.querySelectorAll(".category-group");
                let totalMatches = 0;

                groups.forEach(function (group) {
                    const categoryName = group.dataset.category || "";
                    const items = group.querySelectorAll(".option-item");
                    let groupMatches = 0;

                    items.forEach(function (item) {
                        const name = item.dataset.name || "";

                        const matches =
                            term === "" ||
                            name.includes(term) ||
                            categoryName.includes(term);

                        item.hidden = !matches;

                        if (matches) {
                            groupMatches++;
                            totalMatches++;
                        }
                    });

                    group.style.display = groupMatches > 0 ? "" : "none";

                    // Automatically expand matching categories while searching.
                    if (term !== "" && groupMatches > 0) {
                        group.classList.remove("collapsed");
                        const header = group.querySelector(".category-header");
                        if (header) header.setAttribute("aria-expanded", "true");
                    }
                });

                noResults.classList.toggle("show", term !== "" && totalMatches === 0);
            };

            // Selected items panels
            const selectedMappings = [
                {
                    checkboxSelector: 'input[name="SelectedConditionIds"]',
                    containerId: "selectedConditionsList",
                    emptyText: "No conditions selected."
                },
                {
                    checkboxSelector: 'input[name="SelectedAllergyIds"]',
                    containerId: "selectedAllergiesList",
                    emptyText: "No allergies selected."
                },
                {
                    checkboxSelector: 'input[name="SelectedMedicationIds"]',
                    containerId: "selectedMedicationsList",
                    emptyText: "No medications selected."
                }
            ];

            function renderSelected(map) {
                const container = document.getElementById(map.containerId);
                if (!container) return;

                container.replaceChildren();

                const checked = Array.from(
                    document.querySelectorAll(map.checkboxSelector)
                ).filter(function (checkbox) {
                    return checkbox.checked;
                });

                if (checked.length === 0) {
                    const empty = document.createElement("p");
                    empty.className = "selected-empty";
                    empty.textContent = map.emptyText;
                    container.appendChild(empty);
                    return;
                }

                checked.forEach(function (checkbox) {
                    const labelElement = document.querySelector(
                        'label[for="' + checkbox.id + '"]'
                    );

                    const labelText = labelElement
                        ? labelElement.textContent.trim()
                        : checkbox.value;

                    const chip = document.createElement("span");
                    chip.className = "selected-chip";

                    const label = document.createElement("span");
                    label.textContent = labelText;

                    const removeButton = document.createElement("button");
                    removeButton.type = "button";
                    removeButton.textContent = "×";
                    removeButton.title = "Remove " + labelText;
                    removeButton.setAttribute("aria-label", "Remove " + labelText);

                    removeButton.addEventListener("click", function () {
                        checkbox.checked = false;
                        checkbox.dispatchEvent(new Event("change", { bubbles: true }));
                    });

                    chip.append(label, removeButton);
                    container.appendChild(chip);
                });
            }

            selectedMappings.forEach(function (map) {
                document.querySelectorAll(map.checkboxSelector).forEach(function (checkbox) {
                    checkbox.addEventListener("change", function () {
                        renderSelected(map);
                    });
                });

                renderSelected(map);
            });

            // Form validation
            form.addEventListener("submit", function (event) {
                const idValid = validateID();
                const phoneValid = validatePhone();
                const postalValid = validatePostalCode();

                let addressValid = true;

                if (provinceSelect && !provinceSelect.value) {
                    provinceSelect.classList.add("input-invalid");
                    addressValid = false;
                } else if (provinceSelect) {
                    provinceSelect.classList.remove("input-invalid");
                }

                if (cityInput && !cityInput.value.trim()) {
                    cityInput.classList.add("input-invalid");
                    addressValid = false;
                } else if (cityInput) {
                    cityInput.classList.remove("input-invalid");
                }

                if (!idValid || !phoneValid || !postalValid || !addressValid) {
                    event.preventDefault();

                    const firstInvalid = form.querySelector(".input-invalid");

                    if (firstInvalid) {
                        firstInvalid.focus();
                        firstInvalid.scrollIntoView({
                            behavior: "smooth",
                            block: "center"
                        });
                    }
                }
            });

            const idServerError = document.querySelector('[data-valmsg-for="IDNumber"]');

            if (idServerError && idServerError.textContent.trim() && idNumber) {
                idNumber.classList.add("input-invalid");
                idNumber.setAttribute("aria-invalid", "true");
            }
        });
    </script>
}
