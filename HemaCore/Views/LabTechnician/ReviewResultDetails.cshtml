@model HemaCore.Models.TestResultVerification

@{
    ViewData["Title"] = "Review Result";
    Layout = "_LabTechnicianLayout";

    var result = Model.TestResult;
    var test = result?.TestRequestTestType.FirstOrDefault();
}

<div class="container-fluid px-4 py-4">

    <!-- HEADER -->
    <div class="mb-4">
        <h2 class="fw-bold">
            Review Result
        </h2>

        <p class="text-muted mb-0">
            Review and correct the test result that was sent back for further attention.
        </p>
    </div>


    <!-- PATIENT & TEST INFORMATION -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">

            <h5 class="fw-bold mb-4">
                <i class="fas fa-user me-2"></i>
                Patient & Test Information
            </h5>

            <div class="row g-4">

                <div class="col-md-3">
                    <small class="text-muted">
                        Request Number
                    </small>

                    <div class="fw-semibold">
                        #@test?.TestRequestId
                    </div>
                </div>

                <div class="col-md-3">
                    <small class="text-muted">
                        Patient
                    </small>

                    <div class="fw-semibold">
                        @test?.TestRequest?.Patient?.Name
                        @test?.TestRequest?.Patient?.Surname
                    </div>
                </div>

                <div class="col-md-3">
                    <small class="text-muted">
                        Test Type
                    </small>

                    <div class="fw-semibold">
                        @test?.TestType?.TestTypeName
                    </div>
                </div>

                <div class="col-md-3">
                    <small class="text-muted">
                        Original Result Date
                    </small>

                    <div class="fw-semibold">
                        @(result?.DateCaptured.ToString("dd/MM/yyyy HH:mm") ?? "-")
                    </div>
                </div>

            </div>

        </div>
    </div>


    <!-- VERIFIER'S REASON -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">

            <h5 class="fw-bold mb-3">
                <i class="fas fa-exclamation-circle me-2"></i>
                Reason for Review
            </h5>

            <p class="text-muted mb-2">
                The following feedback was provided by the technician who reviewed this result.
            </p>

            <div class="border rounded p-3 bg-light">

                @if (string.IsNullOrWhiteSpace(Model.ReviewNotes))
                {
                    <span class="text-muted">
                        No review notes were provided.
                    </span>
                }
                else
                {
                    @Model.ReviewNotes
                }

            </div>

        </div>
    </div>


    <!-- CURRENT RESULT -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">

            <h5 class="fw-bold mb-4">
                <i class="fas fa-vial me-2"></i>
                Current Result
            </h5>

            <div class="row g-4">

                <div class="col-md-6">

                    <small class="text-muted">
                        Current Result Value
                    </small>

                    <div class="mt-2">

                        @if (result?.IsAbnormal == true)
                        {
                            <span class="badge bg-danger fs-6">
                                @result.ResultValue
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-success fs-6">
                                @result?.ResultValue
                            </span>
                        }

                    </div>

                </div>

                <div class="col-md-6">

                    <small class="text-muted">
                        Current Result Status
                    </small>

                    <div class="mt-2">

                        @if (result?.IsAbnormal == true)
                        {
                            <span class="badge bg-danger">
                                Abnormal
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-success">
                                Normal
                            </span>
                        }

                    </div>

                </div>

                <div class="col-12">

                    <small class="text-muted">
                        Technician Notes
                    </small>

                    <div class="border rounded p-3 mt-2 bg-light">

                        @(string.IsNullOrWhiteSpace(result?.Notes)
                            ? "No notes were provided."
                            : result.Notes)

                    </div>

                </div>

            </div>

        </div>
    </div>


    <!-- CORRECTION -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">

            <h5 class="fw-bold mb-3">
                <i class="fas fa-edit me-2"></i>
                Correct Result
            </h5>

            <p class="text-muted">
                Review the feedback above, make any necessary corrections,
                and resubmit the result for verification.
            </p>

            <form asp-action="CompleteReview" method="post">

                <input type="hidden"
                       name="id"
                       value="@Model.TestResultVerificationId" />


                <!-- RESULT VALUE -->
                <div class="mb-3">

                    <label class="form-label fw-semibold">
                        Result Value
                    </label>

                    <input type="text"
                           name="resultValue"
                           class="form-control"
                           value="@result?.ResultValue"
                           required />

                </div>


                <!-- NOTES -->
                <div class="mb-3">

                    <label class="form-label fw-semibold">
                        Technician Notes
                    </label>

                    <textarea name="notes"
                              class="form-control"
                              rows="4"
                              placeholder="Enter any relevant notes about the corrected result">@result?.Notes</textarea>

                </div>


                <!-- ACTIONS -->
                <div class="d-flex gap-2">

                    <a asp-action="ReviewResults"
                       class="btn btn-secondary">

                        <i class="fas fa-arrow-left me-1"></i>
                        Back

                    </a>


                    <button type="submit"
                            class="btn btn-primary">

                        <i class="fas fa-paper-plane me-1"></i>
                        Resubmit for Verification

                    </button>

                </div>

            </form>

        </div>
    </div>

</div>