@model HemaCore.Models.TestResultVerification
@using HemaCore.Models
@using System.Linq

@{
    ViewData["Title"] = "Review Result";
    Layout = "_LabTechnicianLayout";

    var result = Model.TestResult;
    var test = result?.TestRequestTestType?.FirstOrDefault();
    var request = test?.TestRequest;
    var patient = request?.Patient;
    var testType = test?.TestType;

    var history = ViewBag.TestResultHistory as IEnumerable<TestResultHistory>
                  ?? Enumerable.Empty<TestResultHistory>();

    var historyRecords = history.OrderBy(h => h.ActionDateTime).ToList();

    var conditions = ViewBag.PatientConditions as IEnumerable<PatientCondition>
                     ?? Enumerable.Empty<PatientCondition>();

    var allergies = ViewBag.PatientAllergies as IEnumerable<PatientAllergy>
                    ?? Enumerable.Empty<PatientAllergy>();

    var medications = ViewBag.PatientMedications as IEnumerable<PatientMedication>
                      ?? Enumerable.Empty<PatientMedication>();

    var patientName = patient != null
        ? $"{patient.Name} {patient.Surname}"
        : "N/A";

    var normalMin = ViewBag.NormalRangeMin;
    var normalMax = ViewBag.NormalRangeMax;

    var testUnit = ViewBag.TestUnit as string
                   ?? testType?.UnitOfMeasurement
                   ?? "";

    var referenceRange = normalMin != null && normalMax != null
        ? $"{normalMin} – {normalMax} {testUnit}".Trim()
        : "Not available";
}

<div class="review-page">

    <header class="page-heading">
        <a asp-action="ReviewResults" class="back-link">
            &larr; Back to review list
        </a>
        <h2>Review test result</h2>
    </header>

    <section class="summary-bar">
        <div>
            <span class="field-label">Patient</span>
            <strong>@patientName</strong>
        </div>
        <div>
            <span class="field-label">Test</span>
            <strong>@(testType?.TestTypeName ?? "N/A")</strong>
        </div>
        <div>
            <span class="field-label">Request number</span>
            <strong>@(request?.TestRequestId.ToString() ?? "N/A")</strong>
        </div>
        <div>
            <span class="field-label">Result captured</span>
            <strong>
                @(result == null
                    ? "N/A"
                    : result.DateCaptured.ToString("dd MMM yyyy, HH:mm"))
            </strong>
        </div>
    </section>

    <section class="review-card">
        <div class="section-heading">
            <h5>Patient information</h5>
        </div>

        <div class="details-grid">
            <div>
                <span class="field-label">Full name</span>
                <span>@patientName</span>
            </div>
            <div>
                <span class="field-label">ID number</span>
                <span>@(patient?.IDNumber ?? "Not recorded")</span>
            </div>
            <div>
                <span class="field-label">Date of birth</span>
                <span>
                    @(patient == null
                        ? "Not recorded"
                        : patient.DateOfBirth.ToString("dd MMM yyyy"))
                </span>
            </div>
            <div>
                <span class="field-label">Gender</span>
                <span>@(patient?.Gender ?? "Not recorded")</span>
            </div>
            <div>
                <span class="field-label">Contact number</span>
                <span>@(patient?.PhoneNumber ?? "Not recorded")</span>
            </div>
        </div>
    </section>

    <section class="review-card">
        <div class="section-heading">
            <h5>Medical background</h5>
        </div>

        <div class="medical-grid">
            <div class="medical-section">
                <h6>Conditions</h6>
                @if (conditions.Any())
                {
                    <ul>
                        @foreach (var item in conditions)
                        {
                            <li>@(item.Condition?.Name ?? "Unavailable")</li>
                        }
                    </ul>
                }
                else
                {
                    <p class="empty-text">None recorded.</p>
                }
            </div>

            <div class="medical-section">
                <h6>Allergies</h6>
                @if (allergies.Any())
                {
                    <ul>
                        @foreach (var item in allergies)
                        {
                            <li>@(item.Allergy?.Name ?? "Unavailable")</li>
                        }
                    </ul>
                }
                else
                {
                    <p class="empty-text">None recorded.</p>
                }
            </div>

            <div class="medical-section">
                <h6>Medications</h6>
                @if (medications.Any())
                {
                    <ul>
                        @foreach (var item in medications)
                        {
                            <li>
                                <strong>@(item.Medication?.Name ?? "Unavailable")</strong>
                                @if (!string.IsNullOrWhiteSpace(item.Dosage))
                                {
                                    <span class="medication-detail">@item.Dosage</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(item.Frequency))
                                {
                                    <span class="medication-detail">@item.Frequency</span>
                                }
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="empty-text">None recorded.</p>
                }
            </div>
        </div>
    </section>

    <section class="review-card feedback-card">
        <div class="section-heading">
            <h5>Reviewer feedback</h5>
            <span class="status-pill status-review">Correction required</span>
        </div>

        <div class="card-content">
            @if (string.IsNullOrWhiteSpace(Model.ReviewNotes))
            {
                <p class="empty-text">No review notes provided.</p>
            }
            else
            {
                <p class="feedback-text">@Model.ReviewNotes</p>
            }
        </div>
    </section>

    <section class="review-card">
        <div class="section-heading">
            <h5>Current result</h5>
            @if (result?.IsAbnormal == true)
            {
                <span class="status-pill status-abnormal">Abnormal</span>
            }
            else
            {
                <span class="status-pill status-neutral">Not flagged abnormal</span>
            }
        </div>

        <div class="result-content">
            <div>
                <span class="field-label">Recorded value</span>
                <div class="result-value @(string.IsNullOrWhiteSpace(result?.ResultValue) ? "muted-value" : "")">
                    @(string.IsNullOrWhiteSpace(result?.ResultValue)
                        ? "Not recorded"
                        : $"{result.ResultValue} {testUnit}".Trim())
                </div>

                <div class="reference-info">
                    <span class="field-label">Reference range</span>
                    <strong>@referenceRange</strong>
                </div>
            </div>

            <div class="result-notes">
                <span class="field-label">Technician notes</span>
                @if (string.IsNullOrWhiteSpace(result?.Notes))
                {
                    <p class="empty-text">No notes recorded.</p>
                }
                else
                {
                    <p class="notes-content">@result.Notes</p>
                }
            </div>
        </div>
    </section>

    
    <!-- Test history -->
    <!-- Test history -->
    <section class="review-card">
        <div class="history-heading">
            <div>
                <h5>Test history</h5>
                <p>Recorded actions and result changes for this test.</p>
            </div>

            <span class="history-count">
                @historyRecords.Count @(historyRecords.Count == 1 ? "entry" : "entries")
            </span>
        </div>

        <div class="history-table-wrapper">
            <table class="history-table">
                <thead>
                    <tr>
                        <th>Date &amp; Time</th>
                        <th>Action</th>
                        <th>Technician</th>
                        <th>Captured Value</th>
                        <th>Notes</th>
                    </tr>
                </thead>

                <tbody>
                    @if (historyRecords.Any())
                    {
                        foreach (var item in historyRecords)
                        {
                            var actionLabel = item.Action switch
                            {
                                "Result Captured" => "Result Captured",
                                "Sent Back for Review" => "Sent Back For Review",
                                "Sent Back For Review" => "Sent Back For Review",
                                "Corrected Result Resubmitted" => "Resubmitted",
                                "Result Verified" => "Verified",
                                _ => item.Action
                            };

                            var isSentBack =
                                item.Action == "Sent Back for Review" ||
                                item.Action == "Sent Back For Review";

                            var actionClass = isSentBack
                                ? "action-returned"
                                : item.Action == "Result Verified"
                                    ? "action-verified"
                                    : item.Action == "Corrected Result Resubmitted"
                                        ? "action-resubmitted"
                                        : "action-captured";

                            <tr>
                                <td class="history-date">
                                    @item.ActionDateTime.ToString("dd MMM yyyy")
                                    <span>@item.ActionDateTime.ToString("HH:mm")</span>
                                </td>

                                <td>
                                    <span class="action-label @actionClass">
                                        @actionLabel
                                    </span>
                                </td>

                                <td class="history-user">
                                    @(item.LabTechnician?.User?.FullName ?? "Unknown user")
                                </td>

                                <td class="captured-value">
                                    @if (isSentBack)
                                    {
                                        <span class="no-value">—</span>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(item.ResultValue))
                                    {
                                        @($"{item.ResultValue} {testUnit}".Trim())
                                    }
                                    else
                                    {
                                        <span class="no-value">—</span>
                                    }
                                </td>

                                <td class="history-notes">
                                    @if (!string.IsNullOrWhiteSpace(item.ReviewNotes))
                                    {
                                        @item.ReviewNotes
                                    }
                                    else if (!string.IsNullOrWhiteSpace(item.ResultNotes))
                                    {
                                        @item.ResultNotes
                                    }
                                    else
                                    {
                                        <span class="no-value">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="history-empty">
                                No test history recorded.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
    <section class="review-card correction-card">
        <div class="section-heading">
            <h5>Correct result</h5>
        </div>

        <form asp-action="CompleteReview" method="post" class="correction-form">
            @Html.AntiForgeryToken()

            <input type="hidden" name="id" value="@Model.TestResultVerificationId" />

            <div class="form-field">
                <label for="resultValue" class="form-label">Corrected result value</label>
                <input type="text"
                       id="resultValue"
                       name="resultValue"
                       class="form-control"
                       value="@result?.ResultValue"
                       required />
            </div>

            <div class="form-field">
                <label for="notes" class="form-label">Technician notes</label>
                <textarea id="notes"
                          name="notes"
                          class="form-control"
                          rows="3"
                          placeholder="Add notes if needed.">@result?.Notes</textarea>
            </div>

            <div class="form-actions">
                <a asp-action="ReviewResults" class="btn btn-outline-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">
                    Resubmit for verification
                </button>
            </div>
        </form>
    </section>

</div>


<style>
    .review-page {
        max-width: 1120px;
        margin: 0 auto;
        padding: 22px 20px 40px;
        color: #24313b;
        font-size: 14px;
        line-height: 1.5;
    }

    .page-heading {
        margin-bottom: 18px;
    }

    .back-link {
        display: inline-block;
        margin-bottom: 10px;
        color: #52606d;
        font-size: 13px;
        text-decoration: none;
    }

        .back-link:hover {
            color: #0f766e;
        }

    .page-heading h2 {
        margin: 0;
        font-size: 24px;
        font-weight: 650;
    }

    .summary-bar {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        margin-bottom: 16px;
        background: #fff;
        border: 1px solid #dfe5e9;
        border-radius: 7px;
    }

        .summary-bar > div {
            min-width: 0;
            padding: 13px 15px;
        }

            .summary-bar > div + div {
                border-left: 1px solid #e9edf0;
            }

        .summary-bar strong {
            display: block;
            overflow-wrap: anywhere;
            font-weight: 600;
        }

    .field-label {
        display: block;
        margin-bottom: 4px;
        color: #778590;
        font-size: 12px;
    }

    .review-card {
        margin-bottom: 15px;
        overflow: hidden;
        background: #fff;
        border: 1px solid #dfe5e9;
        border-radius: 7px;
    }

    .section-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 14px 17px;
        border-bottom: 1px solid #edf0f2;
    }

        .section-heading h5 {
            margin: 0;
            font-size: 15px;
            font-weight: 650;
        }

    .details-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 18px 22px;
        padding: 18px;
    }

        .details-grid > div {
            min-width: 0;
            overflow-wrap: anywhere;
        }

    .medical-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        padding: 0 18px;
    }

    .medical-section {
        min-width: 0;
        padding: 15px 14px 15px 0;
    }

        .medical-section + .medical-section {
            padding-left: 18px;
            border-left: 1px solid #edf0f2;
        }

        .medical-section h6 {
            margin: 0 0 9px;
            font-size: 13px;
            font-weight: 650;
        }

        .medical-section ul {
            margin: 0;
            padding-left: 17px;
            overflow-wrap: anywhere;
        }

        .medical-section li {
            margin-bottom: 6px;
        }

    .medication-detail {
        display: block;
        color: #687782;
        font-size: 12px;
    }

    .empty-text {
        margin: 0;
        color: #788590;
        font-size: 13px;
    }

    .feedback-card {
        border-left: 3px solid #c58a35;
    }

    .card-content {
        padding: 15px 18px;
    }

    .feedback-text,
    .notes-content {
        margin: 0;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
        line-height: 1.6;
    }

    .status-pill {
        display: inline-flex;
        align-items: center;
        flex-shrink: 0;
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 11px;
        font-weight: 650;
    }

    .status-review {
        color: #8a510d;
        background: #fff3df;
    }

    .status-abnormal {
        color: #b42318;
        background: #fdecea;
    }

    .status-neutral {
        color: #596873;
        background: #f0f3f5;
    }

    .result-content {
        display: grid;
        grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
        gap: 25px;
        padding: 18px;
    }

    .result-value {
        font-size: 28px;
        font-weight: 650;
        overflow-wrap: anywhere;
    }

    .muted-value {
        color: #89949c;
        font-size: 17px;
        font-weight: 400;
    }

    .reference-info {
        margin-top: 15px;
        padding-top: 12px;
        border-top: 1px solid #edf0f2;
    }

        .reference-info strong {
            font-size: 13px;
        }

    .result-notes {
        min-width: 0;
        padding-left: 22px;
        border-left: 1px solid #edf0f2;
    }

    /* Test history — matching Verify Test Result */
    .history-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        padding: 16px 20px;
        border-bottom: 1px solid #edf0f3;
    }

        .history-heading h5 {
            margin: 0;
            font-size: 16px;
            font-weight: 600;
        }

        .history-heading p {
            margin: 3px 0 0;
            color: #52606d;
            font-size: 13px;
        }

    .history-count {
        flex-shrink: 0;
        padding: 4px 9px;
        border-radius: 6px;
        background: #f0f5f6;
        color: #356f7c;
        font-size: 12px;
        font-weight: 600;
    }

    .history-table-wrapper {
        padding: 14px 16px 16px;
        overflow-x: auto;
    }

    .history-table {
        width: 100%;
        min-width: 760px;
        border-collapse: separate;
        border-spacing: 0;
        border: 1px solid #e1e6eb;
        border-radius: 7px;
        overflow: hidden;
        font-size: 13px;
    }

        .history-table thead {
            background: #edf5f6;
        }

        .history-table th {
            padding: 12px 14px;
            text-align: left;
            color: #365b63;
            font-size: 12px;
            font-weight: 600;
            white-space: nowrap;
            border-bottom: 1px solid #dce8ea;
        }

        .history-table td {
            padding: 12px 14px;
            border-bottom: 1px solid #edf0f2;
            vertical-align: middle;
        }

        .history-table tbody tr:last-child td {
            border-bottom: none;
        }

        .history-table tbody tr:nth-child(even) {
            background: #fafcfc;
        }

        .history-table tbody tr:hover {
            background: #f3f8f9;
        }

    .history-date {
        min-width: 125px;
        color: #1f2933;
        white-space: nowrap;
    }

        .history-date span {
            display: block;
            margin-top: 2px;
            color: #7b8794;
            font-size: 12px;
        }

    .history-user {
        min-width: 135px;
        font-weight: 500;
    }

    .action-label {
        display: inline-block;
        padding: 4px 9px;
        border-radius: 5px;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
    }

    .action-captured {
        background: #eef1f4;
        color: #475569;
    }

    .action-returned {
        background: #fff7e6;
        color: #9a6700;
    }

    .action-resubmitted {
        background: #eaf4f7;
        color: #356f7c;
    }

    .action-verified {
        background: #eaf6ef;
        color: #18794e;
    }

    .captured-value {
        min-width: 110px;
        font-weight: 600;
        white-space: nowrap;
    }

    .history-notes {
        min-width: 180px;
        max-width: 320px;
        overflow-wrap: anywhere;
    }

    .no-value {
        color: #9aa4af;
    }

    .history-empty {
        padding: 26px !important;
        text-align: center;
        color: #7b8794;
    }

    .correction-card {
        border-top: 3px solid #75aaba;
    }

    .correction-form {
        padding: 18px;
    }

    .form-field {
        margin-bottom: 17px;
    }

    .form-label {
        display: block;
        margin-bottom: 6px;
        font-size: 13px;
        font-weight: 600;
    }

    .correction-form .form-control {
        border-color: #d7dfe4;
        border-radius: 5px;
        font-size: 14px;
    }

        .correction-form .form-control:focus {
            border-color: #75aaba;
            box-shadow: 0 0 0 3px rgba(117, 170, 186, 0.15);
        }

    .correction-form textarea {
        resize: vertical;
    }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        flex-wrap: wrap;
        gap: 10px;
        padding-top: 15px;
        border-top: 1px solid #edf0f2;
    }

        .form-actions .btn {
            padding: 8px 14px;
            border-radius: 5px;
            font-size: 13px;
            font-weight: 600;
        }

        .form-actions .btn-primary {
            border-color: #0f766e;
            background: #0f766e;
        }

            .form-actions .btn-primary:hover {
                border-color: #115e59;
                background: #115e59;
            }

    @@media (max-width: 768px) {
        .review-page {
            padding: 16px 12px 28px;
        }

        .summary-bar {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

            .summary-bar > div:nth-child(3) {
                border-left: none;
            }

            .summary-bar > div:nth-child(n+3) {
                border-top: 1px solid #e9edf0;
            }

        .details-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 16px;
        }

        .medical-grid {
            grid-template-columns: 1fr;
        }

        .medical-section {
            padding: 13px 0;
        }

            .medical-section + .medical-section {
                padding-left: 0;
                border-top: 1px solid #edf0f2;
                border-left: none;
            }

        .result-content {
            grid-template-columns: 1fr;
            gap: 18px;
        }

        .result-notes {
            padding: 15px 0 0;
            border-top: 1px solid #edf0f2;
            border-left: none;
        }

        .history-heading {
            padding: 14px;
        }

        .history-table-wrapper {
            padding: 12px;
        }
    }

    @@media (max-width: 480px) {
        .summary-bar,
        .details-grid {
            grid-template-columns: 1fr;
        }

            .summary-bar > div + div {
                border-top: 1px solid #e9edf0;
                border-left: none;
            }

        .section-heading {
            align-items: flex-start;
            gap: 8px;
        }

        .status-pill {
            white-space: normal;
        }

        .form-actions {
            flex-direction: column-reverse;
        }

            .form-actions .btn {
                width: 100%;
            }
    }
</style>
