
@model HemaCore.Models.ViewModels.LabTechnicianReportViewModel

@{
    ViewData["Title"] = "Lab Technician Reports";
    Layout = "_LabTechnicianLayout";

    var generatedAt = DateTime.Now;
    var tests = (Model.Tests ?? new List<HemaCore.Models.ViewModels.LabTechnicianReportItemViewModel>())
        .OrderByDescending(t => t.CompletionDateTime)
        .ThenBy(t => t.TestRequestId)
        .ToList();

    var hasFilters =
        Model.FromDate.HasValue ||
        Model.ToDate.HasValue ||
        !string.IsNullOrWhiteSpace(Model.TestType) ||
        !string.IsNullOrWhiteSpace(Model.Status) ||
        !string.IsNullOrWhiteSpace(Model.Urgency);

    string DisplayStatus(string? value) =>
        value == "InProgress" ? "In progress" : value ?? "N/A";

    string DisplayDate(DateTime? value) =>
        value.HasValue ? value.Value.ToString("dd MMM yyyy") : "—";

    string DisplayTurnaround(double? minutes)
    {
        if (!minutes.HasValue)
        {
            return "—";
        }

        var total = Math.Max(0, (int)Math.Round(minutes.Value));

        return total < 60
            ? $"{total} min"
            : $"{total / 60}h {total % 60}min";
    }
}

<div class="report-page">

    <header class="report-heading">
        <div>
            <div class="report-eyebrow">HEMACORE / REPORTING</div>
            <h1>Lab Technician Reports</h1>
            <p>Review test processing, results and turnaround times.</p>
        </div>

        <div class="report-generated">
            <span>Report preview generated</span>
            <strong>@generatedAt.ToString("dd MMM yyyy")</strong>
            <span>@generatedAt.ToString("HH:mm")</span>
        </div>
    </header>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success py-2 small">
            @TempData["SuccessMessage"]
        </div>
    }

    <section class="report-panel">
        <div class="panel-heading">
            <div>
                <h2>Report criteria</h2>
                <p>Apply filters to narrow down the report data.</p>
            </div>
        </div>

        <form asp-action="Reports" method="get" class="filter-form">
            <div class="filter-field">
                <label for="fromDate">Completion date from</label>
                <input type="date"
                       id="fromDate"
                       name="fromDate"
                       class="form-control form-control-sm"
                       value="@Model.FromDate?.ToString("yyyy-MM-dd")" />
            </div>

            <div class="filter-field">
                <label for="toDate">Completion date to</label>
                <input type="date"
                       id="toDate"
                       name="toDate"
                       class="form-control form-control-sm"
                       value="@Model.ToDate?.ToString("yyyy-MM-dd")" />
            </div>

            <div class="filter-field">
                <label for="testType">Test type</label>
                <select id="testType"
                        name="testType"
                        class="form-select form-select-sm">
                    <option value="">All test types</option>
                    <option value="Full Blood Count"
                            selected="@(Model.TestType == "Full Blood Count")">
                        Full Blood Count
                    </option>
                    <option value="ESR"
                            selected="@(Model.TestType == "ESR")">
                        ESR
                    </option>
                    <option value="Blood Group"
                            selected="@(Model.TestType == "Blood Group")">
                        Blood Group
                    </option>
                </select>
            </div>

            <div class="filter-field">
                <label for="status">Test status</label>
                <select id="status"
                        name="status"
                        class="form-select form-select-sm">
                    <option value="">All statuses</option>
                    <option value="Completed"
                            selected="@(Model.Status == "Completed")">
                        Completed
                    </option>
                    <option value="InProgress"
                            selected="@(Model.Status == "InProgress")">
                        In progress
                    </option>
                </select>
            </div>

            <div class="filter-field">
                <label for="urgency">Urgency</label>
                <select id="urgency"
                        name="urgency"
                        class="form-select form-select-sm">
                    <option value="">All urgency levels</option>
                    <option value="Routine"
                            selected="@(Model.Urgency == "Routine")">
                        Routine
                    </option>
                    <option value="Urgent"
                            selected="@(Model.Urgency == "Urgent")">
                        Urgent
                    </option>
                    <option value="STAT"
                            selected="@(Model.Urgency == "STAT")">
                        STAT
                    </option>
                </select>
            </div>

            <div class="filter-actions">
                <button type="submit" class="btn btn-dark btn-sm">
                    <i class="fas fa-filter me-1"></i>
                    Generate report
                </button>

                <a asp-action="Reports"
                   class="btn btn-outline-secondary btn-sm">
                    Clear filters
                </a>
            </div>
        </form>
    </section>

    <section class="summary-section">
        <div class="section-heading">
            <div>
                <h2>Report summary</h2>
                <p>Overview of the records matching your criteria.</p>
            </div>
        </div>

        <div class="summary-grid">
            <article class="summary-card">
                <span>Total tests</span>
                <strong>@Model.TotalTests</strong>
                <small>Matching records</small>
            </article>

            <article class="summary-card">
                <span>Completed</span>
                <strong>@Model.CompletedTests</strong>
                <small>Completed tests</small>
            </article>

            <article class="summary-card">
                <span>In progress</span>
                <strong>@Model.InProgressTests</strong>
                <small>Tests being processed</small>
            </article>

            <article class="summary-card @(Model.AbnormalResults > 0 ? "summary-warning" : "")">
                <span>Abnormal results</span>
                <strong>@Model.AbnormalResults</strong>
                <small>Flagged results</small>
            </article>
        </div>
    </section>

    <section class="report-panel results-panel">
        <div class="panel-heading results-heading">
            <div>
                <h2>Test details</h2>
                <p>
                    @if (hasFilters)
                    {
                        <span>Filtered results</span>
                    }
                    else
                    {
                        <span>All available report records</span>
                    }
                    <span class="record-count">@tests.Count records</span>
                </p>
            </div>

            <a asp-action="ExportReportPdf"
               asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
               asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")"
               asp-route-testType="@Model.TestType"
               asp-route-status="@Model.Status"
               asp-route-urgency="@Model.Urgency"
               class="btn btn-outline-dark btn-sm">
                <i class="fas fa-file-pdf me-1"></i>
                Export PDF
            </a>
        </div>

        <div class="criteria-strip">
            <div>
                <span>Date range</span>
                <strong>
                    @(Model.FromDate?.ToString("dd MMM yyyy") ?? "Any date")
                    –
                    @(Model.ToDate?.ToString("dd MMM yyyy") ?? "Any date")
                </strong>
            </div>
            <div>
                <span>Test type</span>
                <strong>@(string.IsNullOrWhiteSpace(Model.TestType) ? "All" : Model.TestType)</strong>
            </div>
            <div>
                <span>Status</span>
                <strong>@(string.IsNullOrWhiteSpace(Model.Status) ? "All" : DisplayStatus(Model.Status))</strong>
            </div>
            <div>
                <span>Urgency</span>
                <strong>@(string.IsNullOrWhiteSpace(Model.Urgency) ? "All" : Model.Urgency)</strong>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table report-table">
                <thead>
                    <tr>
                        <th scope="col">Request</th>
                        <th scope="col">Patient</th>
                        <th scope="col">Test type</th>
                        <th scope="col">Technician</th>
                        <th scope="col">Urgency</th>
                        <th scope="col">Status</th>
                        <th scope="col">Result</th>
                        <th scope="col">Completed</th>
                        <th scope="col" class="text-end">Turnaround</th>
                    </tr>
                </thead>

                <tbody>
                    @if (!tests.Any())
                    {
                        <tr>
                            <td colspan="9" class="empty-state">
                                <div class="empty-title">No records found</div>
                                <p>
                                    No tests match the selected criteria.
                                    Try changing the date range or clearing the filters.
                                </p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var test in tests)
                        {
                            var urgencyClass = test.Urgency switch
                            {
                                "STAT" => "status-stat",
                                "Urgent" => "status-urgent",
                                _ => "status-neutral"
                            };

                            var statusClass = test.Status switch
                            {
                                "Completed" => "status-completed",
                                "InProgress" => "status-progress",
                                _ => "status-neutral"
                            };

                            <tr>
                                <td class="request-number">
                                    #@test.TestRequestId
                                </td>

                                <td class="patient-cell">
                                    @(string.IsNullOrWhiteSpace(test.PatientName)
                                        ? "N/A"
                                        : test.PatientName)
                                </td>

                                <td>@test.TestTypeName</td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(test.TechnicianName)
                                        ? "N/A"
                                        : test.TechnicianName)
                                </td>

                                <td>
                                    <span class="status-pill @urgencyClass">
                                        @test.Urgency
                                    </span>
                                </td>

                                <td>
                                    <span class="status-pill @statusClass">
                                        @DisplayStatus(test.Status)
                                    </span>
                                </td>

                                <td>
                                    @if (string.IsNullOrWhiteSpace(test.ResultValue)
                                        || test.ResultValue == "N/A")
                                    {
                                        <span class="muted-value">—</span>
                                    }
                                    else
                                    {
                                        <span class="result-value @(test.IsAbnormal ? "result-abnormal" : "")">
                                            @test.ResultValue
                                        </span>

                                        @if (test.IsAbnormal)
                                        {
                                            <span class="abnormal-label">Abnormal</span>
                                        }
                                    }
                                </td>

                                <td class="date-cell">
                                    @DisplayDate(test.CompletionDateTime)
                                </td>

                                <td class="text-end turnaround-cell">
                                    @DisplayTurnaround(test.TurnaroundMinutes)
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="table-footnote">
            <span>HemaCore · Lab Technician Reporting</span>
            <span>Preview generated @generatedAt.ToString("dd MMM yyyy, HH:mm")</span>
        </div>
    </section>
</div>

<style>
    .report-page {
        --report-ink: #29323a;
        --report-muted: #6b747d;
        --report-border: #dfe4e8;
        --report-soft: #f6f7f8;
        --report-accent: #3f6269;
        padding: 22px 24px 36px;
        max-width: 1500px;
        margin: 0 auto;
        color: var(--report-ink);
        font-size: 13px;
        line-height: 1.45;
    }

    .report-page * {
        box-sizing: border-box;
    }

    .report-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 22px;
    }

    .report-eyebrow {
        margin-bottom: 5px;
        color: var(--report-muted);
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 1px;
    }

    .report-heading h1 {
        margin: 0;
        font-size: 22px;
        font-weight: 650;
        letter-spacing: -0.3px;
    }

    .report-heading p {
        margin: 5px 0 0;
        color: var(--report-muted);
        font-size: 12px;
    }

    .report-generated {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 2px;
        color: var(--report-muted);
        font-size: 11px;
        white-space: nowrap;
    }

    .report-generated strong {
        color: var(--report-ink);
        font-size: 12px;
        font-weight: 600;
    }

    .report-panel {
        margin-bottom: 18px;
        overflow: hidden;
        background: #fff;
        border: 1px solid var(--report-border);
        border-radius: 7px;
    }

    .panel-heading,
    .section-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
    }

    .panel-heading {
        padding: 14px 17px;
        border-bottom: 1px solid var(--report-border);
    }

    .panel-heading h2,
    .section-heading h2 {
        margin: 0;
        font-size: 14px;
        font-weight: 650;
    }

    .panel-heading p,
    .section-heading p {
        margin: 3px 0 0;
        color: var(--report-muted);
        font-size: 11px;
    }

    .filter-form {
        display: grid;
        grid-template-columns: repeat(5, minmax(120px, 1fr));
        gap: 13px;
        padding: 17px;
        align-items: end;
    }

    .filter-field {
        min-width: 0;
    }

    .filter-field label {
        display: block;
        margin-bottom: 5px;
        color: #414a52;
        font-size: 11px;
        font-weight: 600;
    }

    .filter-field .form-control,
    .filter-field .form-select {
        min-height: 33px;
        border-color: #d7dde2;
        border-radius: 4px;
        font-size: 12px;
    }

    .filter-actions {
        grid-column: 1 / -1;
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        padding-top: 13px;
        border-top: 1px solid #edf0f2;
    }

    .report-page .btn {
        border-radius: 4px;
        font-size: 11px;
        font-weight: 600;
        padding: 7px 12px;
    }

    .summary-section {
        margin-bottom: 18px;
    }

    .section-heading {
        margin-bottom: 10px;
    }

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 12px;
    }

    .summary-card {
        display: flex;
        flex-direction: column;
        gap: 4px;
        padding: 14px 16px;
        background: #fff;
        border: 1px solid var(--report-border);
        border-radius: 7px;
    }

    .summary-card > span {
        color: var(--report-muted);
        font-size: 11px;
        font-weight: 500;
    }

    .summary-card > strong {
        font-size: 25px;
        font-weight: 650;
        line-height: 1.2;
        font-variant-numeric: tabular-nums;
    }

    .summary-card > small {
        color: var(--report-muted);
        font-size: 10px;
    }

    .summary-warning {
        border-left: 3px solid #a94442;
    }

    .summary-warning > strong {
        color: #a94442;
    }

    .results-heading {
        padding: 14px 17px;
    }

    .record-count {
        display: inline-block;
        margin-left: 6px;
        padding: 2px 7px;
        background: #eef1f3;
        border-radius: 3px;
        color: #4e5962;
        font-size: 10px;
        font-weight: 600;
    }

    .criteria-strip {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        padding: 11px 17px;
        background: #fafbfb;
        border-bottom: 1px solid var(--report-border);
    }

    .criteria-strip > div {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .criteria-strip span {
        color: var(--report-muted);
        font-size: 10px;
    }

    .criteria-strip strong {
        font-size: 11px;
        font-weight: 600;
    }

    .report-table {
        width: 100%;
        min-width: 1000px;
        margin: 0;
        font-size: 11px;
        vertical-align: middle;
        border-collapse: collapse;
    }

    .report-table thead th {
        padding: 10px 11px;
        background: #f0f2f4;
        color: #4d5760;
        border-bottom: 1px solid #d9dfe4;
        font-size: 10px;
        font-weight: 700;
        white-space: nowrap;
    }

    .report-table tbody td {
        padding: 10px 11px;
        border-bottom: 1px solid #edf0f2;
        color: #303941;
    }

    .report-table tbody tr:last-child td {
        border-bottom: none;
    }

    .report-table tbody tr:hover {
        background: #fafbfc;
    }

    .request-number {
        color: var(--report-accent) !important;
        font-weight: 650;
        white-space: nowrap;
    }

    .patient-cell {
        min-width: 130px;
        font-weight: 550;
    }

    .date-cell,
    .turnaround-cell {
        white-space: nowrap;
        font-variant-numeric: tabular-nums;
    }

    .status-pill {
        display: inline-block;
        padding: 3px 7px;
        border-radius: 4px;
        font-size: 10px;
        font-weight: 600;
        white-space: nowrap;
    }

    .status-neutral {
        background: #edf0f2;
        color: #56616a;
    }

    .status-completed {
        background: #e9f2ec;
        color: #356448;
    }

    .status-progress {
        background: #f7f0df;
        color: #88641c;
    }

    .status-urgent {
        background: #f8e9dd;
        color: #98551f;
    }

    .status-stat {
        background: #f7e6e6;
        color: #a23f3f;
    }

    .result-value {
        display: inline-block;
        overflow-wrap: anywhere;
        font-weight: 550;
    }

    .result-abnormal {
        color: #a23f3f;
    }

    .abnormal-label {
        display: block;
        margin-top: 2px;
        color: #a23f3f;
        font-size: 9px;
        font-weight: 650;
    }

    .muted-value {
        color: #929aa1;
    }

    .empty-state {
        padding: 35px 18px !important;
        text-align: center;
    }

    .empty-title {
        margin-bottom: 4px;
        color: var(--report-ink);
        font-size: 13px;
        font-weight: 650;
    }

    .empty-state p {
        margin: 0;
        color: var(--report-muted);
        font-size: 11px;
    }

    .table-footnote {
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 8px;
        padding: 10px 17px;
        background: #fafbfb;
        border-top: 1px solid var(--report-border);
        color: var(--report-muted);
        font-size: 10px;
    }

    .report-page .form-control:focus,
    .report-page .form-select:focus {
        border-color: #8babb0;
        box-shadow: 0 0 0 2px rgb(63 98 105 / 10%);
    }

    @@media (max-width: 1000px) {
        .filter-form {
            grid-template-columns: repeat(3, minmax(130px, 1fr));
        }

        .summary-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 600px) {
        .report-page {
            padding: 15px 10px 25px;
        }

        .report-heading {
            align-items: flex-start;
            flex-direction: column;
            gap: 12px;
        }

        .report-generated {
            align-items: flex-start;
        }

        .filter-form {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            padding: 13px;
        }

        .summary-grid {
            gap: 8px;
        }

        .summary-card {
            padding: 12px;
        }

        .summary-card > strong {
            font-size: 22px;
        }

        .criteria-strip {
            gap: 12px;
        }

        .panel-heading {
            align-items: flex-start;
        }

        .results-heading {
            flex-direction: column;
        }

        .table-footnote {
            flex-direction: column;
        }
    }

    @@media (max-width: 380px) {
        .filter-form,
        .summary-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
