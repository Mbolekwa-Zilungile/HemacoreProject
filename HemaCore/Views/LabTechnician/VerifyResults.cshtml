@model IEnumerable<HemaCore.Models.TestResult>

@{
    ViewData["Title"] = "Verify Test Results";
    Layout = "_LabTechnicianLayout";
}

<link rel="stylesheet" href="~/css/doctor.css" />

<div class="content-card">

    <!-- HEADER -->
    <div class="section-title d-flex align-items-center justify-content-between">

        <div class="d-flex align-items-center">

            <i class="fas fa-check-double me-2"></i>

            <span>Verify Test Results</span>

            <span class="badge blue-badge ms-2">
                @(Model?.Count() ?? 0)
            </span>

        </div>

    </div>

    <p class="text-muted mb-3">
        Review completed test results before they are released.
    </p>


    <!-- TABLE -->
    <div class="table-responsive">

        <table class="modern-table">

            <thead>

                <tr>

                    <th>Request Number</th>

                    <th>Patient</th>

                    <th>Test Type</th>

                    <th>Result</th>

                    <th>Date Captured</th>

                    <th>Action</th>

                </tr>

            </thead>

            <tbody>

                @if (Model == null || !Model.Any())
                {
                    <tr>

                        <td colspan="6" class="text-center text-muted py-4">

                            <i class="fas fa-check-double fa-2x mb-2"></i>

                            <div class="fw-semibold">
                                There are currently no test results waiting for verification.
                            </div>

                            <small>
                                Completed test results will appear here when they are ready for verification.
                            </small>

                        </td>

                    </tr>
                }
                else
                {
                    foreach (var result in Model)
                    {
                        var test = result.TestRequestTestType.FirstOrDefault();

                        <tr>

                            <!-- REQUEST NUMBER -->
                            <td class="fw-semibold blue-text">
                                #@test?.TestRequestId
                            </td>


                            <!-- PATIENT -->
                            <td>
                                @test?.TestRequest?.Patient?.Name
                                @test?.TestRequest?.Patient?.Surname
                            </td>


                            <!-- TEST TYPE -->
                            <td>
                                @test?.TestType?.TestTypeName
                            </td>


                            <!-- RESULT -->
                            <td>

                                @if (result.IsAbnormal)
                                {
                                    <span class="badge bg-danger">
                                        @result.ResultValue
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success">
                                        @result.ResultValue
                                    </span>
                                }

                            </td>


                            <!-- DATE CAPTURED -->
                            <td>
                                @result.DateCaptured.ToString("dd/MM/yyyy HH:mm")
                            </td>


                            <!-- ACTION -->
                            <td>

                                <a asp-action="VerifyResultDetails"
                                   asp-route-id="@result.TestResultId"
                                   class="btn btn-primary btn-sm">

                                    <i class="fas fa-check-double me-1"></i>
                                    Review

                                </a>

                            </td>

                        </tr>
                    }
                }

            </tbody>

        </table>

    </div>

</div>