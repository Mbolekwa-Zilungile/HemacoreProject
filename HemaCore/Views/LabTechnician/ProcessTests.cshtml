
@model IEnumerable<HemaCore.Models.TestRequestItem>

@{
    ViewData["Title"] = "Select & Process Tests";
    Layout = "_LabTechnicianLayout";
    var categories = ViewBag.Categories as List<HemaCore.Models.TestCategory>;
}

<link rel="stylesheet" href="~/css/doctor.css" />

<div class="content-card">

    @if (TempData["ResultSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
            <i class="fas fa-check-circle me-2"></i>
            @TempData["ResultSuccess"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="section-title d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center">
            <i class="fas fa-microscope me-2"></i>
            <span>Select & Process Tests</span>
            <span class="badge blue-badge ms-2">
                @(Model?.Count() ?? 0)
            </span>
        </div>
    </div>

    <p class="text-muted mb-3">
        Start an eligible test or continue a test you have already started.
    </p>

    @{
        var urgencyList = new SelectList(
            new List<string> { "Routine", "Urgent", "STAT" },
            selectedValue: Context.Request.Query["urgency"].ToString());
    }

    <form method="get" asp-action="ProcessTests" class="row g-2 mb-3">

        
    </form>

    <div class="table-responsive">
        <table class="modern-table">

            <thead>
                <tr>
                    <th>Request Number</th>
                    <th>Patient</th>
                    <th>Test Type</th>
                    <th>Category</th>
                    <th>Urgency</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">
                            <i class="fas fa-microscope fa-2x mb-2"></i>
                            <div class="fw-semibold">
                                There are currently no tests to display.
                            </div>
                            <small>
                                Eligible tests appear after their required samples have been received.
                                Tests you have already started remain available here.
                            </small>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var test in Model)
                    {
                        <tr>
                            <td class="fw-semibold blue-text">
                                #@test.TestRequestId
                            </td>

                            <td>
                                @test.TestRequest?.Patient?.Name
                                @test.TestRequest?.Patient?.Surname
                            </td>

                            <td>
                                @test.TestType?.TestTypeName
                            </td>

                            <td>
                                @test.TestType?.Category?.CategoryName
                            </td>

                            <td>
                                @test.TestRequest?.Urgency
                            </td>

                            <td>
                                @if (test.Status == "InProgress")
                                {
                                    <span class="badge bg-primary">
                                        In Progress
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">
                                        @test.Status
                                    </span>
                                }
                            </td>

                            <td>
                                @if (test.Status == "InProgress")
                                {
                                    <a asp-action="CaptureTestResult"
                                       asp-route-id="@test.TestRequestTestTypeId"
                                       class="btn btn-sm btn-success">
                                        <i class="fas fa-arrow-right me-1"></i>
                                        Continue Test
                                    </a>
                                }
                                else if (test.Status == "Submitted")
                                {
                                    <form asp-action="StartProcessing"
                                          asp-route-id="@test.TestRequestTestTypeId"
                                          method="post">
                                        <button type="submit" class="btn btn-sm btn-primary">
                                            <i class="fas fa-play me-1"></i>
                                            Start Processing
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>

        </table>
    </div>

</div>
