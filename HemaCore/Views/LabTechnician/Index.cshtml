
@model HemaCore.Models.ViewModels.LabTechnicianDashboardViewModel

@{
    ViewData["Title"] = "Lab Technician Dashboard";
    Layout = "_LabTechnicianLayout";
}

<style>

    body {
        background-color: #f5f6f8;
        color: #212529;
    }

    /* ==============================
           HEADER
           ============================== */

    .dashboard-header {
        margin-bottom: 28px;
    }

    .page-title {
        color: #1d2939;
        font-size: 25px;
        font-weight: 700;
        margin-bottom: 5px;
    }

    .page-subtitle {
        color: #667085;
        font-size: 14px;
        margin: 0;
    }

    .date-display {
        color: #667085;
        font-size: 13px;
        text-align: right;
    }


    /* ==============================
           KPI CARDS
           ============================== */

    .kpi-card {
        background: #ffffff;
        border: 1px solid #eaecf0;
        border-radius: 8px;
        transition: 0.2s ease;
        cursor: pointer;
        height: 100%;
    }

        .kpi-card:hover {
            border-color: #75AABA;
            box-shadow: 0 3px 10px rgba(0, 0, 0, 0.06);
            transform: translateY(-1px);
        }

        .kpi-card .card-body {
            padding: 18px;
        }

    .kpi-icon {
        width: 38px;
        height: 38px;
        border-radius: 7px;
        background: #f2f4f7;
        color: #475467;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
    }

    .kpi-label {
        color: #667085;
        font-size: 12px;
        font-weight: 500;
        margin-bottom: 4px;
    }

    .kpi-number {
        color: #1d2939;
        font-size: 23px;
        font-weight: 700;
        line-height: 1;
        margin: 0;
    }


    /* ==============================
           MAIN DASHBOARD CARDS
           ============================== */

    .dashboard-card {
        background: #ffffff;
        border: 1px solid #eaecf0;
        border-radius: 9px;
    }

    .section-header {
        padding: 16px 18px;
        border-bottom: 1px solid #eaecf0;
    }

    .section-title {
        color: #1d2939;
        font-size: 16px;
        font-weight: 700;
        margin: 0;
    }

    .section-description {
        color: #667085;
        font-size: 12px;
        margin: 4px 0 0;
    }


    /* ==============================
           QUICK ACTIONS
           ============================== */

    .quick-actions {
        padding: 18px;
    }

    .quick-action {
        display: flex;
        align-items: center;
        gap: 12px;
        width: 100%;
        padding: 13px 14px;
        background: #ffffff;
        border: 1px solid #d0d5dd;
        border-radius: 7px;
        color: #344054;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
        transition: 0.2s ease;
    }

        .quick-action:hover {
            border-color: #75AABA;
            background-color: #f8fbfc;
            color: #344054;
        }

        .quick-action i {
            width: 24px;
            text-align: center;
            color: #75AABA;
        }


    /* ==============================
           ATTENTION SECTION
           ============================== */

    .attention-list {
        padding: 6px 18px 10px;
    }

    .attention-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 15px 0;
        border-bottom: 1px solid #eaecf0;
    }

        .attention-item:last-child {
            border-bottom: none;
        }

    .attention-left {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .attention-icon {
        width: 34px;
        height: 34px;
        border-radius: 7px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f2f4f7;
        color: #475467;
        font-size: 13px;
    }

    .attention-label {
        color: #344054;
        font-size: 13px;
        font-weight: 500;
    }

    .attention-description {
        color: #98a2b3;
        font-size: 11px;
        margin-top: 2px;
    }

    .attention-number {
        color: #1d2939;
        font-size: 18px;
        font-weight: 700;
    }


    /* ==============================
           OVERVIEW
           ============================== */

    .overview-content {
        padding: 18px;
    }

    .overview-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 0;
        border-bottom: 1px solid #eaecf0;
    }

        .overview-item:last-child {
            border-bottom: none;
        }

    .overview-label {
        color: #667085;
        font-size: 13px;
    }

    .overview-value {
        color: #1d2939;
        font-size: 15px;
        font-weight: 700;
    }

</style>


<div class="container-fluid px-4 py-4">


    <!-- ==============================
         HEADER
         ============================== -->

    <div class="dashboard-header">

        <div class="row align-items-center">

            <div class="col">

                <h2 class="page-title">
                    Welcome, @Model.TechnicianName
                </h2>

                <p class="page-subtitle">
                    Laboratory Technician Dashboard
                </p>

            </div>

            <div class="col-auto">

                <div class="date-display">

                    <div>
                        @DateTime.Now.ToString("dd MMMM yyyy")
                    </div>

                    <div class="mt-1">
                        @DateTime.Now.ToString("HH:mm")
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ==============================
         KPI SUMMARY
         ============================== -->

    <div class="row g-3 mb-4">


        <!-- MY TESTS -->

        <div class="col-xl-3 col-md-6">

            <a asp-controller="LabTechnician"
               asp-action="ProcessTests"
               class="text-decoration-none">

                <div class="kpi-card">

                    <div class="card-body">

                        <div class="d-flex align-items-center">

                            <div class="kpi-icon">

                                <i class="fas fa-microscope"></i>

                            </div>

                            <div class="ms-3">

                                <div class="kpi-label">
                                    My Tests
                                </div>

                                <div class="kpi-number">
                                    @Model.MySelectedTests
                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </a>

        </div>


        <!-- TO BE SELECTED -->

        <div class="col-xl-3 col-md-6">

            <a asp-controller="LabTechnician"
               asp-action="ProcessTests"
               class="text-decoration-none">

                <div class="kpi-card">

                    <div class="card-body">

                        <div class="d-flex align-items-center">

                            <div class="kpi-icon">

                                <i class="fas fa-hourglass-half"></i>

                            </div>

                            <div class="ms-3">

                                <div class="kpi-label">
                                    To Be Selected
                                </div>

                                <div class="kpi-number">
                                    @Model.WaitingToBeSelected
                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </a>

        </div>


        <!-- VERIFICATION -->

        <div class="col-xl-3 col-md-6">

            <a asp-controller="LabTechnician"
               asp-action="VerifyResults"
               class="text-decoration-none">

                <div class="kpi-card">

                    <div class="card-body">

                        <div class="d-flex align-items-center">

                            <div class="kpi-icon">

                                <i class="fas fa-check-double"></i>

                            </div>

                            <div class="ms-3">

                                <div class="kpi-label">
                                    Awaiting Verification
                                </div>

                                <div class="kpi-number">
                                    @Model.WaitingVerification
                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </a>

        </div>


        <!-- REVIEW -->

        <div class="col-xl-3 col-md-6">

            <a asp-controller="LabTechnician"
               asp-action="ReviewResults"
               class="text-decoration-none">

                <div class="kpi-card">

                    <div class="card-body">

                        <div class="d-flex align-items-center">

                            <div class="kpi-icon">

                                <i class="fas fa-clipboard-check"></i>

                            </div>

                            <div class="ms-3">

                                <div class="kpi-label">
                                    To Be Reviewed
                                </div>

                                <div class="kpi-number">
                                    @Model.WaitingReview
                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </a>

        </div>

    </div>


    <!-- ==============================
         QUICK ACTIONS
         ============================== -->

    <div class="dashboard-card mb-4">

        <div class="section-header">

            <h5 class="section-title">

                <i class="fas fa-bolt me-2"></i>

                Quick Actions

            </h5>

            <p class="section-description">
                Common laboratory tasks.
            </p>

        </div>


        <div class="quick-actions">

            <div class="row g-3">


                <!-- RECEIVE SAMPLES -->

                <div class="col-md-3">

                    <a asp-controller="LabTechnician"
                       asp-action="ReceiveSample"
                       class="quick-action">

                        <i class="fas fa-vial"></i>

                        <span>
                            Receive Samples
                        </span>

                    </a>

                </div>


                <!-- PROCESS TESTS -->

                <div class="col-md-3">

                    <a asp-controller="LabTechnician"
                       asp-action="ProcessTests"
                       class="quick-action">

                        <i class="fas fa-microscope"></i>

                        <span>
                            Process Tests
                        </span>

                    </a>

                </div>


                <!-- VERIFY RESULTS -->

                <div class="col-md-3">

                    <a asp-controller="LabTechnician"
                       asp-action="VerifyResults"
                       class="quick-action">

                        <i class="fas fa-check-double"></i>

                        <span>
                            Verify Results
                        </span>

                    </a>

                </div>


                <!-- REVIEW RESULTS -->

                <div class="col-md-3">

                    <a asp-controller="LabTechnician"
                       asp-action="ReviewResults"
                       class="quick-action">

                        <i class="fas fa-clipboard-check"></i>

                        <span>
                            Review Results
                        </span>

                    </a>

                </div>

            </div>

        </div>

    </div>


    <!-- ==============================
         LOWER DASHBOARD
         ============================== -->

    <div class="row g-4">


        <!-- ATTENTION -->

        <div class="col-lg-7">

            <div class="dashboard-card">

                <div class="section-header">

                    <h5 class="section-title">

                        <i class="fas fa-exclamation-circle me-2"></i>

                        Attention

                    </h5>

                    <p class="section-description">
                        Items that may require priority.
                    </p>

                </div>


                <div class="attention-list">


                    <!-- URGENT -->

                    <div class="attention-item">

                        <div class="attention-left">

                            <div class="attention-icon">

                                <i class="fas fa-bolt"></i>

                            </div>

                            <div>

                                <div class="attention-label">
                                    Urgent / STAT Tests
                                </div>

                                <div class="attention-description">
                                    Tests requiring immediate attention
                                </div>

                            </div>

                        </div>

                        <div class="attention-number">
                            @Model.UrgentTests
                        </div>

                    </div>


                    <!-- OVERDUE -->

                    <div class="attention-item">

                        <div class="attention-left">

                            <div class="attention-icon">

                                <i class="fas fa-clock"></i>

                            </div>

                            <div>

                                <div class="attention-label">
                                    Overdue Tests
                                </div>

                                <div class="attention-description">
                                    Tests past their turnaround time
                                </div>

                            </div>

                        </div>

                        <div class="attention-number">
                            @Model.OverdueTests
                        </div>

                    </div>


                    <!-- NEARING TAT -->

                    <div class="attention-item">

                        <div class="attention-left">

                            <div class="attention-icon">

                                <i class="fas fa-stopwatch"></i>

                            </div>

                            <div>

                                <div class="attention-label">
                                    Nearing Turnaround
                                </div>

                                <div class="attention-description">
                                    Tests approaching their turnaround limit
                                </div>

                            </div>

                        </div>

                        <div class="attention-number">
                            @Model.NearingTurnaround
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- OVERVIEW -->

        <div class="col-lg-5">

            <div class="dashboard-card">

                <div class="section-header">

                    <h5 class="section-title">

                        <i class="fas fa-chart-simple me-2"></i>

                        Today's Overview

                    </h5>

                    <p class="section-description">
                        Current workload summary.
                    </p>

                </div>


                <div class="overview-content">


                    <div class="overview-item">

                        <span class="overview-label">
                            Tests in Progress
                        </span>

                        <span class="overview-value">
                            @Model.MySelectedTests
                        </span>

                    </div>


                    <div class="overview-item">

                        <span class="overview-label">
                            Awaiting Selection
                        </span>

                        <span class="overview-value">
                            @Model.WaitingToBeSelected
                        </span>

                    </div>


                    <div class="overview-item">

                        <span class="overview-label">
                            Awaiting Verification
                        </span>

                        <span class="overview-value">
                            @Model.WaitingVerification
                        </span>

                    </div>


                    <div class="overview-item">

                        <span class="overview-label">
                            Awaiting Review
                        </span>

                        <span class="overview-value">
                            @Model.WaitingReview
                        </span>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>
