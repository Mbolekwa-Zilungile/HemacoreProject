
@model HemaCore.Models.ViewModels.LabTechnicianDashboardViewModel

@{
    ViewData["Title"] = "Lab Technician Dashboard";
    Layout = "_LabTechnicianLayout";
}

<style>

    /* ==============================
           PROFESSIONAL LAB THEME
           ============================== */

    body {
        background-color: #f5f6f8;
        color: #212529;
    }


    /* ==============================
           PAGE HEADER
           ============================== */

    .page-title {
        color: #1d2939;
    }

    .page-subtitle {
        color: #667085;
    }


    /* ==============================
           TOP KPI CARDS
           ============================== */

    .kpi-card {
        border: 1px solid #eaecf0 !important;
        border-radius: 8px;
        background: #ffffff;
        transition: all 0.2s ease;
    }

        .kpi-card:hover {
            transform: translateY(-1px);
            border-color: #d0d5dd !important;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.06) !important;
        }

        .kpi-card .card-body {
            padding: 16px 18px;
        }


    /* TOP KPI ICON */

    .kpi-icon {
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 7px;
        background: #f2f4f7;
        color: #475467;
        font-size: 14px;
        flex-shrink: 0;
    }


    /* TOP KPI LABEL */

    .kpi-label {
        color: #667085;
        font-size: 12px;
        font-weight: 500;
    }


    /* TOP KPI NUMBER */

    .kpi-number {
        color: #1d2939;
        font-size: 22px;
        font-weight: 700;
        line-height: 1;
    }


    /* ==============================
           ALERT KPI CARDS
           ============================== */

    .alert-kpi-card {
        border-radius: 8px;
        background: #ffffff;
        border: 1px solid #eaecf0 !important;
        transition: all 0.2s ease;
    }

        .alert-kpi-card:hover {
            transform: translateY(-1px);
            border-color: #d0d5dd !important;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.06) !important;
        }

        .alert-kpi-card .card-body {
            padding: 15px 18px;
        }


    /* ALERT ICON */

    .alert-kpi-icon {
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 7px;
        font-size: 14px;
        flex-shrink: 0;
    }


    /* URGENT / STAT */

    .urgent-card {
        border-left: 4px solid #b42318 !important;
    }

    .urgent-icon {
        background: #fef3f2;
        color: #b42318;
    }


    /* OVERDUE */

    .overdue-card {
        border-left: 4px solid #b42318 !important;
    }

    .overdue-icon {
        background: #fef3f2;
        color: #b42318;
    }


    /* NEARING TURNAROUND */

    .nearing-card {
        border-left: 4px solid #667085 !important;
    }

    .nearing-icon {
        background: #f2f4f7;
        color: #667085;
    }


    /* ALERT LABEL */

    .alert-kpi-label {
        color: #475467;
        font-size: 12px;
        font-weight: 600;
    }


    /* ALERT NUMBER */

    .alert-kpi-number {
        color: #1d2939;
        font-size: 21px;
        font-weight: 700;
        line-height: 1;
    }


    /* ALERT DESCRIPTION */

    .alert-kpi-text {
        color: #98a2b3;
        font-size: 11px;
    }


    /* ==============================
           GENERAL CARDS
           ============================== */

    .card.border-0.shadow-sm {
        border-radius: 9px;
        background: #ffffff;
    }


    /* ==============================
           SECTION TITLES
           ============================== */

    .section-title {
        color: #1d2939;
    }


    /* ==============================
           FILTER SECTION
           ============================== */

    .form-label {
        font-size: 13px;
        font-weight: 600;
        color: #344054;
    }

    .form-select,
    .form-control {
        border-color: #d0d5dd;
        border-radius: 7px;
    }

        .form-select:focus,
        .form-control:focus {
            border-color: #344054;
            box-shadow: 0 0 0 2px rgba(52, 64, 84, 0.10);
        }


    /* ==============================
           TABLE
           ============================== */

    #workloadTable thead th {
        background-color: #f2f4f7;
        color: #344054;
        font-size: 13px;
        font-weight: 600;
        border-bottom: 1px solid #d0d5dd;
    }

    #workloadTable tbody td {
        font-size: 14px;
        color: #344054;
    }

    #workloadTable tbody tr {
        border-bottom: 1px solid #eaecf0;
    }


    /* ==============================
           BADGES
           ============================== */

    .badge {
        padding: 6px 10px;
        border-radius: 6px;
        font-weight: 600;
    }


    /* ==============================
           TEST COUNT
           ============================== */

    #testCount {
        background-color: #344054 !important;
    }

</style>


<div class="container-fluid px-4 py-4">


    <!-- ==============================
         PAGE HEADER
         ============================== -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold mb-1 page-title">
                Welcome, @Model.TechnicianName
            </h2>

            <p class="mb-0 page-subtitle">
                Here's your laboratory workload and test activity for today.
            </p>

        </div>


        <div class="text-end">

            <div class="fw-semibold">

                <i class="fas fa-calendar-day me-2"></i>

                @DateTime.Now.ToString("dd MMMM yyyy")

            </div>


            <div class="text-muted mt-1">

                <i class="fas fa-clock me-2"></i>

                <span id="currentTime">
                    @DateTime.Now.ToString("HH:mm:ss")
                </span>

            </div>

        </div>

    </div>



    <!-- ==============================
         TOP KPI CARDS
         ============================== -->

    <div class="row g-3 mb-3">


        <!-- MY SELECTED TESTS -->

        <div class="col-xl-3 col-md-6">

            <div class="card kpi-card h-100 shadow-sm clickable-card"
                 data-filter="selected"
                 style="cursor:pointer;">

                <div class="card-body">

                    <div class="d-flex align-items-center">

                        <div class="kpi-icon">

                            <i class="fas fa-microscope"></i>

                        </div>


                        <div class="ms-3">

                            <p class="kpi-label mb-1">
                                My Selected Tests
                            </p>

                            <h3 class="kpi-number mb-0">
                                @Model.MySelectedTests
                            </h3>

                        </div>

                    </div>

                </div>

            </div>

        </div>



        <!-- WAITING TO BE SELECTED -->

        <div class="col-xl-3 col-md-6">

            <div class="card kpi-card h-100 shadow-sm clickable-card"
                 data-filter="waiting"
                 style="cursor:pointer;">

                <div class="card-body">

                    <div class="d-flex align-items-center">

                        <div class="kpi-icon">

                            <i class="fas fa-hourglass-half"></i>

                        </div>


                        <div class="ms-3">

                            <p class="kpi-label mb-1">
                                Waiting to be Selected
                            </p>

                            <h3 class="kpi-number mb-0">
                                @Model.WaitingToBeSelected
                            </h3>

                        </div>

                    </div>

                </div>

            </div>

        </div>



        <!-- WAITING VERIFICATION -->

        <div class="col-xl-3 col-md-6">

            <div class="card kpi-card h-100 shadow-sm clickable-card"
                 data-filter="verification"
                 style="cursor:pointer;">

                <div class="card-body">

                    <div class="d-flex align-items-center">

                        <div class="kpi-icon">

                            <i class="fas fa-check-double"></i>

                        </div>


                        <div class="ms-3">

                            <p class="kpi-label mb-1">
                                Waiting Verification
                            </p>

                            <h3 class="kpi-number mb-0">
                                @Model.WaitingVerification
                            </h3>

                        </div>

                    </div>

                </div>

            </div>

        </div>



        <!-- WAITING REVIEW -->

        <div class="col-xl-3 col-md-6">

            <div class="card kpi-card h-100 shadow-sm clickable-card"
                 data-filter="review"
                 style="cursor:pointer;">

                <div class="card-body">

                    <div class="d-flex align-items-center">

                        <div class="kpi-icon">

                            <i class="fas fa-clipboard-list"></i>

                        </div>


                        <div class="ms-3">

                            <p class="kpi-label mb-1">
                                Waiting Review
                            </p>

                            <h3 class="kpi-number mb-0">
                                @Model.WaitingReview
                            </h3>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>



    <!-- ==============================
         ALERT KPI CARDS
         ============================== -->

    <div class="row g-3 mb-4">


        <!-- URGENT / STAT -->

        <div class="col-lg-4">

            <div class="card alert-kpi-card urgent-card shadow-sm clickable-card"
                 data-filter="urgent"
                 style="cursor:pointer;">

                <div class="card-body">

                    <div class="d-flex align-items-center">

                        <div class="alert-kpi-icon urgent-icon">

                            <i class="fas fa-bolt"></i>

                        </div>


                        <div class="ms-3">

                            <p class="alert-kpi-label mb-1">
                                Urgent / STAT Tests
                            </p>


                            <div class="d-flex align-items-baseline">

                                <h3 class="alert-kpi-number mb-0">
                                    @Model.UrgentTests
                                </h3>

                                <span class="alert-kpi-text ms-2">
                                    requiring attention
                                </span>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>



        <!-- OVERDUE -->

        <div class="col-lg-4">

            <div class="card alert-kpi-card overdue-card shadow-sm clickable-card"
                 data-filter="overdue"
                 style="cursor:pointer;">

                <div class="card-body">

                    <div class="d-flex align-items-center">

                        <div class="alert-kpi-icon overdue-icon">

                            <i class="fas fa-clock"></i>

                        </div>


                        <div class="ms-3">

                            <p class="alert-kpi-label mb-1">
                                Overdue Tests
                            </p>


                            <div class="d-flex align-items-baseline">

                                <h3 class="alert-kpi-number mb-0">
                                    @Model.OverdueTests
                                </h3>

                                <span class="alert-kpi-text ms-2">
                                    past turnaround time
                                </span>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>



        <!-- NEARING TURNAROUND -->

        <div class="col-lg-4">

            <div class="card alert-kpi-card nearing-card shadow-sm clickable-card"
                 data-filter="nearing"
                 style="cursor:pointer;">

                <div class="card-body">

                    <div class="d-flex align-items-center">

                        <div class="alert-kpi-icon nearing-icon">

                            <i class="fas fa-stopwatch"></i>

                        </div>


                        <div class="ms-3">

                            <p class="alert-kpi-label mb-1">
                                Nearing Turnaround Limit
                            </p>


                            <div class="d-flex align-items-baseline">

                                <h3 class="alert-kpi-number mb-0">
                                    @Model.NearingTurnaround
                                </h3>

                                <span class="alert-kpi-text ms-2">
                                    approaching limit
                                </span>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>



    <!-- ==============================
         FILTERS
         ============================== -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body">

            <div class="d-flex align-items-center mb-3">

                <i class="fas fa-filter me-2"></i>

                <h5 class="fw-bold mb-0 section-title">
                    Filter Tests
                </h5>

            </div>


            <div class="row g-3">


                <!-- URGENCY -->

                <div class="col-md-3">

                    <label class="form-label">
                        Urgency
                    </label>

                    <select id="urgencyFilter"
                            class="form-select">

                        <option value="">
                            All
                        </option>

                        <option value="Routine">
                            Routine
                        </option>

                        <option value="Urgent">
                            Urgent
                        </option>

                        <option value="STAT">
                            STAT
                        </option>

                    </select>

                </div>



                <!-- TEST TYPE -->

                <div class="col-md-3">

                    <label class="form-label">
                        Test Type
                    </label>

                    <select id="testTypeFilter"
                            class="form-select">

                        <option value="">
                            All Test Types
                        </option>

                        @foreach (var testType in Model.Workload
                            .Select(x => x.TestTypeName)
                            .Where(x => !string.IsNullOrEmpty(x))
                            .Distinct())
                        {
                            <option value="@testType">
                                @testType
                            </option>
                        }

                    </select>

                </div>



                <!-- STATUS -->

                <div class="col-md-3">

                    <label class="form-label">
                        Status
                    </label>

                    <select id="statusFilter"
                            class="form-select">

                        <option value="">
                            All
                        </option>

                        <option value="Submitted">
                            Submitted
                        </option>

                        <option value="In Progress">
                            In Progress
                        </option>

                        <option value="Completed">
                            Completed
                        </option>

                    </select>

                </div>



                <!-- REQUEST NUMBER -->

                <div class="col-md-3">

                    <label class="form-label">
                        Request Number
                    </label>

                    <input type="text"
                           id="requestFilter"
                           class="form-control"
                           placeholder="Search request number">

                </div>

            </div>

        </div>

    </div>



    <!-- ==============================
         TEST WORKLOAD
         ============================== -->

    <div class="card border-0 shadow-sm">

        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-3">

                <div>

                    <h5 class="fw-bold mb-1 section-title">

                        <i class="fas fa-microscope me-2"></i>

                        Test Workload

                    </h5>


                    <p class="card-description mb-0">
                        Tests requiring your attention.
                    </p>

                </div>


                <span id="testCount"
                      class="badge">

                    @Model.Workload.Count Tests

                </span>

            </div>



            <div class="table-responsive">

                <table class="table table-hover align-middle"
                       id="workloadTable">

                    <thead>

                        <tr>

                            <th>
                                Request No.
                            </th>

                            <th>
                                Patient
                            </th>

                            <th>
                                Test Type
                            </th>

                            <th>
                                Urgency
                            </th>

                            <th>
                                Status
                            </th>

                            <th>
                                Due Time
                            </th>

                        </tr>

                    </thead>



                    <tbody>

                        @if (Model.Workload == null || !Model.Workload.Any())
                        {
                            <tr>

                                <td colspan="6"
                                    class="text-center text-muted py-5">

                                    <i class="fas fa-inbox fa-2x mb-3 d-block"></i>

                                    No tests currently require your attention.

                                </td>

                            </tr>
                        }
                        else
                        {
                            foreach (var test in Model.Workload)
                            {
                                <tr class="workload-row"
                                    data-urgency="@test.Urgency"
                                    data-testtype="@test.TestTypeName"
                                    data-status="@test.Status"
                                    data-request="@test.TestRequestId"
                                    data-due="@test.DueTime">

                                    <td>
                                        #@test.TestRequestId
                                    </td>


                                    <td>
                                        @test.PatientName
                                    </td>


                                    <td>
                                        @test.TestTypeName
                                    </td>


                                    <td>

                                        @if (test.Urgency == "STAT")
                                        {
                                            <span class="badge bg-danger">
                                                STAT
                                            </span>
                                        }
                                        else if (test.Urgency == "Urgent")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Urgent
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @test.Urgency
                                            </span>
                                        }

                                    </td>


                                    <td>

                                        @if (test.Status == "Completed")
                                        {
                                            <span class="badge bg-success">
                                                Completed
                                            </span>
                                        }
                                        else if (test.Status == "In Progress")
                                        {
                                            <span class="badge bg-primary">
                                                In Progress
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">
                                                @test.Status
                                            </span>
                                        }

                                    </td>


                                    <td>
                                        @(test.DueTime?.ToString("dd/MM/yyyy HH:mm") ?? "-")
                                    </td>

                                </tr>
                            }


                            <tr id="noFilterResults"
                                style="display:none;">

                                <td colspan="6"
                                    class="text-center text-muted py-5">

                                    <i class="fas fa-search fa-2x mb-3 d-block"></i>

                                    No tests match the selected filter.

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>



<script>

    document.addEventListener("DOMContentLoaded", function() {


        /* ==============================
           LIVE CLOCK
           ============================== */

        function updateTime() {

            const now = new Date();

            const time = now.toLocaleTimeString("en-GB", {
                hour: "2-digit",
                minute: "2-digit",
                second: "2-digit"
            });

            const timeElement =
                document.getElementById("currentTime");

            if (timeElement) {

                timeElement.textContent = time;

            }

        }

        updateTime();

        setInterval(updateTime, 1000);



        /* ==============================
           FILTER ELEMENTS
           ============================== */

        const urgencyFilter =
            document.getElementById("urgencyFilter");

        const testTypeFilter =
            document.getElementById("testTypeFilter");

        const statusFilter =
            document.getElementById("statusFilter");

        const requestFilter =
            document.getElementById("requestFilter");

        const rows =
            document.querySelectorAll(".workload-row");

        const testCount =
            document.getElementById("testCount");

        const noResults =
            document.getElementById("noFilterResults");



        /* ==============================
           FILTER TESTS
           ============================== */

        function filterTests(cardFilter = null) {

            let visibleCount = 0;


            rows.forEach(function(row) {

                let show = true;


                const urgency =
                    row.dataset.urgency || "";

                const testType =
                    row.dataset.testtype || "";

                const status =
                    row.dataset.status || "";

                const request =
                    row.dataset.request || "";

                const due =
                    row.dataset.due || "";



                /* ==============================
                   NORMAL FILTERS
                   ============================== */

                if (
                    urgencyFilter.value &&
                    urgency.toLowerCase() !==
                    urgencyFilter.value.toLowerCase()
                ) {

                    show = false;

                }


                if (
                    testTypeFilter.value &&
                    testType.toLowerCase() !==
                    testTypeFilter.value.toLowerCase()
                ) {

                    show = false;

                }


                if (
                    statusFilter.value &&
                    status.toLowerCase() !==
                    statusFilter.value.toLowerCase()
                ) {

                    show = false;

                }


                if (
                    requestFilter.value &&
                    !request.toLowerCase().includes(
                        requestFilter.value.toLowerCase()
                    )
                ) {

                    show = false;

                }



                /* ==============================
                   DASHBOARD CARD FILTERS
                   ============================== */

                if (cardFilter === "selected") {

                    if (
                        status === "Completed" ||
                        status === "Submitted"
                    ) {

                        show = false;

                    }

                }


                if (cardFilter === "waiting") {

                    if (status !== "Submitted") {

                        show = false;

                    }

                }


                if (cardFilter === "verification") {

                    if (status !== "Completed") {

                        show = false;

                    }

                }


                if (cardFilter === "review") {

                    show = false;

                }


                if (cardFilter === "urgent") {

                    if (urgency !== "STAT") {

                        show = false;

                    }

                }


                if (cardFilter === "overdue") {

                    if (!due) {

                        show = false;

                    }
                    else {

                        const dueDate =
                            new Date(due);

                        if (
                            dueDate >= new Date() ||
                            status === "Completed"
                        ) {

                            show = false;

                        }

                    }

                }


                if (cardFilter === "nearing") {

                    if (!due) {

                        show = false;

                    }
                    else {

                        const dueDate =
                            new Date(due);

                        const now =
                            new Date();

                        const twoHours =
                            new Date(
                                now.getTime() +
                                (2 * 60 * 60 * 1000)
                            );


                        if (
                            dueDate <= now ||
                            dueDate > twoHours ||
                            status === "Completed"
                        ) {

                            show = false;

                        }

                    }

                }



                /* ==============================
                   SHOW / HIDE
                   ============================== */

                if (show) {

                    row.style.display = "";

                    visibleCount++;

                }
                else {

                    row.style.display = "none";

                }

            });



            /* ==============================
               UPDATE COUNT
               ============================== */

            testCount.textContent =
                visibleCount + " Tests";



            /* ==============================
               NO RESULTS
               ============================== */

            if (noResults) {

                noResults.style.display =
                    visibleCount === 0
                        ? ""
                        : "none";

            }

        }



        /* ==============================
           NORMAL FILTER EVENTS
           ============================== */

        urgencyFilter.addEventListener(
            "change",
            function() {

                filterTests();

            }
        );


        testTypeFilter.addEventListener(
            "change",
            function() {

                filterTests();

            }
        );


        statusFilter.addEventListener(
            "change",
            function() {

                filterTests();

            }
        );


        requestFilter.addEventListener(
            "keyup",
            function() {

                filterTests();

            }
        );



        /* ==============================
           DASHBOARD CARD EVENTS
           ============================== */

        document
            .querySelectorAll(".clickable-card")
            .forEach(function(card) {

                card.addEventListener(
                    "click",
                    function() {

                        const filter =
                            card.dataset.filter;


                        filterTests(filter);


                        document
                            .getElementById("workloadTable")
                            .scrollIntoView({
                                behavior: "smooth",
                                block: "start"
                            });

                    }
                );

            });

    });

</script>
