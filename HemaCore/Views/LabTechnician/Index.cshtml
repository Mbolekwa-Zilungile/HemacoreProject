 @model HemaCore.Models.ViewModels.LabTechnicianDashboardViewModel

@{
    ViewData["Title"] = "Lab Technician Dashboard";
    Layout = "_LabTechnicianLayout";
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

<div class="container-fluid lab-dashboard">

    <!-- HEADER -->
    <div class="lab-header">
        <div>
            <div class="lab-eyebrow">
                <i class="fas fa-microscope"></i>
                LABORATORY WORKSPACE
            </div>

            <h2>Lab Technician Dashboard</h2>

            <p>
                Welcome, @Model.TechnicianName.
                Here is an overview of your laboratory workload.
            </p>
        </div>

        <div class="lab-header-icon">
            <i class="fas fa-flask"></i>
        </div>
    </div>

    <!-- WORKFLOW STATISTICS -->
    <div class="row g-3 mb-4">

        <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6">
            <a asp-controller="LabTechnician"
               asp-action="ReceiveSample"
               class="lab-stat-link">
                <div class="lab-stat">
                    <div class="lab-stat-top">
                        <span class="lab-stat-icon stat-blue">
                            <i class="fas fa-vial"></i>
                        </span>
                        <i class="fas fa-arrow-up-right-from-square stat-link-icon"></i>
                    </div>
                    <div class="lab-stat-label">Samples to Receive</div>
                    <div class="lab-stat-number">@Model.SamplesAwaitingReceipt</div>
                    <div class="lab-stat-foot">Pending receipt</div>
                </div>
            </a>
        </div>

        <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6">
            <a asp-controller="LabTechnician"
               asp-action="ProcessTests"
               class="lab-stat-link">
                <div class="lab-stat">
                    <div class="lab-stat-top">
                        <span class="lab-stat-icon stat-purple">
                            <i class="fas fa-list-check"></i>
                        </span>
                        <i class="fas fa-arrow-up-right-from-square stat-link-icon"></i>
                    </div>
                    <div class="lab-stat-label">Available Tests</div>
                    <div class="lab-stat-number">@Model.WaitingToBeSelected</div>
                    <div class="lab-stat-foot">Ready for selection</div>
                </div>
            </a>
        </div>

        <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6">
            <a asp-controller="LabTechnician"
               asp-action="MyTests"
               class="lab-stat-link">
                <div class="lab-stat">
                    <div class="lab-stat-top">
                        <span class="lab-stat-icon stat-teal">
                            <i class="fas fa-microscope"></i>
                        </span>
                        <i class="fas fa-arrow-up-right-from-square stat-link-icon"></i>
                    </div>
                    <div class="lab-stat-label">Selected by Me</div>
                    <div class="lab-stat-number">@Model.MySelectedTests</div>
                    <div class="lab-stat-foot">Your active tests</div>
                </div>
            </a>
        </div>

        <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6">
            <a asp-controller="LabTechnician"
               asp-action="VerifyResults"
               class="lab-stat-link">
                <div class="lab-stat">
                    <div class="lab-stat-top">
                        <span class="lab-stat-icon stat-green">
                            <i class="fas fa-shield-halved"></i>
                        </span>
                        <i class="fas fa-arrow-up-right-from-square stat-link-icon"></i>
                    </div>
                    <div class="lab-stat-label">Awaiting Verification</div>
                    <div class="lab-stat-number">@Model.WaitingVerification</div>
                    <div class="lab-stat-foot">Results to verify</div>
                </div>
            </a>
        </div>

        <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6">
            <a asp-controller="LabTechnician"
               asp-action="ReviewResults"
               class="lab-stat-link">
                <div class="lab-stat">
                    <div class="lab-stat-top">
                        <span class="lab-stat-icon stat-orange">
                            <i class="fas fa-clipboard-check"></i>
                        </span>
                        <i class="fas fa-arrow-up-right-from-square stat-link-icon"></i>
                    </div>
                    <div class="lab-stat-label">Awaiting Review</div>
                    <div class="lab-stat-number">@Model.WaitingReview</div>
                    <div class="lab-stat-foot">Returned results</div>
                </div>
            </a>
        </div>

        <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6">
            <a asp-controller="LabTechnician"
               asp-action="ProcessTests"
               asp-route-urgency="STAT"
               class="lab-stat-link">
                <div class="lab-stat">
                    <div class="lab-stat-top">
                        <span class="lab-stat-icon stat-red">
                            <i class="fas fa-bolt"></i>
                        </span>
                        <i class="fas fa-arrow-up-right-from-square stat-link-icon"></i>
                    </div>
                    <div class="lab-stat-label">Urgent Tests</div>
                    <div class="lab-stat-number">@Model.UrgentTests</div>
                    <div class="lab-stat-foot">STAT priority</div>
                </div>
            </a>
        </div>

    </div>

    <!-- TURNAROUND MONITORING -->
    <div class="lab-section-heading">
        <div>
            <h5>Turnaround Monitoring</h5>
            <p>Keep track of tests that may need your attention.</p>
        </div>
    </div>

    <div class="row g-3 mb-4">

        <div class="col-lg-6">
            <div class="lab-panel attention-panel">
                <div class="lab-panel-heading">
                    <div class="lab-panel-title">
                        <span class="attention-icon overdue-icon">
                            <i class="fas fa-clock"></i>
                        </span>
                        <div>
                            <h6>Overdue Tests</h6>
                            <span>Passed expected completion time</span>
                        </div>
                    </div>

                    <span class="lab-count count-red">@Model.OverdueTests</span>
                </div>

                <div class="lab-panel-content">
                    @if (Model.OverdueTests > 0)
                    {
                        <p>
                            Outstanding tests may require prioritisation.
                        </p>

                        <a asp-controller="LabTechnician"
                           asp-action="ProcessTests"
                           asp-route-dueStatus="Overdue"
                           class="lab-action-link action-red">
                            Review overdue tests
                            <i class="fas fa-arrow-right"></i>
                        </a>
                    }
                    else
                    {
                        <div class="lab-empty-inline">
                            <i class="fas fa-circle-check"></i>
                            No overdue tests in your current workload.
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="lab-panel attention-panel">
                <div class="lab-panel-heading">
                    <div class="lab-panel-title">
                        <span class="attention-icon nearing-icon">
                            <i class="fas fa-hourglass-half"></i>
                        </span>
                        <div>
                            <h6>Nearing Turnaround Limit</h6>
                            <span>Approaching expected completion time</span>
                        </div>
                    </div>

                    <span class="lab-count count-amber">@Model.NearingTurnaround</span>
                </div>

                <div class="lab-panel-content">
                    @if (Model.NearingTurnaround > 0)
                    {
                        <p>
                            Check these tests before their deadlines are reached.
                        </p>

                        <a asp-controller="LabTechnician"
                           asp-action="ProcessTests"
                           asp-route-dueStatus="Nearing"
                           class="lab-action-link action-amber">
                            Review approaching deadlines
                            <i class="fas fa-arrow-right"></i>
                        </a>
                    }
                    else
                    {
                        <div class="lab-empty-inline">
                            <i class="fas fa-circle-check"></i>
                            No tests are currently nearing their limit.
                        </div>
                    }
                </div>
            </div>
        </div>

    </div>

    <!-- FIND TESTS -->
    <div class="lab-panel mb-4">
        <div class="lab-panel-heading section-panel-heading">
            <div class="lab-panel-title">
                <span class="section-icon">
                    <i class="fas fa-sliders"></i>
                </span>
                <div>
                    <h6>Find Tests</h6>
                    <span>Narrow down the tests available to you</span>
                </div>
            </div>
        </div>

        <div class="lab-panel-content">
            <form asp-controller="LabTechnician"
                  asp-action="Index"
                  method="get">

                <div class="row g-3">

                    <div class="col-xl-3 col-md-6">
                        <label for="urgencyFilter" class="form-label">
                            Urgency
                        </label>
                        <select id="urgencyFilter"
                                name="urgency"
                                class="form-select lab-input">
                            <option value="">All urgencies</option>
                            <option value="Routine"
                                    selected="@(Model.FilterUrgency == "Routine")">
                                Routine
                            </option>
                            <option value="Urgent"
                                    selected="@(Model.FilterUrgency == "Urgent")">
                                Urgent
                            </option>
                            <option value="STAT"
                                    selected="@(Model.FilterUrgency == "STAT")">
                                STAT
                            </option>
                        </select>
                    </div>

                    <div class="col-xl-3 col-md-6">
                        <label for="categoryFilter" class="form-label">
                            Test Category
                        </label>
                        <select id="categoryFilter"
                                name="categoryId"
                                class="form-select lab-input">
                            <option value="">All categories</option>

                            @if (ViewBag.TestCategories != null)
                            {
                                foreach (var category in ViewBag.TestCategories)
                                {
                                    <option value="@category.CategoryId"
                                            selected="@(Model.FilterCategoryId == category.CategoryId)">
                                        @category.CategoryName
                                    </option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-xl-3 col-md-6">
                        <label for="dueStatusFilter" class="form-label">
                            Due Time
                        </label>
                        <select id="dueStatusFilter"
                                name="dueStatus"
                                class="form-select lab-input">
                            <option value="">All due times</option>
                            <option value="Nearing"
                                    selected="@(Model.FilterDueStatus == "Nearing")">
                                Nearing deadline
                            </option>
                            <option value="Overdue"
                                    selected="@(Model.FilterDueStatus == "Overdue")">
                                Overdue
                            </option>
                        </select>
                    </div>

                    <div class="col-xl-3 col-md-6">
                        <label for="requestNumberFilter" class="form-label">
                            Request Number
                        </label>
                        <input id="requestNumberFilter"
                               name="requestNumber"
                               type="number"
                               min="1"
                               class="form-control lab-input"
                               placeholder="Enter request number"
                               value="@Model.FilterRequestNumber" />
                    </div>

                </div>

                <div class="lab-filter-actions">
                    <button type="submit" class="lab-primary-button">
                        <i class="fas fa-filter"></i>
                        Apply Filters
                    </button>

                    <a asp-controller="LabTechnician"
                       asp-action="Index"
                       class="lab-secondary-button">
                        <i class="fas fa-rotate-left"></i>
                        Clear Filters
                    </a>
                </div>

            </form>
        </div>
    </div>

    <!-- AVAILABLE TESTS TABLE -->
    <div class="lab-panel mb-4">
        <div class="lab-panel-heading section-panel-heading">
            <div class="lab-panel-title">
                <span class="section-icon">
                    <i class="fas fa-list-check"></i>
                </span>
                <div>
                    <h6>Available Tests</h6>
                    <span>Eligible tests waiting to be selected</span>
                </div>
            </div>

            <span class="lab-table-count">
                @(Model.AvailableTests?.Count ?? 0) tests
            </span>
        </div>

        <div class="table-responsive">
            @if (Model.AvailableTests != null &&
                 Model.AvailableTests.Any())
            {
                <table class="table lab-table mb-0">
                    <thead>
                        <tr>
                            <th>Request</th>
                            <th>Patient</th>
                            <th>Test Type</th>
                            <th>Category</th>
                            <th>Urgency</th>
                            <th>Status</th>
                            <th>Due Time</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var test in Model.AvailableTests)
                        {
                            <tr>
                                <td>
                                    <span class="lab-request-number">
                                        #@test.TestRequestId
                                    </span>
                                </td>
                                <td class="lab-patient-name">
                                    @test.PatientName
                                </td>
                                <td>@test.TestTypeName</td>
                                <td>
                                    <span class="lab-category-tag">
                                        @test.CategoryName
                                    </span>
                                </td>
                                <td>
                                    @if (test.Urgency == "STAT")
                                    {
                                        <span class="lab-status-tag tag-stat">
                                            <i class="fas fa-bolt"></i> STAT
                                        </span>
                                    }
                                    else if (test.Urgency == "Urgent")
                                    {
                                        <span class="lab-status-tag tag-urgent">
                                            Urgent
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="lab-status-tag tag-routine">
                                            @test.Urgency
                                        </span>
                                    }
                                </td>
                                <td>
                                    <span class="lab-status-tag tag-pending">
                                        @test.Status
                                    </span>
                                </td>
                                <td class="lab-due-time">
                                    @(test.DueTime.HasValue
                                        ? test.DueTime.Value.ToString("dd MMM yyyy HH:mm")
                                        : "Not set")
                                </td>
                                <td>
                                    <a asp-controller="LabTechnician"
                                       asp-action="TestDetails"
                                       asp-route-id="@test.TestRequestTestTypeId"
                                       class="lab-view-button">
                                        View test
                                        <i class="fas fa-chevron-right"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="lab-empty-table">
                    <div class="empty-table-icon">
                        <i class="fas fa-flask"></i>
                    </div>
                    <h6>No matching tests</h6>
                    <p>
                        There are no eligible tests matching your current filters.
                        Try clearing the filters or check again later.
                    </p>
                    <a asp-controller="LabTechnician"
                       asp-action="Index"
                       class="lab-secondary-button">
                        Clear filters
                    </a>
                </div>
            }
        </div>
    </div>

</div>

<style>
    .lab-dashboard {
        background: #f6f9fa;
        min-height: 100vh;
        padding: 28px;
        color: #34434b;
    }

    .lab-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 27px;
    }

    .lab-eyebrow {
        color: #528f96;
        font-size: 11px;
        font-weight: 750;
        letter-spacing: 1.25px;
        margin-bottom: 9px;
    }

    .lab-eyebrow i {
        margin-right: 6px;
    }

    .lab-header h2 {
        color: #263b43;
        font-size: 27px;
        font-weight: 700;
        margin: 0;
    }

    .lab-header p {
        color: #788990;
        font-size: 13px;
        margin: 8px 0 0;
    }

    .lab-header-icon {
        width: 54px;
        height: 54px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 16px;
        background: #e3f1f1;
        color: #528f96;
        font-size: 23px;
        flex-shrink: 0;
    }

    .lab-stat-link {
        display: block;
        height: 100%;
        color: inherit;
        text-decoration: none;
    }

    .lab-stat {
        height: 100%;
        min-height: 156px;
        background: #fff;
        border: 1px solid #e5ecee;
        border-radius: 13px;
        padding: 17px;
        transition: transform .18s ease, border-color .18s ease, box-shadow .18s ease;
    }

    .lab-stat-link:hover .lab-stat {
        transform: translateY(-3px);
        border-color: #a7cdcf;
        box-shadow: 0 8px 20px rgba(55, 100, 106, .07);
    }

    .lab-stat-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 14px;
    }

    .lab-stat-icon {
        width: 39px;
        height: 39px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 11px;
        font-size: 16px;
    }

    .stat-link-icon {
        color: #c1cccf;
        font-size: 11px;
    }

    .lab-stat-label {
        color: #6f8087;
        font-size: 12px;
        line-height: 1.45;
        min-height: 34px;
    }

    .lab-stat-number {
        color: #2b4149;
        font-size: 28px;
        font-weight: 750;
        line-height: 1.2;
        margin-top: 3px;
    }

    .lab-stat-foot {
        color: #9aa8ad;
        font-size: 10px;
        margin-top: 5px;
    }

    .stat-blue { background: #e9f2ff; color: #4d80bf; }
    .stat-purple { background: #f0edff; color: #8174be; }
    .stat-teal { background: #e3f3f1; color: #488f87; }
    .stat-green { background: #e7f5ec; color: #4f9970; }
    .stat-orange { background: #fff1e5; color: #c58a51; }
    .stat-red { background: #ffeded; color: #c76c70; }

    .lab-section-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin: 29px 0 14px;
    }

    .lab-section-heading h5 {
        color: #30434b;
        font-size: 16px;
        font-weight: 700;
        margin: 0;
    }

    .lab-section-heading p {
        color: #87969b;
        font-size: 12px;
        margin: 5px 0 0;
    }

    .lab-panel {
        background: #fff;
        border: 1px solid #e5ecee;
        border-radius: 13px;
        overflow: hidden;
    }

    .lab-panel-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 14px;
        padding: 17px 20px;
        border-bottom: 1px solid #edf1f2;
    }

    .lab-panel-title {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
    }

    .lab-panel-title h6 {
        color: #34474e;
        font-size: 13px;
        font-weight: 700;
        margin: 0 0 4px;
    }

    .lab-panel-title > div > span {
        color: #8a989d;
        font-size: 11px;
    }

    .attention-icon,
    .section-icon {
        width: 37px;
        height: 37px;
        display: flex;
        flex-shrink: 0;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        font-size: 14px;
    }

    .overdue-icon { background: #fff0ef; color: #c66f6b; }
    .nearing-icon { background: #fff5df; color: #b88c39; }
    .section-icon { background: #e6f2f2; color: #568f95; }

    .lab-count {
        min-width: 31px;
        text-align: center;
        border-radius: 9px;
        padding: 5px 9px;
        font-size: 12px;
        font-weight: 700;
    }

    .count-red { background: #fff0ef; color: #bd6663; }
    .count-amber { background: #fff5df; color: #a98232; }

    .lab-panel-content {
        padding: 17px 20px;
    }

    .lab-panel-content > p {
        color: #77878d;
        font-size: 12px;
        margin: 0 0 13px;
    }

    .lab-empty-inline {
        display: flex;
        align-items: center;
        gap: 9px;
        color: #728b80;
        font-size: 12px;
        padding: 5px 0;
    }

    .lab-empty-inline i {
        color: #78ad91;
    }

    .lab-action-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 12px;
        font-weight: 650;
        text-decoration: none;
    }

    .action-red { color: #b96764; }
    .action-amber { color: #a98232; }

    .lab-action-link:hover {
        text-decoration: underline;
    }

    .section-panel-heading {
        padding: 18px 20px;
    }

    .lab-panel-content .form-label {
        color: #52666e;
        font-size: 12px;
        font-weight: 650;
        margin-bottom: 7px;
    }

    .lab-input {
        min-height: 42px;
        border: 1px solid #dfe7e9;
        border-radius: 8px;
        background-color: #fff;
        color: #465b62;
        font-size: 12px;
        box-shadow: none;
    }

    .lab-input:focus {
        border-color: #83b7ba;
        box-shadow: 0 0 0 3px rgba(117, 170, 186, .13);
    }

    .lab-filter-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 9px;
        margin-top: 22px;
        padding-top: 17px;
        border-top: 1px solid #edf1f2;
    }

    .lab-primary-button,
    .lab-secondary-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 38px;
        padding: 9px 14px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 650;
        text-decoration: none;
        cursor: pointer;
        transition: background .15s ease, border-color .15s ease;
    }

    .lab-primary-button {
        border: 1px solid #6dabb0;
        background: #75aaba;
        color: #fff;
    }

    .lab-primary-button:hover {
        background: #639ba5;
        border-color: #639ba5;
        color: #fff;
    }

    .lab-secondary-button {
        border: 1px solid #dce5e7;
        background: #fff;
        color: #667980;
    }

    .lab-secondary-button:hover {
        background: #f5f9f9;
        border-color: #b9ced1;
        color: #476a71;
    }

    .lab-table-count {
        background: #edf6f5;
        color: #538c88;
        border-radius: 8px;
        padding: 6px 10px;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
    }

    .lab-table {
        min-width: 900px;
        border-collapse: separate;
        border-spacing: 0;
    }

    .lab-table thead th {
        background: #f7fafb;
        color: #71838a;
        border-bottom: 1px solid #e8eef0;
        padding: 13px 15px;
        font-size: 10px;
        font-weight: 750;
        letter-spacing: .35px;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .lab-table tbody td {
        color: #5c6e75;
        border-bottom: 1px solid #edf1f2;
        padding: 14px 15px;
        font-size: 11px;
        vertical-align: middle;
    }

    .lab-table tbody tr:last-child td {
        border-bottom: 0;
    }

    .lab-table tbody tr:hover {
        background: #f8fbfb;
    }

    .lab-request-number {
        color: #568f95;
        font-weight: 750;
    }

    .lab-patient-name {
        color: #394e56 !important;
        font-weight: 650;
        white-space: nowrap;
    }

    .lab-category-tag {
        display: inline-block;
        background: #f0f5f6;
        color: #6c8087;
        border-radius: 6px;
        padding: 5px 7px;
        white-space: nowrap;
    }

    .lab-status-tag {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        border-radius: 6px;
        padding: 5px 7px;
