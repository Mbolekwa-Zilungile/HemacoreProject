@model HemaCore.Models.ViewModels.LabTechnicianDashboardViewModel

@{
    ViewData["Title"] = "Lab Technician Dashboard";
    Layout = "_LabTechnicianLayout";
}

<style>
    body {
        background: #f5f6f8;
        color: #1d2939;
    }

    .dashboard-container {
        max-width: 1600px;
        margin: 0 auto;
    }

    /* HEADER */

    .dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 30px;
    }

    .page-title {
        font-size: 25px;
        font-weight: 700;
        letter-spacing: -0.5px;
        margin-bottom: 6px;
        color: #1d2939;
    }

    .page-subtitle {
        font-size: 14px;
        color: #667085;
        margin: 0;
    }

    .date-box {
        text-align: right;
        color: #667085;
        font-size: 13px;
        white-space: nowrap;
    }

        .date-box .date {
            color: #344054;
            font-weight: 600;
            margin-bottom: 4px;
        }

    /* SECTION HEADINGS */

    .section-heading {
        margin-bottom: 16px;
    }

    .section-title {
        font-size: 16px;
        font-weight: 700;
        color: #1d2939;
        margin-bottom: 5px;
    }

    .section-subtitle {
        font-size: 12px;
        color: #667085;
        margin: 0;
    }

    /* WORKFLOW CARDS */

    .workflow-card {
        display: block;
        height: 100%;
        padding: 20px;
        background: #ffffff;
        border: 1px solid #eaecf0;
        border-radius: 10px;
        text-decoration: none;
        transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
    }

        .workflow-card:hover {
            border-color: #75AABA;
            box-shadow: 0 5px 16px rgba(16, 24, 40, 0.06);
            transform: translateY(-2px);
        }

        .workflow-card:focus-visible,
        .workspace-link:focus-visible {
            outline: 3px solid rgba(117, 170, 186, 0.45);
            outline-offset: 3px;
        }

    .workflow-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 22px;
    }

    .workflow-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 42px;
        height: 42px;
        border-radius: 9px;
        background: #edf5f7;
        color: #4f899a;
        font-size: 17px;
    }

    .workflow-arrow {
        color: #98a2b3;
        font-size: 13px;
        transition: color 0.2s ease, transform 0.2s ease;
    }

    .workflow-card:hover .workflow-arrow {
        color: #4f899a;
        transform: translate(2px, -2px);
    }

    .workflow-count {
        color: #1d2939;
        font-size: 30px;
        font-weight: 700;
        line-height: 1.2;
        margin-bottom: 7px;
    }

    .workflow-label {
        color: #344054;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 5px;
    }

    .workflow-description {
        color: #98a2b3;
        font-size: 12px;
        line-height: 1.5;
        margin: 0;
    }

    /* WORKSPACE */

    .workspace-section {
        margin-top: 32px;
    }

    .workspace-panel {
        background: #ffffff;
        border: 1px solid #eaecf0;
        border-radius: 10px;
        overflow: hidden;
    }

    .workspace-link {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 17px 20px;
        color: inherit;
        text-decoration: none;
        transition: background 0.2s ease;
    }

        .workspace-link + .workspace-link {
            border-top: 1px solid #eaecf0;
        }

        .workspace-link:hover {
            background: #f8fbfc;
            color: inherit;
        }

    .workspace-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        flex-shrink: 0;
        background: #f2f4f7;
        color: #475467;
        border-radius: 8px;
        font-size: 15px;
    }

    .workspace-text {
        flex: 1;
        min-width: 0;
    }

    .workspace-label {
        color: #344054;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 4px;
    }

    .workspace-description {
        color: #667085;
        font-size: 12px;
        margin: 0;
        line-height: 1.5;
    }

    .workspace-arrow {
        color: #98a2b3;
        font-size: 13px;
    }

    /* RESPONSIVE */

    @@media (max-width: 767px) {
        .dashboard-container {
            padding-left: 16px !important;
            padding-right: 16px !important;
        }

        .dashboard-header {
            align-items: flex-start;
        }

        .page-title {
            font-size: 21px;
        }

        .date-box {
            font-size: 11px;
        }

        .workflow-card {
            padding: 16px;
        }

        .workflow-count {
            font-size: 26px;
        }
    }

    @@media (max-width: 420px) {
        .dashboard-header {
            flex-direction: column;
            gap: 12px;
        }

        .date-box {
            text-align: left;
        }
    }
</style>

<div class="container-fluid dashboard-container px-4 py-4">

    <!-- PAGE HEADER -->

    <div class="dashboard-header">
        <div>
            <h1 class="page-title">
                Welcome, @Model.TechnicianName
            </h1>

            <p class="page-subtitle">
                Here's your laboratory workflow at a glance.
            </p>
        </div>

        <div class="date-box">
            <div class="date">
                <i class="far fa-calendar me-1"></i>
                @DateTime.Now.ToString("dd MMMM yyyy")
            </div>

            <div>
                <i class="far fa-clock me-1"></i>
                @DateTime.Now.ToString("HH:mm")
            </div>
        </div>
    </div>

    <!-- WORKFLOW OVERVIEW -->

    <div class="section-heading">
        <h2 class="section-title">Workflow Overview</h2>
        <p class="section-subtitle">
            Select a stage to view the items requiring attention.
        </p>
    </div>

    <div class="row g-3">

        <!-- RECEIVE SAMPLES -->

        <div class="col-xl-3 col-md-6">
            <a asp-controller="LabTechnician"
               asp-action="ReceiveSample"
               class="workflow-card">

                <div class="workflow-top">
                    <div class="workflow-icon">
                        <i class="fas fa-vial"></i>
                    </div>

                    <i class="fas fa-arrow-up-right-from-square workflow-arrow"></i>
                </div>

                <div class="workflow-count">
                    @Model.SamplesAwaitingReceipt
                </div>

                <div class="workflow-label">
                    Samples to Receive
                </div>

                <p class="workflow-description">
                    Samples awaiting receipt and registration.
                </p>
            </a>
        </div>

        <!-- PROCESS TESTS -->

        <div class="col-xl-3 col-md-6">
            <a asp-controller="LabTechnician"
               asp-action="ProcessTests"
               class="workflow-card">

                <div class="workflow-top">
                    <div class="workflow-icon">
                        <i class="fas fa-microscope"></i>
                    </div>

                    <i class="fas fa-arrow-up-right-from-square workflow-arrow"></i>
                </div>

                <div class="workflow-count">
                    @Model.TestsAwaitingProcessing
                </div>

                <div class="workflow-label">
                    Tests to Process
                </div>

                <p class="workflow-description">
                    Tests ready for processing or currently in progress.
                </p>
            </a>
        </div>

        <!-- VERIFY RESULTS -->

        <div class="col-xl-3 col-md-6">
            <a asp-controller="LabTechnician"
               asp-action="VerifyResults"
               class="workflow-card">

                <div class="workflow-top">
                    <div class="workflow-icon">
                        <i class="fas fa-shield-halved"></i>
                    </div>

                    <i class="fas fa-arrow-up-right-from-square workflow-arrow"></i>
                </div>

                <div class="workflow-count">
                    @Model.WaitingVerification
                </div>

                <div class="workflow-label">
                    Awaiting Verification
                </div>

                <p class="workflow-description">
                    Results waiting for verification.
                </p>
            </a>
        </div>

        <!-- REVIEW RESULTS -->

        <div class="col-xl-3 col-md-6">
            <a asp-controller="LabTechnician"
               asp-action="ReviewResults"
               class="workflow-card">

                <div class="workflow-top">
                    <div class="workflow-icon">
                        <i class="fas fa-clipboard-check"></i>
                    </div>

                    <i class="fas fa-arrow-up-right-from-square workflow-arrow"></i>
                </div>

                <div class="workflow-count">
                    @Model.WaitingReview
                </div>

                <div class="workflow-label">
                    Awaiting Review
                </div>

                <p class="workflow-description">
                    Verified results waiting for review.
                </p>
            </a>
        </div>

    </div>

    <!-- MY WORKSPACE -->

    <div class="workspace-section">

        <div class="section-heading">
            <h2 class="section-title">My Workspace</h2>

            <p class="section-subtitle">
                Access your completed work, reports and account settings.
            </p>
        </div>

        <div class="workspace-panel">

            <!-- COMPLETED TESTS -->

            <a asp-controller="LabTechnician"
               asp-action="MyCompletedTests"
               class="workspace-link">

                <div class="workspace-icon">
                    <i class="fas fa-circle-check"></i>
                </div>

                <div class="workspace-text">
                    <div class="workspace-label">
                        My Completed Tests
                    </div>

                    <p class="workspace-description">
                        View tests you have completed.
                    </p>
                </div>

                <i class="fas fa-chevron-right workspace-arrow"></i>
            </a>

            <!-- REPORTS -->

            <a asp-controller="LabTechnician"
               asp-action="Reports"
               class="workspace-link">

                <div class="workspace-icon">
                    <i class="fas fa-file-lines"></i>
                </div>

                <div class="workspace-text">
                    <div class="workspace-label">
                        Reports
                    </div>

                    <p class="workspace-description">
                        Access available laboratory reports.
                    </p>
                </div>

                <i class="fas fa-chevron-right workspace-arrow"></i>
            </a>

            <!-- MY ACCOUNT -->

            <a asp-controller="LabTechnician"
               asp-action="TechnicianProfile"
               class="workspace-link">

                <div class="workspace-icon">
                    <i class="fas fa-user-gear"></i>
                </div>

                <div class="workspace-text">
                    <div class="workspace-label">
                        My Account
                    </div>

                    <p class="workspace-description">
                        Manage your profile and password.
                    </p>
                </div>

                <i class="fas fa-chevron-right workspace-arrow"></i>
            </a>

        </div>
    </div>

</div>
