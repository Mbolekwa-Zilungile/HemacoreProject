
@model HemaCore.Models.ViewModels.LabTechnicianDashboardViewModel

@{
    ViewData["Title"] = "Lab Technician Dashboard";
    Layout = "_LabTechnicianLayout";
}

<style>
    /* ==============================
           DASHBOARD CARDS
           ============================== */

    .dashboard-card,
    .alert-card {
        border-radius: 14px;
        overflow: hidden;
        transition: all 0.2s ease;
        position: relative;
    }

        .dashboard-card:hover,
        .alert-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.10) !important;
        }

        .dashboard-card h2,
        .alert-card h2 {
            font-size: 30px;
            letter-spacing: -0.5px;
        }

    /* ==============================
           ICONS
           ============================== */

    .dashboard-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        flex-shrink: 0;
    }

    /* ==============================
           KPI CARD COLOURS
           ============================== */

    .selected-card {
        border-left: 5px solid #4e73df !important;
        background: linear-gradient(135deg, #ffffff 70%, #eef2ff);
    }

        .selected-card .dashboard-icon {
            background: #e8edff;
            color: #4e73df;
        }

    .waiting-card {
        border-left: 5px solid #f6c23e !important;
        background: linear-gradient(135deg, #ffffff 70%, #fff8df);
    }

        .waiting-card .dashboard-icon {
            background: #fff4cc;
            color: #d89b00;
        }

    .verification-card {
        border-left: 5px solid #1cc88a !important;
        background: linear-gradient(135deg, #ffffff 70%, #eafff6);
    }

        .verification-card .dashboard-icon {
            background: #dcfaef;
            color: #16a673;
        }

    .review-card {
        border-left: 5px solid #6f42c1 !important;
        background: linear-gradient(135deg, #ffffff 70%, #f3edff);
    }

        .review-card .dashboard-icon {
            background: #eee5ff;
            color: #6f42c1;
        }

    /* ==============================
           ALERT CARD COLOURS
           ============================== */

    .urgent-card {
        border-left: 5px solid #dc3545 !important;
        background: linear-gradient(135deg, #ffffff 70%, #fff0f1);
    }

        .urgent-card .dashboard-icon {
            background: #ffe1e4;
            color: #dc3545;
        }

    .overdue-card {
        border-left: 5px solid #fd7e14 !important;
        background: linear-gradient(135deg, #ffffff 70%, #fff3e8);
    }

        .overdue-card .dashboard-icon {
            background: #ffe8d2;
            color: #e76500;
        }

    .nearing-card {
        border-left: 5px solid #20c997 !important;
        background: linear-gradient(135deg, #ffffff 70%, #eafff8);
    }

        .nearing-card .dashboard-icon {
            background: #dffaf2;
            color: #159b75;
        }

    /* ==============================
           OTHER CARDS
           ============================== */

    .card.border-0.shadow-sm {
        border-radius: 14px;
    }

    .badge {
        padding: 6px 10px;
        border-radius: 8px;
        font-weight: 600;
    }
</style>


<div class="container-fluid px-4 py-4">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                Hi, @Model.TechnicianName 👋
            </h2>

            <p class="text-muted mb-0">
                Here's your laboratory workload and test activity for today.
            </p>
        </div>

        <div class="text-end">

            <div class="fw-semibold">
                <i class="fas fa-calendar-day me-2"></i>
                @DateTime.Now.ToString("dd MMMM yyyy")
            </div>

            <div class="text-muted mt-1">
                <i class="fas fa-clock me-2"></i>

                <span id="currentTime">
                    @DateTime.Now.ToString("HH:mm:ss")
                </span>
            </div>

        </div>

    </div>


    <!-- KPI CARDS -->
    <div class="row g-4 mb-4">

        <!-- MY SELECTED TESTS -->
        <div class="col-xl-3 col-md-6">

            <div class="card dashboard-card selected-card h-100 shadow-sm border-0 clickable-card"
                 data-filter="selected"
                 style="cursor:pointer;">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>

                            <p class="text-muted mb-2">
                                My Selected Tests
                            </p>

                            <h2 class="fw-bold mb-0">
                                @Model.MySelectedTests
                            </h2>

                        </div>

                        <div class="dashboard-icon">
                            <i class="fas fa-microscope"></i>
                        </div>

                    </div>

                    <small class="text-muted">
                        Tests currently assigned to you
                    </small>

                </div>

            </div>

        </div>


        <!-- WAITING TO BE SELECTED -->
        <div class="col-xl-3 col-md-6">

            <div class="card dashboard-card waiting-card h-100 shadow-sm border-0 clickable-card"
                 data-filter="waiting"
                 style="cursor:pointer;">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>

                            <p class="text-muted mb-2">
                                Waiting to be Selected
                            </p>

                            <h2 class="fw-bold mb-0">
                                @Model.WaitingToBeSelected
                            </h2>

                        </div>

                        <div class="dashboard-icon">
                            <i class="fas fa-hourglass-half"></i>
                        </div>

                    </div>

                    <small class="text-muted">
                        Tests available for selection
                    </small>

                </div>

            </div>

        </div>


        <!-- WAITING VERIFICATION -->
        <div class="col-xl-3 col-md-6">

            <div class="card dashboard-card verification-card h-100 shadow-sm border-0 clickable-card"
                 data-filter="verification"
                 style="cursor:pointer;">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>

                            <p class="text-muted mb-2">
                                Waiting Verification
                            </p>

                            <h2 class="fw-bold mb-0">
                                @Model.WaitingVerification
                            </h2>

                        </div>

                        <div class="dashboard-icon">
                            <i class="fas fa-check-double"></i>
                        </div>

                    </div>

                    <small class="text-muted">
                        Results waiting for verification
                    </small>

                </div>

            </div>

        </div>


        <!-- WAITING REVIEW -->
        <div class="col-xl-3 col-md-6">

            <div class="card dashboard-card review-card h-100 shadow-sm border-0 clickable-card"
                 data-filter="review"
                 style="cursor:pointer;">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>

                            <p class="text-muted mb-2">
                                Waiting Review
                            </p>

                            <h2 class="fw-bold mb-0">
                                @Model.WaitingReview
                            </h2>

                        </div>

                        <div class="dashboard-icon">
                            <i class="fas fa-clipboard-list"></i>
                        </div>

                    </div>

                    <small class="text-muted">
                        Results returned for review
                    </small>

                </div>

            </div>

        </div>

    </div>


    <!-- ALERT CARDS -->
    <div class="row g-4 mb-4">

        <!-- STAT -->
        <div class="col-lg-4">

            <div class="card alert-card urgent-card border-0 shadow-sm h-100 clickable-card"
                 data-filter="urgent"
                 style="cursor:pointer;">

                <div class="card-body">

                    <div class="d-flex align-items-center mb-3">

                        <div class="dashboard-icon">
                            <i class="fas fa-bolt"></i>
                        </div>

                        <h5 class="fw-bold mb-0 ms-3">
                            Urgent / STAT Tests
                        </h5>

                    </div>

                    <h2 class="fw-bold">
                        @Model.UrgentTests
                    </h2>

                    <p class="text-muted mb-0">
                        Urgent tests requiring immediate attention.
                    </p>

                </div>

            </div>

        </div>


        <!-- OVERDUE -->
        <div class="col-lg-4">

            <div class="card alert-card overdue-card border-0 shadow-sm h-100 clickable-card"
                 data-filter="overdue"
                 style="cursor:pointer;">

                <div class="card-body">

                    <div class="d-flex align-items-center mb-3">

                        <div class="dashboard-icon">
                            <i class="fas fa-clock"></i>
                        </div>

                        <h5 class="fw-bold mb-0 ms-3">
                            Overdue Tests
                        </h5>

                    </div>

                    <h2 class="fw-bold">
                        @Model.OverdueTests
                    </h2>

                    <p class="text-muted mb-0">
                        Tests that have exceeded their turnaround time.
                    </p>

                </div>

            </div>

        </div>


        <!-- NEARING TURNAROUND -->
        <div class="col-lg-4">

            <div class="card alert-card nearing-card border-0 shadow-sm h-100 clickable-card"
                 data-filter="nearing"
                 style="cursor:pointer;">

                <div class="card-body">

                    <div class="d-flex align-items-center mb-3">

                        <div class="dashboard-icon">
                            <i class="fas fa-stopwatch"></i>
                        </div>

                        <h5 class="fw-bold mb-0 ms-3">
                            Nearing Turnaround Limit
                        </h5>

                    </div>

                    <h2 class="fw-bold">
                        @Model.NearingTurnaround
                    </h2>

                    <p class="text-muted mb-0">
                        Tests approaching their expected completion time.
                    </p>

                </div>

            </div>

        </div>

    </div>


    <!-- FILTERS -->
    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body">

            <div class="d-flex align-items-center mb-3">

                <i class="fas fa-filter me-2"></i>

                <h5 class="fw-bold mb-0">
                    Filter Tests
                </h5>

            </div>

            <div class="row g-3">

                <div class="col-md-3">

                    <label class="form-label">
                        Urgency
                    </label>

                    <select id="urgencyFilter"
                            class="form-select">

                        <option value="">All</option>
                        <option value="Routine">Routine</option>
                        <option value="Urgent">Urgent</option>
                        <option value="STAT">STAT</option>

                    </select>

                </div>


                <div class="col-md-3">

                    <label class="form-label">
                        Test Type
                    </label>

                    <select id="testTypeFilter"
                            class="form-select">

                        <option value="">
                            All Test Types
                        </option>

                        @foreach (var testType in Model.Workload
                            .Select(x => x.TestTypeName)
                            .Where(x => !string.IsNullOrEmpty(x))
                            .Distinct())
                        {
                            <option value="@testType">
                                @testType
                            </option>
                        }

                    </select>

                </div>


                <div class="col-md-3">

                    <label class="form-label">
                        Status
                    </label>

                    <select id="statusFilter"
                            class="form-select">

                        <option value="">All</option>
                        <option value="Submitted">Submitted</option>
                        <option value="In Progress">In Progress</option>
                        <option value="Completed">Completed</option>

                    </select>

                </div>


                <div class="col-md-3">

                    <label class="form-label">
                        Request Number
                    </label>

                    <input type="text"
                           id="requestFilter"
                           class="form-control"
                           placeholder="Search request number">

                </div>

            </div>

        </div>

    </div>


    <!-- TEST WORKLOAD TABLE -->
    <div class="card border-0 shadow-sm">

        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-3">

                <div>

                    <h5 class="fw-bold mb-1">

                        <i class="fas fa-microscope me-2"></i>

                        Test Workload

                    </h5>

                    <p class="text-muted mb-0">
                        Tests requiring your attention.
                    </p>

                </div>

                <span id="testCount"
                      class="badge bg-secondary">

                    @Model.Workload.Count Tests

                </span>

            </div>


            <div class="table-responsive">

                <table class="table table-hover align-middle"
                       id="workloadTable">

                    <thead class="table-light">

                        <tr>

                            <th>Request No.</th>
                            <th>Patient</th>
                            <th>Test Type</th>
                            <th>Urgency</th>
                            <th>Status</th>
                            <th>Due Time</th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (Model.Workload == null || !Model.Workload.Any())
                        {
                            <tr>

                                <td colspan="6"
                                    class="text-center text-muted py-5">

                                    <i class="fas fa-inbox fa-2x mb-3 d-block"></i>

                                    No tests currently require your attention.

                                </td>

                            </tr>
                        }
                        else
                        {
                            foreach (var test in Model.Workload)
                            {
                                <tr class="workload-row"
                                    data-urgency="@test.Urgency"
                                    data-testtype="@test.TestTypeName"
                                    data-status="@test.Status"
                                    data-request="@test.TestRequestId"
                                    data-due="@test.DueTime">

                                    <td>
                                        #@test.TestRequestId
                                    </td>

                                    <td>
                                        @test.PatientName
                                    </td>

                                    <td>
                                        @test.TestTypeName
                                    </td>

                                    <td>

                                        @if (test.Urgency == "STAT")
                                        {
                                            <span class="badge bg-danger">
                                                STAT
                                            </span>
                                        }
                                        else if (test.Urgency == "Urgent")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Urgent
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @test.Urgency
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        @if (test.Status == "Completed")
                                        {
                                            <span class="badge bg-success">
                                                Completed
                                            </span>
                                        }
                                        else if (test.Status == "In Progress")
                                        {
                                            <span class="badge bg-primary">
                                                In Progress
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">
                                                @test.Status
                                            </span>
                                        }

                                    </td>

                                    <td>
                                        @(test.DueTime?.ToString("dd/MM/yyyy HH:mm") ?? "-")
                                    </td>

                                </tr>
                            }

                            <tr id="noFilterResults"
                                style="display:none;">

                                <td colspan="6"
                                    class="text-center text-muted py-5">

                                    <i class="fas fa-search fa-2x mb-3 d-block"></i>

                                    No tests match the selected filter.

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>


<script>

    document.addEventListener("DOMContentLoaded", function() {

        /* ==============================
           LIVE CLOCK
           ============================== */

        function updateTime() {

            const now = new Date();

            const time = now.toLocaleTimeString("en-GB", {
                hour: "2-digit",
                minute: "2-digit",
                second: "2-digit"
            });

            const timeElement =
                document.getElementById("currentTime");

            if (timeElement) {
                timeElement.textContent = time;
            }

        }

        updateTime();

        setInterval(updateTime, 1000);


        /* ==============================
           FILTER ELEMENTS
           ============================== */

        const urgencyFilter =
            document.getElementById("urgencyFilter");

        const testTypeFilter =
            document.getElementById("testTypeFilter");

        const statusFilter =
            document.getElementById("statusFilter");

        const requestFilter =
            document.getElementById("requestFilter");

        const rows =
            document.querySelectorAll(".workload-row");

        const testCount =
            document.getElementById("testCount");

        const noResults =
            document.getElementById("noFilterResults");


        /* ==============================
           FILTER TESTS
           ============================== */

        function filterTests(cardFilter = null) {

            let visibleCount = 0;

            rows.forEach(function(row) {

                let show = true;

                const urgency =
                    row.dataset.urgency || "";

                const testType =
                    row.dataset.testtype || "";

                const status =
                    row.dataset.status || "";

                const request =
                    row.dataset.request || "";

                const due =
                    row.dataset.due || "";


                /* NORMAL FILTERS */

                if (
                    urgencyFilter.value &&
                    urgency.toLowerCase() !==
                    urgencyFilter.value.toLowerCase()
                ) {
                    show = false;
                }


                if (
                    testTypeFilter.value &&
                    testType.toLowerCase() !==
                    testTypeFilter.value.toLowerCase()
                ) {
                    show = false;
                }


                if (
                    statusFilter.value &&
                    status.toLowerCase() !==
                    statusFilter.value.toLowerCase()
                ) {
                    show = false;
                }


                if (
                    requestFilter.value &&
                    !request.toLowerCase().includes(
                        requestFilter.value.toLowerCase()
                    )
                ) {
                    show = false;
                }


                /* DASHBOARD CARD FILTERS */

                if (cardFilter === "selected") {

                    if (
                        status === "Completed" ||
                        status === "Submitted"
                    ) {
                        show = false;
                    }

                }


                if (cardFilter === "waiting") {

                    if (status !== "Submitted") {
                        show = false;
                    }

                }


                if (cardFilter === "verification") {

                    if (status !== "Completed") {
                        show = false;
                    }

                }


                if (cardFilter === "review") {

                    show = false;

                }


                if (cardFilter === "urgent") {

                    if (urgency !== "STAT") {
                        show = false;
                    }

                }


                if (cardFilter === "overdue") {

                    if (!due) {

                        show = false;

                    }
                    else {

                        const dueDate =
                            new Date(due);

                        if (
                            dueDate >= new Date() ||
                            status === "Completed"
                        ) {
                            show = false;
                        }

                    }

                }


                if (cardFilter === "nearing") {

                    if (!due) {

                        show = false;

                    }
                    else {

                        const dueDate =
                            new Date(due);

                        const now =
                            new Date();

                        const twoHours =
                            new Date(
                                now.getTime() +
                                (2 * 60 * 60 * 1000)
                            );

                        if (
                            dueDate <= now ||
                            dueDate > twoHours ||
                            status === "Completed"
                        ) {
                            show = false;
                        }

                    }

                }


                /* SHOW / HIDE */

                if (show) {

                    row.style.display = "";

                    visibleCount++;

                }
                else {

                    row.style.display = "none";

                }

            });


            /* UPDATE COUNT */

            testCount.textContent =
                visibleCount + " Tests";


            /* NO RESULTS */

            if (noResults) {

                noResults.style.display =
                    visibleCount === 0
                        ? ""
                        : "none";

            }

        }


        /* NORMAL FILTER EVENTS */

        urgencyFilter.addEventListener(
            "change",
            function() {
                filterTests();
            }
        );

        testTypeFilter.addEventListener(
            "change",
            function() {
                filterTests();
            }
        );

        statusFilter.addEventListener(
            "change",
            function() {
                filterTests();
            }
        );

        requestFilter.addEventListener(
            "keyup",
            function() {
                filterTests();
            }
        );


        /* DASHBOARD CARD EVENTS */

        document
            .querySelectorAll(".clickable-card")
            .forEach(function(card) {

                card.addEventListener(
                    "click",
                    function() {

                        const filter =
                            card.dataset.filter;

                        filterTests(filter);

                        document
                            .getElementById("workloadTable")
                            .scrollIntoView({
                                behavior: "smooth",
                                block: "start"
                            });

                    }
                );

            });

    });

</script>

