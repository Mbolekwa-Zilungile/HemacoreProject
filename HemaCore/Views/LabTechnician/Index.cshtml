@model HemaCore.Models.ViewModels.LabTechnicianDashboardViewModel

@{
    ViewData["Title"] = "Lab Technician Dashboard";
    Layout = "_LabTechnicianLayout";
}

<style>
    :root {
        --hc-bg: #f6f7f9;
        --hc-surface: #ffffff;
        --hc-surface-hover: #f7fafb;
        --hc-border: #e4e7ec;
        --hc-text: #101828;
        --hc-text-2: #475467;
        --hc-text-3: #667085;
        --hc-brand: #3f8499;
        --hc-brand-soft: #e8f2f5;
        --hc-brand-ring: rgba(63, 132, 153, .35);
        --hc-danger: #c0392b;
        --hc-danger-soft: #fdeceb;
        --hc-warn: #b7791f;
        --hc-warn-soft: #fdf3dc;
        --hc-radius: 12px;
        --hc-radius-sm: 8px;
    }

    @@media (prefers-color-scheme: dark) {
        :root {
            --hc-bg: #0f1419;
            --hc-surface: #171d25;
            --hc-surface-hover: #1c242e;
            --hc-border: #2a3441;
            --hc-text: #f2f4f7;
            --hc-text-2: #b6bfcc;
            --hc-text-3: #8d98a8;
            --hc-brand: #6fb3c7;
            --hc-brand-soft: #1b2f37;
            --hc-brand-ring: rgba(111, 179, 199, .45);
            --hc-danger: #f08a7e;
            --hc-danger-soft: #3a1f1d;
            --hc-warn: #e8b960;
            --hc-warn-soft: #382d16;
        }
    }

    body {
        background: var(--hc-bg);
        color: var(--hc-text);
    }

    .hc-dashboard {
        max-width: 1400px;
        margin: 0 auto;
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    }

    /* ---------- Header ---------- */

    .hc-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 16px;
        margin-bottom: 28px;
    }

    .hc-title {
        font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem);
        font-weight: 700;
        letter-spacing: -.02em;
        margin: 0 0 4px;
    }

    .hc-subtitle {
        color: var(--hc-text-3);
        font-size: .9rem;
        margin: 0;
    }

    .hc-clock {
        text-align: right;
        color: var(--hc-text-3);
        font-size: .8rem;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
    }

        .hc-clock strong {
            display: block;
            color: var(--hc-text-2);
            font-size: .875rem;
            font-weight: 600;
        }

    /* ---------- Sections ---------- */

    .hc-section {
        margin-top: 32px;
    }

    .hc-section-head {
        margin-bottom: 12px;
    }

    .hc-section-title {
        font-size: 1rem;
        font-weight: 650;
        margin: 0 0 2px;
    }

    .hc-section-sub {
        color: var(--hc-text-3);
        font-size: .8rem;
        margin: 0;
    }

    /* ---------- Shared link behaviour ---------- */

    .hc-tile,
    .hc-stage,
    .hc-link {
        text-decoration: none;
        color: inherit;
    }

        .hc-tile:focus-visible,
        .hc-stage:focus-visible,
        .hc-link:focus-visible {
            outline: 3px solid var(--hc-brand-ring);
            outline-offset: -3px;
        }

    .hc-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        flex-shrink: 0;
        border-radius: var(--hc-radius-sm);
        background: var(--hc-brand-soft);
        color: var(--hc-brand);
        font-size: .95rem;
    }

    .hc-count {
        font-size: 2rem;
        font-weight: 700;
        line-height: 1;
        letter-spacing: -.02em;
        font-variant-numeric: tabular-nums;
    }

    .hc-label {
        font-size: .875rem;
        font-weight: 600;
        color: var(--hc-text);
    }

    .hc-desc {
        font-size: .78rem;
        line-height: 1.45;
        color: var(--hc-text-3);
        margin: 0;
    }

    /* ---------- Needs attention (the focal block) ---------- */

    .hc-attention {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
    }

    .hc-tile {
        display: grid;
        grid-template-columns: auto 1fr;
        column-gap: 14px;
        row-gap: 2px;
        align-items: center;
        padding: 18px 20px;
        background: var(--hc-surface);
        border: 1px solid var(--hc-border);
        border-left: 4px solid var(--hc-border);
        border-radius: var(--hc-radius);
        transition: background-color .15s ease, border-color .15s ease;
    }

        .hc-tile:hover {
            background: var(--hc-surface-hover);
        }

        .hc-tile .hc-count {
            grid-row: 1 / span 3;
            min-width: 2.2ch;
            text-align: center;
        }

        .hc-tile.is-danger {
            border-left-color: var(--hc-danger);
        }

            .hc-tile.is-danger .hc-count,
            .hc-tile.is-danger .hc-icon {
                color: var(--hc-danger);
            }

            .hc-tile.is-danger .hc-icon {
                background: var(--hc-danger-soft);
            }

        .hc-tile.is-warn {
            border-left-color: var(--hc-warn);
        }

            .hc-tile.is-warn .hc-count,
            .hc-tile.is-warn .hc-icon {
                color: var(--hc-warn);
            }

            .hc-tile.is-warn .hc-icon {
                background: var(--hc-warn-soft);
            }

        .hc-tile .hc-label {
            display: flex;
            align-items: center;
            gap: 8px;
        }

    /* ---------- Workflow stages ---------- */

    .hc-pipeline {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        background: var(--hc-surface);
        border: 1px solid var(--hc-border);
        border-radius: var(--hc-radius);
        overflow: hidden;
    }

    .hc-stage {
        display: flex;
        flex-direction: column;
        gap: 8px;
        padding: 20px;
        transition: background-color .15s ease;
    }

        .hc-stage + .hc-stage {
            border-left: 1px solid var(--hc-border);
        }

        .hc-stage:hover {
            background: var(--hc-surface-hover);
        }

    .hc-stage-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 6px;
    }

        .hc-stage-top .fa-arrow-right {
            color: var(--hc-text-3);
            font-size: .75rem;
            transition: transform .15s ease, color .15s ease;
        }

    .hc-stage:hover .fa-arrow-right {
        color: var(--hc-brand);
        transform: translateX(3px);
    }

    /* ---------- Filters ---------- */

    .hc-filters {
        background: var(--hc-surface);
        border: 1px solid var(--hc-border);
        border-radius: var(--hc-radius);
        padding: 20px;
    }

    .hc-filter-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 14px;
    }

    .hc-field label {
        display: block;
        font-size: .78rem;
        font-weight: 600;
        color: var(--hc-text-2);
        margin-bottom: 6px;
    }

    .hc-input {
        width: 100%;
        min-height: 40px;
        padding: 8px 12px;
        font: inherit;
        font-size: .875rem;
        color: var(--hc-text);
        background: var(--hc-surface);
        border: 1px solid var(--hc-border);
        border-radius: var(--hc-radius-sm);
    }

        .hc-input::placeholder {
            color: var(--hc-text-3);
        }

        .hc-input:focus {
            outline: none;
            border-color: var(--hc-brand);
            box-shadow: 0 0 0 3px var(--hc-brand-ring);
        }

    .hc-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 16px;
    }

    .hc-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 40px;
        padding: 8px 18px;
        font: inherit;
        font-size: .875rem;
        font-weight: 600;
        text-decoration: none;
        border-radius: var(--hc-radius-sm);
        cursor: pointer;
    }

        .hc-btn:focus-visible {
            outline: 3px solid var(--hc-brand-ring);
            outline-offset: 2px;
        }

    .hc-btn-primary {
        background: var(--hc-brand);
        border: 1px solid var(--hc-brand);
        color: #fff;
    }

        .hc-btn-primary:hover {
            filter: brightness(.93);
            color: #fff;
        }

    .hc-btn-ghost {
        background: transparent;
        border: 1px solid var(--hc-border);
        color: var(--hc-text-2);
    }

        .hc-btn-ghost:hover {
            background: var(--hc-surface-hover);
            color: var(--hc-text);
        }

    /* ---------- Workspace ---------- */

    .hc-workspace {
        background: var(--hc-surface);
        border: 1px solid var(--hc-border);
        border-radius: var(--hc-radius);
        overflow: hidden;
    }

    .hc-link {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 16px 20px;
        transition: background-color .15s ease;
    }

        .hc-link + .hc-link {
            border-top: 1px solid var(--hc-border);
        }

        .hc-link:hover {
            background: var(--hc-surface-hover);
        }

        .hc-link .hc-icon {
            background: var(--hc-bg);
            color: var(--hc-text-2);
        }

    .hc-link-text {
        flex: 1;
        min-width: 0;
    }

    .hc-link .fa-chevron-right {
        color: var(--hc-text-3);
        font-size: .75rem;
    }

    /* ---------- Responsive ---------- */

    @@media (max-width: 1199px) {
        .hc-pipeline {
            grid-template-columns: repeat(2, 1fr);
        }

        .hc-stage + .hc-stage {
            border-left: 0;
        }

        .hc-stage:nth-child(even) {
            border-left: 1px solid var(--hc-border);
        }

        .hc-stage:nth-child(n + 3) {
            border-top: 1px solid var(--hc-border);
        }

        .hc-filter-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 767px) {
        .hc-dashboard {
            padding-left: 16px !important;
            padding-right: 16px !important;
        }

        .hc-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .hc-clock {
            text-align: left;
        }

        .hc-attention,
        .hc-pipeline,
        .hc-filter-grid {
            grid-template-columns: 1fr;
        }

        .hc-stage:nth-child(even) {
            border-left: 0;
        }

        .hc-stage:nth-child(n + 2) {
            border-top: 1px solid var(--hc-border);
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .hc-tile,
        .hc-stage,
        .hc-link,
        .hc-stage-top .fa-arrow-right {
            transition: none;
        }

            .hc-stage:hover .fa-arrow-right {
                transform: none;
            }
    }
</style>

<div class="container-fluid hc-dashboard px-4 py-4">

    <!-- HEADER -->

    <header class="hc-header">
        <div>
            <h1 class="hc-title">Welcome, @Model.TechnicianName</h1>
            <p class="hc-subtitle">Here's your laboratory workflow at a glance.</p>
        </div>

        <div class="hc-clock">
            <strong><i class="far fa-calendar me-1"></i>@DateTime.Now.ToString("dd MMMM yyyy")</strong>
            <span><i class="far fa-clock me-1"></i>@DateTime.Now.ToString("HH:mm")</span>
        </div>
    </header>

    <!-- NEEDS ATTENTION -->

    <section class="hc-section" style="margin-top:0" aria-labelledby="attention-title">
        <div class="hc-section-head">
            <h2 id="attention-title" class="hc-section-title">Needs attention</h2>
            <p class="hc-section-sub">Tests that are urgent or running out of time.</p>
        </div>

        <div class="hc-attention">

            <a asp-controller="LabTechnician"
               asp-action="ProcessTests"
               asp-route-dueStatus="Overdue"
               class="hc-tile @(Model.OverdueTests > 0 ? "is-danger" : "")">
                <span class="hc-count">@Model.OverdueTests</span>
                <span class="hc-label">
                    <i class="fas fa-clock" aria-hidden="true"></i>
                    Overdue tests
                </span>
                <p class="hc-desc">Past their expected completion time.</p>
            </a>

            <a asp-controller="LabTechnician"
               asp-action="ProcessTests"
               asp-route-urgency="STAT"
               class="hc-tile @(Model.UrgentTests > 0 ? "is-danger" : "")">
                <span class="hc-count">@Model.UrgentTests</span>
                <span class="hc-label">
                    <i class="fas fa-bolt" aria-hidden="true"></i>
                    Urgent tests (STAT)
                </span>
                <p class="hc-desc">Marked STAT and needing immediate attention.</p>
            </a>

            <a asp-controller="LabTechnician"
               asp-action="ProcessTests"
               asp-route-dueStatus="Nearing"
               class="hc-tile @(Model.NearingTurnaround > 0 ? "is-warn" : "")">
                <span class="hc-count">@Model.NearingTurnaround</span>
                <span class="hc-label">
                    <i class="fas fa-hourglass-half" aria-hidden="true"></i>
                    Nearing turnaround limit
                </span>
                <p class="hc-desc">Approaching their expected completion deadline.</p>
            </a>

        </div>
    </section>

    <!-- WORKFLOW -->

    <section class="hc-section" aria-labelledby="workflow-title">
        <div class="hc-section-head">
            <h2 id="workflow-title" class="hc-section-title">Lab workflow</h2>
            <p class="hc-section-sub">Follow a sample from receipt through to review.</p>
        </div>

        <div class="hc-pipeline">

            <a asp-controller="LabTechnician" asp-action="ReceiveSample" class="hc-stage">
                <div class="hc-stage-top">
                    <span class="hc-icon"><i class="fas fa-vial" aria-hidden="true"></i></span>
                    <i class="fas fa-arrow-right" aria-hidden="true"></i>
                </div>
                <div class="hc-count">@Model.SamplesAwaitingReceipt</div>
                <div class="hc-label">Samples to receive</div>
                <p class="hc-desc">Requests awaiting sample receipt and registration.</p>
            </a>

            <a asp-controller="LabTechnician" asp-action="ProcessTests" class="hc-stage">
                <div class="hc-stage-top">
                    <span class="hc-icon"><i class="fas fa-list-check" aria-hidden="true"></i></span>
                    <i class="fas fa-arrow-right" aria-hidden="true"></i>
                </div>
                <div class="hc-count">@Model.WaitingToBeSelected</div>
                <div class="hc-label">Waiting to be selected</div>
                <p class="hc-desc">Eligible tests awaiting selection by a technician.</p>
            </a>

            <a asp-controller="LabTechnician" asp-action="ProcessTests" class="hc-stage">
                <div class="hc-stage-top">
                    <span class="hc-icon"><i class="fas fa-microscope" aria-hidden="true"></i></span>
                    <i class="fas fa-arrow-right" aria-hidden="true"></i>
                </div>
                <div class="hc-count">@Model.MySelectedTests</div>
                <div class="hc-label">Selected by me</div>
                <p class="hc-desc">Tests you selected and are responsible for processing.</p>
            </a>

            <a asp-controller="LabTechnician" asp-action="VerifyResults" class="hc-stage">
                <div class="hc-stage-top">
                    <span class="hc-icon"><i class="fas fa-shield-halved" aria-hidden="true"></i></span>
                    <i class="fas fa-arrow-right" aria-hidden="true"></i>
                </div>
                <div class="hc-count">@Model.WaitingVerification</div>
                <div class="hc-label">Awaiting verification</div>
                <p class="hc-desc">Completed results awaiting a second technician's verification.</p>
            </a>

            <a asp-controller="LabTechnician" asp-action="ReviewResults" class="hc-stage">
                <div class="hc-stage-top">
                    <span class="hc-icon"><i class="fas fa-clipboard-check" aria-hidden="true"></i></span>
                    <i class="fas fa-arrow-right" aria-hidden="true"></i>
                </div>
                <div class="hc-count">@Model.WaitingReview</div>
                <div class="hc-label">Awaiting review</div>
                <p class="hc-desc">Results returned for correction after verification.</p>
            </a>

        </div>
    </section>

    <!-- FIND TESTS -->

    <section class="hc-section" aria-labelledby="filters-title">
        <div class="hc-section-head">
            <h2 id="filters-title" class="hc-section-title">Find tests</h2>
            <p class="hc-section-sub">Filter your workload by urgency, category, due time or request number.</p>
        </div>

        <div class="hc-filters">
            <form asp-controller="LabTechnician" asp-action="ProcessTests" method="get">

                <div class="hc-filter-grid">

                    <div class="hc-field">
                        <label for="urgencyFilter">Urgency</label>
                        <select id="urgencyFilter" name="urgency" class="hc-input">
                            <option value="">All urgencies</option>
                            <option value="Routine">Routine</option>
                            <option value="Urgent">Urgent</option>
                            <option value="STAT">STAT</option>
                        </select>
                    </div>

                    <div class="hc-field">
                        <label for="categoryFilter">Test category</label>
                        <select id="categoryFilter" name="category" class="hc-input">
                            <option value="">All categories</option>
                            @if (ViewBag.TestCategories != null)
                            {
                                foreach (var category in ViewBag.TestCategories)
                                {
                                    <option value="@category.CategoryName">@category.CategoryName</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="hc-field">
                        <label for="dueStatusFilter">Due time</label>
                        <select id="dueStatusFilter" name="dueStatus" class="hc-input">
                            <option value="">All due times</option>
                            <option value="Nearing">Nearing deadline</option>
                            <option value="Overdue">Overdue</option>
                        </select>
                    </div>

                    <div class="hc-field">
                        <label for="requestNumberFilter">Request number</label>
                        <input id="requestNumberFilter"
                               name="requestNumber"
                               type="number"
                               min="1"
                               inputmode="numeric"
                               class="hc-input"
                               placeholder="Enter request number" />
                    </div>

                </div>

                <div class="hc-actions">
                    <button type="submit" class="hc-btn hc-btn-primary">
                        <i class="fas fa-filter" aria-hidden="true"></i>
                        Apply filters
                    </button>

                    <a asp-controller="LabTechnician" asp-action="ProcessTests" class="hc-btn hc-btn-ghost">
                        Clear filters
                    </a>
                </div>

            </form>
        </div>
    </section>

    <!-- MY WORKSPACE -->

    <section class="hc-section" aria-labelledby="workspace-title">
        <div class="hc-section-head">
            <h2 id="workspace-title" class="hc-section-title">My workspace</h2>
            <p class="hc-section-sub">Access completed work, reports and account settings.</p>
        </div>

        <div class="hc-workspace">

            <a asp-controller="LabTechnician" asp-action="MyCompletedTests" class="hc-link">
                <span class="hc-icon"><i class="fas fa-circle-check" aria-hidden="true"></i></span>
                <div class="hc-link-text">
                    <div class="hc-label">My completed tests</div>
                    <p class="hc-desc">View tests you have completed.</p>
                </div>
                <i class="fas fa-chevron-right" aria-hidden="true"></i>
            </a>

            <a asp-controller="LabTechnician" asp-action="Reports" class="hc-link">
                <span class="hc-icon"><i class="fas fa-file-lines" aria-hidden="true"></i></span>
                <div class="hc-link-text">
                    <div class="hc-label">Reports</div>
                    <p class="hc-desc">Generate and access laboratory reports.</p>
                </div>
                <i class="fas fa-chevron-right" aria-hidden="true"></i>
            </a>

            <a asp-controller="LabTechnician" asp-action="TechnicianProfile" class="hc-link">
                <span class="hc-icon"><i class="fas fa-user-gear" aria-hidden="true"></i></span>
                <div class="hc-link-text">
                    <div class="hc-label">My account</div>
                    <p class="hc-desc">Manage your profile and password.</p>
                </div>
                <i class="fas fa-chevron-right" aria-hidden="true"></i>
            </a>

        </div>
    </section>

</div>
