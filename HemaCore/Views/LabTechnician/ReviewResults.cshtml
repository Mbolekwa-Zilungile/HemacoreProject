@model IEnumerable<HemaCore.Models.TestResultVerification>

@{
    ViewData["Title"] = "Review Test Results";
    Layout = "_LabTechnicianLayout";
}

<link rel="stylesheet" href="~/css/doctor.css" />

<div class="content-card">

    <!-- HEADER -->
    <div class="section-title d-flex align-items-center justify-content-between">

        <div class="d-flex align-items-center">

            <i class="fas fa-clipboard-check me-2"></i>

            <span>Review Test Results</span>

            <span class="badge blue-badge ms-2">
                @(Model?.Count() ?? 0)
            </span>

        </div>

    </div>

    <p class="text-muted mb-3">
        Review test results that have been returned for further attention.
    </p>


    <!-- TABLE -->
    <div class="table-responsive">

        <table class="modern-table">

            <thead>

                <tr>

                    <th>Request Number</th>

                    <th>Patient</th>

                    <th>Test Type</th>

                    <th>Result</th>

                    <th>Review Notes</th>

                    <th>Action</th>

                </tr>

            </thead>

            <tbody>

                @if (Model == null || !Model.Any())
                {
                    <tr>

                        <td colspan="6" class="text-center text-muted py-4">

                            <i class="fas fa-clipboard-check fa-2x mb-2"></i>

                            <div class="fw-semibold">
                                There are currently no test results requiring review.
                            </div>

                            <small>
                                Results returned for further attention will appear here.
                            </small>

                        </td>

                    </tr>
                }
                else
                {
                    foreach (var verification in Model)
                    {
                        var result = verification.TestResult;

                        var test = result?.TestRequestTestType.FirstOrDefault();

                        <tr>

                            <!-- REQUEST NUMBER -->
                            <td class="fw-semibold blue-text">
                                #@test?.TestRequestId
                            </td>


                            <!-- PATIENT -->
                            <td>
                                @test?.TestRequest?.Patient?.Name
                                @test?.TestRequest?.Patient?.Surname
                            </td>


                            <!-- TEST TYPE -->
                            <td>
                                @test?.TestType?.TestTypeName
                            </td>


                            <!-- RESULT -->
                            <td>

                                @if (result?.IsAbnormal == true)
                                {
                                    <span class="badge bg-danger">
                                        @result.ResultValue
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success">
                                        @result?.ResultValue
                                    </span>
                                }

                            </td>


                            <!-- REVIEW NOTES -->
                            <td>

                                @if (string.IsNullOrWhiteSpace(verification.ReviewNotes))
                                {
                                    <span class="text-muted">
                                        No review notes
                                    </span>
                                }
                                else
                                {
                                    @verification.ReviewNotes
                                }

                            </td>


                            <!-- ACTION -->
                            <td>

                                <a asp-action="ReviewResultDetails"
                                   asp-route-id="@verification.TestResultVerificationId"
                                   class="btn btn-primary btn-sm">

                                    <i class="fas fa-eye me-1"></i>
                                    Review

                                </a>

                            </td>

                        </tr>
                    }
                }

            </tbody>

        </table>

    </div>

</div>