
@model HemaCore.ViewModels.LabTechnicianProfileViewModel

@{
    ViewData["Title"] = "Edit Profile";
    Layout = "_LabTechnicianLayout";
}

<div class="container-fluid px-4 py-4">
    <div class="mb-4">
        <a asp-action="TechnicianProfile"
           class="text-decoration-none text-secondary small">
            <i class="bi bi-arrow-left me-1"></i> Back to My Profile
        </a>

        <h2 class="fw-bold mt-3 mb-1">Edit Profile</h2>
        <p class="text-muted mb-0">
            Update your personal and contact information.
        </p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom py-3">
            <h5 class="mb-0 fw-semibold">Personal Information</h5>
        </div>

        <div class="card-body p-4">
            <form asp-action="EditProfile" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"
                     role="alert"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Name"
                               class="form-label fw-semibold"></label>
                        <input asp-for="Name"
                               class="form-control"
                               placeholder="Enter your name" />
                        <span asp-validation-for="Name"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Surname"
                               class="form-label fw-semibold"></label>
                        <input asp-for="Surname"
                               class="form-control"
                               placeholder="Enter your surname" />
                        <span asp-validation-for="Surname"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Email"
                               class="form-label fw-semibold"></label>
                        <input asp-for="Email"
                               type="email"
                               class="form-control"
                               placeholder="Enter your email address" />
                        <span asp-validation-for="Email"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="PhoneNumber"
                               class="form-label fw-semibold"></label>
                        <input asp-for="PhoneNumber"
                               type="tel"
                               class="form-control"
                               placeholder="Enter your phone number" />
                        <span asp-validation-for="PhoneNumber"
                              class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2 mt-4">
                    <button type="submit"
                            class="btn btn-dark px-4">
                        <i class="bi bi-check2-circle me-2"></i>
                        Save Changes
                    </button>

                    <a asp-action="TechnicianProfile"
                       class="btn btn-outline-secondary px-4">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
