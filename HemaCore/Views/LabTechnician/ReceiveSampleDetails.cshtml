
@model HemaCore.Models.TestRequest

@{
    ViewData["Title"] = "Receive Samples";
    Layout = "_LabTechnicianLayout";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2>Receive Patient Samples</h2>

            <p class="text-muted mb-0">
                Review the test request and confirm that the samples have been received.
            </p>
        </div>

        <a asp-action="ReceiveSample"
           class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-2"></i>
            Back
        </a>

    </div>


    <!-- REQUEST DETAILS -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-white">
            <h5 class="fw-bold mb-0">
                <i class="fas fa-file-medical me-2"></i>
                Test Request Details
            </h5>
        </div>

        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-4">
                    <strong>Request Number</strong>
                    <p class="mb-0">
                        #@Model.TestRequestId
                    </p>
                </div>

                <div class="col-md-4">
                    <strong>Patient</strong>
                    <p class="mb-0">
                        @Model.Patient?.Name
                        @Model.Patient?.Surname
                    </p>
                </div>

                <div class="col-md-4">
                    <strong>Doctor</strong>
                    <p class="mb-0">
                        @Model.Doctor?.Name
                        @Model.Doctor?.Surname
                    </p>
                </div>

                <div class="col-md-4">
                    <strong>Request Date</strong>
                    <p class="mb-0">
                        @Model.RequestDate.ToString("dd/MM/yyyy HH:mm")
                    </p>
                </div>

                <div class="col-md-4">
                    <strong>Urgency</strong>
                    <p class="mb-0">
                        @Model.Urgency
                    </p>
                </div>

                <div class="col-md-4">
                    <strong>Status</strong>
                    <p class="mb-0">
                        @Model.Status
                    </p>
                </div>

            </div>

        </div>

    </div>


    <!-- SAMPLES -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-white">

            <h5 class="fw-bold mb-0">
                <i class="fas fa-vial me-2"></i>
                Samples
            </h5>

        </div>

        <div class="card-body">

            @if (Model.Samples == null || !Model.Samples.Any())
            {
                <div class="alert alert-warning mb-0">
                    No samples are associated with this test request.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-light">

                            <tr>
                                <th>Barcode</th>
                                <th>Sample Type</th>
                                <th>Received Date & Time</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var sample in Model.Samples)
                            {
                                <tr>

                                    <td>
                                        @sample.Barcode
                                    </td>

                                    <td>
                                        @sample.SampleType?.SampleName
                                    </td>

                                    <td>
                                        @sample.DateTimeReceived.ToString("dd/MM/yyyy HH:mm:ss")
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>


    <!-- CONFIRM -->

    <div class="card shadow-sm border-0">

        <div class="card-body text-center">

            <h5 class="fw-bold mb-2">
                Confirm Sample Receipt
            </h5>

            <p class="text-muted">
                Confirm that the samples for this test request have been physically received by the laboratory.
            </p>

            <form asp-action="ConfirmReceiveSample"
                  asp-route-id="@Model.TestRequestId"
                  method="post">

                <button type="submit"
                        class="btn btn-success">

                    <i class="fas fa-check-circle me-2"></i>
                    Confirm Sample Received

                </button>

            </form>

        </div>

    </div>

</div>

