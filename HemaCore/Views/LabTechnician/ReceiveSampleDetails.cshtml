@model HemaCore.Models.TestRequest

@{
    ViewData["Title"] = "Receive Sample";
    Layout = "_LabTechnicianLayout";
}

<style>
    .receive-page {
        padding-bottom: 40px;
    }

    .page-hero {
        background: linear-gradient(135deg, #75AABA 0%, #5f9aaa 100%);
        color: white;
        border-radius: 16px;
        padding: 28px 32px;
        margin-bottom: 24px;
        box-shadow: 0 6px 18px rgba(70, 120, 140, 0.18);
    }

        .page-hero h2 {
            font-weight: 700;
            margin-bottom: 6px;
        }

        .page-hero p {
            margin-bottom: 0;
            opacity: 0.9;
        }

    .back-btn {
        background: rgba(255, 255, 255, 0.15);
        border: 1px solid rgba(255, 255, 255, 0.45);
        color: white;
        border-radius: 8px;
        padding: 9px 16px;
    }

        .back-btn:hover {
            background: rgba(255, 255, 255, 0.25);
            color: white;
        }

    .info-card {
        background: white;
        border: none;
        border-radius: 14px;
        box-shadow: 0 3px 14px rgba(0, 0, 0, 0.07);
        margin-bottom: 20px;
        overflow: hidden;
    }

    .info-card-header {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 17px 22px;
        background: #f7fafb;
        border-bottom: 1px solid #e8eef0;
        color: #315967;
        font-weight: 600;
    }

        .info-card-header i {
            color: #75AABA;
            font-size: 17px;
        }

    .info-card-body {
        padding: 22px;
    }

    .info-item {
        padding: 12px 15px;
        background: #f9fbfc;
        border-radius: 9px;
        height: 100%;
        border: 1px solid #edf2f4;
    }

    .info-label {
        display: block;
        font-size: 12px;
        color: #7a8b92;
        text-transform: uppercase;
        letter-spacing: 0.4px;
        margin-bottom: 5px;
        font-weight: 600;
    }

    .info-value {
        color: #263b43;
        font-weight: 500;
        font-size: 15px;
    }

    .request-number {
        color: #4e91a6;
        font-size: 18px;
        font-weight: 700;
    }

    .status-badge {
        display: inline-block;
        padding: 5px 11px;
        border-radius: 20px;
        background: #e9f1f4;
        color: #477888;
        font-size: 13px;
        font-weight: 600;
    }

    .urgency-badge {
        display: inline-block;
        padding: 5px 11px;
        border-radius: 20px;
        background: #fff3d9;
        color: #9a6b17;
        font-size: 13px;
        font-weight: 600;
    }

    .technician-box {
        background: #eef7f9;
        border: 1px solid #d6eaee;
        border-radius: 10px;
        padding: 16px 18px;
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .technician-icon {
        width: 45px;
        height: 45px;
        border-radius: 50%;
        background: #75AABA;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
    }

    .technician-label {
        font-size: 12px;
        color: #71858c;
        margin-bottom: 2px;
    }

    .technician-name {
        font-weight: 600;
        color: #294b57;
    }

    .clinical-note {
        background: #f8fafb;
        border-left: 4px solid #75AABA;
        border-radius: 6px;
        padding: 15px 18px;
        color: #455960;
        line-height: 1.6;
    }

    .sample-table {
        margin-bottom: 0;
    }

        .sample-table thead th {
            background: #f3f7f8;
            color: #58717a;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.3px;
            border-bottom: 1px solid #dfe8eb;
            padding: 13px 15px;
        }

        .sample-table tbody td {
            padding: 16px 15px;
            vertical-align: middle;
            border-color: #edf1f2;
            color: #40545b;
        }

    .barcode {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #397c91;
        font-weight: 600;
    }

    .sample-type {
        display: inline-block;
        background: #edf6f8;
        color: #477d8c;
        padding: 5px 10px;
        border-radius: 6px;
        font-size: 13px;
        font-weight: 600;
    }
</style>

<div class="container mt-4 receive-page">

    <div class="page-hero">

        <div class="d-flex justify-content-between align-items-center">

            <div>

                <div class="mb-2">
                    <i class="fas fa-vial me-2"></i>
                    LABORATORY SAMPLE RECEIVING
                </div>

                <h2>Receive Patient Sample</h2>

                <p>
                    Review the request and sample information, then confirm each sample as it is received.
                </p>

            </div>

            <a asp-action="ReceiveSample"
               class="btn back-btn">

                <i class="fas fa-arrow-left me-2"></i>
                Back

            </a>

        </div>

    </div>


    <!-- TEST REQUEST -->
    <div class="info-card">

        <div class="info-card-header">
            <i class="fas fa-file-medical"></i>
            <span>Test Request Details</span>
        </div>

        <div class="info-card-body">

            <div class="row g-3">

                <div class="col-md-3">

                    <div class="info-item">

                        <span class="info-label">
                            Request Number
                        </span>

                        <span class="request-number">
                            #@Model.TestRequestId
                        </span>

                    </div>

                </div>


                <div class="col-md-3">

                    <div class="info-item">

                        <span class="info-label">
                            Request Date
                        </span>

                        <span class="info-value">
                            @Model.RequestDate.ToString("dd/MM/yyyy HH:mm")
                        </span>

                    </div>

                </div>


                <div class="col-md-3">

                    <div class="info-item">

                        <span class="info-label">
                            Urgency
                        </span>

                        <span class="urgency-badge">
                            @Model.Urgency
                        </span>

                    </div>

                </div>


                <div class="col-md-3">

                    <div class="info-item">

                        <span class="info-label">
                            Status
                        </span>

                        <span class="status-badge">
                            @Model.Status
                        </span>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- PATIENT INFORMATION -->
    <div class="info-card">

        <div class="info-card-header">

            <i class="fas fa-user"></i>

            <span>Patient Information</span>

        </div>

        <div class="info-card-body">

            <div class="row g-3">

                <div class="col-md-6">

                    <div class="info-item">

                        <span class="info-label">
                            Patient Name
                        </span>

                        <span class="info-value">
                            @Model.Patient?.Name
                            @Model.Patient?.Surname
                        </span>

                    </div>

                </div>


                <div class="col-md-6">

                    <div class="info-item">

                        <span class="info-label">
                            ID Number
                        </span>

                        <span class="info-value">
                            @Model.Patient?.IDNumber
                        </span>

                    </div>

                </div>


                <div class="col-md-6">

                    <div class="info-item">

                        <span class="info-label">
                            Date of Birth
                        </span>

                        <span class="info-value">
                            @Model.Patient?.DateOfBirth.ToString("dd/MM/yyyy")
                        </span>

                    </div>

                </div>


                <div class="col-md-6">

                    <div class="info-item">

                        <span class="info-label">
                            Contact Number
                        </span>

                        <span class="info-value">
                            @Model.Patient?.PhoneNumber
                        </span>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- REQUESTING DOCTOR -->
    <div class="info-card">

        <div class="info-card-header">

            <i class="fas fa-user-md"></i>

            <span>Requesting Doctor</span>

        </div>

        <div class="info-card-body">

            <div class="row g-3">

                <div class="col-md-6">

                    <div class="info-item">

                        <span class="info-label">
                            Doctor
                        </span>

                        <span class="info-value">
                            @Model.Doctor?.Name
                            @Model.Doctor?.Surname
                        </span>

                    </div>

                </div>


                <div class="col-md-6">

                    <div class="info-item">

                        <span class="info-label">
                            HPCSA Number
                        </span>

                        <span class="info-value">
                            @Model.Doctor?.HPCSANumber
                        </span>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- RECEIVING TECHNICIAN -->
    <div class="info-card">

        <div class="info-card-header">

            <i class="fas fa-user-check"></i>

            <span>Receiving Technician</span>

        </div>

        <div class="info-card-body">

            <div class="technician-box">

                <div class="technician-icon">

                    <i class="fas fa-user-md"></i>

                </div>

                <div>

                    <div class="technician-label">
                        Currently logged-in technician
                    </div>

                    <div class="technician-name">
                        @User.Identity?.Name
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- CLINICAL INFORMATION -->
    <div class="info-card">

        <div class="info-card-header">

            <i class="fas fa-notes-medical"></i>

            <span>Clinical Information</span>

        </div>

        <div class="info-card-body">

            <span class="info-label">
                Clinical Notes
            </span>

            <div class="clinical-note">

                @if (string.IsNullOrWhiteSpace(Model.ClinicalNotes))
                {
                    <span class="text-muted">
                        No clinical notes provided.
                    </span>
                }
                else
                {
                    @Model.ClinicalNotes
                }

            </div>

        </div>

    </div>


    <!-- SAMPLE INFORMATION -->
    <div class="info-card">

        <div class="info-card-header">

            <i class="fas fa-vial"></i>

            <span>Sample Information</span>

            @if (Model.Samples != null)
            {
                <span class="badge ms-auto"
                      style="background:#e2f1f4; color:#4d8393;">

                    @Model.Samples.Count Sample(s)

                </span>
            }

        </div>

        <div class="info-card-body">

            @if (Model.Samples == null || !Model.Samples.Any())
            {
                <div class="alert alert-warning mb-0">

                    <i class="fas fa-exclamation-triangle me-2"></i>

                    No samples are associated with this test request.

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table sample-table">
                        <thead>
                            <tr>
                                <th>Barcode</th>
                                <th>Sample Type</th>
                                <th>Received Date & Time</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var sample in Model.Samples)
                            {
                                <tr>
                                    <td>
                                        <span class="barcode">
                                            <i class="fas fa-barcode"></i>
                                            @sample.Barcode
                                        </span>
                                    </td>
                                    <td>
                                        <span class="sample-type">
                                            <i class="fas fa-vial me-1"></i>
                                            @sample.SampleType?.SampleName
                                        </span>
                                    </td>
                                    <td>
                                        @if (sample.DateTimeReceived.HasValue)
                                        {
                                            @sample.DateTimeReceived.Value.ToString("dd/MM/yyyy HH:mm:ss")
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not yet received</span>
                                        }
                                    </td>
                                    <td>
                                        @if (sample.DateTimeReceived.HasValue)
                                        {
                                            <span class="badge bg-success">Received</span>
                                        }
                                        else
                                        {
                                            <form asp-action="ConfirmReceiveSample"
                                                  asp-route-sampleId="@sample.SampleId"
                                                  method="post">
                                                <button type="submit" class="btn btn-sm btn-primary">
                                                    <i class="fas fa-check-circle me-1"></i>
                                                    Confirm Receipt
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>

    </div>

</div>
