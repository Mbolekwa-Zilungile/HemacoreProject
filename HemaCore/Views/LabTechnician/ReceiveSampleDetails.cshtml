
@model HemaCore.Models.TestRequest
@using Microsoft.EntityFrameworkCore
@inject HemaCore.Data.AppDbContext Db

@{
    ViewData["Title"] = "Receive Sample";
    Layout = "_LabTechnicianLayout";

    var conditions = new List<string>();
    var allergies = new List<string>();
    var medications = new List<string>();

    if (Model.Patient != null)
    {
        var patientId = Model.Patient.PatientID;

        var patientConditions = await Db.PatientConditions
            .Include(pc => pc.Condition)
            .Where(pc => pc.PatientID == patientId)
            .ToListAsync();

        conditions = patientConditions
            .Where(pc => pc.Condition != null)
            .Select(pc => pc.DiagnosedDate.HasValue
                ? pc.Condition.Name + " (diagnosed " +
                  pc.DiagnosedDate.Value.ToString("dd/MM/yyyy") + ")"
                : pc.Condition.Name)
            .ToList();

        var patientAllergies = await Db.PatientAllergies
            .Include(pa => pa.Allergy)
            .Where(pa => pa.PatientID == patientId)
            .ToListAsync();

        allergies = patientAllergies
            .Where(pa => pa.Allergy != null)
            .Select(pa => string.IsNullOrWhiteSpace(pa.Severity)
                ? pa.Allergy.Name
                : pa.Allergy.Name + " (" + pa.Severity + ")")
            .ToList();

        var patientMedications = await Db.PatientMedications
            .Include(pm => pm.Medication)
            .Where(pm => pm.PatientID == patientId)
            .ToListAsync();

        medications = patientMedications
            .Where(pm => pm.Medication != null)
            .Select(pm => string.Join(" - ",
                new[]
                {
                    pm.Medication.Name,
                    pm.Dosage,
                    pm.Frequency
                }.Where(value => !string.IsNullOrWhiteSpace(value))))
            .ToList();
    }
}

<style>
    .receive-page {
        --lab-accent: #75AABA;
        --lab-accent-dark: #477f90;
        --lab-text: #263746;
        --lab-muted: #77838e;
        --lab-line: #e7ebef;
        --lab-soft: #f7f9fb;
        color: var(--lab-text);
        padding-bottom: 36px;
        font-size: 14px;
    }

    .receive-page * {
        box-sizing: border-box;
    }

    .receive-page .page-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        margin: 8px 0 25px;
    }

    .receive-page .eyebrow {
        color: var(--lab-muted);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1.1px;
        text-transform: uppercase;
        margin-bottom: 7px;
    }

    .receive-page .page-title {
        font-size: 25px;
        font-weight: 650;
        letter-spacing: -.5px;
        margin: 0;
        color: var(--lab-text);
    }

    .receive-page .page-description {
        color: var(--lab-muted);
        margin: 7px 0 0;
        font-size: 13px;
        line-height: 1.6;
    }

    .receive-page .back-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 13px;
        border: 1px solid var(--lab-line);
        border-radius: 7px;
        color: #475563;
        background: #fff;
        text-decoration: none;
        white-space: nowrap;
    }

    .receive-page .back-link:hover {
        background: var(--lab-soft);
        border-color: #ccd5dc;
        color: var(--lab-text);
    }

    .receive-page .request-strip {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 22px;
        background: #fff;
        border: 1px solid var(--lab-line);
        border-radius: 10px;
        padding: 18px 20px;
        margin-bottom: 25px;
    }

    .receive-page .request-field {
        min-width: 0;
    }

    .receive-page .field-label {
        display: block;
        color: var(--lab-muted);
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .55px;
        margin-bottom: 7px;
    }

    .receive-page .field-value {
        color: var(--lab-text);
        font-weight: 600;
        font-size: 14px;
        overflow-wrap: anywhere;
    }

    .receive-page .request-id {
        color: var(--lab-accent-dark);
        font-size: 19px;
        font-weight: 700;
    }

    .receive-page .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border-radius: 5px;
        padding: 5px 8px;
        background: #eef5f7;
        color: #477887;
        font-size: 11px;
        font-weight: 650;
    }

    .receive-page .status-pill::before {
        content: "";
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: currentColor;
    }

    .receive-page .section {
        background: #fff;
        border: 1px solid var(--lab-line);
        border-radius: 10px;
        margin-bottom: 20px;
        overflow: hidden;
    }

    .receive-page .section-heading {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 17px 20px;
        border-bottom: 1px solid var(--lab-line);
    }

    .receive-page .section-icon {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        flex-shrink: 0;
        width: 31px;
        height: 31px;
        border-radius: 7px;
        color: var(--lab-accent-dark);
        background: #f0f6f8;
    }

    .receive-page .section-title {
        font-size: 14px;
        font-weight: 650;
        margin: 0;
        color: var(--lab-text);
    }

    .receive-page .section-subtitle {
        color: var(--lab-muted);
        font-size: 12px;
        margin: 4px 0 0;
    }

    .receive-page .section-body {
        padding: 20px;
    }

    .receive-page .detail-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px 28px;
    }

    .receive-page .detail-value {
        color: var(--lab-text);
        font-size: 13px;
        font-weight: 550;
        overflow-wrap: anywhere;
    }

    .receive-page .patient-profile {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 18px;
        margin-top: 24px;
        padding-top: 20px;
        border-top: 1px solid var(--lab-line);
    }

    .receive-page .profile-heading {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 12px;
        font-weight: 700;
        margin-bottom: 12px;
        color: #50616e;
    }

    .receive-page .profile-heading i {
        color: var(--lab-accent-dark);
    }

    .receive-page .profile-heading .count {
        color: var(--lab-muted);
        font-weight: 500;
    }

    .receive-page .profile-panel.allergy-panel {
        border-left: 2px solid #d89b8f;
        padding-left: 14px;
    }

    .receive-page .allergy-panel .profile-heading,
    .receive-page .allergy-panel .profile-heading i {
        color: #a14c40;
    }

    .receive-page .profile-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .receive-page .profile-list li {
        padding: 8px 0;
        border-bottom: 1px solid #f0f2f4;
        color: #455461;
        font-size: 12px;
        line-height: 1.5;
        overflow-wrap: anywhere;
    }

    .receive-page .profile-list li:last-child {
        border-bottom: 0;
    }

    .receive-page .profile-empty {
        color: var(--lab-muted);
        font-size: 12px;
        margin: 0;
        padding: 5px 0;
    }

    .receive-page .technician-row {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .receive-page .technician-avatar {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: #edf4f6;
        color: var(--lab-accent-dark);
        font-size: 15px;
        flex-shrink: 0;
    }

    .receive-page .technician-label {
        color: var(--lab-muted);
        font-size: 11px;
        margin-bottom: 4px;
    }

    .receive-page .technician-name {
        color: var(--lab-text);
        font-size: 13px;
        font-weight: 600;
        overflow-wrap: anywhere;
    }

    .receive-page .clinical-note {
        color: #4a5966;
        background: var(--lab-soft);
        border-radius: 6px;
        padding: 13px 15px;
        line-height: 1.7;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
    }

    .receive-page .sample-count {
        margin-left: auto;
        color: var(--lab-muted);
        font-size: 12px;
        font-weight: 500;
        white-space: nowrap;
    }

    .receive-page .table-responsive {
        overflow-x: auto;
    }

    .receive-page .sample-table {
        width: 100%;
        margin: 0;
        border-collapse: separate;
        border-spacing: 0;
    }

    .receive-page .sample-table thead th {
        background: #f8fafb;
        color: #647380;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: .6px;
        text-transform: uppercase;
        padding: 13px 16px;
        border-bottom: 1px solid var(--lab-line);
        white-space: nowrap;
    }

    .receive-page .sample-table tbody td {
        padding: 17px 16px;
        border-bottom: 1px solid #edf0f3;
        vertical-align: top;
        color: #455461;
        font-size: 12px;
    }

    .receive-page .sample-table tbody tr:last-child td {
        border-bottom: 0;
    }

    .receive-page .sample-table tbody tr:hover {
        background: #fbfcfd;
    }

    .receive-page .barcode {
        color: #344b5a;
        font-weight: 650;
        overflow-wrap: anywhere;
    }

    .receive-page .barcode i {
        color: var(--lab-accent-dark);
        margin-right: 5px;
    }

    .receive-page .barcode-edit-btn {
        border: 0;
        background: transparent;
        color: #7c8994;
        padding: 3px 5px;
        border-radius: 4px;
    }

    .receive-page .barcode-edit-btn:hover {
        background: #edf3f5;
        color: var(--lab-accent-dark);
    }

    .receive-page .sample-type {
        display: inline-block;
        background: #f0f5f7;
        color: #536e7b;
        padding: 5px 8px;
        border-radius: 5px;
        font-size: 11px;
        white-space: nowrap;
    }

    .receive-page .sample-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 8px;
        border-radius: 5px;
        font-size: 11px;
        font-weight: 650;
        white-space: nowrap;
    }

    .receive-page .sample-status.received {
        background: #edf6f0;
        color: #34734d;
    }

    .receive-page .sample-status.pending {
        background: #f5f3e9;
        color: #81703a;
    }

    .receive-page .sample-status.cancelled {
        background: #fbefed;
        color: #a4493c;
    }

    .receive-page .received-by {
        margin-top: 10px;
        padding-top: 9px;
        border-top: 1px solid #edf0f3;
        display: flex;
        align-items: flex-start;
        gap: 7px;
        line-height: 1.5;
    }

    .receive-page .received-by i {
        color: var(--lab-accent-dark);
        margin-top: 2px;
    }

    .receive-page .received-by-label {
        display: block;
        color: var(--lab-muted);
        font-size: 10px;
        margin-bottom: 2px;
    }

    .receive-page .received-by-name {
        color: #344b5a;
        font-size: 12px;
        font-weight: 650;
        overflow-wrap: anywhere;
    }

    .receive-page .sample-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 7px;
        margin-top: 11px;
    }

    .receive-page .btn-lab-primary {
        background: var(--lab-accent-dark);
        border: 1px solid var(--lab-accent-dark);
        color: #fff;
        border-radius: 6px;
        padding: 7px 10px;
        font-size: 11px;
        font-weight: 600;
        transition: background .18s ease;
    }

    .receive-page .btn-lab-primary:hover {
        background: #386d7d;
        border-color: #386d7d;
        color: #fff;
    }

    .receive-page .btn-lab-cancel {
        background: #fff;
        border: 1px solid #e5c7c2;
        color: #a14c40;
        border-radius: 6px;
        padding: 7px 10px;
        font-size: 11px;
        font-weight: 600;
    }

    .receive-page .btn-lab-cancel:hover {
        background: #fbefed;
        color: #8f392e;
    }

    .receive-page .cancel-panel {
        background: #fcf9f8;
        border: 1px solid #eee2df;
        border-radius: 7px;
        padding: 13px;
        margin-top: 12px;
        min-width: 220px;
    }

    .receive-page .cancel-panel .form-label {
        font-size: 11px;
        font-weight: 600;
        color: #596673;
    }

    .receive-page .form-control,
    .receive-page .form-select {
        border-color: #dfe5ea;
        border-radius: 6px;
        font-size: 12px;
    }

    .receive-page .form-control:focus,
    .receive-page .form-select:focus {
        border-color: var(--lab-accent);
        box-shadow: 0 0 0 3px rgba(117, 170, 186, .14);
    }

    .receive-page .cancellation-note {
        color: #94483d;
        background: #fcf3f1;
        border-radius: 5px;
        padding: 9px 10px;
        margin-top: 8px;
        font-size: 11px;
        line-height: 1.6;
        overflow-wrap: anywhere;
    }

    .receive-page .muted-text {
        color: var(--lab-muted);
        font-size: 12px;
    }

    .receive-page .empty-state {
        padding: 30px 15px;
        text-align: center;
        color: var(--lab-muted);
    }

    .receive-page .empty-state i {
        display: block;
        font-size: 23px;
        margin-bottom: 10px;
        color: #aab6bf;
    }

    .receive-page .alert {
        border-radius: 7px;
        font-size: 13px;
    }

    @@media (max-width: 992px) {
        .receive-page .patient-profile {
            grid-template-columns: 1fr;
            gap: 20px;
        }

        .receive-page .request-strip {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 576px) {
        .receive-page.container {
            padding-left: 12px;
            padding-right: 12px;
        }

        .receive-page .page-top {
            align-items: flex-start;
        }

        .receive-page .page-title {
            font-size: 21px;
        }

        .receive-page .page-description {
            max-width: 260px;
        }

        .receive-page .back-link {
            padding: 8px 10px;
            font-size: 12px;
        }

        .receive-page .request-strip {
            gap: 18px 12px;
            padding: 16px;
        }

        .receive-page .section-heading {
            padding: 14px 15px;
        }

        .receive-page .section-body {
            padding: 16px;
        }

        .receive-page .detail-grid {
            grid-template-columns: 1fr;
            gap: 17px;
        }

        .receive-page .sample-count {
            font-size: 11px;
        }
    }
</style>

<div class="container mt-4 receive-page">

    @if (TempData["SampleReceivedSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>
            @TempData["SampleReceivedSuccess"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["SampleError"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>
            @TempData["SampleError"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- PAGE HEADER -->
    <div class="page-top">
        <div>
            <div class="eyebrow">Laboratory operations / Sample receiving</div>
            <h1 class="page-title">Receive Patient Sample</h1>
            <p class="page-description">
                Review the request and patient details before recording sample receipt.
            </p>
        </div>

        <a asp-action="ReceiveSample" class="back-link">
            <i class="fas fa-arrow-left"></i>
            Back
        </a>
    </div>

    <!-- REQUEST SUMMARY -->
    <div class="request-strip">
        <div class="request-field">
            <span class="field-label">Request number</span>
            <div class="request-id">#@Model.TestRequestId</div>
        </div>

        <div class="request-field">
            <span class="field-label">Request date</span>
            <div class="field-value">
                @Model.RequestDate.ToString("dd/MM/yyyy HH:mm")
            </div>
        </div>

        <div class="request-field">
            <span class="field-label">Urgency</span>
            <div class="field-value">
                @(string.IsNullOrWhiteSpace(Model.Urgency) ? "Not specified" : Model.Urgency)
            </div>
        </div>

        <div class="request-field">
            <span class="field-label">Request status</span>
            <div>
                <span class="status-pill">
                    @(string.IsNullOrWhiteSpace(Model.Status) ? "Unknown" : Model.Status)
                </span>
            </div>
        </div>
    </div>

    <!-- PATIENT INFORMATION -->
    <section class="section">
        <div class="section-heading">
            <span class="section-icon"><i class="fas fa-user"></i></span>
            <div>
                <h2 class="section-title">Patient Information</h2>
                <p class="section-subtitle">Patient identity and relevant medical history</p>
            </div>
        </div>

        <div class="section-body">
            <div class="detail-grid">
                <div>
                    <span class="field-label">Patient name</span>
                    <div class="detail-value">
                        @(Model.Patient == null
                            ? "Not available"
                            : $"{Model.Patient.Name} {Model.Patient.Surname}")
                    </div>
                </div>

                <div>
                    <span class="field-label">ID number</span>
                    <div class="detail-value">
                        @(string.IsNullOrWhiteSpace(Model.Patient?.IDNumber)
                            ? "Not available"
                            : Model.Patient.IDNumber)
                    </div>
                </div>

                <div>
                    <span class="field-label">Date of birth</span>
                    <div class="detail-value">
                        @(Model.Patient == null
                            ? "Not available"
                            : Model.Patient.DateOfBirth.ToString("dd/MM/yyyy"))
                    </div>
                </div>

                <div>
                    <span class="field-label">Contact number</span>
                    <div class="detail-value">
                        @(string.IsNullOrWhiteSpace(Model.Patient?.PhoneNumber)
                            ? "Not available"
                            : Model.Patient.PhoneNumber)
                    </div>
                </div>
            </div>

            <div class="patient-profile">
                <div class="profile-panel">
                    <div class="profile-heading">
                        <i class="fas fa-heartbeat"></i>
                        Medical Conditions
                        <span class="count">(@conditions.Count)</span>
                    </div>

                    @if (conditions.Any())
                    {
                        <ul class="profile-list">
                            @foreach (var item in conditions)
                            {
                                <li>@item</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="profile-empty">No conditions recorded.</p>
                    }
                </div>

                <div class="profile-panel allergy-panel">
                    <div class="profile-heading">
                        <i class="fas fa-exclamation-triangle"></i>
                        Allergies
                        <span class="count">(@allergies.Count)</span>
                    </div>

                    @if (allergies.Any())
                    {
                        <ul class="profile-list">
                            @foreach (var item in allergies)
                            {
                                <li>@item</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="profile-empty">No allergies recorded.</p>
                    }
                </div>

                <div class="profile-panel">
                    <div class="profile-heading">
                        <i class="fas fa-pills"></i>
                        Current Medications
                        <span class="count">(@medications.Count)</span>
                    </div>

                    @if (medications.Any())
                    {
                        <ul class="profile-list">
                            @foreach (var item in medications)
                            {
                                <li>@item</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="profile-empty">No medications recorded.</p>
                    }
                </div>
            </div>
        </div>
    </section>

    <!-- REQUESTING DOCTOR -->
    <section class="section">
        <div class="section-heading">
            <span class="section-icon"><i class="fas fa-user-md"></i></span>
            <div>
                <h2 class="section-title">Requesting Doctor</h2>
                <p class="section-subtitle">Details of the referring medical practitioner</p>
            </div>
        </div>

        <div class="section-body">
            <div class="detail-grid">
                <div>
                    <span class="field-label">Doctor</span>
                    <div class="detail-value">
                        @(Model.Doctor == null
                            ? "Not available"
                            : $"{Model.Doctor.Name} {Model.Doctor.Surname}")
                    </div>
                </div>

                <div>
                    <span class="field-label">HPCSA number</span>
                    <div class="detail-value">
                        @(string.IsNullOrWhiteSpace(Model.Doctor?.HPCSANumber)
                            ? "Not provided"
                            : Model.Doctor.HPCSANumber)
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- CURRENTLY LOGGED-IN TECHNICIAN -->
    <section class="section">
        <div class="section-heading">
            <span class="section-icon"><i class="fas fa-user-check"></i></span>
            <div>
                <h2 class="section-title">Current Technician</h2>
                <p class="section-subtitle">Account currently handling this request</p>
            </div>
        </div>

        <div class="section-body">
            <div class="technician-row">
                <div class="technician-avatar">
                    <i class="fas fa-user"></i>
                </div>
                <div>
                    <div class="technician-label">Logged-in account</div>
                    <div class="technician-name">
                        @(string.IsNullOrWhiteSpace(User.Identity?.Name)
                            ? "Technician account"
                            : User.Identity.Name)
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- CLINICAL INFORMATION -->
    <section class="section">
        <div class="section-heading">
            <span class="section-icon"><i class="fas fa-notes-medical"></i></span>
            <div>
                <h2 class="section-title">Clinical Information</h2>
                <p class="section-subtitle">Clinical notes supplied with the request</p>
            </div>
        </div>

        <div class="section-body">
            <span class="field-label">Clinical notes</span>
            <div class="clinical-note">
                @if (string.IsNullOrWhiteSpace(Model.ClinicalNotes))
                {
                    <span class="muted-text">No clinical notes provided.</span>
                }
                else
                {
                    @Model.ClinicalNotes
                }
            </div>
        </div>
    </section>

    <!-- SAMPLE INFORMATION -->
    <section class="section">
        <div class="section-heading">
            <span class="section-icon"><i class="fas fa-vial"></i></span>
            <div>
                <h2 class="section-title">Sample Information</h2>
                <p class="section-subtitle">
                    Review barcodes and record the receipt or cancellation of each sample
                </p>
            </div>
            <span class="sample-count">
                @(Model.Samples?.Count ?? 0) sample(s)
            </span>
        </div>

        @if (Model.Samples == null || !Model.Samples.Any())
        {
            <div class="empty-state">
                <i class="fas fa-vial"></i>
                <div>No samples are associated with this test request.</div>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="sample-table">
                    <thead>
                        <tr>
                            <th>Barcode</th>
                            <th>Sample type</th>
                            <th>Received date &amp; time</th>
                            <th>Status and actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sample in Model.Samples)
                        {
                            var sampleStatus = string.IsNullOrWhiteSpace(sample.Status)
                                ? (sample.DateTimeReceived.HasValue ? "Received" : "Pending")
                                : sample.Status;

                            var isCancelled = sampleStatus == "Rejected" ||
                                              sampleStatus == "Cancelled";

                            var isReceived = sampleStatus == "Received" ||
                                             sample.DateTimeReceived.HasValue;

                            var canReceive = !isCancelled && !isReceived;

                            <tr>
                                <!-- BARCODE -->
                                <td>
                                    @if (canReceive)
                                    {
                                        <div class="d-flex align-items-center gap-1">
                                            <span class="barcode">
                                                <i class="fas fa-barcode"></i>@sample.Barcode
                                            </span>

                                            <button type="button"
                                                    class="barcode-edit-btn"
                                                    title="Edit barcode"
                                                    aria-label="Edit barcode"
                                                    data-bs-toggle="collapse"
                                                    data-bs-target="#barcode-edit-@sample.SampleId">
                                                <i class="fas fa-pen"></i>
                                            </button>
                                        </div>

                                        <div class="collapse mt-2"
                                             id="barcode-edit-@sample.SampleId">
                                            <form asp-action="EditSampleBarcode" method="post">
                                                @Html.AntiForgeryToken()

                                                <input type="hidden" name="sampleId"
                                                       value="@sample.SampleId" />

                                                <label class="form-label small"
                                                       for="barcode-value-@sample.SampleId">
                                                    Correct barcode
                                                </label>

                                                <input type="text"
                                                       id="barcode-value-@sample.SampleId"
                                                       name="barcode"
                                                       value="@sample.Barcode"
                                                       class="form-control form-control-sm mb-2"
                                                       maxlength="100"
                                                       required />

                                                <button type="submit"
                                                        class="btn btn-sm btn-lab-primary">
                                                    Save barcode
                                                </button>
                                            </form>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="barcode">
                                            <i class="fas fa-barcode"></i>@sample.Barcode
                                        </span>
                                    }
                                </td>

                                <!-- SAMPLE TYPE -->
                                <td>
                                    <span class="sample-type">
                                        @(sample.SampleType?.SampleName ?? "Not specified")
                                    </span>
                                </td>

                                <!-- RECEIVED DATE AND TIME -->
                                <td>
                                    @if (sample.DateTimeReceived.HasValue)
                                    {
                                        <span>
                                            @sample.DateTimeReceived.Value.ToString("dd/MM/yyyy")
                                        </span>
                                        <div class="muted-text">
                                            @sample.DateTimeReceived.Value.ToString("HH:mm:ss")
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="muted-text">Not yet received</span>
                                    }
                                </td>

                                <!-- STATUS, RECEIVING TECHNICIAN AND ACTIONS -->
                                <td>
                                    @if (isCancelled)
                                    {
                                        <span class="sample-status cancelled">
                                            <i class="fas fa-times-circle"></i>
                                            Cancelled
                                        </span>

                                        <div class="cancellation-note">
                                            <strong>Reason:</strong>
                                            @(string.IsNullOrWhiteSpace(sample.RejectionReason)
                                                ? "No reason recorded."
                                                : sample.RejectionReason)
                                        </div>

                                        @if (sample.RejectedDateTime.HasValue)
                                        {
                                            <div class="muted-text mt-2">
                                                Cancelled on
                                                @sample.RejectedDateTime.Value.ToString("dd/MM/yyyy HH:mm")
                                            </div>
                                        }
                                    }
                                    else if (isReceived)
                                    {
                                        <span class="sample-status received">
                                            <i class="fas fa-check-circle"></i>
                                            Received
                                        </span>

                                        <div class="received-by">
                                            <i class="fas fa-user-check"></i>
                                            <div>
                                                <span class="received-by-label">
                                                    Received by
                                                </span>

                                                <div class="received-by-name">
                                                    @if (sample.LabTechnician != null)
                                                    {
                                                        @(sample.LabTechnician.Name + " " +
                                                          sample.LabTechnician.Surname)
                                                    }
                                                    else
                                                    {
                                                        <span class="muted-text">
                                                            Technician not recorded
                                                        </span>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="sample-status pending">
                                            <i class="fas fa-clock"></i>
                                            Pending receipt
                                        </span>

                                        <div class="sample-actions">
                                            <form asp-action="ConfirmReceiveSample" method="post">
                                                @Html.AntiForgeryToken()

                                                <input type="hidden" name="sampleId"
                                                       value="@sample.SampleId" />

                                                <button type="submit"
                                                        class="btn btn-lab-primary">
                                                    <i class="fas fa-check me-1"></i>
                                                    Confirm receipt
                                                </button>
                                            </form>

                                            <button type="button"
                                                    class="btn btn-lab-cancel"
                                                    data-bs-toggle="collapse"
                                                    data-bs-target="#cancel-@sample.SampleId">
                                                <i class="fas fa-times me-1"></i>
                                                Cancel sample
                                            </button>
                                        </div>

                                        <div class="collapse"
                                             id="cancel-@sample.SampleId">
                                            <div class="cancel-panel">
                                                <form asp-action="RejectSample"
                                                      method="post"
                                                      class="cancel-form"
                                                      novalidate>
                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden" name="sampleId"
                                                           value="@sample.SampleId" />

                                                    <div class="mb-3">
                                                        <label class="form-label"
                                                               for="reason-@sample.SampleId">
                                                            Reason for cancellation
                                                            <span class="text-danger">*</span>
                                                        </label>

                                                        <select id="reason-@sample.SampleId"
                                                                name="rejectionReason"
                                                                class="form-select form-select-sm cancel-reason"
                                                                required>
                                                            <option value="">Select a reason</option>
                                                            <option value="Improper transport or storage">
                                                                Improper transport or storage
                                                            </option>
                                                            <option value="Damaged or leaking container">
                                                                Damaged or leaking container
                                                            </option>
                                                            <option value="Insufficient sample quantity">
                                                                Insufficient sample quantity
                                                            </option>
                                                            <option value="Incorrect patient identification">
                                                                Incorrect patient identification
                                                            </option>
                                                            <option value="Unsuitable sample type">
                                                                Unsuitable sample type
                                                            </option>
                                                            <option value="Other">Other</option>
                                                        </select>

                                                        <div class="invalid-feedback">
                                                            Select a reason before cancelling this sample.
                                                        </div>
                                                    </div>

                                                    <div class="mb-3">
                                                        <label class="form-label"
                                                               for="details-@sample.SampleId">
                                                            Additional details
                                                            <span class="details-hint text-muted">
                                                                (optional)
                                                            </span>
                                                        </label>

                                                        <textarea id="details-@sample.SampleId"
                                                                  name="rejectionDetails"
                                                                  class="form-control form-control-sm cancel-details"
                                                                  maxlength="1000"
                                                                  rows="2"
                                                                  placeholder="Add details if needed"></textarea>

                                                        <div class="invalid-feedback">
                                                            Describe the reason when you select Other.
                                                        </div>
                                                    </div>

                                                    <button type="submit"
                                                            class="btn btn-lab-cancel">
                                                        Confirm cancellation
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

<script>
    document.querySelectorAll('.cancel-form').forEach(function (form) {
        var reason = form.querySelector('.cancel-reason');
        var details = form.querySelector('.cancel-details');
        var hint = form.querySelector('.details-hint');
        var attempted = false;

        function isOther() {
            return reason.value === 'Other';
        }

        function validate() {
            var reasonOk = reason.value.trim() !== '';
            var detailsOk = !isOther() || details.value.trim() !== '';

            reason.classList.toggle('is-invalid', !reasonOk);
            details.classList.toggle('is-invalid', !detailsOk);

            return reasonOk && detailsOk;
        }

        function refresh() {
            hint.textContent = isOther() ? '(required)' : '(optional)';
            details.required = isOther();
            details.placeholder = isOther()
                ? 'Describe the reason for cancellation'
                : 'Add details if needed';

            if (attempted) {
                validate();
            }
        }

        reason.addEventListener('change', refresh);
        details.addEventListener('input', refresh);

        form.addEventListener('submit', function (e) {
            attempted = true;

            if (!validate()) {
                e.preventDefault();

                (reason.classList.contains('is-invalid')
                    ? reason
                    : details).focus();
            }
        });
    });
</script>
