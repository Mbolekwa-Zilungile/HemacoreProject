@model HemaCore.Models.TestRequest
@using Microsoft.EntityFrameworkCore

@inject HemaCore.Data.AppDbContext Db

@{
    ViewData["Title"] = "Receive Sample";
    Layout = "_LabTechnicianLayout";

    // ----- Patient history (loaded here so no controller change is needed) -----
    var conditions = new List<string>();
    var allergies = new List<string>();
    var medications = new List<string>();

    if (Model.Patient != null)
    {
        var patientId = Model.Patient.PatientID;

        var conditionRows = await Db.PatientConditions
            .Where(pc => pc.PatientID == patientId)
            .Select(pc => new { ConditionName = pc.Condition.Name, pc.DiagnosedDate })
            .ToListAsync();

        conditions = conditionRows
            .Select(c => c.DiagnosedDate.HasValue
                ? c.ConditionName + " (diagnosed " + c.DiagnosedDate.Value.ToString("dd/MM/yyyy") + ")"
                : c.ConditionName)
            .ToList();

        var allergyRows = await Db.PatientAllergies
            .Where(pa => pa.PatientID == patientId)
            .Select(pa => new { AllergyName = pa.Allergy.Name, pa.Severity })
            .ToListAsync();

        allergies = allergyRows
            .Select(a => string.IsNullOrWhiteSpace(a.Severity)
                ? a.AllergyName
                : a.AllergyName + " (" + a.Severity + ")")
            .ToList();

        var medicationRows = await Db.PatientMedications
            .Where(pm => pm.PatientID == patientId)
            .Select(pm => new { MedicationName = pm.Medication.Name, pm.Dosage, pm.Frequency })
            .ToListAsync();

        medications = medicationRows
            .Select(m => string.Join(" - ", new[] { m.MedicationName, m.Dosage, m.Frequency }
                .Where(x => !string.IsNullOrWhiteSpace(x))))
            .ToList();
    }
}

<style>
    .receive-page {
        padding-bottom: 40px;
    }

    .page-hero {
        background: linear-gradient(135deg, #75AABA 0%, #5f9aaa 100%);
        color: white;
        border-radius: 16px;
        padding: 28px 32px;
        margin-bottom: 24px;
        box-shadow: 0 6px 18px rgba(70, 120, 140, 0.18);
    }

        .page-hero h2 {
            font-weight: 700;
            margin-bottom: 6px;
        }

        .page-hero p {
            margin-bottom: 0;
            opacity: 0.9;
        }

    .back-btn {
        background: rgba(255,255,255,.15);
        border: 1px solid rgba(255,255,255,.45);
        color: white;
        border-radius: 8px;
        padding: 9px 16px;
    }

        .back-btn:hover {
            background: rgba(255,255,255,.25);
            color: white;
        }

    .info-card {
        background: white;
        border: none;
        border-radius: 14px;
        box-shadow: 0 3px 14px rgba(0,0,0,.07);
        margin-bottom: 20px;
        overflow: hidden;
    }

    .info-card-header {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 17px 22px;
        background: #f7fafb;
        border-bottom: 1px solid #e8eef0;
        color: #315967;
        font-weight: 600;
    }

        .info-card-header i {
            color: #75AABA;
            font-size: 17px;
        }

    .info-card-body {
        padding: 22px;
    }

    .info-item {
        padding: 12px 15px;
        background: #f9fbfc;
        border-radius: 9px;
        height: 100%;
        border: 1px solid #edf2f4;
    }

    .info-label {
        display: block;
        font-size: 12px;
        color: #7a8b92;
        text-transform: uppercase;
        letter-spacing: .4px;
        margin-bottom: 5px;
        font-weight: 600;
    }

    .info-value {
        color: #263b43;
        font-weight: 500;
        font-size: 15px;
    }

    .request-number {
        color: #4e91a6;
        font-size: 18px;
        font-weight: 700;
    }

    .status-badge,
    .urgency-badge {
        display: inline-block;
        padding: 5px 11px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
    }

    .status-badge {
        background: #e9f1f4;
        color: #477888;
    }

    .urgency-badge {
        background: #fff3d9;
        color: #9a6b17;
    }

    /* ---------- Patient clinical profile ---------- */

    .patient-profile {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        margin-top: 20px;
    }

    .profile-panel {
        background: #f9fbfc;
        border: 1px solid #edf2f4;
        border-radius: 10px;
        padding: 16px 18px;
    }

    .profile-panel-title {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 8px;
        font-size: 14px;
        font-weight: 600;
        color: #315967;
    }

        .profile-panel-title i {
            color: #75AABA;
        }

    .profile-panel-count {
        margin-left: auto;
        font-size: 12px;
        font-weight: 600;
        color: #58717a;
        background: #e9f1f4;
        border-radius: 20px;
        padding: 2px 9px;
    }

    .profile-panel.is-allergy {
        background: #fff8f6;
        border-color: #f3d9d3;
    }

        .profile-panel.is-allergy .profile-panel-title,
        .profile-panel.is-allergy .profile-panel-title i {
            color: #9b3b2c;
        }

        .profile-panel.is-allergy .profile-panel-count {
            background: #fbe3de;
            color: #9b3b2c;
        }

    .profile-list {
        list-style: none;
        margin: 0;
        padding: 0;
    }

        .profile-list li {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 12px;
            padding: 10px 0;
            border-top: 1px solid #edf2f4;
        }

            .profile-list li:first-child {
                border-top: 0;
            }

    .profile-panel.is-allergy .profile-list li {
        border-top-color: #f3d9d3;
    }

        .profile-panel.is-allergy .profile-list li:first-child {
            border-top: 0;
        }

    .profile-list-name {
        font-weight: 600;
        font-size: 14px;
        color: #263b43;
    }

    .profile-list-meta {
        font-size: 12.5px;
        color: #7a8b92;
    }

    .profile-empty {
        margin: 0;
        padding-top: 4px;
        font-size: 13px;
        color: #7a8b92;
    }

    .severity-badge {
        flex-shrink: 0;
        padding: 3px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        background: #fbe3de;
        color: #9b3b2c;
    }

    /* ---------- Technician ---------- */

    .technician-box {
        background: #eef7f9;
        border: 1px solid #d6eaee;
        border-radius: 10px;
        padding: 16px 18px;
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .technician-icon {
        width: 45px;
        height: 45px;
        border-radius: 50%;
        background: #75AABA;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
    }

    .technician-label {
        font-size: 12px;
        color: #71858c;
        margin-bottom: 2px;
    }

    .technician-name {
        font-weight: 600;
        color: #294b57;
    }

    .clinical-note {
        background: #f8fafb;
        border-left: 4px solid #75AABA;
        border-radius: 6px;
        padding: 15px 18px;
        color: #455960;
        line-height: 1.6;
        white-space: pre-wrap;
    }

    /* ---------- Sample table ---------- */

    .sample-table {
        margin-bottom: 0;
    }

        .sample-table thead th {
            background: #f3f7f8;
            color: #58717a;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: .3px;
            border-bottom: 1px solid #dfe8eb;
            padding: 13px 15px;
            white-space: nowrap;
        }

        .sample-table tbody td {
            padding: 16px 15px;
            vertical-align: middle;
            border-color: #edf1f2;
            color: #40545b;
        }

    .barcode {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #397c91;
        font-weight: 600;
        overflow-wrap: anywhere;
    }

    .barcode-display {
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    .barcode-edit-btn {
        border: none;
        background: transparent;
        color: #6c8790;
        padding: 5px 7px;
        border-radius: 5px;
        cursor: pointer;
    }

        .barcode-edit-btn:hover {
            background: #edf4f6;
            color: #397c91;
        }

    .barcode-edit-panel {
        min-width: 220px;
        max-width: 300px;
    }

    .sample-type {
        display: inline-block;
        background: #edf6f8;
        color: #477d8c;
        padding: 5px 10px;
        border-radius: 6px;
        font-size: 13px;
        font-weight: 600;
    }

    .reject-panel {
        min-width: 230px;
        background: #fffafa;
        border: 1px solid #f0dada;
        padding: 12px;
        border-radius: 8px;
    }

    .rejection-reason {
        color: #842029;
        background: #f8d7da;
        border-radius: 7px;
        padding: 10px 12px;
        margin-top: 8px;
        white-space: normal;
        overflow-wrap: anywhere;
    }

    .action-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    @@media (max-width: 992px) {
        .patient-profile {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 768px) {
        .page-hero {
            padding: 22px 18px;
        }

        .info-card-body {
            padding: 16px;
        }

        .sample-table thead th,
        .sample-table tbody td {
            padding: 12px 10px;
        }
    }
</style>

<div class="container mt-4 receive-page">

    @if (TempData["SampleReceivedSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>
            @TempData["SampleReceivedSuccess"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["SampleError"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>
            @TempData["SampleError"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="page-hero">
        <div class="d-flex justify-content-between align-items-center gap-3">
            <div>
                <div class="mb-2">
                    <i class="fas fa-vial me-2"></i>
                    LABORATORY SAMPLE RECEIVING
                </div>
                <h2>Receive Patient Sample</h2>
                <p>Review the request, verify each barcode and confirm or reject each sample.</p>
            </div>

            <a asp-action="ReceiveSample" class="btn back-btn">
                <i class="fas fa-arrow-left me-2"></i>Back
            </a>
        </div>
    </div>

    <!-- TEST REQUEST -->
    <div class="info-card">
        <div class="info-card-header">
            <i class="fas fa-file-medical"></i>
            <span>Test Request Details</span>
        </div>

        <div class="info-card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <div class="info-item">
                        <span class="info-label">Request Number</span>
                        <span class="request-number">#@Model.TestRequestId</span>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="info-item">
                        <span class="info-label">Request Date</span>
                        <span class="info-value">
                            @Model.RequestDate.ToString("dd/MM/yyyy HH:mm")
                        </span>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="info-item">
                        <span class="info-label">Urgency</span>
                        <span class="urgency-badge">@Model.Urgency</span>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="info-item">
                        <span class="info-label">Request Status</span>
                        <span class="status-badge">@Model.Status</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- PATIENT INFORMATION (includes conditions, allergies, medications) -->
    <div class="info-card">
        <div class="info-card-header">
            <i class="fas fa-user"></i>
            <span>Patient Information</span>
        </div>

        <div class="info-card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="info-item">
                        <span class="info-label">Patient Name</span>
                        <span class="info-value">
                            @Model.Patient?.Name @Model.Patient?.Surname
                        </span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="info-item">
                        <span class="info-label">ID Number</span>
                        <span class="info-value">@Model.Patient?.IDNumber</span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="info-item">
                        <span class="info-label">Date of Birth</span>
                        <span class="info-value">
                            @(Model.Patient == null
                                ? "Not available"
                                : Model.Patient.DateOfBirth.ToString("dd/MM/yyyy"))
                        </span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="info-item">
                        <span class="info-label">Contact Number</span>
                        <span class="info-value">@Model.Patient?.PhoneNumber</span>
                    </div>
                </div>
            </div>

            <div class="patient-profile">

                <div class="profile-panel">
                    <div class="profile-panel-title">
                        <i class="fas fa-heartbeat"></i>
                        <span>Medical conditions</span>
                        <span class="profile-panel-count">@conditions.Count</span>
                    </div>

                    @if (conditions.Any())
                    {
                        <ul class="profile-list">
                            @foreach (var item in conditions)
                            {
                                <li><div class="profile-list-name">@item</div></li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="profile-empty">No conditions recorded.</p>
                    }
                </div>

                <div class="profile-panel is-allergy">
                    <div class="profile-panel-title">
                        <i class="fas fa-exclamation-triangle"></i>
                        <span>Allergies</span>
                        <span class="profile-panel-count">@allergies.Count</span>
                    </div>

                    @if (allergies.Any())
                    {
                        <ul class="profile-list">
                            @foreach (var item in allergies)
                            {
                                <li><div class="profile-list-name">@item</div></li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="profile-empty">No allergies recorded.</p>
                    }
                </div>

                <div class="profile-panel">
                    <div class="profile-panel-title">
                        <i class="fas fa-pills"></i>
                        <span>Current medications</span>
                        <span class="profile-panel-count">@medications.Count</span>
                    </div>

                    @if (medications.Any())
                    {
                        <ul class="profile-list">
                            @foreach (var item in medications)
                            {
                                <li><div class="profile-list-name">@item</div></li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="profile-empty">No medications recorded.</p>
                    }
                </div>

            </div>
        </div>
    </div>

    <!-- REQUESTING DOCTOR -->
    <div class="info-card">
        <div class="info-card-header">
            <i class="fas fa-user-md"></i>
            <span>Requesting Doctor</span>
        </div>

        <div class="info-card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="info-item">
                        <span class="info-label">Doctor</span>
                        <span class="info-value">
                            @Model.Doctor?.Name @Model.Doctor?.Surname
                        </span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="info-item">
                        <span class="info-label">HPCSA Number</span>
                        <span class="info-value">
                            @(string.IsNullOrWhiteSpace(Model.Doctor?.HPCSANumber)
                                ? "Not provided"
                                : Model.Doctor.HPCSANumber)
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- RECEIVING TECHNICIAN -->
    <div class="info-card">
        <div class="info-card-header">
            <i class="fas fa-user-check"></i>
            <span>Receiving Technician</span>
        </div>

        <div class="info-card-body">
            <div class="technician-box">
                <div class="technician-icon">
                    <i class="fas fa-user-md"></i>
                </div>

                <div>
                    <div class="technician-label">Currently logged-in technician</div>
                    <div class="technician-name">@User.Identity?.Name</div>
                </div>
            </div>
        </div>
    </div>

    <!-- CLINICAL INFORMATION -->
    <div class="info-card">
        <div class="info-card-header">
            <i class="fas fa-notes-medical"></i>
            <span>Clinical Information</span>
        </div>

        <div class="info-card-body">
            <span class="info-label">Clinical Notes</span>

            <div class="clinical-note">
                @if (string.IsNullOrWhiteSpace(Model.ClinicalNotes))
                {
                    <span class="text-muted">No clinical notes provided.</span>
                }
                else
                {
                    @Model.ClinicalNotes
                }
            </div>
        </div>
    </div>

    <!-- SAMPLE INFORMATION -->
    <div class="info-card">
        <div class="info-card-header">
            <i class="fas fa-vial"></i>
            <span>Sample Information</span>

            <span class="badge ms-auto"
                  style="background:#e2f1f4;color:#4d8393;">
                @(Model.Samples?.Count ?? 0) Sample(s)
            </span>
        </div>

        <div class="info-card-body">
            @if (Model.Samples == null || !Model.Samples.Any())
            {
                <div class="alert alert-warning mb-0">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    No samples are associated with this test request.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table sample-table">
                        <thead>
                            <tr>
                                <th>Barcode</th>
                                <th>Sample Type</th>
                                <th>Received Date &amp; Time</th>
                                <th>Sample Status / Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var sample in Model.Samples)
                            {
                                var sampleStatus = string.IsNullOrWhiteSpace(sample.Status)
                                    ? (sample.DateTimeReceived.HasValue ? "Received" : "Pending")
                                    : sample.Status;

                                <tr>
                                    <!-- BARCODE -->
                                    <td>
                                        @if (sampleStatus != "Received" &&
                                             sampleStatus != "Rejected" &&
                                             !sample.DateTimeReceived.HasValue)
                                        {
                                            <div class="barcode-display">
                                                <span class="barcode">
                                                    <i class="fas fa-barcode"></i>
                                                    @sample.Barcode
                                                </span>

                                                <button type="button"
                                                        class="barcode-edit-btn"
                                                        title="Edit barcode"
                                                        aria-label="Edit barcode"
                                                        data-bs-toggle="collapse"
                                                        data-bs-target="#barcode-edit-@sample.SampleId"
                                                        aria-expanded="false">
                                                    <i class="fas fa-pencil-alt"></i>
                                                </button>
                                            </div>

                                            <div class="collapse mt-2"
                                                 id="barcode-edit-@sample.SampleId">
                                                <div class="barcode-edit-panel">
                                                    <form asp-action="EditSampleBarcode"
                                                          method="post">
                                                        @Html.AntiForgeryToken()

                                                        <input type="hidden"
                                                               name="sampleId"
                                                               value="@sample.SampleId" />

                                                        <label class="form-label small">
                                                            Correct barcode
                                                        </label>

                                                        <input type="text"
                                                               name="barcode"
                                                               value="@sample.Barcode"
                                                               class="form-control form-control-sm mb-2"
                                                               maxlength="100"
                                                               required />

                                                        <div class="d-flex gap-2">
                                                            <button type="submit"
                                                                    class="btn btn-sm btn-primary">
                                                                <i class="fas fa-check me-1"></i>
                                                                Save
                                                            </button>

                                                            <button type="button"
                                                                    class="btn btn-sm btn-light border"
                                                                    data-bs-toggle="collapse"
                                                                    data-bs-target="#barcode-edit-@sample.SampleId">
                                                                Cancel
                                                            </button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="barcode">
                                                <i class="fas fa-barcode"></i>
                                                @sample.Barcode
                                            </span>
                                        }
                                    </td>

                                    <!-- SAMPLE TYPE -->
                                    <td>
                                        <span class="sample-type">
                                            <i class="fas fa-vial me-1"></i>
                                            @(sample.SampleType?.SampleName ?? "Not specified")
                                        </span>
                                    </td>

                                    <!-- RECEIVED DATE -->
                                    <td>
                                        @if (sample.DateTimeReceived.HasValue)
                                        {
                                            @sample.DateTimeReceived.Value.ToString("dd/MM/yyyy HH:mm:ss")
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not yet received</span>
                                        }
                                    </td>

                                    <!-- STATUS AND ACTIONS -->
                                    <td>
                                        @if (sampleStatus == "Rejected")
                                        {
                                            <span class="badge bg-danger">Rejected</span>

                                            <div class="rejection-reason">
                                                <strong>Reason:</strong>
                                                @(string.IsNullOrWhiteSpace(sample.RejectionReason)
                                                    ? "No reason recorded."
                                                    : sample.RejectionReason)
                                            </div>

                                            @if (sample.RejectedDateTime.HasValue)
                                            {
                                                <small class="text-muted d-block mt-2">
                                                    Rejected on
                                                    @sample.RejectedDateTime.Value.ToString("dd/MM/yyyy HH:mm")
                                                </small>
                                            }
                                        }
                                        else if (sampleStatus == "Received" ||
                                                 sample.DateTimeReceived.HasValue)
                                        {
                                            <span class="badge bg-success">Received</span>
                                        }
                                        else
                                        {
                                            <div class="action-buttons">
                                                <form asp-action="ConfirmReceiveSample"
                                                      method="post">
                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="sampleId"
                                                           value="@sample.SampleId" />

                                                    <button type="submit"
                                                            class="btn btn-sm btn-primary">
                                                        <i class="fas fa-check-circle me-1"></i>
                                                        Confirm Receipt
                                                    </button>
                                                </form>

                                                <button type="button"
                                                        class="btn btn-sm btn-outline-danger"
                                                        data-bs-toggle="collapse"
                                                        data-bs-target="#reject-@sample.SampleId"
                                                        aria-expanded="false">
                                                    <i class="fas fa-times-circle me-1"></i>
                                                    Reject Sample
                                                </button>
                                            </div>

                                            <div class="collapse mt-3"
                                                 id="reject-@sample.SampleId">
                                                <div class="reject-panel">
                                                    <form asp-action="RejectSample"
                                                          method="post"
                                                          class="reject-form"
                                                          novalidate>
                                                        @Html.AntiForgeryToken()

                                                        <input type="hidden"
                                                               name="sampleId"
                                                               value="@sample.SampleId" />

                                                        <div class="mb-2">
                                                            <label class="form-label"
                                                                   for="reason-@sample.SampleId">
                                                                Reason for rejection
                                                                <span class="text-danger">*</span>
                                                            </label>

                                                            <select id="reason-@sample.SampleId"
                                                                    name="rejectionReason"
                                                                    class="form-select form-select-sm reject-reason"
                                                                    required>
                                                                <option value="">Select a reason</option>
                                                                <option value="Improper transport or storage">
                                                                    Improper transport or storage
                                                                </option>
                                                                <option value="Damaged or leaking container">
                                                                    Damaged or leaking container
                                                                </option>
                                                                <option value="Insufficient sample quantity">
                                                                    Insufficient sample quantity
                                                                </option>
                                                                <option value="Incorrect patient identification">
                                                                    Incorrect patient identification
                                                                </option>
                                                                <option value="Unsuitable sample type">
                                                                    Unsuitable sample type
                                                                </option>
                                                                <option value="Other">Other</option>
                                                            </select>
                                                            <div class="invalid-feedback">
                                                                Select a reason before rejecting this sample.
                                                            </div>
                                                        </div>

                                                        <div class="mb-3">
                                                            <label class="form-label"
                                                                   for="details-@sample.SampleId">
                                                                Additional details
                                                                <span class="reject-details-hint text-muted">(optional)</span>
                                                            </label>

                                                            <textarea id="details-@sample.SampleId"
                                                                      name="rejectionDetails"
                                                                      class="form-control form-control-sm reject-details"
                                                                      maxlength="1000"
                                                                      rows="2"
                                                                      placeholder="Add details if needed"></textarea>
                                                            <div class="invalid-feedback">
                                                                Describe the reason when you select "Other".
                                                            </div>
                                                        </div>

                                                        <button type="submit"
                                                                class="btn btn-sm btn-danger">
                                                            <i class="fas fa-times-circle me-1"></i>
                                                            Confirm Rejection
                                                        </button>
                                                    </form>
                                                </div>
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<script>
    document.querySelectorAll('.reject-form').forEach(function (form) {
        var reason = form.querySelector('.reject-reason');
        var details = form.querySelector('.reject-details');
        var hint = form.querySelector('.reject-details-hint');
        var attempted = false;

        function isOther() {
            return reason.value === 'Other';
        }

        function validate() {
            var reasonOk = reason.value.trim() !== '';
            var detailsOk = !isOther() || details.value.trim() !== '';

            reason.classList.toggle('is-invalid', !reasonOk);
            details.classList.toggle('is-invalid', !detailsOk);

            return reasonOk && detailsOk;
        }

        function refresh() {
            hint.textContent = isOther() ? '(required)' : '(optional)';
            details.required = isOther();
            details.placeholder = isOther()
                ? 'Describe the reason for rejection'
                : 'Add details if needed';

            if (attempted) {
                validate();
            }
        }

        reason.addEventListener('change', refresh);
        details.addEventListener('input', refresh);

        form.addEventListener('submit', function (e) {
            attempted = true;

            if (!validate()) {
                e.preventDefault();
                (reason.classList.contains('is-invalid') ? reason : details).focus();
            }
        });
    });
</script>
