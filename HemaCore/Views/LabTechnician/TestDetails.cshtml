
@model HemaCore.Models.TestRequestItem
@using HemaCore.Models

@{
    ViewData["Title"] = "Test Details";
    Layout = "_LabTechnicianLayout";

    var consumables = ViewBag.Consumables as List<TestTypeConsumable>
        ?? new List<TestTypeConsumable>();

    var expectedFinish = (DateTime)ViewBag.ExpectedFinish;
    bool hasShortage = (bool)ViewBag.HasShortage;

    var duration = TimeSpan.FromHours(Model.TestType.TurnAroundTime);

    string durationText = duration.TotalHours >= 1
        ? $"{(int)duration.TotalHours} h {duration.Minutes} min"
        : $"{duration.Minutes} min";
}

<style>
    .test-page {
        max-width: 1100px;
        margin: 0 auto;
        padding: 28px 24px 40px;
        color: #304750;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        margin-bottom: 28px;
    }

    .page-header h1 {
        margin: 0;
        font-size: 27px;
        font-weight: 650;
        color: #263f48;
    }

    .request-label {
        margin-top: 6px;
        color: #819198;
        font-size: 13px;
    }

    .back-link {
        color: #426873;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
        white-space: nowrap;
    }

    .back-link:hover {
        color: #75AABA;
    }

    .error-message {
        padding: 12px 15px;
        margin-bottom: 20px;
        border: 1px solid #f0dfb8;
        border-radius: 7px;
        background: #fffaf0;
        color: #805c1b;
        font-size: 13px;
    }

    .summary {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        border-top: 1px solid #e5ecee;
        border-bottom: 1px solid #e5ecee;
    }

    .summary-item {
        padding: 18px 16px 18px 0;
        min-width: 0;
    }

    .summary-item:not(:last-child) {
        border-right: 1px solid #e5ecee;
        margin-right: 16px;
    }

    .label {
        display: block;
        margin-bottom: 7px;
        color: #839399;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: .5px;
    }

    .value {
        font-size: 14px;
        font-weight: 600;
        overflow-wrap: anywhere;
    }

    .urgency {
        display: inline-flex;
        align-items: center;
        gap: 7px;
    }

    .urgency-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #d5a34a;
    }

    .section {
        margin-top: 30px;
    }

    .section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 14px;
    }

    .section-header h2 {
        margin: 0;
        font-size: 16px;
        font-weight: 650;
        color: #304952;
    }

    .item-count {
        color: #839399;
        font-size: 12px;
    }

    .timing-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
        padding: 20px 0;
        border-top: 1px solid #e5ecee;
        border-bottom: 1px solid #e5ecee;
    }

    .timing-value {
        font-size: 25px;
        font-weight: 650;
        color: #304750;
    }

    .timing-caption {
        margin-top: 5px;
        font-size: 12px;
        color: #839399;
    }

    .table-wrap {
        overflow-x: auto;
        border-top: 1px solid #e5ecee;
    }

    .stock-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 500px;
    }

    .stock-table th {
        padding: 12px 12px 12px 0;
        text-align: left;
        color: #839399;
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .4px;
        border-bottom: 1px solid #e5ecee;
    }

    .stock-table td {
        padding: 14px 12px 14px 0;
        font-size: 13px;
        border-bottom: 1px solid #edf1f2;
        color: #465d65;
    }

    .stock-table tbody tr:last-child td {
        border-bottom: 1px solid #e5ecee;
    }

    .stock-name {
        font-weight: 600;
        color: #344e57;
    }

    .stock-status {
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
    }

    .stock-status.ok { color: #347454; }
    .stock-status.low { color: #976c23; }
    .stock-status.out { color: #b24f43; }

    .empty-stock {
        padding: 18px 0;
        border-top: 1px solid #e5ecee;
        color: #839399;
        font-size: 13px;
    }

    .stock-warning {
        margin-top: 18px;
        padding: 13px 15px;
        border: 1px solid #f0dfb8;
        border-radius: 7px;
        background: #fffaf0;
        color: #805c1b;
        font-size: 13px;
    }

    .actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 25px;
        padding-top: 20px;
        border-top: 1px solid #e5ecee;
    }

    .btn-select {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 11px 18px;
        border: 1px solid #75AABA;
        border-radius: 7px;
        background: #75AABA;
        color: #fff;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
    }

    .btn-select:hover:not(:disabled) {
        background: #5f96a6;
    }

    .btn-select:disabled {
        background: #c8d9de;
        border-color: #c8d9de;
        cursor: not-allowed;
    }

    .btn-cancel {
        padding: 10px 14px;
        color: #526a72;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
    }

    .btn-cancel:hover {
        color: #315967;
    }

    @@media (max-width: 650px) {
        .test-page {
            padding: 22px 16px 32px;
        }

        .page-header {
            align-items: flex-start;
        }

        .page-header h1 {
            font-size: 23px;
        }

        .summary {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .summary-item {
            border-bottom: 1px solid #e5ecee;
        }

        .summary-item:nth-child(2) {
            border-right: none;
            margin-right: 0;
        }

        .summary-item:nth-child(3),
        .summary-item:nth-child(4) {
            border-bottom: none;
        }

        .timing-row {
            gap: 16px;
        }

        .timing-value {
            font-size: 22px;
        }

        .actions {
            align-items: stretch;
            flex-direction: column-reverse;
        }

        .btn-select {
            width: 100%;
        }

        .btn-cancel {
            text-align: center;
        }
    }

    @@media (max-width: 400px) {
        .page-header {
            flex-direction: column;
        }

        .timing-row {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="test-page">

    @if (TempData["Error"] != null)
    {
        <div class="error-message" role="alert">
            <i class="fas fa-circle-exclamation me-2"></i>
            @TempData["Error"]
        </div>
    }

    <div class="page-header">
        <div>
            <h1>@Model.TestType.TestTypeName</h1>
            <div class="request-label">
                Request #@Model.TestRequestId
            </div>
        </div>

        <a asp-action="ProcessTests" class="back-link">
            <i class="fas fa-arrow-left me-1"></i> Back to tests
        </a>
    </div>

    <div class="summary">
        <div class="summary-item">
            <span class="label">Category</span>
            <span class="value">
                @(Model.TestType.Category?.CategoryName ?? "Not specified")
            </span>
        </div>

        <div class="summary-item">
            <span class="label">Urgency</span>
            <span class="value urgency">
                <span class="urgency-dot"></span>
                @Model.TestRequest.Urgency
            </span>
        </div>

        <div class="summary-item">
            <span class="label">Turnaround</span>
            <span class="value">@durationText</span>
        </div>

        <div class="summary-item">
            <span class="label">Estimated completion</span>
            <span class="value">@expectedFinish.ToString("dd MMM, HH:mm")</span>
        </div>
    </div>

    <section class="section">
        <div class="section-header">
            <h2>Consumables</h2>
            <span class="item-count">@consumables.Count item(s)</span>
        </div>

        @if (!consumables.Any())
        {
            <div class="empty-stock">No consumables recorded for this test.</div>
        }
        else
        {
            <div class="table-wrap">
                <table class="stock-table">
                    <thead>
                        <tr>
                            <th>Consumable</th>
                            <th>Required</th>
                            <th>In stock</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in consumables)
                        {
                            bool enough =
                                item.Consumable.QuantityInHand >= item.QuantityNeeded;

                            bool low =
                                enough &&
                                item.Consumable.QuantityInHand
                                <= item.Consumable.ReorderLevel;

                            <tr>
                                <td class="stock-name">
                                    @item.Consumable.ConsumableName
                                </td>
                                <td>@item.QuantityNeeded</td>
                                <td>@item.Consumable.QuantityInHand</td>
                                <td>
                                    @if (!enough)
                                    {
                                        <span class="stock-status out">Insufficient</span>
                                    }
                                    else if (low)
                                    {
                                        <span class="stock-status low">Low stock</span>
                                    }
                                    else
                                    {
                                        <span class="stock-status ok">Available</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    @if (hasShortage)
    {
        <div class="stock-warning" role="alert">
            <i class="fas fa-triangle-exclamation me-2"></i>
            Insufficient stock. This test cannot be selected until the shortage is resolved.
        </div>
    }

  
    <div class="actions">
        <a asp-action="ProcessTests" class="btn-cancel">
            Select a Different Test
        </a>

        @if (hasShortage)
        {
            <button type="button" class="btn-select" disabled>
                <i class="fas fa-plus"></i> Add to My Tests
            </button>
        }
        else
        {
            <form asp-action="AddToMyTests"
                  asp-route-id="@Model.TestRequestTestTypeId"
                  method="post">
                @Html.AntiForgeryToken()

                <button type="submit" class="btn-select">
                    <i class="fas fa-plus"></i> Add to My Tests
                </button>
            </form>
        }
    </div>
    

</div>
