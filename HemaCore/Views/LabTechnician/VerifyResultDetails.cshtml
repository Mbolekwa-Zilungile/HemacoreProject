@model HemaCore.Models.TestResult
@using HemaCore.Models
@using System.Linq

@{
    ViewData["Title"] = "Verify Test Result";
    Layout = "_LabTechnicianLayout";

    var test = Model.TestRequestTestType.FirstOrDefault();
    var request = test?.TestRequest;
    var patient = request?.Patient;
    var testType = test?.TestType;

    var history = ViewBag.TestResultHistory as IEnumerable<TestResultHistory>
                  ?? Enumerable.Empty<TestResultHistory>();

    var historyRecords = history
        .OrderBy(h => h.ActionDateTime)
        .ToList();

    var conditions = ViewBag.PatientConditions as IEnumerable<PatientCondition>
                     ?? Enumerable.Empty<PatientCondition>();

    var allergies = ViewBag.PatientAllergies as IEnumerable<PatientAllergy>
                    ?? Enumerable.Empty<PatientAllergy>();

    var medications = ViewBag.PatientMedications as IEnumerable<PatientMedication>
                      ?? Enumerable.Empty<PatientMedication>();

    var patientName = patient != null
        ? $"{patient.Name} {patient.Surname}"
        : "N/A";

    var normalMin = ViewBag.NormalRangeMin;
    var normalMax = ViewBag.NormalRangeMax;

    var testUnit = ViewBag.TestUnit as string
                   ?? testType?.UnitOfMeasurement
                   ?? "";

    var referenceRange = normalMin != null && normalMax != null
        ? $"{normalMin} – {normalMax} {testUnit}".Trim()
        : "Reference range not available";
}

<div class="verify-page">

    <header class="page-heading">
        <div>
            <h2>Verify test result</h2>
            <p>Review the patient information, medical background and test result before making your decision.</p>
        </div>

        <a asp-action="VerifyResults" class="btn btn-outline-secondary">
            Back to verification list
        </a>
    </header>

    <!-- Patient and test summary -->
    <section class="summary-bar" aria-label="Patient and test summary">
        <div class="summary-item">
            <span class="label">Patient</span>
            <span class="value">@patientName</span>
        </div>

        <div class="summary-item">
            <span class="label">Test</span>
            <span class="value">@(testType?.TestTypeName ?? "N/A")</span>
        </div>

        <div class="summary-item">
            <span class="label">Result recorded</span>
            <span class="value">@Model.DateCaptured.ToString("dd MMM yyyy, HH:mm")</span>
        </div>
    </section>

    <!-- Patient information -->
    <section class="verify-card">
        <div class="card-head">
            <div>
                <h5>Patient information</h5>
                <p>Patient identification and demographic details.</p>
            </div>
        </div>

        <div class="patient-info-grid">
            <div class="info-item">
                <span class="label">Full name</span>
                <span class="info-value">@patientName</span>
            </div>

            <div class="info-item">
                <span class="label">Patient ID number</span>
                <span class="info-value">@(patient?.IDNumber ?? "Not recorded")</span>
            </div>

            <div class="info-item">
                <span class="label">Date of birth</span>
                <span class="info-value">
                    @(patient == null ? "Not recorded" : patient.DateOfBirth.ToString("dd MMM yyyy"))
                </span>
            </div>

            <div class="info-item">
                <span class="label">Gender</span>
                <span class="info-value">@(patient?.Gender ?? "Not recorded")</span>
            </div>

            <div class="info-item">
                <span class="label">Contact number</span>
                <span class="info-value">@(patient?.PhoneNumber ?? "Not recorded")</span>
            </div>

            <div class="info-item">
                <span class="label">Request number</span>
                <span class="info-value">
                    @(request == null ? "N/A" : request.TestRequestId.ToString())
                </span>
            </div>
        </div>
    </section>

    <!-- Medical background -->
    <section class="verify-card">
        <div class="card-head">
            <div>
                <h5>Medical background</h5>
                <p>Medical information recorded for this patient.</p>
            </div>
        </div>

        <div class="medical-grid">

            <div class="medical-section">
                <h6>Medical conditions</h6>

                @if (conditions.Any())
                {
                    <ul>
                        @foreach (var item in conditions)
                        {
                            <li>@(item.Condition?.Name ?? "Condition name unavailable")</li>
                        }
                    </ul>
                }
                else
                {
                    <p class="empty-info">No medical conditions recorded.</p>
                }
            </div>

            <div class="medical-section">
                <h6>Allergies</h6>

                @if (allergies.Any())
                {
                    <ul>
                        @foreach (var item in allergies)
                        {
                            <li>@(item.Allergy?.Name ?? "Allergy name unavailable")</li>
                        }
                    </ul>
                }
                else
                {
                    <p class="empty-info">No allergies recorded.</p>
                }
            </div>

            <div class="medical-section">
                <h6>Medications</h6>

                @if (medications.Any())
                {
                    <ul>
                        @foreach (var item in medications)
                        {
                            <li>
                                <strong>@(item.Medication?.Name ?? "Medication name unavailable")</strong>

                                @if (!string.IsNullOrWhiteSpace(item.Dosage))
                                {
                                    <span> — @item.Dosage</span>
                                }

                                @if (!string.IsNullOrWhiteSpace(item.Frequency))
                                {
                                    <span>, @item.Frequency</span>
                                }
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="empty-info">No medications recorded.</p>
                }
            </div>

        </div>
    </section>

    <!-- Current result -->
    <section class="verify-card @(Model.IsAbnormal ? "is-abnormal" : "")">
        <div class="card-head">
            <div>
                <h5>Current test result</h5>
                <p>Compare the current result with the configured reference range.</p>
            </div>

            <span class="flag @(Model.IsAbnormal ? "flag-abnormal" : "flag-normal")">
                @(Model.IsAbnormal ? "Abnormal" : "Not marked abnormal")
            </span>
        </div>

        <div class="result-layout">
            <div class="result-main">
                <span class="label">Current recorded value</span>

                <div class="result-value @(string.IsNullOrWhiteSpace(Model.ResultValue) ? "is-empty" : "")">
                    @(string.IsNullOrWhiteSpace(Model.ResultValue)
                        ? "Not recorded"
                        : $"{Model.ResultValue} {testUnit}".Trim())
                </div>

                <div class="reference-range">
                    <span class="label">Normal reference range</span>
                    <strong>@referenceRange</strong>
                    <p>Reference range configured for this test type.</p>
                </div>
            </div>

            <div class="result-notes">
                <span class="label">Result notes</span>
                <div class="notes-text @(string.IsNullOrWhiteSpace(Model.Notes) ? "is-empty" : "")">
                    @(string.IsNullOrWhiteSpace(Model.Notes) ? "No notes recorded" : Model.Notes)
                </div>
            </div>
        </div>
    </section>

    <!-- Test history -->
    <section class="review-card">
        <div class="history-heading">
            <div>
                <h5>Test history</h5>
                <p>Recorded actions and result changes for this test.</p>
            </div>
            <span class="history-count">@historyRecords.Count @(historyRecords.Count == 1 ? "entry" : "entries")</span>
        </div>

        <div class="history-table-wrapper">
            <table class="history-table">
                <thead>
                    <tr>
                        <th>Date &amp; Time</th>
                        <th>Action</th>
                        <th>Technician</th>
                        <th>Captured Value</th>
                        <th>Notes</th>
                    </tr>
                </thead>

                <tbody>
                    @if (historyRecords.Any())
                    {
                        foreach (var item in historyRecords)
                        {
                            var actionLabel = item.Action switch
                            {
                                "Result Captured" => "Result Captured",
                                "Sent Back for Review" => "Sent Back For Review",
                                "Sent Back For Review" => "Sent Back For Review",
                                "Corrected Result Resubmitted" => "Resubmitted",
                                "Result Verified" => "Verified",
                                _ => item.Action
                            };

                            var isSentBack =
                                item.Action == "Sent Back for Review" ||
                                item.Action == "Sent Back For Review";

                            var actionClass = isSentBack
                                ? "action-returned"
                                : item.Action == "Result Verified"
                                    ? "action-verified"
                                    : item.Action == "Corrected Result Resubmitted"
                                        ? "action-resubmitted"
                                        : "action-captured";

                            <tr>
                                <td class="history-date">
                                    @item.ActionDateTime.ToString("dd MMM yyyy")
                                    <span>@item.ActionDateTime.ToString("HH:mm")</span>
                                </td>

                                <td>
                                    <span class="action-label @actionClass">
                                        @actionLabel
                                    </span>
                                </td>

                                <td class="history-user">
                                    @(item.LabTechnician?.User?.FullName ?? "Unknown user")
                                </td>

                                <td class="captured-value">
                                    @if (isSentBack)
                                    {
                                        <span class="no-value">—</span>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(item.ResultValue))
                                    {
                                        @($"{item.ResultValue} {testUnit}".Trim())
                                    }
                                    else
                                    {
                                        <span class="no-value">—</span>
                                    }
                                </td>

                                <td class="history-notes">
                                    @if (!string.IsNullOrWhiteSpace(item.ReviewNotes))
                                    {
                                        @item.ReviewNotes
                                    }
                                    else if (!string.IsNullOrWhiteSpace(item.ResultNotes))
                                    {
                                        @item.ResultNotes
                                    }
                                    else
                                    {
                                        <span class="no-value">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="history-empty">
                                No test history recorded.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <!-- Verification decision -->
    <section class="verify-card decision-card">
        <div class="card-head">
            <div>
                <h5>Verification decision</h5>
                <p>Verify the result if it is correct, or send it back with a reason for correction.</p>
            </div>
        </div>

        <form asp-action="VerifyResult"
              method="post"
              id="decisionForm"
              class="decision-form">

            <input type="hidden" name="id" value="@Model.TestResultId" />

            <label for="reviewNotes" class="form-label">Review notes</label>

            <textarea id="reviewNotes"
                      name="reviewNotes"
                      class="form-control"
                      rows="3"
                      aria-describedby="notesHelp"
                      placeholder="Explain what needs correcting if you send the result back."></textarea>

            <div id="notesHelp" class="notes-help">
                A reason is required when sending a result back for correction.
            </div>

            <div class="decision-actions">
                <button type="submit"
                        name="action"
                        value="SendBack"
                        class="btn btn-outline-danger"
                        formnovalidate>
                    Send Back for Correction
                </button>

                <button type="submit"
                        name="action"
                        value="Verify"
                        class="btn btn-primary">
                    Verify Result
                </button>
            </div>
        </form>
    </section>

</div>

<script>
    (function() {
        const form = document.getElementById("decisionForm");
        const notes = document.getElementById("reviewNotes");
        const help = document.getElementById("notesHelp");

        if (!form || !notes || !help) return;

        const defaultHelp = help.textContent;

        form.addEventListener("submit", function(e) {
            const action = e.submitter ? e.submitter.value : "";

            if (action === "SendBack" && notes.value.trim() === "") {
                e.preventDefault();
                notes.classList.add("is-invalid");
                help.textContent =
                    "Enter a reason explaining what needs to be corrected.";
                help.classList.add("is-error");
                notes.focus();
            }
        });

        notes.addEventListener("input", function() {
            notes.classList.remove("is-invalid");
            help.classList.remove("is-error");
            help.textContent = defaultHelp;
        });
    })();
</script>

<style>
    :root {
        --ink: #1f2933;
        --ink-soft: #52606d;
        --ink-faint: #7b8794;
        --surface: #ffffff;
        --page: #f4f6f8;
        --line: #e1e6eb;
        --line-soft: #edf0f3;
        --accent: #75aaba;
        --accent-dark: #356f7c;
        --danger: #b42318;
        --danger-bg: #fdf0ee;
        --warn: #9a6700;
        --warn-bg: #fff7e6;
        --ok: #18794e;
        --ok-bg: #eaf6ef;
        --radius: 8px;
    }

    .verify-page {
        max-width: 1100px;
        margin: 0 auto;
        padding: 24px 20px 48px;
        min-height: 100vh;
        background: var(--page);
        color: var(--ink);
        line-height: 1.5;
    }

    .page-heading {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 16px;
        margin-bottom: 20px;
    }

        .page-heading h2 {
            margin: 0 0 4px;
            font-size: 24px;
            font-weight: 600;
        }

        .page-heading p,
        .card-head p,
        .history-heading p {
            margin: 3px 0 0;
            color: var(--ink-soft);
            font-size: 13px;
        }

    .label {
        display: block;
        margin-bottom: 4px;
        color: var(--ink-faint);
        font-size: 12px;
        font-weight: 500;
    }

    .summary-bar {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        margin-bottom: 16px;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--radius);
    }

    .summary-item {
        padding: 14px 18px;
        min-width: 0;
    }

        .summary-item + .summary-item {
            border-left: 1px solid var(--line-soft);
        }

        .summary-item .value,
        .info-value {
            display: block;
            font-size: 14px;
            font-weight: 600;
            overflow-wrap: anywhere;
        }

    .verify-card,
    .review-card {
        margin-bottom: 16px;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        overflow: hidden;
    }

    .card-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 12px;
        padding: 16px 20px;
        border-bottom: 1px solid var(--line-soft);
    }

        .card-head h5,
        .history-heading h5 {
            margin: 0;
            font-size: 16px;
            font-weight: 600;
        }

    .patient-info-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 20px;
        padding: 20px;
    }

    .info-item {
        min-width: 0;
    }

    .medical-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 14px;
        padding: 20px;
    }

    .medical-section {
        min-width: 0;
        padding: 14px;
        background: #f8f9fa;
        border: 1px solid var(--line-soft);
        border-radius: 6px;
    }

        .medical-section h6 {
            margin: 0 0 10px;
            font-size: 14px;
            font-weight: 600;
        }

        .medical-section ul {
            margin: 0;
            padding-left: 18px;
            font-size: 13px;
            overflow-wrap: anywhere;
        }

        .medical-section li {
            margin-bottom: 6px;
        }

    .empty-info {
        margin: 0;
        padding: 10px 0;
        color: var(--ink-faint);
        font-size: 13px;
    }

    .verify-card.is-abnormal {
        border-left: 4px solid var(--danger);
    }

    .result-layout {
        display: grid;
        grid-template-columns: minmax(200px, 1fr) minmax(0, 2fr);
        gap: 24px;
        padding: 20px;
        align-items: start;
    }

    .result-value {
        font-size: 32px;
        font-weight: 600;
        line-height: 1.2;
        overflow-wrap: anywhere;
    }

    .is-abnormal .result-value {
        color: var(--danger);
    }

    .result-value.is-empty,
    .notes-text.is-empty {
        color: var(--ink-faint);
        font-weight: 400;
    }

    .result-value.is-empty {
        font-size: 18px;
    }

    .notes-text {
        font-size: 14px;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
        max-width: 70ch;
    }

    .reference-range {
        margin-top: 18px;
        padding: 12px;
        background: #f8f9fa;
        border: 1px solid var(--line);
        border-radius: 6px;
    }

        .reference-range strong {
            font-size: 16px;
            overflow-wrap: anywhere;
        }

        .reference-range p {
            margin: 5px 0 0;
            color: var(--ink-soft);
            font-size: 12px;
        }

    .flag {
        flex-shrink: 0;
        padding: 3px 10px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
    }

    .flag-normal {
        background: #eef1f4;
        color: var(--ink-soft);
    }

    .flag-abnormal {
        background: var(--danger-bg);
        color: var(--danger);
    }

    /* Test history table */
    .history-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        padding: 16px 20px;
        border-bottom: 1px solid var(--line-soft);
    }

    .history-count {
        flex-shrink: 0;
        padding: 4px 9px;
        border-radius: 6px;
        background: #f0f5f6;
        color: var(--accent-dark);
        font-size: 12px;
        font-weight: 600;
    }

    .history-table-wrapper {
        padding: 14px 16px 16px;
        overflow-x: auto;
    }

    .history-table {
        width: 100%;
        min-width: 760px;
        border-collapse: separate;
        border-spacing: 0;
        border: 1px solid var(--line);
        border-radius: 7px;
        overflow: hidden;
        font-size: 13px;
    }

        .history-table thead {
            background: #edf5f6;
        }

        .history-table th {
            padding: 12px 14px;
            text-align: left;
            color: #365b63;
            font-size: 12px;
            font-weight: 600;
            white-space: nowrap;
            border-bottom: 1px solid #dce8ea;
        }

        .history-table td {
            padding: 12px 14px;
            border-bottom: 1px solid #edf0f2;
            vertical-align: middle;
        }

        .history-table tbody tr:last-child td {
            border-bottom: none;
        }

        .history-table tbody tr:nth-child(even) {
            background: #fafcfc;
        }

        .history-table tbody tr:hover {
            background: #f3f8f9;
        }

    .history-date {
        min-width: 125px;
        color: var(--ink);
        white-space: nowrap;
    }

        .history-date span {
            display: block;
            margin-top: 2px;
            color: var(--ink-faint);
            font-size: 12px;
        }

    .history-user {
        min-width: 135px;
        font-weight: 500;
    }

    .action-label {
        display: inline-block;
        padding: 4px 9px;
        border-radius: 5px;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
    }

    .action-captured {
        background: #eef1f4;
        color: #475569;
    }

    .action-returned {
        background: var(--warn-bg);
        color: var(--warn);
    }

    .action-resubmitted {
        background: #eaf4f7;
        color: #356f7c;
    }

    .action-verified {
        background: var(--ok-bg);
        color: var(--ok);
    }

    .captured-value {
        min-width: 110px;
        font-weight: 600;
        white-space: nowrap;
    }

    .history-notes {
        min-width: 180px;
        max-width: 320px;
        overflow-wrap: anywhere;
    }

    .no-value {
        color: #9aa4af;
    }

    .history-empty {
        padding: 26px !important;
        text-align: center;
        color: var(--ink-faint);
    }

    .decision-form {
        padding: 20px;
    }

    .form-label {
        margin-bottom: 6px;
        font-size: 13px;
        font-weight: 600;
        color: var(--ink);
    }

    #reviewNotes {
        font-size: 14px;
        resize: vertical;
    }

        #reviewNotes.is-invalid {
            border-color: var(--danger);
        }

    .notes-help {
        margin-top: 6px;
        color: var(--ink-faint);
        font-size: 12px;
    }

        .notes-help.is-error {
            color: var(--danger);
            font-weight: 500;
        }

    .decision-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 20px;
        padding-top: 16px;
        border-top: 1px solid var(--line-soft);
    }

    .decision-card .btn:focus-visible,
    .page-heading .btn:focus-visible,
    #reviewNotes:focus-visible {
        outline: 2px solid var(--accent-dark);
        outline-offset: 2px;
    }

    @@media (max-width: 768px) {
        .verify-page {
            padding: 14px 12px 32px;
        }

        .page-heading {
            flex-direction: column;
        }

        .summary-bar,
        .patient-info-grid,
        .medical-grid,
        .result-layout {
            grid-template-columns: 1fr;
        }

        .summary-item + .summary-item {
            border-left: none;
            border-top: 1px solid var(--line-soft);
        }

        .decision-actions {
            flex-direction: column-reverse;
        }

            .decision-actions .btn {
                width: 100%;
            }
    }
</style>
