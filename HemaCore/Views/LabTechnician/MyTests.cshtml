@model IEnumerable<HemaCore.Models.TestRequestItem>

@{
    ViewData["Title"] = "My Tests";
    Layout = "_LabTechnicianLayout";

    var tests = Model?.ToList() ?? new List<HemaCore.Models.TestRequestItem>();
    var now = DateTime.Now;

    var selectedUrgency = Context.Request.Query["urgency"].ToString();
    var selectedDue = Context.Request.Query["dueStatus"].ToString();

    var filtersActive = !string.IsNullOrWhiteSpace(selectedUrgency)
                        || !string.IsNullOrWhiteSpace(selectedDue);

    string Duration(double minutes)
    {
        minutes = Math.Max(0, minutes);
        var totalMinutes = (int)Math.Floor(minutes);
        var hours = totalMinutes / 60;
        var remainingMinutes = totalMinutes % 60;

        return hours > 0
            ? $"{hours}h {remainingMinutes:D2}m"
            : $"{remainingMinutes} min";
    }

    string DisplayStatus(string? status)
    {
        return status switch
        {
            "InProgress" => "In progress",
            "To Be Reviewed" => "To be reviewed",
            "Completed" => "Completed",
            _ => string.IsNullOrWhiteSpace(status) ? "Unknown" : status
        };
    }
}

<link rel="stylesheet" href="~/css/doctor.css" />

@if (TempData["ResultSuccess"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i>
        @TempData["ResultSuccess"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i>
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="content-card">

    <div class="section-title d-flex align-items-center justify-content-between">

        <div class="d-flex align-items-center">
            <i class="fas fa-vial me-2"></i>

            <span>
                My Tests (@tests.Count)
            </span>
        </div>

      

    </div>

    <form method="get"
          asp-action="MyTests"
          id="filterForm"
          class="search-toolbar">

        <div class="search-box">
            <i class="fas fa-search search-icon"></i>

            <input type="text"
                   id="searchBox"
                   class="search-input"
                   placeholder="Search patient, test or request..."
                   autocomplete="off" />
        </div>

        <div class="filter-box">
            <label for="urgencyFilter" class="filter-label">
                <i class="fas fa-bolt me-1"></i>
            </label>

            <div class="select-wrapper">
                <select id="urgencyFilter"
                        name="urgency"
                        class="filter-select"
                        onchange="this.form.submit()">

                    <option value="">All urgencies</option>

                    <option value="Routine"
                            selected="@(selectedUrgency == "Routine")">
                        Routine
                    </option>

                    <option value="Urgent"
                            selected="@(selectedUrgency == "Urgent")">
                        Urgent
                    </option>

                    <option value="STAT"
                            selected="@(selectedUrgency == "STAT")">
                        STAT
                    </option>
                </select>

                <i class="fas fa-chevron-down dropdown-icon"></i>
            </div>
        </div>

        <div class="filter-box">
            <label for="dueFilter" class="filter-label">
                <i class="fas fa-clock me-1"></i>
            </label>

            <div class="select-wrapper">
                <select id="dueFilter"
                        name="dueStatus"
                        class="filter-select"
                        onchange="this.form.submit()">

                    <option value="">All due times</option>

                    <option value="Nearing"
                            selected="@(selectedDue == "Nearing")">
                        Nearing deadline
                    </option>

                    <option value="Overdue"
                            selected="@(selectedDue == "Overdue")">
                        Overdue
                    </option>
                </select>

                <i class="fas fa-chevron-down dropdown-icon"></i>
            </div>
        </div>

        @if (filtersActive)
        {
            <a asp-action="MyTests"
               class="btn btn-sm btn-outline-secondary">
                <i class="fas fa-rotate-left me-1"></i>
                Clear
            </a>
        }

    </form>

    <table class="modern-table">

        <thead>
            <tr>
                <th>Request</th>
                <th>Patient</th>
                <th>Test Type</th>
                <th>Urgency</th>
                <th>Expected Completion</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody id="testsTable">

            @if (!tests.Any())
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">
                        <i class="fas fa-vial fa-2x mb-2"></i>

                        <div class="fw-semibold">
                            @(filtersActive
                                ? "No tests match your filters."
                                : "There are currently no assigned tests.")
                        </div>

                        <small>
                            @(filtersActive
                                ? "Try clearing the filters."
                                : "Tests you add from Available Tests will appear here.")
                        </small>
                    </td>
                </tr>
            }
            else
            {
                foreach (var test in tests)
                {
                    var isInProgress = test.Status == "InProgress";
                    var isUnderReview = test.Status == "To Be Reviewed";
                    var isCompleted = test.Status == "Completed";

                    DateTime? deadline = null;

                    if (test.StartDateTime.HasValue && test.TestType != null)
                    {
                        deadline = test.StartDateTime.Value.AddHours(
                            test.TestType.TurnAroundTime);
                    }

                    var remaining = deadline.HasValue
                        ? (deadline.Value - now).TotalMinutes
                        : (double?)null;

                    var isOverdue = isInProgress
                        && remaining.HasValue
                        && remaining.Value < 0
                        && !test.CompletionDateTime.HasValue;

                    var isDueSoon = isInProgress
                        && remaining.HasValue
                        && remaining.Value >= 0
                        && remaining.Value <= 60
                        && !test.CompletionDateTime.HasValue;

                    var urgency = test.TestRequest?.Urgency ?? "N/A";

                    // Shown as a tooltip so the row stays one line.
                    var completionTip = test.TestType != null
                        ? $"{test.TestType.TurnAroundTime} h turnaround"
                        : "";

                    <tr class="test-row">

                        <td class="fw-semibold blue-text">
                            #@test.TestRequestId
                        </td>

                        <td>
                            @test.TestRequest?.Patient?.Name
                            @test.TestRequest?.Patient?.Surname
                        </td>

                        <td title="@test.TestType?.Category?.CategoryName">
                            @(test.TestType?.TestTypeName ?? "Not specified")
                        </td>

                        <td>
                            @if (urgency == "STAT")
                            {
                                <span class="badge bg-danger">
                                    <i class="fas fa-bolt me-1"></i>STAT
                                </span>
                            }
                            else if (urgency == "Urgent")
                            {
                                <span class="badge bg-warning text-dark">Urgent</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@urgency</span>
                            }
                        </td>

                        <td title="@completionTip">
                            @if (deadline.HasValue)
                            {
                                @deadline.Value.ToString("dd/MM/yyyy HH:mm")

                                if (isOverdue)
                                {
                                    <div>
                                        <small class="text-danger fw-semibold">
                                            @Duration(Math.Abs(remaining!.Value)) overdue
                                        </small>
                                    </div>
                                }
                                else if (isDueSoon)
                                {
                                    <div>
                                        <small class="text-warning fw-semibold">
                                            @Duration(remaining!.Value) left
                                        </small>
                                    </div>
                                }
                            }
                            else
                            {
                                <span class="text-muted">Not available</span>
                            }
                        </td>

                        <td>
                            @if (isOverdue)
                            {
                                <span class="badge bg-danger">Overdue</span>
                            }
                            else if (isDueSoon)
                            {
                                <span class="badge bg-warning text-dark">Due soon</span>
                            }
                            else if (isInProgress)
                            {
                                <span class="badge bg-primary">In progress</span>
                            }
                            else if (isUnderReview)
                            {
                                <span class="badge bg-warning text-dark">To be reviewed</span>
                            }
                            else if (isCompleted)
                            {
                                <span class="badge bg-success">Completed</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    @DisplayStatus(test.Status)
                                </span>
                            }
                        </td>

                        <td>
                            @if (isInProgress)
                            {
                                <a asp-action="CaptureTestResult"
                                   asp-route-id="@test.TestRequestTestTypeId"
                                   class="btn btn-sm btn-outline-primary"
                                   title="Capture result">
                                    <i class="fas fa-vial me-1"></i>
                                    Capture
                                </a>
                            }
                            else if (isUnderReview)
                            {
                                <a asp-action="ReviewResults"
                                   class="btn btn-sm btn-outline-primary"
                                   title="Review results">
                                    <i class="fas fa-clipboard-check me-1"></i>
                                    Review
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">No action</span>
                            }
                        </td>

                    </tr>
                }

                <tr id="noMatchRow" style="display:none;">
                    <td colspan="7" class="text-center text-muted py-3">
                        No tests match your search.
                    </td>
                </tr>
            }

        </tbody>

    </table>

</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const searchBox = document.getElementById("searchBox");
        const rows = document.querySelectorAll("#testsTable .test-row");
        const noMatchRow = document.getElementById("noMatchRow");

        if (!searchBox) return;

        // Stop Enter from submitting the filter form.
        searchBox.addEventListener("keydown", function(event) {
            if (event.key === "Enter") {
                event.preventDefault();
            }
        });

        // Filter the rows already on the page as you type.
        searchBox.addEventListener("input", function() {
            const term = this.value.trim().toLowerCase();
            let visible = 0;

            rows.forEach(function(row) {
                const match = row.textContent.toLowerCase().includes(term);
                row.style.display = match ? "" : "none";

                if (match) visible++;
            });

            if (noMatchRow) {
                noMatchRow.style.display = visible === 0 ? "" : "none";
            }
        });
    });
</script>