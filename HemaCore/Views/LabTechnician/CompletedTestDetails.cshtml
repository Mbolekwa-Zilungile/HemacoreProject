
@model HemaCore.Models.TestRequestItem

@{
    ViewData["Title"] = "Completed Test Details";
    Layout = "_LabTechnicianLayout";
}

<link rel="stylesheet" href="~/css/doctor.css" />

<div class="completed-details-page">

    <div class="page-header">
        <div>
            <h2>Completed Test Details</h2>
            <p>Review the information and recorded result for this test.</p>
        </div>

        <a asp-action="MyCompletedTests" class="back-button">
            <i class="fas fa-arrow-left"></i>
            Back to Completed Tests
        </a>
    </div>

    <div class="details-card">

        <div class="card-heading">
            <div>
                <h3>Test Information</h3>
                <p>Request #@Model.TestRequestId</p>
            </div>

            @if (Model.Status == "Verified")
            {
                <span class="status-badge verified">Verified</span>
            }
            else
            {
                <span class="status-badge completed">@Model.Status</span>
            }
        </div>

        <div class="details-grid">

            <div class="detail-item">
                <span class="detail-label">Patient Name</span>
                <strong>
                    @(Model.TestRequest?.Patient != null
                        ? $"{Model.TestRequest.Patient.Name} {Model.TestRequest.Patient.Surname}"
                        : "N/A")
                </strong>
            </div>

            <div class="detail-item">
                <span class="detail-label">Test Type</span>
                <strong>@(Model.TestType?.TestTypeName ?? "N/A")</strong>
            </div>

            <div class="detail-item">
                <span class="detail-label">Request Number</span>
                <strong>#@Model.TestRequestId</strong>
            </div>

            <div class="detail-item">
                <span class="detail-label">Completion Date</span>
                <strong>
                    @(Model.CompletionDateTime?.ToString("dd MMM yyyy, HH:mm") ?? "—")
                </strong>
            </div>

        </div>

        <div class="section-divider"></div>

        <div class="result-section">
            <h3>Recorded Result</h3>

            <div class="result-panel">
                <span class="detail-label">Result Value</span>

                <div class="result-value">
                    @(string.IsNullOrWhiteSpace(Model.TestResult?.ResultValue)
                        ? "No result recorded"
                        : Model.TestResult.ResultValue)
                </div>
            </div>

            @if (Model.TestResult != null)
            {
                <div class="details-grid result-meta">

                    <div class="detail-item">
                        <span class="detail-label">Date Captured</span>
                        <strong>
                            @Model.TestResult.DateCaptured.ToString("dd MMM yyyy, HH:mm")
                        </strong>
                    </div>

                    <div class="detail-item">
                        <span class="detail-label">Abnormal Result</span>
                        <strong>
                            @(Model.TestResult.IsAbnormal ? "Yes" : "No")
                        </strong>
                    </div>

                    <div class="detail-item full-width">
                        <span class="detail-label">Result Notes</span>
                        <p>
                            @(string.IsNullOrWhiteSpace(Model.TestResult.Notes)
                                ? "No notes recorded."
                                : Model.TestResult.Notes)
                        </p>
                    </div>

                </div>
            }
        </div>

    </div>

</div>

<style>
    .completed-details-page {
        min-height: 100vh;
        padding: 24px;
        background: #f6f7f9;
        color: #263238;
    }

    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        margin-bottom: 22px;
    }

        .page-header h2 {
            margin: 0 0 6px;
            font-size: 24px;
            font-weight: 600;
        }

        .page-header p {
            margin: 0;
            color: #6b7280;
            font-size: 13px;
        }

    .back-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 9px 12px;
        background: #fff;
        border: 1px solid #d5dce3;
        border-radius: 5px;
        color: #34495e;
        font-size: 12px;
        font-weight: 600;
        text-decoration: none;
        white-space: nowrap;
    }

        .back-button:hover {
            background: #f1f5f9;
            color: #1f2937;
        }

    .details-card {
        padding: 24px;
        background: #fff;
        border: 1px solid #e1e5e9;
        border-radius: 7px;
    }

    .card-heading {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 15px;
        padding-bottom: 20px;
        border-bottom: 1px solid #edf0f2;
    }

        .card-heading h3,
        .result-section h3 {
            margin: 0 0 6px;
            font-size: 16px;
            font-weight: 600;
        }

        .card-heading p {
            margin: 0;
            color: #6b7280;
            font-size: 12px;
        }

    .details-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 24px;
        padding-top: 24px;
    }

    .detail-item {
        display: flex;
        flex-direction: column;
        gap: 7px;
        min-width: 0;
    }

    .detail-label {
        color: #6b7280;
        font-size: 12px;
    }

    .detail-item strong {
        color: #263238;
        font-size: 14px;
        font-weight: 600;
        overflow-wrap: anywhere;
    }

    .section-divider {
        margin: 26px 0;
        border-top: 1px solid #edf0f2;
    }

    .result-section h3 {
        margin-bottom: 16px;
    }

    .result-panel {
        padding: 18px;
        background: #f8f9fa;
        border: 1px solid #e6e9ed;
        border-radius: 6px;
    }

    .result-value {
        margin-top: 8px;
        font-size: 20px;
        font-weight: 600;
        overflow-wrap: anywhere;
    }

    .result-meta {
        padding-top: 22px;
    }

    .full-width {
        grid-column: 1 / -1;
    }

        .full-width p {
            margin: 0;
            color: #374151;
            font-size: 13px;
            line-height: 1.6;
            overflow-wrap: anywhere;
        }

    .status-badge {
        display: inline-block;
        padding: 5px 10px;
        border-radius: 4px;
        font-size: 11px;
        font-weight: 600;
        white-space: nowrap;
    }

        .status-badge.verified {
            background: #e8f3ed;
            color: #287348;
        }

        .status-badge.completed {
            background: #eaf0f7;
            color: #365b82;
        }

    @@media (max-width: 768px) {
        .completed-details-page {
            padding: 14px;
        }

        .page-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .details-card {
            padding: 18px;
        }

        .details-grid {
            grid-template-columns: 1fr;
        }

        .full-width {
            grid-column: auto;
        }
    }
</style>
