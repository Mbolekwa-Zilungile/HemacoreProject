
<!-- ========================================== -->
<!-- CAPTURE RESULT -->
<!-- ========================================== -->

<div class="result-section">

    <div class="result-section-title">
        <i class="fas fa-edit me-2"></i>
        Enter Test Result
    </div>

    <p class="text-muted">
        Enter the result obtained from the laboratory test.
        The system will automatically determine whether the result
        is within the configured normal range.
    </p>


    <form asp-action="SaveTestResult"
          method="post"
          id="resultForm">

        @Html.AntiForgeryToken()

        <input type="hidden"
               name="testRequestTestTypeId"
               value="@Model.TestRequestTestTypeId" />


        <!-- RESULT VALUE -->

        <div class="mb-3">

            <label for="resultValue"
                   class="form-label">

                Result Value
                <span class="text-danger">*</span>

            </label>

            <div class="input-group">

                <input type="number"
                       id="resultValue"
                       name="resultValue"
                       class="form-control"
                       placeholder="Enter numeric result"
                       step="any"
                       min="0"
                       inputmode="decimal"
                       required
                       data-normal-min="@Model.TestType?.NormalRangeMin"
                       data-normal-max="@Model.TestType?.NormalRangeMax" />

                @if (!string.IsNullOrWhiteSpace(
                    Model.TestType?.UnitOfMeasurement))
                {
                    <span class="input-group-text">
                        @Model.TestType.UnitOfMeasurement
                    </span>
                }

            </div>


            <small class="text-muted">
                Enter a numeric value. Decimal values are allowed.
            </small>


            <!-- LIVE ABNORMAL WARNING -->

            <div id="abnormalWarning"
                 class="alert alert-warning mt-3 d-none">

                <i class="fas fa-exclamation-triangle me-2"></i>

                <strong>Be aware:</strong>
                this result is outside the normal range
                and will be marked as abnormal.

            </div>


            <!-- LIVE NORMAL MESSAGE -->

            <div id="normalMessage"
                 class="alert alert-success mt-3 d-none">

                <i class="fas fa-check-circle me-2"></i>

                This result is within the normal range.

            </div>

        </div>



        <!-- NORMAL RANGE REFERENCE -->

        <div class="range-reference mb-4">

            <div class="range-reference-title">

                <i class="fas fa-ruler-horizontal me-2"></i>

                Normal Range

            </div>

            <div class="range-reference-value">

                @Model.TestType?.NormalRangeMin
                -
                @Model.TestType?.NormalRangeMax

                @if (!string.IsNullOrWhiteSpace(
                    Model.TestType?.UnitOfMeasurement))
                {
                    <span>
                        @Model.TestType.UnitOfMeasurement
                    </span>
                }

            </div>

            <small class="text-muted">

                Results outside this range will automatically
                be classified as abnormal.

            </small>

        </div>



        <!-- NOTES -->

        <div class="mb-4">

            <label for="notes"
                   class="form-label">

                Notes
                <span class="text-danger">*</span>

            </label>

            <textarea id="notes"
                      name="notes"
                      class="form-control"
                      rows="4"
                      placeholder="Enter any relevant observations or notes"
                      required></textarea>

            <small class="text-muted">

                Notes are required before the test can be completed.

            </small>

        </div>



        <!-- AUTOMATIC ABNORMAL INFORMATION -->

        <div class="automatic-result-box mb-4">

            <div class="d-flex align-items-start">

                <i class="fas fa-robot me-3 mt-1"></i>

                <div>

                    <strong>
                        Automatic Result Classification
                    </strong>

                    <p class="mb-0 text-muted">

                        The system automatically compares the captured
                        result against the configured normal range.
                        You do not need to manually mark the result
                        as abnormal.

                    </p>

                </div>

            </div>

        </div>



        <!-- ACTIONS -->

        <div class="d-flex justify-content-end gap-2">

            <a asp-action="ProcessTests"
               class="btn btn-secondary">

                <i class="fas fa-arrow-left me-1"></i>

                Back to Tests

            </a>


            <button type="submit"
                    class="btn btn-primary">

                <i class="fas fa-check me-1"></i>

                Complete Test

            </button>

        </div>

    </form>

</div>


<!-- ========================================== -->
<!-- RESULT SUCCESS / ERROR POPUP -->
<!-- ========================================== -->
@if (TempData["ResultSuccess"] != null ||
     TempData["Error"] != null)
{
    <div class="modal fade"
         id="resultMessageModal"
         tabindex="-1"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content border-0 shadow">

                <div class="modal-header
                    @(TempData["ResultSuccess"] != null
                        ? "bg-success text-white"
                        : "bg-danger text-white")">

                    <h5 class="modal-title">

                        <i class="fas
                            @(TempData["ResultSuccess"] != null
                               ? "fa-check-circle"
                               : "fa-exclamation-circle")
                            me-2">
                        </i>

                        @(TempData["ResultSuccess"] != null
                            ? "Success"
                            : "Unable to Save Result")

                    </h5>

                    <button type="button"
                            class="btn-close
                        @(TempData["ResultSuccess"] != null
                            ? "btn-close-white"
                            : "")"
                            data-bs-dismiss="modal">
                    </button>

                </div>


                <div class="modal-body">

                    @if (TempData["ResultSuccess"] != null)
                    {
                        <p class="mb-0">
                            @TempData["ResultSuccess"]
                        </p>
                    }
                    else
                    {
                        <p class="mb-0">
                            @TempData["Error"]
                        </p>
                    }

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-primary"
                            data-bs-dismiss="modal">

                        OK

                    </button>

                </div>

            </div>

        </div>

    </div>
}
