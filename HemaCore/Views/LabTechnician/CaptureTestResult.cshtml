@model HemaCore.Models.TestRequestItem
@using HemaCore.Models

@{
    ViewData["Title"] = "Capture Test Result";
    Layout = "_LabTechnicianLayout";

    var patient = ViewBag.Patient;
    var conditions = ViewBag.PatientConditions as IEnumerable<PatientCondition>;
    var allergies = ViewBag.PatientAllergies as IEnumerable<PatientAllergy>;
    var medications = ViewBag.PatientMedications as IEnumerable<PatientMedication>;

    double? normalMin = Model.TestType?.NormalRangeMin;
    double? normalMax = Model.TestType?.NormalRangeMax;
    var unit = Model.TestType?.UnitOfMeasurement;
}

<style>
    .result-card {
        background: #fff;
        border: 1px solid #e2e9ec;
        border-radius: 14px;
        padding: 28px;
        box-shadow: 0 4px 16px rgba(35, 55, 65, .05);
        margin-bottom: 24px;
    }

    .result-heading {
        display: flex;
        align-items: center;
        gap: 12px;
        color: #294b57;
        font-size: 22px;
        font-weight: 700;
        margin-bottom: 20px;
    }

    .result-heading i,
    .patient-information h5 i,
    .medical-history-item h6 i {
        color: #75AABA;
        margin-right: 5px;
    }

    .patient-information {
        margin-bottom: 28px;
    }

    .patient-information h5 {
        color: #294b57;
        font-weight: 700;
        margin-bottom: 20px;
    }

    .patient-information-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px 24px;
    }

    .patient-information-grid > div {
        display: flex;
        flex-direction: column;
        gap: 5px;
        overflow-wrap: anywhere;
    }

    .patient-information-grid span {
        color: #718087;
        font-size: 12px;
        text-transform: uppercase;
        font-weight: 600;
    }

    .patient-information-grid strong {
        color: #294b57;
        font-size: 14px;
    }

    .clinical-notes {
        background: #fff;
        border: 1px solid #e2e9ec;
        border-radius: 8px;
        padding: 15px;
        margin-top: 22px;
    }

    .clinical-notes p {
        color: #52666e;
        margin: 8px 0 0;
        line-height: 1.6;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
    }

    .medical-history-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 14px;
        margin-top: 20px;
    }

    .medical-history-item {
        background: #fff;
        border: 1px solid #e2e9ec;
        border-radius: 8px;
        padding: 15px;
        overflow-wrap: anywhere;
    }

    .medical-history-item h6 {
        color: #294b57;
        font-size: 14px;
        font-weight: 700;
        margin-bottom: 12px;
    }

    .medical-history-item ul {
        padding-left: 18px;
        margin-bottom: 0;
    }

    .medical-history-item li,
    .medical-history-item p {
        color: #52666e;
        font-size: 13px;
        line-height: 1.6;
    }

    .medical-history-item li {
        padding-bottom: 5px;
    }

    .context-divider {
        border-color: #dfe7ea;
        margin: 28px 0;
    }

    .form-label {
        color: #344e58;
        font-weight: 600;
        margin-bottom: 9px;
    }

    .required {
        color: #dc3545;
    }

    .result-input {
        min-height: 54px;
        border: 1px solid #d8e1e5;
        border-radius: 10px 0 0 10px;
        font-size: 17px;
    }

    .result-input:focus,
    .notes-input:focus {
        border-color: #75AABA;
        box-shadow: 0 0 0 .2rem rgba(117, 170, 186, .18);
    }

    .result-input.is-invalid {
        border-color: #dc3545;
        background-image: none;
    }

    .result-input.is-valid {
        border-color: #198754;
        background-image: none;
    }

    .unit-label {
        background: #f3f7f8;
        border-color: #d8e1e5;
        color: #526c75;
        font-weight: 600;
        border-radius: 0 10px 10px 0;
        padding: 0 18px;
    }

    .result-feedback {
        display: flex;
        align-items: flex-start;
        gap: 9px;
        padding: 12px 14px;
        border-radius: 9px;
        margin-top: 12px;
        font-size: 13px;
        line-height: 1.5;
    }

    .feedback-error {
        background: #fff1f1;
        color: #b02a37;
        border: 1px solid #f3c6ca;
    }

    .feedback-warning {
        background: #fff7e6;
        color: #8a6116;
        border: 1px solid #f0d9a7;
    }

    .feedback-success {
        background: #edf8f1;
        color: #187346;
        border: 1px solid #c8e8d3;
    }

    .range-card {
        background: #fff;
        border: 1px solid #e2e9ec;
        border-radius: 11px;
        padding: 18px 20px;
        margin-top: 22px;
    }

    .range-title {
        color: #536e78;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .5px;
        margin-bottom: 7px;
    }

    .range-value {
        color: #294b57;
        font-size: 22px;
        font-weight: 700;
        overflow-wrap: anywhere;
    }

    .notes-input {
        border: 1px solid #d8e1e5;
        border-radius: 10px;
        resize: vertical;
    }

    .btn-complete {
        background: #477f91;
        border: 1px solid #477f91;
        color: #fff;
        border-radius: 8px;
        padding: 10px 18px;
        font-weight: 600;
    }

    .btn-complete:hover {
        background: #356778;
        border-color: #356778;
        color: #fff;
    }

    .btn-complete:disabled {
        opacity: .6;
        cursor: not-allowed;
    }

    .btn-back {
        border-radius: 8px;
        padding: 10px 18px;
    }

    @@media (max-width: 768px) {
        .medical-history-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 576px) {
        .result-card {
            padding: 18px;
        }

        .patient-information-grid {
            grid-template-columns: 1fr;
        }

        .result-actions {
            flex-direction: column-reverse;
        }

        .result-actions .btn {
            width: 100%;
        }
    }
</style>

<div class="result-card">

    <div class="result-heading">
        <i class="fas fa-edit"></i>
        Capture Test Result
    </div>

    @if (patient != null)
    {
        <section class="patient-information">

            <h5>
                <i class="fas fa-user-circle"></i>
                Patient Information
            </h5>

            <div class="patient-information-grid">
                <div>
                    <span>Patient Name</span>
                    <strong>@patient.Name @patient.Surname</strong>
                </div>

                <div>
                    <span>Patient Number</span>
                    <strong>@patient.PatientID</strong>
                </div>

                <div>
                    <span>Date of Birth</span>
                    <strong>
                        @(patient.DateOfBirth == null
                            ? "Not recorded"
                            : ((DateTime)patient.DateOfBirth).ToString("dd MMM yyyy"))
                    </strong>
                </div>

                <div>
                    <span>Gender</span>
                    <strong>@(patient.Gender ?? "Not recorded")</strong>
                </div>

                <div>
                    <span>ID Number</span>
                    <strong>@(patient.IDNumber ?? "Not recorded")</strong>
                </div>

                <div>
                    <span>Contact Number</span>
                    <strong>@(patient.PhoneNumber ?? "Not recorded")</strong>
                </div>
            </div>

            <hr class="context-divider" />

            <h5>
                <i class="fas fa-file-medical"></i>
                Test Request Information
            </h5>

            <div class="patient-information-grid">
                <div>
                    <span>Request Number</span>
                    <strong>@Model.TestRequestId</strong>
                </div>

                <div>
                    <span>Test Type</span>
                    <strong>
                        @(Model.TestType?.TestTypeName ?? "Not recorded")
                    </strong>
                </div>

                <div>
                    <span>Urgency</span>
                    <strong>
                        @(Model.TestRequest?.Urgency ?? "Not recorded")
                    </strong>
                </div>

                <div>
                    <span>Request Date</span>
                    <strong>
                        @(Model.TestRequest == null
                            ? "Not recorded"
                            : Model.TestRequest.RequestDate.ToString("dd MMM yyyy"))
                    </strong>
                </div>

                <div>
                    <span>Requesting Doctor</span>
                    <strong>
                        @(Model.TestRequest?.Doctor == null
                            ? "Not recorded"
                            : $"{Model.TestRequest.Doctor.Name} {Model.TestRequest.Doctor.Surname}")
                    </strong>
                </div>
            </div>

            <div class="clinical-notes">
                <strong>Doctor's Clinical Notes</strong>
                <p>@(string.IsNullOrWhiteSpace(Model.TestRequest?.ClinicalNotes)
                    ? "No clinical notes recorded."
                    : Model.TestRequest.ClinicalNotes)</p>
            </div>

            <div class="medical-history-grid">

                <div class="medical-history-item">
                    <h6>
                        <i class="fas fa-pills"></i>
                        Medications
                    </h6>

                    @if (medications?.Any() == true)
                    {
                        <ul>
                            @foreach (var item in medications)
                            {
                                <li>
                                    @(item.Medication?.Name
                                        ?? "Medication details unavailable")
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p>No medication details recorded.</p>
                    }
                </div>

                <div class="medical-history-item">
                    <h6>
                        <i class="fas fa-allergies"></i>
                        Allergies
                    </h6>

                    @if (allergies?.Any() == true)
                    {
                        <ul>
                            @foreach (var item in allergies)
                            {
                                <li>
                                    @(item.Allergy?.Name
                                        ?? "Allergy details unavailable")
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p>No allergy details recorded.</p>
                    }
                </div>

                <div class="medical-history-item">
                    <h6>
                        <i class="fas fa-notes-medical"></i>
                        Medical Conditions
                    </h6>

                    @if (conditions?.Any() == true)
                    {
                        <ul>
                            @foreach (var item in conditions)
                            {
                                <li>
                                    @(item.Condition?.Name
                                        ?? "Condition details unavailable")
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p>No medical conditions recorded.</p>
                    }
                </div>

            </div>

        </section>

        <hr class="context-divider" />
    }
    else
    {
        <div class="alert alert-warning">
            Patient information could not be loaded. Please return to the
            test list and reopen the test.
        </div>
    }

    <div class="result-heading">
        <i class="fas fa-vial"></i>
        Laboratory Result
    </div>

    <form asp-action="SaveTestResult"
          asp-controller="LabTechnician"
          method="post"
          id="resultForm">

        @Html.AntiForgeryToken()

        <input type="hidden"
               name="testRequestTestTypeId"
               value="@Model.TestRequestTestTypeId" />

        <div class="mb-4">

            <label for="resultValue" class="form-label">
                Result Value <span class="required">*</span>
            </label>

            <div class="input-group input-group-lg">

                <input type="number"
                       id="resultValue"
                       name="resultValue"
                       class="form-control result-input"
                       placeholder="Enter numeric result"
                       step="any"
                       min="0"
                       inputmode="decimal"
                       autocomplete="off"
                       required
                       data-normal-min="@normalMin"
                       data-normal-max="@normalMax"
                       aria-describedby="resultValidation" />

                @if (!string.IsNullOrWhiteSpace(unit))
                {
                    <span class="input-group-text unit-label">
                        @unit
                    </span>
                }

            </div>

            <div id="resultValidation"
                 class="result-feedback d-none"
                 role="status"
                 aria-live="polite">
            </div>

            <div class="range-card">
                <div class="range-title">
                    <i class="fas fa-ruler-horizontal me-2"></i>
                    Configured Normal Range
                </div>

                <div class="range-value">
                    @if (normalMin.HasValue && normalMax.HasValue)
                    {
                        @normalMin.Value.ToString("0.##")
                        <span> – </span>
                        @normalMax.Value.ToString("0.##")

                        @if (!string.IsNullOrWhiteSpace(unit))
                        {
                            <span>@unit</span>
                        }
                    }
                    else
                    {
                        <span class="text-muted fs-6">
                            Normal range not configured
                        </span>
                    }
                </div>
            </div>

        </div>

        <div class="mb-4">
            <label for="notes" class="form-label">
                Notes <span class="required">*</span>
            </label>

            <textarea id="notes"
                      name="notes"
                      class="form-control notes-input"
                      rows="4"
                      maxlength="2000"
                      placeholder="Enter observations or notes"
                      required></textarea>

            <small class="text-muted">
                Include relevant observations associated with this result.
            </small>
        </div>

        <div class="d-flex justify-content-end gap-2 result-actions">

            <a asp-action="MyTests"
               asp-controller="LabTechnician"
               class="btn btn-outline-secondary btn-back">
                <i class="fas fa-arrow-left me-1"></i>
                Back to My Tests
            </a>

            <button type="submit"
                    id="submitResult"
                    class="btn btn-complete"
                    disabled="@(patient == null)">
                <i class="fas fa-check me-1"></i>
                Complete Test
            </button>

        </div>

    </form>

</div>

@if (TempData["ResultSuccess"] != null ||
     TempData["Error"] != null)
{
    <div class="modal fade"
         id="resultMessageModal"
         tabindex="-1"
         aria-labelledby="resultMessageTitle"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">

                <div class="modal-header @(TempData["ResultSuccess"] != null
                    ? "bg-success text-white"
                    : "bg-danger text-white")">

                    <h5 class="modal-title" id="resultMessageTitle">
                        <i class="fas @(TempData["ResultSuccess"] != null
                            ? "fa-check-circle"
                            : "fa-exclamation-circle") me-2"></i>

                        @(TempData["ResultSuccess"] != null
                            ? "Success"
                            : "Unable to Save Result")
                    </h5>

                    <button type="button"
                            class="btn-close btn-close-white"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>

                </div>

                <div class="modal-body">
                    @if (TempData["ResultSuccess"] != null)
                    {
                        @TempData["ResultSuccess"]
                    }
                    else
                    {
                        @TempData["Error"]
                    }
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-primary"
                            data-bs-dismiss="modal">
                        OK
                    </button>
                </div>

            </div>
        </div>
    </div>
}

<script>
document.addEventListener("DOMContentLoaded", function () {
    const input = document.getElementById("resultValue");
    const notes = document.getElementById("notes");
    const feedback = document.getElementById("resultValidation");
    const form = document.getElementById("resultForm");
    const submitButton = document.getElementById("submitResult");

    function showFeedback(message, type) {
        feedback.className = "result-feedback feedback-" + type;

        const icon = document.createElement("i");
        icon.className = type === "error"
            ? "fas fa-exclamation-circle"
            : type === "warning"
                ? "fas fa-exclamation-triangle"
                : "fas fa-check-circle";

        const text = document.createElement("span");
        text.textContent = message;

        feedback.replaceChildren(icon, text);
    }

    function hideFeedback() {
        feedback.className = "result-feedback d-none";
        feedback.replaceChildren();
    }

    function validateResult() {
        input.classList.remove("is-invalid", "is-valid");
        hideFeedback();

        const rawValue = input.value.trim();

        if (rawValue === "") {
            input.classList.add("is-invalid");
            showFeedback("Please enter a result value.", "error");
            return false;
        }

        const number = Number(rawValue);

        if (!Number.isFinite(number) || number < 0) {
            input.classList.add("is-invalid");
            showFeedback(
                "Enter a valid number greater than or equal to zero.",
                "error"
            );
            return false;
        }

        const minRaw = input.dataset.normalMin;
        const maxRaw = input.dataset.normalMax;
        const min = Number(minRaw);
        const max = Number(maxRaw);

        input.classList.add("is-valid");

        // A missing normal range should not prevent the technician
        // from submitting an otherwise valid numeric result.
        if (minRaw === "" || maxRaw === "" ||
            !Number.isFinite(min) || !Number.isFinite(max) ||
            min > max) {
            showFeedback(
                "Result value is valid, but the configured normal range is unavailable. Please ensure the range is reviewed.",
                "warning"
            );
            return true;
        }

        if (number < min) {
            showFeedback(
                "Below the configured normal range. This result will be flagged as abnormal.",
                "warning"
            );
        } else if (number > max) {
            showFeedback(
                "Above the configured normal range. This result will be flagged as abnormal.",
                "warning"
            );
        } else {
            showFeedback(
                "This value is within the configured normal range.",
                "success"
            );
        }

        return true;
    }

    if (input && notes && feedback && form) {
        input.addEventListener("input", validateResult);

        form.addEventListener("submit", function (event) {
            if (!validateResult()) {
                event.preventDefault();
                input.focus();
                return;
            }

            if (!notes.value.trim()) {
                event.preventDefault();
                notes.setCustomValidity("Please enter notes for the result.");
                notes.reportValidity();
                notes.focus();
                return;
            }

            notes.setCustomValidity("");

            if (!form.checkValidity()) {
                event.preventDefault();
                form.reportValidity();
                return;
            }

            // Prevent accidental double submission.
            if (submitButton) {
                submitButton.disabled = true;
                submitButton.innerHTML =
                    '<i class="fas fa-spinner fa-spin me-1"></i> Saving Result...';
            }
        });

        notes.addEventListener("input", function () {
            notes.setCustomValidity("");
        });
    }

    const modalElement = document.getElementById("resultMessageModal");

    if (modalElement && window.bootstrap) {
        new bootstrap.Modal(modalElement).show();
    }
});
</script>