@model IEnumerable<HemaCore.Models.TestRequest>

@{
    ViewData["Title"] = "Receive Samples";
    Layout = "_LabTechnicianLayout";
}

<link rel="stylesheet" href="~/css/doctor.css" />

<style>

    /* ============================= */
    /* SUCCESS MODAL */
    /* ============================= */

    .success-modal {
        border: none;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 15px 45px rgba(0, 0, 0, 0.20);
    }

    .success-modal-body {
        padding: 40px 35px;
        text-align: center;
    }

    .success-icon {
        width: 78px;
        height: 78px;
        margin: 0 auto 20px;
        border-radius: 50%;
        background: #e5f5ee;
        color: #45a77e;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 36px;
        box-shadow: 0 5px 15px rgba(69, 167, 126, 0.15);
    }

    .success-modal-title {
        color: #294b57;
        font-size: 23px;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .success-modal-message {
        color: #718087;
        font-size: 15px;
        line-height: 1.6;
        margin-bottom: 25px;
    }

    .success-request {
        display: inline-block;
        background: #eef7f9;
        color: #4d8393;
        padding: 7px 14px;
        border-radius: 8px;
        font-weight: 600;
        margin-bottom: 22px;
    }

    .success-continue-btn {
        background: #5f9aaa;
        border: none;
        color: white;
        padding: 11px 28px;
        border-radius: 8px;
        font-weight: 600;
        transition: 0.2s ease;
    }

        .success-continue-btn:hover {
            background: #4f899a;
            color: white;
        }

    .success-modal-subtext {
        font-size: 13px;
        color: #8a999f;
        margin-top: 15px;
        margin-bottom: 0;
    }

</style>

<div class="content-card">

    
    <!-- HEADER -->
    <div class="section-title d-flex align-items-center justify-content-between">

        <div class="d-flex align-items-center">

            <i class="fas fa-vial me-2"></i>

            <span>Receive Patient Samples</span>

            <span class="badge blue-badge ms-2">
                @(Model?.Count() ?? 0)
            </span>

        </div>

    </div>


    <!-- DESCRIPTION -->
    <p class="text-muted mb-3">
        Select a submitted test request to receive its samples.
    </p>


    <!-- TABLE -->
    <div class="table-responsive">

        <table class="modern-table">

            <thead>

                <tr>

                    <th>Request Number</th>
                    <th>Patient</th>
                    <th>Doctor</th>
                    <th>Request Date</th>
                    <th>Urgency</th>
                    <th>Samples</th>
                    <th>Actions</th>

                </tr>

            </thead>


            <tbody>

                @if (!Model.Any())
                {
                    <tr>

                        <td colspan="7"
                            class="text-center text-muted py-4">

                            <i class="fas fa-vial fa-2x mb-2"></i>

                            <div class="fw-semibold">
                                There are currently no submitted test requests waiting for samples.
                            </div>

                            <small>
                                Submitted test requests will appear here when they are available.
                            </small>

                        </td>

                    </tr>
                }
                else
                {
                    @foreach (var request in Model)
                    {
                        <tr>

                            <!-- REQUEST NUMBER -->
                            <td class="fw-semibold blue-text">

                                #@request.TestRequestId

                            </td>


                            <!-- PATIENT -->
                            <td>

                                @request.Patient?.Name
                                @request.Patient?.Surname

                            </td>


                            <!-- DOCTOR -->
                            <td>

                                @request.Doctor?.Name
                                @request.Doctor?.Surname

                            </td>


                            <!-- REQUEST DATE -->
                            <td>

                                @request.RequestDate.ToString("dd/MM/yyyy HH:mm")

                            </td>


                            <!-- URGENCY -->
                            <td>

                                @request.Urgency

                            </td>


                            <!-- SAMPLES -->
                            <td>

                                @request.Samples.Count

                            </td>


                            <!-- ACTION -->
                            <td>

                                <a asp-action="ReceiveSampleDetails"
                                   asp-route-id="@request.TestRequestId"
                                   class="btn btn-sm btn-primary">

                                    <i class="fas fa-vial me-1"></i>

                                    Receive Sample

                                </a>

                            </td>

                        </tr>
                    }
                }

            </tbody>

        </table>

    </div>
   

</div>

<!-- ================================================= -->
<!-- SAMPLE RECEIVED SUCCESS MODAL -->
<!-- ================================================= -->
@if (TempData["SampleReceivedSuccess"] != null)
{
    <div class="modal fade"
         id="sampleReceivedSuccessModal"
         tabindex="-1"
         aria-labelledby="sampleReceivedSuccessModalLabel"
         aria-hidden="true">

        
        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content success-modal">

                <div class="success-modal-body">

                    <!-- SUCCESS ICON -->
                    <div class="success-icon">

                        <i class="fas fa-check"></i>

                    </div>


                    <!-- TITLE -->
                    <div class="success-modal-title"
                         id="sampleReceivedSuccessModalLabel">

                        Sample Received Successfully

                    </div>


                    <!-- REQUEST NUMBER -->
                    @if (TempData["ReceivedRequestId"] != null)
                    {
                        <div class="success-request">

                            <i class="fas fa-vial me-2"></i>

                            Request #@TempData["ReceivedRequestId"]

                        </div>
                    }


                    <!-- MESSAGE -->
                    <div class="success-modal-message">

                        @TempData["SampleReceivedSuccess"]

                    </div>


                    <!-- CONTINUE -->
                    <button type="button"
                            class="btn success-continue-btn"
                            data-bs-dismiss="modal">

                        Continue

                    </button>


                    <p class="success-modal-subtext">

                        The request is now ready for sample processing.

                    </p>

                </div>

            </div>

        </div>

    </div>


    <script>

        document.addEventListener("DOMContentLoaded", function () {

            var successModalElement =
                document.getElementById("sampleReceivedSuccessModal");

            if (successModalElement) {

                var successModal =
                    new bootstrap.Modal(successModalElement);

                successModal.show();

            }

        });

    </script>


}
