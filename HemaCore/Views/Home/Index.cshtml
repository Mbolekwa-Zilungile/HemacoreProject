@{
    Layout = null;
    ViewData["Title"] = "HemaCore";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>HemaCore | Hospital Laboratory System</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <link rel="stylesheet" href="~/css/home-style.css" />
</head>

<body>

    <!-- NAVBAR -->
    <header class="navbar">
        <div class="nav-container">

            <a asp-controller="Home"
               asp-action="Index"
               class="brand">

                <div class="brand-icon">
                    <i class="fa-solid fa-heart-pulse"></i>
                </div>

                <div>
                    <strong>HemaCore</strong>
                    <span>Hospital Laboratory</span>
                </div>

            </a>

            <nav class="nav-links">
                <a href="#home">Home</a>
                <a href="#services">Services</a>
                <a href="#about">About</a>
                <a href="#security">Security</a>
            </nav>

            <div class="nav-actions">
                <a asp-controller="Account"
                   asp-action="Login"
                   class="login-link">
                    Sign In
                </a>

                <a asp-controller="Account"
                   asp-action="Register"
                   class="register-button">
                    Register
                </a>
            </div>

        </div>
    </header>


    <!-- HERO -->
    <main>

        <section class="hero" id="home">

            <div class="hero-background">
                <div class="dot-field"></div>
                <div class="shape shape-one"></div>
                <div class="shape shape-two"></div>
                <div class="shape shape-three"></div>
                <div class="shape shape-four"></div>
            </div>

            <div class="hero-container">

                <div class="hero-badge">
                    <i class="fa-solid fa-shield-halved"></i>
                    NMB HDL
                </div>

                <h1 class="hero-title">HemaCore</h1>

                <p class="hero-subtitle">
                    Next-generation laboratory test request management system
                    for Nelson Mandela Bay Haematology Diagnostic Laboratories
                </p>

                <div class="hero-buttons">

                    <a asp-controller="Account"
                       asp-action="Register"
                       class="primary-button">
                        <i class="fa-solid fa-arrow-right"></i>
                        Get Started
                    </a>

                    <a href="#about" class="outline-button">
                        <i class="fa-solid fa-play"></i>
                        Learn More
                    </a>

                </div>

            </div>

            <a href="#services" class="scroll-indicator">
                <i class="fa-solid fa-chevron-down"></i>
            </a>

        </section>


        <!-- SERVICES -->
        <section class="services section" id="services">

            <div class="container">

                <div class="section-heading">

                    <span>OUR SYSTEM</span>

                    <h2>
                        Everything your laboratory
                        <strong>needs in one place.</strong>
                    </h2>

                    <p>
                        HemaCore brings together the essential tools needed
                        to support efficient laboratory operations.
                    </p>

                </div>


                <div class="service-grid">

                    <article class="service-card">

                        <div class="service-icon blue-bg">
                            <i class="fa-solid fa-file-medical"></i>
                        </div>

                        <span class="service-number">01</span>

                        <h3>Test Requests</h3>

                        <p>
                            Healthcare providers can submit and monitor
                            laboratory test requests digitally.
                        </p>

                    </article>


                    <article class="service-card">

                        <div class="service-icon green-bg">
                            <i class="fa-solid fa-vials"></i>
                        </div>

                        <span class="service-number">02</span>

                        <h3>Sample Management</h3>

                        <p>
                            Laboratory staff can track samples throughout
                            the testing process.
                        </p>

                    </article>


                    <article class="service-card">

                        <div class="service-icon purple-bg">
                            <i class="fa-solid fa-chart-column"></i>
                        </div>

                        <span class="service-number">03</span>

                        <h3>Results</h3>

                        <p>
                            Laboratory results can be recorded, reviewed
                            and securely accessed.
                        </p>

                    </article>


                    <article class="service-card">

                        <div class="service-icon orange-bg">
                            <i class="fa-solid fa-users-gear"></i>
                        </div>

                        <span class="service-number">04</span>

                        <h3>User Management</h3>

                        <p>
                            Different hospital users receive access based
                            on their responsibilities.
                        </p>

                    </article>

                </div>

            </div>

        </section>


        <!-- ABOUT -->
        <section class="about section" id="about">

            <div class="container about-container">

                <div class="about-visual">

                    <div class="hospital-panel">

                        <div class="panel-icon">
                            <i class="fa-solid fa-hospital"></i>
                        </div>

                        <span>HOSPITAL LABORATORY</span>

                        <h3>
                            Connected care.
                            <br />
                            Better workflow.
                        </h3>

                        <div class="panel-line"></div>

                        <div class="panel-points">

                            <div>
                                <i class="fa-solid fa-check"></i>
                                <span>Centralized laboratory workflow</span>
                            </div>

                            <div>
                                <i class="fa-solid fa-check"></i>
                                <span>Clear communication between teams</span>
                            </div>

                            <div>
                                <i class="fa-solid fa-check"></i>
                                <span>Controlled access to information</span>
                            </div>

                        </div>

                    </div>

                </div>


                <div class="about-content">

                    <span class="section-label">ABOUT HEMACORE</span>

                    <h2>
                        Built for the people
                        <strong>behind patient care.</strong>
                    </h2>

                    <p>
                        A modern hospital laboratory depends on accurate
                        information and efficient communication. HemaCore
                        provides a centralized environment where healthcare
                        providers and laboratory teams can manage the
                        laboratory testing workflow.
                    </p>

                    <p>
                        From submitting a test request to processing a
                        sample and recording results, every stage can be
                        managed through the system.
                    </p>

                    <div class="about-checks">

                        <div>
                            <i class="fa-solid fa-circle-check"></i>
                            Simple laboratory workflow
                        </div>

                        <div>
                            <i class="fa-solid fa-circle-check"></i>
                            Secure user authentication
                        </div>

                        <div>
                            <i class="fa-solid fa-circle-check"></i>
                            Role-based access
                        </div>

                        <div>
                            <i class="fa-solid fa-circle-check"></i>
                            Centralized records
                        </div>

                    </div>

                </div>

            </div>

        </section>


        <!-- SECURITY -->
        <section class="security section" id="security">

            <div class="container">

                <div class="security-box">

                    <div class="security-icon">
                        <i class="fa-solid fa-shield-halved"></i>
                    </div>

                    <div class="security-text">

                        <span>SECURITY</span>

                        <h2>
                            Your laboratory information
                            deserves <strong>protection.</strong>
                        </h2>

                        <p>
                            HemaCore uses authentication and role-based
                            access to help ensure that laboratory information
                            is available only to authorized users.
                        </p>

                    </div>

                    <div class="security-list">

                        <div>
                            <i class="fa-solid fa-check"></i>
                            Secure authentication
                        </div>

                        <div>
                            <i class="fa-solid fa-check"></i>
                            Role-based permissions
                        </div>

                        <div>
                            <i class="fa-solid fa-check"></i>
                            Protected records
                        </div>

                    </div>

                </div>

            </div>

        </section>


        <!-- CTA -->
        <section class="cta">

            <div class="container cta-container">

                <div class="cta-icon">
                    <i class="fa-solid fa-heart-pulse"></i>
                </div>

                <div class="cta-text">

                    <span>GET STARTED</span>

                    <h2>
                        Ready to access HemaCore?
                    </h2>

                    <p>
                        Sign in to continue or create an account to get started.
                    </p>

                </div>

                <div class="cta-buttons">

                    <a asp-controller="Account"
                       asp-action="Login"
                       class="primary-button">
                        Sign In
                        <i class="fa-solid fa-arrow-right"></i>
                    </a>

                    <a asp-controller="Account"
                       asp-action="Register"
                       class="outline-button">
                        Register
                    </a>

                </div>

            </div>

        </section>

    </main>


    <!-- FOOTER -->
    <footer>

        <div class="container footer-container">

            <div class="footer-brand">

                <a asp-controller="Home"
                   asp-action="Index"
                   class="brand">

                    <div class="brand-icon">
                        <i class="fa-solid fa-heart-pulse"></i>
                    </div>

                    <div>
                        <strong>HemaCore</strong>
                        <span>Hospital Laboratory</span>
                    </div>

                </a>

                <p>
                    Hospital Laboratory Test Management System
                </p>

            </div>


            <div class="footer-links">

                <a href="#home">Home</a>
                <a href="#services">Services</a>
                <a href="#about">About</a>
                <a href="#security">Security</a>

            </div>

        </div>


        <div class="footer-bottom">

            <div class="container">

                <span>
                    &copy; @DateTime.Now.Year HemaCore. All rights reserved.
                </span>

                <span>
                    Hospital Laboratory Management
                </span>

            </div>

        </div>

    </footer>

</body>
</html>