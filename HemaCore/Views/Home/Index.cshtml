@{
    Layout = null;
    ViewData["Title"] = "Home - HemaCore";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"]</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <link rel="stylesheet" href="~/css/home.css" />
</head>

<body>

    <!-- NAVIGATION -->
    <nav class="navbar navbar-expand-lg public-navbar">
        <div class="container">

            <a class="navbar-brand brand-logo"
               asp-controller="Home"
               asp-action="Index">
                <span class="brand-icon">
                    <i class="fas fa-heartbeat"></i>
                </span>
                Hema<span>Core</span>
            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNavbar"
                    aria-controls="mainNavbar"
                    aria-expanded="false"
                    aria-label="Toggle navigation">
                <i class="fas fa-bars"></i>
            </button>

            <div class="collapse navbar-collapse" id="mainNavbar">

                <ul class="navbar-nav mx-auto">
                    <li class="nav-item">
                        <a class="nav-link active"
                           href="#home">Home</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           href="#services">Services</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           href="#about">About Us</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           href="#contact">Contact</a>
                    </li>
                </ul>

                <div class="nav-buttons">
                    <a class="btn btn-login"
                       asp-controller="Account"
                       asp-action="Login">
                        Login
                    </a>

                    <a class="btn btn-register"
                       asp-controller="Account"
                       asp-action="Register">
                        Get Started
                    </a>
                </div>

            </div>
        </div>
    </nav>


    <!-- HERO SECTION -->
    <section class="hero-section" id="home">
        <div class="container">
            <div class="row align-items-center g-5">

                <div class="col-lg-6">

                    <div class="hero-badge">
                        <i class="fas fa-shield-heart"></i>
                        Healthcare Testing, Made Simpler
                    </div>

                    <h1>
                        Better Testing.
                        <span>Better Care.</span>
                    </h1>

                    <p class="hero-description">
                        Welcome to HemaCore, your digital laboratory
                        management solution. We help streamline test
                        requests, manage laboratory samples and make
                        test results easier to access.
                    </p>

                    <div class="hero-buttons">
                        <a class="btn btn-primary-custom"
                           asp-controller="Account"
                           asp-action="Login">
                            Access Your Portal
                            <i class="fas fa-arrow-right ms-2"></i>
                        </a>

                        <a href="#services"
                           class="btn btn-outline-custom">
                            Explore Services
                        </a>
                    </div>

                    <div class="hero-note">
                        <i class="fas fa-lock"></i>
                        Designed to support secure laboratory workflows
                    </div>

                </div>

                <div class="col-lg-6">

                    <div class="hero-visual">

                        <div class="hero-image-wrapper">
                            <img src="https://images.unsplash.com/photo-1579154204601-01588f351e67?auto=format&fit=crop&w=1100&q=85"
                                 alt="Laboratory professional working with diagnostic samples"
                                 class="hero-image" />
                        </div>

                        <div class="floating-card floating-card-top">
                            <div class="floating-icon">
                                <i class="fas fa-flask"></i>
                            </div>
                            <div>
                                <strong>Laboratory Services</strong>
                                <small>Organised testing workflows</small>
                            </div>
                        </div>

                        <div class="floating-card floating-card-bottom">
                            <div class="floating-icon result-icon">
                                <i class="fas fa-file-medical"></i>
                            </div>
                            <div>
                                <strong>Digital Test Results</strong>
                                <small>Convenient result management</small>
                            </div>
                        </div>

                        <div class="decorative-circle"></div>

                    </div>

                </div>
            </div>
        </div>
    </section>


    <!-- BENEFITS SECTION -->
    <section class="benefits-section">
        <div class="container">

            <div class="row g-4">

                <div class="col-md-4">
                    <div class="benefit-item">
                        <div class="benefit-icon">
                            <i class="fas fa-user-shield"></i>
                        </div>
                        <div>
                            <h5>Secure Information</h5>
                            <p>Support for responsible patient information management.</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="benefit-item">
                        <div class="benefit-icon">
                            <i class="fas fa-microscope"></i>
                        </div>
                        <div>
                            <h5>Efficient Workflows</h5>
                            <p>Keep test requests and laboratory processes organised.</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="benefit-item">
                        <div class="benefit-icon">
                            <i class="fas fa-file-medical-alt"></i>
                        </div>
                        <div>
                            <h5>Result Management</h5>
                            <p>Help authorised users manage laboratory results.</p>
                        </div>
                    </div>
                </div>

            </div>

        </div>
    </section>


    <!-- SERVICES SECTION -->
    <section class="services-section" id="services">
        <div class="container">

            <div class="section-heading text-center">
                <span class="section-label">WHAT WE OFFER</span>

                <h2>Our Laboratory Services</h2>

                <p>
                    A connected approach to managing medical laboratory
                    testing, samples and results.
                </p>
            </div>

            <div class="row g-4 mt-3">

                <div class="col-md-6 col-lg-3">
                    <div class="service-card">
                        <div class="service-icon">
                            <i class="fas fa-vials"></i>
                        </div>

                        <h4>Test Requests</h4>

                        <p>
                            Support the creation and tracking of laboratory
                            test requests from authorised healthcare users.
                        </p>

                        <a asp-controller="Account"
                           asp-action="Login">
                            Access Portal
                            <i class="fas fa-arrow-right"></i>
                        </a>
                    </div>
                </div>

                <div class="col-md-6 col-lg-3">
                    <div class="service-card">
                        <div class="service-icon">
                            <i class="fas fa-tint"></i>
                        </div>

                        <h4>Sample Management</h4>

                        <p>
                            Help laboratory staff organise samples and
                            monitor their progress through the testing process.
                        </p>

                        <a asp-controller="Account"
                           asp-action="Login">
                            Access Portal
                            <i class="fas fa-arrow-right"></i>
                        </a>
                    </div>
                </div>

                <div class="col-md-6 col-lg-3">
                    <div class="service-card">
                        <div class="service-icon">
                            <i class="fas fa-microscope"></i>
                        </div>

                        <h4>Diagnostic Testing</h4>

                        <p>
                            Support laboratory technicians with organised
                            test workflows and result recording.
                        </p>

                        <a asp-controller="Account"
                           asp-action="Login">
                            Access Portal
                            <i class="fas fa-arrow-right"></i>
                        </a>
                    </div>
                </div>

                <div class="col-md-6 col-lg-3">
                    <div class="service-card">
                        <div class="service-icon">
                            <i class="fas fa-clipboard-check"></i>
                        </div>

                        <h4>Results Management</h4>

                        <p>
                            Help authorised staff record, verify and manage
                            laboratory test results.
                        </p>

                        <a asp-controller="Account"
                           asp-action="Login">
                            Access Portal
                            <i class="fas fa-arrow-right"></i>
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </section>


    <!-- ABOUT SECTION -->
    <section class="about-section" id="about">
        <div class="container">

            <div class="row align-items-center g-5">

                <div class="col-lg-6">
                    <div class="about-image-wrapper">

                        <img src="https://images.unsplash.com/photo-1582719471384-894fbb16e074?auto=format&fit=crop&w=1000&q=85"
                             alt="Modern medical laboratory"
                             class="about-image" />

                        <div class="about-caption">
                            <i class="fas fa-heartbeat"></i>
                            <div>
                                <strong>Care Through Technology</strong>
                                <small>Connected laboratory workflows</small>
                            </div>
                        </div>

                    </div>
                </div>

                <div class="col-lg-6">

                    <span class="section-label">ABOUT HEMACORE</span>

                    <h2 class="about-title">
                        Bringing Laboratory Management Into The Digital Age
                    </h2>

                    <p class="about-description">
                        HemaCore is designed to help medical laboratories
                        move away from fragmented manual processes towards
                        a more organised digital environment.
                    </p>

                    <div class="about-feature">
                        <i class="fas fa-check-circle"></i>
                        <span>Organised test request management</span>
                    </div>

                    <div class="about-feature">
                        <i class="fas fa-check-circle"></i>
                        <span>Improved visibility of sample workflows</span>
                    </div>

                    <div class="about-feature">
                        <i class="fas fa-check-circle"></i>
                        <span>Structured laboratory result management</span>
                    </div>

                    <a href="#contact"
                       class="btn btn-primary-custom mt-4">
                        Learn More
                        <i class="fas fa-arrow-right ms-2"></i>
                    </a>

                </div>

            </div>
        </div>
    </section>


    <!-- PROCESS SECTION -->
    <section class="process-section">
        <div class="container">

            <div class="section-heading text-center">
                <span class="section-label">HOW IT WORKS</span>
                <h2>A Simpler Laboratory Workflow</h2>
                <p>Bring essential laboratory activities together in one system.</p>
            </div>

            <div class="row g-4 mt-4">

                <div class="col-md-4">
                    <div class="process-card">
                        <span class="process-number">01</span>
                        <div class="process-icon">
                            <i class="fas fa-file-medical"></i>
                        </div>
                        <h4>Submit a Request</h4>
                        <p>
                            Authorised healthcare professionals initiate
                            laboratory test requests.
                        </p>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="process-card">
                        <span class="process-number">02</span>
                        <div class="process-icon">
                            <i class="fas fa-flask"></i>
                        </div>
                        <h4>Process the Sample</h4>
                        <p>
                            Laboratory personnel manage samples and
                            record the required testing information.
                        </p>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="process-card">
                        <span class="process-number">03</span>
                        <div class="process-icon">
                            <i class="fas fa-clipboard-check"></i>
                        </div>
                        <h4>Manage Results</h4>
                        <p>
                            Results can be recorded and verified before
                            being made available to authorised users.
                        </p>
                    </div>
                </div>

            </div>
        </div>
    </section>


    <!-- CALL TO ACTION -->
    <section class="cta-section" id="contact">
        <div class="container">

            <div class="cta-content">
                <div>
                    <span class="cta-label">WELCOME TO HEMACORE</span>
                    <h2>Ready to Access Your Laboratory Portal?</h2>
                    <p>
                        Sign in to access the features available for your role.
                    </p>
                </div>

                <a class="btn cta-button"
                   asp-controller="Account"
                   asp-action="Login">
                    Login to HemaCore
                    <i class="fas fa-arrow-right ms-2"></i>
                </a>
            </div>

        </div>
    </section>


    <!-- FOOTER -->
    <footer class="public-footer">
        <div class="container">

            <div class="row g-4">

                <div class="col-lg-5">
                    <a class="navbar-brand brand-logo footer-logo"
                       asp-controller="Home"
                       asp-action="Index">
                        <span class="brand-icon">
                            <i class="fas fa-heartbeat"></i>
                        </span>
                        Hema<span>Core</span>
                    </a>

                    <p class="footer-description">
                        Supporting more organised medical laboratory
                        workflows through digital technology.
                    </p>
                </div>

                <div class="col-6 col-lg-3">
                    <h5>Quick Links</h5>
                    <a href="#home">Home</a>
                    <a href="#services">Services</a>
                    <a href="#about">About Us</a>
                    <a href="#contact">Contact</a>
                </div>

                <div class="col-6 col-lg-4">
                    <h5>Portal Access</h5>
                    <a asp-controller="Account"
                       asp-action="Login">
                        <i class="fas fa-sign-in-alt me-2"></i>
                        Login
                    </a>

                    <a asp-controller="Account"
                       asp-action="Register">
                        <i class="fas fa-user-plus me-2"></i>
                        Register
                    </a>
                </div>

            </div>

            <div class="footer-bottom">
                <p>
                    &copy; @DateTime.Now.Year HemaCore.
                    All rights reserved.
                </p>

                <span>Laboratory Management System</span>
            </div>

        </div>
    </footer>


    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
