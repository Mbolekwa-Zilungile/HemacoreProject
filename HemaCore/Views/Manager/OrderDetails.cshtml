@model HemaCore.Models.Order
@using HemaCore.Models.Enums

@{
    ViewData["Title"] = "Order Details";
    Layout = "_ManagerLayout";
}

<link rel="stylesheet" href="~/css/doctor.css" />

<div class="container mt-4">

    <div class="card shadow-sm p-4">

        <!-- HEADER -->
        <div class="mb-3">
            <h3 class="fw-bold">
                Order #@Model.OrderNumber
            </h3>

            <p class="text-muted mb-1">
                Supplier:
                <b>@Model.Supplier?.SupplierName</b>
            </p>

            <p class="text-muted mb-1">
                Date:
                @Model.OrderDate.ToString("yyyy-MM-dd")
            </p>

            <p class="text-muted">
                Status:
                @if (Model.Status.ToString() == "Ordered")
                {
                    <span class="badge bg-warning">Ordered</span>
                }
                else if (Model.Status.ToString() == "Completed")
                {
                    <span class="badge bg-success">Completed</span>
                }
                else if (Model.Status.ToString() == "Cancelled")
                {
                    <span class="badge bg-danger">Cancelled</span>
                }
                else
                {
                    <span class="badge bg-info">@Model.Status</span>
                }
            </p>

            @if (!string.IsNullOrEmpty(Model.CancelReason))
            {
                <p class="text-danger small mt-2">
                    <strong>Cancel Reason:</strong> @Model.CancelReason
                </p>
            }
        </div>

        <hr />

        <!-- ORDER ITEMS -->
        <h5 class="mb-3 text-secondary">
            Order Items
        </h5>

        @if (Model.OrderItems != null && Model.OrderItems.Any())
        {
            @foreach (var item in Model.OrderItems)
            {
                var status = item.Status.ToString();

                var badge =
                status == "Pending" ? "bg-warning" :
                status == "Received" ? "bg-success" :
                "bg-danger";

                <div class="card mb-2 p-2" style="font-size:0.85rem;">

                    <div class="d-flex justify-content-between align-items-center">

                        <!-- LEFT -->
                        <div>
                            <strong>
                                @item.Consumable?.ConsumableName
                            </strong>

                            <div class="text-muted small">
                                Qty: @item.Quantity
                            </div>

                            <div class="text-muted small">
                                Received: @(item.DateReceived?.ToString("yyyy-MM-dd") ?? "-")
                                | Cancelled: @(item.DateRejected?.ToString("yyyy-MM-dd") ?? "-")
                            </div>

                            @if (!string.IsNullOrEmpty(item.RejectReason))
                            {
                                <div class="text-danger small mt-1">
                                    @item.RejectReason
                                </div>
                            }

                            <span class="badge @badge mt-1">
                                @status
                            </span>
                        </div>

                        <!-- RIGHT -->
                        <div class="text-end">

                            @if (status == "Pending")
                            {
                                <!-- RECEIVE -->
                                <form method="post"
                                      asp-action="ReceiveItem"
                                      asp-controller="Manager"
                                      style="display:inline;">

                                    <input type="hidden" name="orderId" value="@Model.OrderId" />
                                    <input type="hidden" name="orderItemId" value="@item.OrderItemId" />

                                    <button type="submit" class="btn btn-sm btn-success">
                                        Receive
                                    </button>
                                </form>

                                <!-- REJECT -->
                                <form method="post"
                                      asp-action="RejectItem"
                                      asp-controller="Manager"
                                      style="display:inline-block; margin-left:5px;">

                                    <input type="hidden" name="orderId" value="@Model.OrderId" />
                                    <input type="hidden" name="orderItemId" value="@item.OrderItemId" />

                                    <input type="text"
                                           name="reason"
                                           class="form-control form-control-sm d-inline-block"
                                           style="width:120px;"
                                           placeholder="Reason..."
                                           required />

                                    <button type="submit" class="btn btn-sm btn-danger">
                                        Cancel
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="text-muted small">
                                    No actions available
                                </span>
                            }

                        </div>

                    </div>
                </div>
            }
        }
        else
        {
            <p class="text-muted">
                No items found.
            </p>
        }

        <!-- BACK -->
        <div class="mt-3">
            <a asp-action="Orders" class="btn btn-outline-secondary">
                ← Back
            </a>
        </div>

    </div>
</div>