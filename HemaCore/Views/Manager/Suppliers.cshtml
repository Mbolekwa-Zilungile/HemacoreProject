@model List<HemaCore.Models.Supplier>

@{
    Layout = "_ManagerLayout";
}

<link rel="stylesheet" href="~/css/doctor.css" />
<link rel="stylesheet" href="~/css/delete.css" />


<!-- =========================================================
     ALERT MESSAGES
     ========================================================= -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}


<!-- =========================================================
     MAIN CONTENT
     ========================================================= -->

<div class="content-card">


    <!-- =====================================================
         HEADER
         ===================================================== -->

    <div class="section-title d-flex align-items-center justify-content-between">

        <div class="d-flex align-items-center">

            <i class="fas fa-industry me-2"></i>

            <span>
                Active Suppliers (@(Model?.Count ?? 0))
            </span>

        </div>


        <!-- ADD SUPPLIER -->

        <a asp-action="AddSupplier"
           class="btn btn-primary-custom btn-sm">

            + Add Supplier

        </a>

    </div>



    <div class="search-toolbar">

        <div class="search-box">
            <i class="fas fa-search search-icon"></i>

            <input type="text"
                   id="searchBox"
                   class="search-input"
                   placeholder="Search..."
                   autocomplete="off" />
        </div>

 
           
        <div class="filter-box">
            <label for="statusFilter" class="filter-label">
                <i class="fas fa-filter me-1"></i>
            </label>

            <div class="select-wrapper">
                <select id="statusFilter"
                        class="filter-select"
                        onchange="if (this.value) window.location.href = this.value;">

                    <option value="@Url.Action("Suppliers", "Manager")"
                            selected="@(ViewContext.RouteData.Values["action"]?.ToString() == "Suppliers")">
                        Active Suppliers
                    </option>

                    <option value="@Url.Action("InactiveSuppliers", "Manager")"
                            selected="@(ViewContext.RouteData.Values["action"]?.ToString() == "InactiveSuppliers")">
                        Inactive Suppliers
                    </option>

                </select>

                <i class="fas fa-chevron-down dropdown-icon"></i>
            </div>
        </div>

    </div>


    <!-- =====================================================
         TABLE
         ===================================================== -->

    <div class="card shadow-sm">

        <div class="card-body p-0">

            <table class="modern-table">

                <thead>

                    <tr>

                        <th>
                            Name
                        </th>

                        <th>
                            Contact Person
                        </th>

                        <th>
                            Email
                        </th>

                        <th>
                            Consumables
                        </th>

                        <th>
                            Status
                        </th>
                        <th>
                            Actions
                        </th>

                    </tr>

                </thead>


                <tbody id="supplierTable">

                    @if (Model == null || !Model.Any())
                    {
                        <tr>

                            <td colspan="5"
                                class="text-center text-muted py-3">

                                No suppliers available.

                            </td>

                        </tr>
                    }
                    else
                    {
                        foreach (var supplier in Model)
                        {
                            int total = 0;

                            if (ViewBag.SupplierConsumableCount != null &&
                                ViewBag.SupplierConsumableCount.ContainsKey(
                                    supplier.SupplierId))
                            {
                                total =
                                    ViewBag.SupplierConsumableCount[
                                        supplier.SupplierId];
                            }


                            <tr>

                                <!-- NAME -->

                                <td class="fw-semibold blue-text">

                                    @supplier.SupplierName

                                </td>


                                <!-- CONTACT -->

                                <td>

                                    @supplier.ContactPerson

                                </td>


                                <!-- EMAIL -->

                                <td>

                                    @supplier.Email

                                </td>


                                <!-- CONSUMABLE COUNT -->

                                <td>

                                    @total

                                </td>
                                <td>
                                    @if (supplier.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactive</span>
                                    }
                                </td>

                                <td>

                                    <a asp-action="SupplierDetails"
                                       asp-route-id="@supplier.SupplierId"
                                       class="btn btn-sm btn-outline-info me-1">

                                        <i class="fas fa-eye me-1"></i>
                                    </a>
                                    <a asp-action="EditSupplier"
                                       asp-route-id="@supplier.SupplierId"
                               class="btn btn-sm btn-outline-primary me-1">

                                <i class="fas fa-edit me-1"></i>

                            </a>


                                    <!-- DEACTIVATE -->

                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger deactivate-supplier-btn"
                                            data-id="@supplier.SupplierId"
                                            data-name="@supplier.SupplierName">

                                        <i class="fas fa-ban"></i>

                                    </button>

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>



<!-- =========================================================
     DEACTIVATE MODAL
     ========================================================= -->

<div id="deleteModal"
     class="delete-overlay"
     role="dialog"
     aria-modal="true"
     aria-labelledby="deleteModalTitle">

    <div class="delete-box">


        <!-- ICON -->

        <div class="delete-icon">

            <i class="fas fa-exclamation-triangle"></i>

        </div>


        <!-- TITLE -->

        <h3 id="deleteModalTitle">

            Are you sure?

        </h3>


        <!-- MESSAGE -->

        <p>

            Are you sure you want to deactivate

            <strong id="deleteSupplierName"></strong>?

        </p>


        <!-- WARNING -->

        <span class="delete-warning">

            <i class="fas fa-info-circle"></i>

            This supplier will no longer be active.

        </span>


        <!-- BUTTONS -->

        <div class="delete-buttons">


            <!-- CANCEL -->

            <button type="button"
                    id="cancelDeleteBtn"
                    class="cancel-btn">

                Cancel

            </button>


            <!-- DELETE FORM -->

            <form asp-action="DeleteSupplier"
                  method="post"
                  id="deleteForm">

                @Html.AntiForgeryToken()


                <input type="hidden"
                       name="id"
                       id="deleteSupplierId" />


                <button type="submit"
                        id="confirmDeleteBtn"
                        class="confirm-delete-btn">

                    <i class="fas fa-ban me-1"></i>

                    Yes, Deactivate

                </button>

            </form>

        </div>

    </div>

</div>




<script>
    document.addEventListener("DOMContentLoaded", function () {

        const modal = document.getElementById("deleteModal");
        const supplierIdInput = document.getElementById("deleteSupplierId");
        const supplierName = document.getElementById("deleteSupplierName");
        const cancelButton = document.getElementById("cancelDeleteBtn");
        const deleteForm = document.getElementById("deleteForm");
        const searchBox = document.getElementById("searchBox");
        const supplierTable = document.getElementById("supplierTable");

        // Generate URLs from MVC routing.
        const searchUrl = '@Url.Action("SearchSupplierLive", "Manager")';
        const detailsUrl = '@Url.Action("SupplierDetails", "Manager")';
        const editUrl = '@Url.Action("EditSupplier", "Manager")';

        // Escape text before inserting it into HTML.
        function escapeHtml(value) {
            const div = document.createElement("div");
            div.textContent = value ?? "";
            return div.innerHTML;
        }

        // Open deactivate modal.
        document.addEventListener("click", function (event) {
            const button = event.target.closest(".deactivate-supplier-btn");

            if (!button) return;

            supplierIdInput.value = button.dataset.id;
            supplierName.textContent = button.dataset.name || "";

            modal.classList.add("show");
            document.body.classList.add("modal-open");
        });

        // Close modal.
        function closeModal() {
            modal.classList.remove("show");
            document.body.classList.remove("modal-open");
            supplierIdInput.value = "";
            supplierName.textContent = "";
        }

        cancelButton.addEventListener("click", closeModal);

        modal.addEventListener("click", function (event) {
            if (event.target === modal) {
                closeModal();
            }
        });

        document.addEventListener("keydown", function (event) {
            if (event.key === "Escape" && modal.classList.contains("show")) {
                closeModal();
            }
        });

        // Prevent double submission.
        deleteForm.addEventListener("submit", function () {
            const button = document.getElementById("confirmDeleteBtn");

            button.disabled = true;
            button.innerHTML =
                '<i class="fas fa-spinner fa-spin me-1"></i> Deactivating...';
        });

        // Live search.
        let searchController = null;

        searchBox.addEventListener("input", async function () {
            const term = this.value.trim();

            // Cancel the previous request if the user types again.
            if (searchController) {
                searchController.abort();
            }

            searchController = new AbortController();

            supplierTable.innerHTML = `
                <tr>
                    <td colspan="6" class="text-center text-muted py-3">
                        Searching...
                    </td>
                </tr>`;

            try {
                const response = await fetch(
                    searchUrl + "?term=" + encodeURIComponent(term),
                    { signal: searchController.signal }
                );

                if (!response.ok) {
                    throw new Error("Search request failed.");
                }

                const data = await response.json();

                if (!data || data.length === 0) {
                    supplierTable.innerHTML = `
                        <tr>
                            <td colspan="6" class="text-center text-muted py-3">
                                No suppliers found.
                            </td>
                        </tr>`;
                    return;
                }

                supplierTable.innerHTML = data.map(function (item) {
                    const id = item.supplierId;
                    const name = escapeHtml(item.name);
                    const contact = escapeHtml(item.contactPerson);
                    const email = escapeHtml(item.email);
                    const total = Number(item.totalConsumables) || 0;

                    // Use MVC-generated URLs rather than hardcoded paths.
                    const detailsLink =
                        detailsUrl + "?id=" + encodeURIComponent(id);

                    const editLink =
                        editUrl + "?id=" + encodeURIComponent(id);

                    return `
                        <tr>
                            <td class="fw-semibold blue-text">${name}</td>

                            <td>${contact}</td>

                            <td>${email}</td>

                            <td>${total}</td>

                            <td>
                                <span class="badge bg-success">Active</span>
                            </td>

                            <td>
                                <a href="${detailsLink}"
                                   class="btn btn-sm btn-outline-info me-1"
                                   title="View supplier">
                                    <i class="fas fa-eye"></i>
                                </a>

                                <a href="${editLink}"
                                   class="btn btn-sm btn-outline-primary me-1"
                                   title="Edit supplier">
                                    <i class="fas fa-edit"></i>
                                </a>

                                <button type="button"
                                        class="btn btn-sm btn-outline-danger deactivate-supplier-btn"
                                        data-id="${escapeHtml(id)}"
                                        data-name="${name}"
                                        title="Deactivate supplier">
                                    <i class="fas fa-ban"></i>
                                </button>
                            </td>
                        </tr>`;
                }).join("");

            } catch (error) {
                if (error.name === "AbortError") return;

                console.error("Supplier search failed:", error);

                supplierTable.innerHTML = `
                    <tr>
                        <td colspan="6" class="text-center text-danger py-3">
                            Search failed. Please try again.
                        </td>
                    </tr>`;
            }
        });
    });
</script>
