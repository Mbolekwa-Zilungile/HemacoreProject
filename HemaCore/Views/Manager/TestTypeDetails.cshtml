@model HemaCore.Models.TestType

@{
    ViewData["Title"] = "Test Type Details";
    Layout = "_ManagerLayout";
}

<link rel="stylesheet" href="~/css/doctor.css" />

<div class="content-card">

    <!-- PAGE HEADER -->
    <div class="section-title d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center">
            <i class="fas fa-microscope me-2"></i>
            <span>Test Type Details</span>
        </div>

        <a asp-action="EditTestType"
           asp-controller="Manager"
           asp-route-id="@Model.TestTypeId"
           class="btn btn-primary-custom btn-sm">
            <i class="fas fa-edit me-1"></i>
            Edit Test Type
        </a>
    </div>

    <!-- TEST TYPE INFORMATION -->
    <div class="card shadow-sm mb-4">

        <div class="card-header">
            <h5 class="mb-0">
                <i class="fas fa-info-circle me-2"></i>
                Test Type Information
            </h5>
        </div>

        <div class="card-body">
            <div class="row">

                <div class="col-md-6 mb-3">
                    <label class="text-muted">Test Type Name</label>
                    <div class="fw-semibold">
                        @Model.TestTypeName
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="text-muted">Category</label>
                    <div class="fw-semibold">
                        @(Model.Category?.CategoryName ?? "Not assigned")
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="text-muted">Sample Type</label>
                    <div class="fw-semibold">
                        @(Model.SampleType?.SampleName ?? "Not assigned")
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="text-muted">Status</label>
                    <div>
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Inactive</span>
                        }
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="text-muted">Normal Range Minimum</label>
                    <div class="fw-semibold">
                        @Model.NormalRangeMin
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="text-muted">Normal Range Maximum</label>
                    <div class="fw-semibold">
                        @Model.NormalRangeMax
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="text-muted">Unit of Measurement</label>
                    <div class="fw-semibold">
                        @(string.IsNullOrWhiteSpace(Model.UnitOfMeasurement)
                            ? "Not specified"
                            : Model.UnitOfMeasurement)
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="text-muted">Turnaround Time</label>
                    <div>
                        <span class="badge bg-info text-dark">
                            <i class="fas fa-clock me-1"></i>
                            @Model.TurnAroundTime minutes
                        </span>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- ASSIGNED LAB TECHNICIANS -->
    <div class="card shadow-sm mb-4">

        <div class="card-header">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <i class="fas fa-user-cog me-2"></i>
                    Assigned Lab Technicians
                </h5>

                <span class="badge bg-primary">
                    @(Model.TechnicianTestType?.Count ?? 0)
                </span>
            </div>
        </div>

        <div class="card-body">

            @if (Model.TechnicianTestType != null &&
                 Model.TechnicianTestType.Any())
            {
                <div class="table-responsive">
                    <table class="modern-table">
                        <thead>
                            <tr>
                                <th>Technician Name</th>
                                <th>Employee Number</th>
                                <th>ID Number</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var assignment in Model.TechnicianTestType)
                            {
                                var technician = assignment.LabTechnician;

                                if (technician != null)
                                {
                                    <tr>
                                        <td class="fw-semibold blue-text">
                                            @($"{technician.Surname} {technician.Name}".ToUpper())
                                        </td>

                                        <td>
                                            @(technician.EmployeeNumber ?? "Not available")
                                        </td>

                                        <td>
                                            @(technician.IDNumber ?? "Not available")
                                        </td>

                                        <td>
                                            @if (technician.IsActive)
                                            {
                                                <span class="badge bg-success">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">Inactive</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info mb-0">
                    <i class="fas fa-info-circle me-2"></i>
                    No lab technicians have been assigned to this test type.
                </div>
            }

        </div>
    </div>

    <!-- REQUIRED CONSUMABLES -->
    <div class="card shadow-sm mb-4">

        <div class="card-header">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <i class="fas fa-boxes-stacked me-2"></i>
                    Required Consumables
                </h5>

                <span class="badge bg-primary">
                    @(Model.TestTypeConsumables?.Count ?? 0)
                </span>
            </div>
        </div>

        <div class="card-body">

            @if (Model.TestTypeConsumables != null &&
                 Model.TestTypeConsumables.Any())
            {
                <div class="table-responsive">
                    <table class="modern-table">
                        <thead>
                            <tr>
                                <th>Consumable Name</th>
                                <th>Quantity in Hand</th>
                                <th>Reorder Level</th>
                                <th>Stock Status</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var assignment in Model.TestTypeConsumables)
                            {
                                var consumable = assignment.Consumable;

                                if (consumable != null)
                                {
                                    <tr>
                                        <td class="fw-semibold">
                                            @(consumable.ConsumableName ?? "Unnamed consumable")
                                        </td>

                                        <td>
                                            @consumable.QuantityInHand
                                        </td>

                                        <td>
                                            @consumable.ReorderLevel
                                        </td>

                                        <td>
                                            @if (consumable.QuantityInHand <= 0)
                                            {
                                                <span class="badge bg-danger">Out of Stock</span>
                                            }
                                            else if (consumable.QuantityInHand <= consumable.ReorderLevel)
                                            {
                                                <span class="badge bg-warning text-dark">Low Stock</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">In Stock</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info mb-0">
                    <i class="fas fa-info-circle me-2"></i>
                    No consumables have been assigned to this test type.
                </div>
            }

        </div>
    </div>

    <!-- BOTTOM BUTTONS -->
    <div class="d-flex justify-content-between mt-4">

        <a asp-action="TestTypes"
           asp-controller="Manager"
           class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>
            Back to Test Types
        </a>

        <a asp-action="EditTestType"
           asp-controller="Manager"
           asp-route-id="@Model.TestTypeId"
           class="btn btn-primary-custom">
            <i class="fas fa-edit me-1"></i>
            Edit Test Type
        </a>

    </div>

</div>
