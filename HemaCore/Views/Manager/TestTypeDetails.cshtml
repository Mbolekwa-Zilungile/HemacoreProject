
@model HemaCore.ViewModels.ManagerVM.ManagerProfileVM

@{
    ViewData["Title"] = "Manager Details";
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
}

<link rel="stylesheet" href="~/css/doctor.css" />

<div class="container mt-4 mb-5">

    <div class="card shadow-sm border-0 p-4">

        <!-- PAGE HEADER -->
        <div class="d-flex justify-content-between align-items-start mb-4">
            <div>
                <h3 class="fw-bold mb-2">Manager Details</h3>
                <p class="text-muted mb-0">
                    View your manager account information.
                </p>
            </div>

            <span class="badge bg-success px-3 py-2">
                Manager
            </span>
        </div>

        <hr class="text-muted opacity-25 mb-4" />

        <!-- MANAGER INFORMATION -->
        <div class="mb-4">

            <h5 class="fw-bold text-secondary mb-3">
                <i class="fas fa-user-tie me-2"></i>
                General Information
            </h5>

            <div class="row">

                <div class="col-md-6 mb-3">
                    <label class="form-label text-muted">Full Name</label>
                    <div class="form-control bg-light">
                        @(string.IsNullOrWhiteSpace(Model.FullName)
                            ? "Not provided"
                            : Model.FullName)
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label text-muted">Email Address</label>
                    <div class="form-control bg-light">
                        @(string.IsNullOrWhiteSpace(Model.Email)
                            ? "Not provided"
                            : Model.Email)
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label text-muted">Phone Number</label>
                    <div class="form-control bg-light">
                        @(string.IsNullOrWhiteSpace(Model.PhoneNumber)
                            ? "Not provided"
                            : Model.PhoneNumber)
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label text-muted">Account Role</label>
                    <div class="form-control bg-light">
                        Manager
                    </div>
                </div>

            </div>
        </div>

        <!-- ACTION BUTTONS -->
        <hr class="text-muted opacity-25 mt-4 mb-3" />

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-2">

            <a asp-controller="Manager"
               asp-action="Index"
               class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i>
                Back to Dashboard
            </a>

            <a asp-controller="Manager"
               asp-action="ManagerProfile"
               class="btn btn-primary-custom">
                <i class="fas fa-edit me-1"></i>
                Manage Profile
            </a>

        </div>

    </div>

</div>
