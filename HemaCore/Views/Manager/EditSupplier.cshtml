@model HemaCore.Models.Supplier

@{
    ViewData["Title"] = "Edit Supplier";
    Layout = "_ManagerLayout";
}

<link rel="stylesheet" href="~/css/doctor.css" />
<div class="container mt-4">
    <div class="card shadow-sm p-4">

        <!-- HEADER -->
        <div class="mb-4">

            <h3 class="fw-bold">
                Edit Supplier
            </h3>

            <p class="text-muted">
                Update the supplier information below.
            </p>

        </div>


        <!-- FORM -->
        <form asp-action="EditSupplier"
              method="post">

            @Html.AntiForgeryToken()

            <!-- SUPPLIER ID -->
            <input asp-for="SupplierId"
                   type="hidden" />


            <!-- VALIDATION -->
            <div asp-validation-summary="All"
                 class="text-danger">
            </div>


            <!-- SUPPLIER INFORMATION -->
            <h5 class="mb-3 text-secondary">
                Supplier Information
            </h5>


            <div class="row">

                <!-- SUPPLIER NAME -->
                <div class="col-md-6 mb-3">

                    <label asp-for="SupplierName"
                           class="form-label">
                    </label>

                    <input asp-for="SupplierName"
                           class="form-control"
                           placeholder="Supplier name" />

                    <span asp-validation-for="SupplierName"
                          class="text-danger small">
                    </span>

                </div>


                <!-- CONTACT PERSON -->
                <div class="col-md-6 mb-3">

                    <label asp-for="ContactPerson"
                           class="form-label">
                    </label>

                    <input asp-for="ContactPerson"
                           class="form-control"
                           placeholder="Contact person" />

                    <span asp-validation-for="ContactPerson"
                          class="text-danger small">
                    </span>

                </div>

            </div>


            <!-- EMAIL -->
            <div class="row">

                <div class="col-md-12 mb-3">

                    <label asp-for="Email"
                           class="form-label">
                    </label>

                    <input asp-for="Email"
                           type="email"
                           class="form-control"
                           placeholder="Enter email address" />

                    <span asp-validation-for="Email"
                          class="text-danger small">
                    </span>

                </div>

            </div>


            <!-- BUTTONS -->
            <div class="d-flex justify-content-between mt-4">

                <a asp-action="Suppliers"
                   class="btn btn-outline-secondary">

                    ← Back

                </a>


                <button type="submit"
                        class="btn btn-primary-custom btn-sm">

                    <i class="fas fa-save me-1"></i>

                    Save Changes

                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />


}