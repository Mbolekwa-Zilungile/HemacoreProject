@model HemaCore.ViewModels.ManagerVM.AddDoctorViewModel

@{
    ViewData["Title"] = "Add Doctor";
    Layout = "_ManagerLayout";
}

<link rel="stylesheet" href="~/css/doctor.css" />

<div class="container mt-4">

    <div class="card shadow-sm p-4">

        <div class="mb-4">

            <h3 class="fw-bold">
                Add New Doctor
            </h3>

            <p class="text-muted">
                Fill in the details below to register a doctor in the system.
            </p>

        </div>


        <form asp-action="AddDoctor" method="post">

            @Html.AntiForgeryToken()


            <!-- Validation -->

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>


            <!-- ================================= -->
            <!-- ACCOUNT INFORMATION -->
            <!-- ================================= -->

            <h5 class="mb-3 text-secondary">
                Account Information
            </h5>

            <div class="row">

                <!-- EMAIL -->

                <div class="col-md-6 mb-3">

                    <label asp-for="Email"
                           class="form-label">
                    </label>

                    <input asp-for="Email"
                           class="form-control"
                           placeholder="Enter email address" />

                    <span asp-validation-for="Email"
                          class="text-danger small">
                    </span>

                </div>


                <!-- PHONE -->

                <div class="col-md-6 mb-3">

                    <label asp-for="PhoneNumber"
                           class="form-label">
                    </label>

                    <input asp-for="PhoneNumber"
                           class="form-control"
                           placeholder="Enter phone number" />

                    <span asp-validation-for="PhoneNumber"
                          class="text-danger small">
                    </span>

                </div>

            </div>


            <!-- ================================= -->
            <!-- PERSONAL INFORMATION -->
            <!-- ================================= -->

            <h5 class="mt-4 mb-3 text-secondary">
                Personal Information
            </h5>

            <div class="row">

                <!-- NAME -->

                <div class="col-md-6 mb-3">

                    <label asp-for="Name"
                           class="form-label">
                    </label>

                    <input asp-for="Name"
                           class="form-control"
                           placeholder="First name" />

                    <span asp-validation-for="Name"
                          class="text-danger small">
                    </span>

                </div>


                <!-- SURNAME -->

                <div class="col-md-6 mb-3">

                    <label asp-for="Surname"
                           class="form-label">
                    </label>

                    <input asp-for="Surname"
                           class="form-control"
                           placeholder="Last name" />

                    <span asp-validation-for="Surname"
                          class="text-danger small">
                    </span>

                </div>

            </div>


            <!-- ================================= -->
            <!-- PROFESSIONAL INFORMATION -->
            <!-- ================================= -->

            <h5 class="mt-4 mb-3 text-secondary">
                Professional Information
            </h5>

            <div class="row">

                <!-- HPCSA -->

                <div class="col-md-6 mb-3">

                    <label asp-for="HPCSANumber"
                           class="form-label">
                    </label>

                    <input asp-for="HPCSANumber"
                           class="form-control"
                           placeholder="Enter HPCSA number" />

                    <span asp-validation-for="HPCSANumber"
                          class="text-danger small">
                    </span>

                    <small class="text-muted">
                        HPCSA number must be entered by the manager.
                    </small>

                </div>

            </div>


            <!-- ================================= -->
            <!-- PASSWORD INFORMATION -->
            <!-- ================================= -->

            <div class="alert alert-info mt-3">

                <strong>Note:</strong>

                A temporary password will be generated automatically
                for the doctor's account.

                The doctor will use their email address and temporary
                password to log in.

            </div>


            <!-- ================================= -->
            <!-- BUTTONS -->
            <!-- ================================= -->

            <div class="d-flex justify-content-between mt-4">

                <a asp-action="Doctors"
                   class="btn btn-outline-secondary">

                    ← Back

                </a>


                <button type="submit"
                        class="btn btn-primary px-4">

                    + Add Doctor

                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}
