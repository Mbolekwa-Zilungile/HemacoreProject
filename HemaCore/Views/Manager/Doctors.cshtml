@model List<HemaCore.Models.Doctor>

@{
    Layout = "_ManagerLayout";
}

<link rel="stylesheet" href="~/css/doctor.css" />
<link rel="stylesheet" href="~/css/delete.css" />

<!-- =========================================================
     ALERT MESSAGES
     ========================================================= -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}


<!-- =========================================================
     MAIN CONTENT
     ========================================================= -->

<div class="content-card">


    <!-- =====================================================
         HEADER
         ===================================================== -->

    <div class="section-title d-flex align-items-center justify-content-between">

        <div class="d-flex align-items-center">

            <i class="fas fa-user-md me-2"></i>

            <span>
                Active Doctors (@(Model?.Count ?? 0))
            </span>

        </div>


        <!-- ADD DOCTOR -->

        <a asp-action="AddDoctor"
           class="btn btn-primary-custom btn-sm">

            + Add Doctor

        </a>

    </div>


   
         <div class="search-toolbar">

            <div class="search-box">
                <i class="fas fa-search search-icon"></i>

                <input type="text"
                       id="searchBox"
                       class="search-input"
                       placeholder="Search..."
                       autocomplete="off" />
            </div>

 
            <div class="filter-box">
                <label for="statusFilter" class="filter-label">
                    <i class="fas fa-filter me-1"></i>
           
                </label>

                <div class="select-wrapper">
                    <select id="statusFilter"
                            class="filter-select"
                            onchange="if (this.value) window.location.href = this.value;">

                        <option value="@Url.Action("Doctors", "Manager")"
                                selected="@(ViewBag.FilterTitle == "Active Doctors")">
                            Active Doctors
                        </option>

                        <option value="@Url.Action("InactiveDoctors", "Manager")"
                                selected="@(ViewBag.FilterTitle == "Inactive Doctors")">
                            Inactive Doctors
                        </option>

                    </select>

                    <i class="fas fa-chevron-down dropdown-icon"></i>
                </div>
            </div>
        </div>



  
    <div class="card shadow-sm">

        <div class="card-body p-0">

            <table class="modern-table">

                <thead>

                    <tr>

                        <th>
                            Name
                        </th>

                        <th>
                            Email
                        </th>

                        <th>
                            HPCSA Number
                        </th>

                        <th>
                            Phone
                        </th>
                        <th>
                            Status
                        </th>
                        <th>
                            Actions
                        </th>

                    </tr>

                </thead>


                <tbody id="doctorTable">

                    @if (Model == null || !Model.Any())
                    {
                        <tr>

                            <td colspan="5"
                                class="text-center text-muted py-3">

                                No inactive doctors available.

                            </td>

                        </tr>
                    }
                    else
                    {
                        foreach (var doctor in Model)
                        {
                            <tr>

                                <!-- NAME -->

                                <td class="fw-semibold blue-text">

                                    Dr @doctor.Surname.ToUpper()
                                    @doctor.Name.ToUpper()

                                </td>


                                <!-- EMAIL -->

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(
                                        doctor.User?.Email))
                                    {
                                        <a href="mailto:@doctor.User.Email">
                                            @doctor.User.Email
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            No email
                                        </span>
                                    }

                                </td>


                                <!-- HPCSA -->

                                <td>

                                    @doctor.HPCSANumber

                                </td>


                                <!-- PHONE -->

                                <td>

                                    @doctor.PhoneNumber

                                </td>

                                
                                <td>
                                    @if (doctor.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactive</span>
                                    }
                                </td>

                                <td>

                                    <a asp-action="EditDoctor"
                                       asp-route-id="@doctor.DoctorId"
                                       class="btn btn-sm btn-outline-primary me-1">

                                        <i class="fas fa-edit me-1"></i>

                                    </a>


                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger deactivate-doctor-btn"
                                            data-id="@doctor.DoctorId"
                                            data-name="Dr @doctor.Name @doctor.Surname">

                                        <i class="fas fa-ban"></i>

                                    </button>

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>



<!-- =========================================================
     DEACTIVATE MODAL
     ========================================================= -->

<div id="deleteModal"
     class="delete-overlay"
     role="dialog"
     aria-modal="true"
     aria-labelledby="deleteModalTitle">

    <div class="delete-box">


        <!-- ICON -->

        <div class="delete-icon">

            <i class="fas fa-exclamation-triangle"></i>

        </div>


        <!-- TITLE -->

        <h3 id="deleteModalTitle">

            Are you sure?

        </h3>


        <!-- MESSAGE -->

        <p>

            Are you sure you want to deactivate

            <strong id="deleteDoctorName"></strong>?

        </p>


        <!-- WARNING -->

        <span class="delete-warning">

            <i class="fas fa-info-circle"></i>

            This doctor will no longer be active.

        </span>


        <!-- BUTTONS -->

        <div class="delete-buttons">


            <!-- CANCEL -->

            <button type="button"
                    id="cancelDeleteBtn"
                    class="cancel-btn">

                Cancel

            </button>


            <!-- DELETE FORM -->

            <form asp-action="DeleteDoctor"
                  method="post"
                  id="deleteForm">

                @Html.AntiForgeryToken()


                <input type="hidden"
                       name="id"
                       id="deleteDoctorId" />


                <button type="submit"
                        id="confirmDeleteBtn"
                        class="confirm-delete-btn">

                    <i class="fas fa-ban me-1"></i>

                    Yes, Deactivate

                </button>

            </form>

        </div>

    </div>

</div>






<script>
    document.addEventListener("DOMContentLoaded", function () {

        // =====================================================
        // ELEMENTS
        // =====================================================

        const modal = document.getElementById("deleteModal");
        const doctorIdInput = document.getElementById("deleteDoctorId");
        const doctorName = document.getElementById("deleteDoctorName");
        const cancelButton = document.getElementById("cancelDeleteBtn");
        const deleteForm = document.getElementById("deleteForm");
        const confirmDeleteBtn = document.getElementById("confirmDeleteBtn");

        // =====================================================
        // OPEN DEACTIVATE MODAL
        // =====================================================

        document.addEventListener("click", function (event) {

            const button = event.target.closest(".deactivate-doctor-btn");

            if (!button) {
                return;
            }

            const id = button.getAttribute("data-id");
            const name = button.getAttribute("data-name");

            doctorIdInput.value = id;
            doctorName.textContent = name;

            modal.classList.add("show");
            document.body.classList.add("modal-open");

        });

        // =====================================================
        // CLOSE MODAL
        // =====================================================

        function closeModal() {

            modal.classList.remove("show");
            document.body.classList.remove("modal-open");

            doctorIdInput.value = "";
            doctorName.textContent = "";

        }

        // =====================================================
        // CANCEL DEACTIVATION
        // =====================================================

        cancelButton.addEventListener("click", function () {

            closeModal();

        });

        // =====================================================
        // CLICK OUTSIDE MODAL
        // =====================================================

        modal.addEventListener("click", function (event) {

            if (event.target === modal) {
                closeModal();
            }

        });

        // =====================================================
        // CLOSE MODAL WITH ESCAPE
        // =====================================================

        document.addEventListener("keydown", function (event) {

            if (
                event.key === "Escape" &&
                modal.classList.contains("show")
            ) {
                closeModal();
            }

        });

        // =====================================================
        // PREVENT DOUBLE FORM SUBMISSION
        // =====================================================

        deleteForm.addEventListener("submit", function () {

            confirmDeleteBtn.disabled = true;

            confirmDeleteBtn.innerHTML = `
                <i class="fas fa-spinner fa-spin me-1"></i>
                Deactivating...
            `;

        });

    });
</script>
