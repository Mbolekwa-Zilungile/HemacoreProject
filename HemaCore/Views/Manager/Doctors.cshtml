@model List<HemaCore.Models.Doctor>

@{
    Layout = "_ManagerLayout";
}

<link rel="stylesheet" href="~/css/doctor.css" />
<link rel="stylesheet" href="~/css/delete.css" />

<!-- =========================================================
     ALERT MESSAGES
     ========================================================= -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}


<!-- =========================================================
     MAIN CONTENT
     ========================================================= -->

<div class="content-card">


    <!-- =====================================================
         HEADER
         ===================================================== -->

    <div class="section-title d-flex align-items-center justify-content-between">

        <div class="d-flex align-items-center">

            <i class="fas fa-user-md me-2"></i>

            <span>
                Doctors (@(Model?.Count ?? 0))
            </span>

        </div>


        <!-- ADD DOCTOR -->

        <a asp-action="AddDoctor"
           class="btn btn-primary-custom btn-sm">

            + Add Doctor

        </a>

    </div>


   
    <div class="row mb-3">

        <div class="col-md-8">
            <input type="text"
                   id="searchBox"
                   class="form-control"
                   placeholder="Type to search doctors..."
                   autocomplete="off" />
        </div>

        <div class="col-md-4">
            <select id="statusFilter" class="form-select">    
                <option value="Active">Active Doctors</option>
                <option value="Inactive">Inactive Doctors</option>
                <option value="All">All Doctors</option>
            </select>
        </div>

    </div>



    <div class="card shadow-sm">

        <div class="card-body p-0">

            <table class="modern-table">

                <thead>

                    <tr>

                        <th>
                            Name
                        </th>

                        <th>
                            Email
                        </th>

                        <th>
                            HPCSA Number
                        </th>

                        <th>
                            Phone
                        </th>

                        <th>
                            Actions
                        </th>

                    </tr>

                </thead>


                <tbody id="doctorTable">

                    @if (Model == null || !Model.Any())
                    {
                        <tr>

                            <td colspan="5"
                                class="text-center text-muted py-3">

                                No doctors available.

                            </td>

                        </tr>
                    }
                    else
                    {
                        foreach (var doctor in Model)
                        {
                            <tr>

                                <!-- NAME -->

                                <td class="fw-semibold blue-text">

                                    Dr @doctor.Surname.ToUpper()
                                    @doctor.Name.ToUpper()

                                </td>


                                <!-- EMAIL -->

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(
                                        doctor.User?.Email))
                                    {
                                        <a href="mailto:@doctor.User.Email">
                                            @doctor.User.Email
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            No email
                                        </span>
                                    }

                                </td>


                                <!-- HPCSA -->

                                <td>

                                    @doctor.HPCSANumber

                                </td>


                                <!-- PHONE -->

                                <td>

                                    @doctor.PhoneNumber

                                </td>



                                <td>

                                    <a asp-action="EditDoctor"
                                       asp-route-id="@doctor.DoctorId"
                                       class="btn btn-sm btn-outline-primary me-1">

                                        <i class="fas fa-edit me-1"></i>

                                    </a>


                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger deactivate-doctor-btn"
                                            data-id="@doctor.DoctorId"
                                            data-name="Dr @doctor.Name @doctor.Surname">

                                        <i class="fas fa-ban"></i>

                                    </button>

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>



<!-- =========================================================
     DEACTIVATE MODAL
     ========================================================= -->

<div id="deleteModal"
     class="delete-overlay"
     role="dialog"
     aria-modal="true"
     aria-labelledby="deleteModalTitle">

    <div class="delete-box">


        <!-- ICON -->

        <div class="delete-icon">

            <i class="fas fa-exclamation-triangle"></i>

        </div>


        <!-- TITLE -->

        <h3 id="deleteModalTitle">

            Are you sure?

        </h3>


        <!-- MESSAGE -->

        <p>

            Are you sure you want to deactivate

            <strong id="deleteDoctorName"></strong>?

        </p>


        <!-- WARNING -->

        <span class="delete-warning">

            <i class="fas fa-info-circle"></i>

            This doctor will no longer be active.

        </span>


        <!-- BUTTONS -->

        <div class="delete-buttons">


            <!-- CANCEL -->

            <button type="button"
                    id="cancelDeleteBtn"
                    class="cancel-btn">

                Cancel

            </button>


            <!-- DELETE FORM -->

            <form asp-action="DeleteDoctor"
                  method="post"
                  id="deleteForm">

                @Html.AntiForgeryToken()


                <input type="hidden"
                       name="id"
                       id="deleteDoctorId" />


                <button type="submit"
                        id="confirmDeleteBtn"
                        class="confirm-delete-btn">

                    <i class="fas fa-ban me-1"></i>

                    Yes, Deactivate

                </button>

            </form>

        </div>

    </div>

</div>






<script>
    document.addEventListener("DOMContentLoaded", function () {

        // =====================================================
        // ELEMENTS
        // =====================================================

        const modal = document.getElementById("deleteModal");
        const doctorIdInput = document.getElementById("deleteDoctorId");
        const doctorName = document.getElementById("deleteDoctorName");
        const cancelButton = document.getElementById("cancelDeleteBtn");
        const deleteForm = document.getElementById("deleteForm");
        const searchBox = document.getElementById("searchBox");
        const doctorTable = document.getElementById("doctorTable");
        const statusFilter = document.getElementById("statusFilter");
        const confirmDeleteBtn = document.getElementById("confirmDeleteBtn");

        // Prevent overlapping search requests
        let searchController = null;

        // =====================================================
        // OPEN DEACTIVATE MODAL
        // =====================================================

        document.addEventListener("click", function (event) {

            const button = event.target.closest(".deactivate-doctor-btn");

            if (!button) {
                return;
            }

            const id = button.getAttribute("data-id");
            const name = button.getAttribute("data-name");

            doctorIdInput.value = id;
            doctorName.textContent = name;

            modal.classList.add("show");
            document.body.classList.add("modal-open");

        });

        // =====================================================
        // CLOSE MODAL
        // =====================================================

        function closeModal() {

            modal.classList.remove("show");
            document.body.classList.remove("modal-open");

            doctorIdInput.value = "";
            doctorName.textContent = "";

        }

        // =====================================================
        // CANCEL DEACTIVATION
        // =====================================================

        cancelButton.addEventListener("click", function () {
            closeModal();
        });

        // =====================================================
        // CLICK OUTSIDE MODAL
        // =====================================================

        modal.addEventListener("click", function (event) {

            if (event.target === modal) {
                closeModal();
            }

        });

        // =====================================================
        // CLOSE MODAL WITH ESCAPE
        // =====================================================

        document.addEventListener("keydown", function (event) {

            if (
                event.key === "Escape" &&
                modal.classList.contains("show")
            ) {
                closeModal();
            }

        });

        // =====================================================
        // PREVENT DOUBLE FORM SUBMISSION
        // =====================================================

        deleteForm.addEventListener("submit", function () {

            confirmDeleteBtn.disabled = true;

            confirmDeleteBtn.innerHTML = `
                <i class="fas fa-spinner fa-spin me-1"></i>
                Deactivating...
            `;

        });

        // =====================================================
        // ESCAPE HTML TO PREVENT HTML INJECTION
        // =====================================================

        function escapeHtml(value) {

            const div = document.createElement("div");

            div.textContent = String(value ?? "");

            return div.innerHTML;

        }

        // =====================================================
        // LIVE SEARCH AND STATUS FILTER
        // =====================================================

        function searchDoctors() {

            const term = searchBox.value.trim();

            // Default to All if the filter is missing
            const status = statusFilter
                ? statusFilter.value
                : "All";

            // Cancel the previous request if necessary
            if (searchController) {
                searchController.abort();
            }

            searchController = new AbortController();

            const url =
                '@Url.Action("SearchDoctorsLive", "Manager")'
                + '?term=' + encodeURIComponent(term)
                + '&status=' + encodeURIComponent(status);

            fetch(url, {
                method: "GET",
                headers: {
                    "Accept": "application/json"
                },
                signal: searchController.signal
            })

            .then(function (response) {

                if (!response.ok) {
                    throw new Error("Search request failed.");
                }

                return response.json();

            })

            .then(function (data) {

                // =============================================
                // NO RESULTS
                // =============================================

                if (!data || data.length === 0) {

                    doctorTable.innerHTML = `
                        <tr>
                            <td colspan="5"
                                class="text-center text-muted py-3">
                                No doctors found.
                            </td>
                        </tr>
                    `;

                    return;
                }

                // =============================================
                // BUILD TABLE ROWS
                // =============================================

                let rows = "";

                data.forEach(function (item) {

                    const id =
                        item.doctorID ?? item.doctorId;

                    const name =
                        escapeHtml(item.name ?? "");

                    const surname =
                        escapeHtml(item.surname ?? "");

                    const email =
                        escapeHtml(item.email ?? "");

                    const hpcsa =
                        escapeHtml(
                            item.hpcsaNumber ??
                            item.hpcsanumber ??
                            ""
                        );

                    const phone =
                        escapeHtml(item.phoneNumber ?? "");

                    const fullName =
                        escapeHtml("Dr " + name + " " + surname);

                    // =========================================
                    // ROW
                    // =========================================

                    rows += `
                        <tr>

                            <td class="fw-semibold blue-text">
                                Dr ${surname.toUpperCase()}
                                ${name.toUpperCase()}
                            </td>

                            <td>
                                ${
                                    email
                                        ? `<a href="mailto:${email}">${email}</a>`
                                        : `<span class="text-muted">No email</span>`
                                }
                            </td>

                            <td>${hpcsa}</td>

                            <td>${phone}</td>

                            <td>
                                <a href="/Manager/EditDoctor/${encodeURIComponent(id)}"
                                   class="btn btn-sm btn-outline-primary me-1"
                                   title="Edit doctor"
                                   aria-label="Edit doctor">
                                    <i class="fas fa-edit"></i>
                                </a>

                                <button type="button"
                                        class="btn btn-sm btn-outline-danger deactivate-doctor-btn"
                                        data-id="${escapeHtml(id)}"
                                        data-name="${fullName}"
                                        title="Deactivate doctor"
                                        aria-label="Deactivate doctor">
                                    <i class="fas fa-ban"></i>
                                </button>
                            </td>

                        </tr>
                    `;

                });

                doctorTable.innerHTML = rows;

            })

            .catch(function (error) {

                // Ignore requests cancelled by a newer search
                if (error.name === "AbortError") {
                    return;
                }

                console.error("Doctor search failed:", error);

                doctorTable.innerHTML = `
                    <tr>
                        <td colspan="5"
                            class="text-center text-danger py-3">
                            Search failed. Please try again.
                        </td>
                    </tr>
                `;

            });

        }

        // =====================================================
        // SEARCH WHEN TYPING
        // =====================================================

        searchBox.addEventListener("input", searchDoctors);

        // =====================================================
        // FILTER WHEN STATUS CHANGES
        // =====================================================

        if (statusFilter) {
            statusFilter.addEventListener("change", searchDoctors);
        }

    });
</script>

