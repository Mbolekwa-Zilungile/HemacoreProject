@model List<HemaCore.Models.Doctor>

@{
    Layout = "_ManagerLayout";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

<link rel="stylesheet" href="~/css/doctor.css" />

<div class="content-card">

    <!-- HEADER -->
    <div class="section-title d-flex align-items-center justify-content-between">

        <div class="d-flex align-items-center">
            <i class="fas fa-user-md me-2"></i>

            <span>Doctors (@Model.Count)</span>

        </div>

        <a asp-action="AddDoctor"
           class="btn btn-primary-custom btn-sm">
            + Add Doctor
        </a>

    </div>

    <!-- SEARCH -->
    <input type="text"
           id="searchBox"
           class="form-control mb-3"
           placeholder="Search doctors by name, surname, HPCSA, email or phone..." />

    <div class="card shadow-sm">
        <div class="card-body p-0">

            <table class="modern-table">

                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>HPCSA Number</th>
                        <th>Phone</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>

                <tbody id="doctorTable">
                      @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-3">
                                No doctor available.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var doctor in Model)
                        {
                            <tr>
                                <td>Dr @doctor.Surname @doctor.Name</td>
                                <td>
                                    <a href="mailto:@doctor.User.Email">@doctor.User.Email</a>
                                </td>
                                <td>@doctor.HPCSANumber</td>
                                <td>@doctor.PhoneNumber</td>

                                <td class="text-center">
                                    <a asp-action="EditDoctor"
                                    asp-route-id="@doctor.DoctorId"
                                    class="btn btn-sm btn-outline-primary me-1">
                                        Edit
                                    </a>

                                    <a asp-action="DeleteDoctor"
                                    asp-route-id="@doctor.DoctorId"
                                    class="btn btn-sm btn-outline-danger">
                                        Deactivate
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>

            </table>

        </div>
    </div>
</div>

<!-- LIVE SEARCH SCRIPT -->
<script>
    document.getElementById("searchBox").addEventListener("keyup", function () {

        let term = this.value;

        fetch('/Manager/SearchDoctorsLive?term=' + encodeURIComponent(term))
            .then(res => res.json())
            .then(data => {

                let rows = "";

                if (data.length === 0) {

                    rows = `
                        <tr>
                            <td colspan="5" class="text-center text-muted">
                                No doctors found.
                            </td>
                        </tr>
                    `;
                }
                else {

                    data.forEach(item => {

                        rows += `
                            <tr>
                                <td>Dr ${item.surname ?? ""} ${item.name ?? ""}</td>
                                <td>${item.email ?? ""}</td>
                                <td>${item.hpcsanumber ?? ""}</td>
                                <td>${item.phoneNumber ?? ""}</td>

                                <td class="text-center">
                                    <a href="/Manager/EditDoctor/${item.doctorID}"
                                       class="btn btn-sm btn-primary me-1">
                                        Edit
                                    </a>

                                    <a href="/Manager/DeleteDoctor/${item.doctorID}"
                                       class="btn btn-sm btn-danger">
                                        Deactivate
                                    </a>
                                </td>
                            </tr>
                        `;
                    });
                }

                document.getElementById("doctorTable").innerHTML = rows;
            });
    });
</script>