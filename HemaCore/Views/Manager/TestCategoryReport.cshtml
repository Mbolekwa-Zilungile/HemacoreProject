@model HemaCore.ViewModels.ManagerVM.TestCategoryReportViewModel

@{
    Layout = "_ManagerLayout";
    ViewData["Title"] = "Management Reports";
}

<link rel="stylesheet" href="~/css/management-reports.css" />

<div class="reports-container">

    <!-- PAGE HEADER -->
    <div class="reports-header">
        <div>
            <h2>
                <i class="fas fa-chart-bar"></i>
                Management Reports
            </h2>

            <p>
                Generate and download laboratory management reports.
            </p>
        </div>

        <div class="reports-header-icon">
            <i class="fas fa-file-pdf"></i>
        </div>
    </div>

    <!-- REPORT CARD -->
    <div class="report-card">

        <div class="report-card-header">
            <div class="report-icon">
                <i class="fas fa-chart-column"></i>
            </div>

            <div>
                <h4>Tests Performed by Category</h4>
                <p>PDF management report</p>
            </div>
        </div>

        <div class="report-card-body">

            <div class="report-description">
                <i class="fas fa-circle-info"></i>

                <span>
                    Select a date range to generate a PDF showing
                    the total number of completed tests grouped
                    by test category.
                </span>
            </div>

            <form asp-controller="Manager"
                  asp-action="GenerateTestCategoryReport"
                  method="post"
                  id="reportForm">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="validation-summary"></div>

                <div class="date-fields">

                    <div class="form-group">
                        <label asp-for="StartDate">
                            <i class="fas fa-calendar"></i>
                            Start Date
                        </label>

                        <input asp-for="StartDate"
                               type="date"
                               class="form-control"
                               id="StartDate"
                               required />

                        <span asp-validation-for="StartDate"
                              class="field-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="EndDate">
                            <i class="fas fa-calendar-check"></i>
                            End Date
                        </label>

                        <input asp-for="EndDate"
                               type="date"
                               class="form-control"
                               id="EndDate"
                               required />

                        <span asp-validation-for="EndDate"
                              class="field-error"></span>
                    </div>

                </div>

                <div id="dateError"
                     class="date-error"
                     role="alert"
                     hidden>
                    The start date cannot be after the end date.
                </div>

                <div class="report-actions">
                    <button type="submit"
                            class="btn-generate"
                            id="generateButton">

                        <i class="fas fa-file-pdf"></i>
                        Generate PDF Report
                    </button>

                    <button type="reset"
                            class="btn-reset">
                        <i class="fas fa-rotate-left"></i>
                        Reset Dates
                    </button>
                </div>

            </form>

            <div class="report-information">
                <h5>
                    <i class="fas fa-circle-info"></i>
                    Report information
                </h5>

                <ul>
                    <li>Only completed tests are included.</li>
                    <li>Tests are grouped by their test category.</li>
                    <li>The report includes a grand total.</li>
                    <li>The selected start and end dates are included.</li>
                    <li>The report is downloaded as a PDF file.</li>
                </ul>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const form = document.getElementById("reportForm");
            const startDate = document.getElementById("StartDate");
            const endDate = document.getElementById("EndDate");
            const dateError = document.getElementById("dateError");
            const generateButton =
                document.getElementById("generateButton");

            function validateDates() {
                const invalid =
                    startDate.value &&
                    endDate.value &&
                    startDate.value > endDate.value;

                dateError.hidden = !invalid;

                startDate.setCustomValidity(
                    invalid
                        ? "Start date cannot be after end date."
                        : ""
                );

                endDate.setCustomValidity(
                    invalid
                        ? "End date cannot be before start date."
                        : ""
                );

                return !invalid;
            }

            startDate.addEventListener("change", validateDates);
            endDate.addEventListener("change", validateDates);

            form.addEventListener("submit", function (event) {
                if (!validateDates()) {
                    event.preventDefault();
                    startDate.reportValidity();
                    return;
                }

                generateButton.disabled = true;
                generateButton.innerHTML =
                    '<i class="fas fa-spinner fa-spin"></i> Generating PDF...';
            });

            form.addEventListener("reset", function () {
                window.setTimeout(function () {
                    dateError.hidden = true;
                    startDate.setCustomValidity("");
                    endDate.setCustomValidity("");
                    generateButton.disabled = false;
                    generateButton.innerHTML =
                        '<i class="fas fa-file-pdf"></i> Generate PDF Report';
                }, 0);
            });
        });
    </script>
}
