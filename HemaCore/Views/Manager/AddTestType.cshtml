@model HemaCore.ViewModels.ManagerVM.TestTypeViewModel

@{
    Layout = "_ManagerLayout";
}

<link rel="stylesheet" href="~/css/doctor.css" />


<div class="container mt-4">

    <div class="card shadow-sm p-4">


        <!-- =====================================================
             PAGE HEADER
             ===================================================== -->

        <div class="mb-4">

            <h3 class="fw-bold">
                Add Test Type
            </h3>

            <p class="text-muted">
                Fill in the details below to add a new test type
                to the system.
            </p>

        </div>


        <!-- =====================================================
             FORM
             ===================================================== -->

        <form asp-action="AddTestType"
              method="post">

            @Html.AntiForgeryToken()


            <!-- =================================================
                 VALIDATION
                 ================================================= -->

            <div asp-validation-summary="All"
                 class="text-danger mb-3">
            </div>


            <!-- =================================================
                 TEST TYPE DETAILS
                 ================================================= -->

            <h5 class="text-secondary mb-3">
                Test Type Details
            </h5>


            <div class="row">


                <!-- TEST TYPE NAME -->

                <div class="col-md-6 mb-3">

                    <label asp-for="TestTypeName"
                           class="form-label">
                        Test Type Name
                    </label>

                    <input asp-for="TestTypeName"
                           class="form-control"
                           placeholder="Test Type Name" />

                    <span asp-validation-for="TestTypeName"
                          class="text-danger">
                    </span>

                </div>


                <!-- UNIT OF MEASUREMENT -->

                <div class="col-md-6 mb-3">

                    <label asp-for="UnitOfMeasurement"
                           class="form-label">
                        Unit of Measurement
                    </label>

                    <input asp-for="UnitOfMeasurement"
                           class="form-control"
                           placeholder="Unit Of Measurement" />

                    <span asp-validation-for="UnitOfMeasurement"
                          class="text-danger">
                    </span>

                </div>


                <!-- NORMAL RANGE MIN -->

                <div class="col-md-6 mb-3">

                    <label asp-for="NormalRangeMin"
                           class="form-label">
                        Normal Range Minimum
                    </label>

                    <input asp-for="NormalRangeMin"
                           type="number"
                           step="0.01"
                           class="form-control" />

                    <span asp-validation-for="NormalRangeMin"
                          class="text-danger">
                    </span>

                </div>


                <!-- NORMAL RANGE MAX -->

                <div class="col-md-6 mb-3">

                    <label asp-for="NormalRangeMax"
                           class="form-label">
                        Normal Range Maximum
                    </label>

                    <input asp-for="NormalRangeMax"
                           type="number"
                           step="0.01"
                           class="form-control" />

                    <span asp-validation-for="NormalRangeMax"
                          class="text-danger">
                    </span>

                </div>


                <!-- TURNAROUND TIME -->

                <div class="col-md-6 mb-3">

                    <label asp-for="TurnAroundTime"
                           class="form-label">
                        Turnaround Time (min)
                    </label>

                    <input asp-for="TurnAroundTime"
                           type="number"
                           class="form-control" />

                    <span asp-validation-for="TurnAroundTime"
                          class="text-danger">
                    </span>

                </div>

            </div>


            <!-- =================================================
                 CATEGORY + SAMPLE TYPE
                 ================================================= -->

            <div class="row">

                <!-- CATEGORY -->

                <div class="col-md-6 mb-3">

                    <label asp-for="CategoryID"
                           class="form-label">

                        Category

                    </label>

                    <select asp-for="CategoryID"
                            class="form-control">

                        <option value="">
                            -- Select Category --
                        </option>

                        @if (ViewBag.Categories != null)
                        {
                            foreach (var category in ViewBag.Categories)
                            {
                                <option value="@category.CategoryId">
                                    @category.CategoryName
                                </option>
                            }
                        }

                    </select>

                    <span asp-validation-for="CategoryID"
                          class="text-danger">
                    </span>

                </div>


                <!-- SAMPLE TYPE -->

                <div class="col-md-6 mb-3">

                    <label asp-for="SampleTypeID"
                           class="form-label">

                        Sample Type

                    </label>

                    <select asp-for="SampleTypeID"
                            class="form-control">

                        <option value="">
                            -- Select Sample Type --
                        </option>

                        @if (ViewBag.SampleTypes != null)
                        {
                            foreach (var sampleType in ViewBag.SampleTypes)
                            {
                                <option value="@sampleType.SampleTypeId">
                                    @sampleType.SampleName
                                </option>
                            }
                        }

                    </select>

                    <span asp-validation-for="SampleTypeID"
                          class="text-danger">
                    </span>

                </div>

            </div>


            <hr class="my-4" />


            <!-- =====================================================
                 CONSUMABLES + LAB TECHNICIANS
                 ===================================================== -->

            <div class="row g-4">


                <!-- =================================================
                     CONSUMABLES
                     ================================================= -->

                <div class="col-md-6">


                    <!-- CONSUMABLE HEADER -->

                    <div class="d-flex justify-content-between align-items-center mb-3">

                        <div>

                            <h5 class="mb-0 text-secondary">
                                Consumables
                            </h5>

                            <small class="text-muted">
                                Select the consumables required to perform this test type.
                            </small>

                        </div>


                        <button type="button"
                                id="toggleConsumables"
                                class="btn btn-outline-primary btn-sm">

                            <span class="toggle-icon">
                                👁
                            </span>

                            <span class="toggle-text">
                                Hide Consumables
                            </span>

                        </button>

                    </div>


                    <!-- =================================================
                         CONSUMABLE SECTION
                         ================================================= -->

                    <div id="consumablesSection">

                        @if (Model?.Consumables != null &&
                             Model.Consumables.Any())
                        {

                            <!-- SEARCH -->

                            <div class="mb-3">

                                <input type="text"
                                       id="consumableSearch"
                                       class="form-control"
                                       placeholder="Search consumables..."
                                       autocomplete="off" />

                            </div>


                            <!-- TABLE -->

                            <div id="consumablesTableContainer">

                                <div class="table-responsive">

                                    <table class="table table-bordered">

                                        <thead>

                                            <tr>

                                                <th width="70">
                                                    Select
                                                </th>

                                                <th>
                                                    Consumable
                                                </th>

                                                <th width="150">
                                                    Quantity Used
                                                </th>

                                            </tr>

                                        </thead>


                                        <tbody id="consumablesTableBody">

                                            @for (int i = 0;
                                                  i < Model.Consumables.Count;
                                                  i++)
                                            {

                                                <tr class="consumable-row">

                                                    <!-- SELECT -->

                                                    <td class="text-center">

                                                        <input type="checkbox"
                                                               asp-for="Consumables[i].IsSelected"
                                                               class="consumable-checkbox" />

                                                        <input type="hidden"
                                                               asp-for="Consumables[i].ConsumableID" />

                                                        <input type="hidden"
                                                               asp-for="Consumables[i].ConsumableName" />

                                                    </td>


                                                    <!-- NAME -->

                                                    <td>

                                                        @Model.Consumables[i].ConsumableName

                                                    </td>


                                                    <!-- QUANTITY -->

                                                    <td>

                                                        <input asp-for="Consumables[i].QuantityUsed"
                                                               class="form-control quantity-input consumable-quantity"
                                                               type="number"
                                                               min="0"
                                                               placeholder="0" />

                                                        <span asp-validation-for="Consumables[i].QuantityUsed"
                                                              class="text-danger">
                                                        </span>

                                                    </td>

                                                </tr>

                                            }

                                        </tbody>

                                    </table>

                                </div>


                                <!-- NO SEARCH RESULTS -->

                                <div id="noSearchResults"
                                     class="no-consumables-message"
                                     style="display:none;">

                                    <div class="empty-icon">
                                        🔍
                                    </div>

                                    <strong>
                                        No consumables found
                                    </strong>

                                    <p class="mb-0 mt-1">
                                        No consumables match your search.
                                    </p>

                                </div>

                            </div>

                        }
                        else
                        {

                            <!-- NO CONSUMABLES -->

                            <div class="no-consumables-message">

                                <div class="empty-icon">
                                    📦
                                </div>

                                <strong>
                                    No consumables available
                                </strong>

                                <p class="mb-0 mt-1">
                                    There are currently no consumables available.
                                </p>

                            </div>

                        }

                    </div>


                    <!-- =================================================
                         SELECTED CONSUMABLE COUNT

                         OUTSIDE HIDDEN SECTION
                         ================================================= -->

                    <div class="mt-2">

                        <span id="selectedConsumableCount"
                              class="selected-consumable-count">

                            0 selected

                        </span>

                    </div>

                </div>


                <!-- =================================================
                     LAB TECHNICIANS
                     ================================================= -->

                <div class="col-md-6">

                    <div class="technician-section">


                        <!-- TECHNICIAN HEADER -->

                        <div class="d-flex justify-content-between align-items-center mb-3">

                            <div>

                                <h5 class="mb-0 text-secondary">
                                    Assign Lab Technicians
                                </h5>

                                <small class="text-muted">
                                    Select one or more technicians who can perform this test type.
                                </small>

                            </div>


                            <button type="button"
                                    id="toggleTechnicians"
                                    class="btn btn-outline-primary btn-sm">

                                <span class="toggle-icon">
                                    👁
                                </span>

                                <span class="toggle-text">
                                    Hide Technicians
                                </span>

                            </button>

                        </div>


                        <!-- =================================================
                             TECHNICIAN SECTION
                             ================================================= -->

                        <div id="techniciansSection">

                            @if (Model?.Technicians != null &&
                                 Model.Technicians.Any())
                            {

                                <!-- SEARCH -->

                                <div class="mb-3">

                                    <input type="text"
                                           id="technicianSearch"
                                           class="form-control"
                                           placeholder="Search lab technicians..."
                                           autocomplete="off" />

                                </div>


                                <!-- TABLE -->

                                <div class="table-responsive technician-table">

                                    <table class="table table-bordered align-middle">

                                        <thead>

                                            <tr>

                                                <th width="70"
                                                    class="text-center">

                                                    Select

                                                </th>

                                                <th>
                                                    Lab Technician
                                                </th>

                                            </tr>

                                        </thead>


                                        <tbody id="technicianTableBody">

                                            @for (int i = 0;
                                                  i < Model.Technicians.Count;
                                                  i++)
                                            {

                                                <tr class="technician-row">

                                                    <!-- SELECT -->

                                                    <td class="text-center">

                                                        <input type="checkbox"
                                                               asp-for="Technicians[i].IsSelected"
                                                               class="technician-checkbox" />

                                                        <input type="hidden"
                                                               asp-for="Technicians[i].TechnicianID" />

                                                        <input type="hidden"
                                                               asp-for="Technicians[i].TechnicianName" />

                                                    </td>


                                                    <!-- NAME -->

                                                    <td>

                                                        <label class="form-check-label">

                                                            @Model.Technicians[i].TechnicianName

                                                        </label>

                                                    </td>

                                                </tr>

                                            }

                                        </tbody>

                                    </table>

                                </div>


                                <!-- NO SEARCH RESULTS -->

                                <div id="noTechnicianSearchResults"
                                     class="no-consumables-message"
                                     style="display:none;">

                                    <div class="empty-icon">
                                        🔍
                                    </div>

                                    <strong>
                                        No technicians found
                                    </strong>

                                    <p class="mb-0 mt-1">
                                        No lab technicians match your search.
                                    </p>

                                </div>

                            }
                            else
                            {

                                <!-- NO TECHNICIANS -->

                                <div class="alert alert-warning">

                                    <strong>
                                        No active lab technicians available.
                                    </strong>

                                    <p class="mb-0 mt-1">
                                        Please add or activate a lab technician
                                        before assigning technicians to this test type.
                                    </p>

                                </div>

                            }

                        </div>


                        <!-- =================================================
                             SELECTED TECHNICIAN COUNT

                             OUTSIDE HIDDEN SECTION
                             ================================================= -->

                        <div class="mt-2">

                            <span id="selectedTechnicianCount"
                                  class="selected-technician-count">

                                0 selected

                            </span>

                        </div>

                    </div>

                </div>

            </div>


            <!-- =================================================
                 BUTTONS
                 ================================================= -->

            <div class="d-flex justify-content-between mt-4">

                <a asp-action="TestTypes"
                   class="btn btn-outline-secondary">

                    ← Back

                </a>


                <button type="submit"
                        class="btn btn-primary-custom btn-sm">

                    Save Test Type

                </button>

            </div>


        </form>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />


    <script>

        document.addEventListener("DOMContentLoaded", function () {


            // =====================================================
            // CONSUMABLE ELEMENTS
            // =====================================================

            const toggleConsumables =
                document.getElementById("toggleConsumables");

            const consumablesSection =
                document.getElementById("consumablesSection");

            const consumableSearch =
                document.getElementById("consumableSearch");

            const noSearchResults =
                document.getElementById("noSearchResults");

            const consumableRows =
                document.querySelectorAll(".consumable-row");

            const consumableCheckboxes =
                document.querySelectorAll(".consumable-checkbox");

            const consumableQuantityInputs =
                document.querySelectorAll(".consumable-quantity");

            const selectedConsumableCount =
                document.getElementById(
                    "selectedConsumableCount"
                );


            // =====================================================
            // SHOW / HIDE CONSUMABLES
            // =====================================================

            if (toggleConsumables && consumablesSection) {

                toggleConsumables.addEventListener(
                    "click",
                    function () {

                        const isHidden =
                            consumablesSection.style.display === "none";


                        if (isHidden) {

                            consumablesSection.style.display = "block";

                            toggleConsumables
                                .querySelector(".toggle-text")
                                .textContent = "Hide Consumables";

                            toggleConsumables
                                .querySelector(".toggle-icon")
                                .textContent = "👁";

                        }
                        else {

                            consumablesSection.style.display = "none";

                            toggleConsumables
                                .querySelector(".toggle-text")
                                .textContent = "Show Consumables";

                            toggleConsumables
                                .querySelector(".toggle-icon")
                                .textContent = "👁‍🗨";

                        }

                    }
                );

            }


            // =====================================================
            // SEARCH CONSUMABLES
            // =====================================================

            if (consumableSearch) {

                consumableSearch.addEventListener(
                    "input",
                    function () {

                        const searchText =
                            consumableSearch.value
                                .toLowerCase()
                                .trim();


                        let visibleRows = 0;


                        consumableRows.forEach(function (row) {

                            const consumableName =
                                row
                                    .querySelector("td:nth-child(2)")
                                    ?.textContent
                                    .toLowerCase()
                                    .trim() || "";


                            if (
                                consumableName.includes(searchText)
                            ) {

                                row.style.display = "";

                                visibleRows++;

                            }
                            else {

                                row.style.display = "none";

                            }

                        });


                        if (noSearchResults) {

                            if (
                                searchText !== "" &&
                                visibleRows === 0
                            ) {

                                noSearchResults.style.display = "block";

                            }
                            else {

                                noSearchResults.style.display = "none";

                            }

                        }

                    }
                );

            }


            // =====================================================
            // CONSUMABLE COUNT
            // =====================================================

            function updateConsumableCount() {

                if (!selectedConsumableCount) {
                    return;
                }


                const selectedCount =
                    document.querySelectorAll(
                        ".consumable-checkbox:checked"
                    ).length;


                selectedConsumableCount.textContent =
                    selectedCount + " selected";

            }


            // =====================================================
            // CONSUMABLE CHECKBOX EVENTS
            // =====================================================

            if (consumableCheckboxes.length > 0) {

                consumableCheckboxes.forEach(
                    function (checkbox) {

                        checkbox.addEventListener(
                            "change",
                            function () {

                                const row =
                                    checkbox.closest(
                                        ".consumable-row"
                                    );


                                if (!row) {
                                    return;
                                }


                                const quantityInput =
                                    row.querySelector(
                                        ".consumable-quantity"
                                    );


                                // =================================
                                // CHECKED
                                // =================================

                                if (checkbox.checked) {

                                    // Automatically set quantity
                                    // to 1 when selected.

                                    if (
                                        !quantityInput.value ||
                                        parseFloat(
                                            quantityInput.value
                                        ) <= 0
                                    ) {

                                        quantityInput.value = 1;

                                    }

                                }


                                // =================================
                                // UNCHECKED
                                // =================================

                                else {

                                    // Clear quantity when the
                                    // consumable is unselected.

                                    if (quantityInput) {

                                        quantityInput.value = "";

                                    }

                                }


                                updateConsumableCount();

                            }
                        );

                    }
                );

            }


            // =====================================================
            // QUANTITY AUTOMATICALLY SELECTS CONSUMABLE
            // =====================================================

            if (consumableQuantityInputs.length > 0) {

                consumableQuantityInputs.forEach(
                    function (quantityInput) {

                        quantityInput.addEventListener(
                            "input",
                            function () {

                                const row =
                                    quantityInput.closest(
                                        ".consumable-row"
                                    );


                                if (!row) {
                                    return;
                                }


                                const checkbox =
                                    row.querySelector(
                                        ".consumable-checkbox"
                                    );


                                if (!checkbox) {
                                    return;
                                }


                                const quantity =
                                    parseFloat(
                                        quantityInput.value
                                    );


                                // =================================
                                // QUANTITY > 0
                                // =================================

                                if (
                                    !isNaN(quantity) &&
                                    quantity > 0
                                ) {

                                    checkbox.checked = true;

                                }


                                // =================================
                                // QUANTITY = 0 / EMPTY
                                // =================================

                                else {

                                    checkbox.checked = false;

                                }


                                updateConsumableCount();

                            }
                        );

                    }
                );

            }


            // Initial count

            updateConsumableCount();


            // =====================================================
            // TECHNICIAN ELEMENTS
            // =====================================================

            const toggleTechnicians =
                document.getElementById("toggleTechnicians");

            const techniciansSection =
                document.getElementById("techniciansSection");

            const technicianSearch =
                document.getElementById("technicianSearch");

            const technicianRows =
                document.querySelectorAll(".technician-row");

            const noTechnicianSearchResults =
                document.getElementById(
                    "noTechnicianSearchResults"
                );

            const technicianCheckboxes =
                document.querySelectorAll(
                    ".technician-checkbox"
                );

            const selectedTechnicianCount =
                document.getElementById(
                    "selectedTechnicianCount"
                );


            // =====================================================
            // SHOW / HIDE TECHNICIANS
            // =====================================================

            if (toggleTechnicians && techniciansSection) {

                toggleTechnicians.addEventListener(
                    "click",
                    function () {

                        const isHidden =
                            techniciansSection.style.display === "none";


                        if (isHidden) {

                            techniciansSection.style.display = "block";

                            toggleTechnicians
                                .querySelector(".toggle-text")
                                .textContent = "Hide Technicians";

                            toggleTechnicians
                                .querySelector(".toggle-icon")
                                .textContent = "👁";

                        }
                        else {

                            techniciansSection.style.display = "none";

                            toggleTechnicians
                                .querySelector(".toggle-text")
                                .textContent = "Show Technicians";

                            toggleTechnicians
                                .querySelector(".toggle-icon")
                                .textContent = "👁‍🗨";

                        }

                    }
                );

            }


            // =====================================================
            // SEARCH TECHNICIANS
            // =====================================================

            if (technicianSearch) {

                technicianSearch.addEventListener(
                    "input",
                    function () {

                        const searchText =
                            technicianSearch.value
                                .toLowerCase()
                                .trim();


                        let visibleRows = 0;


                        technicianRows.forEach(function (row) {

                            const technicianName =
                                row
                                    .querySelector("td:nth-child(2)")
                                    ?.textContent
                                    .toLowerCase()
                                    .trim() || "";


                            if (
                                technicianName.includes(searchText)
                            ) {

                                row.style.display = "";

                                visibleRows++;

                            }
                            else {

                                row.style.display = "none";

                            }

                        });


                        if (noTechnicianSearchResults) {

                            if (
                                searchText !== "" &&
                                visibleRows === 0
                            ) {

                                noTechnicianSearchResults
                                    .style.display = "block";

                            }
                            else {

                                noTechnicianSearchResults
                                    .style.display = "none";

                            }

                        }

                    }
                );

            }


            // =====================================================
            // TECHNICIAN COUNT
            // =====================================================

            function updateTechnicianCount() {

                if (!selectedTechnicianCount) {
                    return;
                }


                const selectedCount =
                    document.querySelectorAll(
                        ".technician-checkbox:checked"
                    ).length;


                selectedTechnicianCount.textContent =
                    selectedCount + " selected";

            }


            // =====================================================
            // TECHNICIAN CHECKBOX EVENTS
            // =====================================================

            if (technicianCheckboxes.length > 0) {

                technicianCheckboxes.forEach(
                    function (checkbox) {

                        checkbox.addEventListener(
                            "change",
                            updateTechnicianCount
                        );

                    }
                );


                updateTechnicianCount();

            }

        });

    </script>

}
