@model HemaCore.Models.TestCategory

@{
    Layout = "_ManagerLayout";
}

<br />

<h3 class="text-primary">Edit Category</h3>
<hr />

<form asp-action="EditCategory" method="post">

    <!-- Hidden ID -->
    <input type="hidden" asp-for="CategoryId" />

    <div class="mb-3">
        <label>Category Name</label>
        <input asp-for="CategoryName" class="form-control" />
        <span asp-validation-for="CategoryName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label>Description</label>
        <textarea asp-for="CategoryDescription" class="form-control"></textarea>
        <span asp-validation-for="CategoryDescription" class="text-danger"></span>
    </div>

    <button type="submit"
            class="btn"
            style="background-color:#3b5bb5; color:white;">
        Save Changes
    </button>

    <a asp-action="TestCategories" class="btn btn-secondary">
        Cancel
    </a>

</form>