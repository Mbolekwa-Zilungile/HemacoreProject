@model List<HemaCore.Models.TestCategory>

@{
    Layout = "_ManagerLayout";
}

<link rel="stylesheet" href="~/css/doctor.css" />
<link rel="stylesheet" href="~/css/delete.css" />

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}


<div class="content-card">


    <div class="section-title d-flex align-items-center justify-content-between">

        <div class="d-flex align-items-center">

            <i class="fas fa-folder me-2"></i>

            <span>
                Inactive Test Categories (@(Model?.Count ?? 0))
            </span>

        </div>

        <a asp-action="AddCategory"
           class="btn btn-primary-custom btn-sm">

            + Add Category

        </a>

    </div>



     <div class="search-toolbar">

            <div class="search-box">
                <i class="fas fa-search search-icon"></i>

                <input type="text"
                       id="searchBox"
                       class="search-input"
                       placeholder="Search..."
                       autocomplete="off" />
            </div>

 
           
        <div class="filter-box">
            <label for="statusFilter" class="filter-label">
                <i class="fas fa-filter me-1"></i>
            </label>

            <div class="select-wrapper">
                <select id="statusFilter"
                        class="filter-select"
                        onchange="if (this.value) window.location.href = this.value;">

                    <option value="@Url.Action("TestCategories", "Manager")"
                            selected="@(ViewContext.RouteData.Values["action"]?.ToString() == "TestCategories")">
                        Active Categories
                    </option>

                    <option value="@Url.Action("InactiveTestCategories", "Manager")"
                            selected="@(ViewContext.RouteData.Values["action"]?.ToString() == "InactiveTestCategories")">
                        Inactive Categories
                    </option>

                </select>

                <i class="fas fa-chevron-down dropdown-icon"></i>
            </div>
        </div>

        </div>


    <table class="modern-table">

        <thead>

            <tr>

                <th>
                    Category Name
                </th>

                <th>
                    Description
                </th>

                <th>
                    Test Types
                </th>

                <th>
                    Status
                </th>

                <th>
                    Actions
                </th>

            </tr>

        </thead>


        <tbody id="categoryTable">

            @if (Model == null || !Model.Any())
            {
                <tr>

                    <td colspan="5"
                        class="text-center text-muted">

                        No inactive test categories available.

                    </td>

                </tr>
            }
            else
            {
                foreach (var category in Model)
                {
                    <tr>

                        <!-- CATEGORY NAME -->
                        <td class="fw-semibold blue-text">

                            @category.CategoryName

                        </td>


                        <!-- DESCRIPTION -->
                        <td>

                            @category.CategoryDescription

                        </td>


                        <!-- TEST TYPES -->
                        <td>

                            @(ViewBag.TestTypeCountByCategory != null &&
                                                    ViewBag.TestTypeCountByCategory.ContainsKey(category.CategoryId)
                                                    ? ViewBag.TestTypeCountByCategory[category.CategoryId]
                                                    : 0)

                        </td>

                        <td>
                                @if (category.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactive</span>
                                }
                         </td>
                       
                      
                        <td>

                            <!-- EDIT -->
                            <a asp-action="EditCategory"
                               asp-route-id="@category.CategoryId"
                               class="btn btn-sm btn-outline-primary me-1">

                                <i class="fas fa-edit me-1"></i>

                            </a>


                            <!-- ACTIVATE -->
                            <button type="button"
                                    class="btn btn-sm btn-outline-success activate-category-btn"
                                    data-id="@category.CategoryId"
                                    data-name="@category.CategoryName"
                                    title="Reactivate category">

                                <i class="fas fa-check-circle"></i>

                            </button>


                        </td>

                    </tr>
                }
            }

        </tbody>

    </table>

</div>



<!-- =========================================================
     DEACTIVATE MODAL
     ========================================================= -->

<!-- REACTIVATE CATEGORY MODAL -->
<div id="deleteModal"
     class="delete-overlay"
     role="dialog"
     aria-modal="true"
     aria-labelledby="deleteModalTitle">

    <div class="delete-box">

        <div class="activate-icon">
            <i class="fas fa-check-circle"></i>
        </div>

        <h3 id="deleteModalTitle">
            Reactivate Test Category?
        </h3>

        <p>
            Are you sure you want to reactivate
            <strong id="deleteCategoryName"></strong>?
        </p>

        <span class="delete-warning activate-warning">
            <i class="fas fa-check-circle"></i>
            <span class="activate-text">
                This category will become active and available for use again.
            </span>
        </span>

        <div class="delete-buttons">

            <button type="button"
                    id="cancelDeleteBtn"
                    class="cancel-btn">
                Cancel
            </button>

            <form asp-action="ActivateCategory"
                  asp-controller="Manager"
                  method="post"
                  id="deleteForm">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       id="deleteCategoryId" />

                <button type="submit"
                        id="confirmDeleteBtn"
                        class="btn btn-success">

                    <i class="fas fa-check-circle me-1"></i>
                    Yes, Reactivate

                </button>

            </form>

        </div>

    </div>
</div>




<script>
    document.addEventListener("DOMContentLoaded", function () {

        // =====================================================
        // ELEMENTS
        // =====================================================

        const modal = document.getElementById("deleteModal");
        const categoryIdInput = document.getElementById("deleteCategoryId");
        const categoryName = document.getElementById("deleteCategoryName");
        const cancelButton = document.getElementById("cancelDeleteBtn");
        const deleteForm = document.getElementById("deleteForm");
        const confirmButton = document.getElementById("confirmDeleteBtn");
        const searchBox = document.getElementById("searchBox");
        const categoryTable = document.getElementById("categoryTable");

        // =====================================================
        // OPEN REACTIVATE CATEGORY MODAL
        // =====================================================

        document.addEventListener("click", function (event) {

            const button = event.target.closest(".activate-category-btn");

            if (!button) return;

            categoryIdInput.value = button.dataset.id || "";
            categoryName.textContent = button.dataset.name || "";

            modal.classList.add("show");
            document.body.classList.add("modal-open");

        });

        // =====================================================
        // CLOSE MODAL
        // =====================================================

        function closeModal() {

            modal.classList.remove("show");
            document.body.classList.remove("modal-open");

            categoryIdInput.value = "";
            categoryName.textContent = "";

            confirmButton.disabled = false;
            confirmButton.innerHTML = `
                <i class="fas fa-check-circle me-1"></i>
                Yes, Reactivate
            `;
        }

        cancelButton.addEventListener("click", closeModal);

        // Click outside modal
        modal.addEventListener("click", function (event) {

            if (event.target === modal) {
                closeModal();
            }

        });

        // Escape key
        document.addEventListener("keydown", function (event) {

            if (
                event.key === "Escape" &&
                modal.classList.contains("show")
            ) {
                closeModal();
            }

        });

        // =====================================================
        // PREVENT DOUBLE FORM SUBMISSION
        // =====================================================

        deleteForm.addEventListener("submit", function (event) {

            if (!categoryIdInput.value) {
                event.preventDefault();
                return;
            }

            confirmButton.disabled = true;
            confirmButton.innerHTML = `
                <i class="fas fa-spinner fa-spin me-1"></i>
                Reactivating...
            `;

        });

        // =====================================================
        // HTML ESCAPING
        // =====================================================

        function escapeHtml(value) {

            const element = document.createElement("div");
            element.textContent = value ?? "";

            return element.innerHTML;
        }

        // =====================================================
        // LIVE SEARCH - INACTIVE CATEGORIES
        // =====================================================

        let searchTimeout;

        if (searchBox && categoryTable) {

            // Preserve the initial server-rendered rows
            const originalRows = Array.from(categoryTable.children);

            searchBox.addEventListener("input", function () {

                const term = this.value.trim();

                clearTimeout(searchTimeout);

                searchTimeout = setTimeout(function () {

                    // Restore original rows when search is cleared
                    if (term === "") {
                        categoryTable.replaceChildren(...originalRows);
                        return;
                    }

                    fetch(
                        '/Manager/SearchCategoriesLive?term=' +
                        encodeURIComponent(term),
                        {
                            headers: {
                                "X-Requested-With": "XMLHttpRequest"
                            }
                        }
                    )
                    .then(response => {

                        if (!response.ok) {
                            throw new Error("Unable to search categories.");
                        }

                        return response.json();

                    })
                    .then(data => {

                        let rows = "";

                        if (!Array.isArray(data) || data.length === 0) {

                            rows = `
                                <tr>
                                    <td colspan="5"
                                        class="text-center text-muted py-3">
                                        No categories found.
                                    </td>
                                </tr>
                            `;

                        } else {

                            data.forEach(item => {

                                const id =
                                    item.categoryId ??
                                    item.categoryID ??
                                    item.CategoryId ??
                                    item.CategoryID;

                                const rawName =
                                    item.categoryName ??
                                    item.CategoryName ??
                                    "";

                                const rawDescription =
                                    item.categoryDescription ??
                                    item.CategoryDescription ??
                                    "";

                                const name = escapeHtml(rawName);
                                const description = escapeHtml(rawDescription);

                                const isActive =
                                    item.isActive ??
                                    item.IsActive ??
                                    false;

                                const testTypeCount =
                                    item.testTypeCount ??
                                    item.TestTypeCount ??
                                    0;

                                const status = isActive
                                    ? '<span class="badge bg-success">Active</span>'
                                    : '<span class="badge bg-danger">Inactive</span>';

                                // Inactive categories show Reactivate.
                                // Active categories show Deactivate.
                                const actionButton = isActive
                                    ? `
                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger deactivate-category-btn"
                                                data-id="${escapeHtml(id)}"
                                                data-name="${name}"
                                                title="Deactivate category">
                                            <i class="fas fa-ban"></i>
                                        </button>
                                      `
                                    : `
                                        <button type="button"
                                                class="btn btn-sm btn-outline-success activate-category-btn"
                                                data-id="${escapeHtml(id)}"
                                                data-name="${name}"
                                                title="Reactivate category">
                                            <i class="fas fa-check-circle"></i>
                                        </button>
                                      `;

                                rows += `
                                    <tr>
                                        <td class="fw-semibold blue-text">
                                            ${name}
                                        </td>

                                        <td>
                                            ${description}
                                        </td>

                                        <td>
                                            ${escapeHtml(testTypeCount)}
                                        </td>

                                        <td>
                                            ${status}
                                        </td>

                                        <td>
                                            <a href="/Manager/EditCategory/${encodeURIComponent(id ?? "")}"
                                               class="btn btn-sm btn-outline-primary me-1"
                                               title="Edit category">
                                                <i class="fas fa-edit"></i>
                                            </a>

                                            ${actionButton}
                                        </td>
                                    </tr>
                                `;
                            });
                        }

                        categoryTable.innerHTML = rows;

                    })
                    .catch(error => {

                        console.error("Category search failed:", error);

                        categoryTable.innerHTML = `
                            <tr>
                                <td colspan="5"
                                    class="text-center text-danger py-3">
                                    Unable to load categories. Please try again.
                                </td>
                            </tr>
                        `;

                    });

                }, 250);

            });
        }

    });
</script>
