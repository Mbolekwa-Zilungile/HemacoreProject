@model List<HemaCore.Models.SampleType>

@{
    ViewData["Title"] = "Active Sample Types";
    Layout = "_ManagerLayout";
}

<link rel="stylesheet" href="~/css/doctor.css" />
<link rel="stylesheet" href="~/css/delete.css" />

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<div class="content-card">

    <!-- =====================================================
         HEADER
         ===================================================== -->

    <div class="section-title d-flex align-items-center justify-content-between">

        <div class="d-flex align-items-center">
            <i class="fas fa-vial me-2"></i>

            <span>
                Active Sample Types (@(Model?.Count ?? 0))
            </span>
        </div>

        <a asp-action="AddSampleType"
           asp-controller="Manager"
           class="btn btn-primary-custom btn-sm">

            + Add Sample Type

        </a>

    </div>

    <!-- =====================================================
         SEARCH AND STATUS FILTER
         ===================================================== -->

    <div class="search-toolbar">

        <div class="search-box">

            <i class="fas fa-search search-icon"></i>

            <input type="text"
                   id="searchBox"
                   class="search-input"
                   placeholder="Search sample types..."
                   autocomplete="off" />

        </div>

        <div class="filter-box">

            <label for="statusFilter" class="filter-label">
                <i class="fas fa-filter me-1"></i>
            </label>

            <div class="select-wrapper">

                <select id="statusFilter"
                        class="filter-select"
                        onchange="if (this.value) window.location.href = this.value;">

                    <option value="@Url.Action("SampleTypes", "Manager")"
                            selected="@(ViewContext.RouteData.Values["action"]?.ToString() == "SampleTypes")">

                        Active Sample Types

                    </option>

                    <option value="@Url.Action("InactiveSampleTypes", "Manager")"
                            selected="@(ViewContext.RouteData.Values["action"]?.ToString() == "InactiveSampleTypes")">

                        Inactive Sample Types

                    </option>

                </select>

                <i class="fas fa-chevron-down dropdown-icon"></i>

            </div>

        </div>

    </div>

    <!-- =====================================================
         SAMPLE TYPES TABLE
         ===================================================== -->

    <div class="card shadow-sm">

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="modern-table">

                    <thead>

                        <tr>
                            <th>Sample Type Name</th>
                            <th>Description</th>
                            <th>Status</th>
                            <th class="text-center">Actions</th>
                        </tr>

                    </thead>

                    <tbody id="sampleTypeTable">

                        @if (Model != null && Model.Count > 0)
                        {
                            foreach (var sample in Model)
                            {
                                <tr>

                                    <td class="fw-semibold">
                                        @sample.SampleName
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(sample.Description)
                                            ? "No description"
                                            : sample.Description)
                                    </td>

                                    <td>

                                        @if (sample.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Inactive
                                            </span>
                                        }

                                    </td>

                                    <td class="text-center">

                                        <a asp-action="SampleTypeDetails"
                                           asp-route-id="@sample.SampleTypeId"
                                           class="btn btn-sm btn-outline-info me-1">

                                            <i class="fas fa-eye me-1"></i>
                                        </a>

                                        <a asp-action="EditSampleType"
                                           asp-controller="Manager"
                                           asp-route-id="@sample.SampleTypeId"
                                           class="btn btn-sm btn-outline-primary me-1"
                                           title="Edit sample type">

                                            <i class="fas fa-edit"></i>

                                        </a>

                                        <!-- DEACTIVATE ACTIVE SAMPLE TYPES -->
                                        @if (sample.IsActive)
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger deactivate-sample-btn"
                                                    data-id="@sample.SampleTypeId"
                                                    data-name="@sample.SampleName"
                                                    title="Deactivate sample type">

                                                <i class="fas fa-ban"></i>

                                            </button>
                                        }

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="4"
                                    class="text-center text-muted py-3">

                                    No sample types available.

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

<!-- =====================================================
     DEACTIVATE CONFIRMATION MODAL
     ===================================================== -->

<div id="deleteModal"
     class="delete-overlay"
     role="dialog"
     aria-modal="true"
     aria-hidden="true"
     aria-labelledby="deleteModalTitle">

    <div class="delete-box">

        <!-- ICON -->

        <div class="delete-icon">

            <i class="fas fa-exclamation-triangle"></i>

        </div>

        <!-- TITLE -->

        <h3 id="deleteModalTitle">
            Deactivate Sample Type?
        </h3>

        <!-- MESSAGE -->

        <p>
            Are you sure you want to deactivate
            <strong id="deleteSampleName"></strong>?
        </p>

        <!-- WARNING -->

        <span class="delete-warning">

            <i class="fas fa-info-circle"></i>

            This sample type will become inactive and unavailable for normal use.

        </span>

        <!-- BUTTONS -->

        <div class="delete-buttons">

            <!-- CANCEL -->

            <button type="button"
                    id="cancelDeleteBtn"
                    class="cancel-btn">

                Cancel

            </button>

            <!-- DEACTIVATE FORM -->

            <form asp-action="DeactivateSampleType"
                  asp-controller="Manager"
                  method="post"
                  id="deleteForm">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       id="deleteSampleTypeId" />

                <button type="submit"
                        id="confirmDeactivateBtn"
                        class="confirm-delete-btn">

                    <i class="fas fa-ban me-1"></i>

                    Yes, Deactivate

                </button>

            </form>

        </div>

    </div>

</div>

<!-- =====================================================
     LIVE SEARCH AND MODAL SCRIPT
     ===================================================== -->


<script>
    document.addEventListener("DOMContentLoaded", function () {

        // =====================================================
        // ELEMENTS
        // =====================================================

        const modal = document.getElementById("deleteModal");
        const sampleIdInput = document.getElementById("deleteSampleTypeId");
        const sampleNameElement = document.getElementById("deleteSampleName");
        const cancelButton = document.getElementById("cancelDeleteBtn");
        const deactivateForm = document.getElementById("deleteForm");
        const confirmButton = document.getElementById("confirmDeactivateBtn");
        const searchBox = document.getElementById("searchBox");
        const tableBody = document.getElementById("sampleTypeTable");
        const statusFilter = document.getElementById("statusFilter");

        let searchTimeout;
        let currentController = null;

        // Determine which page is currently displayed.
        const currentAction =
            '@ViewContext.RouteData.Values["action"]?.ToString()';

        const currentStatus =
            currentAction === "InactiveSampleTypes"
                ? "inactive"
                : "active";

        // Generate correct URLs using MVC routing.
        const detailsUrlTemplate =
            '@Url.Action("SampleTypeDetails", "Manager", new { id = "__id__" })';

        const editUrlTemplate =
            '@Url.Action("EditSampleType", "Manager", new { id = "__id__" })';

        // =====================================================
        // OPEN DEACTIVATION MODAL
        // =====================================================

        document.addEventListener("click", function (event) {

            const button = event.target.closest(".deactivate-sample-btn");

            if (!button || !modal) {
                return;
            }

            sampleIdInput.value = button.dataset.id || "";
            sampleNameElement.textContent = button.dataset.name || "";

            modal.classList.add("show");
            modal.setAttribute("aria-hidden", "false");

            document.body.classList.add("modal-open");

            if (cancelButton) {
                cancelButton.focus();
            }
        });

        // =====================================================
        // CLOSE MODAL
        // =====================================================

        function closeModal() {

            if (!modal) {
                return;
            }

            modal.classList.remove("show");
            modal.setAttribute("aria-hidden", "true");

            document.body.classList.remove("modal-open");

            sampleIdInput.value = "";
            sampleNameElement.textContent = "";

            if (confirmButton) {
                confirmButton.disabled = false;
                confirmButton.innerHTML =
                    '<i class="fas fa-ban me-1"></i> Yes, Deactivate';
            }
        }

        if (cancelButton) {
            cancelButton.addEventListener("click", closeModal);
        }

        // Close when clicking the overlay outside the dialog.
        if (modal) {
            modal.addEventListener("click", function (event) {

                if (event.target === modal) {
                    closeModal();
                }
            });
        }

        // Close when pressing Escape.
        document.addEventListener("keydown", function (event) {

            if (
                event.key === "Escape" &&
                modal &&
                modal.classList.contains("show")
            ) {
                closeModal();
            }
        });

        // =====================================================
        // PREVENT DOUBLE FORM SUBMISSION
        // =====================================================

        if (deactivateForm) {
            deactivateForm.addEventListener("submit", function (event) {

                if (!sampleIdInput.value) {
                    event.preventDefault();
                    return;
                }

                if (confirmButton) {
                    confirmButton.disabled = true;
                    confirmButton.innerHTML =
                        '<i class="fas fa-spinner fa-spin me-1"></i> Deactivating...';
                }
            });
        }

        // =====================================================
        // HTML ESCAPING
        // =====================================================

        function escapeHtml(value) {

            const element = document.createElement("div");
            element.textContent = value == null ? "" : String(value);

            return element.innerHTML;
        }

        // =====================================================
        // CREATE URL USING MVC ROUTING
        // =====================================================

        function createActionUrl(template, id) {

            return template.replace(
                "__id__",
                encodeURIComponent(String(id))
            );
        }

        // =====================================================
        // DISPLAY EMPTY MESSAGE
        // =====================================================

        function showMessage(message, className = "text-muted") {

            tableBody.innerHTML = `
                <tr>
                    <td colspan="4"
                        class="text-center ${className} py-3">
                        ${escapeHtml(message)}
                    </td>
                </tr>
            `;
        }

        // =====================================================
        // RENDER SEARCH RESULTS
        // =====================================================

        function renderSampleTypes(data) {

            if (!Array.isArray(data) || data.length === 0) {
                showMessage("No sample types found.");
                return;
            }

            let rows = "";

            data.forEach(function (sample) {

                const id =
                    sample.sampleTypeId ??
                    sample.SampleTypeId ??
                    sample.sampleTypeID ??
                    sample.SampleTypeID;

                const name =
                    sample.sampleName ??
                    sample.SampleName ??
                    "";

                const description =
                    sample.description ??
                    sample.Description ??
                    "";

                const isActive =
                    sample.isActive ??
                    sample.IsActive ??
                    false;

                // Do not render records belonging to the other status.
                if (
                    currentStatus === "active" && !isActive ||
                    currentStatus === "inactive" && isActive
                ) {
                    return;
                }

                if (id == null) {
                    return;
                }

                const safeName = escapeHtml(name);
                const safeDescription = escapeHtml(
                    description || "No description"
                );

                const detailsUrl = createActionUrl(
                    detailsUrlTemplate,
                    id
                );

                const editUrl = createActionUrl(
                    editUrlTemplate,
                    id
                );

                rows += `
                    <tr>
                        <td class="fw-semibold">
                            ${safeName}
                        </td>

                        <td>
                            ${safeDescription}
                        </td>

                        <td>
                            ${
                                isActive
                                    ? '<span class="badge bg-success">Active</span>'
                                    : '<span class="badge bg-danger">Inactive</span>'
                            }
                        </td>

                        <td class="text-center">

                            <a href="${detailsUrl}"
                               class="btn btn-sm btn-outline-info me-1"
                               title="View sample type">
                                <i class="fas fa-eye"></i>
                            </a>

                            <a href="${editUrl}"
                               class="btn btn-sm btn-outline-primary me-1"
                               title="Edit sample type">
                                <i class="fas fa-edit"></i>
                            </a>

                            ${
                                isActive
                                    ? `
                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger deactivate-sample-btn"
                                                data-id="${escapeHtml(id)}"
                                                data-name="${safeName}"
                                                title="Deactivate sample type">
                                            <i class="fas fa-ban"></i>
                                        </button>
                                      `
                                    : ""
                            }

                        </td>
                    </tr>
                `;
            });

            if (rows === "") {
                showMessage(
                    currentStatus === "active"
                        ? "No active sample types found."
                        : "No inactive sample types found."
                );
                return;
            }

            tableBody.innerHTML = rows;
        }

        // =====================================================
        // LIVE SEARCH
        // =====================================================

        if (searchBox && tableBody) {

            searchBox.addEventListener("input", function () {

                const term = this.value.trim();

                clearTimeout(searchTimeout);

                // Cancel an earlier request if the user keeps typing.
                if (currentController) {
                    currentController.abort();
                    currentController = null;
                }

                searchTimeout = setTimeout(async function () {

                    // Restore original rows when the search is cleared.
                    if (term === "") {
                        window.location.reload();
                        return;
                    }

                    currentController = new AbortController();

                    showMessage("Searching sample types...");

                    const url =
                        '@Url.Action("SearchSampleTypesLive", "Manager")' +
                        '?term=' + encodeURIComponent(term) +
                        '&status=' + encodeURIComponent(currentStatus);

                    try {

                        const response = await fetch(url, {
                            method: "GET",
                            headers: {
                                "X-Requested-With": "XMLHttpRequest"
                            },
                            signal: currentController.signal
                        });

                        if (!response.ok) {
                            throw new Error(
                                "Unable to search sample types."
                            );
                        }

                        const data = await response.json();

                        renderSampleTypes(data);

                    } catch (error) {

                        if (error.name === "AbortError") {
                            return;
                        }

                        console.error(
                            "Sample type search failed:",
                            error
                        );

                        showMessage(
                            "Search failed. Please try again.",
                            "text-danger"
                        );

                    } finally {
                        currentController = null;
                    }

                }, 300);
            });
        }

        // =====================================================
        // STATUS FILTER
        // =====================================================

        // The dropdown navigates to the appropriate MVC action.
        if (statusFilter) {
            statusFilter.addEventListener("change", function () {

                if (this.value) {
                    window.location.href = this.value;
                }
            });

            // Prevent duplicate navigation if inline onchange exists.
            statusFilter.removeAttribute("onchange");
        }

    });
</script>
