@model List<HemaCore.Models.SampleType>

@{
    Layout = "_ManagerLayout";
}

<link rel="stylesheet" href="~/css/doctor.css" />
<link rel="stylesheet" href="~/css/delete.css" />


@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}


<div class="content-card">

    <!-- HEADER -->
    <div class="section-title d-flex align-items-center justify-content-between">

        <div class="d-flex align-items-center">

            <i class="fas fa-vial me-2"></i>

            <span>
                Sample Types (@(Model?.Count ?? 0))
            </span>

        </div>

        <a asp-action="AddSampleType"
           class="btn btn-primary-custom btn-sm">

            + Add Sample Type

        </a>

    </div>


    <!-- SEARCH -->
    <input type="text"
           id="searchBox"
           class="form-control mb-3"
           placeholder="Type to search sample type..."
           autocomplete="off" />


    <!-- TABLE -->
    <div class="card shadow-sm">

        <div class="card-body p-0">

            <table class="modern-table">

                <thead>
                    <tr>

                        <th>
                            Sample Type Name
                        </th>

                        <th>
                            Description
                        </th>

                        <th>
                            Actions
                        </th>

                    </tr>
                </thead>


                <tbody id="TestTypeTable">

                    @if (Model != null && Model.Any())
                    {
                        foreach (var sample in Model)
                        {
                            <tr>

                                <td class="fw-semibold">
                                    @sample.SampleName
                                </td>

                                <td>
                                    @sample.Description
                                </td>

                                <td class="text-center">

                                    <!-- EDIT -->
                                    <a asp-action="EditSampleType"
                                       asp-route-id="@sample.SampleTypeId"
                                       class="btn btn-sm btn-outline-primary me-1">

                                        Edit

                                    </a>


                                    <!-- DELETE -->
                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger delete-sample-btn"
                                            data-id="@sample.SampleTypeId"
                                            data-name="@sample.SampleName">

                                        Delete

                                    </button>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="3"
                                class="text-center text-muted py-3">

                                No sample types available.

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>



<!-- =========================================================
     DELETE CONFIRMATION MODAL
     ========================================================= -->

<div id="deleteModal"
     class="delete-overlay"
     role="dialog"
     aria-modal="true"
     aria-labelledby="deleteModalTitle">

    <div class="delete-box">

        <!-- ICON -->
        <div class="delete-icon">

            <i class="fas fa-exclamation-triangle"></i>

        </div>


        <!-- TITLE -->
        <h3 id="deleteModalTitle">
            Are you sure?
        </h3>


        <!-- MESSAGE -->
        <p>

            Are you sure you want to delete

            <strong id="deleteSampleName"></strong>?

        </p>


        <!-- WARNING -->
        <span class="delete-warning">

            <i class="fas fa-info-circle"></i>

            This action cannot be undone.

        </span>


        <!-- BUTTONS -->
        <div class="delete-buttons">

            <!-- CANCEL -->
            <button type="button"
                    id="cancelDeleteBtn"
                    class="cancel-btn">

                Cancel

            </button>


            <!-- DELETE FORM -->
            <form asp-action="DeleteSampleType"
                  method="post"
                  id="deleteForm">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       id="deleteSampleTypeId" />

                <button type="submit"
                        class="confirm-delete-btn">

                    <i class="fas fa-trash-alt me-1"></i>

                    Yes, Delete

                </button>

            </form>

        </div>

    </div>

</div>



<!-- JQUERY -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>


<script>

    $(document).ready(function () {


    /* =====================================================
    OPEN DELETE MODAL
    ===================================================== */

    $(document).on("click", ".delete-sample-btn", function () {

    var id = $(this).attr("data-id");
    var sampleName = $(this).attr("data-name");

    $("#deleteSampleTypeId").val(id);

    $("#deleteSampleName").text(sampleName);

    $("#deleteModal").addClass("show");

    $("body").addClass("modal-open");

    });


    /* =====================================================
    CLOSE DELETE MODAL
    ===================================================== */

    function closeDeleteModal() {

    $("#deleteModal").removeClass("show");

    $("body").removeClass("modal-open");

    $("#deleteSampleTypeId").val("");

    $("#deleteSampleName").text("");

    }


    /* =====================================================
    CANCEL
    ===================================================== */

    $("#cancelDeleteBtn").on("click", function () {

    closeDeleteModal();

    });


    /* =====================================================
    CLICK OUTSIDE MODAL
    ===================================================== */

    $("#deleteModal").on("click", function (event) {

    if (event.target === this) {

    closeDeleteModal();

    }

    });


    /* =====================================================
    ESCAPE KEY
    ===================================================== */

    $(document).on("keydown", function (event) {

    if (event.key === "Escape") {

    if ($("#deleteModal").hasClass("show")) {

    closeDeleteModal();

    }

    }

    });


    /* =====================================================
    LIVE SEARCH
    ===================================================== */

    $("#searchBox").on("input", function () {

    var term = $(this).val().trim();

    $.ajax({

    url: '@Url.Action("SearchSampleTypesLive", "Manager")',

    type: "GET",

    data: {
    term: term
    },

    success: function (data) {

    var tableBody = $("#TestTypeTable");

    tableBody.empty();


    if (!data || data.length === 0) {

    tableBody.append(`

    <tr>

    <td colspan="3"
    class="text-center text-muted py-3">

    No sample types found

    </td>

    </tr>

    `);

    return;
    }


    $.each(data, function (index, sample) {

    var sampleName =
    sample.sampleName ?? "";

    var description =
    sample.description ?? "";

    var sampleTypeId =
    sample.sampleTypeId;


    /*
    * Escape HTML
    */

    var safeSampleName =
    $("<div>").text(sampleName).html();

    var safeDescription =
    $("<div>").text(description).html();


    var row = `

    <tr>

    <td class="fw-semibold">
    ${safeSampleName}
    </td>

    <td>
    ${safeDescription}
    </td>

    <td class="text-center">

    <a href="/Manager/EditSampleType/${sampleTypeId}"
    class="btn btn-sm btn-outline-primary me-1">

    Edit

    </a>


    <button type="button"
    class="btn btn-sm btn-outline-danger delete-sample-btn"
    data-id="${sampleTypeId}"
    data-name="${safeSampleName}">

    Delete

    </button>

    </td>

    </tr>

    `;

    tableBody.append(row);

    });

    },


    error: function () {

    $("#TestTypeTable").html(`

    <tr>

    <td colspan="3"
    class="text-center text-danger py-3">

    Search failed. Please try again.

    </td>

    </tr>

    `);

    }

    });

    });


    /* =====================================================
    PREVENT DOUBLE DELETE
    ===================================================== */

    $("#deleteForm").on("submit", function () {

    $(".confirm-delete-btn")
    .prop("disabled", true)
    .html(`
    <i class="fas fa-spinner fa-spin me-1"></i>
    Deleting...
    `);

    });

    });

</script>
