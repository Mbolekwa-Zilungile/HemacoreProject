@model List<HemaCore.Models.SampleType>

@{
    Layout = "_ManagerLayout";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<link rel="stylesheet" href="~/css/doctor.css" />
<link rel="stylesheet" href="" />


<div class="content-card">

    <!-- HEADER -->
    <div class="section-title d-flex align-items-center justify-content-between">

        <div class="d-flex align-items-center">
            <i class="fas fa-vial"></i>

            <span>
                Sample Types (@Model.Count)
            </span>
        </div>

        <a asp-action="AddSampleType"
           class="btn btn-primary-custom btn-sm">
            + Add Sample Type
        </a>

    </div>


    <!-- SEARCH -->
    <input type="text"
           id="searchBox"
           class="form-control mb-3"
           placeholder="Type to search sample type..." />


    <!-- TABLE -->
    <div class="card shadow-sm">

        <div class="card-body p-0">

            <table class="modern-table">

                <thead>
                    <tr>
                        <th>Sample Type Name</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>


                <tbody id="TestTypeTable">

                    @if (Model != null && Model.Any())
                    {
                        foreach (var sample in Model)
                        {
                            <tr>

                                <td class="fw-semibold">
                                    @sample.SampleName
                                </td>

                                <td>
                                    @sample.Description
                                </td>

                                <td class="text-center">

                                    <!-- EDIT -->
                                    <a asp-action="EditSampleType"
                                       asp-route-id="@sample.SampleTypeId"
                                       class="btn btn-sm btn-outline-primary me-1">
                                        Edit
                                    </a>


                                    <!-- DELETE -->
                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger"
                                            onclick="confirmDelete(
                                        '@sample.SampleTypeId',
                                        '@sample.SampleName'
                                        )">
                                        Delete
                                    </button>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="3"
                                class="text-center text-muted py-3">

                                No sample types available.

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>



<!-- ========================================================= -->
<!-- DELETE CONFIRMATION MODAL -->
<!-- ========================================================= -->

<div id="deleteModal"
     class="delete-overlay">

    <div class="delete-box">


        <!-- ICON -->
        <div class="delete-icon">

            <i class="fas fa-exclamation-triangle"></i>

        </div>


        <!-- TITLE -->
        <h3>
            Are you sure?
        </h3>


        <!-- MESSAGE -->
        <p>

            Are you sure you want to delete

            <strong id="deleteSampleName"></strong>?

        </p>


        <!-- WARNING -->
        <span class="delete-warning">

            <i class="fas fa-info-circle"></i>

            This action cannot be undone.

        </span>


        <!-- BUTTONS -->
        <div class="delete-buttons">


            <!-- CANCEL -->
            <button type="button"
                    class="cancel-btn"
                    onclick="closeDeleteModal()">

                Cancel

            </button>


            <!-- DELETE FORM -->
            <form asp-action="DeleteSampleType"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       id="deleteSampleTypeId" />

                <button type="submit"
                        class="confirm-delete-btn">

                    <i class="fas fa-trash-alt"></i>

                    Yes, Delete

                </button>

            </form>

        </div>

    </div>

</div>



<!-- ========================================================= -->
<!-- JAVASCRIPT -->
<!-- ========================================================= -->

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>

    /*
    * OPEN DELETE MODAL
    */
    function confirmDelete(id, sampleName) {

    document.getElementById("deleteSampleTypeId").value = id;

    document.getElementById("deleteSampleName").textContent =
    sampleName;

    document.getElementById("deleteModal").style.display = "flex";
    }


    /*
    * CLOSE DELETE MODAL
    */
    function closeDeleteModal() {

    document.getElementById("deleteModal").style.display = "none";
    }


    /*
    * CLOSE WHEN CLICKING OUTSIDE
    */
    document.getElementById("deleteModal").addEventListener(
    "click",
    function (event) {

    if (event.target === this) {
    closeDeleteModal();
    }

    }
    );


    /*
    * CLOSE WITH ESCAPE
    */
    document.addEventListener("keydown", function (event) {

    if (event.key === "Escape") {
    closeDeleteModal();
    }

    });



    /* =========================================================
    LIVE SEARCH
    ========================================================= */

    $("#searchBox").on("input", function () {

    var term = $(this).val();

    $.ajax({

    url: '@Url.Action("SearchSampleTypesLive", "Manager")',

    type: 'GET',

    data: {
    term: term
    },

    success: function (data) {

    var tableBody = $("#TestTypeTable");

    tableBody.empty();


    if (!data || data.length === 0) {

    tableBody.append(`

    <tr>

    <td colspan="3"
    class="text-center text-muted py-3">

    No sample types found

    </td>

    </tr>

    `);

    return;
    }


    $.each(data, function (index, sample) {

    var sampleName =
    sample.sampleName ?? "";

    var description =
    sample.description ?? "";


    var row = `

    <tr>

    <td class="fw-semibold">
    ${sampleName}
    </td>

    <td>
    ${description}
    </td>

    <td class="text-center">

    <a href="/Manager/EditSampleType/${sample.sampleTypeId}"
    class="btn btn-sm btn-outline-primary me-1">

    Edit

    </a>


    <button type="button"
    class="btn btn-sm btn-outline-danger"
    onclick="confirmDelete(
    '${sample.sampleTypeId}',
    '${sampleName.replace(/'/g, "\\'")}'
    )">

    Delete

    </button>

    </td>

    </tr>

    `;

    tableBody.append(row);

    });

    },


    error: function () {

    alert(
    "Search failed. Please try again."
    );

    }

    });

    });

</script>



