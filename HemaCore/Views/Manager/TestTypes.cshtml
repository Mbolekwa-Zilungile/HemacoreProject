@model List<HemaCore.Models.TestType>

@{
    Layout = "_ManagerLayout";
}

<link rel="stylesheet" href="~/css/doctor.css" />
<link rel="stylesheet" href="~/css/delete.css" />


@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}


<div class="content-card">

    <!-- =====================================================
         HEADER
         ===================================================== -->

    <div class="section-title d-flex align-items-center justify-content-between">

        <div class="d-flex align-items-center">

            <i class="fas fa-microscope me-2"></i>

            <span>
                Test Types (@(Model?.Count ?? 0))
            </span>

        </div>


        <a asp-action="AddTestType"
           class="btn btn-primary-custom btn-sm">

            + Add Test Type

        </a>

    </div>


    <div class="search-toolbar">

        <div class="search-box">
            <i class="fas fa-search search-icon"></i>

            <input type="text"
                   id="searchBox"
                   class="search-input"
                   placeholder="Search..."
                   autocomplete="off" />
        </div>

 
           
        <div class="filter-box">
            <label for="statusFilter" class="filter-label">
                <i class="fas fa-filter me-1"></i>
            </label>

            <div class="select-wrapper">
                <select id="statusFilter"
                        class="filter-select"
                        onchange="if (this.value) window.location.href = this.value;">

                    <option value="@Url.Action("TestTypes", "Manager")"
                            selected="@(ViewContext.RouteData.Values["action"]?.ToString() == "TestTypes")">
                        Active Test types
                    </option>

                    <option value="@Url.Action("InactiveTestTypes", "Manager")"
                            selected="@(ViewContext.RouteData.Values["action"]?.ToString() == "InactiveTestTypes")">
                        Inactive Test type
                    </option>

                </select>

                <i class="fas fa-chevron-down dropdown-icon"></i>
            </div>
        </div>

    </div>

    <div class="card shadow-sm">

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="modern-table">

                    <thead>

                        <tr>

                            <th>
                                Test Name
                            </th>

                            <th>
                                Category
                            </th>

                            <th>
                                Turnaround Time
                            </th>

                            <th>
                                Status
                            </th>
                            <th class="text-center">
                                Actions
                            </th>

                        </tr>

                    </thead>


                    <tbody id="TestTypeTable">

                        @if (Model != null && Model.Any())
                        {
                            foreach (var test in Model)
                            {
                                <tr>

                                    <!-- TEST NAME -->

                                    <td class="fw-semibold">

                                        @test.TestTypeName.ToUpper()

                                    </td>


                                    <!-- CATEGORY -->

                                    <td>

                                        <span class="fw-semibold">

                                            @test.Category?.CategoryName.ToUpper()

                                        </span>

                                    </td>

                                    <td>

                                        <span class="badge bg-info text-dark">

                                            @test.TurnAroundTime min

                                        </span>

                                    </td>

                                    <td>
                                        @if (test.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Inactive</span>
                                        }
                                    </td>
                                    <td class="text-center">

                                        <!-- DETAILS -->

                                        <a asp-action="TestTypeDetails"
                                           asp-route-id="@test.TestTypeId"
                                           class="btn btn-sm btn-outline-info me-1">

                                            <i class="fas fa-eye me-1"></i>
                                        </a>


                                        <!-- EDIT -->

                                        <a asp-action="EditTestType"
                                           asp-route-id="@test.TestTypeId"
                                           class="btn btn-sm btn-outline-primary me-1">

                                            <i class="fas fa-edit me-1"></i>
                                        </a>


                                        <!-- DELETE -->

                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger delete-test-btn"
                                                data-id="@test.TestTypeId"
                                                data-name="@test.TestTypeName">

                                            <i class="fas fa-ban"></i>
                                        </button>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="4"
                                    class="text-center text-muted py-3">

                                    No test types available.

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>



<!-- =========================================================
     DELETE CONFIRMATION MODAL
     ========================================================= -->

<div id="deleteModal"
     class="delete-overlay"
     role="dialog"
     aria-modal="true"
     aria-labelledby="deleteModalTitle">


    <div class="delete-box">


        <!-- ICON -->

        <div class="delete-icon">

            <i class="fas fa-exclamation-triangle"></i>

        </div>


        <!-- TITLE -->

        <h3 id="deleteModalTitle">

            Are you sure?

        </h3>


        <!-- MESSAGE -->

        <p>

            Are you sure you want to delete

            <strong id="deleteTestName"></strong>?

        </p>


        <!-- WARNING -->

        <span class="delete-warning">

            <i class="fas fa-info-circle"></i>

            This action cannot be undone.

        </span>


        <!-- BUTTONS -->

        <div class="delete-buttons">


            <!-- CANCEL -->

            <button type="button"
                    id="cancelDeleteBtn"
                    class="cancel-btn">

                Cancel

            </button>


            <!-- DELETE FORM -->

            <form asp-action="DeleteTestType"
                  method="post"
                  id="deleteForm">

                @Html.AntiForgeryToken()


                <input type="hidden"
                       name="id"
                       id="deleteTestTypeId" />


                <button type="submit"
                        class="confirm-delete-btn">

                    <i class="fas fa-trash-alt me-1"></i>

                    Yes, Delete

                </button>

            </form>

        </div>

    </div>

</div>



<!-- =========================================================
     JQUERY
     ========================================================= -->

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>



<script>
    document.addEventListener("DOMContentLoaded", function () {

    // =====================================================
    // ELEMENTS
    // =====================================================

    const modal = document.getElementById("deleteModal");
    const testIdInput = document.getElementById("deleteTestTypeId");
    const testNameElement = document.getElementById("deleteTestName");
    const cancelButton = document.getElementById("cancelDeleteBtn");
    const deleteForm = document.getElementById("deleteForm");
    const confirmButton = deleteForm?.querySelector(".confirm-delete-btn");
    const searchBox = document.getElementById("searchBox");
    const testTable = document.getElementById("TestTypeTable");

    if (!modal || !testIdInput || !testNameElement ||
    !cancelButton || !deleteForm || !confirmButton ||
    !searchBox || !testTable) {
    console.error("Test Types page elements could not be found.");
    return;
    }

    // =====================================================
    // HELPER: ESCAPE HTML
    // =====================================================

    function escapeHtml(value) {
    const element = document.createElement("div");
    element.textContent = value == null ? "" : String(value);
    return element.innerHTML;
    }

    // =====================================================
    // HELPER: GET PROPERTY WITH DIFFERENT JSON CASING
    // =====================================================

    function getValue(object, ...keys) {
    for (const key of keys) {
    if (object[key] !== undefined && object[key] !== null) {
    return object[key];
    }
    }

    return "";
    }

    // =====================================================
    // OPEN DELETE MODAL
    // Works for both original and dynamically searched rows
    // =====================================================

    document.addEventListener("click", function (event) {

    const button = event.target.closest(".delete-test-btn");

    if (!button) return;

    const id = button.getAttribute("data-id");
    const name = button.getAttribute("data-name");

    if (!id) return;

    testIdInput.value = id;
    testNameElement.textContent = name || "this test type";

    modal.classList.add("show");
    document.body.classList.add("modal-open");

    cancelButton.focus();
    });

    // =====================================================
    // CLOSE DELETE MODAL
    // =====================================================

    function closeDeleteModal() {
    modal.classList.remove("show");
    document.body.classList.remove("modal-open");

    testIdInput.value = "";
    testNameElement.textContent = "";
    }

    cancelButton.addEventListener("click", closeDeleteModal);

    // Click outside modal
    modal.addEventListener("click", function (event) {
    if (event.target === modal) {
    closeDeleteModal();
    }
    });

    // Escape key
    document.addEventListener("keydown", function (event) {
    if (event.key === "Escape" && modal.classList.contains("show")) {
    closeDeleteModal();
    }
    });

    // =====================================================
    // PREVENT DOUBLE DELETE
    // =====================================================

    deleteForm.addEventListener("submit", function () {
    confirmButton.disabled = true;

    confirmButton.innerHTML = `
    <i class="fas fa-spinner fa-spin me-1"></i>
    Deleting...
    `;
    });

    // =====================================================
    // LIVE SEARCH TEST TYPES
    // =====================================================

    let searchTimeout;
    let searchController = null;

    async function searchTestTypes(term) {

    // Cancel any previous search request
    if (searchController) {
    searchController.abort();
    }

    searchController = new AbortController();

    testTable.innerHTML = `
    <tr>
    <td colspan="5" class="text-center text-muted py-3">
    <i class="fas fa-spinner fa-spin me-2"></i>
    Searching test types...
    </td>
    </tr>
    `;

    try {

    const url =
    '@Url.Action("SearchTestTypesLive", "Manager")' +
    '?term=' + encodeURIComponent(term);

    const response = await fetch(url, {
    method: "GET",
    headers: {
    "X-Requested-With": "XMLHttpRequest"
    },
    signal: searchController.signal
    });

    if (!response.ok) {
    throw new Error("Unable to search test types.");
    }

    const data = await response.json();

    let rows = "";

    // No results
    if (!Array.isArray(data) || data.length === 0) {

    testTable.innerHTML = `
    <tr>
    <td colspan="5"
    class="text-center text-muted py-3">
    No test types found.
    </td>
    </tr>
    `;

    return;
    }

    // Build table rows
    data.forEach(function (test) {

    const id = getValue(
    test,
    "testTypeId",
    "TestTypeId",
    "testTypeID",
    "TestTypeID"
    );

    if (id === "") return;

    const name = getValue(
    test,
    "name",
    "Name",
    "testTypeName",
    "TestTypeName"
    );

    const category = getValue(
    test,
    "category",
    "Category",
    "categoryName",
    "CategoryName"
    );

    const turnaround = getValue(
    test,
    "turnaround",
    "Turnaround",
    "turnAroundTime",
    "TurnAroundTime"
    );

    const isActiveValue = getValue(
    test,
    "isActive",
    "IsActive"
    );

    const isActive =
    isActiveValue === true ||
    isActiveValue === 1 ||
    String(isActiveValue).toLowerCase() === "true";

    const safeName = escapeHtml(name);
    const safeCategory = escapeHtml(
    category || "Not assigned"
    );

    const safeTurnaround = escapeHtml(
    turnaround === "" ? "N/A" : turnaround
    );

    const safeId = encodeURIComponent(id);

    const statusBadge = isActive
    ? '<span class="badge bg-success">Active</span>'
    : '<span class="badge bg-danger">Inactive</span>';

    // Generate MVC URLs
    const detailsUrl =
    '@Url.Action("TestTypeDetails", "Manager")' +
    '?id=' + safeId;

    const editUrl =
    '@Url.Action("EditTestType", "Manager")' +
    '?id=' + safeId;

    rows += `
    <tr>

    <td class="fw-semibold">
    ${safeName}
    </td>

    <td>
    <span class="fw-semibold">
    ${safeCategory}
    </span>
    </td>

    <td>
    <span class="badge bg-info text-dark">
    ${safeTurnaround} min
    </span>
    </td>

    <td>
    ${statusBadge}
    </td>

    <td class="text-center">

    <a href="${detailsUrl}"
    class="btn btn-sm btn-outline-info me-1"
    title="View details">
    <i class="fas fa-eye"></i>
    </a>

    <a href="${editUrl}"
    class="btn btn-sm btn-outline-primary me-1"
    title="Edit test type">
    <i class="fas fa-edit"></i>
    </a>

    ${isActive ? `
    <button type="button"
    class="btn btn-sm btn-outline-danger delete-test-btn"
    data-id="${escapeHtml(id)}"
    data-name="${safeName}"
    title="Delete test type">
    <i class="fas fa-ban"></i>
    </button>
    ` : ""}

    </td>

    </tr>
    `;
    });

    if (rows === "") {
    testTable.innerHTML = `
    <tr>
    <td colspan="5"
    class="text-center text-muted py-3">
    No matching test types found.
    </td>
    </tr>
    `;
    return;
    }

    testTable.innerHTML = rows;

    } catch (error) {

    // Ignore cancelled requests
    if (error.name === "AbortError") {
    return;
    }

    console.error("Test type search failed:", error);

    testTable.innerHTML = `
    <tr>
    <td colspan="5"
    class="text-center text-danger py-3">
    Unable to load test types. Please try again.
    </td>
    </tr>
    `;
    }
    }

    // =====================================================
    // SEARCH WHEN USER TYPES
    // =====================================================

    searchBox.addEventListener("input", function () {

    const term = this.value.trim();

    clearTimeout(searchTimeout);

    searchTimeout = setTimeout(function () {
    searchTestTypes(term);
    }, 300);
    });

    });
</script>
