@model List<HemaCore.Models.TestCategory>

@{
    Layout = "_ManagerLayout";
}


<link rel="stylesheet" href="~/css/doctor.css" />


@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

<div class="content-card">

    <!-- HEADER -->
    <div class="section-title d-flex align-items-center justify-content-between">

        <div class="d-flex align-items-center">
            <i class="fas fa-folder"></i>

            <span>Test Categories (@Model.Count)</span>

   
        </div>

        <a asp-action="AddCategory"
           class="btn btn-primary-custom btn-sm">
            + Add Category
        </a>

    </div>

    <!-- SEARCH -->
    <input type="text"
           id="searchBox"
           class="form-control mb-3"
           placeholder="Search test categories..." />

    <!-- TABLE -->
    <table class="modern-table">

        <thead>
            <tr>
                <th>Category Name</th>
                <th>Description</th>
                <th>Test Types</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody id="categoryTable">

            @if (!Model.Any())
            {
                <tr>
                    <td colspan="4" class="text-center text-muted">
                        No test categories available.
                    </td>
                </tr>
            }
            else
            {
                @foreach (var category in Model)
                {
                    <tr>
                        <td class="fw-semibold blue-text">
                            @category.CategoryName
                        </td>

                        <td>
                            @category.CategoryDescription
                        </td>

                        <td>
                            @(ViewBag.TestTypeCountByCategory != null &&
                                                ViewBag.TestTypeCountByCategory.ContainsKey(category.CategoryId)
                                                ? ViewBag.TestTypeCountByCategory[category.CategoryId]
                                                : 0)
                        </td>

                        <td>
                            <a asp-action="EditCategory"
                               asp-route-id="@category.CategoryId"
                               class="btn btn-sm btn-primary me-1">
                                Edit
                            </a>

                            <a href="#"
                               class="btn btn-sm btn-danger"
                               onclick="confirmDelete(@category.CategoryId)">
                                Deactivate
                            </a>
                        </td>
                    </tr>
                }
            }

        </tbody>

    </table>

</div>

<!-- SCRIPT -->
<script>
    document.getElementById("searchBox").addEventListener("keyup", function () {

        let term = this.value;

        fetch('/Manager/SearchCategoriesLive?term=' + term)
            .then(res => res.json())
            .then(data => {

                let rows = "";

                if (data.length === 0) {
                    rows = `
                        <tr>
                            <td colspan="4" class="text-center text-muted">
                                No results found.
                            </td>
                        </tr>
                    `;
                }
                else {
                    data.forEach(item => {
                        rows += `
                            <tr>
                                <td class="fw-semibold blue-text">
                                    ${item.categoryName}
                                </td>

                                <td>
                                    ${item.categoryDescription ?? ""}
                                </td>

                                <td>0</td>

                                <td>
                                    <a href="/Manager/EditCategory/${item.categoryID}"
                                       class="btn btn-sm btn-primary me-1">
                                        Edit
                                    </a>

                                    <a href="/Manager/DeleteCategory/${item.categoryID}"
                                       class="btn btn-sm btn-danger">
                                        Delete
                                    </a>
                                </td>
                            </tr>
                        `;
                    });
                }

                document.getElementById("categoryTable").innerHTML = rows;
            });
    });

    function confirmDelete(id) {
        if (confirm("Are you sure you want to delete this category?")) {
            window.location.href = '/Manager/DeleteCategory/' + id;
        }
    }
</script>