@model List<HemaCore.Models.TestCategory>

@{
    Layout = "_ManagerLayout";
}

<link rel="stylesheet" href="~/css/doctor.css" />
<link rel="stylesheet" href="~/css/delete.css" />

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}



<div class="content-card">

    <div class="section-title d-flex align-items-center justify-content-between">

        <div class="d-flex align-items-center">

            <i class="fas fa-folder me-2"></i>

            <span>
                Active Test Categories (@(Model?.Count ?? 0))
            </span>

        </div>


        <a asp-action="AddCategory"
           class="btn btn-primary-custom btn-sm">

            + Add Category

        </a>

    </div>



     <div class="search-toolbar">

            <div class="search-box">
                <i class="fas fa-search search-icon"></i>

                <input type="text"
                       id="searchBox"
                       class="search-input"
                       placeholder="Search..."
                       autocomplete="off" />
            </div>

 
           
        <div class="filter-box">
            <label for="statusFilter" class="filter-label">
                <i class="fas fa-filter me-1"></i>
            </label>

            <div class="select-wrapper">
                <select id="statusFilter"
                        class="filter-select"
                        onchange="if (this.value) window.location.href = this.value;">

                    <option value="@Url.Action("TestCategories", "Manager")"
                            selected="@(ViewContext.RouteData.Values["action"]?.ToString() == "TestCategories")">
                        Active Test types
                    </option>

                    <option value="@Url.Action("InactiveTestCategories", "Manager")"
                            selected="@(ViewContext.RouteData.Values["action"]?.ToString() == "InactiveTestCategories")">
                        Inactive Test types
                    </option>

                </select>

                <i class="fas fa-chevron-down dropdown-icon"></i>
            </div>
        </div>

        </div>


    <table class="modern-table">

        <thead>

            <tr>

                <th>
                    Category Name
                </th>

                <th>
                    Description
                </th>

                <th>
                    Test Types
                </th>

                <th>
                    Status
                </th>

                <th>
                    Actions
                </th>

            </tr>

        </thead>


        <tbody id="categoryTable">

            @if (Model == null || !Model.Any())
            {
                <tr>

                    <td colspan="5"
                        class="text-center text-muted">

                        No active test categories available.

                    </td>

                </tr>
            }
            else
            {
                foreach (var category in Model)
                {
                    <tr>

                        <!-- CATEGORY NAME -->
                        <td class="fw-semibold blue-text">

                            @category.CategoryName

                        </td>


                        <!-- DESCRIPTION -->
                        <td>

                            @category.CategoryDescription

                        </td>


                        <!-- TEST TYPES -->
                        <td>

                            @(ViewBag.TestTypeCountByCategory != null &&
                                                    ViewBag.TestTypeCountByCategory.ContainsKey(category.CategoryId)
                                                    ? ViewBag.TestTypeCountByCategory[category.CategoryId]
                                                    : 0)

                        </td>

                        <td>
                                @if (category.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactive</span>
                                }
                         </td>
                       
                      
                        <td>
                            <a asp-action="CategoryDetails"
                               asp-route-id="@category.CategoryId"
                               class="btn btn-sm btn-outline-info me-1">

                                <i class="fas fa-eye me-1"></i>
                            </a>
                            <!-- EDIT -->
                            <a asp-action="EditCategory"
                               asp-route-id="@category.CategoryId"
                               class="btn btn-sm btn-outline-primary me-1">

                                <i class="fas fa-edit me-1"></i>

                            </a>


                            <!-- DEACTIVATE -->
                            <button type="button"
                                    class="btn btn-sm btn-outline-danger deactivate-category-btn"
                                    data-id="@category.CategoryId"
                                    data-name="@category.CategoryName">

                                <i class="fas fa-ban"></i>

                            </button>

                        </td>

                    </tr>
                }
            }

        </tbody>

    </table>

</div>



<!-- =========================================================
     DEACTIVATE MODAL
     ========================================================= -->

<div id="deleteModal"
     class="delete-overlay"
     role="dialog"
     aria-modal="true"
     aria-labelledby="deleteModalTitle">

    <div class="delete-box">


        <!-- ICON -->
        <div class="delete-icon">

            <i class="fas fa-exclamation-triangle"></i>

        </div>


        <!-- TITLE -->
        <h3 id="deleteModalTitle">

            Are you sure?

        </h3>


        <!-- MESSAGE -->
        <p>

            Are you sure you want to deactivate

            <strong id="deleteSampleName"></strong>?

        </p>


        <!-- WARNING -->
        <span class="delete-warning">

            <i class="fas fa-info-circle"></i>

            This category will no longer be active.

        </span>


        <div class="delete-buttons">


            <button type="button"
                    id="cancelDeleteBtn"
                    class="cancel-btn">

                Cancel

            </button>


            <!-- DEACTIVATE FORM -->
            <form asp-action="DeleteCategory"
                  method="post"
                  id="deleteForm">

                @Html.AntiForgeryToken()


                <!-- CATEGORY ID -->
                <input type="hidden"
                       name="id"
                       id="deleteSampleTypeId" />


                <!-- CONFIRM -->
                <button type="submit"
                        id="confirmDeleteBtn"
                        class="confirm-delete-btn">

                    <i class="fas fa-ban me-1"></i>

                    Yes, Deactivate

                </button>

            </form>

        </div>

    </div>

</div>



<!-- =========================================================
     JAVASCRIPT
     ========================================================= -->


<script>
    document.addEventListener("DOMContentLoaded", function () {

        // =====================================================
        // ELEMENTS
        // =====================================================

        const modal = document.getElementById("deleteModal");
        const categoryIdInput = document.getElementById("deleteSampleTypeId");
        const categoryName = document.getElementById("deleteSampleName");
        const cancelButton = document.getElementById("cancelDeleteBtn");
        const deleteForm = document.getElementById("deleteForm");
        const confirmDeleteBtn = document.getElementById("confirmDeleteBtn");
        const searchBox = document.getElementById("searchBox");
        const categoryTable = document.getElementById("categoryTable");

        if (!modal || !categoryIdInput || !categoryName ||
            !cancelButton || !deleteForm || !confirmDeleteBtn ||
            !searchBox || !categoryTable) {
            console.error("One or more Test Categories page elements are missing.");
            return;
        }

        // =====================================================
        // HTML ESCAPING
        // =====================================================

        function escapeHtml(value) {
            const div = document.createElement("div");
            div.textContent = value == null ? "" : String(value);
            return div.innerHTML;
        }

        // =====================================================
        // OPEN DEACTIVATE MODAL
        // =====================================================

        document.addEventListener("click", function (event) {

            const button = event.target.closest(".deactivate-category-btn");

            if (!button) return;

            const id = button.getAttribute("data-id");
            const name = button.getAttribute("data-name");

            if (!id) return;

            categoryIdInput.value = id;
            categoryName.textContent = name || "this category";

            modal.classList.add("show");
            document.body.classList.add("modal-open");

            cancelButton.focus();
        });

        // =====================================================
        // CLOSE DEACTIVATE MODAL
        // =====================================================

        function closeModal() {
            modal.classList.remove("show");
            document.body.classList.remove("modal-open");

            categoryIdInput.value = "";
            categoryName.textContent = "";
        }

        cancelButton.addEventListener("click", closeModal);

        // Close when clicking outside the modal box
        modal.addEventListener("click", function (event) {
            if (event.target === modal) {
                closeModal();
            }
        });

        // Close with Escape key
        document.addEventListener("keydown", function (event) {
            if (event.key === "Escape" &&
                modal.classList.contains("show")) {
                closeModal();
            }
        });

        // =====================================================
        // PREVENT DOUBLE FORM SUBMISSION
        // =====================================================

        deleteForm.addEventListener("submit", function () {

            confirmDeleteBtn.disabled = true;

            confirmDeleteBtn.innerHTML = `
                <i class="fas fa-spinner fa-spin me-1"></i>
                Deactivating...
            `;
        });

        // =====================================================
        // LIVE SEARCH TEST CATEGORIES
        // Searches category name and description
        // =====================================================

        let searchTimeout;
        let searchController = null;

        async function searchCategories(term) {

            // Cancel the previous request if it is still running
            if (searchController) {
                searchController.abort();
            }

            searchController = new AbortController();

            categoryTable.innerHTML = `
                <tr>
                    <td colspan="5" class="text-center text-muted py-3">
                        <i class="fas fa-spinner fa-spin me-2"></i>
                        Searching test categories...
                    </td>
                </tr>
            `;

            try {
                const url =
                    '@Url.Action("SearchCategoriesLive", "Manager")' +
                    '?term=' + encodeURIComponent(term);

                const response = await fetch(url, {
                    method: "GET",
                    headers: {
                        "X-Requested-With": "XMLHttpRequest"
                    },
                    signal: searchController.signal
                });

                if (!response.ok) {
                    throw new Error("Unable to load test categories.");
                }

                const data = await response.json();

                if (!Array.isArray(data) || data.length === 0) {
                    categoryTable.innerHTML = `
                        <tr>
                            <td colspan="5"
                                class="text-center text-muted py-3">
                                No active test categories found.
                            </td>
                        </tr>
                    `;
                    return;
                }

                let rows = "";

                data.forEach(function (item) {

                    // Support camelCase and PascalCase JSON properties
                    const id =
                        item.categoryId ?? item.CategoryId ??
                        item.categoryID ?? item.CategoryID;

                    const rawName =
                        item.categoryName ?? item.CategoryName ?? "";

                    const rawDescription =
                        item.categoryDescription ??
                        item.CategoryDescription ?? "";

                    const isActive =
                        item.isActive ?? item.IsActive ?? true;

                    const count =
                        item.testTypeCount ??
                        item.TestTypeCount ?? 0;

                    if (id == null) return;

                    const name = escapeHtml(rawName);
                    const description = escapeHtml(
                        rawDescription || "No description available"
                    );

                    const statusBadge = isActive
                        ? '<span class="badge bg-success">Active</span>'
                        : '<span class="badge bg-danger">Inactive</span>';

                    const detailsUrl =
                        '@Url.Action("CategoryDetails", "Manager")' +
                        '?id=' + encodeURIComponent(id);

                    const editUrl =
                        '@Url.Action("EditCategory", "Manager")' +
                        '?id=' + encodeURIComponent(id);

                    rows += `
                        <tr>
                            <td class="fw-semibold blue-text">
                                ${name}
                            </td>

                            <td>${description}</td>

                            <td>${Number(count) || 0}</td>

                            <td>${statusBadge}</td>

                            <td>
                                <a href="${detailsUrl}"
                                   class="btn btn-sm btn-outline-info me-1"
                                   title="View category">
                                    <i class="fas fa-eye"></i>
                                </a>

                                <a href="${editUrl}"
                                   class="btn btn-sm btn-outline-primary me-1"
                                   title="Edit category">
                                    <i class="fas fa-edit"></i>
                                </a>

                                ${isActive ? `
                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger deactivate-category-btn"
                                            data-id="${escapeHtml(id)}"
                                            data-name="${name}"
                                            title="Deactivate category">
                                        <i class="fas fa-ban"></i>
                                    </button>
                                ` : ""}
                            </td>
                        </tr>
                    `;
                });

                if (rows === "") {
                    rows = `
                        <tr>
                            <td colspan="5"
                                class="text-center text-muted py-3">
                                No matching test categories found.
                            </td>
                        </tr>
                    `;
                }

                categoryTable.innerHTML = rows;

            } catch (error) {

                if (error.name === "AbortError") {
                    return;
                }

                console.error("Live category search failed:", error);

                categoryTable.innerHTML = `
                    <tr>
                        <td colspan="5"
                            class="text-center text-danger py-3">
                            Unable to load test categories.
                            Please try again.
                        </td>
                    </tr>
                `;
            }
        }

        // =====================================================
        // SEARCH AS THE USER TYPES
        // =====================================================

        searchBox.addEventListener("input", function () {

            const term = this.value.trim();

            clearTimeout(searchTimeout);

            searchTimeout = setTimeout(function () {
                searchCategories(term);
            }, 300);
        });

    });
</script>

