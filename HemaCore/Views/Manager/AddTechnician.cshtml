@model HemaCore.ViewModels.ManagerVM.TechnicianViewModel

@{
    ViewData["Title"] = "Add Lab Technician";
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"] <button type="button"
                                     class="btn-close"
                                     data-bs-dismiss="alert"
                                     aria-label="Close"> </button>
    </div>
}

<link rel="stylesheet" href="~/css/doctor.css" />

<div class="container mt-4 mb-5">

    <div class="card shadow-sm p-4">

        <div class="mb-4">
            <h3 class="fw-bold">
                Add Lab Technician
            </h3>

            <p class="text-muted mb-0">
                Fill in the details below to add a new lab technician
                in the system.
            </p>
        </div>


        <!-- ========================= -->
        <!-- VALIDATION SUMMARY -->
        <!-- ========================= -->

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger"
             role="alert">
        </div>


        <!-- ========================= -->
        <!-- FORM -->
        <!-- ========================= -->

        <form asp-action="AddTechnician"
              method="post">

            @Html.AntiForgeryToken()


            <!-- ========================= -->
            <!-- PERSONAL DETAILS -->
            <!-- ========================= -->

            <h5 class="text-secondary mb-3">
                Personal Details
            </h5>

            <div class="row">

                <!-- NAME -->
                <div class="col-md-6 mb-3">

                    <label asp-for="Name"
                           class="form-label">
                    </label>

                    <input asp-for="Name"
                           class="form-control"
                           placeholder="First name"
                           autocomplete="given-name" />

                    <span asp-validation-for="Name"
                          class="text-danger small">
                    </span>

                </div>


                <!-- SURNAME -->
                <div class="col-md-6 mb-3">

                    <label asp-for="Surname"
                           class="form-label">
                    </label>

                    <input asp-for="Surname"
                           class="form-control"
                           placeholder="Last name"
                           autocomplete="family-name" />

                    <span asp-validation-for="Surname"
                          class="text-danger small">
                    </span>

                </div>


                <!-- ID NUMBER -->
                <div class="col-md-6 mb-3">

                    <label asp-for="IDNumber" class="form-label"></label>

                    <input asp-for="IDNumber"
                           id="IDNumber"
                           type="text"
                           class="form-control"
                           placeholder="Enter 13-digit ID number"
                           maxlength="13"
                           minlength="13"
                           inputmode="numeric"
                           pattern="[0-9]{13}"
                           autocomplete="off"
                           required />

                    <span asp-validation-for="IDNumber"
                          class="text-danger small"></span>

                    <small class="text-muted">
                        Enter exactly 13 digits. Numbers only.
                    </small>

                </div>

            </div>


            <!-- ========================= -->
            <!-- CONTACT DETAILS -->
            <!-- ========================= -->

            <h5 class="text-secondary mt-3 mb-3">
                Contact Details
            </h5>

            <div class="row">

                <!-- EMAIL -->
                <div class="col-md-6 mb-3">

                    <label asp-for="Email"
                           class="form-label">
                    </label>

                    <input asp-for="Email"
                           type="email"
                           class="form-control"
                           placeholder="Enter email address"
                           autocomplete="email" />

                    <span asp-validation-for="Email"
                          class="text-danger small">
                    </span>

                </div>


                <div class="col-md-6 mb-3">

                    <label asp-for="PhoneNumber" class="form-label"></label>

                    <input asp-for="PhoneNumber"
                           id="PhoneNumber"
                           type="text"
                           class="form-control"
                           placeholder="+27756455676"
                           maxlength="12"
                           minlength="1"
                           inputmode="tel"
                           autocomplete="tel"
                           pattern="\+?[0-9]{0,11}"
                           title="Only numbers and one leading + sign are allowed. Maximum 12 characters."
                           required />

                    <span asp-validation-for="PhoneNumber"
                          class="text-danger small"></span>

                    <small class="text-muted">
                        Only numbers and a single leading + sign are allowed.
                        Maximum 12 characters.
                    </small>

                </div>
            </div>


            <!-- ========================= -->
            <!-- TEST SPECIALIZATIONS -->
            <!-- ========================= -->

            <h5 class="mt-4 mb-3 text-secondary">
                Test Specializations
            </h5>

            <div class="card shadow-sm mb-3">

                <div class="card-body">

                    <p class="text-muted small mb-3">
                        Select the tests this technician is qualified
                        to perform.
                    </p>


                    <!-- SEARCH -->
                    <div class="input-group mb-3">

                        <span class="input-group-text">
                            🔍
                        </span>

                        <input type="text"
                               id="testTypeSearch"
                               class="form-control"
                               placeholder="Search test types..."
                               autocomplete="off" />

                        <button type="button"
                                id="clearTestSearch"
                                class="btn btn-outline-secondary"
                                style="display: none;">
                            Clear
                        </button>

                    </div>


                    <!-- SELECTED COUNT -->
                    <div class="d-flex justify-content-between
                        align-items-center mb-2">

                        <small class="text-muted">
                            <span id="selectedTestCount">0</span>
                            test(s) selected
                        </small>

                        <small class="text-muted">
                            <span id="visibleTestCount">
                                @(Model.TestTypes?.Count ?? 0)
                            </span>
                            test(s) shown
                        </small>

                    </div>


                    <!-- TEST LIST -->
                    <div id="testTypeList"
                         class="border rounded p-3"
                         style="max-height: 300px;
                        overflow-y: auto;">

                        @if (Model.TestTypes != null &&
                             Model.TestTypes.Any())
                        {
                            foreach (var test in Model.TestTypes)
                            {
                                <div class="form-check mb-2 test-type-item"
                                     data-test-name="@test.TestTypeName">

                                    <input type="checkbox"
                                           name="SelectedTestTypeIds"
                                           value="@test.TestTypeId"
                                           id="test_@test.TestTypeId"
                                           class="form-check-input test-type-checkbox" />

                                    <label class="form-check-label"
                                           for="test_@test.TestTypeId">

                                        <strong>
                                            @test.TestTypeName
                                        </strong>

                                    </label>

                                </div>
                            }

                            <div id="noTestResults"
                                 class="text-muted text-center py-4"
                                 style="display: none;">

                                <div class="mb-2"
                                     style="font-size: 30px;">
                                    🔍
                                </div>

                                <strong>
                                    No test types found
                                </strong>

                                <div class="small">
                                    Try a different search term.
                                </div>

                            </div>
                        }
                        else
                        {
                            <div class="text-center text-muted py-4">

                                <div class="mb-2"
                                     style="font-size: 30px;">
                                    🧪
                                </div>

                                <strong>
                                    No test types available
                                </strong>

                                <div class="small mt-1">
                                    There are currently no active
                                    test types.
                                </div>

                            </div>
                        }

                    </div>

                </div>

            </div>


            <!-- ========================= -->
            <!-- BUTTONS -->
            <!-- ========================= -->

            <div class="d-flex justify-content-between mt-4">

                <a asp-action="LabTechnician"
                   class="btn btn-outline-secondary">

                    ← Back

                </a>

                <button type="submit"
                        class="btn btn-primary-custom btn-sm">

                    Add Technician

                </button>

            </div>

        </form>

    </div>
  
</div>



@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            // ==========================================
            // ID NUMBER VALIDATION
            // Numbers only, maximum 13 digits
            // ==========================================

            const idNumberInput = document.getElementById("IDNumber");

            if (idNumberInput) {

                idNumberInput.addEventListener("input", function () {

                    // Remove all non-numeric characters.
                    this.value = this.value.replace(/[^0-9]/g, "");

                    // Limit to 13 digits.
                    this.value = this.value.slice(0, 13);

                    this.setCustomValidity("");
                });

                idNumberInput.addEventListener("paste", function () {
                    const input = this;

                    setTimeout(function () {
                        input.value = input.value
                            .replace(/[^0-9]/g, "")
                            .slice(0, 13);
                    }, 0);
                });
            }


            // ==========================================
            // PHONE NUMBER VALIDATION
            // Optional leading + and maximum 12 characters
            // ==========================================

            const phoneInput = document.getElementById("PhoneNumber");

            if (phoneInput) {

                phoneInput.addEventListener("input", function () {

                    let value = this.value;

                    // Allow digits and the + sign only.
                    value = value.replace(/[^0-9+]/g, "");

                    // Allow + only at the beginning.
                    const hasPlus = value.startsWith("+");
                    value = value.replace(/\+/g, "");

                    if (hasPlus) {
                        value = "+" + value;
                    }

                    // Maximum 12 characters, including +.
                    this.value = value.slice(0, 12);

                    this.setCustomValidity("");
                });

                phoneInput.addEventListener("paste", function () {
                    const input = this;

                    setTimeout(function () {
                        let value = input.value.replace(/[^0-9+]/g, "");
                        const hasPlus = value.startsWith("+");

                        value = value.replace(/\+/g, "");

                        if (hasPlus) {
                            value = "+" + value;
                        }

                        input.value = value.slice(0, 12);
                        input.setCustomValidity("");
                    }, 0);
                });
            }


            // ==========================================
            // FORM SUBMISSION VALIDATION
            // ==========================================

            const form = document.querySelector(
                'form[asp-action="AddTechnician"]'
            ) || (idNumberInput ? idNumberInput.form : null);

            // The ASP.NET Core form tag helper may not render
            // asp-action as a literal HTML attribute.
            const technicianForm = idNumberInput
                ? idNumberInput.closest("form")
                : (phoneInput ? phoneInput.closest("form") : null);

            const activeForm = technicianForm || form;

            if (activeForm) {

                activeForm.addEventListener("submit", function (event) {

                    if (idNumberInput) {
                        idNumberInput.value =
                            idNumberInput.value.replace(/[^0-9]/g, "").slice(0, 13);

                        if (!/^[0-9]{13}$/.test(idNumberInput.value)) {
                            event.preventDefault();

                            idNumberInput.setCustomValidity(
                                "ID Number must contain exactly 13 digits."
                            );

                            idNumberInput.reportValidity();
                            idNumberInput.focus();
                            return;
                        }

                        idNumberInput.setCustomValidity("");
                    }

                    if (phoneInput) {
                        if (!/^\+?[0-9]{1,11}$/.test(phoneInput.value)) {
                            event.preventDefault();

                            phoneInput.setCustomValidity(
                                "Enter digits and an optional leading + sign, with a maximum of 12 characters."
                            );

                            phoneInput.reportValidity();
                            phoneInput.focus();
                            return;
                        }

                        phoneInput.setCustomValidity("");
                    }
                });
            }


            // ==========================================
            // TEST TYPE SEARCH ELEMENTS
            // ==========================================

            const searchBox = document.getElementById("testTypeSearch");
            const clearButton = document.getElementById("clearTestSearch");
            const testItems = document.querySelectorAll(".test-type-item");
            const checkboxes = document.querySelectorAll(".test-type-checkbox");
            const noResults = document.getElementById("noTestResults");
            const visibleCount = document.getElementById("visibleTestCount");
            const selectedCount = document.getElementById("selectedTestCount");


            // ==========================================
            // SEARCH AND FILTER TEST TYPES
            // ==========================================

            function filterTestTypes() {

                if (!searchBox) return;

                const searchTerm = searchBox.value.toLowerCase().trim();
                let numberVisible = 0;

                testItems.forEach(function (item) {

                    const testName = (
                        item.getAttribute("data-test-name") || ""
                    ).toLowerCase();

                    if (testName.includes(searchTerm)) {
                        item.style.display = "";
                        numberVisible++;
                    } else {
                        item.style.display = "none";
                    }
                });

                if (visibleCount) {
                    visibleCount.textContent = numberVisible;
                }

                if (noResults) {
                    noResults.style.display =
                        numberVisible === 0 && searchTerm.length > 0
                            ? "block"
                            : "none";
                }

                if (clearButton) {
                    clearButton.style.display =
                        searchTerm.length > 0 ? "block" : "none";
                }
            }


            // ==========================================
            // SEARCH EVENT
            // ==========================================

            if (searchBox) {
                searchBox.addEventListener("input", filterTestTypes);
            }


            // ==========================================
            // CLEAR SEARCH
            // ==========================================

            if (clearButton && searchBox) {

                clearButton.addEventListener("click", function () {

                    searchBox.value = "";

                    filterTestTypes();

                    searchBox.focus();
                });
            }


            // ==========================================
            // COUNT SELECTED TEST TYPES
            // ==========================================

            function updateSelectedCount() {

                let count = 0;

                checkboxes.forEach(function (checkbox) {
                    if (checkbox.checked) {
                        count++;
                    }
                });

                if (selectedCount) {
                    selectedCount.textContent = count;
                }
            }


            // ==========================================
            // CHECKBOX CHANGE EVENTS
            // ==========================================

            checkboxes.forEach(function (checkbox) {

                checkbox.addEventListener(
                    "change",
                    updateSelectedCount
                );
            });


            // ==========================================
            // INITIALIZE COUNTS AND SEARCH
            // ==========================================

            updateSelectedCount();
            filterTestTypes();

        });
    </script>
}
