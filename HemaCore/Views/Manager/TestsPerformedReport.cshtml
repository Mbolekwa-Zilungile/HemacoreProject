@model HemaCore.ViewModels.ManagerVM.TestsPerformedReportViewModel

@{
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
    ViewData["Title"] = "Management Reports";
}

<link rel="stylesheet" href="~/css/doctor.css" />
<link rel="stylesheet" href="~/css/management-reports.css" />

<div class="container mt-4 mb-5">

    <div class="card shadow-sm border-0 p-4">

        <!-- PAGE HEADER -->
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
            <div>
                <h3 class="fw-bold mb-2">Management Reports</h3>
                <p class="text-muted mb-0">
                    <i class="fas fa-file-pdf me-2"></i>
                    Tests Performed by Category
                </p>
            </div>

            <div class="rounded-circle bg-light text-primary d-flex align-items-center justify-content-center"
                 style="width: 55px; height: 55px;">
                <i class="fas fa-chart-bar fs-4"></i>
            </div>
        </div>

        <hr class="text-muted opacity-25 mb-4" />

        <!-- ERROR MESSAGE -->
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger" role="alert">
                <i class="fas fa-exclamation-circle me-2"></i>
                @TempData["Error"]
            </div>
        }

        <!-- REPORT FORM -->
        <form asp-controller="Manager"
              asp-action="GenerateTestsByCategoryReport"
              method="get"
              id="reportForm">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="mb-4">
                <h5 class="fw-bold text-secondary mb-3">
                    <i class="fas fa-calendar-alt me-2"></i>
                    Select Reporting Period
                </h5>

                <div class="row">

                    <!-- START DATE -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="StartDate"
                               class="form-label text-muted">
                            Start Date
                        </label>

                        <input asp-for="StartDate"
                               type="date"
                               class="form-control"
                               id="StartDate"
                               max="@DateTime.Today.ToString("yyyy-MM-dd")"
                               required />

                        <span asp-validation-for="StartDate"
                              class="text-danger small"></span>
                    </div>

                    <!-- END DATE -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="EndDate"
                               class="form-label text-muted">
                            End Date
                        </label>

                        <input asp-for="EndDate"
                               type="date"
                               class="form-control"
                               id="EndDate"
                               max="@DateTime.Today.ToString("yyyy-MM-dd")"
                               required />

                        <span asp-validation-for="EndDate"
                              class="text-danger small"></span>
                    </div>

                </div>

                <!-- DATE VALIDATION -->
                <div id="dateError"
                     class="alert alert-danger mt-2"
                     role="alert"
                     hidden>
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    The start date cannot be after the end date.
                </div>
            </div>

            <hr class="text-muted opacity-25 my-4" />

            <!-- ACTION BUTTONS -->
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-3">

                <button type="reset"
                        class="btn btn-outline-secondary"
                        id="resetButton">
                    <i class="fas fa-rotate-left me-1"></i>
                    Reset Dates
                </button>

                <button type="submit"
                        class="btn btn-primary-custom"
                        id="generateButton">
                    <i class="fas fa-file-pdf me-1"></i>
                    Generate PDF Report
                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const form = document.getElementById("reportForm");
            const startDate = document.getElementById("StartDate");
            const endDate = document.getElementById("EndDate");
            const dateError = document.getElementById("dateError");
            const generateButton = document.getElementById("generateButton");

            const originalButtonHtml =
                '<i class="fas fa-file-pdf me-1"></i> Generate PDF Report';

            function validateDates() {
                const invalid =
                    startDate.value !== "" &&
                    endDate.value !== "" &&
                    startDate.value > endDate.value;

                dateError.hidden = !invalid;

                startDate.setCustomValidity(
                    invalid ? "Start date cannot be after end date." : ""
                );

                endDate.setCustomValidity(
                    invalid ? "End date cannot be before start date." : ""
                );

                return !invalid;
            }

            function updateEndDateMinimum() {
                endDate.min = startDate.value || "";
            }

            startDate.addEventListener("change", function () {
                updateEndDateMinimum();
                validateDates();
            });

            endDate.addEventListener("change", validateDates);

            form.addEventListener("submit", function (event) {

                if (!validateDates()) {
                    event.preventDefault();
                    endDate.reportValidity();
                    return;
                }

                generateButton.disabled = true;

                generateButton.innerHTML =
                    '<i class="fas fa-spinner fa-spin me-1"></i> Generating PDF...';
            });

            form.addEventListener("reset", function () {

                window.setTimeout(function () {
                    dateError.hidden = true;

                    startDate.setCustomValidity("");
                    endDate.setCustomValidity("");

                    updateEndDateMinimum();

                    generateButton.disabled = false;
                    generateButton.innerHTML = originalButtonHtml;
                }, 0);
            });

            updateEndDateMinimum();
        });
    </script>
}