@model HemaCore.ViewModels.ManagerVM.AssignTechnicianViewModel

@{
    ViewData["Title"] = "Assign Lab Technicians";
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
}

<link rel="stylesheet" href="~/css/doctor.css" />

<div class="container mt-4 mb-5">

    <div class="content-card">

        <div class="section-title d-flex align-items-center mb-4">
            <i class="fas fa-user-plus me-2"></i>
            <span>Assign Lab Technicians</span>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                <i class="fas fa-check-circle me-2"></i>
                @TempData["Success"]
                <button type="button" class="btn-close"
                        data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">
                <i class="fas fa-exclamation-circle me-2"></i>
                @TempData["Error"]
                <button type="button" class="btn-close"
                        data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="card shadow-sm border-0 mb-4">

            <div class="card-header bg-white py-3">
                <h5 class="mb-0">
                    <i class="fas fa-microscope me-2 text-primary"></i>
                    Test Type Information
                </h5>
            </div>

            <div class="card-body p-4">
                <label class="text-muted small mb-2">
                    Selected Test Type
                </label>

                <h4 class="fw-bold mb-2">
                    @Model.TestTypeName
                </h4>

                <p class="text-muted mb-0">
                    Select one or more active lab technicians to perform
                    this test type. Technicians already assigned to this
                    test type will not appear in the list.
                </p>
            </div>

        </div>

        <div class="card shadow-sm border-0">

            <div class="card-header bg-white py-3">
                <h5 class="mb-0">
                    <i class="fas fa-users me-2 text-primary"></i>
                    Available Technicians

                    <span class="badge bg-primary ms-2">
                        @(Model.AvailableTechnicians?.Count ?? 0)
                    </span>
                </h5>
            </div>

            <div class="card-body p-4">

                @if (Model.AvailableTechnicians == null ||
                     !Model.AvailableTechnicians.Any())
                {
                    <div class="text-center py-5">
                        <i class="fas fa-user-check text-success"
                           style="font-size: 2.5rem;"></i>

                        <h5 class="mt-3 fw-bold">
                            No Available Technicians
                        </h5>

                        <p class="text-muted mb-4">
                            All active technicians are already assigned
                            to this test type, or no active technicians
                            are available.
                        </p>

                        <a asp-action="TestTypeDetails"
                           asp-route-id="@Model.TestTypeId"
                           class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left me-1"></i>
                            Back to Test Type
                        </a>
                    </div>
                }
                else
                {
                    <form asp-action="AssignTechnicianToTestTypes"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               asp-for="TestTypeId" />

                        <div class="d-flex justify-content-between
                            align-items-center mb-3 flex-wrap gap-2">

                            <p class="text-muted mb-0">
                                Choose the technicians you want to assign.
                            </p>

                            <button type="button"
                                    id="selectAllBtn"
                                    class="btn btn-outline-primary btn-sm">
                                Select All
                            </button>

                        </div>

                        <div class="row g-3">

                            @for (int i = 0;
                                  i < Model.AvailableTechnicians.Count;
                                  i++)
                            {
                                var technician =
                                    Model.AvailableTechnicians[i];

                                <div class="col-md-6">

                                    <label class="card h-100 border
                                        technician-option"
                                           for="tech_@technician.LabTechnicianId"
                                           style="cursor:pointer;">

                                        <div class="card-body d-flex
                                            align-items-center gap-3">

                                            <input type="checkbox"
                                                   class="form-check-input
                                            technician-checkbox"
                                                   id="tech_@technician.LabTechnicianId"
                                                   name="SelectedTechnicianIds"
                                                   value="@technician.LabTechnicianId" />

                                            <div class="rounded-circle
                                                bg-light text-primary
                                                d-flex align-items-center
                                                justify-content-center"
                                                 style="width:48px;height:48px;
                                                flex-shrink:0;">

                                                <i class="fas fa-user-md
                                                fa-lg"></i>
                                            </div>

                                            <div class="flex-grow-1">

                                                <h6 class="fw-bold mb-1">
                                                    @technician.Name
                                                    @technician.Surname
                                                </h6>

                                                <div class="text-muted small">
                                                    Employee No:
                                                    @(string.IsNullOrWhiteSpace(
                                                        technician.EmployeeNumber)
                                                        ? "Not available"
                                                        : technician.EmployeeNumber)
                                                </div>

                                                <span class="badge bg-success
                                                    mt-2">
                                                    Active
                                                </span>

                                            </div>

                                        </div>

                                    </label>

                                </div>
                            }

                        </div>

                        <div class="d-flex justify-content-between
                            align-items-center mt-4 pt-3 border-top
                            flex-wrap gap-2">

                            <a asp-action="TestTypeDetails"
                               asp-route-id="@Model.TestTypeId"
                               class="btn btn-outline-secondary">
                                <i class="fas fa-arrow-left me-1"></i>
                                Cancel
                            </a>

                            <button type="submit"
                                    class="btn btn-primary-custom">
                                <i class="fas fa-user-plus me-2"></i>
                                Assign Selected Technicians
                            </button>

                        </div>

                    </form>
                }

            </div>
        </div>

    </div>
</div>

<style>
    .technician-option {
        transition: border-color .2s ease, box-shadow .2s ease, background-color .2s ease;
    }

        .technician-option:hover {
            border-color: #0d6efd !important;
            box-shadow: 0 3px 12px rgba(0, 0, 0, .07);
        }

        .technician-option:has(.technician-checkbox:checked) {
            border-color: #0d6efd !important;
            background-color: #f4f8ff;
        }

    .technician-checkbox {
        width: 18px;
        height: 18px;
        flex-shrink: 0;
    }
</style>

@section Scripts {
    <script>
        const selectAllBtn = document.getElementById("selectAllBtn");
        const checkboxes = document.querySelectorAll(
            ".technician-checkbox"
        );

        function updateSelectAllButton() {
            const allChecked = checkboxes.length > 0 &&
                Array.from(checkboxes).every(c => c.checked);

            selectAllBtn.textContent = allChecked
                ? "Deselect All"
                : "Select All";
        }

        selectAllBtn?.addEventListener("click", function () {
            const allChecked = checkboxes.length > 0 &&
                Array.from(checkboxes).every(c => c.checked);

            checkboxes.forEach(c => {
                c.checked = !allChecked;
            });

            updateSelectAllButton();
        });

        checkboxes.forEach(c => {
            c.addEventListener("change", updateSelectAllButton);
        });
    </script>
}
