@model HemaCore.ViewModels.ManagerVM.StockAdjustmentVM

@{
    ViewData["Title"] = "Adjust Stock";
    Layout = "_ManagerLayout";
}

<link rel="stylesheet" href="~/css/doctor.css" />

<div class="container mt-4">
    <div class="card shadow-sm p-4">

        <div class="mb-4">
            <h3 class="fw-bold">Adjust Stock</h3>

            <p class="text-muted">
                Update the stock quantity for
                <strong>@Model.ConsumableName</strong>.
            </p>
        </div>

      
        <form asp-action="AdjustStock" method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="ConsumableID" />

            <!-- READ-ONLY STOCK INFORMATION -->
            <div class="row mb-4">

                <!-- CONSUMABLE NAME -->
                <div class="col-md-6 mb-3">
                    <label class="form-label text-muted">
                        <i class="fas fa-box me-1"></i>
                        Consumable Name
                        <i class="fas fa-lock ms-1"></i>
                    </label>

                    <div class="fw-semibold fs-5">
                        @Model.ConsumableName
                    </div>

                   
                </div>

                <!-- CURRENT STOCK -->
                <div class="col-md-6 mb-3">
                    <label class="form-label text-muted">
                        <i class="fas fa-cubes me-1"></i>
                        Quantity on Hand
                        <i class="fas fa-lock ms-1"></i>
                    </label>

                    <div class="fw-semibold fs-5">
                        @Model.QuantityOnHand
                    </div>

                   
                </div>

            </div>

            <hr />

            <!-- ADJUSTMENT TYPE AND AMOUNT -->
            <div class="row">

                <div class="col-md-6 mb-3">
                    <label asp-for="AdjustmentType"
                           class="form-label">
                        Adjustment Type
                    </label>

                    <select asp-for="AdjustmentType"
                            class="form-select">
                        <option value="Set">Set Value</option>
                        <option value="Increase">Increase By Amount</option>
                        <option value="Decrease">Decrease By Amount</option>
                    </select>

                    <span asp-validation-for="AdjustmentType"
                          class="text-danger small"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Amount"
                           class="form-label">
                        Adjustment Quantity
                    </label>

                    <input asp-for="Amount"
                           type="number"
                           min="0"
                           step="1"
                           class="form-control"
                           placeholder="Enter amount" />

                    <span asp-validation-for="Amount"
                          class="text-danger small"></span>
                </div>

            </div>

            <!-- ACTION BUTTONS -->
            <div class="d-flex justify-content-between mt-4">

                <a asp-action="Consumables"
                   class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left me-1"></i>
                    Back
                </a>

                <button type="submit"
                        class="btn btn-primary-custom btn-sm">
                    <i class="fas fa-save me-1"></i>
                    Update Stock
                </button>

            </div>

        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
