@model HemaCore.Models.TestCategory

@{
    ViewData["Title"] = "Test Category Details";
    Layout = "_ManagerLayout";

    var testTypes = Model.TestTypes;
}

<link rel="stylesheet" href="~/css/doctor.css" />

<div class="content-card">

    <!-- PAGE HEADER -->
    <div class="section-title d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center">
            <i class="fas fa-folder-open me-2"></i>
            <span>Test Category Details</span>
        </div>

        <a asp-action="EditCategory"
           asp-controller="Manager"
           asp-route-id="@Model.CategoryId"
           class="btn btn-primary-custom btn-sm">
            <i class="fas fa-edit me-1"></i>
            Edit Category
        </a>
    </div>

    <!-- CATEGORY INFORMATION -->
    <div class="card shadow-sm mb-4">

        <div class="card-header">
            <h5 class="mb-0">
                <i class="fas fa-info-circle me-2"></i>
                Category Information
            </h5>
        </div>

        <div class="card-body">
            <div class="row">

                <div class="col-md-6 mb-3">
                    <label class="text-muted">Category Name</label>
                    <div class="fw-semibold">
                        @Model.CategoryName
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="text-muted">Category ID</label>
                    <div class="fw-semibold">
                        @Model.CategoryId
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="text-muted">Description</label>
                    <div class="fw-semibold">
                        @(string.IsNullOrWhiteSpace(Model.CategoryDescription)
                            ? "No description available"
                            : Model.CategoryDescription)
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="text-muted">Category Status</label>
                    <div>
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Inactive</span>
                        }
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- ASSOCIATED TEST TYPES -->
    <div class="card shadow-sm mb-4">

        <div class="card-header">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <i class="fas fa-vials me-2"></i>
                    Associated Test Types
                </h5>

                <span class="badge bg-primary">
                    @(testTypes?.Count ?? 0)
                </span>
            </div>
        </div>

        <div class="card-body">

            @if (testTypes != null && testTypes.Count > 0)
            {
                <div class="row">

                    @foreach (var test in testTypes)
                    {
                        <div class="col-lg-6 mb-3">

                            <div class="card h-100 border shadow-sm">

                                <!-- TEST TYPE HEADER -->
                                <div class="card-header d-flex justify-content-between align-items-center">

                                    <h6 class="mb-0 fw-bold">
                                        <i class="fas fa-microscope me-2 text-primary"></i>
                                        @test.TestTypeName
                                    </h6>

                                    @if (test.IsActive)
                                    {
                                        <span class="badge bg-success">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            Inactive
                                        </span>
                                    }

                                </div>

                                <!-- IMPORTANT TEST DETAILS -->
                                <div class="card-body">

                                    <div class="mb-3">
                                        <small class="text-muted d-block">
                                            Sample Type
                                        </small>

                                        <div class="fw-semibold">
                                            @if (test.SampleType != null)
                                            {
                                                <i class="fas fa-vial me-1 text-primary"></i>
                                                @test.SampleType.SampleName
                                            }
                                            else
                                            {
                                                <span class="text-muted">
                                                    Not assigned
                                                </span>
                                            }
                                        </div>
                                    </div>

                                    <div class="row">

                                        <div class="col-6 mb-3">
                                            <small class="text-muted d-block">
                                                Normal Range
                                            </small>

                                            <div class="fw-semibold">
                                                @test.NormalRangeMin -
                                                @test.NormalRangeMax
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(test.UnitOfMeasurement))
                                            {
                                                <small class="text-muted">
                                                    @test.UnitOfMeasurement
                                                </small>
                                            }
                                        </div>

                                        <div class="col-6 mb-3">
                                            <small class="text-muted d-block">
                                                Turnaround Time
                                            </small>

                                            <span class="badge bg-info text-dark mt-1">
                                                @test.TurnAroundTime min
                                            </span>
                                        </div>

                                        <div class="col-12 mb-2">
                                            <small class="text-muted d-block">
                                                Unit of Measurement
                                            </small>

                                            <div class="fw-semibold">
                                                @(string.IsNullOrWhiteSpace(test.UnitOfMeasurement)
                                                    ? "Not specified"
                                                    : test.UnitOfMeasurement)
                                            </div>
                                        </div>

                                    </div>

                                </div>

                                <!-- ACTIONS -->
                                <div class="card-footer bg-transparent text-end">

                                    <a asp-action="DetailsTestType"
                                       asp-controller="Manager"
                                       asp-route-id="@test.TestTypeId"
                                       class="btn btn-sm btn-outline-info me-1"
                                       title="View test type details">
                                        <i class="fas fa-eye me-1"></i>
                                        Details
                                    </a>

                                    <a asp-action="EditTestType"
                                       asp-controller="Manager"
                                       asp-route-id="@test.TestTypeId"
                                       class="btn btn-sm btn-outline-primary"
                                       title="Edit test type">
                                        <i class="fas fa-edit me-1"></i>
                                        Edit
                                    </a>

                                </div>

                            </div>

                        </div>
                    }

                </div>
            }
            else
            {
                <div class="alert alert-info mb-0">
                    <i class="fas fa-info-circle me-2"></i>
                    No test types have been assigned to this category.
                </div>
            }

        </div>
    </div>

    <!-- BOTTOM BUTTONS -->
    <div class="d-flex justify-content-between mt-4">

        <a asp-action="TestCategories"
           asp-controller="Manager"
           class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>
            Back to Test Categories
        </a>

        <a asp-action="EditCategory"
           asp-controller="Manager"
           asp-route-id="@Model.CategoryId"
           class="btn btn-primary-custom">
            <i class="fas fa-edit me-1"></i>
            Edit Category
        </a>

    </div>

</div>