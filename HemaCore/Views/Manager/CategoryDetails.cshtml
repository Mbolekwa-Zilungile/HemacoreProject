@model HemaCore.Models.TestCategory

@{
    ViewData["Title"] = "Test Category Details";
    Layout = "_ManagerLayout";

    var testTypes = Model.TestTypes;
}

<link rel="stylesheet" href="~/css/doctor.css" />

<div class="content-card">

    <!-- PAGE HEADER -->
    <div class="section-title d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center">
            <i class="fas fa-folder-open me-2"></i>
            <span>Test Category Details</span>
        </div>

        <a asp-action="EditCategory"
           asp-controller="Manager"
           asp-route-id="@Model.CategoryId"
           class="btn btn-primary-custom btn-sm">
            <i class="fas fa-edit me-1"></i>
            Edit Category
        </a>
    </div>

    <!-- CATEGORY INFORMATION -->
    <div class="card shadow-sm mb-4">

        <div class="card-header">
            <h5 class="mb-0">
                <i class="fas fa-info-circle me-2"></i>
                Category Information
            </h5>
        </div>

        <div class="card-body">
            <div class="row">

                <div class="col-md-6 mb-3">
                    <label class="text-muted">Category Name</label>
                    <div class="fw-semibold">
                        @Model.CategoryName
                    </div>
                </div>

            
                <div class="col-md-6 mb-3">
                    <label class="text-muted">Description</label>
                    <div class="fw-semibold">
                        @(string.IsNullOrWhiteSpace(Model.CategoryDescription)
                            ? "No description available"
                            : Model.CategoryDescription)
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="text-muted">Category Status</label>
                    <div>
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Inactive</span>
                        }
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- ASSOCIATED TEST TYPES: ACCORDION -->
    <div class="card shadow-sm mb-4">

        <div class="card-header">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <i class="fas fa-vials me-2"></i>
                    Associated Test Types
                </h5>

                <span class="badge bg-primary">
                    @(testTypes?.Count ?? 0)
                </span>
            </div>
        </div>

        <div class="card-body">

            @if (testTypes != null && testTypes.Count > 0)
            {
                var accordionId = $"testTypesAccordion_{Model.CategoryId}";

                <div class="accordion" id="@accordionId">

                    @foreach (var test in testTypes)
                    {
                        var headingId = $"heading_{test.TestTypeId}";
                        var collapseId = $"collapse_{test.TestTypeId}";

                        <div class="accordion-item">

                            <!-- ACCORDION HEADER -->
                            <h2 class="accordion-header" id="@headingId">

                                <button class="accordion-button collapsed"
                                        type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#@collapseId"
                                        aria-expanded="false"
                                        aria-controls="@collapseId">

                                    <div class="d-flex align-items-center justify-content-between w-100 me-3">

                                        <div class="d-flex align-items-center">
                                            <i class="fas fa-microscope text-primary me-3"></i>

                                            <span class="fw-bold">
                                                @test.TestTypeName
                                            </span>
                                        </div>

                                        <span class="badge @(test.IsActive ? "bg-success" : "bg-danger")">
                                            @(test.IsActive ? "Active" : "Inactive")
                                        </span>

                                    </div>

                                </button>

                            </h2>

                            <!-- ACCORDION CONTENT -->
                            <div id="@collapseId"
                                 class="accordion-collapse collapse"
                                 aria-labelledby="@headingId"
                                 data-bs-parent="#@accordionId">

                                <div class="accordion-body">

                                    <div class="row g-3">

                                        <!-- SAMPLE TYPE -->
                                        <div class="col-md-4">

                                            <small class="text-muted d-block mb-1">
                                                <i class="fas fa-vial me-1"></i>
                                                Sample Type
                                            </small>

                                            <div class="fw-semibold">
                                                @(test.SampleType?.SampleName ?? "Not assigned")
                                            </div>

                                        </div>

                                        <!-- NORMAL RANGE -->
                                        <div class="col-md-4">

                                            <small class="text-muted d-block mb-1">
                                                <i class="fas fa-chart-line me-1"></i>
                                                Normal Range
                                            </small>

                                            <div class="fw-semibold">
                                                @test.NormalRangeMin - @test.NormalRangeMax

                                                @if (!string.IsNullOrWhiteSpace(test.UnitOfMeasurement))
                                                {
                                                    <span class="text-muted">
                                                        @test.UnitOfMeasurement
                                                    </span>
                                                }
                                            </div>

                                        </div>

                                        <!-- TURNAROUND TIME -->
                                        <div class="col-md-4">

                                            <small class="text-muted d-block mb-1">
                                                <i class="fas fa-clock me-1"></i>
                                                Turnaround Time
                                            </small>

                                            <div>
                                                <span class="badge bg-info text-dark">
                                                    @test.TurnAroundTime min
                                                </span>
                                            </div>

                                        </div>

                                    </div>

                                    <!-- ACTION BUTTONS -->
                                    <div class="d-flex justify-content-end gap-2 mt-4">

                                        

                                        <a asp-action="EditTestType"
                                           asp-controller="Manager"
                                           asp-route-id="@test.TestTypeId"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-edit me-1"></i>
                                            Edit
                                        </a>

                                    </div>

                                </div>
                            </div>

                        </div>
                    }

                </div>
            }
            else
            {
                <div class="alert alert-info mb-0">
                    <i class="fas fa-info-circle me-2"></i>
                    No test types have been assigned to this category.
                </div>
            }

        </div>
    </div>

    <!-- BOTTOM BUTTONS -->
    <div class="d-flex justify-content-between mt-4">

        <a asp-action="TestCategories"
           asp-controller="Manager"
           class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>
            Back 
        </a>

        <a asp-action="EditCategory"
           asp-controller="Manager"
           asp-route-id="@Model.CategoryId"
           class="btn btn-primary-custom">
            <i class="fas fa-edit me-1"></i>
            Edit Category
        </a>

    </div>

</div>
