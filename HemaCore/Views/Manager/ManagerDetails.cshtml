@model HemaCore.ViewModels.ManagerVM.ManagerProfileVM

@{
    ViewData["Title"] = "Manager Details";
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
}

<link rel="stylesheet" href="~/css/doctor.css" />

<div class="content-card">

    <!-- PAGE HEADER -->
    <div class="section-title d-flex align-items-center justify-content-between flex-wrap gap-2">

        <div class="d-flex align-items-center">
            <i class="fas fa-user-tie me-2"></i>
            <span>Manager Details</span>
        </div>

        <span class="badge bg-success px-3 py-2">
            <i class="fas fa-shield-alt me-1"></i>
            Manager
        </span>

    </div>

    <!-- INTRODUCTION -->
    <p class="text-muted mb-4">
        View your manager account information and contact details.
    </p>

    <!-- MANAGER INFORMATION -->
    <div class="card shadow-sm mb-4">

        <div class="card-header">
            <h5 class="mb-0">
                <i class="fas fa-info-circle me-2"></i>
                General Information
            </h5>
        </div>

        <div class="card-body">

            <div class="row">

                <!-- FULL NAME -->
                <div class="col-md-6 mb-4">

                    <label class="text-muted d-block mb-2">
                        <i class="fas fa-user me-1"></i>
                        Full Name
                    </label>

                    <div class="fw-semibold">
                        @(string.IsNullOrWhiteSpace(Model.FullName)
                            ? "Not provided"
                            : Model.FullName)
                    </div>

                </div>

                <!-- EMAIL ADDRESS -->
                <div class="col-md-6 mb-4">

                    <label class="text-muted d-block mb-2">
                        <i class="fas fa-envelope me-1"></i>
                        Email Address
                    </label>

                    <div class="fw-semibold">
                        @(string.IsNullOrWhiteSpace(Model.Email)
                            ? "Not provided"
                            : Model.Email)
                    </div>

                </div>

                <!-- PHONE NUMBER -->
                <div class="col-md-6 mb-4">

                    <label class="text-muted d-block mb-2">
                        <i class="fas fa-phone me-1"></i>
                        Phone Number
                    </label>

                    <div class="fw-semibold">
                        @(string.IsNullOrWhiteSpace(Model.PhoneNumber)
                            ? "Not provided"
                            : Model.PhoneNumber)
                    </div>

                </div>

                <!-- ACCOUNT ROLE -->
                <div class="col-md-6 mb-4">

                    <label class="text-muted d-block mb-2">
                        <i class="fas fa-user-shield me-1"></i>
                        Account Role
                    </label>

                    <div>
                        <span class="badge bg-primary">
                            Manager
                        </span>
                    </div>

                </div>

            </div>

        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-4">

        <a asp-controller="Manager"
           asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="fas fa-arrow-left me-1"></i>
            Back

        </a>

        <a asp-controller="Manager"
           asp-action="ManagerProfile"
           class="btn btn-primary-custom">

            <i class="fas fa-edit me-1"></i>
            Manage Profile

        </a>

    </div>

</div>
