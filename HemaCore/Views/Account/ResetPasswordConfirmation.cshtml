@{
    ViewData["Title"] = "Password Reset Confirmation";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Password Reset Confirmation | HemaCore</title>

    <style>
            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 20px;
                font-family: "Segoe UI", Arial, sans-serif;
                background: linear-gradient(135deg, #eaf5f9, #d6eaf2);
                color: #243746;
            }

            .confirmation-card {
                width: 100%;
                max-width: 460px;
                padding: 40px 35px;
                background: #ffffff;
                border-radius: 16px;
                text-align: center;
                box-shadow: 0 12px 35px rgba(31, 80, 104, 0.13);
            }

            .success-icon {
                width: 70px;
                height: 70px;
                display: flex;
                align-items: center;
                justify-content: center;
                margin: 0 auto 22px;
                border-radius: 50%;
                background: #e4f4ed;
                color: #21845b;
                font-size: 34px;
                font-weight: 700;
            }

            .brand {
                margin-bottom: 12px;
                color: #2c7da0;
                font-size: 28px;
                font-weight: 700;
            }

            h1 {
                margin: 10px 0 15px;
                color: #1f5068;
                font-size: 25px;
            }

            p {
                margin-bottom: 25px;
                color: #647785;
                font-size: 14px;
                line-height: 1.7;
            }

            .login-button {
                display: block;
                width: 100%;
                padding: 14px;
                border-radius: 8px;
                background: #2c7da0;
                color: #ffffff;
                font-size: 15px;
                font-weight: 600;
                text-decoration: none;
                transition: background 0.2s ease;
            }

                .login-button:hover {
                    background: #1f5068;
                }
    </style>
</head>

<body>
    <main class="confirmation-card">
        <div class="success-icon" aria-hidden="true">&#10003;</div>

        <div class="brand">HemaCore</div>

        <h1>Password Reset Complete</h1>

        <p>
            Your password has been reset successfully.
            You can now log in using your new password.
        </p>

        <a asp-controller="Account"
           asp-action="Login"
           class="login-button">
            Return to Login
        </a>
    </main>
</body>
</html>