@model HemaCore.ViewModels.RegisterViewModel
@{
    Layout = null;
    ViewData["Title"] = "Register";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>HemaCore - Register</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/login-style.css" />
    <style>
        .register-container {
            max-width: 550px;
            margin: 50px auto;
        }
        body {
            overflow-y: auto;
            padding: 20px;
        }
    </style>
</head>
<body>

    <div class="circle circle-1"></div>
    <div class="circle circle-2"></div>
    <div class="circle circle-3"></div>

    <div class="login-container register-container">
        <div class="login-card">
            <div class="card-header">
                <div class="logo-icon">
                    <i class="fas fa-user-plus"></i>
                </div>
                <h2>Create Account</h2>
                <p>Join HemaCore today</p>
            </div>

            <div class="card-body">
                <form asp-controller="Account" asp-action="Register" method="post">
                    @Html.AntiForgeryToken()
                    
                    <div asp-validation-summary="All" class="alert alert-error" style="display: block;"></div>

                    <div class="form-group">
                        <label><i class="fas fa-user"></i> Full Name</label>
                        <div class="input-wrapper">
                            <i class="fas fa-user input-icon"></i>
                            <input asp-for="Name" placeholder="Enter your first name" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label><i class="fas fa-user"></i> Surname</label>
                        <div class="input-wrapper">
                            <i class="fas fa-user input-icon"></i>
                            <input asp-for="Surname" placeholder="Enter your surname" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label><i class="fas fa-id-card"></i> ID Number</label>
                        <div class="input-wrapper">
                            <i class="fas fa-id-card input-icon"></i>
                            <input asp-for="IDNumber" placeholder="13-digit ID number" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label><i class="fas fa-calendar"></i> Date of Birth</label>
                        <div class="input-wrapper">
                            <i class="fas fa-calendar input-icon"></i>
                            <input asp-for="DateOfBirth" type="date" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label><i class="fas fa-phone"></i> Phone Number</label>
                        <div class="input-wrapper">
                            <i class="fas fa-phone input-icon"></i>
                            <input asp-for="PhoneNumber" placeholder="+27721234567" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label><i class="fas fa-home"></i> Address</label>
                        <div class="input-wrapper">
                            <i class="fas fa-home input-icon"></i>
                            <input asp-for="Address" placeholder="Your home address" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label><i class="fas fa-envelope"></i> Email Address</label>
                        <div class="input-wrapper">
                            <i class="fas fa-envelope input-icon"></i>
                            <input asp-for="Email" type="email" placeholder="you@example.com" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label><i class="fas fa-lock"></i> Password</label>
                        <div class="input-wrapper">
                            <i class="fas fa-lock input-icon"></i>
                            <input asp-for="Password" type="password" id="password" placeholder="Create a password" />
                            <i class="fas fa-eye toggle-password" onclick="togglePassword()"></i>
                        </div>
                    </div>

                    <div class="form-group">
                        <label><i class="fas fa-lock"></i> Confirm Password</label>
                        <div class="input-wrapper">
                            <i class="fas fa-lock input-icon"></i>
                            <input asp-for="ConfirmPassword" type="password" id="confirmPassword" placeholder="Confirm your password" />
                        </div>
                    </div>

                    <button type="submit" class="login-btn">
                        <i class="fas fa-user-plus"></i> Register
                    </button>
                </form>

                <div class="register-link">
                    <p>Already have an account? <a href="/Account/Login">Sign In</a></p>
                </div>
            </div>
        </div>
    </div>

    <script>
        function togglePassword() {
            const passwordInput = document.getElementById('password');
            const toggleIcon = document.querySelector('.toggle-password');
            
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                toggleIcon.classList.remove('fa-eye');
                toggleIcon.classList.add('fa-eye-slash');
            } else {
                passwordInput.type = 'password';
                toggleIcon.classList.remove('fa-eye-slash');
                toggleIcon.classList.add('fa-eye');
            }
        }
    </script>

</body>
</html>