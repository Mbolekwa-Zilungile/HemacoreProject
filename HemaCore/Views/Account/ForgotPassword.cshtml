@model HemaCore.ViewModels.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgot Password | HemaCore</title>

    <style>
            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                min-height: 100vh;
                display: flex;
                justify-content: center;
                align-items: center;
                padding: 20px;
                font-family: "Segoe UI", Arial, sans-serif;
                background: linear-gradient(135deg, #eaf5f9, #d6eaf2);
                color: #243746;
            }

            .forgot-card {
                width: 100%;
                max-width: 440px;
                padding: 38px;
                background: #ffffff;
                border-radius: 16px;
                box-shadow: 0 12px 35px rgba(31, 80, 104, 0.13);
            }

            .brand {
                margin-bottom: 8px;
                color: #2c7da0;
                font-size: 28px;
                font-weight: 700;
                text-align: center;
            }

            h1 {
                margin: 10px 0;
                color: #1f5068;
                font-size: 25px;
                text-align: center;
            }

            .description {
                margin-bottom: 28px;
                color: #647785;
                font-size: 14px;
                line-height: 1.6;
                text-align: center;
            }

            .form-group {
                margin-bottom: 20px;
            }

            label {
                display: block;
                margin-bottom: 8px;
                font-size: 14px;
                font-weight: 600;
            }

            input[type="email"] {
                width: 100%;
                padding: 13px 14px;
                border: 1px solid #ccdce4;
                border-radius: 8px;
                outline: none;
                font-size: 15px;
            }

                input[type="email"]:focus {
                    border-color: #2c7da0;
                    box-shadow: 0 0 0 3px rgba(44, 125, 160, 0.12);
                }

            .submit-button {
                width: 100%;
                padding: 14px;
                border: none;
                border-radius: 8px;
                background: #2c7da0;
                color: white;
                font-size: 15px;
                font-weight: 600;
                cursor: pointer;
            }

                .submit-button:hover {
                    background: #1f5068;
                }

            .back-link {
                display: block;
                margin-top: 22px;
                color: #2c7da0;
                font-size: 14px;
                text-align: center;
                text-decoration: none;
            }

                .back-link:hover {
                    text-decoration: underline;
                }

            .validation {
                display: block;
                margin-top: 6px;
                color: #b42318;
                font-size: 13px;
            }

            .validation-summary-errors {
                margin-bottom: 18px;
                color: #b42318;
                font-size: 13px;
            }

            @@media (max-width: 480px) {
                .forgot-card {
                    padding: 26px 20px;
                }
            }
    </style>
</head>
<body>
    <main class="forgot-card">
        <div class="brand">HemaCore</div>

        <h1>Forgot Password?</h1>

        <p class="description">
            Enter the email address associated with your account.
            If password recovery is available for your account,
            you will receive instructions to continue.
        </p>

        <form asp-controller="Account"
              asp-action="ForgotPassword"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="validation-summary-errors"></div>

            <div class="form-group">
                <label asp-for="Email">Email Address</label>

                <input asp-for="Email"
                       type="email"
                       placeholder="Enter your email address"
                       autocomplete="email" />

                <span asp-validation-for="Email"
                      class="validation"></span>
            </div>

            <button type="submit" class="submit-button">
                Send Reset Instructions
            </button>
        </form>

        <a asp-controller="Account"
           asp-action="Login"
           class="back-link">
            ← Back to Login
        </a>
    </main>
</body>
</html>