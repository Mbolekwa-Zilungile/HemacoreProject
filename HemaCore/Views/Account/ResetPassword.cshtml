@model HemaCore.ViewModels.ResetPasswordViewModel

@{
    ViewData["Title"] = "Reset Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Reset Password | HemaCore</title>

    <style>
            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 20px;
                font-family: "Segoe UI", Arial, sans-serif;
                background: linear-gradient(135deg, #eaf5f9, #d6eaf2);
                color: #243746;
            }

            .reset-card {
                width: 100%;
                max-width: 460px;
                padding: 38px;
                background: #ffffff;
                border-radius: 16px;
                box-shadow: 0 12px 35px rgba(31, 80, 104, 0.13);
            }

            .brand {
                margin-bottom: 8px;
                color: #2c7da0;
                font-size: 28px;
                font-weight: 700;
                text-align: center;
            }

            h1 {
                margin: 10px 0;
                color: #1f5068;
                font-size: 25px;
                text-align: center;
            }

            .description {
                margin-bottom: 28px;
                color: #647785;
                font-size: 14px;
                line-height: 1.6;
                text-align: center;
            }

            .form-group {
                margin-bottom: 20px;
            }

            label {
                display: block;
                margin-bottom: 8px;
                font-size: 14px;
                font-weight: 600;
            }

            input[type="password"] {
                width: 100%;
                padding: 13px 14px;
                border: 1px solid #ccdce4;
                border-radius: 8px;
                outline: none;
                font-family: inherit;
                font-size: 15px;
            }

                input[type="password"]:focus {
                    border-color: #2c7da0;
                    box-shadow: 0 0 0 3px rgba(44, 125, 160, 0.12);
                }

            .submit-button {
                width: 100%;
                padding: 14px;
                border: none;
                border-radius: 8px;
                background: #2c7da0;
                color: #ffffff;
                font-size: 15px;
                font-weight: 600;
                cursor: pointer;
                transition: background 0.2s ease;
            }

                .submit-button:hover {
                    background: #1f5068;
                }

            .validation {
                display: block;
                margin-top: 6px;
                color: #b42318;
                font-size: 13px;
            }

            .validation-summary-errors {
                margin-bottom: 18px;
                color: #b42318;
                font-size: 13px;
            }

                .validation-summary-errors ul {
                    padding-left: 20px;
                }

            .back-link {
                display: block;
                margin-top: 22px;
                color: #2c7da0;
                font-size: 14px;
                text-align: center;
                text-decoration: none;
            }

                .back-link:hover {
                    text-decoration: underline;
                }

            .password-hint {
                margin-top: 7px;
                color: #647785;
                font-size: 12px;
            }

            @@media (max-width: 480px) {
                .reset-card {
                    padding: 28px 22px;
                }
            }
    </style>
</head>

<body>
    <main class="reset-card">
        <div class="brand">HemaCore</div>

        <h1>Reset Your Password</h1>

        <p class="description">
            Create a new password for your account.
            Enter your new password below and confirm it.
        </p>

        <form asp-controller="Account"
              asp-action="ResetPassword"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="validation-summary-errors"></div>

            <input asp-for="Email" type="hidden" />
            <input asp-for="Token" type="hidden" />

            <div class="form-group">
                <label asp-for="Password">New Password</label>

                <input asp-for="Password"
                       type="password"
                       autocomplete="new-password"
                       placeholder="Enter your new password" />

                <span asp-validation-for="Password"
                      class="validation"></span>

                <p class="password-hint">
                    Your password must be at least 6 characters long
                    and contain a digit and a lowercase letter.
                </p>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmPassword">
                    Confirm New Password
                </label>

                <input asp-for="ConfirmPassword"
                       type="password"
                       autocomplete="new-password"
                       placeholder="Re-enter your new password" />

                <span asp-validation-for="ConfirmPassword"
                      class="validation"></span>
            </div>

            <button type="submit" class="submit-button">
                Reset Password
            </button>
        </form>

        <a asp-controller="Account"
           asp-action="Login"
           class="back-link">
            ← Back to Login
        </a>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>